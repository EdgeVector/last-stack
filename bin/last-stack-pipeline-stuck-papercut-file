#!/usr/bin/env python3
"""Retired LastGit stuck-CR papercut filer (kept so old callers exit 0).

LastGit is retired (2026-09-30, decision-2026-09-29-retire-lastgit-all-repos-to-github).
There is no LastGit change request to be stuck. A stuck pull request is filed as one
row per PR by `last-stack-pipeline-forge-pr-ledger sync --apply` (GitHub through gh,
the lastgit repo through Forgejo). This helper keeps its argument contract and
always answers `skip-lastgit-retired`, exit 0, and writes nothing to the brain.
"""

from __future__ import annotations

import argparse
import json


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--cr-id", required=True)
    parser.add_argument("--evidence", required=True)
    parser.add_argument("--root-cause-slug")
    parser.add_argument("--candidate-slug", action="append", default=[])
    parser.add_argument("--brain-bin", default="brain")
    parser.add_argument("--json", action="store_true", dest="json_out")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    result = {
        "ok": True,
        "action": "skip-lastgit-retired",
        "cr_id": args.cr_id.strip(),
        "repo": args.repo,
        "reason": "LastGit is retired; stuck PRs are filed by last-stack-pipeline-forge-pr-ledger",
    }
    if args.json_out:
        print(json.dumps(result, sort_keys=True))
    else:
        print(f"{result['action']}: {result['reason']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
