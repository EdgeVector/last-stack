#!/bin/bash
# last-stack-lastdb-memory-guard
#
# Soft-restarts the primary LastDB Mini daemon (lastdbd) if the memory it holds
# exceeds a hard ceiling. Prevents the 2026-07-14 failure mode where cloud-sync
# download_entries ballooned footprint 0.5 GB -> 74 GB in ~2 minutes, exhausted
# swap, and tripped the kernel watchdog (panic + reboot).
#
# Repo of record. The LaunchAgent in launchd/com.edgevector.lastdb-memory-guard.plist
# runs the installed copy at ~/.last-stack/bin/, which Host Track activates from
# this file. Only the logs live under $LASTDBD_PRIMARY_HOME/monitoring/. Edit
# here, then install; never hand-edit the deployed copy.
#
# Scope: ONLY the primary Mini daemon.
#   (executable named `lastdbd` with no --data-dir, or LASTDB_HOME pointing at
#    the primary home). Never touches:
#   - LastGit forge lastdbd (--data-dir ~/.lastgit/...)
#   - throwaway smoke / temp-home / CoW upgrade-probe nodes
#   - fold-app desktop binary
#
# When the ceiling trips we POST /api/admin/shed first and wait for footprint
# to fall (a build without the shed route answers 404; log shed_unsupported
# and move on — never fail closed on a missing route). If footprint has not
# fallen by LASTDBD_GUARD_SHED_WAIT_SEC, capture `vmmap -summary` for
# post-mortem, then SIGTERM (graceful) with a LASTDBD_GUARD_TERM_WAIT_SEC
# clean-shutdown window, then SIGKILL if still alive. launchd KeepAlive
# restarts the service. The guard is a circuit breaker, not a root-cause fix.
# Port of fold #1908 (scripts/lastdbd/lastdbd-memory-guard.sh, merge 3974e691);
# see design-lastdb-primary-footprint-stays-under-the-guard clause D.
#
# KeepAlive only restarts a LOADED agent. When the primary exits while its
# LaunchAgent is not loaded, nothing revives it and every brain/kanban/situations
# read fails until a human or agent notices. The guard therefore also owns that
# case — see the primary revival block below.
#
# ---------------------------------------------------------------------------
# TWO GAUGES, AND WHY THIS SCRIPT REPORTS BOTH
#
# `ps -o rss=` is NOT the memory this process holds. On macOS it excludes
# compressed pages, and this daemon lives mostly in compressed//malloc memory.
# Measured on the live primary 2026-08-06:
#
#     ps -o rss=          1.47 GiB      <- what this guard has always enforced
#     phys_footprint      8.70 GiB      <- what the process actually holds
#     phys_footprint peak 11.11 GiB     <- 92.5% of the 12 GiB ceiling
#
# The guard read 12% of its limit while the node had touched 92.5% of it.
# phys_footprint is the number macOS jetsam and Activity Monitor use, and the
# unit the 2026-07-14 panic happened in, so it is the correct gauge.
#
# Tom chose a 16 GiB limit on 2026-08-08. The guard therefore defaults to
# phys_footprint and 16384 MiB as one policy. The old 12 GiB limit was below an
# observed 12.25 GiB peak and could have caused a restart loop.
#
# The script still measures and logs both gauges every cycle. Operators can set
# LASTDBD_GUARD_METRIC=rss for a deliberate compatibility rollback, but that
# restores the blind spot and emits a warning when footprint crosses the limit.
#
# Ground truth: brain
#   lastdb-memory-guard-measures-rss-while-the-node-lives-in-phys-footprint-20260803
# ---------------------------------------------------------------------------
#
# Tunables (env):
#   LASTDBD_GUARD_METRIC     default `footprint` — which gauge FIRES the restart.
#                            `rss`       enforce on ps rss (legacy, 8.6x margin)
#                            `footprint` enforce on phys_footprint (true usage)
#   LASTDBD_RSS_LIMIT_MB     default 16384 — ceiling, in MB, for the enforced gauge
#   LASTDBD_GUARD_COOLDOWN_SEC  default 120 — min seconds between restarts
#   LASTDBD_PRIMARY_HOME     default $HOME/.lastdb
#   LASTDBD_GUARD_RESTART_WAIT_SEC default 30 — wait for the replacement PID
#   LASTDBD_GUARD_NOTICE_CMD default situations — notice CLI or absolute path
#   LASTDBD_GUARD_REVIVE     default 1 — revive the primary LaunchAgent when the
#                            daemon is absent AND the agent is not loaded
#   LASTDBD_GUARD_REVIVE_MIN_ABSENT_CYCLES default 2 — consecutive cycles the
#                            state must persist before a revive; keeps an
#                            upgrade's bootout/bootstrap window from tripping it
#   LASTDBD_GUARD_REVIVE_WAIT_SEC   default 30 — wait for the socket to answer
#   LASTDBD_GUARD_REVIVE_HOLD_FILE  default $LASTDBD_PRIMARY_HOME/monitoring/
#                            lastdbd-revive.hold — presence declares a
#                            maintenance window and suppresses revival
#   LASTDBD_GUARD_PLIST_DIR  default $HOME/Library/LaunchAgents
#   LASTDBD_GUARD_DRY_RUN    default 0 — log restart intent, skip shed/kill/kickstart
#   LASTDBD_GUARD_SHED_WAIT_SEC default 60 — seconds to wait after POST
#                            /api/admin/shed for footprint to fall below the
#                            limit before capturing vmmap and sending SIGTERM
#   LASTDBD_GUARD_TERM_WAIT_SEC default 60 — clean-shutdown window after
#                            SIGTERM before SIGKILL
#   LASTDBD_GUARD_CONFIRM_SAMPLES default 5 — extra readings taken after the
#                            first over-limit reading. A majority of them must
#                            also be at or above the limit before the restart
#                            path runs. 0 restores the old single-sample
#                            behaviour (deliberate rollback only).
#   LASTDBD_GUARD_CONFIRM_INTERVAL_SEC default 2 — seconds between those
#                            confirmation readings
#
# Subcommand:
#   --check-log-contract [logfile] [--since ISO]
#       Audit an existing guard log against the declared field contract instead
#       of running a guard cycle. Groups violations by the missing key set with
#       a first and last timestamp, so a field that went away without a format
#       change reads as its own row with a start and an end. Exits 1 on any
#       violation in range. --since bounds it, which is how you ask whether the
#       CURRENT format is whole without being told about every deliberate past
#       format change.

set -eu
# launchd hands this script a near-empty PATH, so pin a known-good one. Kept
# overridable for installs whose curl/launchctl live elsewhere (and for the
# fixtures, which shim these binaries) — the default is the hardened value.
export PATH="${LASTDBD_GUARD_PATH:-/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin}"

GUARD_METRIC="${LASTDBD_GUARD_METRIC:-footprint}"
RSS_LIMIT_MB="${LASTDBD_RSS_LIMIT_MB:-16384}"
COOLDOWN_SEC="${LASTDBD_GUARD_COOLDOWN_SEC:-120}"
RESTART_WAIT_SEC="${LASTDBD_GUARD_RESTART_WAIT_SEC:-30}"
IDENTITY_TIMEOUT_SEC="${LASTDBD_GUARD_IDENTITY_TIMEOUT_SEC:-1}"
SHED_WAIT_SEC="${LASTDBD_GUARD_SHED_WAIT_SEC:-60}"
TERM_WAIT_SEC="${LASTDBD_GUARD_TERM_WAIT_SEC:-60}"
CONFIRM_SAMPLES="${LASTDBD_GUARD_CONFIRM_SAMPLES:-5}"
CONFIRM_INTERVAL_SEC="${LASTDBD_GUARD_CONFIRM_INTERVAL_SEC:-2}"
PRIMARY_HOME="${LASTDBD_PRIMARY_HOME:-$HOME/.lastdb}"
LOG_DIR="${PRIMARY_HOME}/monitoring"
LOG="${LOG_DIR}/lastdbd-memory-guard.log"
EVENT_LOG="${LASTDBD_GUARD_EVENT_LOG:-${LOG_DIR}/lastdbd-memory-guard-events.jsonl}"
STATE="${LOG_DIR}/lastdbd-memory-guard.state"
SOCKET="${PRIMARY_HOME}/data/folddb.sock"
PRIMARY_AGENT_LABEL="${LASTDBD_PRIMARY_AGENT_LABEL:-}"
FALLBACK_AGENT_LABEL="${LASTDBD_FALLBACK_AGENT_LABEL:-homebrew.mxcl.lastdb}"
mkdir -p "$LOG_DIR"

case "$GUARD_METRIC" in
  rss|footprint) ;;
  *)
    echo "invalid LASTDBD_GUARD_METRIC=$GUARD_METRIC (want rss|footprint)" >&2
    exit 2
    ;;
esac

case "$IDENTITY_TIMEOUT_SEC" in
  ''|*[!0-9]*|0)
    echo "invalid LASTDBD_GUARD_IDENTITY_TIMEOUT_SEC=$IDENTITY_TIMEOUT_SEC (want positive whole seconds)" >&2
    exit 2
    ;;
esac

case "$SHED_WAIT_SEC" in
  ''|*[!0-9]*)
    echo "invalid LASTDBD_GUARD_SHED_WAIT_SEC=$SHED_WAIT_SEC (want whole seconds)" >&2
    exit 2
    ;;
esac

case "$TERM_WAIT_SEC" in
  ''|*[!0-9]*)
    echo "invalid LASTDBD_GUARD_TERM_WAIT_SEC=$TERM_WAIT_SEC (want whole seconds)" >&2
    exit 2
    ;;
esac

case "$CONFIRM_SAMPLES" in
  ''|*[!0-9]*)
    echo "invalid LASTDBD_GUARD_CONFIRM_SAMPLES=$CONFIRM_SAMPLES (want whole samples)" >&2
    exit 2
    ;;
esac

case "$CONFIRM_INTERVAL_SEC" in
  ''|*[!0-9]*)
    echo "invalid LASTDBD_GUARD_CONFIRM_INTERVAL_SEC=$CONFIRM_INTERVAL_SEC (want whole seconds)" >&2
    exit 2
    ;;
esac

ts() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
log() { echo "$(ts) $*" | tee -a "$LOG" >/dev/null; echo "$(ts) $*"; }

# >>> log field contract (extracted by tests/last-stack-lastdb-memory-guard-log-contract.sh)
# --------------------------------------------------------------------------
# Log field contract.
#
# The guard's telemetry lines are space-separated key=value free text with no
# declared field set. A refactor can therefore drop a field from one of them
# and nothing says so, because an absent key is indistinguishable from a field
# that was never there. That is measured, not hypothetical: the 2026-09-04
# rusage reader port removed `peak_mb` from the `ok` line and the field stayed
# absent for 2.8 days and 3115 samples. peak_mb is the ONLY field that can show
# an excursion the 60 s sampler missed, so for those three days this log could
# not answer the question the guard exists to answer, and the analysis written
# in that window had to reach outside the log to find the peak.
# papercut-lastdbd-guard-log-lost-peak-mb-for-28-days-in-a-silent-field-drop-20260907
#
# So the required keys are declared once, here, and asserted where the line is
# emitted. A value that is genuinely unavailable is emitted as a token — 0,
# `unknown`, `unavailable` — because that is a reading. An absent key is not a
# reading, and it is what this contract refuses.
log_contract_keys() {
  case "$1" in
    ok|over_limit_candidate|OVER_LIMIT)
      printf 'pid metric enforced_mb limit_mb rss_mb footprint_mb peak_mb footprint_source swap_mb\n'
      ;;
    *) printf '\n' ;;
  esac
}

# Comma-joined list of the required keys a message fails to carry, empty when
# it satisfies its contract. A key must be present AND carry a non-empty value:
# an unset shell variable interpolates as an empty value, not as an absent key,
# so both shapes have to fail. The leading space in the match keeps `pid=` from
# matching `new_pid=`.
log_contract_missing() {
  event="$1"
  msg="$2"
  missing=""
  for key in $(log_contract_keys "$event"); do
    case " $msg " in
      *" $key="*)
        value="${msg#*" $key="}"
        value="${value%% *}"
        [ -n "$value" ] || missing="${missing:+$missing,}$key=empty"
        ;;
      *) missing="${missing:+$missing,}$key" ;;
    esac
  done
  printf '%s' "$missing"
}

# log(), plus the contract assertion for the events that declare one. The
# violation is itself a log line rather than a hard failure: this script's job
# is to keep the primary alive, and it must not stop guarding because it has
# stopped describing itself well.
log_checked() {
  event="$1"
  shift
  msg="$*"
  log "$msg"
  missing="$(log_contract_missing "$event" "$msg")"
  [ -z "$missing" ] || log "log_contract_violation event=$event missing=$missing"
}

# <<< log field contract

# `--check-log-contract [logfile] [--since ISO]` audits an EXISTING guard log
# against the declared contract, so the contract can be verified against real
# production output and not only against a fixture. This is the reader that
# would have caught the peak_mb hole on the day it opened.
#
# It groups by the MISSING KEY SET rather than printing every offending line,
# because this log spans several deliberate format changes and a flat count
# over its whole history is 61696 violations of which nearly all are simply
# "July did not have these fields yet". Grouped, the same scan reads as a
# history of what the line carried and when — and a field that went away
# without a format change appears as its own row with a start and an end.
#
# --since bounds the scan to lines at or after an ISO timestamp prefix, which
# is what an operator wants when asking whether the CURRENT format is whole.
#
# The whole scan is ONE awk pass. The obvious shell loop calls
# log_contract_missing per line, which is a fork per line: 62k forks and over
# two minutes on the production log. A diagnostic nobody will wait for is a
# diagnostic nobody runs, so the key list is declared once above and handed to
# awk, which keeps the declaration single-sourced without paying for it.
# Exits 1 when any contracted line in range is short a field.
if [ "${1:-}" = "--check-log-contract" ]; then
  scan_log="$LOG"
  scan_since=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --since)
        shift
        scan_since="${1:-}"
        ;;
      --since=*) scan_since="${1#--since=}" ;;
      *) scan_log="$1" ;;
    esac
    shift
  done
  if [ ! -r "$scan_log" ]; then
    echo "cannot read $scan_log" >&2
    exit 2
  fi
  awk -v required="$(log_contract_keys ok)" \
      -v since="$scan_since" \
      -v logfile="$scan_log" '
    BEGIN { nreq = split(required, req, " ") }
    {
      if (index($0, " ok pid=")) event = "ok"
      else if (index($0, " over_limit_candidate pid=")) event = "over_limit_candidate"
      else if (index($0, " OVER_LIMIT pid=")) event = "OVER_LIMIT"
      else next
      if (since != "" && $1 < since) next
      checked++
      missing = ""
      for (i = 1; i <= nreq; i++) {
        at = index($0, " " req[i] "=")
        if (at == 0) { missing = missing (missing ? "," : "") req[i]; continue }
        rest = substr($0, at + length(req[i]) + 2)
        sp = index(rest, " ")
        value = (sp ? substr(rest, 1, sp - 1) : rest)
        if (value == "") missing = missing (missing ? "," : "") req[i] "=empty"
      }
      if (missing == "") next
      violations++
      key = event " " missing
      n[key]++
      if (!(key in first)) first[key] = $1
      last[key] = $1
    }
    END {
      for (k in n)
        printf "violations=%-6d event+missing=%s first=%s last=%s\n",
               n[k], k, first[k], last[k] | "sort -t= -k2 -rn"
      close("sort -t= -k2 -rn")
      printf "log_contract_scan file=%s since=%s checked=%d violations=%d\n",
             logfile, (since == "" ? "all" : since), checked + 0, violations + 0
      exit (violations > 0 ? 1 : 0)
    }
  ' "$scan_log"
  exit $?
fi

event() {
  # Values passed here are numeric or controlled tokens. Keep this dependency
  # free because the guard runs before the node and its toolchain are healthy.
  printf '{"ts":"%s","event":"%s","old_pid":%s,"new_pid":%s,"metric":"%s","enforced_mb":%s,"limit_mb":%s,"rss_mb":%s,"footprint_mb":%s,"peak_mb":%s,"build":"%s"}\n' \
    "$(ts)" "$1" "$2" "$3" "$metric" "$enforced" "$RSS_LIMIT_MB" \
    "$rss" "${footprint:-0}" "${peak:-0}" "${build:-unknown}" >>"$EVENT_LOG"
}

# Resolve primary lastdbd PID.
#
# Match on the EXECUTABLE PATH (`ps -o comm=`), never the full argv.
#
# Every previous selector matched argv text, and all three were wrong:
#   1. `lsof -t <unix socket path>` returns nothing on macOS, so the preferred
#      branch never produced a pid. Had it worked it would have been worse:
#      lsof on a socket lists connected CLIENTS too, and `head -1` would pick
#      one of them.
#   2. The `case */lastdbd) continue ;;` arm matched the real primary and
#      skipped past it, making the very next arm — the one meant to select the
#      daemon — unreachable. (`return 0` inside a piped `while` is a subshell
#      anyway.)
#   3. The awk fallback took the first process whose command line merely
#      CONTAINED "lastdbd". Routine agent prompts mention lastdbd in argv, so
#      on 2026-08-03 this guard was watching `claude -p ...` (202 MB) while the
#      actual primary sat at 9.5 GB phys_footprint.
#
# Selecting a client is not just a blind spot — `restart_primary` SIGTERMs then
# SIGKILLs whatever pid it is handed, so a mis-selection kills an innocent
# process and then needlessly kickstarts a healthy primary.
#
# Fail closed: emit nothing rather than a guess. A guard that does nothing this
# cycle is strictly safer than one that kills the wrong process.
primary_pid() {
  local p comm args home
  while read -r p comm; do
    # Executable path, not argv: a client that merely mentions lastdbd cannot
    # reach this branch.
    case "$comm" in
      */lastdbd) ;;
      *) continue ;;
    esac
    # Reject nodes explicitly homed elsewhere: smoke/temp nodes under /tmp,
    # LastGit forge nodes, CoW upgrade probes.
    args=$(ps -p "$p" -o args= 2>/dev/null || true)
    case "$args" in
      *--data-dir*) continue ;;
    esac
    # Confirm the home really is the primary before handing this pid to a killer.
    home=$(ps eww -p "$p" 2>/dev/null | tr ' ' '\n' | sed -n 's/^LASTDB_HOME=//p' | head -1 || true)
    if [ -n "$home" ] && [ "$home" != "$PRIMARY_HOME" ]; then
      continue
    fi
    echo "$p"
    return 0
  done <<EOF
$(ps -Ao pid=,comm=)
EOF
  return 0
}

# Is the process table readable at all?
#
# `primary_pid` fails closed: it emits nothing both when no primary is running
# and when `ps` itself is denied. Those two are the same to a killer — neither
# is a pid it may signal — but they are NOT the same to the read-only
# `--identity` reader. A scheduled routine runs under a managed sandbox that
# returns `operation not permitted` for `ps`, and on 2026-09-06 that made the
# canary v2 dogfood gate report `primary_identity_absent` for a primary whose
# own socket answered GET /api/system/boot-identity with HTTP 200, build
# 0.23.3-1576-g86498047e, pid 73392. The line stopped on a denial, not on a
# fact about the node.
#
# So separate them. A `ps` that exits non-zero, or that prints nothing at all
# on a host that must be running at least one process, is unreadable.
process_table_readable() {
  local table
  table=$(ps -Ao pid=,comm= 2>/dev/null) || return 1
  [ -n "$table" ]
}

rss_mb_of() {
  local pid="$1"
  local rss_kb
  rss_kb=$(ps -p "$pid" -o rss= 2>/dev/null | tr -d ' ' || echo 0)
  if [ -z "$rss_kb" ] || [ "$rss_kb" = "0" ]; then
    echo 0
  else
    echo $((rss_kb / 1024))
  fi
}

# phys_footprint via proc_pid_rusage(RUSAGE_INFO_V4) — the same gauge macOS
# jetsam and Activity Monitor use, read directly from the kernel instead of
# through this daemon's own /api/status. That decouples the reading from the
# node's HTTP path entirely: a hung or overloaded node (the ~242-cold-load
# cost /api/status carried before fold #1908) no longer blinds this gauge.
# Falls back to rss when the pid is gone or the platform has no footprint
# accounting (e.g. non-macOS CI). Prints "<mb> <source> <peak_mb>" — a caller
# run through `$(...)` runs in a subshell, so the source has to travel on
# stdout rather than through a global the function sets. Port of fold #1908's
# phys_footprint_mb_of.
#
# The third field is ri_lifetime_max_phys_footprint, the process-lifetime high
# water mark the same syscall already carries. The node publishes the identical
# number as status.phys_footprint_peak_bytes — verified equal on the live
# primary 2026-09-07 (pid 40502, both 18656074072 bytes) — but reading it from
# the kernel costs this guard nothing and adds no request to a primary that
# Situation lastdb-primary-offload-then-heal-20260906 says must not gain
# consumers. It also keeps the steady-state cycle off the node's HTTP path,
# which is the property fold #1908 bought.
#
# Peak is 0 when unavailable (rss fallback, or a kernel that does not carry the
# field). Callers must read 0 as "unknown", not as "the process never grew".
phys_footprint_mb_of() {
  local pid="$1" bytes peak_bytes reading
  # Unquoted $(...) — bash 3.2 (LaunchAgent /bin/bash) treats quotes inside
  # a double-quoted "$( <<'PY' )" as closers, so the python must not sit
  # in an extra quoted substitution.
  reading=$(python3 - "$pid" <<'PY' 2>/dev/null || true
import ctypes
import ctypes.util
import struct
import sys

pid = int(sys.argv[1])
libc_name = ctypes.util.find_library("c")
if not libc_name:
    raise SystemExit(1)
libc = ctypes.CDLL(libc_name)
# Darwin rusage_info_v4 is 296 bytes (macOS 26 SDK). A 248-byte ctypes
# Structure overflowed the heap and SIGSEGV'd in PyGC_Collect on finalize.
# An oversized buffer survives later field growth (v5=304, v6=464).
RUSAGE_INFO_V4 = 4
BUF_SIZE = 1024
PHYS_FOOTPRINT_OFFSET = 72
# ri_lifetime_max_phys_footprint, the field after ri_logical_writes in the v4
# tail. Verified against the node's own status.phys_footprint_peak_bytes.
LIFETIME_MAX_FOOTPRINT_OFFSET = 240
buf = (ctypes.c_uint8 * BUF_SIZE)()
fn = libc.proc_pid_rusage
fn.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
fn.restype = ctypes.c_int
rc = fn(pid, RUSAGE_INFO_V4, buf)
if rc != 0:
    raise SystemExit(1)
raw = bytes(buf)
footprint = struct.unpack_from('<Q', raw, PHYS_FOOTPRINT_OFFSET)[0]
if footprint <= 0:
    raise SystemExit(1)
peak = struct.unpack_from('<Q', raw, LIFETIME_MAX_FOOTPRINT_OFFSET)[0]
# A peak below the instantaneous reading means the offset does not hold what
# this code expects on this kernel. Report 0 rather than a smaller-than-now
# "high water mark" no reader could interpret.
if peak < footprint:
    peak = 0
print(int(footprint), int(peak))
PY
)
  # A shim or an older reader may print only the footprint. Splitting on the
  # first and last word of a one-word line yields the same word twice, so the
  # peak is validated as a distinct number before it is trusted.
  bytes="${reading%% *}"
  peak_bytes="${reading##* }"
  if [ "$peak_bytes" = "$reading" ]; then
    peak_bytes=0
  fi
  case "${peak_bytes:-}" in
    ''|*[!0-9]*) peak_bytes=0 ;;
  esac
  if [ -n "${bytes:-}" ] && [ "$bytes" -gt 0 ] 2>/dev/null; then
    printf '%s rusage %s\n' "$((bytes / 1024 / 1024))" "$((peak_bytes / 1024 / 1024))"
    return 0
  fi
  printf '%s rss_fallback 0\n' "$(rss_mb_of "$pid")"
}

# The shed route only exists on daemon builds carrying fold #1908
# (0.23.3-1540+); an older daemon answers 404. Never fail closed on a missing
# or errored route — restart_primary proceeds straight to the vmmap capture +
# SIGTERM window either way.
post_shed() {
  local blob
  blob=$(curl -s --max-time 5 --unix-socket "$SOCKET" \
    -H 'X-LastDB-Client: lastdb-memory-guard' \
    -X POST -w '\n%{http_code}' \
    "http://localhost/api/admin/shed" 2>/dev/null || true)
  if ! split_http_body "$blob"; then
    log "shed_failed reason=no_response socket=$SOCKET"
    return 1
  fi
  case "$IDENTITY_HTTP_CODE" in
    200)
      log "shed_ok socket=$SOCKET"
      return 0
      ;;
    404)
      log "shed_unsupported socket=$SOCKET"
      return 1
      ;;
    *)
      log "shed_failed http_code=$IDENTITY_HTTP_CODE socket=$SOCKET"
      return 1
      ;;
  esac
}

capture_vmmap() {
  local pid="$1" dest
  dest="$LOG_DIR/footprint-guard-$(date -u +%Y%m%dT%H%M%SZ).txt"
  if command -v vmmap >/dev/null 2>&1; then
    vmmap -summary "$pid" >"$dest" 2>&1 || true
    log "vmmap_capture path=$dest pid=$pid"
  else
    log "vmmap_skip reason=no_vmmap pid=$pid"
  fi
}

# Read a unique top-level integer field out of the node's /api/status.
#
# The daemon already computes phys_footprint the same way the kernel does and
# publishes it; asking the node is both cheaper and more accurate than shelling
# out to vmmap/footprint, which need elevated privileges. Text-extract rather
# than jq: this runs from launchd with a minimal PATH and must not acquire a
# dependency to stay armed.
status_field() {
  local body="$1" key="$2" v
  v=$(printf '%s' "$body" | sed -n "s/.*\"${key}\":\([0-9][0-9]*\).*/\1/p" | head -1)
  if [ -z "$v" ]; then
    echo ""
  else
    echo "$v"
  fi
}

status_build() {
  local body="$1" v
  v=$(printf '%s' "$body" | sed -n 's/.*"build":{[^}]*"version":"\([^"]*\)".*/\1/p' | head -1)
  printf '%s\n' "${v:-unknown}"
}

# Split a curl body that ends with a newline plus the write-out HTTP code.
# Empty code means the socket did not answer. Callers own the timeout.
split_http_body() {
  local blob="$1"
  IDENTITY_HTTP_CODE=""
  IDENTITY_BODY=""
  if [ -z "$blob" ]; then
    return 1
  fi
  IDENTITY_HTTP_CODE=$(printf '%s\n' "$blob" | sed -n '$p')
  IDENTITY_BODY=$(printf '%s\n' "$blob" | sed '$d')
  return 0
}

unix_get() {
  local url="$1"
  curl -s --max-time "$IDENTITY_TIMEOUT_SEC" --unix-socket "$SOCKET" \
    -H 'X-LastDB-Client: lastdb-memory-guard' \
    -w '\n%{http_code}' \
    "$url" 2>/dev/null || true
}

# footprint_mb + peak_mb from the primary's own socket. Empty on any failure —
# callers fall back to rss and say so.
STATUS_BODY=""
read_status() {
  # No pre-check that the socket exists: curl failing IS the unavailable signal,
  # and one branch that can report "unavailable" is easier to reason about than
  # two. --max-time bounds this so a wedged node cannot stall the guard.
  STATUS_BODY=$(curl -s --max-time 5 --unix-socket "$SOCKET" \
    -H 'X-LastDB-Client: lastdb-memory-guard' \
    http://localhost/api/status 2>/dev/null || true)
}

identity_from_status() {
  # 404-only fallback. A timeout, empty body, or down socket stays a failure.
  local expected_pid="$1" blob status_pid start build_value
  blob=$(unix_get "http://localhost/api/status")
  split_http_body "$blob" || return 1
  if [ "$IDENTITY_HTTP_CODE" != "200" ] || [ -z "$IDENTITY_BODY" ]; then
    return 1
  fi
  status_pid=$(printf '%s' "$IDENTITY_BODY" | sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' | head -1)
  if [ -z "$status_pid" ]; then
    status_pid="$expected_pid"
  fi
  start=$(status_field "$IDENTITY_BODY" process_start_ts)
  if [ -z "$start" ]; then
    start=0
  fi
  build_value=$(status_build "$IDENTITY_BODY")
  if [ -z "$build_value" ] || [ "$build_value" = "unknown" ]; then
    return 1
  fi
  # An empty expected_pid reaches here only from the unreadable-process-table
  # branch in identity(). There is nothing to cross-check against, so say so in
  # the source rather than failing on a denial.
  if [ -z "$expected_pid" ]; then
    if [ -z "$status_pid" ]; then
      return 1
    fi
    printf 'pid=%s process_start_ts=%s build=%s identity_source=status_fallback_unverified_pid\n' \
      "$status_pid" "$start" "$build_value"
    return 0
  fi
  if [ "$status_pid" != "$expected_pid" ]; then
    return 1
  fi
  printf 'pid=%s process_start_ts=%s build=%s identity_source=status_fallback\n' \
    "$status_pid" "$start" "$build_value"
}

identity() {
  local expected_pid identity_pid start build_value blob source
  expected_pid=$(primary_pid || true)
  if [ -z "$expected_pid" ] && process_table_readable; then
    # The process table is readable and holds no primary. That is a real fact
    # about the node, and it stays a failure.
    return 1
  fi
  # Prefer the one-row boot-identity read. Call /api/status only when that
  # route is absent (HTTP 404). A timeout or down socket is still a failure.
  blob=$(unix_get "http://localhost/api/system/boot-identity")
  if ! split_http_body "$blob"; then
    return 1
  fi
  if [ "$IDENTITY_HTTP_CODE" = "404" ]; then
    identity_from_status "$expected_pid"
    return $?
  fi
  if [ "$IDENTITY_HTTP_CODE" != "200" ]; then
    return 1
  fi
  identity_pid=$(printf '%s' "$IDENTITY_BODY" | sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' | head -1)
  start=$(printf '%s' "$IDENTITY_BODY" | sed -n 's/.*"process_start_ts":\([0-9][0-9]*\).*/\1/p' | head -1)
  build_value=$(printf '%s' "$IDENTITY_BODY" | sed -n 's/.*"build":"\([^"]*\)".*/\1/p' | head -1)
  if [ -z "$identity_pid" ] || [ -z "$start" ] || [ -z "$build_value" ]; then
    return 1
  fi
  # Only the live daemon can answer on the primary's own socket, so a 200 here
  # is already proof of identity. The `ps` cross-check is a second opinion, and
  # its absence names itself in the source rather than voiding the first one.
  source=boot_identity
  if [ -z "$expected_pid" ]; then
    source=boot_identity_unverified_pid
  elif [ "$identity_pid" != "$expected_pid" ]; then
    return 1
  fi
  printf 'pid=%s process_start_ts=%s build=%s identity_source=%s\n' \
    "$identity_pid" "$start" "$build_value" "$source"
}

# Slug for the restart notice.
#
# Situations validates every slug against ^[a-z0-9][a-z0-9_-]*$ and rejects the
# write outright. `date -u +%Y%m%dT%H%M%SZ` emits an uppercase T and Z, so every
# notice this guard ever tried to post was rejected as invalid_slug — silently,
# because the call discarded stderr. Two live restarts on 2026-08-30 (20:10Z and
# 21:25Z) logged `notice_failed` and a human had to hand-post the evidence.
# Fold the timestamp to lowercase; keep the shape so old slugs still sort.
notice_slug() {
  printf 'lastdb-memory-guard-restart-%s-%s\n' \
    "$(date -u +%Y%m%dT%H%M%SZ | tr 'A-Z' 'a-z')" "$1"
}

post_restart_notice() {
  local old_pid="$1" new_pid="$2" build_value="$3" notice_cmd slug out rc
  notice_cmd="${LASTDBD_GUARD_NOTICE_CMD:-}"
  if [ -z "$notice_cmd" ]; then
    if [ -x "$HOME/.local/bin/situations" ]; then
      notice_cmd="$HOME/.local/bin/situations"
    else
      notice_cmd="situations"
    fi
  fi
  slug="$(notice_slug "$new_pid")"
  # Keep the reason. Discarding stderr is what let a wrong diagnosis ship: the
  # 2026-08-30 attribution fix changed the actor while the real reject was the
  # slug, and nothing on disk could contradict it.
  set +e
  out=$("$notice_cmd" notice \
    --slug "$slug" \
    --title "LastDB memory guard restarted the primary" \
    --kind restart \
    --system lastdbd \
    --system primary-brain \
    --actor agent:lastdb-memory-guard \
    --severity-hint warn \
    --expires-hours 24 \
    --summary "physical footprint ${enforced} MiB exceeded ${RSS_LIMIT_MB} MiB; pid ${old_pid} -> ${new_pid}; build ${build_value}" \
    2>&1)
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    log "notice posted slug=$slug old_pid=$old_pid new_pid=$new_pid build=$build_value"
  else
    log "WARN notice_failed rc=$rc slug=$slug old_pid=$old_pid new_pid=$new_pid build=$build_value event_log=$EVENT_LOG reason=$(printf '%s' "$out" | tr '\n' ' ' | head -c 300)"
  fi
}

swap_used_mb() {
  # vm.swapusage: "total = X.00M  used = Y.00M  free = Z.00M"
  /usr/sbin/sysctl -n vm.swapusage 2>/dev/null \
    | sed -n 's/.*used = \([0-9.]*\)M.*/\1/p' \
    | awk '{printf "%d\n", $1+0}'
}

cooldown_ok() {
  if [ ! -f "$STATE" ]; then
    return 0
  fi
  local last now
  last=$(cat "$STATE" 2>/dev/null || echo 0)
  now=$(date +%s)
  if [ $((now - last)) -ge "$COOLDOWN_SEC" ]; then
    return 0
  fi
  return 1
}

mark_restart() {
  date +%s >"$STATE"
}

# The gauge the guard actually enforces on, as one number. Confirmation and
# drain logging both need "what would fire right now", not the whole reading.
current_enforced_mb() {
  local pid="$1" reading
  if [ "$GUARD_METRIC" = "rss" ]; then
    rss_mb_of "$pid"
    return 0
  fi
  reading=$(phys_footprint_mb_of "$pid")
  printf '%s\n' "${reading%% *}"
}

# Confirm an over-limit reading before handing a pid to the killer.
#
# The LaunchAgent runs this guard once per 60 s, so the old code enforced a
# hard ceiling on ONE sample. Measured on the live primary 2026-09-07 over 623
# samples of a single pid, the minute-to-minute absolute change of
# phys_footprint is p50 110 MB, p90 1650 MB, max 7638 MB. One sample therefore
# says very little about whether the process is holding that memory: of the 39
# recorded OVER_LIMIT events carrying a footprint reading, 24 (62%) fired
# within 500 MB of the limit, which is well inside that noise.
#
# So take CONFIRM_SAMPLES more readings CONFIRM_INTERVAL_SEC apart and require
# a majority of them at or above the limit. Seconds apart, not minutes apart:
# that separates a spike from a sustained hold without leaving the machine at
# its ceiling for another full cycle.
#
# A dead pid needs no special case. Its reading falls back to rss, rss of a
# gone process is 0, and 0 is under the limit — so an exit during confirmation
# reads as "not over" and nothing gets signalled.
#
# Returns 0 to proceed with the restart, 1 to ignore this cycle. Either way
# every reading lands in the log, so the false-positive rate becomes countable
# instead of inferred.
confirm_over_limit() {
  local pid="$1" first="$2"
  if [ "$CONFIRM_SAMPLES" -eq 0 ]; then
    log "confirm_disabled pid=$pid samples=0 first_mb=$first limit_mb=$RSS_LIMIT_MB"
    return 0
  fi
  local i=0 over=0 mb readings="$first"
  while [ "$i" -lt "$CONFIRM_SAMPLES" ]; do
    sleep "$CONFIRM_INTERVAL_SEC"
    mb=$(current_enforced_mb "$pid")
    case "${mb:-}" in
      ''|*[!0-9]*) mb=0 ;;
    esac
    readings="$readings,$mb"
    if [ "$mb" -ge "$RSS_LIMIT_MB" ]; then
      over=$((over + 1))
    fi
    i=$((i + 1))
  done
  if [ $((over * 2)) -gt "$CONFIRM_SAMPLES" ]; then
    log "confirmed_over_limit pid=$pid metric=$GUARD_METRIC over=$over/$CONFIRM_SAMPLES limit_mb=$RSS_LIMIT_MB interval_sec=$CONFIRM_INTERVAL_SEC readings=$readings"
    return 0
  fi
  log "transient_ignored pid=$pid metric=$GUARD_METRIC over=$over/$CONFIRM_SAMPLES limit_mb=$RSS_LIMIT_MB interval_sec=$CONFIRM_INTERVAL_SEC readings=$readings"
  return 1
}

# One observation of how far a shutting-down node has got.
#
# There is no shutdown-state field on the status route, so the drain is read
# from what a draining node still reports: whether the socket answers at all,
# how many requests are still in flight on it, and how many sync uploads are
# still pending. `uds.in_flight` is scoped to its own object here rather than
# taken from the flat key, because `local_retention.in_flight` shares the name.
drain_snapshot() {
  local blob in_flight pending
  blob=$(unix_get "http://localhost/api/status")
  if ! split_http_body "$blob" \
    || [ "$IDENTITY_HTTP_CODE" != "200" ] \
    || [ -z "$IDENTITY_BODY" ]; then
    printf 'socket=unanswered\n'
    return 0
  fi
  in_flight=$(printf '%s' "$IDENTITY_BODY" \
    | sed -n 's/.*"uds":{[^}]*"in_flight":\([0-9][0-9]*\).*/\1/p' | head -1)
  pending=$(status_field "$IDENTITY_BODY" pending_count)
  printf 'socket=answering uds_in_flight=%s sync_pending=%s\n' \
    "${in_flight:-unknown}" "${pending:-unknown}"
}

restart_primary() {
  local pid="$1"
  local reading="$2"
  event restart_requested "$pid" null
  log "RESTART primary lastdbd pid=$pid metric=$metric enforced_mb=$reading limit_mb=$RSS_LIMIT_MB (shed, then SIGTERM, then kickstart)"
  mark_restart
  if [ "${LASTDBD_GUARD_DRY_RUN:-0}" = "1" ]; then
    log "dry_run skip shed/kill/kickstart"
    return 0
  fi

  if post_shed; then
    local shed_deadline current_reading current_mb
    shed_deadline=$(($(date +%s) + SHED_WAIT_SEC))
    while [ "$(date +%s)" -lt "$shed_deadline" ]; do
      current_reading=$(phys_footprint_mb_of "$pid")
      current_mb="${current_reading%% *}"
      if [ -n "$current_mb" ] && [ "$current_mb" -lt "$RSS_LIMIT_MB" ] 2>/dev/null; then
        log "shed_recovered pid=$pid footprint_mb=$current_mb limit_mb=$RSS_LIMIT_MB"
        return 0
      fi
      sleep 1
    done
    log "shed_timeout pid=$pid footprint_mb=${current_mb:-unavailable} limit_mb=$RSS_LIMIT_MB wait_sec=$SHED_WAIT_SEC"
  fi

  capture_vmmap "$pid"
  kill -TERM "$pid" 2>/dev/null || true
  # Every guard restart in the whole log so far ended in SIGKILL: 43 SIGKILL,
  # 0 SIGTERM_clean. Nothing recorded WHY, so nobody could tell a drain that
  # needs more than TERM_WAIT_SEC from a drain that is wedged. Poll the node
  # once per second across the window and log the last state observed next to
  # the outcome. This measures the question; it does not answer it by raising
  # the window.
  local term_deadline drain_state="" drain_polls=0 drain_answered=0 term_started
  term_started=$(date +%s)
  term_deadline=$((term_started + TERM_WAIT_SEC))
  while [ "$(date +%s)" -lt "$term_deadline" ]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    drain_state=$(drain_snapshot)
    drain_polls=$((drain_polls + 1))
    case "$drain_state" in
      socket=answering*) drain_answered=$((drain_answered + 1)) ;;
    esac
    sleep 1
  done
  log "drain_progress pid=$pid term_wait_sec=$TERM_WAIT_SEC elapsed_sec=$(($(date +%s) - term_started)) polls=$drain_polls answered=$drain_answered last=${drain_state:-unobserved}"
  if kill -0 "$pid" 2>/dev/null; then
    log "SIGKILL pid=$pid (did not exit after SIGTERM window ${TERM_WAIT_SEC}s)"
    kill -KILL "$pid" 2>/dev/null || true
  else
    log "SIGTERM_clean pid=$pid"
  fi
  # Prefer the LaunchAgent that owns the primary. Never restart
  # homebrew.mxcl.lastdb while that agent is the intended primary — brew restart
  # was reintroducing the pre-cap bottle and fighting the LaunchAgent for the
  # primary home during the 2026-07-14 re-enable.
  local uid label
  uid=$(id -u)
  label="$PRIMARY_AGENT_LABEL"
  if [ -z "$label" ]; then
    # Discover the agent that owns the primary rather than hardcoding an
    # install-specific label: any loaded agent whose label names a lastdbd
    # primary. Keeps this script portable across installs.
    label=$(launchctl list 2>/dev/null \
      | awk '$3 ~ /lastdbd-primary/ { print $3; exit }' || true)
  fi
  if [ -n "$label" ] && launchctl print "gui/${uid}/${label}" >/dev/null 2>&1; then
    log "kickstart agent=$label"
    launchctl kickstart -k "gui/${uid}/${label}" 2>/dev/null || true
  elif launchctl print "gui/${uid}/${FALLBACK_AGENT_LABEL}" >/dev/null 2>&1; then
    log "kickstart agent=$FALLBACK_AGENT_LABEL"
    launchctl kickstart -k "gui/${uid}/${FALLBACK_AGENT_LABEL}" 2>/dev/null \
      || brew services restart lastdb 2>/dev/null \
      || true
  else
    # KeepAlive on whichever agent owns the socket should revive; do not force brew.
    true
  fi
  local new_pid="" new_identity="" new_build="$build" waited=0
  while [ "$waited" -lt "$RESTART_WAIT_SEC" ]; do
    # A new process alone is not enough for the notice path. Wait until its
    # socket answers and supplies a start time, so the notice write has a live
    # LastDB endpoint and records the replacement build.
    new_identity=$(identity || true)
    new_pid=$(printf '%s\n' "$new_identity" | sed -n 's/.*pid=\([^ ]*\).*/\1/p')
    new_build=$(printf '%s\n' "$new_identity" | sed -n 's/.*build=\([^ ]*\).*/\1/p')
    if [ -n "$new_pid" ] && [ "$new_pid" != "$pid" ]; then
      break
    fi
    new_pid=""
    sleep 1
    waited=$((waited + 1))
  done
  if [ -n "$new_pid" ]; then
    event restart_observed "$pid" "$new_pid"
    post_restart_notice "$pid" "$new_pid" "${new_build:-$build}"
    log "kickstart verified old_pid=$pid new_pid=$new_pid"
  else
    log "WARN kickstart_unverified old_pid=$pid wait_sec=$RESTART_WAIT_SEC event_log=$EVENT_LOG"
  fi
}

# --- primary revival ----------------------------------------------------------
#
# The guard already computed the one fact that matters when the primary is gone,
# and then discarded it: `ok no_primary_lastdbd`, exit 0.
#
# Three dated outages have the same shape — the primary exited AND its
# LaunchAgent was not loaded, so KeepAlive could not revive it, and
# brain/kanban/situations stayed down until an agent noticed by accident on an
# unrelated routine:
#
#   2026-08-30 22:5xZ  ~14 min   found at 23:11Z by a papercut filing that failed
#   2026-09-03 17:3xZ  ~38 min   found at 18:10Z by last-stack-pipeline-health
#   2026-09-03 21:05Z  ~4 min    found at 21:09Z by papercut-resolver
#
# On the third one this guard logged `ok no_primary_lastdbd` at 21:06:32Z —
# it observed the outage, called it ok, and did nothing.
#
# Ground truth: brain papercut
# papercut-primary-lastdbd-exited-with-launchagent-unloaded-no-auto-revival,
# whose suggested fix is this watchdog. It belongs in this process rather than a
# new agent: a supervisor that can itself go missing is the failure being fixed,
# and this one is already loaded, already runs every 60s, and already resolves
# the primary. A health check must be cheaper than what it checks.
#
# The recovery action is sanctioned for unattended agents by
# decision-2026-08-23-unattended-lastdbd-bootstrap-self-heal, whose precondition
# is exactly UNLOADED + no process. Every precondition is checked below, and
# each one that fails is a reason to do nothing rather than a step to force:
#
#   agent loaded         -> KeepAlive owns the restart; never race it
#   socket answers       -> something serves this home already; fail closed
#   absent < N cycles    -> a bootout/bootstrap window is not a crash.
#                           lastdb-safe-upgrade boots the agent out and back in
#                           during its live step, and that window must never be
#                           mistaken for one. Requiring the state to persist
#                           across cycles costs one minute of downtime and
#                           removes the only way this can fight an upgrade.
#   hold file present    -> an operator or an upgrade declared a maintenance
#                           window (LASTDBD_GUARD_REVIVE_HOLD_FILE)
#   .paused-* marker     -> deliberately parked; same convention as
#                           last-stack-forge-runner-watchdog
#   no unique plist for
#     THIS primary home  -> we do not guess which daemon to start. This machine
#                           also carries a lastdbd-bob agent and many .bak-*
#                           copies; starting the wrong daemon against the wrong
#                           home is worse than staying down.
#   preflight exit 3     -> human clearance required
REVIVE_ENABLED="${LASTDBD_GUARD_REVIVE:-1}"
REVIVE_MIN_ABSENT_CYCLES="${LASTDBD_GUARD_REVIVE_MIN_ABSENT_CYCLES:-2}"
REVIVE_WAIT_SEC="${LASTDBD_GUARD_REVIVE_WAIT_SEC:-30}"
PLIST_DIR="${LASTDBD_GUARD_PLIST_DIR:-$HOME/Library/LaunchAgents}"
ABSENT_STATE="${LOG_DIR}/lastdbd-absent.state"
REVIVE_HOLD_FILE="${LASTDBD_GUARD_REVIVE_HOLD_FILE:-${LOG_DIR}/lastdbd-revive.hold}"

# Dependency-free, and deliberately NOT event(): that helper reads the gauge
# globals, none of which exist on the path where there is no process to gauge.
revive_event() {
  printf '{"ts":"%s","event":"%s","agent":"%s","absent_cycles":%s,"new_pid":%s}\n' \
    "$(ts)" "$1" "$2" "${3:-0}" "${4:-null}" >>"$EVENT_LOG"
}

absent_cycles() {
  local n=0
  if [ -f "$ABSENT_STATE" ]; then
    n=$(cat "$ABSENT_STATE" 2>/dev/null || echo 0)
  fi
  case "$n" in
    ''|*[!0-9]*) n=0 ;;
  esac
  echo "$n"
}

bump_absent() {
  local n
  n=$(( $(absent_cycles) + 1 ))
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  echo "$n" >"$ABSENT_STATE" 2>/dev/null || true
  echo "$n"
}

clear_absent() {
  rm -f "$ABSENT_STATE" 2>/dev/null || true
}

situations_cmd() {
  if [ -n "${LASTDBD_GUARD_NOTICE_CMD:-}" ]; then
    printf '%s\n' "$LASTDBD_GUARD_NOTICE_CMD"
  elif [ -x "$HOME/.local/bin/situations" ]; then
    printf '%s\n' "$HOME/.local/bin/situations"
  else
    printf 'situations\n'
  fi
}

# Resolve the LaunchAgent that owns THIS primary home. An explicit label wins.
# Otherwise require exactly one on-disk plist that both names a lastdbd primary
# and mentions this home; anything else is ambiguous and we refuse.
primary_agent_label() {
  if [ -n "$PRIMARY_AGENT_LABEL" ]; then
    printf '%s\n' "$PRIMARY_AGENT_LABEL"
    return 0
  fi
  local f found="" n=0
  for f in "$PLIST_DIR"/*lastdbd-primary*.plist; do
    [ -f "$f" ] || continue
    grep -q "$PRIMARY_HOME" "$f" 2>/dev/null || continue
    found=$(basename "$f" .plist)
    n=$((n + 1))
  done
  if [ "$n" -ne 1 ]; then
    return 1
  fi
  printf '%s\n' "$found"
}

agent_loaded() {
  launchctl list 2>/dev/null | awk -v l="$1" '$3 == l { f = 1 } END { exit !f }'
}

# A lane is deliberately parked only when a .paused-* plist exists and the live
# plist does not. That is the marker a human pause leaves behind.
deliberately_paused() {
  local live="$PLIST_DIR/$1.plist" parked
  parked=$(ls "$PLIST_DIR" 2>/dev/null | grep -c "^$1\.plist\.paused-" || true)
  case "$parked" in
    ''|*[!0-9]*) parked=0 ;;
  esac
  [ ! -f "$live" ] && [ "$parked" -gt 0 ]
}

# Anything answering on the primary socket means a daemon owns this home even if
# our process selector missed it. Bootstrapping a second one would be worse than
# the outage, so this is a hard stop rather than a hint.
#
# It has to be a real HTTP status. `curl -w '%{http_code}'` STILL writes the
# write-out when the connection itself fails, as the literal string 000, so a
# non-empty code is not evidence of anything — an unreachable socket produces
# one. Measured against the real curl on 2026-09-03: a missing socket returned
# "000" here and an earlier draft of this function read it as "answers", which
# would have disabled revival on exactly the machine state it exists for. The
# fixtures did not catch it because their curl shim exits 7 with no output.
socket_answers() {
  local blob
  blob=$(unix_get "http://localhost/api/status")
  split_http_body "$blob" || return 1
  case "$IDENTITY_HTTP_CODE" in
    [1-5][0-9][0-9]) return 0 ;;
    *) return 1 ;;
  esac
}

revive_preflight_ok() {
  local sit rc
  sit=$(situations_cmd)
  if ! command -v "$sit" >/dev/null 2>&1 && [ ! -x "$sit" ]; then
    return 0
  fi
  set +e
  "$sit" preflight --action revive-primary-lastdbd >/dev/null 2>&1
  rc=$?
  set -e
  if [ "$rc" -eq 3 ]; then
    return 1
  fi
  return 0
}

revive_notice_slug() {
  printf 'lastdb-memory-guard-revive-%s-%s\n' \
    "$(date -u +%Y%m%dT%H%M%SZ | tr 'A-Z' 'a-z')" "$1"
}

# Agents that hit socket errors during the outage need to be able to tell this
# apart from a live incident, which is the whole point of a notice.
post_revive_notice() {
  local label="$1" new_pid="$2" cmd slug out rc
  cmd=$(situations_cmd)
  slug="$(revive_notice_slug "$new_pid")"
  set +e
  out=$("$cmd" notice \
    --slug "$slug" \
    --title "LastDB memory guard revived the primary LaunchAgent" \
    --kind restart \
    --system lastdbd \
    --system primary-brain \
    --actor agent:lastdb-memory-guard \
    --severity-hint warn \
    --expires-hours 24 \
    --summary "primary lastdbd was absent and ${label} was not loaded, so KeepAlive could not revive it; bootstrapped the agent, new pid ${new_pid}. Socket refusals before this timestamp are that outage, not a new incident." \
    2>&1)
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    log "notice posted slug=$slug revive_agent=$label new_pid=$new_pid"
  else
    log "WARN notice_failed rc=$rc slug=$slug revive_agent=$label new_pid=$new_pid reason=$(printf '%s' "$out" | tr '\n' ' ' | head -c 300)"
  fi
}

revive_primary() {
  local label plist absent new_pid waited
  if [ "$REVIVE_ENABLED" != "1" ]; then
    log "ok no_primary_lastdbd revive=disabled"
    return 0
  fi
  label=$(primary_agent_label || true)
  if [ -z "$label" ]; then
    log "ok no_primary_lastdbd revive=skipped reason=no_unique_primary_plist dir=$PLIST_DIR home=$PRIMARY_HOME"
    return 0
  fi
  if agent_loaded "$label"; then
    clear_absent
    log "ok no_primary_lastdbd agent=$label loaded=yes — KeepAlive owns the restart"
    return 0
  fi
  if socket_answers; then
    log "ok no_primary_lastdbd agent=$label loaded=no but socket=$SOCKET answers — not reviving"
    return 0
  fi
  if deliberately_paused "$label"; then
    log "ok no_primary_lastdbd agent=$label parked=yes (.paused-* marker) — not reviving"
    return 0
  fi
  if [ -f "$REVIVE_HOLD_FILE" ]; then
    log "ok no_primary_lastdbd agent=$label revive=held file=$REVIVE_HOLD_FILE"
    return 0
  fi
  absent=$(bump_absent)
  if [ "$absent" -lt "$REVIVE_MIN_ABSENT_CYCLES" ]; then
    log "warn no_primary_lastdbd agent=$label loaded=no absent_cycles=$absent/$REVIVE_MIN_ABSENT_CYCLES — waiting (a bootout/bootstrap window is not a crash)"
    return 0
  fi
  plist="$PLIST_DIR/$label.plist"
  if [ ! -f "$plist" ]; then
    log "WARN no_primary_lastdbd agent=$label revive=skipped reason=no_plist path=$plist"
    return 0
  fi
  if ! revive_preflight_ok; then
    log "WARN no_primary_lastdbd agent=$label revive=blocked reason=situations_preflight_exit_3"
    return 0
  fi
  revive_event revive_requested "$label" "$absent" null
  log "REVIVE primary lastdbd agent=$label plist=$plist absent_cycles=$absent (launchctl enable + bootstrap)"
  # `launchctl disable` outlives a plist rename and silently defeats bootstrap,
  # so enable must come first. That is what made the 2026-07-29 forge-primary
  # restore look like an opaque I/O error.
  launchctl enable "gui/$(id -u)/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || true
  new_pid=""
  waited=0
  while [ "$waited" -lt "$REVIVE_WAIT_SEC" ]; do
    # A process alone is not the recovery. The outage is defined by the socket,
    # so the socket is what has to answer before we call this verified.
    new_pid=$(primary_pid || true)
    if [ -n "$new_pid" ] && socket_answers; then
      break
    fi
    new_pid=""
    sleep 1
    waited=$((waited + 1))
  done
  if [ -n "$new_pid" ]; then
    clear_absent
    revive_event revive_observed "$label" "$absent" "$new_pid"
    log "revive verified agent=$label new_pid=$new_pid waited_sec=$waited"
    post_revive_notice "$label" "$new_pid"
  else
    log "WARN revive_unverified agent=$label wait_sec=$REVIVE_WAIT_SEC event_log=$EVENT_LOG"
  fi
  return 0
}

# --- main ---
if [ "${1:-}" = "--identity" ]; then
  identity
  exit $?
fi
if [ "$#" -ne 0 ]; then
  echo "usage: last-stack-lastdb-memory-guard [--identity]" >&2
  exit 2
fi

pid=$(primary_pid || true)
if [ -z "${pid:-}" ]; then
  # No process is not "ok" — it is the outage. See the primary revival block.
  revive_primary
  exit 0
fi
clear_absent

rss=$(rss_mb_of "$pid")
swap=$(swap_used_mb 2>/dev/null || true)
cmd=$(ps -p "$pid" -o command= 2>/dev/null | head -c 200 || true)

# phys_footprint comes from the kernel via proc_pid_rusage, not this daemon's
# own /api/status — see phys_footprint_mb_of. That means a steady-state "ok"
# cycle makes zero calls to the node's HTTP path.
footprint_reading=$(phys_footprint_mb_of "$pid")
# Three fields now: value, source, lifetime peak. Read them positionally —
# `${reading#* }` would hand the source and the peak back as one token.
read -r footprint footprint_source peak <<EOF
$footprint_reading
EOF
peak="${peak:-0}"

metric="$GUARD_METRIC"
if [ "$metric" = "footprint" ]; then
  enforced="$footprint"
else
  enforced="$rss"
fi

# peak_mb is the process-lifetime high water mark, on every cycle beside the
# instant. The 60 s sampling interval means the instant series MISSES
# excursions: `lastdb status` reported a 17.32 GiB peak for pid 40502 while the
# highest of 623 guard samples for the same pid was 15.93 GiB. The node went
# 1.39 GiB past the line and no guard log line knew. Carrying the peak makes
# the excursion rate above the limit countable from this log alone. It is
# OBSERVATION ONLY — nothing enforces on it, by design, until that rate has
# been counted. 0 means unavailable, not "never grew".
log_checked ok "ok pid=$pid metric=$metric enforced_mb=$enforced limit_mb=$RSS_LIMIT_MB rss_mb=$rss footprint_mb=$footprint peak_mb=$peak footprint_source=$footprint_source swap_mb=${swap:-unknown}"

# Keep the old RSS policy explicit and visible when an operator selects it.
# Swap remains in the status line for diagnosis, but swap use does not trigger
# an alert or restart. On macOS, swap use alone is not a capacity signal.
if [ "$metric" = "rss" ] && [ "$footprint" -ge "$RSS_LIMIT_MB" ] 2>/dev/null; then
  log "WARN blind_spot pid=$pid footprint_mb=$footprint >= limit_mb=$RSS_LIMIT_MB but enforcing on rss_mb=$rss — guard will NOT fire; see LASTDBD_GUARD_METRIC"
fi

if [ "$enforced" -lt "$RSS_LIMIT_MB" ]; then
  exit 0
fi

if ! cooldown_ok; then
  log "over_limit pid=$pid metric=$metric enforced_mb=$enforced but cooldown active — skip restart"
  exit 0
fi

log_checked over_limit_candidate "over_limit_candidate pid=$pid metric=$metric enforced_mb=$enforced limit_mb=$RSS_LIMIT_MB rss_mb=$rss footprint_mb=$footprint peak_mb=$peak footprint_source=$footprint_source swap_mb=${swap:-unknown} cmd=$cmd"

# One sample is not evidence. Confirm before the killer runs. OVER_LIMIT stays
# the line that means "the guard acted", so counting restarts in this log does
# not change meaning; the new candidate/transient lines carry what was rejected.
if ! confirm_over_limit "$pid" "$enforced"; then
  exit 0
fi

log_checked OVER_LIMIT "OVER_LIMIT pid=$pid metric=$metric enforced_mb=$enforced limit_mb=$RSS_LIMIT_MB rss_mb=$rss footprint_mb=$footprint peak_mb=$peak footprint_source=$footprint_source swap_mb=${swap:-unknown} cmd=$cmd"
# build is only needed for the restart notice, so only fetch it (via the
# node's own status/boot-identity route) on the rare over-limit path — the
# steady-state cycle above never touches /api/status.
read_status
build=$(status_build "$STATUS_BODY")
restart_primary "$pid" "$enforced"
exit 0
