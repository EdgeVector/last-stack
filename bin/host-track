#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  source_dir="$(cd "$(dirname "$SOURCE")" && pwd -P)"
  link_target="$(readlink "$SOURCE")"
  case "$link_target" in
    /*) SOURCE="$link_target" ;;
    *) SOURCE="$source_dir/$link_target" ;;
  esac
done
# Prefer an explicit root when re-exec'd from a temp copy so install can rewrite
# the live tree without unmapping the running script (self-replace safety).
if [ -n "${HOST_TRACK_ROOT:-}" ] && [ -d "${HOST_TRACK_ROOT}" ]; then
  ROOT="$HOST_TRACK_ROOT"
else
  ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd -P)"
fi
if [ -n "${HOST_TRACK_REGISTRY:-}" ]; then
  REGISTRY="$HOST_TRACK_REGISTRY"
  REGISTRY_IS_DEFAULT=0
elif [ -f "$ROOT/config/host-track/apps.json" ]; then
  REGISTRY="$ROOT/config/host-track/apps.json"
  REGISTRY_IS_DEFAULT=1
else
  REGISTRY="$HOME/.local/share/last-stack/config/host-track/apps.json"
  REGISTRY_IS_DEFAULT=1
fi
STAMP_DIR="${HOST_TRACK_STAMP_DIR:-$HOME/.host-track/stamps}"
ARTIFACT_ROOT_DEFAULT="${HOST_TRACK_ARTIFACT_ROOT:-$HOME/.lastgit/artifacts}"
INSTALL_ROOT_DEFAULT="${HOST_TRACK_INSTALL_ROOT:-$HOME/.host-track/apps}"
# Serialize install/refresh/rollback so concurrent launchd + post-merge + manual
# refreshes cannot half-stage a version and then repoint current/PATH at it.
HOST_TRACK_LOCK_DIR="${HOST_TRACK_LOCK_DIR:-$HOME/.host-track/locks}"
HOST_TRACK_INSTALL_LOCK_WAIT_S="${HOST_TRACK_INSTALL_LOCK_WAIT_S:-300}"
HOST_TRACK_INSTALL_LOCK_STALE_S="${HOST_TRACK_INSTALL_LOCK_STALE_S:-900}"
INSTALL_LOCK_HELD=""
REGISTRY_SYNC_ATTEMPTED=0

# Re-exec from a private temp copy for install mutations so replacing
# ~/.local/bin/host-track (or deleting the live versions/* tree mid-restage)
# cannot unmap the running bash script. ROOT is preserved via HOST_TRACK_ROOT.
maybe_reexec_for_mutation() {
  case "${1:-}" in
    refresh|install|rollback|soak-watch) ;;
    *) return 0 ;;
  esac
  [ -z "${HOST_TRACK_REEXECED:-}" ] || return 0
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/host-track.XXXXXX")"
  # Prefer the resolved real script content (under versions/…), not a PATH shim.
  if [ -r "$SOURCE" ]; then
    cp "$SOURCE" "$tmp"
  else
    cp "${BASH_SOURCE[0]}" "$tmp" 2>/dev/null || return 0
  fi
  chmod +x "$tmp"
  export HOST_TRACK_REEXECED=1
  export HOST_TRACK_ROOT="$ROOT"
  exec "$tmp" "$@"
}

usage() {
  cat >&2 <<'EOF'
Usage:
  host-track status [--json] [--stale] [app]
  host-track which [--json] <app>
  host-track check <app>
  host-track validate-registry [--json]
  host-track refresh [--force] [--force-if-stale] [--activate] (<app>|--all)
  host-track soak-watch [<app>|--all]
  host-track install [--channel candidate|canary|stable] <app>
  host-track rollback <app>

Environment:
  HOST_TRACK_REGISTRY   Registry JSON path (default: last-stack config)
  HOST_TRACK_STAMP_DIR  Stamp directory (default: ~/.host-track/stamps)
  HOST_TRACK_ARTIFACT_ROOT  LastGit artifact CAS (default: ~/.lastgit/artifacts)
  HOST_TRACK_INSTALL_ROOT   Immutable app installs (default: ~/.host-track/apps)
  HOST_TRACK_PROBE_SKIP=1   Tom-only: skip functional probe (do not use casually)
  HOST_TRACK_PROBE_ATTEMPTS  Probe attempts after a transient failure (default 3, max 5)
  HOST_TRACK_PROBE_RETRY_DELAY_S  Delay between probe attempts (default 1, max 10)
  HOST_TRACK_PROBE_LAT_RATIO   Candidate vs current latency fail ratio (default 3)
  HOST_TRACK_PROBE_LAT_FLOOR_MS  Ignore latency below this (default 1000)
  HOST_TRACK_ACTIVATE=1     Flip current after GREEN probe (skip soak)
  HOST_TRACK_SOAK_HOURS     Override registry soak window
EOF
}

die() {
  # Always drop the install lock before process exit (RETURN traps do not run on exit).
  release_install_lock 2>/dev/null || true
  printf 'host-track: %s\n' "$*" >&2
  exit 2
}

need_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required"
}

expand_path() {
  case "${1:-}" in
    "") printf '\n' ;;
    '$HOME') printf '%s\n' "$HOME" ;;
    '$HOME'/*) printf '%s/%s\n' "$HOME" "${1#\$HOME/}" ;;
    "~") printf '%s\n' "$HOME" ;;
    "~"/*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

app_json() {
  local app="$1"
  jq -c --arg app "$app" '.apps[]? | select(.app == $app)' "$REGISTRY"
}

maybe_sync_default_registry() {
  local self_upgrade
  [ "$REGISTRY_IS_DEFAULT" -eq 1 ] || return 1
  [ "$REGISTRY_SYNC_ATTEMPTED" -eq 0 ] || return 1
  REGISTRY_SYNC_ATTEMPTED=1

  self_upgrade="$ROOT/bin/last-stack-self-upgrade"
  [ -x "$self_upgrade" ] || return 1
  "$self_upgrade" --reason=host-track-registry-miss >/dev/null 2>&1 || return 1

  if [ -f "$ROOT/config/host-track/apps.json" ]; then
    REGISTRY="$ROOT/config/host-track/apps.json"
  fi
  return 0
}

require_app_json() {
  local app="$1" json
  json="$(app_json "$app")"
  if [ -z "$json" ]; then
    maybe_sync_default_registry || true
    json="$(app_json "$app")"
  fi
  [ -n "$json" ] || die "unknown app: $app"
  printf '%s\n' "$json"
}

field() {
  local json="$1" key="$2"
  printf '%s\n' "$json" | jq -r --arg key "$key" '.[$key] // ""'
}

setting() {
  local json="$1" key="$2" value
  value="$(field "$json" "$key")"
  if [ -z "$value" ]; then
    value="$(jq -r --arg key "$key" '.defaults[$key] // ""' "$REGISTRY")"
  fi
  printf '%s\n' "$value"
}

safe_upgrade_setting() {
  # .safe_upgrade.<key> from the app entry, else .defaults.safe_upgrade.<key>.
  # An explicit 0/false in the entry wins over the default (only absence
  # inherits) — opting out must stay expressible.
  local json="$1" key="$2" fallback="${3:-}" value
  value="$(printf '%s\n' "$json" | jq -r --arg key "$key" '.safe_upgrade[$key] // "" | tostring')"
  if [ -z "$value" ]; then
    value="$(jq -r --arg key "$key" '.defaults.safe_upgrade[$key] // "" | tostring' "$REGISTRY")"
  fi
  [ -n "$value" ] || value="$fallback"
  printf '%s\n' "$value"
}

git_head() {
  local path="$1"
  [ -n "$path" ] || return 0
  git -C "$path" rev-parse HEAD 2>/dev/null || true
}

git_head_short() {
  local path="$1"
  [ -n "$path" ] || return 0
  git -C "$path" rev-parse --short HEAD 2>/dev/null || true
}

version_file() {
  local path="$1"
  [ -n "$path" ] || return 0
  [ -f "$path/VERSION" ] || return 0
  sed -n '1p' "$path/VERSION"
}

git_dirty() {
  local path="$1"
  [ -n "$path" ] || return 1
  [ -d "$path/.git" ] || return 1
  [ -z "$(git -C "$path" status --porcelain)" ]
}

gate_head() {
  local host_track="$1" remote="$2" ref="$3"
  [ -n "$host_track" ] || return 0
  [ -n "$remote" ] || return 0
  [ -n "$ref" ] || return 0
  git -C "$host_track" ls-remote "$remote" "$ref" 2>/dev/null | awk 'NR == 1 {print $1}' || true
}

remote_head() {
  local remote="$1" ref="$2"
  [ -n "$remote" ] || return 0
  [ -n "$ref" ] || return 0
  git ls-remote "$remote" "$ref" 2>/dev/null | awk 'NR == 1 {print $1}' || true
}

binary_version() {
  local path="$1"
  [ -x "$path" ] || return 0
  # A LastSecrets locator is not itself a Sentry DSN. Version inspection must
  # remain report-only even when the scheduled shell carries that locator.
  env -u OBS_SENTRY_DSN "$path" --version 2>/dev/null | sed -n '1p' || true
}

binary_version_oid() {
  local version="$1"
  printf '%s\n' "$version" | sed -nE 's/.*-g([0-9a-fA-F]{7,40})(-dirty)?$/\1/p' | tr 'A-F' 'a-f'
}

expand_commit_oid() {
  local cache="$1" oid="$2" expanded
  [ -n "$cache" ] && [ -n "$oid" ] && [ -d "$cache" ] || return 0
  expanded="$(git --git-dir="$cache" rev-parse --verify "${oid}^{commit}" 2>/dev/null || true)"
  case "$expanded" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) printf '%s\n' "$expanded" ;;
  esac
}

commit_distance() {
  local cache="$1" installed="$2" gate="$3"
  [ -d "$cache" ] && [ -n "$installed" ] && [ -n "$gate" ] || return 0
  git --git-dir="$cache" rev-list --count "$installed..$gate" 2>/dev/null || true
}

command_path() {
  local command_name="$1"
  [ -n "$command_name" ] || return 0
  command -v "$command_name" 2>/dev/null || true
}

hash_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    die "shasum or sha256sum is required"
  fi
}

artifact_paths() {
  local app="$1" json="$2" artifact_app channel artifact_root install_root
  artifact_app="$(field "$json" artifact_app)"
  [ -n "$artifact_app" ] || artifact_app="$app"
  channel="$(setting "$json" artifact_channel)"
  [ -n "$channel" ] || channel="stable"
  artifact_root="$(expand_path "$(setting "$json" artifact_root)")"
  [ -n "$artifact_root" ] || artifact_root="$ARTIFACT_ROOT_DEFAULT"
  install_root="$(expand_path "$(field "$json" install_root)")"
  [ -n "$install_root" ] || install_root="$INSTALL_ROOT_DEFAULT/$app"
  printf '%s\t%s\t%s\t%s\n' "$artifact_app" "$channel" "$artifact_root" "$install_root"
}

artifact_channel_manifest() {
  local artifact_root="$1" artifact_app="$2" channel="$3" path
  path="$artifact_root/channels/$artifact_app/$channel.json"
  [ -f "$path" ] || return 0
  jq -r '.manifest_digest // ""' "$path" 2>/dev/null || true
}

# lastgit often emits the payload JSON plus a trailing verb_timing event on stdout.
# Keep the first complete JSON object that matches the caller's jq filter.
json_first_object() {
  local filter="${1:-.}"
  python3 -c '
import json, sys
filt = sys.argv[1]
raw = sys.stdin.read()
dec = json.JSONDecoder()
idx = 0
while idx < len(raw):
    while idx < len(raw) and raw[idx].isspace():
        idx += 1
    if idx >= len(raw):
        break
    try:
        obj, end = dec.raw_decode(raw, idx)
    except json.JSONDecodeError:
        break
    idx = end
    if not isinstance(obj, dict):
        continue
    # Apply a tiny jq-like existence check for common filters.
    if filt == "." or True:
        # Prefer non-timing payloads when mixed.
        if obj.get("event") == "verb_timing":
            continue
        json.dump(obj, sys.stdout)
        sys.exit(0)
sys.exit(1)
' "$filter" 2>/dev/null
}

# Platform directory name under LastGit artifact builds/ (matches CI publisher).
artifact_platform_name() {
  local sys mach
  sys="$(uname -s 2>/dev/null || true)"
  mach="$(uname -m 2>/dev/null || true)"
  case "${sys}-${mach}" in
    Darwin-arm64) printf 'darwin-arm64\n' ;;
    Darwin-x86_64) printf 'darwin-x64\n' ;;
    Linux-x86_64|Linux-amd64) printf 'linux-x64\n' ;;
    Linux-aarch64|Linux-arm64) printf 'linux-arm64\n' ;;
    *) printf 'darwin-arm64\n' ;; # local dogfood default
  esac
}

# Parse lastdb:///<repo>#main (or #refs/heads/main) into repo + ref name.
parse_lastdb_gate_main() {
  local gate_main="$1" rest repo ref
  case "$gate_main" in
    lastdb:///*)
      rest="${gate_main#lastdb:///}"
      repo="${rest%%#*}"
      if [ "$rest" = "$repo" ]; then
        ref="main"
      else
        ref="${rest#*#}"
        ref="${ref#refs/heads/}"
        [ -n "$ref" ] || ref="main"
      fi
      printf '%s\t%s\n' "$repo" "$ref"
      ;;
    *) return 1 ;;
  esac
}

# True when this artifact app's runtime tracks gate_main.
# Tom mental model: Host Track follows green main, not a manually-promoted
# stable pointer that can lag forever.
#
# Default ON for every artifact-mode app gated on a LastGit main ref. This used
# to be opt-in per app, which meant an app could be registered correctly in
# every other respect and still silently never advance: `remote` sat on a
# hand-promoted 2026-07-31 pointer for 8 days, shipping a known-broken `ra`
# shim, because its entry simply lacked the flag. Opt-in defaults fail quietly
# in exactly the place nobody looks.
#
# Checkout-mode apps are excluded by the install_mode test — lastgit is
# bootstrap-recovery and lastdb/lastdbd are deployment-only (live primary
# upgrades must stay on lastdb-safe-upgrade, never a Host Track refresh).
# An app can still opt out explicitly with "track_gate_main": false.
artifact_tracks_gate_main() {
  local json="$1" flag gate_main
  flag="$(field "$json" track_gate_main)"
  case "$flag" in
    1|true|yes|YES|True) return 0 ;;
    0|false|no|NO|False) return 1 ;;
  esac
  [ "$(field "$json" install_mode)" = "artifact" ] || return 1
  gate_main="$(field "$json" gate_main)"
  case "$gate_main" in lastdb:///*#main|lastdb:///*#refs/heads/main) return 0 ;; esac
  return 1
}

# Resolve one ref's oid with the POINT read, not the whole status drain.
#
# `lastgit ref <repo> <name>` is a single O(1) HashRange read of LastgitRef.
# `lastgit status --json` is nine requests, and three of them drain every
# LastgitPackInventory row in the repo to compute a pack footprint this
# function does not read. Measured on the live primary 2026-09-01 with
# lastgit's own meter (LASTGIT_NODE_COST=1), repo last-stack:
#
#     lastgit status last-stack --json   9 requests   657ms   recv 2.59 MB
#     lastgit ref    last-stack main     1 request     16ms   recv 1.7 KB
#
# Same oid from both paths, and `ref` reports source=point. The drain is
# O(packs-ever-pushed) and grows with every push
# (brain: papercut-lastgit-status-reads-every-pack-row-to-compute-four-numbers),
# so the gap widens over time. `lastgit ref` was added for THIS caller —
# src/ref-lookup.ts names host-track:361 as the production caller that pays
# eight requests to read one field — and every other consumer had already
# switched (last-stack-post-merge-safe-upgrade:414,478).
#
# Output is "<oid>\t<ref name>\t<point|partition>"; take field 1. A missing
# repo or ref exits 1 and prints nothing to stdout, which the 40-hex guard
# below already rejects, so the failure contract is unchanged.
artifact_main_tip() {
  local repo="$1" ref="${2:-main}" oid
  command -v lastgit >/dev/null 2>&1 || return 1
  oid="$(lastgit ref "$repo" "$ref" 2>/dev/null | awk 'NR==1{print $1}' || true)"
  [[ "$oid" =~ ^[0-9a-f]{40}$ ]] || return 1
  printf '%s\n' "$oid"
}

artifact_ci_success() {
  local repo="$1" oid="$2" state
  command -v lastgit >/dev/null 2>&1 || return 1
  state="$(
    lastgit ci status "$oid" --repo "$repo" --json 2>/dev/null \
      | json_first_object \
      | jq -r '.state // empty' 2>/dev/null || true
  )"
  [ "$state" = "success" ]
}

# Resolve published manifest digest for app@oid (builds/ first, then manifests/).
artifact_manifest_digest_for_oid() {
  local artifact_root="$1" artifact_app="$2" oid="$3" platform path digest f
  platform="$(artifact_platform_name)"
  path="$artifact_root/builds/$artifact_app/$oid/$platform.json"
  if [ -f "$path" ]; then
    digest="$(jq -r '.manifest_digest // empty' "$path" 2>/dev/null || true)"
    if [[ "$digest" =~ ^[0-9a-f]{64}$ ]]; then
      printf '%s\n' "$digest"
      return 0
    fi
  fi
  for f in "$artifact_root"/manifests/*.json; do
    [ -f "$f" ] || continue
    digest="$(jq -r --arg app "$artifact_app" --arg oid "$oid" '
      select(.app == $app and .source_oid == $oid) | .manifest_digest // empty
    ' "$f" 2>/dev/null || true)"
    if [[ "$digest" =~ ^[0-9a-f]{64}$ ]]; then
      printf '%s\n' "$digest"
      return 0
    fi
  done
  return 1
}

# Walk main tip → parents (when a bare cache exists) for first green+published oid.
artifact_deployable_main_oid() {
  local repo="$1" ref="$2" artifact_root="$3" artifact_app="$4" tip cache max_walk oid
  tip="$(artifact_main_tip "$repo" "$ref" || true)"
  [ -n "$tip" ] || return 1
  max_walk="${HOST_TRACK_MAIN_WALK_MAX:-40}"
  cache="${HOST_TRACK_GIT_CACHE:-$HOME/.cache/edgevector-git/$repo.git}"
  if [ -d "$cache" ] && command -v git >/dev/null 2>&1; then
    while IFS= read -r oid; do
      [ -n "$oid" ] || continue
      if artifact_manifest_digest_for_oid "$artifact_root" "$artifact_app" "$oid" >/dev/null \
        && artifact_ci_success "$repo" "$oid"; then
        printf '%s\n' "$oid"
        return 0
      fi
    done < <(git --git-dir="$cache" rev-list -n "$max_walk" "$tip" 2>/dev/null || true)
  fi
  # No cache (or walk empty): try tip only.
  if artifact_manifest_digest_for_oid "$artifact_root" "$artifact_app" "$tip" >/dev/null \
    && artifact_ci_success "$repo" "$tip"; then
    printf '%s\n' "$tip"
    return 0
  fi
  return 1
}

# Promote stable (or channel) to deployable main oid when it is ahead of channel.
# Best-effort: failures leave channel unchanged so install can still use last good.
artifact_promote_channel_to_main() {
  local app="$1" json="$2" channel_override="${3:-}"
  local artifact_app channel artifact_root install_root gate_main repo ref
  local main_tip deploy_oid digest channel_oid channel_path
  artifact_tracks_gate_main "$json" || return 0
  IFS=$'\t' read -r artifact_app channel artifact_root install_root < <(artifact_paths "$app" "$json")
  [ -z "$channel_override" ] || channel="$channel_override"
  gate_main="$(field "$json" gate_main)"
  IFS=$'\t' read -r repo ref < <(parse_lastdb_gate_main "$gate_main" || true)
  [ -n "$repo" ] || return 0
  main_tip="$(artifact_main_tip "$repo" "$ref" || true)"
  deploy_oid="$(artifact_deployable_main_oid "$repo" "$ref" "$artifact_root" "$artifact_app" || true)"
  [ -n "$deploy_oid" ] || {
    if [ -n "$main_tip" ]; then
      printf 'host-track: %s main tip %s not yet green+published; keeping channel=%s\n' \
        "$app" "${main_tip:0:12}" "$channel" >&2
    fi
    return 0
  }
  channel_path="$artifact_root/channels/$artifact_app/$channel.json"
  channel_oid="$(jq -r '.source_oid // empty' "$channel_path" 2>/dev/null || true)"
  if [ "$channel_oid" = "$deploy_oid" ]; then
    return 0
  fi
  digest="$(artifact_manifest_digest_for_oid "$artifact_root" "$artifact_app" "$deploy_oid" || true)"
  [ -n "$digest" ] || return 0
  printf 'host-track: %s promoting %s → %s (main-track oid=%s tip=%s)\n' \
    "$app" "$channel" "${digest:0:12}" "${deploy_oid:0:12}" "${main_tip:0:12}" >&2
  if ! lastgit artifact promote \
    --app "$artifact_app" \
    --channel "$channel" \
    --manifest "$digest" \
    --repo "$repo" \
    --oid "$deploy_oid" \
    --context ci-required \
    --root "$artifact_root" \
    --json >/dev/null 2>&1; then
    printf 'host-track: %s promote failed for oid=%s (will install current channel if any)\n' \
      "$app" "${deploy_oid:0:12}" >&2
    return 0
  fi
  return 0
}


# Fleet policy (North Star end-state #6): every registered app is either
# install_mode=artifact or carries a machine-readable artifact_exemption.
# local-safe / bare checkout without exemption → registry_compliance=non_compliant
# (expected red until producers migrate those apps).
registry_exemption_json() {
  local json="$1"
  printf '%s\n' "$json" | jq -c '
    if (.artifact_exemption | type) == "object" then
      {
        kind: (.artifact_exemption.kind // null),
        owner: (.artifact_exemption.owner // null),
        rationale: (.artifact_exemption.rationale // null)
      }
    else
      null
    end
  '
}

registry_compliance_for() {
  local json="$1" install_mode="$2"
  local kind owner rationale
  if [ "$install_mode" = "artifact" ]; then
    printf 'artifact\n'
    return 0
  fi
  kind="$(printf '%s\n' "$json" | jq -r '.artifact_exemption.kind // ""')"
  owner="$(printf '%s\n' "$json" | jq -r '.artifact_exemption.owner // ""')"
  rationale="$(printf '%s\n' "$json" | jq -r '.artifact_exemption.rationale // ""')"
  case "$kind" in
    deployment-only|bootstrap-recovery)
      if [ -n "$owner" ] && [ -n "$rationale" ]; then
        printf 'exempt\n'
        return 0
      fi
      ;;
  esac
  printf 'non_compliant\n'
}

status_json_for() {
  local app="$1" json kind command_name gate gate_main host_track_raw host_track refresh_raw refresh_path
  local gate_remote gate_ref notes exec_path host_head host_head_short version gate_tip stale stamp_path
  local install_mode artifact_app artifact_channel artifact_root install_root installed_digest channel_digest
  local stamp_install_mode stamp_current
  local track_repo track_ref main_tip channel_oid artifact_current artifact_previous artifact_problem
  local exemption_kind deployment_binary deployment_peer_binary deployment_repo_cache
  local deployment_version deployment_head deployment_peer_version deployment_peer_head
  local deployment_pair_match deployment_problem behind_by distance deployment_expanded
  local main_unpublished freshness soak_state soak_checks soak_min post_flip_ticks_left

  json="$(require_app_json "$app")"
  kind="$(field "$json" kind)"
  command_name="$(field "$json" command)"
  gate="$(field "$json" gate)"
  gate_main="$(field "$json" gate_main)"
  host_track_raw="$(field "$json" host_track)"
  host_track="$(expand_path "$host_track_raw")"
  refresh_raw="$(field "$json" refresh)"
  refresh_path="$(expand_path "$refresh_raw")"
  gate_remote="$(field "$json" gate_remote)"
  gate_ref="$(field "$json" gate_ref)"
  notes="$(field "$json" notes)"
  install_mode="$(setting "$json" install_mode)"
  [ -n "$install_mode" ] || install_mode="checkout"
  exec_path="$(command_path "$command_name")"
  stamp_path="$STAMP_DIR/$app.json"
  exemption_kind="$(printf '%s\n' "$json" | jq -r '.artifact_exemption.kind // ""')"

  artifact_app=""
  artifact_channel=""
  artifact_root=""
  install_root=""
  installed_digest=""
  channel_digest=""
  artifact_current=""
  artifact_previous=""
  artifact_problem=""
  main_unpublished="false"
  soak_state=""
  soak_checks="null"
  soak_min="null"
  post_flip_ticks_left="null"
  deployment_version=""
  deployment_head=""
  deployment_peer_version=""
  deployment_peer_head=""
  deployment_pair_match="null"
  deployment_problem=""
  behind_by="null"
  if [ "$install_mode" = "artifact" ]; then
    IFS=$'\t' read -r artifact_app artifact_channel artifact_root install_root < <(artifact_paths "$app" "$json")
    host_track="$install_root/current"
    artifact_current="$(artifact_pointer_target "$install_root" current || true)"
    artifact_previous="$(artifact_pointer_target "$install_root" previous || true)"
    artifact_problem="$(artifact_install_problem "$install_root" || true)"
    installed_digest="$(jq -r '.manifest_digest // ""' "$stamp_path" 2>/dev/null || true)"
    channel_digest="$(artifact_channel_manifest "$artifact_root" "$artifact_app" "$artifact_channel")"
    host_head="$(jq -r '.source_oid // ""' "$stamp_path" 2>/dev/null || true)"
    host_head_short="${host_head:0:12}"
    channel_oid="$(jq -r '.source_oid // ""' "$artifact_root/channels/$artifact_app/$artifact_channel.json" 2>/dev/null || true)"
    # gate_head for check/stale is the published channel oid, not lastgit main.
    # Unpublished main is main_unpublished. Pickup must not wait on that lag.
    gate_tip="$channel_oid"
    version=""
    stale="null"
    main_unpublished="false"
    main_tip=""
    # Report unpublished main whenever gate_main is knowable. Auto-promote
    # still requires track_gate_main; pickup must not wait on that opt-in.
    if [ -n "$gate_main" ] && IFS=$'\t' read -r track_repo track_ref < <(parse_lastdb_gate_main "$gate_main" || true); then
      main_tip="$(artifact_main_tip "$track_repo" "$track_ref" || true)"
      if [ -n "$main_tip" ] && [ -n "$channel_oid" ] && [ "$main_tip" != "$channel_oid" ]; then
        main_unpublished="true"
      fi
    fi
    if [ -n "$channel_digest" ]; then
      if [ "$installed_digest" = "$channel_digest" ] && [ -L "$install_root/current" ]; then
        stale="false"
      else
        stale="true"
      fi
    fi
    if [ -n "$artifact_problem" ]; then
      stale="true"
    fi
    # Soak state: a parked canary is the system working, not staleness.
    if [ -L "$install_root/canary" ] && [ -f "$(soak_stamp_path "$app")" ]; then
      soak_state="$(jq -r '.status // ""' "$(soak_stamp_path "$app")" 2>/dev/null || true)"
      soak_checks="$(jq -r '.checks // 0' "$(soak_stamp_path "$app")" 2>/dev/null || true)"
      [[ "$soak_checks" =~ ^[0-9]+$ ]] || soak_checks="null"
      soak_min="$(min_checks_for "$json")"
      [[ "$soak_min" =~ ^[0-9]+$ ]] || soak_min="null"
    fi
    if [ -f "$(post_flip_stamp_path "$app")" ]; then
      post_flip_ticks_left="$(jq -r '.ticks_left // 0' "$(post_flip_stamp_path "$app")" 2>/dev/null || true)"
      [[ "$post_flip_ticks_left" =~ ^[0-9]+$ ]] || post_flip_ticks_left="null"
    fi
  elif [ "$install_mode" = "local-safe" ]; then
    # Live current symlink is source of truth (stamp can lag / lie).
    # Stale means "installed is not gate_main tip" when tip is knowable —
    # never self-compare stamp↔symlink (papercut-host-track-local-safe-staleness-is-self-referential).
    install_root="$(expand_path "$(field "$json" install_root)")"
    [ -n "$install_root" ] || install_root="$INSTALL_ROOT_DEFAULT/$app"
    host_track="$install_root/current"
    stamp_install_mode="$(jq -r '.install_mode // ""' "$stamp_path" 2>/dev/null || true)"
    host_head="$(jq -r '.version_id // ""' "$stamp_path" 2>/dev/null || true)"
    stamp_current="$(jq -r '.current // ""' "$stamp_path" 2>/dev/null || true)"
    gate_tip=""
    stale="true"
    local_safe_install_ok=0
    if [ -L "$install_root/current" ]; then
      stamp_current="$(readlink "$install_root/current")"
      case "$stamp_current" in
        versions/*)
          host_head="${stamp_current#versions/}"
          if [[ "$host_head" =~ ^[0-9a-f]{40}$ ]] && [ -d "$install_root/$stamp_current" ]; then
            local_safe_install_ok=1
          fi
          ;;
      esac
    elif [ "$stamp_install_mode" = "local-safe" ] && [[ "$host_head" =~ ^[0-9a-f]{40}$ ]]; then
      stamp_current="$(jq -r '.current // ""' "$stamp_path" 2>/dev/null || true)"
      [ -n "$stamp_current" ] || stamp_current="versions/$host_head"
    fi
    # Prefer real main tip from gate_main (lastdb:///<repo>#main).
    if [ -n "$gate_main" ] && IFS=$'\t' read -r track_repo track_ref < <(parse_lastdb_gate_main "$gate_main" || true); then
      main_tip="$(artifact_main_tip "$track_repo" "$track_ref" || true)"
      if [ -n "$main_tip" ]; then
        gate_tip="$main_tip"
        if [ "$local_safe_install_ok" -eq 1 ] && [ "$host_head" = "$main_tip" ]; then
          stale="false"
        else
          stale="true"
        fi
      fi
    fi
    # Offline / tip-unknown fallback: integrity of the install only (not lag).
    if [ -z "$gate_tip" ] && [ "$local_safe_install_ok" -eq 1 ]; then
      stale="false"
    fi
    # Surface restorable previous like artifact status (for proof helpers).
    if [ -L "$install_root/previous" ]; then
      artifact_previous="$(readlink "$install_root/previous" || true)"
    fi
    if [ -L "$install_root/current" ]; then
      artifact_current="$(readlink "$install_root/current" || true)"
    fi
    host_head_short="${host_head:0:12}"
    version="$host_head"
  elif [ "$exemption_kind" = "deployment-only" ] && [ -n "$(field "$json" deployment_binary)" ]; then
    deployment_binary="$(expand_path "$(field "$json" deployment_binary)")"
    deployment_peer_binary="$(expand_path "$(field "$json" deployment_peer_binary)")"
    deployment_repo_cache="$(expand_path "$(field "$json" deployment_repo_cache)")"
    deployment_version="$(binary_version "$deployment_binary")"
    deployment_head="$(binary_version_oid "$deployment_version")"
    deployment_peer_version="$(binary_version "$deployment_peer_binary")"
    deployment_peer_head="$(binary_version_oid "$deployment_peer_version")"
    gate_tip="$(remote_head "$gate_remote" "$gate_ref")"
    if [ -n "$deployment_repo_cache" ]; then
      host_head="$(expand_commit_oid "$deployment_repo_cache" "$deployment_head")"
      [ -n "$host_head" ] || host_head="$deployment_head"
      if [ -n "$deployment_peer_head" ]; then
        deployment_expanded="$(expand_commit_oid "$deployment_repo_cache" "$deployment_peer_head")"
        [ -z "$deployment_expanded" ] || deployment_peer_head="$deployment_expanded"
      fi
    else
      host_head="$deployment_head"
    fi
    host_head_short="${host_head:0:12}"
    version="$deployment_version"
    exec_path="$deployment_binary"
    stale="true"
    if [ -z "$host_head" ]; then
      deployment_problem="installed binary has no parseable Git version stamp"
    elif [ -z "$gate_tip" ]; then
      deployment_problem="published gate head is unavailable"
    elif [ -z "$deployment_peer_head" ]; then
      deployment_problem="paired binary has no parseable Git version stamp"
    elif [ "$host_head" != "$deployment_peer_head" ]; then
      deployment_pair_match="false"
      deployment_problem="installed binary pair disagrees"
    else
      deployment_pair_match="true"
      if [ "$host_head" = "$gate_tip" ]; then stale="false"; fi
      distance="$(commit_distance "$deployment_repo_cache" "$host_head" "$gate_tip")"
      if [ -n "$distance" ]; then behind_by="$distance"; fi
    fi
  else
    host_head="$(git_head "$host_track")"
    host_head_short="$(git_head_short "$host_track")"
    version="$(version_file "$host_track")"
    gate_tip="$(gate_head "$host_track" "$gate_remote" "$gate_ref")"
    stale="null"
    if [ -n "$host_head" ] && [ -n "$gate_tip" ]; then
      if [ "$host_head" = "$gate_tip" ]; then stale="false"; else stale="true"; fi
    fi
  fi

  # freshness: pickup-facing classification (soft lag ≠ hard-broken).
  # - hard_broken: artifact_problem or missing/unusable current
  # - soft_stale: on channel, and lastgit main has no published package yet
  # - fresh: on channel and main is the published channel oid
  freshness="fresh"
  if [ "$install_mode" = "artifact" ]; then
    if [ -n "$artifact_problem" ]; then
      freshness="hard_broken"
    elif [ "$stale" = "true" ]; then
      if [ -n "$install_root" ] && current_target_is_live "$install_root" 2>/dev/null; then
        freshness="soft_stale"
      else
        freshness="hard_broken"
      fi
    elif [ "${main_unpublished:-false}" = "true" ]; then
      freshness="soft_stale"
    fi
  elif [ -n "$deployment_problem" ]; then
    freshness="hard_broken"
  elif [ "$stale" = "true" ]; then
    freshness="soft_stale"
  fi

  registry_compliance="$(registry_compliance_for "$json" "$install_mode")"
  artifact_exemption_json="$(registry_exemption_json "$json")"

  jq -c -n \
    --arg app "$app" \
    --arg command "$command_name" \
    --arg gate "$gate" \
    --arg gate_main "$gate_main" \
    --arg host_track "$host_track" \
    --arg host_head "$host_head" \
    --arg host_head_short "$host_head_short" \
    --arg version "$version" \
    --arg gate_head "$gate_tip" \
    --arg exec_path "$exec_path" \
    --arg kind "$kind" \
    --arg notes "$notes" \
    --arg refresh "$refresh_path" \
    --arg stamp "$stamp_path" \
    --arg install_mode "$install_mode" \
    --arg artifact_app "$artifact_app" \
    --arg artifact_channel "$artifact_channel" \
    --arg artifact_root "$artifact_root" \
    --arg install_root "$install_root" \
    --arg manifest_digest "$installed_digest" \
    --arg channel_manifest_digest "$channel_digest" \
    --arg artifact_current "$artifact_current" \
    --arg artifact_previous "$artifact_previous" \
    --arg artifact_problem "$artifact_problem" \
    --arg deployment_version "$deployment_version" \
    --arg deployment_peer_version "$deployment_peer_version" \
    --arg deployment_peer_head "$deployment_peer_head" \
    --arg deployment_problem "$deployment_problem" \
    --arg freshness "$freshness" \
    --arg registry_compliance "$registry_compliance" \
    --arg soak_state "$soak_state" \
    --argjson soak_checks "$soak_checks" \
    --argjson soak_min_checks "$soak_min" \
    --argjson post_flip_ticks_left "$post_flip_ticks_left" \
    --argjson artifact_exemption "$artifact_exemption_json" \
    --argjson stale "$stale" \
    --argjson main_unpublished "$main_unpublished" \
    --argjson behind_by "$behind_by" \
    --argjson binary_pair_match "$deployment_pair_match" \
    '{
      app: $app,
      command: $command,
      gate: $gate,
      gate_main: $gate_main,
      host_track: $host_track,
      host_head: ($host_head | select(length > 0) // null),
      host_head_short: ($host_head_short | select(length > 0) // null),
      version: ($version | select(length > 0) // null),
      gate_head: ($gate_head | select(length > 0) // null),
      exec_path: ($exec_path | select(length > 0) // null),
      kind: $kind,
      install_mode: $install_mode,
      registry_compliance: $registry_compliance,
      artifact_exemption: $artifact_exemption,
      stale: $stale,
      main_unpublished: $main_unpublished,
      behind_by: $behind_by,
      binary_pair_match: $binary_pair_match,
      paired_version: ($deployment_peer_version | select(length > 0) // null),
      paired_head: ($deployment_peer_head | select(length > 0) // null),
      deployment_problem: ($deployment_problem | select(length > 0) // null),
      freshness: $freshness,
      soak_state: ($soak_state | select(length > 0) // null),
      soak_checks: $soak_checks,
      soak_min_checks: $soak_min_checks,
      post_flip_ticks_left: $post_flip_ticks_left,
      stamp: $stamp,
      refresh: ($refresh | select(length > 0) // null),
      artifact_app: ($artifact_app | select(length > 0) // null),
      artifact_channel: ($artifact_channel | select(length > 0) // null),
      artifact_root: ($artifact_root | select(length > 0) // null),
      install_root: ($install_root | select(length > 0) // null),
      manifest_digest: ($manifest_digest | select(length > 0) // null),
      channel_manifest_digest: ($channel_manifest_digest | select(length > 0) // null),
      artifact_current: ($artifact_current | select(length > 0) // null),
      artifact_previous: ($artifact_previous | select(length > 0) // null),
      artifact_problem: ($artifact_problem | select(length > 0) // null),
      notes: $notes
    }'
}

status_plain_for() {
  local status="$1"
  printf '%s\n' "$status" | jq -r '
    [
      "app=" + .app,
      "kind=" + .kind,
      "install_mode=" + .install_mode,
      "registry_compliance=" + (.registry_compliance // "-"),
      "exemption_kind=" + ((.artifact_exemption.kind // "-") | tostring),
      "command=" + .command,
      "exec_path=" + (.exec_path // "-"),
      "host_track=" + .host_track,
      "version=" + (.version // "-"),
      "host_head=" + (.host_head // "-"),
      "gate_head=" + (.gate_head // "-"),
      "behind_by=" + ((.behind_by // "-") | tostring),
      "binary_pair_match=" + ((.binary_pair_match // "-") | tostring),
      "deployment_problem=" + (.deployment_problem // "-"),
      "stale=" + (.stale | tostring),
      "main_unpublished=" + ((.main_unpublished // false) | tostring),
      "freshness=" + (.freshness // "-"),
      "soak=" + (if .soak_state then .soak_state + ":" + ((.soak_checks // 0) | tostring) + "/" + ((.soak_min_checks // 0) | tostring) else "-" end),
      "post_flip=" + ((.post_flip_ticks_left // "-") | tostring),
      "notes=" + .notes
    ] | @tsv'
}

list_apps() {
  jq -r '.apps[]?.app' "$REGISTRY"
}

status_cmd() {
  local json_out=0 stale_only=0 app="" statuses=() one
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json_out=1; shift ;;
      --stale) stale_only=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown status flag: $1" ;;
      *) app="$1"; shift ;;
    esac
  done

  if [ -n "$app" ]; then
    one="$(status_json_for "$app")"
    if [ "$stale_only" -eq 1 ] && [ "$(printf '%s\n' "$one" | jq -r '.stale | tostring')" != "true" ]; then
      if [ "$json_out" -eq 1 ]; then printf 'null\n'; fi
      return
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$one"
    else
      status_plain_for "$one"
    fi
    return
  fi

  while IFS= read -r app; do
    [ -n "$app" ] || continue
    one="$(status_json_for "$app")"
    if [ "$stale_only" -eq 0 ] || [ "$(printf '%s\n' "$one" | jq -r '.stale | tostring')" = "true" ]; then
      statuses+=("$one")
    fi
  done < <(list_apps)

  if [ "$json_out" -eq 1 ]; then
    printf '%s\n' "${statuses[@]}" | jq -s '.'
  else
    printf '%s\n' "${statuses[@]}" | while IFS= read -r one; do
      [ -n "$one" ] || continue
      status_plain_for "$one"
    done
  fi
}

which_cmd() {
  local json_out=0 app="" status exec_path artifact_problem
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json_out=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown which flag: $1" ;;
      *) app="$1"; shift ;;
    esac
  done
  [ -n "$app" ] || die "which requires an app"
  status="$(status_json_for "$app")"
  exec_path="$(printf '%s\n' "$status" | jq -r '.exec_path // ""')"
  artifact_problem="$(printf '%s\n' "$status" | jq -r '.artifact_problem // ""')"
  [ -n "$exec_path" ] || {
    if [ -n "$artifact_problem" ]; then
      printf 'host-track: %s artifact install broken: %s\n' "$app" "$artifact_problem" >&2
      return 1
    fi
    printf 'host-track: no executable found for %s\n' "$app" >&2
    return 1
  }
  if [ "$json_out" -eq 1 ]; then
    printf '%s\n' "$status"
    return
  fi
  printf '%s\n' "$exec_path"
}

check_cmd() {
  local app="${1:-}" status exec_path stale json install_mode artifact_problem
  local exemption_kind deployment_problem
  [ -n "$app" ] || die "check requires an app"
  status="$(status_json_for "$app")"
  exec_path="$(printf '%s\n' "$status" | jq -r '.exec_path // ""')"
  stale="$(printf '%s\n' "$status" | jq -r '.stale | tostring')"
  artifact_problem="$(printf '%s\n' "$status" | jq -r '.artifact_problem // ""')"
  json="$(require_app_json "$app")"
  install_mode="$(setting "$json" install_mode)"
  [ -n "$install_mode" ] || install_mode="checkout"
  if [ -n "$artifact_problem" ]; then
    printf 'host-track: %s artifact install broken: %s\n' "$app" "$artifact_problem" >&2
    return 1
  fi
  if [ -z "$exec_path" ]; then
    printf 'host-track: %s executable missing\n' "$app" >&2
    return 1
  fi
  if [ "$stale" = "true" ]; then
    exemption_kind="$(printf '%s\n' "$status" | jq -r '.artifact_exemption.kind // ""')"
    deployment_problem="$(printf '%s\n' "$status" | jq -r '.deployment_problem // ""')"
    if [ "$exemption_kind" = "deployment-only" ] && [ -z "$deployment_problem" ]; then
      # Deployment-managed binaries (lastdb-safe-upgrade owns activation)
      # trail gate main by design between supervised upgrades: gate main
      # moves on every merge while the primary only moves on a proven
      # cutover, so stale=true is the steady state, not a defect. `check`
      # treats it as informational; a real deployment_problem (pair
      # mismatch, unparseable stamp, missing gate head) still fails, and
      # `status` keeps reporting stale/behind_by for visibility.
      printf 'host-track: %s deployment-managed; trails gate by design (stale informational)\n' "$app"
    else
      printf 'host-track: %s stale\n' "$app" >&2
      return 1
    fi
  fi
  if [ "$install_mode" = "artifact" ] && ! verify_active_artifact "$app" "$json"; then
    # verify_active_artifact already printed path/reason to stderr
    printf 'host-track: %s active artifact verification failed\n' "$app" >&2
    return 1
  fi
  printf 'host-track: %s ok\n' "$app"
}

write_stamp() {
  local app="$1" status="$2"
  mkdir -p "$STAMP_DIR"
  printf '%s\n' "$status" | jq --arg refreshed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '. + {refreshed_at: $refreshed_at}' > "$STAMP_DIR/$app.json"
}

base64_decode() {
  if printf '' | base64 --decode >/dev/null 2>&1; then
    base64 --decode
  else
    base64 -D
  fi
}

safe_artifact_relpath() {
  local rel="$1"
  [ -n "$rel" ] || return 1
  case "$rel" in
    /*|*\\*|*$'\n'*|*$'\r'*|*$'\t'*) return 1 ;;
  esac
  ! printf '%s\n' "$rel" | tr '/' '\n' | grep -qx '\.\.'
}

artifact_pointer_target() {
  local install_root="$1" name="$2"
  [ -L "$install_root/$name" ] || return 0
  readlink "$install_root/$name"
}

artifact_install_problem() {
  local install_root="$1" current_target previous_target
  if [ ! -L "$install_root/current" ]; then
    printf 'missing current symlink under %s\n' "$install_root"
    return 0
  fi
  current_target="$(readlink "$install_root/current")"
  case "$current_target" in
    versions/*) ;;
    *)
      printf 'invalid current target: target=%s remedy=host-track refresh --force <app>\n' "$current_target"
      return 0
      ;;
  esac
  if [ ! -d "$install_root/$current_target" ]; then
    printf 'dangling current target: target=%s missing=%s remedy=host-track refresh --force <app>\n' \
      "$current_target" "$install_root/$current_target"
    return 0
  fi
  if [ -L "$install_root/previous" ]; then
    previous_target="$(readlink "$install_root/previous")"
    case "$previous_target" in
      versions/*) ;;
      *)
        printf 'invalid previous target: target=%s remedy=host-track rollback <app> or host-track refresh --force <app>\n' \
          "$previous_target"
        return 0
        ;;
    esac
    if [ ! -d "$install_root/$previous_target" ]; then
      printf 'dangling previous target: target=%s missing=%s remedy=host-track refresh --force <app>\n' \
        "$previous_target" "$install_root/$previous_target"
      return 0
    fi
  fi
  return 1
}

verify_active_artifact() {
  local app="$1" json="$2" artifact_app channel artifact_root install_root manifest digest current_target
  local encoded entry rel expected_sha active_file actual_sha
  IFS=$'\t' read -r artifact_app channel artifact_root install_root < <(artifact_paths "$app" "$json")
  if ! manifest="$(lastgit artifact resolve --app "$artifact_app" --channel "$channel" --root "$artifact_root" --json | json_first_object)"; then
    printf 'host-track: %s artifact resolve failed (channel=%s root=%s)\n' \
      "$app" "$channel" "$artifact_root" >&2
    return 1
  fi
  digest="$(printf '%s\n' "$manifest" | jq -r '.manifest_digest // ""')"
  if [ ! -L "$install_root/current" ]; then
    printf 'host-track: %s missing current symlink under %s\n' "$app" "$install_root" >&2
    return 1
  fi
  current_target="$(readlink "$install_root/current")"
  case "$current_target" in
    versions/*) ;;
    *)
      printf 'host-track: %s invalid current target: target=%s\n' "$app" "$current_target" >&2
      return 1
      ;;
  esac
  if [ ! -d "$install_root/$current_target" ]; then
    printf 'host-track: %s dangling current target: target=%s missing=%s remedy=host-track refresh --force %s\n' \
      "$app" "$current_target" "$install_root/$current_target" "$app" >&2
    return 1
  fi
  if [ "$current_target" != "versions/$digest" ]; then
    printf 'host-track: %s current target mismatch: have=%s want=versions/%s\n' \
      "$app" "$current_target" "$digest" >&2
    return 1
  fi
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    rel="$(printf '%s\n' "$entry" | jq -r '.path')"
    expected_sha="$(printf '%s\n' "$entry" | jq -r '.sha256')"
    if ! safe_artifact_relpath "$rel"; then
      printf 'host-track: %s invalid artifact path in manifest: %s\n' "$app" "$rel" >&2
      return 1
    fi
    active_file="$install_root/current/$rel"
    if [ ! -f "$active_file" ] || [ -L "$active_file" ]; then
      printf 'host-track: %s active file missing or symlink: path=%s\n' "$app" "$rel" >&2
      return 1
    fi
    actual_sha="$(hash_file "$active_file")"
    if [ "$actual_sha" != "$expected_sha" ]; then
      printf 'host-track: %s hash mismatch: path=%s expected=%s actual=%s\n' \
        "$app" "$rel" "$expected_sha" "$actual_sha" >&2
      return 1
    fi
  done < <(printf '%s\n' "$manifest" | jq -r '.files[] | @base64')
}

atomic_symlink() {
  local target="$1" link="$2" tmp
  mkdir -p "$(dirname "$link")"
  tmp="${link}.tmp-$$-$(date +%s)"
  ln -s "$target" "$tmp"
  if mv -f -h "$tmp" "$link" 2>/dev/null; then
    :
  elif mv -fT "$tmp" "$link" 2>/dev/null; then
    :
  else
    rm -f "$tmp"
    die "cannot atomically activate symlink: $link"
  fi
}

# mkdir-mutex install lock (pid + age reclaim). Same shape as lastgit install-local.lock.d.
acquire_install_lock() {
  local app="$1" lock waited=0 mtime now age
  mkdir -p "$HOST_TRACK_LOCK_DIR"
  lock="$HOST_TRACK_LOCK_DIR/install-${app}.lock.d"
  while ! mkdir "$lock" 2>/dev/null; do
    if [ -d "$lock" ]; then
      mtime="$(stat -f %m "$lock" 2>/dev/null || stat -c %Y "$lock" 2>/dev/null || echo 0)"
      now="$(date +%s)"
      age=$((now - mtime))
      # Also reclaim if recorded pid is dead (crash without unlock).
      lock_pid="$(tr -d '[:space:]' <"$lock/pid" 2>/dev/null || true)"
      pid_dead=0
      if [ -n "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
        pid_dead=1
      fi
      if [ "$age" -ge "$HOST_TRACK_INSTALL_LOCK_STALE_S" ] || [ "$pid_dead" -eq 1 ]; then
        printf 'host-track: reclaiming install lock for %s (age=%ss pid_dead=%s)\n' \
          "$app" "$age" "$pid_dead" >&2
        rm -rf -- "$lock" 2>/dev/null || true
        continue
      fi
    fi
    if [ "$waited" -ge "$HOST_TRACK_INSTALL_LOCK_WAIT_S" ]; then
      die "install lock timeout for $app after ${HOST_TRACK_INSTALL_LOCK_WAIT_S}s (another host-track install is running)"
    fi
    sleep 1
    waited=$((waited + 1))
  done
  printf '%s\n' "$$" >"$lock/pid" 2>/dev/null || true
  printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$lock/started_at" 2>/dev/null || true
  INSTALL_LOCK_HELD="$lock"
}

release_install_lock() {
  if [ -n "${INSTALL_LOCK_HELD:-}" ] && [ -d "$INSTALL_LOCK_HELD" ]; then
    rm -rf -- "$INSTALL_LOCK_HELD" 2>/dev/null || true
  fi
  INSTALL_LOCK_HELD=""
}

# True when a staged/installed version tree has a usable command payload.
# Complete when ANY of:
#   - non-empty bin/ (classic last-stack / brain layout)
#   - VERSION marker
#   - every registry links[].source exists as a non-symlink path (dist/* CLIs)
#   - non-empty dist/ with at least one regular file (CAS-only fallback)
# Half-empty stages fail all of the above. json is optional; pass registry app
# JSON when available so links[] can authorize dist-only producers (situations,
# fkanban, kanban, routines).
artifact_tree_has_payload() {
  local tree="$1" json="${2:-}" encoded entry source has_links=0
  [ -d "$tree" ] || return 1
  if [ -d "$tree/bin" ] && [ -n "$(ls -A "$tree/bin" 2>/dev/null || true)" ]; then
    return 0
  fi
  [ -f "$tree/VERSION" ] && return 0
  if [ -n "$json" ]; then
    while IFS= read -r encoded; do
      [ -n "$encoded" ] || continue
      has_links=1
      entry="$(printf '%s' "$encoded" | base64_decode)"
      source="$(printf '%s\n' "$entry" | jq -r '.source // ""')"
      [ -n "$source" ] || return 1
      if [ ! -e "$tree/$source" ] || [ -L "$tree/$source" ]; then
        return 1
      fi
    done < <(printf '%s\n' "$json" | jq -r '.links[]? | @base64')
    [ "$has_links" -eq 1 ] && return 0
  fi
  # dist-only CAS payloads (situations/fkanban) even without registry json at hand.
  if [ -d "$tree/dist" ]; then
    for f in "$tree/dist"/*; do
      [ -e "$f" ] || continue
      [ -f "$f" ] && [ ! -L "$f" ] && return 0
    done
  fi
  return 1
}

# True when install_root/current resolves to an existing directory with content.
current_target_is_live() {
  local install_root="$1" cur abs
  [ -L "$install_root/current" ] || return 1
  cur="$(readlink "$install_root/current")"
  case "$cur" in
    /*) abs="$cur" ;;
    *) abs="$install_root/$cur" ;;
  esac
  [ -d "$abs" ] || return 1
  # bin/, VERSION, links sources, or dist/* — half-stages often have empty trees.
  artifact_tree_has_payload "$abs"
}

# Materialize a fully verified stage directory from the CAS manifest.
# Prints stage path on stdout. On failure cleans stage and returns non-zero.
# Optional 5th arg: registry app JSON so dist/* link sources count as complete
# (situations/fkanban publish dist/* only — not a synthetic bin/ tree).
stage_artifact_from_manifest() {
  local install_root="$1" digest="$2" manifest="$3" artifact_root="$4" json="${5:-}"
  local stage encoded entry rel expected_sha mode blob actual_sha mode_octal
  stage="$(mktemp -d "$install_root/.stage-$digest.XXXXXX")"
  if ! (
    set -e
    while IFS= read -r encoded; do
      [ -n "$encoded" ] || continue
      entry="$(printf '%s' "$encoded" | base64_decode)"
      rel="$(printf '%s\n' "$entry" | jq -r '.path')"
      expected_sha="$(printf '%s\n' "$entry" | jq -r '.sha256')"
      mode="$(printf '%s\n' "$entry" | jq -r '.mode')"
      safe_artifact_relpath "$rel" || die "invalid artifact payload path: $rel"
      [[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || die "invalid artifact blob digest: $rel"
      blob="$artifact_root/blobs/sha256/${expected_sha:0:2}/$expected_sha"
      [ -f "$blob" ] || die "artifact blob missing after verification: $rel"
      actual_sha="$(hash_file "$blob")"
      [ "$actual_sha" = "$expected_sha" ] || die "artifact blob changed during install: $rel"
      mkdir -p "$stage/$(dirname "$rel")"
      cp -p "$blob" "$stage/$rel"
      mode_octal="$(printf '%o' "$mode")"
      chmod "$mode_octal" "$stage/$rel"
      [ "$(hash_file "$stage/$rel")" = "$expected_sha" ] || die "installed artifact verification failed: $rel"
    done < <(printf '%s\n' "$manifest" | jq -r '.files[] | @base64')
    # Refuse empty / half-write stages. Accept bin/, registry link sources, or dist/*.
    if ! artifact_tree_has_payload "$stage" "$json"; then
      die "staged artifact missing command payload (incomplete stage; need bin/, links[].source, or dist/)"
    fi
  ); then
    rm -rf -- "$stage"
    return 1
  fi
  printf '%s\n' "$stage"
}

# Commit a verified stage into versions/<digest> WITHOUT ever leaving current
# pointing at a missing directory. If current already points at this digest,
# park current on previous (when previous is live) before replacing the tree.
commit_staged_version() {
  local install_root="$1" digest="$2" stage="$3"
  local target="$install_root/versions/$digest"
  local live_cur previous_target switched_away=0 aside=""

  live_cur=""
  if [ -L "$install_root/current" ]; then
    live_cur="$(readlink "$install_root/current")"
  fi

  # If we would replace the tree current points at, move current off it first.
  if [ -d "$target" ] && [ "$live_cur" = "versions/$digest" ]; then
    previous_target=""
    if [ -L "$install_root/previous" ]; then
      previous_target="$(readlink "$install_root/previous")"
    fi
    if [ -n "$previous_target" ] && [ "$previous_target" != "versions/$digest" ] \
      && [ -d "$install_root/$previous_target" ]; then
      printf 'host-track: parking current on previous while restaging versions/%s\n' "$digest" >&2
      atomic_symlink "$previous_target" "$install_root/current"
      switched_away=1
    else
      # No safe previous: rename live target aside (current briefly dangles until
      # stage is committed and we repoint — window is milliseconds, not a long stage).
      aside="${target}.old-$$"
      printf 'host-track: renaming live versions/%s aside before restage\n' "$digest" >&2
      if ! mv "$target" "$aside"; then
        rm -rf -- "$stage"
        die "cannot move live version aside for restage: $target"
      fi
      switched_away=1
    fi
  fi

  if [ -d "$target" ]; then
    remove_artifact_version_tree "$target"
  fi
  if ! mv "$stage" "$target"; then
    rm -rf -- "$stage" 2>/dev/null || true
    # Prefer previous (if we parked) over a dangling current.
    die "cannot commit staged version to $target"
  fi

  if [ -n "$aside" ] && [ -d "$aside" ]; then
    remove_artifact_version_tree "$aside"
  fi

  # Always ensure current points at the freshly committed digest when we had
  # to park it, or when this is a brand-new install (caller also sets current).
  if [ "$switched_away" -eq 1 ]; then
    atomic_symlink "versions/$digest" "$install_root/current"
  fi
}

verify_staged_artifact_links() {
  local json="$1" stage="$2" encoded entry source
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    source="$(printf '%s\n' "$entry" | jq -r '.source // ""')"
    safe_artifact_relpath "$source" || die "invalid artifact link source: $source"
    [ -e "$stage/$source" ] || die "staged artifact link source missing: $source"
    [ ! -L "$stage/$source" ] || die "staged artifact link source is symlink: $source"
  done < <(printf '%s\n' "$json" | jq -r '.links[]? | @base64')
}

install_artifact_links() {
  local json="$1" install_root="$2" encoded entry source target_raw target
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    source="$(printf '%s\n' "$entry" | jq -r '.source // ""')"
    target_raw="$(printf '%s\n' "$entry" | jq -r '.target // ""')"
    safe_artifact_relpath "$source" || die "invalid artifact link source: $source"
    target="$(expand_path "$target_raw")"
    [ -n "$target" ] || die "artifact link target is required"
    [ -e "$install_root/current/$source" ] || die "artifact link source missing: $source"
    # Legacy checkout installs left real files in ~/.local/bin (not symlinks).
    # Backup once and replace with a symlink into the active artifact tree so
    # artifact cutover can complete (remote ra/rad hit this path).
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      if [ -d "$target" ]; then
        die "refusing to replace non-symlink directory artifact target: $target"
      fi
      bak="${target}.bak-pre-artifact-$(date -u +%Y%m%dT%H%M%SZ)"
      printf 'host-track: backing up non-symlink PATH target %s -> %s\n' "$target" "$bak" >&2
      mv -f "$target" "$bak"
    fi
    atomic_symlink "$install_root/current/$source" "$target"
  done < <(printf '%s\n' "$json" | jq -r '.links[]? | @base64')
  retire_artifact_links "$json" "$install_root"
}

# Drop PATH names this app used to install. Only unlink a target that is still
# a symlink into this install_root — never delete a real file or a link that
# some other install owns. Live links[] win if a target is listed in both.
retire_artifact_links() {
  local json="$1" install_root="$2" encoded entry target_raw target dest live t
  local -a live_targets=()
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    target_raw="$(printf '%s\n' "$entry" | jq -r '.target // ""')"
    [ -n "$target_raw" ] || continue
    live_targets+=("$(expand_path "$target_raw")")
  done < <(printf '%s\n' "$json" | jq -r '.links[]? | @base64')
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    target_raw="$(printf '%s\n' "$entry" | jq -r '.target // ""')"
    target="$(expand_path "$target_raw")"
    [ -n "$target" ] || continue
    [ -L "$target" ] || continue
    live=0
    for t in "${live_targets[@]+"${live_targets[@]}"}"; do
      if [ "$t" = "$target" ]; then
        live=1
        break
      fi
    done
    [ "$live" -eq 0 ] || continue
    dest="$(readlink "$target" || true)"
    case "$dest" in
      "$install_root"/*)
        rm -f "$target"
        printf 'host-track: retired PATH link %s\n' "$target" >&2
        ;;
    esac
  done < <(printf '%s\n' "$json" | jq -r '.retired_links[]? | @base64')
}

run_artifact_post_install() {
  local app="$1" json="$2" install_root="$3" digest="$4" post_install
  post_install="$(expand_path "$(field "$json" post_install)")"
  [ -n "$post_install" ] || return 0
  [ -x "$post_install" ] || die "artifact post-install is not executable: $post_install"
  HOST_TRACK_APP="$app" HOST_TRACK_INSTALL_ROOT="$install_root" \
    HOST_TRACK_MANIFEST_DIGEST="$digest" LAST_STACK_ROOT="$install_root/current" \
    "$post_install"
}

# True when an existing versions/<digest> tree is missing or content-corrupt.
# Used so refresh can re-stage from CAS even when status.stale is false.
artifact_version_needs_restage() {
  local install_root="$1" digest="$2" manifest="$3" active_root rel expected_sha active_file
  local encoded entry
  active_root="$install_root/versions/$digest"
  [ -d "$active_root" ] || return 0
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    rel="$(printf '%s\n' "$entry" | jq -r '.path')"
    expected_sha="$(printf '%s\n' "$entry" | jq -r '.sha256')"
    safe_artifact_relpath "$rel" || return 0
    active_file="$active_root/$rel"
    if [ ! -f "$active_file" ] || [ -L "$active_file" ]; then
      return 0
    fi
    if [ "$(hash_file "$active_file")" != "$expected_sha" ]; then
      return 0
    fi
  done < <(printf '%s\n' "$manifest" | jq -r '.files[] | @base64')
  return 1
}

remove_artifact_version_tree() {
  local target="$1" install_root="${2:-}" app="${3:-artifact}" refs
  [ -d "$target" ] || return 0
  if [ -n "$install_root" ]; then
    refs="$(artifact_version_tree_refs "$install_root" "$target")"
    if [ -n "$refs" ]; then
      die "$app refusing to remove artifact GC root: target=$target referenced_by=$refs"
    fi
  fi
  # last-stack freezes versions a-w; must unlock before rm.
  chmod -R u+w "$target" 2>/dev/null || true
  rm -rf -- "$target"
}

artifact_version_tree_refs() {
  local install_root="$1" target="$2" name link abs
  for name in current previous canary; do
    [ -L "$install_root/$name" ] || continue
    link="$(readlink "$install_root/$name")"
    case "$link" in versions/*) ;; *) continue ;; esac
    abs="$install_root/$link"
    if [ "$abs" = "$target" ]; then
      printf '%s\n' "$name"
    fi
  done | paste -sd, -
}

# GC abandoned .stage-* dirs left by crashed installs. Never touches versions/*
# or current/previous. Age default 30m (HOST_TRACK_STAGE_GC_MAX_AGE_S).
gc_stale_stage_dirs() {
  local install_root="$1"
  local max_age_s="${HOST_TRACK_STAGE_GC_MAX_AGE_S:-1800}"
  local now stage mtime age
  [ -d "$install_root" ] || return 0
  now="$(date +%s)"
  # Portable: only direct children named .stage-*
  for stage in "$install_root"/.stage-*; do
    [ -e "$stage" ] || continue
    [ -d "$stage" ] || continue
    mtime="$(stat -f %m "$stage" 2>/dev/null || stat -c %Y "$stage" 2>/dev/null || echo 0)"
    age=$((now - mtime))
    if [ "$age" -ge "$max_age_s" ]; then
      printf 'host-track: gc stale stage dir age=%ss path=%s\n' "$age" "$stage" >&2
      chmod -R u+w "$stage" 2>/dev/null || true
      rm -rf -- "$stage" 2>/dev/null || true
    fi
  done
}

safe_upgrade_post_install_phase() {
  local json="$1" phase
  phase="$(printf '%s\n' "$json" | jq -r '.safe_upgrade.post_install_phase // empty')"
  case "$phase" in
    before-probe|after-cutover|both) printf '%s\n' "$phase" ;;
    *) printf 'before-probe\n' ;;
  esac
}

now_ms() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time; print(int(time.time()*1000))'
  elif command -v perl >/dev/null 2>&1; then
    perl -MTime::HiRes=time -e 'print int(time*1000)'
  else
    printf '0\n'
  fi
}

run_with_timeout() {
  local seconds="$1"
  shift
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$seconds" "$@" <<'PY'
import subprocess, sys
sec = int(sys.argv[1])
cmd = sys.argv[2:]
try:
    raise SystemExit(subprocess.run(cmd, timeout=sec).returncode)
except subprocess.TimeoutExpired:
    raise SystemExit(124)
PY
  elif command -v timeout >/dev/null 2>&1; then
    timeout "$seconds" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$seconds" "$@"
  else
    "$@"
  fi
}

resolve_version_rel() {
  local version_dir="$1" rel="$2"
  case "$rel" in
    /*) printf '%s\n' "$rel" ;;
    *) printf '%s/%s\n' "$version_dir" "$rel" ;;
  esac
}

resolve_post_install_hook() {
  local json="$1" install_root="$2" digest="$3" configured base rewritten version_dir
  configured="$(expand_path "$(field "$json" post_install)")"
  [ -n "$configured" ] || return 1
  version_dir="$install_root/versions/$digest"
  base="$(basename "$configured")"
  if [ -n "$base" ] && [ -x "$version_dir/bin/$base" ]; then
    printf '%s\n' "$version_dir/bin/$base"
    return 0
  fi
  rewritten="${configured//\/current\//\/versions\/$digest\/}"
  if [ "$rewritten" != "$configured" ] && [ -x "$rewritten" ]; then
    printf '%s\n' "$rewritten"
    return 0
  fi
  if [ -x "$configured" ]; then
    printf '%s\n' "$configured"
    return 0
  fi
  return 1
}

run_artifact_post_install_on_tree() {
  local app="$1" json="$2" install_root="$3" digest="$4" version_dir="$5" hook
  [ -n "$(field "$json" post_install)" ] || return 0
  if ! hook="$(resolve_post_install_hook "$json" "$install_root" "$digest")"; then
    die "artifact post-install is not executable for $app (digest=$digest)"
  fi
  HOST_TRACK_APP="$app" HOST_TRACK_INSTALL_ROOT="$install_root" \
    HOST_TRACK_MANIFEST_DIGEST="$digest" HOST_TRACK_VERSION_DIR="$version_dir" \
    LAST_STACK_ROOT="$version_dir" \
    "$hook"
}

run_one_probe() {
  local version_dir="$1" spec="$2" attempts_override="${3:-}"
  local timeout_s output_matches accept_exit attempts retry_delay_s attempt
  local n i rel exe rc out ok e
  local -a cmd=()
  timeout_s="$(printf '%s\n' "$spec" | jq -r '.timeout_s // 30')"
  output_matches="$(printf '%s\n' "$spec" | jq -r '.output_matches // empty')"
  accept_exit="$(printf '%s\n' "$spec" | jq -r '(.accept_exit // [0]) | map(tostring) | join(" ")')"
  if [ -n "$attempts_override" ]; then
    attempts="$attempts_override"
  else
    attempts="${HOST_TRACK_PROBE_ATTEMPTS:-$(printf '%s\n' "$spec" | jq -r '.attempts // 3')}"
  fi
  retry_delay_s="${HOST_TRACK_PROBE_RETRY_DELAY_S:-$(printf '%s\n' "$spec" | jq -r '.retry_delay_s // 1')}"
  case "$attempts" in ''|*[!0-9]*) attempts=3 ;; esac
  case "$retry_delay_s" in ''|*[!0-9]*) retry_delay_s=1 ;; esac
  [ "$attempts" -ge 1 ] || attempts=1
  [ "$attempts" -le 5 ] || attempts=5
  [ "$retry_delay_s" -le 10 ] || retry_delay_s=10
  n="$(printf '%s\n' "$spec" | jq -r '.argv | length')"
  [ "$n" -ge 1 ] || return 1
  rel="$(printf '%s\n' "$spec" | jq -r '.argv[0]')"
  exe="$(resolve_version_rel "$version_dir" "$rel")"
  [ -e "$exe" ] || {
    printf 'host-track: probe argv[0] missing: %s\n' "$exe" >&2
    return 1
  }
  cmd=("$exe")
  i=1
  while [ "$i" -lt "$n" ]; do
    cmd+=("$(printf '%s\n' "$spec" | jq -r --argjson i "$i" '.argv[$i]')")
    i=$((i + 1))
  done
  attempt=1
  while [ "$attempt" -le "$attempts" ]; do
    out="$(mktemp "${TMPDIR:-/tmp}/host-track-probe.XXXXXX")"
    set +e
    (
      cd "$version_dir"
      PATH="$version_dir/bin:$version_dir/dist:${PATH}"
      HOST_TRACK_PROBE=1
      export HOST_TRACK_PROBE
      # Probes run in the CANDIDATE's own context. The reexec wrapper exports
      # HOST_TRACK_ROOT (and callers may pin HOST_TRACK_REGISTRY); inherited,
      # they make a candidate binary resolve the LIVE tree's registry, which
      # deadlocks any validator-tightening self-upgrade
      # (papercut-host-track-probe-env-leak-self-upgrade-deadlock).
      unset HOST_TRACK_ROOT HOST_TRACK_REEXECED HOST_TRACK_REGISTRY
      run_with_timeout "$timeout_s" "${cmd[@]}"
    ) >"$out" 2>&1
    rc=$?
    set -e
    ok=0
    for e in $accept_exit; do
      if [ "$rc" = "$e" ]; then
        ok=1
        break
      fi
    done
    if [ -n "$output_matches" ]; then
      grep -q -- "$output_matches" "$out" || ok=0
    fi
    if [ "$ok" -eq 1 ]; then
      rm -f "$out"
      if [ "$attempt" -gt 1 ]; then
        printf 'host-track: probe recovered attempt=%s/%s cmd=%s\n' \
          "$attempt" "$attempts" "${cmd[*]}" >&2
      fi
      return 0
    fi
    printf 'host-track: probe attempt %s/%s failed cmd=%s rc=%s\n' \
      "$attempt" "$attempts" "${cmd[*]}" "$rc" >&2
    sed -n '1,40p' "$out" >&2
    rm -f "$out"
    if [ "$attempt" -ge "$attempts" ]; then
      printf 'host-track: probe exhausted after %s attempts cmd=%s\n' \
        "$attempts" "${cmd[*]}" >&2
      return 1
    fi
    sleep "$retry_delay_s"
    attempt=$((attempt + 1))
  done
  return 1
}

run_probe_with_incumbent_control() {
  local app="$1" candidate_dir="$2" incumbent_dir="$3" spec="$4"

  if run_one_probe "$candidate_dir" "$spec"; then
    return 0
  fi

  if [ -z "$incumbent_dir" ] || [ ! -d "$incumbent_dir" ] \
    || [ "$incumbent_dir" = "$candidate_dir" ]; then
    printf 'host-track: %s probe RED; candidate exhausted and no incumbent control is available\n' \
      "$app" >&2
    return 1
  fi

  printf 'host-track: %s candidate probe exhausted; checking incumbent control\n' \
    "$app" >&2
  if ! run_one_probe "$incumbent_dir" "$spec" 1; then
    printf 'host-track: %s probe INCONCLUSIVE; candidate and incumbent both failed\n' \
      "$app" >&2
    return 2
  fi

  printf 'host-track: %s incumbent control GREEN; confirming candidate\n' \
    "$app" >&2
  if run_one_probe "$candidate_dir" "$spec" 1; then
    printf 'host-track: %s candidate probe recovered after incumbent control\n' \
      "$app" >&2
    return 0
  fi

  printf 'host-track: %s probe RED; candidate failed while incumbent passed\n' \
    "$app" >&2
  return 1
}

time_one_probe_ms() {
  local version_dir="$1" spec="$2" start end
  start="$(now_ms)"
  [ "$start" != "0" ] || { printf '\n'; return 1; }
  if run_one_probe "$version_dir" "$spec"; then
    end="$(now_ms)"
    printf '%s\n' "$((end - start))"
    return 0
  fi
  printf '\n'
  return 1
}

first_link_source() {
  local json="$1"
  printf '%s\n' "$json" | jq -r '.links[0].source // empty'
}

run_safe_upgrade_probes() {
  local app="$1" json="$2" version_dir="$3" current_dir="${4:-}"
  local skip="${HOST_TRACK_PROBE_SKIP:-0}"
  local encoded spec n i candidate_ms baseline_ms ratio floor
  local latency_on

  if [ "$skip" = "1" ]; then
    printf 'host-track: %s probe SKIPPED (HOST_TRACK_PROBE_SKIP=1)\n' "$app" >&2
    return 0
  fi

  n="$(printf '%s\n' "$json" | jq -r '.safe_upgrade.probes // [] | length')"
  if [ "$n" -eq 0 ]; then
    if [ "${REGISTRY_IS_DEFAULT:-0}" = "1" ]; then
      printf 'host-track: %s has no safe_upgrade.probes; refuse to activate\n' "$app" >&2
      return 1
    fi
    rel="$(first_link_source "$json")"
    if [ -n "$rel" ] && [ -e "$version_dir/$rel" ] && [ -x "$version_dir/$rel" ]; then
      printf 'host-track: %s custom registry has no probes; existence check OK (%s)\n' \
        "$app" "$rel" >&2
      return 0
    fi
    printf 'host-track: %s custom registry has no probes and no executable link source\n' \
      "$app" >&2
    return 1
  fi

  printf 'host-track: %s probing %s (%s checks) …\n' "$app" "$version_dir" "$n" >&2
  i=0
  while [ "$i" -lt "$n" ]; do
    spec="$(printf '%s\n' "$json" | jq -c --argjson i "$i" '.safe_upgrade.probes[$i]')"
    if run_probe_with_incumbent_control "$app" "$version_dir" "$current_dir" "$spec"; then
      :
    else
      return $?
    fi
    i=$((i + 1))
  done

  latency_on="$(printf '%s\n' "$json" | jq -r '.safe_upgrade.latency // false | tostring')"
  if [ "$latency_on" = "true" ] && [ -n "$current_dir" ] && [ -d "$current_dir" ] \
    && [ "$current_dir" != "$version_dir" ]; then
    spec="$(printf '%s\n' "$json" | jq -c '.safe_upgrade.probes[-1]')"
    ratio="${HOST_TRACK_PROBE_LAT_RATIO:-$(printf '%s\n' "$json" | jq -r '.safe_upgrade.latency_ratio // 3')}"
    floor="${HOST_TRACK_PROBE_LAT_FLOOR_MS:-$(printf '%s\n' "$json" | jq -r '.safe_upgrade.latency_floor_ms // 1000')}"
    candidate_ms="$(time_one_probe_ms "$version_dir" "$spec" || true)"
    baseline_ms="$(time_one_probe_ms "$current_dir" "$spec" || true)"
    if [ -n "$candidate_ms" ] && [ -n "$baseline_ms" ]; then
      printf 'host-track: %s latency candidate=%sms baseline=%sms ratio=%s floor=%sms\n' \
        "$app" "$candidate_ms" "$baseline_ms" "$ratio" "$floor" >&2
      if [ "$candidate_ms" -gt "$floor" ] && [ "$baseline_ms" -gt 0 ]; then
        ratio_i="${ratio%%.*}"
        [ -n "$ratio_i" ] || ratio_i=3
        if [ "$candidate_ms" -gt $((baseline_ms * ratio_i)) ]; then
          printf 'host-track: %s latency RED candidate=%sms > %sx baseline=%sms\n' \
            "$app" "$candidate_ms" "$ratio_i" "$baseline_ms" >&2
          return 1
        fi
      fi
    else
      printf 'host-track: %s latency unmeasurable; continuing on correctness\n' "$app" >&2
    fi
  fi

  printf 'host-track: %s probe GREEN\n' "$app" >&2
  return 0
}

rollback_current_to_previous() {
  local app="$1" install_root="$2" digest="$3" json="$4"
  local prev
  [ -L "$install_root/current" ] || return 0
  [ "$(readlink "$install_root/current")" = "versions/$digest" ] || return 0
  [ -L "$install_root/previous" ] || return 0
  prev="$(readlink "$install_root/previous")"
  [ -d "$install_root/$prev" ] || return 0
  printf 'host-track: %s rolling current back to %s after RED probe\n' "$app" "$prev" >&2
  atomic_symlink "$prev" "$install_root/current"
  install_artifact_links "$json" "$install_root" || true
}

soak_hours_for() {
  local json="$1" env_h
  env_h="${HOST_TRACK_SOAK_HOURS:-}"
  if [ -n "$env_h" ]; then
    printf '%s\n' "$env_h"
    return
  fi
  # Inherited from .defaults.safe_upgrade so soak is default-ON for the
  # fleet; an entry opts out with an explicit 0 plus soak_exempt_reason
  # (validate-registry enforces the reason).
  safe_upgrade_setting "$json" soak_hours 0
}

min_checks_for() {
  # Green soak-watch checks required before a flip. Code fallback is 1
  # (the pre-defaults behavior); the shipped registry default is 3.
  safe_upgrade_setting "$1" min_checks 1
}

post_flip_ticks_for() {
  # Ticks of probing against the NEW current after a flip. Code fallback 0
  # (no watch); the shipped registry default is 2.
  safe_upgrade_setting "$1" post_flip_ticks 0
}

soak_stamp_path() {
  printf '%s/%s.soak.json\n' "$STAMP_DIR" "$1"
}

archive_soak_stamp() {
  # Soak history survives: move the live stamp aside instead of deleting it.
  local app="$1" outcome="${2:-}" path dest digest
  path="$(soak_stamp_path "$app")"
  [ -f "$path" ] || return 0
  digest="$(jq -r '.digest // "unknown"' "$path" 2>/dev/null || printf 'unknown')"
  mkdir -p "$STAMP_DIR/soak-history"
  dest="$STAMP_DIR/soak-history/${app}-${digest:0:12}-$(date -u +%Y%m%dT%H%M%SZ).soak.json"
  if [ -n "$outcome" ]; then
    jq --arg outcome "$outcome" '. + {outcome: $outcome}' "$path" > "$dest" 2>/dev/null || cp "$path" "$dest"
  else
    cp "$path" "$dest"
  fi
  rm -f "$path"
}

post_flip_stamp_path() {
  printf '%s/%s.postflip.json\n' "$STAMP_DIR" "$1"
}

write_post_flip_stamp() {
  local app="$1" digest="$2" json="$3" ticks
  ticks="$(post_flip_ticks_for "$json")"
  awk -v t="$ticks" 'BEGIN { exit !(t+0 > 0) }' || return 0
  mkdir -p "$STAMP_DIR"
  jq -n --arg app "$app" --arg digest "$digest" --argjson ticks "$ticks" \
    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{app:$app, digest:$digest, ticks_left:$ticks, flipped_at:$now}' \
    > "$(post_flip_stamp_path "$app")"
}

write_soak_stamp() {
  local app="$1" digest="$2" status="$3" soak_h="$4" checks="${5:-1}" started="${6:-}" card_slug="${7:-}"
  local now path
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  path="$(soak_stamp_path "$app")"
  mkdir -p "$STAMP_DIR"
  if [ -z "$started" ]; then
    started="$(date +%s)"
  fi
  if [ -z "$card_slug" ] && [ -f "$path" ]; then
    card_slug="$(jq -r '.card_slug // empty' "$path")"
  fi
  jq -n \
    --arg app "$app" --arg digest "$digest" --arg status "$status" \
    --arg now "$now" --argjson soak "$soak_h" --argjson checks "$checks" \
    --argjson started "$started" --arg card "$card_slug" \
    '{app:$app, digest:$digest, status:$status, soak_hours:$soak,
      started_epoch:$started, last_check_at:$now, checks:$checks,
      card_slug: (if $card == "" then null else $card end)}' \
    > "$path"
}

park_canary() {
  local app="$1" install_root="$2" digest="$3" soak_h="$4"
  local stamp started checks
  atomic_symlink "versions/$digest" "$install_root/canary"
  stamp="$(soak_stamp_path "$app")"
  started=""
  checks=1
  if [ -f "$stamp" ] && [ "$(jq -r '.digest // empty' "$stamp")" = "$digest" ]; then
    started="$(jq -r '.started_epoch // empty' "$stamp")"
    checks="$(jq -r '.checks // 1' "$stamp")"
  fi
  write_soak_stamp "$app" "$digest" "soaking" "$soak_h" "$checks" "$started"
  printf 'host-track: %s canary parked at versions/%s; soak %sh; current unchanged\n' \
    "$app" "$digest" "$soak_h" >&2
}

soak_red_repo() {
  local json="$1" app="$2" gate slug
  gate="$(field "$json" gate_main)"
  case "$gate" in
    lastdb:///*)
      slug="${gate#lastdb:///}"
      slug="${slug%%#*}"
      printf 'EdgeVector/%s\n' "$slug"
      ;;
    *)
      printf 'EdgeVector/%s\n' "$app"
      ;;
  esac
}

soak_red_card_slug() {
  local app="$1" digest="$2"
  printf 'soak-red-%s-%s\n' "$app" "${digest:0:12}"
}

file_soak_red_card() {
  local app="$1" digest="$2" json="$3"
  local helper slug repo stamp body
  [ "${HOST_TRACK_SOAK_FILE_CARD:-1}" != "0" ] || return 0
  helper="${HOST_TRACK_FILE_PR:-}"
  if [ -z "$helper" ]; then
    helper="$(command -v last-stack-kanban-file-pr 2>/dev/null || true)"
  fi
  if [ -z "$helper" ] && [ -x "$ROOT/bin/last-stack-kanban-file-pr" ]; then
    helper="$ROOT/bin/last-stack-kanban-file-pr"
  fi
  if [ -z "$helper" ] || [ ! -x "$helper" ]; then
    printf 'host-track: %s soak RED; last-stack-kanban-file-pr missing, no card\n' \
      "$app" >&2
    return 0
  fi
  stamp="$(soak_stamp_path "$app")"
  # One card per INCIDENT, not per digest: parking a successor canary keeps
  # the open card_slug in the stamp, and a red soak of a heal fix belongs to
  # the same incident (same heal key, same bounded attempt budget). The
  # incident closes when a green soak archives the stamp.
  slug="$(jq -r '.card_slug // empty' "$stamp" 2>/dev/null || true)"
  if [ -n "$slug" ]; then
    printf 'host-track: %s soak RED; incident card %s already open\n' "$app" "$slug" >&2
    return 0
  fi
  slug="$(soak_red_card_slug "$app" "$digest")"
  repo="$(soak_red_repo "$json" "$app")"
  body="$(cat <<EOF
**Follow the kanban-agent skill — drive this through to a MERGED PR.
A card is only done when its code is actually in the repo.**

Repo: ${repo}
Base: main
Kind: pr

## GOAL
Make the ${app} candidate ${digest} pass host-track soak probes so the
new copy can go into service. Do not put a failing copy on PATH.

## CONTEXT
host-track soak-watch rejected this candidate. The live install is
unchanged (last-known-good). Filed automatically on soak RED.

App: ${app}
Digest: ${digest}

## END STATE
host-track soak-watch ${app} is GREEN for this digest, or a later
good candidate has replaced it. Pickup proves with the VERIFY command.

## VERIFY
host-track soak-watch ${app}
# expect soak GREEN or already current — not soak RED
EOF
)"
  if ! printf '%s\n' "$body" | "$helper" "$slug" \
    --title "Soak RED: ${app} ${digest:0:12} failed safe-upgrade probes" \
    --repo "$repo" \
    --base main \
    --priority P0 \
    --tags "p0,soak-red,${app}" \
    --north-star north-star-artifact-driven-host-track \
    --milestone ms-host-track-app-soak-failures \
    --ensure-milestone; then
    printf 'host-track: %s soak RED; card file failed (soak still refuses cutover)\n' \
      "$app" >&2
    return 0
  fi
  soak_h="$(soak_hours_for "$json")"
  write_soak_stamp "$app" "$digest" "soak_red" "$soak_h" 1 "" "$slug"
  printf 'host-track: %s soak RED; filed P0 %s\n' "$app" "$slug" >&2
}

kick_heal_soak() {
  # Bounded self-heal on soak RED. One loom run per open incident: the
  # idempotency key is the card slug minted at the FIRST red digest, so a
  # red soak of the heal's own fix re-enters the same run as the next
  # attempt instead of resetting the attempt budget with every new digest.
  local app="$1" digest="$2" json="$3" runner slug
  [ "${HOST_TRACK_SOAK_HEAL:-1}" != "0" ] || return 0
  runner="${HOST_TRACK_SOAK_HEAL_RUNNER:-}"
  if [ -z "$runner" ]; then
    runner="$(command -v last-stack-soak-heal-loom 2>/dev/null || true)"
  fi
  if [ -z "$runner" ] && [ -x "$ROOT/bin/last-stack-soak-heal-loom" ]; then
    runner="$ROOT/bin/last-stack-soak-heal-loom"
  fi
  if [ -z "$runner" ] || [ ! -x "$runner" ]; then
    printf 'host-track: %s soak RED; heal runner missing, card only\n' "$app" >&2
    return 0
  fi
  slug="$(jq -r '.card_slug // empty' "$(soak_stamp_path "$app")" 2>/dev/null || true)"
  [ -n "$slug" ] || slug="$(soak_red_card_slug "$app" "$digest")"
  "$runner" --app "$app" --digest "$digest" --key "$slug" --quiet \
    || printf 'host-track: %s heal kick failed (soak still refuses cutover)\n' "$app" >&2
  return 0
}

kick_ship_soak_runs() {
  # The Host Track tick is the sole scheduler for active ship-soak runs. The
  # helper resumes only records for this app and applies its own hard bound.
  local app="$1" runner
  [ "${HOST_TRACK_SHIP_SOAK_RESUME:-1}" != "0" ] || return 0
  runner="${HOST_TRACK_SHIP_SOAK_TICK_RUNNER:-}"
  if [ -z "$runner" ]; then
    runner="$(command -v last-stack-ship-soak-tick 2>/dev/null || true)"
  fi
  if [ -z "$runner" ] && [ -x "$ROOT/bin/last-stack-ship-soak-tick" ]; then
    runner="$ROOT/bin/last-stack-ship-soak-tick"
  fi
  [ -n "$runner" ] && [ -x "$runner" ] || return 0
  "$runner" --app "$app" --quiet \
    || printf 'host-track: %s ship-soak resume failed (soak gate unchanged)\n' "$app" >&2
  return 0
}

post_flip_watch_one() {
  # Probe the NEW current for post_flip_ticks ticks after a flip. Red rolls
  # current back to previous automatically, files the card, kicks heal.
  local app="$1" json path digest ticks install_root current_dir incumbent_dir probe_rc
  json="$(require_app_json "$app")"
  [ "$(setting "$json" install_mode)" = "artifact" ] || return 0
  path="$(post_flip_stamp_path "$app")"
  [ -f "$path" ] || return 0
  digest="$(jq -r '.digest // empty' "$path")"
  ticks="$(jq -r '.ticks_left // 0' "$path")"
  IFS=$'\t' read -r _ _ _ install_root < <(artifact_paths "$app" "$json")
  if [ ! -L "$install_root/current" ] \
    || [ "$(readlink "$install_root/current")" != "versions/$digest" ]; then
    # current moved on (newer flip or rollback); this watch no longer applies.
    rm -f "$path"
    return 0
  fi
  current_dir="$install_root/versions/$digest"
  incumbent_dir=""
  if [ -L "$install_root/previous" ]; then
    incumbent_dir="$install_root/$(readlink "$install_root/previous")"
    [ -d "$incumbent_dir" ] || incumbent_dir=""
  fi
  probe_rc=0
  if run_safe_upgrade_probes "$app" "$json" "$current_dir" "$incumbent_dir"; then
    :
  else
    probe_rc=$?
  fi
  if [ "$probe_rc" -eq 2 ]; then
    printf 'host-track: %s post-flip probe inconclusive; ticks_left=%s unchanged\n' \
      "$app" "$ticks" >&2
    return 0
  fi
  if [ "$probe_rc" -ne 0 ]; then
    printf 'host-track: %s post-flip RED; rolling back to previous\n' "$app" >&2
    rollback_current_to_previous "$app" "$install_root" "$digest" "$json"
    file_soak_red_card "$app" "$digest" "$json"
    kick_heal_soak "$app" "$digest" "$json"
    rm -f "$path"
    return 1
  fi
  ticks=$((ticks - 1))
  if [ "$ticks" -le 0 ]; then
    printf 'host-track: %s post-flip watch complete for %s\n' "$app" "${digest:0:12}"
    rm -f "$path"
  else
    jq --argjson t "$ticks" '.ticks_left = $t' "$path" > "$path.tmp" && mv "$path.tmp" "$path"
    printf 'host-track: %s post-flip watch green; ticks_left=%s\n' "$app" "$ticks"
  fi
}

should_soak() {
  local json="$1" install_root="$2" digest="$3" activate_now="$4"
  local soak_h cur
  [ "$activate_now" -eq 0 ] || return 1
  soak_h="$(soak_hours_for "$json")"
  awk -v h="$soak_h" 'BEGIN { exit !(h+0 > 0) }' || return 1
  [ -L "$install_root/current" ] || return 1
  cur="$(readlink "$install_root/current")"
  [ "$cur" != "versions/$digest" ] || return 1
  current_target_is_live "$install_root" || return 1
  return 0
}

artifact_install_app() {
  local app="$1" channel_override="${2:-}" force_restage="${3:-0}" activate_now="${4:-0}" json install_mode artifact_app channel artifact_root install_root
  local manifest digest stage target old_target stamp_path need_materialize=0
  local old_digest prev_target prev_digest post_install_phase current_dir soak_h probe_rc
  json="$(require_app_json "$app")"
  install_mode="$(setting "$json" install_mode)"
  [ "$install_mode" = "artifact" ] || die "$app is not registered for artifact installs"
  [ "${HOST_TRACK_ACTIVATE:-0}" != "1" ] || activate_now=1
  IFS=$'\t' read -r artifact_app channel artifact_root install_root < <(artifact_paths "$app" "$json")
  [ -z "$channel_override" ] || channel="$channel_override"
  case "$channel" in candidate|canary|stable) ;; *) die "invalid artifact channel: $channel" ;; esac
  command -v lastgit >/dev/null 2>&1 || die "lastgit is required for verified artifact installs"

  acquire_install_lock "$app"
  # Clean crashed half-stages before materializing a new one.
  gc_stale_stage_dirs "$install_root"

  # Always release the lock on any exit path from this function (bash RETURN is
  # unreliable across re-exec/temp-copy; pair with explicit releases + die()).
  # shellcheck disable=SC2064
  trap 'release_install_lock' EXIT

  # Track main: promote green+published main tip into the channel before resolve
  # so refresh does not no-op on a stale stable pointer while main has moved.
  artifact_promote_channel_to_main "$app" "$json" "$channel"

  manifest="$(lastgit artifact resolve --app "$artifact_app" --channel "$channel" --root "$artifact_root" --json | json_first_object)"
  digest="$(printf '%s\n' "$manifest" | jq -r '.manifest_digest // ""')"
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || die "resolved artifact has invalid manifest digest"
  mkdir -p "$install_root/versions"
  target="$install_root/versions/$digest"

  # Materialize when missing, forced, or content no longer matches the CAS
  # manifest. CRITICAL: never delete the live tree before the stage is complete
  # (concurrent/half-stage dangle of current + ~/.local/bin).
  # Without restage-on-corrupt, a single bad file under versions/<digest> left
  # status.stale=false and refresh --force was a no-op — freezing pickup.
  if [ ! -d "$target" ]; then
    need_materialize=1
  elif [ "$force_restage" = "1" ] || artifact_version_needs_restage "$install_root" "$digest" "$manifest"; then
    printf 'host-track: %s re-staging versions/%s (corrupt or forced)\n' "$app" "$digest" >&2
    need_materialize=1
  fi

  if [ "$need_materialize" -eq 1 ]; then
    if ! stage="$(stage_artifact_from_manifest "$install_root" "$digest" "$manifest" "$artifact_root" "$json")"; then
      release_install_lock
      trap - EXIT
      return 1
    fi
    if ! verify_staged_artifact_links "$json" "$stage"; then
      rm -rf -- "$stage" 2>/dev/null || true
      release_install_lock
      trap - EXIT
      return 1
    fi
    commit_staged_version "$install_root" "$digest" "$stage"
  fi

  # Last Stack only: freeze the installed version tree so agents cannot
  # hand-edit product files through ~/.last-stack compatibility symlinks.
  # Other artifact apps keep normal modes (post_install / binaries may need +w
  # bits from the manifest only).
  if [ "$app" = "last-stack" ] && [ -d "$target" ]; then
    chmod u+w "$target" 2>/dev/null || true
    find "$target" \( -type f -o -type d \) -exec chmod a-w {} + 2>/dev/null || \
      find "$target" \( -type f -o -type d \) -exec chmod a-w {} \; 2>/dev/null || true
  fi

  # Cutover: only after versions/<digest> is complete on disk.
  # Refuse to activate a non-live tree (defense in depth against empty stages).
  # Accept bin/, registry link sources (dist/*), or VERSION — not bin/-only.
  if ! artifact_tree_has_payload "$target" "$json"; then
    die "refusing cutover: versions/$digest incomplete install (missing command payload)"
  fi

  # Probe the candidate tree BEFORE flipping current/PATH. Last known-good
  # stays live unless this is a restage of the already-active digest.
  post_install_phase="$(safe_upgrade_post_install_phase "$json")"
  current_dir=""
  if [ -L "$install_root/current" ] && current_target_is_live "$install_root"; then
    current_dir="$install_root/$(readlink "$install_root/current")"
  fi
  if [ "$post_install_phase" = "before-probe" ] || [ "$post_install_phase" = "both" ]; then
    if ! run_artifact_post_install_on_tree "$app" "$json" "$install_root" "$digest" "$target"; then
      printf 'host-track: %s pre-probe post-install failed\n' "$app" >&2
      release_install_lock
      trap - EXIT
      return 1
    fi
  fi
  probe_rc=0
  if run_safe_upgrade_probes "$app" "$json" "$target" "$current_dir"; then
    :
  else
    probe_rc=$?
  fi
  if [ "$probe_rc" -eq 2 ]; then
    printf 'host-track: %s probe inconclusive; current unchanged; retry on next refresh\n' \
      "$app" >&2
    release_install_lock
    trap - EXIT
    return 0
  fi
  if [ "$probe_rc" -ne 0 ]; then
    printf 'host-track: %s probe RED; refusing cutover (current unchanged)\n' "$app" >&2
    rollback_current_to_previous "$app" "$install_root" "$digest" "$json"
    release_install_lock
    trap - EXIT
    return 1
  fi

  # Canary soak: last-known-good stays on PATH. soak-watch promotes later.
  if should_soak "$json" "$install_root" "$digest" "$activate_now"; then
    soak_h="$(soak_hours_for "$json")"
    park_canary "$app" "$install_root" "$digest" "$soak_h"
    release_install_lock
    trap - EXIT
    return 0
  fi

  old_target=""
  [ ! -L "$install_root/current" ] || old_target="$(readlink "$install_root/current")"
  if [ -n "$old_target" ] && [ "$old_target" != "versions/$digest" ]; then
    # Only park previous when restorable for artifact invariant:
    # versions/<64-char hex digest> and the tree exists. Timestamp-style or
    # local-safe leftovers (e.g. versions/d20260804171208) are not restorable —
    # clear them so last-stack-host-track-artifact-invariant stays green.
    old_digest="${old_target#versions/}"
    if [[ "$old_target" == versions/* ]] \
      && [[ "$old_digest" =~ ^[0-9a-f]{64}$ ]] \
      && [ -d "$install_root/$old_target" ]; then
      atomic_symlink "$old_target" "$install_root/previous"
    else
      if [ -L "$install_root/previous" ] || [ -n "$old_target" ]; then
        rm -f "$install_root/previous"
        printf 'host-track: %s cleared unrestorable previous (was %s)\n' \
          "$app" "$old_target" >&2
      fi
    fi
  fi
  atomic_symlink "versions/$digest" "$install_root/current"
  # Scrub any pre-existing invalid previous left by older installs / wrong mode.
  if [ -L "$install_root/previous" ]; then
    prev_target="$(readlink "$install_root/previous")"
    prev_digest="${prev_target#versions/}"
    if [[ "$prev_target" != versions/* ]] \
      || [[ ! "$prev_digest" =~ ^[0-9a-f]{64}$ ]] \
      || [ ! -d "$install_root/$prev_target" ]; then
      rm -f "$install_root/previous"
      printf 'host-track: %s cleared unrestorable previous (was %s)\n' \
        "$app" "$prev_target" >&2
    fi
  fi

  # PATH links only after current points at a verified tree.
  install_artifact_links "$json" "$install_root"

  # Last-stack setup (and any after-cutover hook) still runs against current.
  # Other apps already ran post_install on the version tree before the probe.
  if [ "$post_install_phase" = "after-cutover" ] || [ "$post_install_phase" = "both" ]; then
    if ! run_artifact_post_install "$app" "$json" "$install_root" "$digest"; then
      printf 'host-track: %s post-install failed\n' "$app" >&2
      release_install_lock
      trap - EXIT
      return 1
    fi
  fi

  # Stamp only after the active tree verifies (digest match + hashes). Never
  # stamp a half-install as fresh.
  if ! verify_active_artifact "$app" "$json"; then
    printf 'host-track: %s post-cutover verification failed; not stamping fresh\n' "$app" >&2
    # Attempt rollback to previous if live.
    if [ -L "$install_root/previous" ] && [ -d "$install_root/$(readlink "$install_root/previous")" ]; then
      printf 'host-track: %s attempting rollback to previous after failed verify\n' "$app" >&2
      atomic_symlink "$(readlink "$install_root/previous")" "$install_root/current" || true
      install_artifact_links "$json" "$install_root" || true
    fi
    release_install_lock
    trap - EXIT
    return 1
  fi

  stamp_path="$STAMP_DIR/$app.json"
  mkdir -p "$STAMP_DIR"
  printf '%s\n' "$manifest" | jq \
    --arg app "$app" --arg channel "$channel" --arg install_root "$install_root" \
    --arg artifact_root "$artifact_root" \
    --arg installed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{app: $app, install_mode: "artifact", artifact_app: .app, artifact_channel: $channel,
      artifact_root: $artifact_root, install_root: $install_root, manifest_digest: .manifest_digest,
      source_oid: .source_oid, repo: .repo, platform: .platform, installed_at: $installed_at}' \
      > "$stamp_path"
  printf 'host-track: installed %s channel=%s oid=%s manifest=%s\n' \
    "$app" "$channel" "$(printf '%s\n' "$manifest" | jq -r '.source_oid')" "$digest"

  release_install_lock
  trap - EXIT
}

rollback_artifact_app() {
  local app="$1" json install_mode artifact_app channel artifact_root install_root current_target previous_target digest manifest stamp_path
  json="$(require_app_json "$app")"
  install_mode="$(setting "$json" install_mode)"
  [ "$install_mode" = "artifact" ] || die "$app is not registered for artifact installs"
  IFS=$'\t' read -r artifact_app channel artifact_root install_root < <(artifact_paths "$app" "$json")
  acquire_install_lock "$app"
  # shellcheck disable=SC2064
  trap 'release_install_lock' EXIT
  [ -L "$install_root/current" ] || die "$app has no current artifact install"
  [ -L "$install_root/previous" ] || die "$app has no previous artifact install"
  current_target="$(readlink "$install_root/current")"
  previous_target="$(readlink "$install_root/previous")"
  case "$previous_target" in versions/*) ;; *) die "invalid previous artifact target: $previous_target" ;; esac
  [ -d "$install_root/$previous_target" ] || die "previous artifact directory is missing"
  atomic_symlink "$previous_target" "$install_root/current"
  atomic_symlink "$current_target" "$install_root/previous"
  install_artifact_links "$json" "$install_root"
  digest="${previous_target#versions/}"
  manifest="$artifact_root/manifests/$digest.json"
  [ -f "$manifest" ] || die "previous artifact manifest is missing"
  run_artifact_post_install "$app" "$json" "$install_root" "$digest"
  stamp_path="$STAMP_DIR/$app.json"
  mkdir -p "$STAMP_DIR"
  jq --arg app "$app" --arg channel "$channel" --arg artifact_root "$artifact_root" \
    --arg install_root "$install_root" --arg rolled_back_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{app: $app, install_mode: "artifact", artifact_app: .app, artifact_channel: $channel,
      artifact_root: $artifact_root, install_root: $install_root, manifest_digest: .manifest_digest,
      source_oid: .source_oid, repo: .repo, platform: .platform, rolled_back_at: $rolled_back_at}' \
    "$manifest" > "$stamp_path"
  printf 'host-track: rolled back %s manifest=%s\n' "$app" "$digest"
  release_install_lock
  trap - EXIT
}

refresh_app() {
  local app="$1" force="$2" json status stale refresh_path refresh_mode host_track install_mode exemption_kind
  local self_upgrade setup_path

  json="$(require_app_json "$app")"
  install_mode="$(setting "$json" install_mode)"
  [ -n "$install_mode" ] || install_mode="checkout"
  exemption_kind="$(printf '%s\n' "$json" | jq -r '.artifact_exemption.kind // ""')"
  # Promote a deployable main oid even when the live tree is already on channel.
  # Else LaunchAgent --force-if-stale no-ops and never catches a published tip.
  if [ "$install_mode" = "artifact" ]; then
    artifact_promote_channel_to_main "$app" "$json" ""
  fi
  status="$(status_json_for "$app")"
  stale="$(printf '%s\n' "$status" | jq -r '.stale | tostring')"

  if [ "$exemption_kind" = "deployment-only" ]; then
    printf 'host-track: %s is deployment-only; generic refresh is disabled (use lastdb-safe-upgrade)\n' "$app" >&2
    return 3
  fi

  if [ "$force" -eq 0 ] && [ "$stale" = "false" ]; then
    # Pointer is current, but content may still be corrupt (hash mismatch).
    # Heal in place instead of claiming "already current" while check fails.
    if [ "$install_mode" = "artifact" ]; then
      if ! verify_active_artifact "$app" "$json" 2>/dev/null; then
        printf 'host-track: %s current but content verification failed; re-staging\n' "$app" >&2
        artifact_install_app "$app" "" 1
        return
      fi
    fi
    printf 'host-track: %s already current\n' "$app"
    # Artifact stamps are the provenance record written by artifact_install_app.
    # Replacing one with the projected status shape drops source_oid and other
    # manifest fields, so a no-op refresh must leave it intact.
    if [ "$install_mode" != "artifact" ] && [ "$install_mode" != "local-safe" ]; then
      write_stamp "$app" "$status"
    fi
    return 0
  fi

  if [ "$install_mode" = "artifact" ]; then
    # --force always re-stages; normal refresh re-stages only if corrupt/missing.
    artifact_install_app "$app" "" "$force"
    return
  fi

  refresh_path="$(printf '%s\n' "$status" | jq -r '.refresh // ""')"
  refresh_mode="$(field "$json" refresh_mode)"
  host_track="$(printf '%s\n' "$status" | jq -r '.host_track')"

  if [ -n "$refresh_path" ] && [ -x "$refresh_path" ]; then
    # Local-safe helper takes "<app> [--force]"; legacy refresh scripts take only [--force].
    case "$(basename "$refresh_path")" in
      last-stack-refresh-local-safe|last-stack-safe-upgrade-cli|last-stack-safe-upgrade-all-local)
        if [ "$force" -eq 1 ]; then
          "$refresh_path" "$app" --force
        else
          "$refresh_path" "$app"
        fi
        ;;
      *)
        if [ "$force" -eq 1 ]; then
          "$refresh_path" --force
        else
          "$refresh_path"
        fi
        ;;
    esac
  elif [ "$refresh_mode" = "last-stack-self-upgrade" ]; then
    self_upgrade="$host_track/bin/last-stack-self-upgrade"
    setup_path="$host_track/setup"
    if [ -x "$self_upgrade" ]; then
      "$self_upgrade" --repair-dirty --reason=host-track-refresh
    elif [ -d "$host_track/.git" ] && [ -x "$setup_path" ]; then
      if ! git_dirty "$host_track"; then
        printf 'host-track: %s host checkout is dirty; refusing fallback refresh\n' "$app" >&2
        return 1
      fi
      git -C "$host_track" pull --ff-only
      "$setup_path"
    else
      printf 'host-track: %s has no usable last-stack refresh path\n' "$app" >&2
      return 3
    fi
  else
    printf 'host-track: %s has no refresh command yet\n' "$app" >&2
    return 3
  fi

  status="$(status_json_for "$app")"
  if [ "$install_mode" != "local-safe" ]; then
    write_stamp "$app" "$status"
  fi
}

install_cmd() {
  local app="" channel=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --channel) [ "$#" -ge 2 ] || die "--channel requires a value"; channel="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown install flag: $1" ;;
      *) app="$1"; shift ;;
    esac
  done
  [ -n "$app" ] || die "install requires an app"
  artifact_install_app "$app" "$channel"
}

rollback_local_safe_app() {
  local app="$1" json install_root activate_bin current_target previous_target
  local encoded entry source target_raw target link_args=()
  json="$(require_app_json "$app")"
  install_root="$(expand_path "$(field "$json" install_root)")"
  [ -n "$install_root" ] || install_root="$INSTALL_ROOT_DEFAULT/$app"
  activate_bin="$(command -v last-stack-safe-activate-cli 2>/dev/null || true)"
  [ -x "$activate_bin" ] || activate_bin="$(cd "$(dirname "$0")" && pwd -P)/last-stack-safe-activate-cli"
  [ -x "$activate_bin" ] || die "last-stack-safe-activate-cli not found for local-safe rollback"
  [ -L "$install_root/previous" ] || die "$app has no previous (nothing to roll back to)"
  previous_target="$(readlink "$install_root/previous")"
  case "$previous_target" in
    versions/*) ;;
    *) die "invalid local-safe previous target: $previous_target" ;;
  esac
  previous_id="${previous_target#versions/}"
  [[ "$previous_id" =~ ^[0-9a-f]{40}$ ]] || die "local-safe previous is not a restorable 40-hex version: $previous_target"
  [ -d "$install_root/$previous_target" ] || die "previous dir missing: $install_root/$previous_target"
  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    entry="$(printf '%s' "$encoded" | base64_decode)"
    source="$(printf '%s\n' "$entry" | jq -r '.source // empty')"
    target_raw="$(printf '%s\n' "$entry" | jq -r '.target // empty')"
    [ -n "$source" ] && [ -n "$target_raw" ] || continue
    target="$(expand_path "$target_raw")"
    link_args+=(--link "$source:$target")
  done < <(printf '%s\n' "$json" | jq -r '.links[]? | @base64')
  acquire_install_lock "$app"
  # shellcheck disable=SC2064
  trap 'release_install_lock' EXIT
  "$activate_bin" rollback --app "$app" ${link_args[@]+"${link_args[@]}"}
  printf 'host-track: rolled back local-safe %s to %s\n' "$app" "$previous_target"
  release_install_lock
  trap - EXIT
}

rollback_cmd() {
  local app="${1:-}" json install_mode
  [ -n "$app" ] || die "rollback requires an app"
  [ "$#" -eq 1 ] || die "rollback accepts exactly one app"
  json="$(require_app_json "$app")"
  install_mode="$(setting "$json" install_mode)"
  case "$install_mode" in
    artifact) rollback_artifact_app "$app" ;;
    local-safe) rollback_local_safe_app "$app" ;;
    *) die "$app install_mode=$install_mode does not support rollback (artifact|local-safe)" ;;
  esac
}

# Return 0 when an app's installed artifact is behind its channel (status.stale=true).
# Mirrors `host-track status` so `--force-if-stale` re-stages only apps that need it.
app_is_stale() {
  local app="$1" stale
  stale="$(status_json_for "$app" 2>/dev/null | jq -r '.stale | tostring' 2>/dev/null)"
  [ "$stale" = "true" ]
}

refresh_cmd() {
  local force=0 force_if_stale=0 all=0 app="" failures=0 rc eff
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --force-if-stale) force_if_stale=1; shift ;;
      --activate) export HOST_TRACK_ACTIVATE=1; shift ;;
      --all) all=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown refresh flag: $1" ;;
      *) app="$1"; shift ;;
    esac
  done

  # Plain `refresh` can no-op on a pointer-stale artifact when the local channel
  # resolver lags what status reports, leaving status.stale=true forever and
  # blocking every routine that gates on freshness (recurring pickup-fleet stall).
  # `--force-if-stale` re-stages (force) exactly the apps status still flags stale,
  # clearing that stuck state without the churn of forcing already-current apps.
  if [ "$all" -eq 1 ]; then
    while IFS= read -r app; do
      [ -n "$app" ] || continue
      eff="$force"
      if [ "$eff" -eq 0 ] && [ "$force_if_stale" -eq 1 ] && app_is_stale "$app"; then eff=1; fi
      if refresh_app "$app" "$eff"; then
        :
      else
        rc=$?
        [ "$rc" -eq 3 ] || failures=$((failures + 1))
      fi
    done < <(list_apps)
    # The 20-minute LaunchAgent only runs `refresh --all`. Tick soaks here so
    # parked canaries promote without a second scheduled job.
    if [ "${HOST_TRACK_ACTIVATE:-0}" != "1" ] && [ "${HOST_TRACK_SKIP_SOAK_WATCH:-0}" != "1" ]; then
      soak_watch_cmd --all || failures=$((failures + 1))
    fi
    [ "$failures" -eq 0 ]
    return
  fi

  [ -n "$app" ] || die "refresh requires an app or --all"
  eff="$force"
  if [ "$eff" -eq 0 ] && [ "$force_if_stale" -eq 1 ] && app_is_stale "$app"; then eff=1; fi
  refresh_app "$app" "$eff"
  if [ "${HOST_TRACK_ACTIVATE:-0}" != "1" ] && [ "${HOST_TRACK_SKIP_SOAK_WATCH:-0}" != "1" ]; then
    soak_watch_one "$app"
  fi
}


# Fail-closed fleet policy: every registered app must be artifact or exempt.
# Does not require live installs — pure registry scan. local-safe without an
# exemption is intentionally non_compliant (migration pressure).
validate_registry_cmd() {
  local json_out=0 report non_compliant ok_json
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json_out=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown validate-registry flag: $1" ;;
      *) die "validate-registry takes no app argument (scans whole registry)" ;;
    esac
  done

  report="$(jq -c --arg registry "$REGISTRY" '
    . as $root
    | def mode($app):
        ($app.install_mode // $root.defaults.install_mode // "checkout");
      def exemption($app):
        if ($app.artifact_exemption | type) == "object" then
          {
            kind: ($app.artifact_exemption.kind // null),
            owner: ($app.artifact_exemption.owner // null),
            rationale: ($app.artifact_exemption.rationale // null)
          }
        else null end;
      def compliance($app):
        (mode($app)) as $m
        | if $m == "artifact" then "artifact"
          else
            (exemption($app)) as $e
            | if ($e != null)
                and (($e.kind == "deployment-only") or ($e.kind == "bootstrap-recovery"))
                and (($e.owner // "") | length) > 0
                and (($e.rationale // "") | length) > 0
              then "exempt"
              else "non_compliant"
              end
          end;
      def probe_ok($app):
        if compliance($app) != "artifact" then true
        else
          ((.safe_upgrade.probes // []) | length) > 0
          and all(.safe_upgrade.probes[]?; ((.argv // []) | length) > 0)
        end;
      def resolved_soak($app):
        # Same resolution safe_upgrade_setting uses: entry wins, absence inherits.
        ($app.safe_upgrade.soak_hours // $root.defaults.safe_upgrade.soak_hours // 0);
      def soak_ok($app):
        # Artifact apps soak by default; an explicit 0 needs a written reason.
        if compliance($app) != "artifact" then true
        else
          (resolved_soak($app) > 0)
          or ((($app.safe_upgrade.soak_exempt_reason // "") | length) > 0)
        end;
      def probe_depth_ok($app):
        # Self-check plus one real read verb (>=2 probes), or a written waiver
        # for apps with no cheap read verb (server-only binaries, node-heavy
        # status verbs).
        if compliance($app) != "artifact" then true
        else
          ((($app.safe_upgrade.probes // []) | length) >= 2)
          or ((($app.safe_upgrade.probe_waiver_reason // "") | length) > 0)
        end;
      ($root.apps // [])
      | map({
          app: .app,
          install_mode: mode(.),
          registry_compliance: compliance(.),
          artifact_exemption: exemption(.),
          probe_ok: probe_ok(.),
          soak_ok: soak_ok(.),
          resolved_soak_hours: resolved_soak(.),
          probe_depth_ok: probe_depth_ok(.)
        }) as $apps
      | ($apps | map(select(.registry_compliance == "non_compliant")) | length) as $nc
      | ($apps | map(select(.probe_ok == false)) | length) as $mp
      | ($apps | map(select(.soak_ok == false)) | length) as $ms
      | ($apps | map(select(.probe_depth_ok == false)) | length) as $tp
      | {
          ok: (($nc == 0) and ($mp == 0) and ($ms == 0) and ($tp == 0)),
          registry: $registry,
          total: ($apps | length),
          non_compliant: $nc,
          missing_probes: $mp,
          missing_soak: $ms,
          thin_probes: $tp,
          policy: "artifact_or_exempt",
          probe_policy: "artifact_apps_have_probes",
          soak_policy: "artifact_apps_soak_or_written_reason",
          probe_depth_policy: "two_probes_or_written_waiver",
          apps: $apps
        }
  ' "$REGISTRY")" || die "validate-registry could not read registry JSON"

  non_compliant="$(printf '%s\n' "$report" | jq -r '.non_compliant')"
  if [ "$json_out" -eq 1 ]; then
    printf '%s\n' "$report"
  else
    printf 'validate-registry policy=artifact_or_exempt registry=%s total=%s non_compliant=%s missing_probes=%s missing_soak=%s thin_probes=%s\n' \
      "$(printf '%s\n' "$report" | jq -r '.registry')" \
      "$(printf '%s\n' "$report" | jq -r '.total')" \
      "$non_compliant" \
      "$(printf '%s\n' "$report" | jq -r '.missing_probes')" \
      "$(printf '%s\n' "$report" | jq -r '.missing_soak')" \
      "$(printf '%s\n' "$report" | jq -r '.thin_probes')"
    printf '%s\n' "$report" | jq -r '.apps[] |
      .app + "\t" + .install_mode + "\t" + .registry_compliance +
      (if .artifact_exemption then "\t" + (.artifact_exemption.kind // "-") else "\t-" end) +
      "\tprobe=" + (if .probe_ok then "ok" else "MISSING" end) +
      "\tsoak=" + (if .soak_ok then ((.resolved_soak_hours | tostring) + "h") else "MISSING" end) +
      "\tdepth=" + (if .probe_depth_ok then "ok" else "THIN" end)'
    if [ "$(printf '%s\n' "$report" | jq -r '.ok')" = "true" ]; then
      printf 'ok: every app is artifact or exempt; artifact apps declare probes, soak (or a reason), and probe depth (or a waiver)\n'
    else
      if [ "$non_compliant" != "0" ]; then
        printf 'FAIL: %s app(s) are neither artifact nor exempt\n' "$non_compliant" >&2
      fi
      if [ "$(printf '%s\n' "$report" | jq -r '.missing_probes')" != "0" ]; then
        printf 'FAIL: %s artifact app(s) have no safe_upgrade.probes\n' \
          "$(printf '%s\n' "$report" | jq -r '.missing_probes')" >&2
      fi
      if [ "$(printf '%s\n' "$report" | jq -r '.missing_soak')" != "0" ]; then
        printf 'FAIL: %s artifact app(s) resolve to soak 0 with no soak_exempt_reason\n' \
          "$(printf '%s\n' "$report" | jq -r '.missing_soak')" >&2
      fi
      if [ "$(printf '%s\n' "$report" | jq -r '.thin_probes')" != "0" ]; then
        printf 'FAIL: %s artifact app(s) have <2 probes and no probe_waiver_reason\n' \
          "$(printf '%s\n' "$report" | jq -r '.thin_probes')" >&2
      fi
    fi
  fi

  [ "$(printf '%s\n' "$report" | jq -r '.ok')" = "true" ]
}


soak_watch_one() {
  local app="$1" json install_root canary_rel canary_dir digest soak_h min_checks stamp checks started now elapsed need current_dir probe_rc
  json="$(require_app_json "$app")"
  [ "$(setting "$json" install_mode)" = "artifact" ] || return 0
  IFS=$'\t' read -r _ _ _ install_root < <(artifact_paths "$app" "$json")
  [ -L "$install_root/canary" ] || {
    printf 'host-track: %s soak-watch noop (no canary)\n' "$app"
    return 0
  }
  canary_rel="$(readlink "$install_root/canary")"
  case "$canary_rel" in versions/*) ;; *)
    printf 'host-track: %s soak-watch invalid canary %s\n' "$app" "$canary_rel" >&2
    return 1
  esac
  canary_dir="$install_root/$canary_rel"
  [ -d "$canary_dir" ] || {
    printf 'host-track: %s soak-watch dangling canary %s\n' "$app" "$canary_rel" >&2
    return 1
  }
  digest="${canary_rel#versions/}"
  if [ -L "$install_root/current" ] && [ "$(readlink "$install_root/current")" = "$canary_rel" ]; then
    printf 'host-track: %s soak-watch already current\n' "$app"
    archive_soak_stamp "$app" "activated"
    return 0
  fi
  current_dir=""
  if [ -L "$install_root/current" ] && current_target_is_live "$install_root"; then
    current_dir="$install_root/$(readlink "$install_root/current")"
  fi
  probe_rc=0
  if run_safe_upgrade_probes "$app" "$json" "$canary_dir" "$current_dir"; then
    :
  else
    probe_rc=$?
  fi
  if [ "$probe_rc" -eq 2 ]; then
    printf 'host-track: %s soak probe inconclusive; current and soak state unchanged\n' \
      "$app" >&2
    return 0
  fi
  if [ "$probe_rc" -ne 0 ]; then
    soak_h="$(soak_hours_for "$json")"
    write_soak_stamp "$app" "$digest" "soak_red" "$soak_h"
    printf 'host-track: %s soak RED; current unchanged\n' "$app" >&2
    file_soak_red_card "$app" "$digest" "$json"
    kick_heal_soak "$app" "$digest" "$json"
    return 1
  fi
  stamp="$(soak_stamp_path "$app")"
  started="$(date +%s)"
  checks=1
  if [ -f "$stamp" ]; then
    started="$(jq -r '.started_epoch // empty' "$stamp")"
    [ -n "$started" ] || started="$(date +%s)"
    checks="$(jq -r '.checks // 0' "$stamp")"
    checks=$((checks + 1))
  fi
  soak_h="$(soak_hours_for "$json")"
  min_checks="$(min_checks_for "$json")"
  now="$(date +%s)"
  elapsed=$((now - started))
  need="$(awk -v h="$soak_h" 'BEGIN { printf "%d", (h+0)*3600 }')"
  # The gate counts as well as waits: a canary that sat out the window with
  # soak-watch down must not flip on its first and only green check.
  if [ "$elapsed" -lt "$need" ] || [ "$checks" -lt "$min_checks" ]; then
    write_soak_stamp "$app" "$digest" "soaking" "$soak_h" "$checks" "$started"
    printf 'host-track: %s soak pending elapsed=%ss need=%ss checks=%s/%s\n' \
      "$app" "$elapsed" "$need" "$checks" "$min_checks"
    return 0
  fi
  printf 'host-track: %s soak GREEN after %ss (checks=%s/%s); activating\n' \
    "$app" "$elapsed" "$checks" "$min_checks" >&2
  if HOST_TRACK_ACTIVATE=1 artifact_install_app "$app" "" 0 1; then
    archive_soak_stamp "$app" "activated"
    write_post_flip_stamp "$app" "$digest" "$json"
  else
    return 1
  fi
}

soak_watch_cmd() {
  local all=0 app="" failures=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown soak-watch flag: $1" ;;
      *) app="$1"; shift ;;
    esac
  done
  if [ "$all" -eq 1 ] || [ -z "$app" ]; then
    while IFS= read -r app; do
      [ -n "$app" ] || continue
      soak_watch_one "$app" || failures=$((failures + 1))
      post_flip_watch_one "$app" || failures=$((failures + 1))
      kick_ship_soak_runs "$app"
    done < <(list_apps)
    [ "$failures" -eq 0 ]
    return
  fi
  soak_watch_one "$app" || failures=$((failures + 1))
  post_flip_watch_one "$app" || failures=$((failures + 1))
  kick_ship_soak_runs "$app"
  [ "$failures" -eq 0 ]
}

main() {
  need_jq
  [ -f "$REGISTRY" ] || die "registry not found: $REGISTRY"

  # For mutations that rewrite PATH / versions trees, re-exec from a temp copy
  # so self-replace of ~/.local/bin/host-track cannot unmap this process.
  maybe_reexec_for_mutation "$@"

  case "${1:-}" in
    status) shift; status_cmd "$@" ;;
    which) shift; which_cmd "$@" ;;
    check) shift; check_cmd "$@" ;;
    validate-registry) shift; validate_registry_cmd "$@" ;;
    refresh) shift; refresh_cmd "$@" ;;
    soak-watch) shift; soak_watch_cmd "$@" ;;
    install) shift; install_cmd "$@" ;;
    rollback) shift; rollback_cmd "$@" ;;
    -h|--help|"") usage; exit 0 ;;
    *) die "unknown subcommand: $1" ;;
  esac
}

main "$@"
