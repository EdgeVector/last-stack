#!/usr/bin/env python3
"""Auto-refill an empty admitted feature slot from the North Star ranking.

Implements `decision-2026-09-03-portfolio-auto-refill-from-ranking`.

Trigger: both admitted North Stars in
`preference-feature-delivery-portfolio-admission` report zero
idle-promoteable and zero idle-empty milestones on two consecutive
`last-stack-milestone-driver` passes. Pass evidence comes from the
pass-history file `last-stack-portfolio-pass-record` writes each hour — never
a Brain list.

Action: admit the highest-ranked paused North Star (the first real slug in
the `Paused:` field, in order) that has an idle milestone in the latest pass's
`idle_by_north_star` map into the Secondary slot. When no ranked slug has one,
admit the catch-all North Star with the most idle milestones. A pass record
without the map keeps the ranked-only pick. The Primary slot
never moves here — it is Tom's pinned strategic pick
(`decision-2026-08-31-lastdb-storage-simplification-primary`), while the
Secondary slot is the rotation point: both prior manual refills
(`decision-2026-09-01-admit-lastdb-canary-pipeline-v2-secondary`,
`decision-2026-09-02-admit-lastdb-factory-stays-fast-secondary`) replaced
Secondary and left Primary untouched. Bumps Policy-Version, stamps
Updated-By/Updated-At/Reason, and (with --apply) rewrites the record with one
point put. Never admits a third outcome; never enumerates Brain records.

Idempotence: after a successful rewrite the Secondary slug changes, so pass
records written under the previous Secondary no longer match the live record
and two fresh passes must accumulate before the rule can fire again. A human
edit (`Updated-By` set to a person, with a newer `Updated-At`) resets the same
way, even when Primary/Secondary are unchanged — the matcher requires the two
most recent passes to have recorded the exact `Updated-At` the current record
carries.

Jam backfill (`decision-2026-09-26-portfolio-jam-backfill-third-lane`): when
the refill does not fire, the same run checks for a jam. An admitted North
Star (Primary or Secondary) is jammed when its `runnable` count (milestones in
gap-report status `in_flight` or `idle_promoteable`) is zero on the two most
recent matched passes. With no Backfill set, the tool admits the
highest-ranked paused North Star with an idle milestone (the same
`pick_candidate` ranking and `idle_by_north_star` supply) as a temporary
`Backfill:` lane, with `Backfill-For:` and `Backfill-Since:`. When the jammed
North Star has runnable > 0 on the two most recent matched passes (or is no
longer admitted), the tool removes the Backfill lines. Only one Backfill lane
exists; the record never admits more than three North Stars. Each change bumps
Policy-Version, stamps Updated-By/Updated-At/Reason (with the jam reasons), is
one point put, and posts a `situations notice --kind config`. The Tom-veto
reset is the same as for the refill: the matcher needs the exact Updated-At.

Exit:
  0  no trigger this run (nothing written) — the default without --apply
  0  refilled (only with --apply and the trigger fired)
  1  admission record unreadable/malformed (fail closed, no write)
  2  passes file unreadable/unparseable (fail closed, no write)
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Optional

ADMISSION_SLUG = "preference-feature-delivery-portfolio-admission"
DEFAULT_PASSES_FILE = Path.home() / ".local" / "state" / "last-stack" / "portfolio-admission-passes.jsonl"
SLUG_RE = re.compile(r"^[a-z][a-z0-9-]{2,}$")
PLACEHOLDER_TOKENS = ("all-other-feature-north-stars", "none", "empty", "unset", "-")
FIELD_LINE_RE = {
    "policy-version": re.compile(r"(?im)^([ \t]*Policy-Version[ \t]*:)[ \t]*.*$"),
    "primary": re.compile(r"(?im)^([ \t]*Primary[ \t]*:)[ \t]*.*$"),
    "secondary": re.compile(r"(?im)^([ \t]*Secondary[ \t]*:)[ \t]*.*$"),
    "paused": re.compile(r"(?im)^([ \t]*Paused[ \t]*:)[ \t]*.*$"),
    "updated-at": re.compile(r"(?im)^([ \t]*Updated-At[ \t]*:)[ \t]*.*$"),
    "updated-by": re.compile(r"(?im)^([ \t]*Updated-By[ \t]*:)[ \t]*.*$"),
    "reason": re.compile(r"(?im)^([ \t]*Reason[ \t]*:)[ \t]*.*$"),
    "backfill": re.compile(r"(?im)^([ \t]*Backfill[ \t]*:)[ \t]*.*$"),
    "backfill-for": re.compile(r"(?im)^([ \t]*Backfill-For[ \t]*:)[ \t]*.*$"),
    "backfill-since": re.compile(r"(?im)^([ \t]*Backfill-Since[ \t]*:)[ \t]*.*$"),
}
BACKFILL_LINES_RE = re.compile(r"(?im)^[ \t]*(?:Backfill|Backfill-For|Backfill-Since)[ \t]*:.*(?:\n|$)")
BACKFILL_DECISION = "decision-2026-09-26-portfolio-jam-backfill-third-lane"
DRIVER_ACTOR = "last-stack-north-star-driver"


def normalize(value: str) -> str:
    v = (value or "").strip().strip("`").lower()
    if v in ("", "none", "empty", "unset", "-"):
        return ""
    return v


def now_iso() -> str:
    return subprocess.run(
        ["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"], text=True, capture_output=True, timeout=10
    ).stdout.strip()


def split_get_output(raw: str) -> tuple[dict, str]:
    """Parse `brain get` text into meta fields + body (matches the live CLI shape)."""
    text = raw or ""
    meta: dict[str, str] = {}
    if text.startswith("["):
        first_nl = text.find("\n")
        if first_nl >= 0:
            head = text[1:first_nl]
            if "]" in head:
                typ, _, rest = head.partition("]")
                meta["type"] = typ.strip()
                slug_guess = rest.strip()
                if slug_guess:
                    meta["slug"] = slug_guess
            text = text[first_nl + 1:]
    if "\n---\n" in text:
        meta_blob, body = text.split("\n---\n", 1)
    else:
        meta_blob, body = text, ""
    for line in meta_blob.splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        meta[k.strip().lower()] = v.strip()
    return meta, body.lstrip("\n")


def parse_admission_fields(body: str) -> dict:
    fields = {}
    for key, rx in FIELD_LINE_RE.items():
        m = rx.search(body)
        if m:
            line = m.group(0)
            fields[key] = line.split(":", 1)[1].strip()
    return fields


def read_admission(brain_bin: str, fixture_dir: Optional[Path]) -> Optional[tuple[dict, str, str]]:
    """Return (meta, body, raw_text), or None if unreadable."""
    if fixture_dir is not None:
        path = fixture_dir / "get" / f"{ADMISSION_SLUG}.txt"
        if not path.is_file():
            return None
        text = path.read_text()
    else:
        try:
            cp = subprocess.run(
                [brain_bin, "get", ADMISSION_SLUG, "--type", "preference"],
                text=True, capture_output=True, timeout=60,
            )
        except (OSError, subprocess.SubprocessError):
            return None
        if cp.returncode != 0 or not cp.stdout.strip():
            return None
        text = cp.stdout
    meta, body = split_get_output(text)
    return meta, body, text


def load_passes(path: Path) -> list[dict]:
    if not path.is_file():
        return []
    out = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(rec, dict):
            out.append(rec)
    return out


def matching_tail(
    passes: list[dict], primary: str, secondary: str, updated_at: str, backfill: str = ""
) -> list[dict]:
    """Most-recent-first run of passes matching the live (primary, secondary, backfill, updated_at).

    A pass written before the Backfill field existed carries no `backfill`
    key; it matches only a record with no Backfill lane.
    """
    matched = []
    for rec in reversed(passes):
        if (
            normalize(rec.get("primary", "")) == primary
            and normalize(rec.get("secondary", "")) == secondary
            and normalize(rec.get("backfill", "")) == backfill
            and rec.get("admission_updated_at", "") == updated_at
        ):
            matched.append(rec)
        else:
            break
    return matched


# A North Star in one of these states has no outcome left to drive. On
# 2026-09-25 17:44Z the refill admitted north-star-lastdb-canary-pipeline-v2
# (status: done): rebuild_paused puts the displaced Secondary back where the
# candidate stood, so the two most recent occupants swap forever, and a done
# one leaves the Secondary slot with no eligible outcome
# (papercut-portfolio-auto-refill-admits-done-north-star-20260925).
TERMINAL_NORTH_STAR_STATUSES = (
    "done", "complete", "completed", "archived", "retired", "superseded",
    "cancelled", "canceled", "abandoned", "wontfix",
)


def read_north_star_status(slug: str, brain_bin: str, fixture_dir: Optional[Path]) -> str:
    """One point read of the North Star project record. '' when unreadable."""
    if fixture_dir is not None:
        path = fixture_dir / "get" / f"{slug}.txt"
        if not path.is_file():
            return ""
        text = path.read_text()
    else:
        try:
            cp = subprocess.run(
                [brain_bin, "get", slug, "--type", "project"],
                text=True, capture_output=True, timeout=60,
            )
        except (OSError, subprocess.SubprocessError):
            return ""
        if cp.returncode != 0:
            return ""
        text = cp.stdout
    meta, _body = split_get_output(text)
    return (meta.get("status") or "").strip().lower()


CATCH_ALL = "all-other-feature-north-stars"


def pick_candidate(
    paused_field: str,
    primary: str,
    secondary: str,
    status_of=lambda _slug: "",
    skipped: Optional[list] = None,
    supply: Optional[dict] = None,
    exclude: tuple = (),
) -> Optional[str]:
    """First ranked Paused slug that can take work.

    `supply` is the latest pass's `idle_by_north_star` map. When it is present,
    a candidate with no idle milestone is skipped: admitting it fills the slot
    with nothing to decompose, and the next two drained passes swap it back out
    (2026-09-26: factory-stays-fast and feature-delivery-effective-flow, both
    with zero idle milestones, traded the Secondary slot). When no ranked slug
    has supply and Paused carries the catch-all, the North Star with the most
    idle milestones behind the catch-all is admitted. An old pass record with
    no map keeps the old ranked-only behavior.
    """
    named: list[str] = []
    has_catch_all = False
    for tok in paused_field.split(","):
        if normalize(tok) == CATCH_ALL:
            has_catch_all = True
            break
    for tok in paused_field.split(","):
        cand = normalize(tok)
        if not cand or cand in PLACEHOLDER_TOKENS:
            continue
        if not SLUG_RE.match(cand):
            continue
        named.append(cand)
        if cand in (primary, secondary) or cand in exclude:
            continue
        if supply is not None and int(supply.get(cand, 0) or 0) <= 0:
            if skipped is not None:
                skipped.append(f"{cand}:no-idle-milestones")
            continue
        # An unreadable record keeps the old behavior (admit): a brain read
        # blip must not stop the rotation. Only a stated terminal status skips.
        status = status_of(cand)
        if status in TERMINAL_NORTH_STAR_STATUSES:
            if skipped is not None:
                skipped.append(f"{cand}:{status}")
            continue
        return cand
    if supply is None or not has_catch_all:
        return None
    ranked = sorted(
        ((int(n or 0), ns) for ns, n in supply.items()),
        key=lambda item: (-item[0], item[1]),
    )
    for count, cand in ranked:
        if count <= 0 or not SLUG_RE.match(cand):
            continue
        if cand in (primary, secondary) or cand in named or cand in exclude:
            continue
        status = status_of(cand)
        if status in TERMINAL_NORTH_STAR_STATUSES:
            if skipped is not None:
                skipped.append(f"{cand}:{status}")
            continue
        return cand
    return None


def rebuild_paused(paused_field: str, candidate: str, displaced_secondary: str) -> str:
    tokens = [t.strip() for t in paused_field.split(",")]
    out = []
    inserted_displaced = False
    for tok in tokens:
        norm = normalize(tok)
        if norm == candidate:
            # candidate leaves Paused; splice the displaced Secondary in its place
            if displaced_secondary and not inserted_displaced:
                out.append(displaced_secondary)
                inserted_displaced = True
            continue
        out.append(tok.strip())
    if displaced_secondary and not inserted_displaced:
        # candidate was the last token or displaced not yet placed — append before any catch-all
        catch_all_idx = next(
            (i for i, t in enumerate(out) if normalize(t) == "all-other-feature-north-stars"), None
        )
        if catch_all_idx is not None:
            out.insert(catch_all_idx, displaced_secondary)
        else:
            out.append(displaced_secondary)
    return ", ".join(t for t in out if t)


def rewrite_body(body: str, new_fields: dict) -> str:
    out = body
    for key, value in new_fields.items():
        rx = FIELD_LINE_RE[key]
        out, count = rx.subn(lambda m: f"{m.group(1)} {value}", out, count=1)
    return out


def runnable_in(rec: dict, north_star: str, primary: str, secondary: str) -> Optional[int]:
    """The pass's runnable count for one admitted North Star; None when not recorded."""
    by_ns = rec.get("runnable_by_admitted")
    if isinstance(by_ns, dict) and isinstance(by_ns.get(north_star), int):
        return by_ns[north_star]
    key = ""
    if north_star == primary:
        key = "primary_runnable"
    elif north_star and north_star == secondary:
        key = "secondary_runnable"
    value = rec.get(key) if key else None
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def jam_reasons(rec: dict, jammed: list[str]) -> str:
    """`<ns>=[m:status,...]` for each jammed North Star, from the newest pass."""
    by_ns = rec.get("jam_reasons_by_admitted")
    by_ns = by_ns if isinstance(by_ns, dict) else {}
    parts = []
    for ns in jammed:
        reasons = by_ns.get(ns)
        if isinstance(reasons, list) and reasons:
            parts.append(f"{ns}=[{','.join(str(r) for r in reasons)}]")
        else:
            parts.append(f"{ns}=[no-nonterminal-milestone]")
    return "; ".join(parts)


def evaluate_backfill(
    matched: list[dict],
    primary: str,
    secondary: str,
    backfill: str,
    backfill_for: str,
    paused: str,
    status_of,
) -> dict:
    """Decide the jam backfill change. `action` is None, "admit", or "clear"."""
    out: dict = {"action": None, "jammed": [], "jam_reasons": ""}
    if len(matched) < 2:
        out["backfill_verdict"] = "no-backfill-change-insufficient-passes"
        return out
    recent = matched[:2]
    ts1, ts2 = recent[1].get("ts", ""), recent[0].get("ts", "")
    admitted = [ns for ns in (primary, secondary) if ns]

    if backfill:
        # A Backfill lane is open. Never open a second one (no fourth slot);
        # only decide whether the jam it covers is over.
        watched = [backfill_for] if backfill_for else admitted
        gone = [ns for ns in watched if ns not in admitted]
        recovered = all(
            (runnable_in(rec, ns, primary, secondary) or 0) > 0
            for rec in recent
            for ns in watched
            if ns in admitted
        )
        if gone:
            why = f"{', '.join(gone)} is no longer admitted"
        elif recovered:
            counts = ", ".join(
                f"{ns}={runnable_in(recent[1], ns, primary, secondary)}/"
                f"{runnable_in(recent[0], ns, primary, secondary)}"
                for ns in watched
            )
            why = (
                f"{', '.join(watched)} reported runnable milestones on 2 consecutive "
                f"milestone-driver passes ({ts1}, {ts2}; runnable {counts})"
            )
        else:
            out["backfill_verdict"] = "no-backfill-change-still-jammed"
            return out
        out["action"] = "clear"
        out["backfill_verdict"] = "clear"
        out["backfill_reason"] = (
            f"Jam backfill cleared: {why}; removed Backfill {backfill}. Cards already filed "
            f"under {backfill} finish; it files no new cards. Per {BACKFILL_DECISION}."
        )
        return out

    jammed = [
        ns for ns in admitted
        if all(runnable_in(rec, ns, primary, secondary) == 0 for rec in recent)
    ]
    out["jammed"] = jammed
    if not jammed:
        out["backfill_verdict"] = "no-backfill-no-jam"
        return out
    reasons = jam_reasons(recent[0], jammed)
    out["jam_reasons"] = reasons
    supply = recent[0].get("idle_by_north_star")
    if not isinstance(supply, dict):
        # Without the supply map the pick cannot prove the candidate has an
        # idle milestone, and a backfill with nothing to decompose adds no work.
        out["backfill_verdict"] = "no-backfill-no-supply-map"
        return out
    skipped: list = []
    candidate = pick_candidate(
        paused, primary, secondary, status_of=status_of, skipped=skipped, supply=supply,
    )
    out["backfill_skipped"] = skipped
    if candidate is None:
        out["backfill_verdict"] = "no-backfill-candidate"
        return out
    out["action"] = "admit"
    out["backfill_verdict"] = "admit"
    out["new_backfill"] = candidate
    out["backfill_for"] = jammed[0]
    out["backfill_reason"] = (
        f"Jam backfill: {', '.join(jammed)} reported zero runnable milestones (in_flight or "
        f"idle_promoteable) on 2 consecutive milestone-driver passes ({ts1}, {ts2}); "
        f"jam reasons: {reasons}; admitted highest-ranked paused {candidate} with an idle "
        f"milestone ({supply.get(candidate, 0)}) as Backfill per {BACKFILL_DECISION}."
    )
    return out


def strip_backfill_lines(body: str) -> str:
    return BACKFILL_LINES_RE.sub("", body)


def set_backfill_lines(body: str, backfill: str, backfill_for: str, since: str) -> str:
    """Put the three Backfill lines right after Secondary (or Primary)."""
    out = strip_backfill_lines(body)
    anchor = FIELD_LINE_RE["secondary"].search(out) or FIELD_LINE_RE["primary"].search(out)
    lines = f"Backfill: {backfill}\nBackfill-For: {backfill_for}\nBackfill-Since: {since}"
    if anchor is None:
        return f"{lines}\n{out}"
    pos = anchor.end()
    return f"{out[:pos]}\n{lines}{out[pos:]}"


CONTRACT_REWRITES = (
    (
        "The North Star driver can create milestones only for the primary or secondary value.",
        "The North Star driver can create milestones only for the primary, secondary, or backfill value.",
    ),
    (
        "The milestone driver can create Kind:pr cards only for the primary or secondary value.",
        "The milestone driver can create Kind:pr cards only for the primary, secondary, or backfill value.",
    ),
)
BACKFILL_SECTION = f"""## Jam backfill

An admitted North Star is jammed when it has zero runnable milestones (gap-report status `in_flight` or `idle_promoteable`) on two consecutive `last-stack-milestone-driver` passes. Then `last-stack-portfolio-auto-refill` admits the highest-ranked paused North Star that has an idle milestone as a temporary Backfill lane. It uses the auto-refill ranking and writes `Backfill`, `Backfill-For` (the jammed North Star) and `Backfill-Since`. The Backfill North Star keeps its place in Paused.

Only one Backfill lane exists at a time. The factory never admits more than three feature North Stars.

When the jammed North Star has runnable milestones again on two consecutive passes, the tool removes the Backfill lines. Cards already filed under the Backfill lane finish. The Backfill North Star files no new cards after removal.

A jam is also an alarm: the Reason names the jammed milestones and their status. The Backfill lane keeps the factory busy. It does not repair the jam.

Tom keeps veto as for auto-refill: an edit with a newer `Updated-At` resets the trigger.

See `{BACKFILL_DECISION}`.

"""


def ensure_backfill_prose(body: str) -> str:
    """Bring the Contract and the Jam backfill section up to date. Idempotent."""
    out = body
    for old, new in CONTRACT_REWRITES:
        out = out.replace(old, new)
    if "## Jam backfill" in out:
        return out
    idx = out.find("## Auto-refill")
    if idx >= 0:
        return out[:idx] + BACKFILL_SECTION + out[idx:]
    return out.rstrip("\n") + "\n\n" + BACKFILL_SECTION.rstrip("\n") + "\n"


def post_notice(title: str, summary: str, situations_bin: str, actor: str, kind: str) -> bool:
    try:
        cp = subprocess.run(
            [
                situations_bin, "notice",
                "--title", title,
                "--kind", kind,
                "--system", "last-stack",
                "--actor", actor,
                "--summary", summary,
            ],
            text=True, capture_output=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return cp.returncode == 0


def brain_put(meta: dict, body: str, brain_bin: str, fixture_dir: Optional[Path]) -> bool:
    slug = meta.get("slug", ADMISSION_SLUG)
    fm = ["---", f"type: {meta.get('type', 'preference')}", f"slug: {slug}"]
    if meta.get("title"):
        fm.append(f"title: {meta['title']}")
    if meta.get("status"):
        fm.append(f"status: {meta['status']}")
    if meta.get("tags"):
        fm.append(f"tags: {meta['tags']}")
    fm.append("---")
    fm.append("")
    payload = "\n".join(fm) + body
    if not payload.endswith("\n"):
        payload += "\n"

    if fixture_dir is not None:
        put_dir = fixture_dir / "put"
        put_dir.mkdir(parents=True, exist_ok=True)
        (put_dir / f"{slug}.txt").write_text(payload)
        # Mirror the live effect: a subsequent get reflects the write.
        get_dir = fixture_dir / "get"
        get_dir.mkdir(parents=True, exist_ok=True)
        header = f"[{meta.get('type', 'preference')}] {slug}\n"
        get_body = f"title:      {meta.get('title', '')}\nstatus:     {meta.get('status', '')}\ntags:       {meta.get('tags', '')}\n---\n\n{body}"
        (get_dir / f"{slug}.txt").write_text(header + get_body)
        return True

    try:
        cp = subprocess.run(
            [brain_bin, "put"], input=payload, text=True, capture_output=True, timeout=120,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return cp.returncode == 0


def notice_refill(candidate: str, policy_version: int, situations_bin: str, actor: str, apply_notice: bool) -> bool:
    if not apply_notice:
        return True
    try:
        cp = subprocess.run(
            [
                situations_bin, "notice",
                "--title", f"Portfolio auto-refill admitted {candidate} (Policy-Version {policy_version})",
                "--kind", "other",
                "--system", "last-stack",
                "--actor", actor,
                "--summary",
                (
                    f"{DRIVER_ACTOR} admitted {candidate} into the Secondary slot after two "
                    "consecutive drained milestone-driver passes. Tom can veto by editing "
                    f"{ADMISSION_SLUG}."
                ),
            ],
            text=True, capture_output=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return cp.returncode == 0


def main(argv: Optional[list[str]] = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--passes-file", default=os.environ.get("LAST_STACK_PORTFOLIO_PASSES_FILE", str(DEFAULT_PASSES_FILE)))
    ap.add_argument("--fixture-dir", help="Offline brain: get/<slug>.txt, put/<slug>.txt (no live node)")
    ap.add_argument("--brain", default=os.environ.get("BRAIN_BIN", "brain"))
    ap.add_argument("--situations", default=os.environ.get("SITUATIONS_BIN", "situations"))
    ap.add_argument("--notice-actor", default=f"routine:{DRIVER_ACTOR}")
    ap.add_argument("--apply", action="store_true", help="Actually rewrite the admission record and post a notice")
    ap.add_argument("--now", default="", help="Override the write timestamp (tests only)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    fixture = Path(args.fixture_dir) if args.fixture_dir else None

    got = read_admission(args.brain, fixture)
    if got is None:
        result = {"verdict": "admission-unreadable", "refilled": False}
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        print(f"last-stack-portfolio-auto-refill: {ADMISSION_SLUG} is unreadable", file=sys.stderr)
        return 1
    meta, body, _raw = got
    fields = parse_admission_fields(body)

    primary = normalize(fields.get("primary", ""))
    secondary = normalize(fields.get("secondary", ""))
    paused = fields.get("paused", "")
    updated_at = fields.get("updated-at", "")
    try:
        policy_version = int(fields.get("policy-version", ""))
    except ValueError:
        result = {"verdict": "admission-malformed", "refilled": False, "reason": "Policy-Version is not an integer"}
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        print("last-stack-portfolio-auto-refill: admission record is malformed (Policy-Version)", file=sys.stderr)
        return 1
    if not primary:
        result = {"verdict": "admission-malformed", "refilled": False, "reason": "Primary is empty"}
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        print("last-stack-portfolio-auto-refill: admission record is malformed (Primary)", file=sys.stderr)
        return 1

    passes_path = Path(args.passes_file)
    if passes_path.is_file():
        try:
            passes = load_passes(passes_path)
        except OSError as exc:
            result = {"verdict": "passes-file-unreadable", "refilled": False, "reason": str(exc)}
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            return 2
    else:
        passes = []

    backfill = normalize(fields.get("backfill", ""))
    backfill_for = normalize(fields.get("backfill-for", ""))
    matched = matching_tail(passes, primary, secondary, updated_at, backfill)
    result = {
        "verdict": "",
        "refilled": False,
        "primary": primary,
        "secondary": secondary,
        "backfill": backfill,
        "backfill_for": backfill_for,
        "policy_version": policy_version,
        "matched_pass_count": len(matched),
        "candidate": "",
    }
    status_of = lambda slug: read_north_star_status(slug, args.brain, fixture)  # noqa: E731

    def finish() -> int:
        """Emit the report; exit 1 only when a write was attempted and failed."""
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print(
                f"last-stack-portfolio-auto-refill: {result['verdict']} "
                f"candidate={result.get('candidate') or 'none'} "
                f"backfill={result.get('backfill_verdict', 'none')} "
                f"policy_version={policy_version}->{result.get('new_policy_version', policy_version)}"
            )
        return 1 if result["verdict"] == "write-failed" else 0

    def run_backfill() -> int:
        """The jam backfill lane runs only when the refill did not fire."""
        refill_verdict = result["verdict"]
        change = evaluate_backfill(
            matched, primary, secondary, backfill, backfill_for, paused, status_of,
        )
        result.update({k: v for k, v in change.items() if k != "action"})
        action = change.get("action")
        if action is None:
            return finish()
        new_policy_version = policy_version + 1
        new_updated_at = args.now or now_iso()
        result["new_policy_version"] = new_policy_version
        result["refill_verdict"] = refill_verdict
        if action == "admit":
            result["verdict"] = "backfilled" if args.apply else "would-backfill"
            new_body = set_backfill_lines(
                body, change["new_backfill"], change["backfill_for"], new_updated_at
            )
        else:
            result["verdict"] = "backfill-cleared" if args.apply else "would-clear-backfill"
            new_body = strip_backfill_lines(body)
        if not args.apply:
            return finish()
        new_body = ensure_backfill_prose(new_body)
        new_body = rewrite_body(new_body, {
            "policy-version": str(new_policy_version),
            "updated-at": new_updated_at,
            "updated-by": DRIVER_ACTOR,
            "reason": change["backfill_reason"],
        })
        if not brain_put(meta, new_body, args.brain, fixture):
            result["verdict"] = "write-failed"
            print(
                "last-stack-portfolio-auto-refill: brain put failed; admission record unchanged",
                file=sys.stderr,
            )
            return finish()
        if action == "admit":
            title = (
                f"Portfolio jam backfill admitted {change['new_backfill']} "
                f"for {change['backfill_for']} (Policy-Version {new_policy_version})"
            )
        else:
            title = (
                f"Portfolio jam backfill cleared {backfill} "
                f"(Policy-Version {new_policy_version})"
            )
        result["notice_posted"] = post_notice(
            title, change["backfill_reason"], args.situations, args.notice_actor, "config",
        )
        return finish()

    if len(matched) < 2:
        result["verdict"] = "no-trigger-insufficient-passes"
        return run_backfill()

    two_most_recent = matched[:2]
    drained = all(
        rec.get("primary_idle_promoteable") == 0
        and rec.get("primary_idle_empty") == 0
        and rec.get("secondary_idle_promoteable") == 0
        and rec.get("secondary_idle_empty") == 0
        for rec in two_most_recent
    )
    if not drained:
        result["verdict"] = "no-trigger-supply-not-drained"
        return run_backfill()

    skipped: list = []
    supply = two_most_recent[0].get("idle_by_north_star")
    if not isinstance(supply, dict):
        supply = None
    candidate = pick_candidate(
        paused,
        primary,
        secondary,
        status_of=status_of,
        skipped=skipped,
        supply=supply,
        exclude=(backfill,) if backfill else (),
    )
    result["skipped_terminal"] = skipped
    result["supply_aware"] = supply is not None
    if candidate is None:
        result["verdict"] = "no-candidate"
        print(
            "last-stack-portfolio-auto-refill: trigger fired but no paused North Star candidate "
            f"remains in {ADMISSION_SLUG}",
            file=sys.stderr,
        )
        return run_backfill()

    result["candidate"] = candidate
    result["verdict"] = "would-refill" if not args.apply else "refilled"

    ts1, ts2 = two_most_recent[1].get("ts", ""), two_most_recent[0].get("ts", "")
    new_policy_version = policy_version + 1
    new_updated_at = args.now or now_iso()
    new_paused = rebuild_paused(paused, candidate, secondary)
    from_catch_all = normalize(candidate) not in [normalize(t) for t in paused.split(",")]
    if from_catch_all:
        pick = (
            f"no ranked paused North Star had an idle milestone, so admitted {candidate} "
            f"({supply.get(candidate, 0)} idle milestones) from {CATCH_ALL}"
        )
    elif supply is not None:
        pick = (
            f"admitted highest-ranked paused {candidate} with an idle milestone "
            f"({supply.get(candidate, 0)})"
        )
    else:
        pick = f"admitted highest-ranked paused {candidate}"
    reason = (
        f"Auto-refill: {primary} and {secondary} reported zero idle-promoteable and zero "
        f"idle-empty milestones on 2 consecutive milestone-driver passes ({ts1}, {ts2}); "
        f"{pick} into Secondary per "
        "decision-2026-09-03-portfolio-auto-refill-from-ranking."
    )
    result["new_policy_version"] = new_policy_version
    result["new_secondary"] = candidate
    result["new_paused"] = new_paused
    result["reason"] = reason

    if args.apply:
        new_body = rewrite_body(body, {
            "policy-version": str(new_policy_version),
            "secondary": candidate,
            "paused": new_paused,
            "updated-at": new_updated_at,
            "updated-by": DRIVER_ACTOR,
            "reason": reason,
        })
        put_ok = brain_put(meta, new_body, args.brain, fixture)
        if not put_ok:
            result["verdict"] = "write-failed"
            result["refilled"] = False
            print("last-stack-portfolio-auto-refill: brain put failed; admission record unchanged", file=sys.stderr)
            return finish()
        result["refilled"] = True
        notice_ok = notice_refill(candidate, new_policy_version, args.situations, args.notice_actor, True)
        result["notice_posted"] = notice_ok

    return finish()


if __name__ == "__main__":
    sys.exit(main())
