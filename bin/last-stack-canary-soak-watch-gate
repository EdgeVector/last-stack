#!/usr/bin/env bash
# Stateless hourly reconciler for the LastDB canary v2 evidence ledger.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

pipeline="${LAST_STACK_CANARY_V2_PIPELINE:-${ROOT}/bin/last-stack-canary-pipeline}"
run_dir="${ROUTINES_RUN_DIR:-${TMPDIR:-/tmp}}"
evidence="${LAST_STACK_CANARY_V2_GATE_EVIDENCE:-${run_dir}/canary-v2-gate.out}"
window_seconds="${LAST_STACK_CANARY_V2_WINDOW_SECONDS:-86400}"
status_command="${LAST_STACK_CANARY_V2_STATUS_CHECK_CMD:-}"
host_command="${LAST_STACK_CANARY_V2_HOST_CHECK_CMD:-situations preflight --action lastdb-safe-upgrade}"

usage() {
  printf '%s\n' 'last-stack-canary-soak-watch-gate'
  printf '%s\n' 'Read bounded durable evidence and append one stateless canary verdict.'
}

case "${1:-}" in
  '') ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

[ -x "$pipeline" ] || {
  printf 'CANARY_V2_GATE result=error evidence=pipeline_missing\n'
  printf 'ROUTINE_RESULT outcome=error detail=pipeline_missing\n'
  exit 0
}

socket="${LASTDB_SOCKET:-${HOME}/.lastdb/data/folddb.sock}"
if [ -z "$status_command" ]; then
  status_command="curl -fsS --max-time 2 --unix-socket '$socket' http://localhost/api/status"
fi

candidate="${LAST_STACK_CANARY_V2_CANDIDATE:-}"
if [ -z "$candidate" ]; then
  identity_command="${LAST_STACK_CANARY_V2_CANDIDATE_CMD:-last-stack-lastdb-memory-guard --identity}"
  set +e
  identity_output="$(eval "$identity_command" 2>/dev/null)"
  identity_rc=$?
  set -e
  if [ "$identity_rc" -eq 0 ]; then
    for token in $identity_output; do
      case "$token" in
        build=*) candidate="${token#build=}" ;;
      esac
    done
  fi
fi

if [ -z "$candidate" ] || [ "$candidate" = "unknown" ]; then
  printf 'CANARY_V2_GATE result=error evidence=candidate_identity_absent\n'
  printf 'ROUTINE_RESULT outcome=error detail=candidate_identity_absent\n'
  exit 0
fi

sync_args=(--json sync-boot-ledger --candidate "$candidate")
if [ -n "${LAST_STACK_CANARY_V2_BOOT_LEDGER_CMD:-}" ]; then
  sync_args+=(--boot-ledger-command "$LAST_STACK_CANARY_V2_BOOT_LEDGER_CMD")
fi
if [ -n "${LAST_STACK_CANARY_V2_BOOT_LEDGER_FILE:-}" ]; then
  sync_args+=(--boot-ledger-file "$LAST_STACK_CANARY_V2_BOOT_LEDGER_FILE")
fi
set +e
sync_json="$($pipeline "${sync_args[@]}")"
sync_rc=$?
set -e
if [ "$sync_rc" -ne 0 ]; then
  printf 'CANARY_V2_GATE candidate=%s result=error evidence=boot_ledger_command_error\n' "$candidate"
  printf 'ROUTINE_RESULT outcome=error detail=boot_ledger_command_error\n'
  exit 0
fi
sync_result="$(printf '%s\n' "$sync_json" | jq -r '.result // "invalid"' 2>/dev/null || true)"

# The status route has the v2 2-second handler budget. Three measured samples
# produce a real p95; timeout and absence become build evidence.
"$pipeline" observe-command --candidate "$candidate" --check status --subject build \
  --command "$status_command" --samples 3 --timeout-seconds 2 --budget-ms 2000 >/dev/null

# A host fence pauses the window. It does not mark the candidate red.
"$pipeline" observe-command --candidate "$candidate" --check host_fence --subject host \
  --command "$host_command" --samples 1 --timeout-seconds 10 --budget-ms 10000 >/dev/null

reconcile_args=(--json reconcile --candidate "$candidate" --window-seconds "$window_seconds")
if [ -n "${LAST_STACK_CANARY_V2_AT:-}" ]; then
  reconcile_args+=(--at "$LAST_STACK_CANARY_V2_AT")
fi
if [ "${LAST_STACK_CANARY_V2_EXECUTE_ACTIONS:-0}" = "1" ]; then
  [ -n "${LAST_STACK_CANARY_V2_ACTION_CMD:-}" ] || {
    printf 'CANARY_V2_GATE candidate=%s result=error evidence=action_command_missing\n' "$candidate"
    printf 'ROUTINE_RESULT outcome=error detail=action_command_missing\n'
    exit 0
  }
  reconcile_args+=(--execute-actions --action-command "$LAST_STACK_CANARY_V2_ACTION_CMD")
fi
set +e
verdict_json="$($pipeline "${reconcile_args[@]}")"
verdict_rc=$?
set -e
if [ "$verdict_rc" -ne 0 ]; then
  printf 'CANARY_V2_GATE candidate=%s result=error evidence=reconcile_command_error\n' "$candidate"
  printf 'ROUTINE_RESULT outcome=error detail=reconcile_command_error\n'
  exit 0
fi

verdict="$(printf '%s\n' "$verdict_json" | jq -r '.verdict // "invalid"')"
subject="$(printf '%s\n' "$verdict_json" | jq -r '.subject // "none"')"
action="$(printf '%s\n' "$verdict_json" | jq -r '.action // "unknown"')"
detail="$(printf '%s\n' "$verdict_json" | jq -r '.evidence // "unknown"')"

case "$verdict" in
  green) outcome=ok ;;
  window-open|superseded) outcome=noop ;;
  red|line-stopped) outcome=error ;;
  *) outcome=error ;;
esac

mkdir -p "$(dirname "$evidence")"
printf 'CANARY_V2_GATE candidate=%s verdict=%s subject=%s action=%s evidence=%s sync=%s\n' \
  "$candidate" "$verdict" "$subject" "$action" "$detail" "$sync_result" | tee "$evidence"
printf 'ROUTINE_RESULT outcome=%s detail=verdict=%s subject=%s action=%s\n' \
  "$outcome" "$verdict" "$subject" "$action"
