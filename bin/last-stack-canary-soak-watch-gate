#!/usr/bin/env bash
# Zero-agent scheduled tick for the LastDB canary soak lane.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

launcher="${LAST_STACK_CANARY_SOAK_GATE_LAUNCHER:-${ROOT}/bin/last-stack-canary-loom}"
run_dir="${ROUTINES_RUN_DIR:-${TMPDIR:-/tmp}}"
evidence="${LAST_STACK_CANARY_SOAK_GATE_EVIDENCE:-${run_dir}/canary-soak-gate.out}"

usage() {
  cat <<'USAGE'
last-stack-canary-soak-watch-gate

Exit 0 completes the scheduled tick without a model.
Exit 10 asks routinesd to start the full soak-watch agent.
USAGE
}

case "${1:-}" in
  "") ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

[ -x "$launcher" ] || {
  printf 'CANARY_SOAK_GATE_PROCEED reason=launcher-missing\n'
  exit 10
}
mkdir -p "$(dirname "$evidence")"
tmp="$(mktemp "${TMPDIR:-/tmp}/canary-soak-gate.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# Bound the launcher. routinesd caps this gate at GATE_TIMEOUT_CAP_MS (15m) and
# SIGTERMs it there — and a SIGTERMed gate emits no ROUTINE_RESULT and never
# reaches the `cp "$tmp" "$evidence"` below, so the hourly tick produced NOTHING:
# stdout, stderr and evidence all 0 bytes, outcome `gate-timeout`, no verdict for
# the soak lane. Twice in twelve ticks (2026-08-30T22:34Z, 2026-08-31T06:34Z)
# against a 2-35s normal runtime. `timeout -k` also SIGKILLs a child that ignores
# the TERM, which the plain cap did not: those runs left loom and lastgit
# descendants writing into the finished run's scratch/ for another 15 minutes.
#
# 780s leaves headroom under the 15m cap for the evidence copy and the trailer,
# matching `last-stack-whats-wrong-loom`. The sibling gate that already got this
# fix is `last-stack-routine-observer-gate`
# (LAST_STACK_WHY_STOPPED_LOOM_TIMEOUT_SEC); this was the last unbounded loom
# caller of the three.
launcher_timeout="${LAST_STACK_CANARY_SOAK_GATE_TIMEOUT_SEC:-780}"
case "$launcher_timeout" in
  ''|*[!0-9]*) launcher_timeout=780 ;;
esac
[ "$launcher_timeout" -ge 1 ] || launcher_timeout=780

set +e
if command -v timeout >/dev/null 2>&1; then
  timeout -k 2s "${launcher_timeout}s" "$launcher" --json --quiet >"$tmp" 2>&1
else
  # No coreutils `timeout`: keep the old unbounded call rather than inventing a
  # second reaper here. The routines cap still applies, so this degrades to the
  # prior behaviour instead of failing the tick outright.
  "$launcher" --json --quiet >"$tmp" 2>&1
fi
launcher_rc=$?
set -e

# 124 is `timeout`'s own signal that it fired; 137 is the -k SIGKILL escalation.
if [ "$launcher_rc" -eq 124 ] || [ "$launcher_rc" -eq 137 ]; then
  cp "$tmp" "$evidence"
  printf 'CANARY_SOAK_GATE_LAUNCHER_TIMEOUT after=%ss rc=%s evidence=%s\n' \
    "$launcher_timeout" "$launcher_rc" "$evidence"
  # Report the tick instead of being killed mid-flight. Exit 0 so routinesd takes
  # the outcome from this trailer: an error the operator can read beats a
  # `gate-timeout` with empty logs. Do NOT exit 10 — handing a hung launcher to
  # the full agent gives it the same unbounded call with less budget left.
  printf '%s %s\n' 'ROUTINE_RESULT' \
    "outcome=error detail=launcher-timeout=${launcher_timeout}s rc=${launcher_rc}"
  exit 0
fi

if [ "$launcher_rc" -eq 0 ] \
   && grep -Eq '^ROUTINE_RESULT outcome=(ok|noop|error)( |$)' "$tmp"; then
  cat "$tmp"
  exit 0
fi

# Keep the failed tick for the full agent or later inspection. The launcher
# writes structured JSON first, then the legacy result trailer.
cp "$tmp" "$evidence"
status="$(sed -n '1p' "$tmp" | jq -r '.status // ""' 2>/dev/null || true)"

if [ "$status" = "failed" ]; then
  # Preserve the RED result without a dispatcher model. The dedicated healer
  # fires at :36, two minutes after this :34 soak tick, with its 90-minute cap.
  # Running that healer inside this gate would inherit the 15-minute soak cap.
  cat "$tmp"
  exit 0
fi

# Transport, state, and parse failures need the full agent. Do not emit a
# result trailer here; exit 10 transfers ownership to the scheduled prompt.
printf 'CANARY_SOAK_GATE_PROCEED reason=tick-error rc=%s status=%s evidence=%s\n' \
  "$launcher_rc" "${status:-unknown}" "$evidence"
exit 10
