#!/usr/bin/env bash
# Pre-execution lint for ONE agent shell command. It rejects the command
# shapes that routine agents kept writing, each of which fails on this host
# in a known way. The command arrives on stdin (or --command STR).
#
# Why this exists (measured 2026-09-23, papercut burn-down wave 2):
#   Wave 1 closed the canonical rows for these hazards with prose rules in
#   brain sop-routine-shared-contract section 5. Routine agents re-filed ~35
#   copies within hours, because 71 of 76 routines run under Codex and no
#   Codex routine reads that brain record. Prose did not reach the agent;
#   a check at the exec boundary does.
#
# Callers:
#   lib/routine-shell/codex-routine-bash.zsh  every Codex routine command
#   hooks/routine-shell-lint.sh               every Claude Code Bash command
#   bin/last-stack-lint-prompts --shell-blocks fenced bash blocks in prompts
#
# Rules (id: what fails -> the fix the rejection prints):
#   spin-wait         read -t N < /dev/zero never waits; it burns a core
#   heredoc-backticks unquoted heredoc body with backticks runs them
#   dquote-backticks  --body "...`x`..." runs x (same for --evidence etc.)
#   jq-optional-call  jq 1.7.1 rejects f(...)?.x and (.a)?.b
#   jq-escaped-quote  \" anywhere in a jq program (interpolation or a plain
#                     string literal like (.severity // \"-\")) means the
#                     program was built double-quoted; a JS-tool-call layer
#                     can drop the backslash in transport and deliver a
#                     broken filter (measured 2026-09-26, the CLAUDE.md
#                     `situations` TSV example losing its "-" fallback)
#   awk-match-array   macOS awk has no match(s, /re/, arr)
#   sed-inplace       macOS sed -i needs an extension argument
#   date-nanos        macOS date has no %N (date +%s%3N prints ...3N)
#   stat-local-zulu   stat -t with a format ending in a LITERAL Z prints LOCAL
#                     time and appends Z, so the value is in the exact shape
#                     every UTC stamp on this fleet uses and is 25200s wrong.
#                     One-directional: it always reads OLDER, so it manufactures
#                     stalls and never hides one (measured 2026-10-03, a
#                     13-minute-old log read as 7 hours stale and nearly became
#                     a p1 "the refresh agent is dead" finding). TZ=UTC on the
#                     same line is correct and passes.
#   printf-dash       printf '- x' / printf '--- x': a format that starts with - is an option
#   bin-path          /bin/sed, /bin/grep, the /bin temp-file tool ... do not exist on macOS (they are in /usr/bin)
#   mktemp-suffix     an X run that is not at the END of a mktemp template never substitutes on BSD mktemp
#   zsh-status        (--shell zsh only) status is read-only in zsh
#   zsh-mapfile       (--shell zsh only) mapfile/readarray do not exist in zsh
#   zsh-word-split    (--shell zsh only) for x in $VAR does not split; one pass over the whole string
#   zsh-cond-flag-expansion  (--shell zsh only) an unquoted ${var:+--flag "$v"}
#                     composes a flag and a quoted value inside one parameter
#                     expansion. zsh has no SH_WORD_SPLIT, so the WHOLE
#                     substitution stays one word even though the embedded
#                     quotes look like they separate two tokens; bash DOES
#                     split it into two (measured: both shells agree the
#                     nested quotes are honored, but only bash then
#                     word-splits the unquoted result). A CLI then sees one
#                     argument '--flag value' instead of two and reports an
#                     unknown option (measured 2026-10-08: brain papercut
#                     close --fixed-by silently no-opped on 14 rows, with the
#                     wrapper's own rc/echo still reporting success).
#   home-root-scan    a scanner walks $HOME itself, or reads a macOS
#                     TCC-protected folder (Desktop/Documents/Downloads/
#                     Pictures/Movies/Music); the walk BLOCKS on a privacy
#                     prompt attributed to `routines` (measured 2026-09-05,
#                     brain instructions/no-home-root-scan.md). 71+ of the
#                     fleet runs under Codex, which had no guard for this
#                     until now (only the Claude Code hook did) — that gap is
#                     why the same stall recurred in loom review, disk-reclaim
#                     and feature-prove.
#   piped-count-false-zero  a pipeline whose PRODUCER is a path under $HOME and
#                     whose consumer collapses the stream to a count or a boolean
#                     (grep -c / grep -q / wc -l). When the path does not exist
#                     the producer exits 127, stdout is empty, and the count is
#                     0 -- the same answer as "the symbol is absent". The error
#                     is one-directional: a missing producer can only LOWER the
#                     count, so the shape manufactures "the fix never shipped"
#                     and can never manufacture "it shipped" (measured
#                     2026-10-03: the preceding resolver pass recorded a
#                     baseline of 0 for an install proof whose producer path did
#                     not exist, while the fix was installed and the real tree
#                     answered 6). $HOME paths specifically, because install
#                     roots, canary trees and artifact version dirs come and go
#                     with delivery state; /usr/bin, /bin and /opt/homebrew are
#                     excluded, and CLAUDE.md tells agents to call /usr/bin/grep.
#   grep-binary-false-zero  grep -c (or -q/--count) against a bun-compiled
#                     binary (a host-track current/canary tree, a last-stack
#                     artifacts/current tree, or a path ending in /dist/<name>
#                     with no extension) answers 0/exit-1 on a symbol that IS
#                     present: grep's binary-content sniff suppresses normal
#                     match counting (measured 2026-10-08 on the installed
#                     routines binary -- grep -c found 0, grep -ac and
#                     strings | grep -c both found 2). Same one-directional
#                     "the fix never shipped" shape as piped-count-false-zero.
#                     strings <path> | grep -c <sym>, or grep -ac, are correct
#                     and not refused.
#
# Text inside a heredoc body is data, so only heredoc-backticks looks there.
# So is the interior of a quoted data argument (--body, --evidence,
# --verified-by ..., git commit -m): a single-quoted one always, a double-quoted
# one unless it holds $( , a backtick or ${ (those RUN). See blank_data_args.
# Escape hatch: put "shell-lint-ok: <reason>" anywhere in the command.
# home-root-scan also honors the older "home-scan-ok: <reason>" phrase, so a
# command already annotated for the standalone Claude Code hook still passes.
#
# Usage:
#   last-stack-routine-shell-lint [--shell bash|zsh] [--command STR] [--quiet]
#   last-stack-routine-shell-lint --list-rules
# Exit: 0 pass, 2 rejected (message on stderr), 64 usage error.
set -u

shell_kind="bash"
command_text=""
have_command=0
quiet=0

# Print the whole leading comment block, minus the shebang. A line RANGE went
# stale the moment the header grew: `sed -n '2,36p'` stopped at zsh-mapfile, so
# --help silently dropped zsh-word-split, home-root-scan, the escape hatch and
# the entire Usage section. Stop at the first non-comment line instead (the same
# fix bin/last-stack-lint-bin-authoring already carries for the same defect).
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --shell)
      [ "$#" -ge 2 ] || { usage >&2; exit 64; }
      shell_kind="$2"; shift 2 ;;
    --command)
      [ "$#" -ge 2 ] || { usage >&2; exit 64; }
      command_text="$2"; have_command=1; shift 2 ;;
    --quiet) quiet=1; shift ;;
    --list-rules)
      printf '%s\n' spin-wait heredoc-backticks dquote-backticks jq-optional-call jq-escaped-quote \
        awk-match-array sed-inplace date-nanos stat-local-zulu printf-dash bin-path mktemp-suffix zsh-status zsh-mapfile \
        zsh-word-split zsh-cond-flag-expansion home-root-scan piped-count-false-zero grep-binary-false-zero
      exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
  esac
done

case "$shell_kind" in
  bash|zsh) ;;
  *) echo "last-stack-routine-shell-lint: --shell must be bash or zsh" >&2; exit 64 ;;
esac

if [ "$have_command" -eq 0 ]; then
  command_text="$(cat)"
fi

case "$command_text" in
  *"shell-lint-ok:"*) exit 0 ;;
esac

# home-root-scan keeps the standalone Claude Code hook's own escape phrase
# too, so a command already annotated for that hook is not double-blocked
# here.
home_scan_escaped=0
case "$command_text" in
  *"home-scan-ok:"*) home_scan_escaped=1 ;;
esac

# Rule table: id | canonical papercut | fix line.
rule_slug() {
  case "$1" in
    spin-wait) echo papercut-agent-spin-wait-read-t-dev-zero-20260922 ;;
    heredoc-backticks|dquote-backticks) echo papercut-routine-heredoc-command-substitution ;;
    jq-optional-call) echo papercut-routine-jq-optional-field-syntax-unsupported-20260922 ;;
    jq-escaped-quote) echo papercut-routine-jq-quoted-filter-escape-20260922 ;;
    awk-match-array) echo papercut-routine-done-when-sweep-awk-match-portability-20260923 ;;
    sed-inplace) echo papercut-macos-sed-inplace-requires-extension-20260923 ;;
    date-nanos) echo papercut-routine-zsh-date-percent-n-no-millisecond-timer-20260923 ;;
    stat-local-zulu) echo papercut-stat-t-format-prints-local-time-with-a-literal-z-so-a-fresh-log-reads-as-hours-stale-20261003 ;;
    printf-dash) echo papercut-routine-printf-leading-dash-format-20260923 ;;
    bin-path) echo papercut-routine-hard-coded-bin-mktemp-20260923 ;;  # fix form: mktemp "$TMPDIR/x.XXXXXX"
    mktemp-suffix) echo papercut-mktemp-same-template-collides-within-one-second-20260925 ;;
    zsh-status|zsh-mapfile) echo papercut-routine-shell-word-splitting ;;
    zsh-word-split) echo papercut-claude-zsh-for-loop-over-an-unquoted-scalar-does-not-word-split-20260926 ;;
    zsh-cond-flag-expansion) echo papercut-zsh-conditional-flag-expansion-silently-mangles-brain-close-fixedby-20261008 ;;
    home-root-scan) echo papercut-codex-routines-lack-home-root-scan-guard-20260927 ;;
    piped-count-false-zero) echo papercut-piped-count-from-a-home-path-producer-answers-zero-when-the-path-is-absent-20261003 ;;
    grep-binary-false-zero) echo papercut-grep-c-symbol-on-bun-binary-answers-zero-false-negative-20261008 ;;
  esac
}

rule_fix() {
  case "$1" in
    spin-wait) printf '%s\n' \
      "read -t N < /dev/zero returns at once (zero bytes are always ready), so the loop spins one core." \
      "Wait with: sleep 30 (Codex/routines), or a background command plus one check per turn (Claude Code)." ;;
    heredoc-backticks) printf '%s\n' \
      "An unquoted heredoc (<<EOF) runs \`...\` and \$(...) in its body. Markdown code spans become commands." \
      "Quote the delimiter: cat > \"\$f\" <<'EOF' ... EOF, then pass --body \"\$(cat \"\$f\")\"." ;;
    dquote-backticks) printf '%s\n' \
      "Backticks inside a double-quoted --body/--evidence argument run as commands before the CLI sees the text." \
      "Write the text to a file with a quoted heredoc (<<'EOF'), then pass --body \"\$(cat \"\$f\")\"." ;;
    jq-optional-call) printf '%s\n' \
      "Host jq is 1.7.1: '?' after a call or a paren cannot take a .field (match(..)?.string fails to compile)." \
      "Use: try (match(\"re\").string) catch \"\"   or   (capture(\"(?<p>re)\") // {}) | .p // \"\"" \
      "DONE-WHEN sweep: run last-stack-kanban-done-when-sweep instead of writing jq." ;;
    jq-escaped-quote) printf '%s\n' \
      "A double-quoted jq program with an escaped string literal (\\\"...\\\", inside \\( ) or a plain (.field // \\\"-\\\")) can lose the backslash in transport (e.g. a JS tool call), delivering a broken filter." \
      "Single-quote the whole jq program instead: jq -r '.[] | [.slug, .status, (.severity // \"-\")] | @tsv'" ;;
    awk-match-array) printf '%s\n' \
      "macOS awk has no third match() argument (that is GNU awk)." \
      "Use: sed -n 's/^DONE-WHEN:[[:space:]]*//p' file | head -n 1" ;;
    sed-inplace) printf '%s\n' \
      "macOS sed -i takes the NEXT word as a backup extension, so sed -i 's/a/b/' f fails." \
      "Use: sed -i '' 's/a/b/' f   or   sed -i.bak 's/a/b/' f" ;;
    date-nanos) printf '%s\n' \
      "macOS (BSD) date has no %N, so date +%s%3N prints a literal N and the arithmetic fails." \
      "Use: gdate +%s%3N (GNU coreutils is installed), or date +%s for whole seconds." ;;
    stat-local-zulu) printf '%s\n' \
      "In the BSD stat -t format string, %F and %T render from the LOCAL broken-down time and a trailing Z is emitted as a LITERAL character. The result looks like UTC, parses, sorts and compares cleanly, and is 25200 seconds wrong -- always OLDER, so it manufactures stalls." \
      "To compare ages, never format: age_s=\$(( \$(date +%s) - \$(stat -f %m -- \"\$f\") ))" \
      "For a human-readable UTC stamp: date -u -r \"\$(stat -f %m -- \"\$f\")\" +%FT%TZ" \
      "TZ=UTC on the same line also gives the right value and is NOT refused, but it is one missing TZ= away from the same lie; prefer date -u -r." ;;
    printf-dash) printf '%s\n' \
      "A printf format that starts with - is read as an option (bash: printf: --: invalid option)." \
      "Use: printf '%s\\n' '- item'   or   printf -- '- item\\n'" ;;
    bin-path) printf '%s\n' \
      "macOS keeps sed, grep, awk, find, the temp-file tool and friends in /usr/bin, not /bin." \
      "Call the tool by name or use /usr/bin/<tool>. Temp files: mktemp \"\$TMPDIR/x.XXXXXX\" (a bare call ignores TMPDIR on macOS)." ;;
    mktemp-suffix) printf '%s\n' \
      "BSD/macOS mktemp substitutes a run of X's only at the END of the template. With anything after it (card.XXXXXX.json) there is NO substitution: the literal name is created, so the FIRST call succeeds and every later call with that template fails 'mkstemp failed ... File exists' until someone deletes the literal file." \
      "Put the X run last: f=\"\$(mktemp \"\${TMPDIR:-/tmp}/card.XXXXXX\")\"" \
      "When the extension matters, take a directory: f=\"\$(mktemp -d \"\${TMPDIR:-/tmp}/card.XXXXXX\")/card.json\"" ;;
    zsh-status) printf '%s\n' \
      "zsh makes status a read-only special variable (same as \$?)." \
      "Use another name: rc, pr_state, ci_state." ;;
    zsh-mapfile) printf '%s\n' \
      "mapfile and readarray are bash builtins; zsh does not have them." \
      "Use: while IFS= read -r line; do ...; done < \"\$file\"" ;;
    zsh-word-split) printf '%s\n' \
      "zsh has no SH_WORD_SPLIT: an unquoted \$VAR in a for-list is ONE word, so the loop runs once over the whole string (bash would split it)." \
      "Use an array: FILES=(a b c); for x in \"\${FILES[@]}\"; do ...; done -- or a line reader: printf '%s\n' \$FILES | while IFS= read -r x; do ...; done" ;;
    zsh-cond-flag-expansion) printf '%s\n' \
      "zsh has no SH_WORD_SPLIT: \${var:+--flag \"\$val\"} keeps the flag and the quoted value as ONE word, so a CLI sees a single argument '--flag value' and reports an unknown option. bash would split this into two words; zsh never does, with no error." \
      "Pass the flag and its value as two separate literal arguments, built with an array: args=(); [ -n \"\$val\" ] && args+=(--flag \"\$val\"); cmd \"\${args[@]}\"" \
      "Then NEVER trust a wrapper's rc/echo after a brain/kanban mutation -- point-read the record back before reporting success." ;;
    home-root-scan) printf '%s\n' \
      "macOS treats \$HOME/Desktop, \$HOME/Documents, \$HOME/Downloads and the Photos library as protected. A routine agent runs under routinesd, so the walk raises a privacy prompt attributed to \`routines\` and BLOCKS until a human clicks it." \
      "Name the root you actually need: find \"\$HOME/code\" -maxdepth 4 -name '<what>'   or   find \"\$HOME/.routines\" \"\$HOME/.last-stack\" \"\$HOME/.fkanban\" -maxdepth 4 -name '<what>'" \
      "If you truly need the whole tree, prune the protected folders and say why: find \"\$HOME\" -maxdepth 4 \\( -path \"\$HOME/Desktop\" -o -path \"\$HOME/Documents\" -o -path \"\$HOME/Downloads\" -o -path \"\$HOME/Pictures\" -o -path \"\$HOME/Movies\" -o -path \"\$HOME/Music\" -o -path \"\$HOME/Library\" \\) -prune -o -print 2>/dev/null   # home-scan-ok: <reason>" ;;
    piped-count-false-zero) printf '%s\n' \
      "The producer is a path under \$HOME, so it may not exist: an install root, a canary tree, an artifact version dir or a worktree all come and go with delivery state. When it is absent the producer exits 127, stdout is EMPTY, and grep -c answers 0 / grep -q and wc -l answer as if nothing matched. That is the SAME answer as the symbol being absent, so the verdict silently inverts -- and only ever toward 'not delivered'." \
      "Capture the producer's own exit code, then count from the file: <path> --flags > out 2> err; echo \"rc=\$?\"; grep -c <sym> out" \
      "Or assert the path first: [ -x <path> ] || { echo MISSING; exit 1; }" \
      "To prove a merge installed, count from the resolved tree -- grep -c <sym> \"\$(readlink -f ~/.last-stack/bin/<cmd>)\" -- because a missing FILE makes grep itself exit 2 and say so, where a missing PRODUCER says nothing." ;;
    grep-binary-false-zero) printf '%s\n' \
      "grep's binary-content heuristic suppresses normal match counting on a file it sniffs as binary, so grep -c/-q/--count against a bun-compiled executable answers 0/exit-1 even when the symbol IS present. That is the same answer as the symbol being absent, so the verdict silently inverts toward 'not delivered'." \
      "Read it as text: strings <path> | grep -c <sym>   or   grep -ac <sym> <path>" ;;
  esac
}

reject() {
  local id="$1" line="$2"
  if [ "$quiet" -eq 0 ]; then
    {
      echo "last-stack-routine-shell-lint: REJECTED rule=$id (the command did not run)"
      echo "  line: ${line:0:200}"
      rule_fix "$id" | sed 's/^/  /'
      echo "  This is a known hazard with a guard (brain $(rule_slug "$id"))."
      echo "  Do NOT file a papercut for this rejection. Rewrite the command and run it again."
      echo "  Escape hatch, only when the shape is intended: add '# shell-lint-ok: <reason>'."
    } >&2
  fi
  exit 2
}

# Regexes. Kept in variables so bash does not re-parse the quoting.
re_heredoc_start='(^|[^<])<<(-?)[[:space:]]*(["'"'"'\\]?)([A-Za-z_][A-Za-z0-9_.-]*)'
re_spin='(^|[^[:alnum:]_])read[[:space:]][^;|&]*-[[:alpha:]]*t[^;|&]*<[[:space:]]*/dev/zero'
re_spin_b='/dev/zero[^;|&]*(^|[^[:alnum:]_])read[[:space:]][^;|&]*-[[:alpha:]]*t'
re_dquote_backticks='--(body|evidence|symptom|title|summary|verified-by|fixed-by|reason|message|note)[= ]"[^"]*`'
re_jq_word='(^|[^[:alnum:]_-])jq([[:space:]]|$)'
re_jq_optional_call='\)\?\.[[:alpha:]_\["]'
# Any \"...\" pair in a jq program means the program was built double-quoted
# at the shell level (a plain single-quoted program never needs to escape a
# quote). That double-quoting is what a JS-tool-call transport layer can
# strip, whether the escaped literal sits inside \( ) interpolation or a
# plain string like (.severity // \"-\").
re_jq_escaped_quote='\\"[^"\\]*\\"'
re_awk_word='(^|[^[:alnum:]_-])awk([[:space:]]|$)'
re_awk_match='match\([^,()]*,[[:space:]]*/([^/]|\\/)*/[[:space:]]*,[[:space:]]*[[:alpha:]_]'
q="'"
re_sed_inplace='(^|[^[:alnum:]_-])sed[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*-i[[:space:]]+([^'"$q"'"[:space:]-]|'"$q"'[^'"$q"']|"[^"]|-e[[:space:]]|-E[[:space:]])'
re_printf_dash='(^|[;&|({[:space:]])printf[[:space:]]+["'"'"']-'
# /bin/<tool> names below; the temp-file tool is listed as mk[t]emp (same match). XXXXXX
# A template whose X run is followed by another TEMPLATE character never
# substitutes on
# BSD mktemp, so the literal name lands on disk and poisons every later call with
# the same template. Scoped to mktemp's own argument token: the leading class
# cannot cross a space or a quote, so an unrelated XXX elsewhere on the line
# cannot match, and the trailing class excludes shell punctuation so an unquoted
# template that ENDS in X's inside $( ) is not a false positive.
re_mktemp_suffix='(^|[^[:alnum:]_-])mktemp([[:space:]]+-[^[:space:]]+)*[[:space:]]+["'"'"']?[^[:space:]"'"'"'`]*XXX+[^[:space:]"'"'"'`(){}|&;<>X]'  # mktemp-ok: this is the recogniser for an mktemp call, not a call
re_bin_path='(^|[^[:alnum:]_./-])/bin/(mk[t]emp|sed|grep|egrep|awk|find|xargs|sort|uniq|head|tail|wc|tr|cut|jq|env|dirname|basename|timeout|readlink|stat)([^[:alnum:]_-]|$)'
re_date_nanos='(^|[^[:alnum:]_-])date[[:space:]][^;|&]*%[0-9]*N'
# stat-local-zulu: a `stat` call whose -t format ends in a literal Z. The
# char before that final Z must not be `%`, because `%Z` is a real strftime
# conversion (it prints the zone NAME, honestly) and is not this defect. The
# two quote styles are spelled as an alternation because POSIX ERE has no
# backreferences. TZ=UTC anywhere on the line makes the value correct, so it
# is excluded rather than refused.
re_stat_word='(^|[^[:alnum:]_-])stat([[:space:]]|$)'
re_stat_zulu_fmt="-t[[:space:]]+('[^']*[^%']Z'|\"[^\"]*[^%\"]Z\")"
re_tz_utc='(^|[^[:alnum:]_-])TZ=(UTC|utc|Etc/UTC)([[:space:]]|$)'
re_zsh_status='(^|;|&&|[|][|]|[({]|(^|[^[:alnum:]_])(do|then|else|export|local|typeset|declare))[[:space:]]*status=|(^|[^[:alnum:]_])read[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*([[:alpha:]_][[:alnum:]_]*[[:space:]]+)*status([[:space:]]|;|$)|(^|[^[:alnum:]_])(local|typeset|declare|integer)[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*status([=[:space:]]|$)|(^|[^[:alnum:]_$])for[[:space:]]+status[[:space:]]+in([[:space:]]|$)'
re_zsh_mapfile='(^|[;&|({[:space:]])(mapfile|readarray)[[:space:]]'
# Matches `for x in $VAR` / `for x in ${VAR}`, an unquoted bare scalar
# expansion immediately ending the for-list (whitespace, ;, or end of line).
# Does NOT match "${ARR[@]}" (a [ follows the name, so the required
# terminator right after the optional trailing brace never appears),
# $(...)/`...` command substitution (the char after $ is not a letter/_/{),
# or a quoted "$VAR" (the " before $ breaks the immediately-preceding `in `).
re_zsh_word_split='(^|[^[:alnum:]_])for[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]+in[[:space:]]+\$\{?[A-Za-z_][A-Za-z0-9_]*\}?([[:space:]]|;|$)'
# zsh-cond-flag-expansion: ${name:+--flag "$val"} or ${name:-...}, where the
# conditional's word composes a flag token (one or two leading dashes) and a
# double-quoted variable. zsh has no SH_WORD_SPLIT, so when this expansion is
# used unquoted as command arguments, the whole substitution stays ONE word
# even though the nested quotes look like they mark two tokens -- bash DOES
# split it into two (measured empirically: both shells honor the nested
# quotes; only bash then word-splits the unquoted result). A single short
# flag with no trailing quoted value (${v:+-x}) is one word in both shells
# and is not this hazard, so the trailing quoted-variable requirement is
# what scopes the match to the composed-flag shape.
# Brain: papercut-zsh-conditional-flag-expansion-silently-mangles-brain-close-fixedby-20261008
re_zsh_cond_flag_expansion='\$\{[A-Za-z_][A-Za-z0-9_]*:[+-][[:space:]]*--?[A-Za-z][A-Za-z0-9_-]*[[:space:]]+"\$\{?[A-Za-z_][A-Za-z0-9_]*\}?[^}]*"'

# home-root-scan: normalize $HOME / ${HOME} / ~ to the real home path (as
# text, not by expanding anything) so a scanner pointed at any written form
# of the home root matches one regex. Mirrors hooks/no-home-root-scan.sh.
home="${HOME:-}"
normalize_home_line() {
  local line="$1"
  [ -n "$home" ] || { printf '%s' "$line"; return; }
  printf '%s' "$line" | sed \
    -e "s#\${HOME}#$home#g" -e "s#\$HOME#$home#g" -e "s#~/#$home/#g" \
    -e "s#\([[:space:]]\)~\([[:space:]]\)#\1$home\2#g" \
    -e "s#\([[:space:]]\)~\$#\1$home#" \
    -e "s#^~\([[:space:]/]\)#$home\1#" -e "s#^~\$#$home#"
}
re_home_scanner_words='(find|fd|du|ncdu|tree|rg|ag|grep|ls|wc|shasum)'
# A command starts at line-start, after a separator (;&|(), after && / ||,
# or right after a shell keyword (do/then/else/elif) that always begins a
# new command wherever it sits on the line -- `while ...; do find "$HOME"
# ...; done` and `if ...; then du -sh "$HOME"; fi` are the idioms routine
# agents write constantly (measured: both slipped through an earlier draft
# anchored only on ;&|( / && / ||).
re_home_anchor='(^|[;&|(]|&& |\| |(^|[^[:alnum:]_])(do|then|else|elif)[[:space:]])'
# The home token's quotes must BALANCE. An optional quote on each side
# (`[\"']?${home}[\"']?`) also accepts an UNBALANCED opening quote, so a
# quoted REGEX PATTERN that merely contains the home path read as a path
# argument: `grep -nE '$HOME|needle' a.sh b.sh` matched, because
# normalize_home_line rewrites $HOME inside the quotes and the alternation
# `|` that follows satisfies the trailing [;&|)] as if it were a shell pipe.
# No walk: the files are named. Measured three times in one agent pass.
# Brain: papercut-home-root-scan-matcher-assumes-scanner-flags-path-so-it-rejects-a-quoted-pattern-and-misses-grep-r-home-20261004
re_home_token="(\"${home}\"|'${home}'|${home})"

# `find <path> <expr>` puts the path BEFORE its flags (the common, natural
# form); du/ls/rg/grep put flags before the path. Allow optional flags on
# EITHER side of the (optionally quoted) home token so both orders match.
re_home_root_scan="${re_home_anchor}[[:space:]]*(sudo[[:space:]]+)?(time[[:space:]]+)?${re_home_scanner_words}([[:space:]]+-[^[:space:]]+)*[[:space:]]+${re_home_token}([[:space:]]+-[^[:space:]]+)*([[:space:]]|[;&|)]|/\\*|\$)"
# grep/rg/ag take their pattern POSITIONALLY, so the natural spelling of the
# hazard puts a non-flag token between the scanner and the path, and the
# flags-only regex above never saw it: `grep -rn needle "$HOME"` and
# `rg -n needle "$HOME"` both PASSED while `find "$HOME" -name x` was
# rejected. That is the costlier direction -- a recursive grep of $HOME is
# precisely what raises the macOS TCC prompt and blocks an unattended run,
# and these two scanners are the ones agents reach for.
#
# Exactly ONE non-flag token is allowed, quoted or bare. Only the
# pattern-taking scanners get this: find/du/ls/wc put the path where the
# regex above already expects it, and widening them would let a path
# argument that merely PRECEDES the home token satisfy the pattern slot.
re_home_pattern_scanners='(rg|ag|grep|egrep|fgrep)'
re_home_pattern_arg="(\"[^\"]*\"|'[^']*'|[^-[:space:]][^[:space:]]*)"
re_home_root_scan_pattern="${re_home_anchor}[[:space:]]*(sudo[[:space:]]+)?(time[[:space:]]+)?${re_home_pattern_scanners}([[:space:]]+-[^[:space:]]+)*[[:space:]]+${re_home_pattern_arg}[[:space:]]+${re_home_token}([[:space:]]+-[^[:space:]]+)*([[:space:]]|[;&|)]|/\*|$)"

re_home_protected="${home}/(Desktop|Documents|Downloads|Pictures|Movies|Music)"
# piped-count-false-zero: a $HOME-path producer feeding a counting filter.
# Runs on the home-NORMALIZED line, so ~/x, $HOME/x, ${HOME}/x and the literal
# path are one regex (same helper home-root-scan uses).
#
# The producer is either the path itself (`~/.local/bin/x --flag | grep -c y`)
# or the path as an executor's argument (`bash ~/.local/bin/x | grep -c y`,
# `strings ~/.host-track/apps/a/canary/dist/b | grep -c y`). The executor list
# is deliberately only INTERPRETERS AND BINARY READERS: `cat`/`head`/`tail` of a
# data file is a different hazard (read the rc -- items 110/164) and is common
# and legitimate, so it is not refused here.
#
# `[^|]*` between the path and the pipe keeps the path's command as the
# IMMEDIATE producer of the counted stream, so the match cannot span an
# intervening stage. `jq . f | bash ~/x | grep -c y` DOES match (anchored at the
# first pipe, `bash ~/x` is the producer feeding the count), and
# `jq . f | cat ~/g | grep -c y` does not, because at every anchor the next
# token is either a PATH command (`jq`, `grep`) or a non-executor (`cat`).
re_piped_count_exec='(bash|sh|zsh|strings|python3|python|perl|ruby|node|bun)[[:space:]]+'
re_piped_count_sink='(grep[[:space:]]+(-[[:alnum:]]*[cq][[:alnum:]]*|--count|--quiet|--silent)|wc[[:space:]]+-l)'
re_piped_count="${re_home_anchor}[[:space:]]*(${re_piped_count_exec})?[\"']?${home}/[^|]*\|[[:space:]]*${re_piped_count_sink}"

# grep-binary-false-zero: grep's own COUNT/QUIET flag and a binary-tree path
# argument must belong to the SAME grep invocation, so the path scan is
# bounded by `[^;|&]*` -- it cannot cross a `;`, `|` or `&` into an earlier or
# later command on the line. That bound is what keeps
# `p=$(readlink -f ~/.host-track/apps/x/current/bin/x); grep -c sym "$p"` safe
# (the literal "current" text sits before the `;`, outside the bound) while
# still catching `grep -c sym ~/.host-track/apps/x/current/bin/x` on one line.
# It is also what makes the prescribed-safe `strings <path> | grep -c sym`
# form safe without a separate exclusion: the path text is on the OTHER side
# of the `|`, so it is never inside grep's own bounded argument span.
#
# Binary-tree path shapes (named in the papercut this rule ships):
#   .../dist/<name>        -- a bun-compiled single-file executable's own
#                              output path, with no dot in <name> (a real
#                              extension like dist/foo.json is excluded: the
#                              required trailing boundary cannot follow a '.')
#   host-track/apps/*/(current|canary)/...  -- the two live app-binary trees
#   .../artifacts/current/...               -- last-stack's own artifact tree
re_grep_binary_path='(/dist/[A-Za-z0-9_-]+([[:space:]"'"'"']|$)|host-track/apps/[^[:space:]/]+/(current|canary)/|artifacts/current/)'
re_grep_count_binary="(^|[^[:alnum:]_-])grep[[:space:]]+(-[[:alnum:]]*[cq][[:alnum:]]*|--count|--quiet|--silent)[[:space:]]+[^;|&]*${re_grep_binary_path}"
# -a (or --text / --binary-files=text) tells grep to treat the file as text,
# which is correct and must not be refused. Checked anywhere on the line, the
# same precedent as re_tz_utc above: a flag that fixes the whole class is not
# worth re-deriving which specific grep invocation it was attached to.
re_grep_binary_safe='(^|[^[:alnum:]_-])grep[[:space:]]+-[[:alnum:]]*a[[:alnum:]]*([[:space:]]|$)|--text([[:space:]]|$)|--binary-files[=[:space:]]+text'

# Data arguments. Every code rule below matches the line TEXT, so prose inside a
# quoted --body / --evidence / --verified-by read as code and was refused: an
# agent that files or closes a papercut quotes the very pattern it reports
# (measured 2026-10-08, stat-local-zulu refused a --verified-by sentence).
# blank_data_args prints the command with the interior of each such argument
# replaced by spaces (newlines kept, so line N is still line N). The code rules
# then read that text. dquote-backticks and heredoc-backticks read the ORIGINAL.
# Brain: papercut-shell-lint-stat-local-zulu-matches-whole-line-prose-not-shell-code-20261008
#
# What counts as data, and what does not:
#   * Only a quoted string that DIRECTLY follows a data flag (--body --evidence
#     --symptom --title --summary --verified-by --fixed-by --reason --message
#     --note --description, after a space or =) or `git commit -m`. A bare -m
#     is not a data flag: `du -m "$HOME"` is a megabyte scan, not a message.
#   * A single-quoted string is pure data. A double-quoted string is data only
#     when its interior holds no $( , no backtick and no ${ : those three RUN
#     inside double quotes, so such a string stays visible to every rule.
#   * The lexer follows quotes, $( ), ${ }, backticks, comments, \ escapes, $'..'
#     and heredoc bodies, so an apostrophe in a comment or a heredoc cannot open
#     a string that swallows later code. Any construct it cannot close (an
#     unterminated string or heredoc) cancels ALL blanking: the text is then
#     scanned whole, as before. awk failing does the same (see below).
# POSIX ERE and awk only: macOS ships bash 3.2 and BSD awk 20200816.
blank_data_args() {
  awk '
  function push(kind, cl) { sp++; sk[sp] = kind; sc[sp] = cl; sd[sp] = 0 }
  function isdata(at,    from, pre) {
    from = at - 240; if (from < 1) from = 1
    pre = substr(s, from, at - from)
    return match(pre, DATA_RE) || match(pre, GIT_RE)
  }
  function rec(a, b, dq,    t) {
    if (b < a) return
    t = substr(s, a, b - a + 1)
    if (dq && (index(t, "$(") || index(t, BT) || index(t, "${"))) return
    nr++; ra[nr] = a; rb[nr] = b
  }
  BEGIN {
    SQ = "\047"; DQ = "\042"; BT = "\140"; NL = "\n"
    DATA_RE = "(^|[ \t\n;&|(])--(body|evidence|symptom|title|summary|verified-by|fixed-by|reason|message|note|description)(=|[ \t]+)$"
    GIT_RE = "(^|[ \t\n;&|(])git[ \t]+([^;&|\n]*[ \t])?commit[ \t]+([^;&|\n]*[ \t])?-[A-Za-z]*m[ \t]+$"
    while ((getline ln) > 0) s = s ln NL
    n = length(s); ok = 1; i = 1; sp = 0; push("C", "")
    while (ok && i <= n) {
      c = substr(s, i, 1); d = substr(s, i + 1, 1)
      if (sk[sp] == "D") {
        if (c == "\\") i += 2
        else if (c == DQ) { if (sd[sp] > 0) rec(sd[sp] + 1, i - 1, 1); sp--; i++ }
        else if (c == "$" && d == "(") { push("C", ")"); i += 2 }
        else if (c == "$" && d == "{") { push("C", "}"); i += 2 }
        else if (c == BT) { push("C", BT); i++ }
        else i++
        continue
      }
      if (c == "\\") { i += 2; continue }
      if (c == SQ) {
        j = index(substr(s, i + 1), SQ)
        if (j == 0) { ok = 0; break }
        if (isdata(i)) rec(i + 1, i + j - 1, 0)
        i += j + 1; continue
      }
      if (c == DQ) { push("D", ""); if (isdata(i)) sd[sp] = i; i++; continue }
      if (c == "$") {
        if (d == "(") { push("C", ")"); i += 2; continue }
        if (d == "{") { push("C", "}"); i += 2; continue }
        if (d == SQ) {
          j = i + 2
          while (j <= n && substr(s, j, 1) != SQ) { if (substr(s, j, 1) == "\\") j++; j++ }
          if (j > n) { ok = 0; break }
          i = j + 1; continue
        }
        i++; continue
      }
      if (c == BT) { if (sc[sp] == BT) sp--; else push("C", BT); i++; continue }
      if (c == "(") { push("C", ")"); i++; continue }
      if (c == ")") { if (sc[sp] == ")") sp--; i++; continue }
      if (c == "}") { if (sc[sp] == "}") sp--; i++; continue }
      if (c == "#" && sc[sp] != "}") {
        p = (i == 1) ? NL : substr(s, i - 1, 1)
        if (p == " " || p == "\t" || p == NL || p == ";" || p == "&" || p == "|" || p == "(") {
          j = index(substr(s, i), NL)
          if (j == 0) i = n + 1; else i += j - 1
          continue
        }
      }
      if (c == "<" && d == "<") {
        if (substr(s, i + 2, 1) == "<") { i += 3; continue }
        j = i + 2; strip = 0
        if (substr(s, j, 1) == "-") { strip = 1; j++ }
        while (substr(s, j, 1) == " " || substr(s, j, 1) == "\t") j++
        q = substr(s, j, 1)
        if (q == DQ || q == SQ || q == "\\") j++
        if (match(substr(s, j, 256), "^[A-Za-z_][A-Za-z0-9_.-]*")) {
          npend++; pd[npend] = substr(s, j, RLENGTH); ps[npend] = strip
          i = j + RLENGTH
          if ((q == DQ || q == SQ) && substr(s, i, 1) == q) i++
          continue
        }
        i += 2; continue
      }
      if (c == NL) {
        i++
        for (h = 1; h <= npend && ok; h++) {
          found = 0
          while (i <= n) {
            j = index(substr(s, i), NL)
            if (j == 0) { hl = substr(s, i); i = n + 1 } else { hl = substr(s, i, j - 1); i += j }
            if (ps[h]) sub(/^\t+/, "", hl)
            if (hl == pd[h]) { found = 1; break }
          }
          if (!found) ok = 0
        }
        npend = 0
        continue
      }
      i++
    }
    if (!ok || sp != 1) nr = 0
    out = ""; pos = 1
    for (r = 1; r <= nr; r++) {
      seg = substr(s, ra[r], rb[r] - ra[r] + 1); gsub(/[^\n]/, " ", seg)
      out = out substr(s, pos, ra[r] - pos) seg
      pos = rb[r] + 1
    }
    printf "%s", out substr(s, pos)
  }'
}

# check_command_line <line> <blanked line>: the code rules read the blanked
# text, dquote-backticks the original; a rejection prints the original.
check_command_line() {
  local line="$1" bline="$2"
  if [[ $bline =~ $re_spin ]] || [[ $bline =~ $re_spin_b ]]; then
    reject spin-wait "$line"
  fi
  if [[ $line =~ $re_dquote_backticks ]]; then
    reject dquote-backticks "$line"
  fi
  if [[ $bline =~ $re_jq_word ]]; then
    if [[ $bline =~ $re_jq_optional_call ]]; then
      reject jq-optional-call "$line"
    fi
    if [[ $bline =~ $re_jq_escaped_quote ]]; then
      reject jq-escaped-quote "$line"
    fi
  fi
  if [[ $bline =~ $re_awk_word ]] && [[ $bline =~ $re_awk_match ]]; then
    reject awk-match-array "$line"
  fi
  if [[ $bline =~ $re_sed_inplace ]]; then
    reject sed-inplace "$line"
  fi
  if [[ $bline =~ $re_date_nanos ]]; then
    reject date-nanos "$line"
  fi
  if [[ $bline =~ $re_stat_word ]] && [[ $bline =~ $re_stat_zulu_fmt ]] \
     && ! [[ $bline =~ $re_tz_utc ]]; then
    reject stat-local-zulu "$line"
  fi
  if [[ $bline =~ $re_printf_dash ]]; then
    reject printf-dash "$line"
  fi
  if [[ $bline =~ $re_bin_path ]]; then
    reject bin-path "$line"
  fi
  if [[ $bline =~ $re_mktemp_suffix ]]; then
    reject mktemp-suffix "$line"
  fi
  if [[ $bline =~ $re_grep_count_binary ]] && ! [[ $bline =~ $re_grep_binary_safe ]]; then
    reject grep-binary-false-zero "$line"
  fi
  if [ "$shell_kind" = zsh ]; then
    if [[ $bline =~ $re_zsh_status ]]; then
      reject zsh-status "$line"
    fi
    if [[ $bline =~ $re_zsh_mapfile ]]; then
      reject zsh-mapfile "$line"
    fi
    if [[ $bline =~ $re_zsh_word_split ]]; then
      reject zsh-word-split "$line"
    fi
    if [[ $bline =~ $re_zsh_cond_flag_expansion ]]; then
      reject zsh-cond-flag-expansion "$line"
    fi
  fi
  if [ -n "$home" ]; then
    local hline
    hline="$(normalize_home_line "$bline")"
    # home-root-scan honors its own older escape phrase; piped-count-false-zero
    # does NOT -- it is a different defect, so it takes only the generic
    # "shell-lint-ok:" hatch that `reject` already enforces for every rule.
    if [ "$home_scan_escaped" -eq 0 ]; then
      if [[ $hline =~ $re_home_root_scan ]] \
        || [[ $hline =~ $re_home_root_scan_pattern ]] \
        || [[ $hline =~ $re_home_protected ]]; then
        reject home-root-scan "$line"
      fi
    fi
    if [[ $hline =~ $re_piped_count ]]; then
      reject piped-count-false-zero "$line"
    fi
  fi
}

# Queue of pending heredocs opened on the current command line.
# Each entry: "<strip-tabs 0|1>:<quoted 0|1>:<delimiter>".
pending=()
in_body=0
body_strip=0
body_quoted=0
body_delim=""
body_start_line=""

queue_heredocs() {
  local rest="$1" strip quoted delim
  while [[ $rest =~ $re_heredoc_start ]]; do
    strip=0; [ "${BASH_REMATCH[2]}" = "-" ] && strip=1
    quoted=0; [ -n "${BASH_REMATCH[3]}" ] && quoted=1
    delim="${BASH_REMATCH[4]}"
    pending+=("$strip:$quoted:$delim")
    rest="${rest#*"${BASH_REMATCH[0]}"}"
  done
}

open_next_body() {
  local entry="${pending[0]}"
  pending=("${pending[@]:1}")
  body_strip="${entry%%:*}"
  entry="${entry#*:}"
  body_quoted="${entry%%:*}"
  body_delim="${entry#*:}"
  in_body=1
}

# Blank the data arguments once, then walk the original and the blanked text in
# step (same line count). A missing blanked line, or awk failing, falls back to
# the original text: the lint then reads the whole command, as it always did.
blanked_text="$(printf '%s\n' "$command_text" | blank_data_args)" || blanked_text="$command_text"
blank_lines=()
while IFS= read -r bl || [ -n "$bl" ]; do
  blank_lines+=("$bl")
done <<< "$blanked_text"
lineno=0

while IFS= read -r line || [ -n "$line" ]; do
  bline="${blank_lines[$lineno]-$line}"
  lineno=$((lineno + 1))
  if [ "$in_body" -eq 1 ]; then
    probe="$line"
    if [ "$body_strip" = 1 ]; then
      probe="${probe#"${probe%%[!$'\t']*}"}"
    fi
    if [ "$probe" = "$body_delim" ]; then
      in_body=0
      if [ "${#pending[@]}" -gt 0 ]; then
        open_next_body
      fi
      continue
    fi
    if [ "$body_quoted" = 0 ]; then
      case "$line" in
        *'`'*) reject heredoc-backticks "$body_start_line" ;;
      esac
    fi
    continue
  fi
  check_command_line "$line" "$bline"
  queue_heredocs "$bline"
  if [ "${#pending[@]}" -gt 0 ]; then
    body_start_line="$line"
    open_next_body
  fi
done <<< "$command_text"

exit 0
