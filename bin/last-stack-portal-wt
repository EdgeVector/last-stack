#!/usr/bin/env bash
# last-stack-portal-wt — worktree entrypoint for EdgeVector *portals*
# (thin dirs under ~/code/edgevector/<slug> that are NOT product checkouts).
#
# Usage (from a portal, or with --portal):
#   last-stack-portal-wt start <branch-or-slug>   # fetch venue tip + worktree
#   last-stack-portal-wt list
#   last-stack-portal-wt path
#   last-stack-portal-wt rm <branch-or-slug-or-dir>  # same ids as start
#   last-stack-portal-wt fetch
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -h "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
self_root="$(cd -P "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/forge-token.sh
. "$self_root/lib/forge-token.sh"

GIT="${GIT:-/usr/bin/git}"
CACHE_ROOT="${EDGEVECTOR_GIT_CACHE:-$HOME/.cache/edgevector-git}"
WT_ROOT="${WORKTREES_DIR:-$HOME/.fkanban/worktrees}"
# Set by detach_idle_main_worktrees when it refuses a dirty pin on <main>.
DIRTY_MAIN_PIN=""

die() { printf 'portal-wt: %s\n' "$*" >&2; exit 1; }

# Normalize a start/rm identifier to (branch, dir-basename).
# Accepts: kanban/foo | foo | SLUG-kanban-foo | absolute/relative path.
# Branch rule matches cmd_start: bare slug → kanban/<slug>.
worktree_ids_from_spec() {
  local spec="$1"
  local branch name
  case "$spec" in
    /*|./*|../*)
      # Absolute / relative path form — basename only for branch guess.
      name="$(basename "$spec")"
      branch=""
      ;;
    *)
      branch="$spec"
      case "$branch" in
        */*) ;;
        *)
          # If it already looks like a portal-prefixed dir (slug-kanban-…),
          # do not re-prefix with kanban/.
          case "$branch" in
            "${SLUG}-"*) branch="" ;;
            *) branch="kanban/$branch" ;;
          esac
          ;;
      esac
      if [ -n "$branch" ]; then
        name="$(printf '%s' "$branch" | tr '/' '-')"
        name="${SLUG}-${name}"
      else
        name="$spec"
      fi
      ;;
  esac
  printf '%s\t%s\n' "${branch:-}" "$name"
}

find_portal() {
  local d="${PORTAL_DIR:-}"
  if [ -n "$d" ] && [ -f "$d/.portal/remote" ]; then
    printf '%s\n' "$(cd "$d" && pwd -P)"
    return
  fi
  d="$(pwd -P)"
  while [ "$d" != "/" ]; do
    if [ -f "$d/.portal/remote" ]; then
      printf '%s\n' "$d"
      return
    fi
    d="$(dirname "$d")"
  done
  return 1
}

read_portal() {
  PORTAL="$(find_portal)" || die "not inside a portal (no .portal/remote); pass --portal <dir>"
  SLUG="$(tr -d '[:space:]' <"$PORTAL/.portal/slug" 2>/dev/null || basename "$PORTAL")"
  REMOTE="$(tr -d '[:space:]' <"$PORTAL/.portal/remote")"
  VENUE="$(tr -d '[:space:]' <"$PORTAL/.portal/venue" 2>/dev/null || echo lastgit)"
  CACHE="$(tr -d '[:space:]' <"$PORTAL/.portal/cache" 2>/dev/null || true)"
  [ -n "$CACHE" ] || CACHE="$CACHE_ROOT/${SLUG}.git"
  MAIN_REF="${PORTAL_MAIN_REF:-main}"
  export_forge_git_auth
}

# A portal whose venue is the local Forgejo cannot fall back on git's
# osxkeychain credential helper: when the login keychain is locked, that helper
# fails with -25293 and git then asks for a username on a terminal an
# unattended agent does not have ("could not read Username ... Device not
# configured"). Resolve the token ourselves and hand it to every child git
# through GIT_CONFIG_*, which needs no change at the ~30 `$GIT` call sites and
# reaches `clone` before any repo config exists.
# Papercut: papercut-forge-helpers-keychain-lockout-blocks-unattended-push
export_forge_git_auth() {
  case "$REMOTE" in
    http://localhost:3300/*|http://127.0.0.1:3300/*) ;;
    *) return 0 ;;
  esac
  local token
  token="$(last_stack_forge_token || true)"
  [ -n "$token" ] || return 0
  export GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0="http.http://localhost:3300/.extraHeader"
  export GIT_CONFIG_VALUE_0="Authorization: token $token"
  export GIT_CONFIG_KEY_1="http.http://127.0.0.1:3300/.extraHeader"
  export GIT_CONFIG_VALUE_1="Authorization: token $token"
}

# Return success when a process appears to be using a worktree. This check is
# intentionally conservative: detaching an idle clean tree is harmless, but a
# false "idle" result could surprise an active investigation.
worktree_has_live_process() {
  local path="$1"
  if command -v lsof >/dev/null 2>&1; then
    if lsof -nP +D "$path" 2>/dev/null | awk 'NR > 1 { found = 1; exit } END { exit !found }'; then
      return 0
    fi
  fi
  if command -v pgrep >/dev/null 2>&1 && pgrep -f "$path" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

# A linked worktree may live anywhere on disk, not only under WT_ROOT. Git
# refuses to update refs/heads/main while any registered worktree has that
# branch checked out, which turns one abandoned /tmp tree into a fleet-wide
# portal outage. Enumerate the bare mirror's authoritative worktree registry
# and detach only pins that are both clean and unused.
detach_idle_main_worktrees() {
  local path="" line git_status
  DIRTY_MAIN_PIN=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      "branch refs/heads/${MAIN_REF}")
        [ -n "$path" ] || continue
        if ! git_status="$($GIT -C "$path" status --short 2>/dev/null)"; then
          printf 'portal-wt: cannot inspect worktree pinning %s: %s\n' \
            "$MAIN_REF" "$path" >&2
          continue
        fi
        if [ -n "$git_status" ]; then
          printf 'portal-wt: refusing to detach dirty worktree pinning %s: %s\n' \
            "$MAIN_REF" "$path" >&2
          DIRTY_MAIN_PIN="$path"
          continue
        fi
        if worktree_has_live_process "$path"; then
          printf 'portal-wt: refusing to detach in-use worktree pinning %s: %s\n' \
            "$MAIN_REF" "$path" >&2
          continue
        fi
        if $GIT -C "$path" checkout --detach --quiet; then
          printf 'portal-wt: auto-detached clean idle worktree pinning %s: %s\n' \
            "$MAIN_REF" "$path" >&2
        else
          printf 'portal-wt: failed to detach worktree pinning %s: %s\n' \
            "$MAIN_REF" "$path" >&2
        fi
        ;;
    esac
  done <<EOF
$($GIT -C "$CACHE" worktree list --porcelain 2>/dev/null || true)
EOF
}

# A portal mirror must map remote branches into refs/remotes/origin/*, never
# into refs/heads/*. Both of the shapes this fleet accumulated are silent
# stale-ref generators that still exit 0:
#
#   +refs/heads/*:refs/heads/*  — a plain `git fetch origin` targets every
#     worktree-owned branch, so git refuses the WHOLE fetch ("refusing to fetch
#     into branch <x> checked out at <path>") whenever any sibling worktree has
#     one checked out, and refs/heads/main is left at its previous value.
#   (unset)                     — `git fetch origin` writes FETCH_HEAD only, so
#     refs/remotes/origin/main never moves after clone time and every later
#     `git merge-base --is-ancestor <oid> origin/main` answers from a ref that
#     can be days old.
#
# Normalize on every call, not only at clone time, so mirrors provisioned
# before this rule heal on the next start/fetch.
MIRROR_FETCH_REFSPEC='+refs/heads/*:refs/remotes/origin/*'

normalize_mirror_refspec() {
  local current
  # `config --get-all` exits 1 when the key is unset — which is exactly the
  # unset-refspec mirror this heals — so swallow it under `set -e -o pipefail`.
  current="$($GIT -C "$CACHE" config --get-all remote.origin.fetch 2>/dev/null \
    | tr '\n' ' ' | sed 's/ *$//' || true)"
  [ "$current" != "$MIRROR_FETCH_REFSPEC" ] || return 0
  $GIT -C "$CACHE" config --replace-all remote.origin.fetch \
    "$MIRROR_FETCH_REFSPEC" 2>/dev/null || return 0
  printf 'portal-wt: healed mirror refspec [%s] -> [%s]\n' \
    "${current:-unset}" "$MIRROR_FETCH_REFSPEC" >&2
}

ensure_cache() {
  mkdir -p "$(dirname "$CACHE")"
  if [ ! -d "$CACHE" ]; then
    printf 'portal-wt: cloning bare cache %s ← %s\n' "$CACHE" "$REMOTE" >&2
    $GIT clone --bare --quiet "$REMOTE" "$CACHE"
  fi
  normalize_mirror_refspec
  # Always refresh main tip before starting work. Update the documented mirror
  # read path (refs/heads/<main>) AND the remote-tracking ref in one call: the
  # first can be pinned by a worktree, the second never can, so a reader that
  # trusts either one is answered from this fetch. Never fall back to a bare
  # ref name — that form updates FETCH_HEAD alone and is the stale-ref bug.
  printf 'portal-wt: fetch %s (%s)\n' "$REMOTE" "$MAIN_REF" >&2
  detach_idle_main_worktrees
  $GIT -C "$CACHE" fetch --prune --quiet origin \
    "+refs/heads/${MAIN_REF}:refs/heads/${MAIN_REF}" \
    "+refs/heads/${MAIN_REF}:refs/remotes/origin/${MAIN_REF}" 2>/dev/null \
    || $GIT -C "$CACHE" fetch --prune --quiet origin \
         "+refs/heads/${MAIN_REF}:refs/remotes/origin/${MAIN_REF}" 2>/dev/null \
    || $GIT -C "$CACHE" fetch --prune --quiet "$REMOTE" \
         "+refs/heads/${MAIN_REF}:refs/heads/${MAIN_REF}" \
         "+refs/heads/${MAIN_REF}:refs/remotes/origin/${MAIN_REF}"
  $GIT -C "$CACHE" rev-parse --verify -q "refs/heads/${MAIN_REF}" >/dev/null \
    || $GIT -C "$CACHE" rev-parse --verify -q "refs/remotes/origin/${MAIN_REF}" >/dev/null \
    || die "no ${MAIN_REF} after fetch from $REMOTE"
  warn_pinned_main
  # A dirty worktree pinning <main> stays fail-closed. The remote-tracking ref
  # above is now current either way, so a caller that catches this can still
  # read the true tip, but portal-wt never starts work behind an unresolved pin.
  [ -z "${DIRTY_MAIN_PIN:-}" ] \
    || die "dirty worktree pins ${MAIN_REF}: ${DIRTY_MAIN_PIN}"
}

# refs/heads/<main> lags whenever a worktree pins it and the branch fetch was
# refused. Say so with both oids: a caller that reads the mirror ref must not
# mistake "the fetch succeeded" for "this ref is the remote tip".
warn_pinned_main() {
  local local_tip remote_tip
  local_tip="$($GIT -C "$CACHE" rev-parse -q --verify "refs/heads/${MAIN_REF}" 2>/dev/null || true)"
  remote_tip="$($GIT -C "$CACHE" rev-parse -q --verify "refs/remotes/origin/${MAIN_REF}" 2>/dev/null || true)"
  [ -n "$local_tip" ] && [ -n "$remote_tip" ] || return 0
  [ "$local_tip" != "$remote_tip" ] || return 0
  printf 'portal-wt: WARNING refs/heads/%s is stale (%s) vs origin/%s (%s); reading the mirror branch ref will answer from the stale tip\n' \
    "$MAIN_REF" "$local_tip" "$MAIN_REF" "$remote_tip" >&2
}

# Base a new worktree on the remote-tracking ref when it exists: it is the one
# ref no local worktree can pin, so a stray worktree holding main can no longer
# start fresh work from a stale base.
start_base_ref() {
  if $GIT -C "$CACHE" rev-parse -q --verify "refs/remotes/origin/${MAIN_REF}" >/dev/null 2>&1; then
    printf 'refs/remotes/origin/%s\n' "$MAIN_REF"
  else
    printf 'refs/heads/%s\n' "$MAIN_REF"
  fi
}

cmd_fetch() {
  read_portal
  ensure_cache
  tip="$($GIT -C "$CACHE" rev-parse --short "refs/heads/${MAIN_REF}")"
  printf 'portal-wt: %s %s @ %s\n' "$SLUG" "$MAIN_REF" "$tip"
}

cmd_path() {
  read_portal
  printf 'portal=%s\nslug=%s\nremote=%s\nvenue=%s\ncache=%s\nworktrees=%s\n' \
    "$PORTAL" "$SLUG" "$REMOTE" "$VENUE" "$CACHE" "$WT_ROOT"
}

cmd_list() {
  read_portal
  if [ -d "$CACHE" ]; then
    $GIT -C "$CACHE" worktree list
  else
    printf 'portal-wt: no cache yet at %s (run: wt start …)\n' "$CACHE" >&2
  fi
}

# Resolve an rm/start identifier to an existing worktree path, or empty.
# Tries (in order): absolute/relative path, WT_ROOT/<arg>, portal-prefixed
# basename derived from the same branch rules as start, bare basename.
resolve_worktree_path() {
  local spec="$1"
  local branch name candidate
  local ids
  ids="$(worktree_ids_from_spec "$spec")"
  branch="${ids%%	*}"
  name="${ids#*	}"

  # 1) literal path (absolute or relative)
  if [ -e "$spec" ]; then
    printf '%s\n' "$(cd "$spec" 2>/dev/null && pwd -P || printf '%s' "$spec")"
    return 0
  fi
  # 2) WT_ROOT + exact arg (dir-basename form agents already know)
  candidate="$WT_ROOT/$spec"
  if [ -e "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  # 3) portal-prefixed name derived from branch/slug (same as start)
  if [ -n "$name" ]; then
    candidate="$WT_ROOT/$name"
    if [ -e "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  return 1
}

# Near-match suggestions when rm cannot resolve. Never claim "already gone"
# while a same-portal worktree still exists under another name.
suggest_worktree_near_miss() {
  local spec="$1"
  local needle suggestion="" expected=""
  local ids branch name
  ids="$(worktree_ids_from_spec "$spec")"
  branch="${ids%%	*}"
  name="${ids#*	}"
  needle="$(printf '%s' "${branch:-$spec}" | tr '/' '-')"
  expected="$name"
  # Only suggest basenames that actually exist on disk. Otherwise agents
  # misread a soft miss as "already cleaned" while multi-GB worktrees remain.
  local d base base_lc needle_lc token weak=0
  needle_lc="$(printf '%s' "$needle" | tr '[:upper:]' '[:lower:]')"
  if [ -n "$expected" ] && [ -e "$WT_ROOT/$expected" ]; then
    suggestion="$expected"
  fi
  if [ -z "$suggestion" ] && [ -d "$WT_ROOT" ]; then
    for d in "$WT_ROOT"/"${SLUG}"-*; do
      [ -e "$d" ] || continue
      base="$(basename "$d")"
      base_lc="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
      case "$base_lc" in
        *"$needle_lc"*)
          suggestion="$base"
          break
          ;;
      esac
    done
  fi
  # Fallback: share a meaningful token (len>=6) with a live worktree, so a
  # mistyped suffix still surfaces the basename the operator meant.
  #
  # Two rules stop this naming an UNRELATED live worktree, which is a
  # destructive suggestion (papercut-portal-wt-rm-suggests-deleting-an-
  # unrelated-live-worktree-20260906):
  #
  #   * Tokens come from what the operator typed, never from `needle_lc`.
  #     `worktree_ids_from_spec` rewrites a bare slug to `<SLUG>-kanban-<slug>`,
  #     and `kanban` is six characters and sits in the basename of essentially
  #     every worktree this fleet creates. A needle-derived token list therefore
  #     always matches, and the first `${SLUG}-*` the glob returns wins.
  #   * A token matching MORE THAN ONE worktree is not evidence of anything.
  #     Only a unique match is a suggestion; ambiguity means keep looking.
  #
  # A weak match is reported as a candidate to check, never as a `wt rm` to run.
  if [ -z "$suggestion" ] && [ -d "$WT_ROOT" ] && [ -n "$spec" ]; then
    local spec_lc hit hit_count
    spec_lc="$(printf '%s' "$spec" | tr '[:upper:]' '[:lower:]' | tr '/' '-')"
    while IFS= read -r token; do
      [ -n "$token" ] || continue
      case "$token" in kanban|"$SLUG") continue ;; esac
      hit=""
      hit_count=0
      for d in "$WT_ROOT"/"${SLUG}"-*; do
        [ -e "$d" ] || continue
        base="$(basename "$d")"
        base_lc="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
        case "$base_lc" in
          *"$token"*)
            hit="$base"
            hit_count=$((hit_count + 1))
            ;;
        esac
      done
      if [ "$hit_count" -eq 1 ]; then
        suggestion="$hit"
        weak=1
        break
      fi
    done <<EOF
$(printf '%s' "$spec_lc" | tr '-' '\n' | awk 'length>=6 {print}')
EOF
  fi
  if [ -n "$suggestion" ] && [ "$weak" -eq 0 ]; then
    printf 'portal-wt: worktree not removed for %s\n' "$spec" >&2
    printf 'portal-wt: no path matched that id; likely basename is %s\n' "$suggestion" >&2
    printf 'portal-wt: try: wt rm %s\n' "$suggestion" >&2
    printf 'portal-wt: (NOT cleaned up — disk worktree may still exist)\n' >&2
  elif [ -n "$suggestion" ]; then
    # Weak: one shared token, uniquely. Name it so a live worktree is never
    # mistaken for "already cleaned", but do NOT hand back a removal command
    # for a path the caller did not name.
    printf 'portal-wt: worktree not removed for %s\n' "$spec" >&2
    printf 'portal-wt: no path matched that id; closest same-portal worktree is %s\n' "$suggestion" >&2
    printf 'portal-wt: that is a WEAK token match, not the worktree you named — verify before removing it\n' >&2
    printf 'portal-wt: (NOT cleaned up — disk worktree may still exist)\n' >&2
  else
    # Confirmed absence: no same-portal dir matches. Safe "already gone".
    printf 'portal-wt: worktree already gone for %s (no match under %s/%s-*)\n' \
      "$spec" "$WT_ROOT" "$SLUG" >&2
  fi
}

cmd_rm() {
  read_portal
  local spec="${1:-}"
  [ -n "$spec" ] || die "usage: wt rm <branch-or-slug-or-dir>  (same identifiers as wt start)"
  local path
  if ! path="$(resolve_worktree_path "$spec")"; then
    suggest_worktree_near_miss "$spec"
    exit 1
  fi
  ensure_cache
  $GIT -C "$CACHE" worktree remove --force "$path" 2>/dev/null \
    || rm -rf "$path"
  $GIT -C "$CACHE" worktree prune 2>/dev/null || true
  printf 'portal-wt: removed %s\n' "$path"
}

cmd_start() {
  local spec="${1:-}"
  case "$spec" in
    -h|--help|-?)
      printf 'usage: wt start <branch-name-or-card-slug>\n'
      exit 0
      ;;
  esac
  read_portal
  [ -n "$spec" ] || die "usage: wt start <branch-name-or-card-slug>"
  # Accept kanban/foo or bare slug → branch kanban/slug if no slash
  local branch="$spec"
  case "$branch" in
    */*) ;;
    *) branch="kanban/$branch" ;;
  esac
  local name
  name="$(printf '%s' "$branch" | tr '/' '-')"
  # prefix with slug for uniqueness across portals
  name="${SLUG}-${name}"
  local path="$WT_ROOT/$name"

  ensure_cache
  mkdir -p "$WT_ROOT"

  if [ -e "$path" ]; then
    printf 'portal-wt: worktree already exists\n%s\n' "$path"
    exit 0
  fi

  if $GIT -C "$CACHE" show-ref --verify --quiet "refs/heads/$branch"; then
    $GIT -C "$CACHE" worktree add --quiet "$path" "$branch"
  else
    $GIT -C "$CACHE" worktree add --quiet -b "$branch" "$path" "$(start_base_ref)"
  fi

  # Drop a small marker so agents know this is the work surface.
  # Never write absolute local paths (home dirs leak host usernames into git if
  # this file is accidentally committed and mirrored to public GitHub).
  printf 'slug=%s\nbranch=%s\ncreated=%s\n' \
    "$SLUG" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >"$path/.portal-worktree"
  # Keep the marker untracked in every worktree. Linked worktrees use a
  # `.git` *file* (not dir); write exclude via git-dir, never path/.git/info.
  if [ -d "$path/.git" ] || [ -f "$path/.git" ]; then
    if ! git -C "$path" check-ignore -q .portal-worktree 2>/dev/null; then
      gitdir="$(git -C "$path" rev-parse --git-dir 2>/dev/null || true)"
      if [ -n "${gitdir:-}" ]; then
        mkdir -p "$gitdir/info" 2>/dev/null || true
        if [ -d "$gitdir/info" ]; then
          printf '\n# local agent marker — never commit (machine-local)\n.portal-worktree\n' \
            >>"$gitdir/info/exclude"
        fi
      fi
    fi
  fi

  printf 'portal-wt: ready\n'
  printf '  portal  %s\n' "$PORTAL"
  printf '  cache   %s\n' "$CACHE"
  printf '  branch  %s\n' "$branch"
  printf '  path    %s\n' "$path"
  printf 'WORK ONLY IN THE PATH ABOVE. Do not edit the portal directory.\n' >&2
}

# --- arg parse ---
cmd=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --portal)
      PORTAL_DIR="${2:-}"
      [ -n "$PORTAL_DIR" ] || die "--portal needs a directory"
      shift 2
      ;;
    start|list|path|rm|fetch)
      cmd="$1"
      shift
      break
      ;;
    -h|--help)
      sed -n '2,12p' "$0" | tr -d '#'
      exit 0
      ;;
    *)
      die "unknown arg: $1 (try start|list|path|rm|fetch)"
      ;;
  esac
done
[ -n "$cmd" ] || die "usage: last-stack-portal-wt [--portal DIR] start|list|path|rm|fetch …"

case "$cmd" in
  start) cmd_start "$@" ;;
  list) cmd_list ;;
  path) cmd_path ;;
  rm) cmd_rm "$@" ;;
  fetch) cmd_fetch ;;
esac
