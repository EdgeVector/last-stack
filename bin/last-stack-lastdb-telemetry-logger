#!/usr/bin/env bash
# last-stack-lastdb-telemetry-logger — one poll pass of `lastdb status` +
# `lastdb ops --json`, appended to a compact trend log, with automatic
# rotation so nothing grows unbounded.
#
# Why (Tom, 2026-09-25): "lastdb ops should always run" — it was a command run
# by hand, so gaps (e.g. the folddb.sock.tmp socket-rename race,
# papercut-lastdbd-listening-on-folddb-sock-tmp-20260924) went unnoticed until
# someone happened to check. This is one pass; it is wrapped by
# last-stack-launchd-loop under com.edgevector.lastdb-telemetry-logger
# (KeepAlive, launchd/com.edgevector.lastdb-telemetry-logger.plist, installed
# by last-stack-guard-loops-install), the same pattern as lastdb-memory-guard,
# because a plain StartInterval job stops firing once the GUI session locks.
#
# History (2026-11-25): this script lived only as a hand-installed copy in
# ~/.local/bin and called `lastdb ops --by-app`. LastDB removed that flag, so
# every pass since at least 2026-11-10 wrote ops_rc=2 and no ops numbers, and
# still exited 0. It now reads `lastdb ops --json` (stdout and stderr kept
# apart by last-stack-json-capture) and exits non-zero with a log line when a
# command fails or the JSON does not parse.
#
# Output:
#   $DIR/lastdb-telemetry-YYYYMMDD.tsv           one line per poll, always
#   $DIR/lastdb-telemetry-failures-YYYYMMDD.log  full raw output, only on failure
#
# TSV line: a UTC timestamp, then key=value fields. The first eleven fields keep
# their old names and order; new fields are appended after them.
#   status_rc status_ms ops_rc ops_ms   exit status and wall time of each command
#   footprint_gib rss_gib cpu_pct warm evictions
#                                       parsed from `lastdb status` text when it
#                                       prints them (current builds do not; the
#                                       fields stay empty)
#   broken_rows      call rows where every request was refused (count > 0 and
#                    the refused total >= count)
#   ops_json         ok | bad | none — whether `lastdb ops --json` parsed
#   ops_uptime_s     node uptime that the ops counters cover
#   ops_rows         call rows in the table (caller x client x route)
#   ops_count        requests completed since the node started
#   ops_refused      refused requests since the node started
#   ops_total_ms     total request time since the node started
#   read_count read_total_ms          the /v1/read rows, summed
#   write_count write_total_ms write_slowest_ms
#                                     the /v1/write rows, summed (slowest = max)
# The ops counters are cumulative since the node started, so the history is the
# difference between two lines; a drop in ops_uptime_s marks a node restart.
#
# Exit status: 0 when both commands succeed and the ops JSON parses; 1
# otherwise, after the TSV line and the failure log are written and one
# `FAIL ...` line is printed on stderr (the launchd log). The loop keeps going
# and records the rc in its heartbeat.
#
# Rotation: files older than LASTDB_TELEM_RETAIN_DAYS are deleted every pass;
# if the directory is still over LASTDB_TELEM_MAX_MB, oldest files are deleted
# next, oldest-name-first, until back under the cap.
#
# Env:
#   LASTDB_TELEM_DIR               default $HOME/.lastdb/monitoring/telemetry
#   LASTDB_TELEM_RETAIN_DAYS       default 14
#   LASTDB_TELEM_MAX_MB            default 300
#   LASTDB_TELEM_FAIL_THRESHOLD    default 3 consecutive failed polls before a notice
#   LASTDB_TELEM_NOTICE_COOLDOWN_SEC  default 3600 — one notice per window
#   LASTDB_TELEM_LASTDB            default lastdb (the CLI on PATH)

set -u

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
fi

DIR="${LASTDB_TELEM_DIR:-$HOME/.lastdb/monitoring/telemetry}"
RETAIN_DAYS="${LASTDB_TELEM_RETAIN_DAYS:-14}"
MAX_MB="${LASTDB_TELEM_MAX_MB:-300}"
FAIL_THRESHOLD="${LASTDB_TELEM_FAIL_THRESHOLD:-3}"
NOTICE_COOLDOWN_SEC="${LASTDB_TELEM_NOTICE_COOLDOWN_SEC:-3600}"
LASTDB_BIN="${LASTDB_TELEM_LASTDB:-lastdb}"

fail_early() {
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) last-stack-lastdb-telemetry-logger: FAIL $*" >&2
  exit 1
}

mkdir -p "$DIR" 2>/dev/null || fail_early "cannot create $DIR"
STATE_DIR="$DIR/.state"
mkdir -p "$STATE_DIR" 2>/dev/null || true

# The capture helper ships next to this script in bin/. Fall back to PATH.
self_dir="$(cd "$(dirname "$0")" && pwd)"
CAPTURE="$self_dir/last-stack-json-capture"
[ -x "$CAPTURE" ] || CAPTURE="$(command -v last-stack-json-capture 2>/dev/null || true)"
[ -n "$CAPTURE" ] || fail_early "last-stack-json-capture not found next to $0 or on PATH"
command -v jq >/dev/null 2>&1 || fail_early "jq not found on PATH"

TODAY="$(date +%Y%m%d)"
TREND="$DIR/lastdb-telemetry-$TODAY.tsv"
FAILLOG="$DIR/lastdb-telemetry-failures-$TODAY.log"
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/lastdb-telem.XXXXXX")" || fail_early "mktemp failed"
trap 'rm -rf "$WORK"' EXIT
STATUS_OUT="$WORK/status.txt"
OPS_JSON_FILE="$WORK/ops.json"
OPS_ERR="$OPS_JSON_FILE.err"

T0=$(date +%s)
"$LASTDB_BIN" status >"$STATUS_OUT" 2>"$STATUS_OUT.err"
STATUS_RC=$?
STATUS_MS=$(( ($(date +%s) - T0) * 1000 ))

# Never merge stderr into a --json stream: the helper writes stdout to the
# file and stderr to <file>.err, and exits with the command's status.
T0=$(date +%s)
CAPTURE_LINE="$("$CAPTURE" "$OPS_JSON_FILE" -- "$LASTDB_BIN" ops --json 2>/dev/null)"
OPS_RC=$?
OPS_MS=$(( ($(date +%s) - T0) * 1000 ))

FOOTPRINT="$(sed -n 's/.*footprint \([0-9.]*\) GiB.*/\1/p' "$STATUS_OUT" | head -1)"
RSS="$(sed -n 's/.*RSS \([0-9.]*\) GiB.*/\1/p' "$STATUS_OUT" | head -1)"
CPU="$(sed -n 's/.*CPU: \([0-9.]*\)%.*/\1/p' "$STATUS_OUT" | head -1)"
WARM="$(sed -n 's/.*warm=\([0-9.]*\) GiB \/ \([0-9.]*\) GiB.*/\1\/\2/p' "$STATUS_OUT" | head -1)"
EVICTIONS="$(sed -n 's/.*eviction_events=\([0-9]*\).*/\1/p' "$STATUS_OUT" | head -1)"

# One jq pass turns the route JSON into the appended TSV fields. The order
# matches the `read` below.
# shellcheck disable=SC2016  # jq program: $c, $r and $w are jq variables
OPS_FILTER='
  def ms: (. / 1000000 | floor);
  def refused_sum: ((.refused // {}) | [.[]] | add // 0);
  def total(f): (map(f) | add // 0);
  (.calls // []) as $c
  | ($c | map(select(.call == "/v1/read"))) as $r
  | ($c | map(select(.call == "/v1/write"))) as $w
  | [ ($c | map(select(.count > 0 and refused_sum >= .count)) | length),
      (.uptime_secs // 0),
      ($c | length),
      ($c | total(.count)),
      ($c | total(refused_sum)),
      ($c | total(.total_ns) | ms),
      ($r | total(.count)),
      ($r | total(.total_ns) | ms),
      ($w | total(.count)),
      ($w | total(.total_ns) | ms),
      ($w | map(.slowest_ns) | max // 0 | ms)
    ] | @tsv'

OPS_JSON_STATE=none
BROKEN_ROWS=0
OPS_UPTIME="" OPS_ROWS="" OPS_COUNT="" OPS_REFUSED="" OPS_TOTAL_MS=""
READ_COUNT="" READ_TOTAL_MS="" WRITE_COUNT="" WRITE_TOTAL_MS="" WRITE_SLOWEST_MS=""
if [ -s "$OPS_JSON_FILE" ]; then
  if jq -e '.ok == true and (.calls | type == "array")' "$OPS_JSON_FILE" >/dev/null 2>&1 \
     && jq -r "$OPS_FILTER" "$OPS_JSON_FILE" >"$WORK/ops.tsv" 2>"$WORK/ops.jq.err" \
     && [ -s "$WORK/ops.tsv" ]; then
    OPS_JSON_STATE=ok
    IFS="$(printf '\t')" read -r BROKEN_ROWS OPS_UPTIME OPS_ROWS OPS_COUNT OPS_REFUSED OPS_TOTAL_MS \
      READ_COUNT READ_TOTAL_MS WRITE_COUNT WRITE_TOTAL_MS WRITE_SLOWEST_MS <"$WORK/ops.tsv"
  else
    OPS_JSON_STATE=bad
  fi
fi

printf '%s\tstatus_rc=%s\tstatus_ms=%s\tops_rc=%s\tops_ms=%s\tfootprint_gib=%s\trss_gib=%s\tcpu_pct=%s\twarm=%s\tevictions=%s\tbroken_rows=%s\tops_json=%s\tops_uptime_s=%s\tops_rows=%s\tops_count=%s\tops_refused=%s\tops_total_ms=%s\tread_count=%s\tread_total_ms=%s\twrite_count=%s\twrite_total_ms=%s\twrite_slowest_ms=%s\n' \
  "$TS" "$STATUS_RC" "$STATUS_MS" "$OPS_RC" "$OPS_MS" "${FOOTPRINT:-}" "${RSS:-}" "${CPU:-}" "${WARM:-}" "${EVICTIONS:-}" "${BROKEN_ROWS:-0}" \
  "$OPS_JSON_STATE" "$OPS_UPTIME" "$OPS_ROWS" "$OPS_COUNT" "$OPS_REFUSED" "$OPS_TOTAL_MS" \
  "$READ_COUNT" "$READ_TOTAL_MS" "$WRITE_COUNT" "$WRITE_TOTAL_MS" "$WRITE_SLOWEST_MS" \
  >>"$TREND"

FAIL_COUNT_FILE="$STATE_DIR/consec_fail"
NOTICE_COOLDOWN_FILE="$STATE_DIR/last_notice_epoch"
PASS_RC=0

if [ "$STATUS_RC" -ne 0 ] || [ "$OPS_RC" -ne 0 ] || [ "$OPS_JSON_STATE" != ok ]; then
  PASS_RC=1
  {
    echo "=== $TS status_rc=$STATUS_RC status_ms=$STATUS_MS ops_rc=$OPS_RC ops_ms=$OPS_MS ops_json=$OPS_JSON_STATE ==="
    echo "--- lastdb status (stdout) ---"
    cat "$STATUS_OUT"
    echo "--- lastdb status (stderr) ---"
    cat "$STATUS_OUT.err" 2>/dev/null
    echo "--- lastdb ops --json ---"
    echo "$CAPTURE_LINE"
    echo "--- lastdb ops --json (stdout, first 4 KiB) ---"
    head -c 4096 "$OPS_JSON_FILE" 2>/dev/null
    echo
    echo "--- lastdb ops --json (stderr) ---"
    cat "$OPS_ERR" 2>/dev/null
    cat "$WORK/ops.jq.err" 2>/dev/null
    echo
  } >>"$FAILLOG"

  first_err="$(head -n 1 "$OPS_ERR" 2>/dev/null)"
  [ -n "$first_err" ] || first_err="$(head -n 1 "$STATUS_OUT.err" 2>/dev/null)"
  echo "$TS last-stack-lastdb-telemetry-logger: FAIL status_rc=$STATUS_RC ops_rc=$OPS_RC ops_json=$OPS_JSON_STATE first_stderr=${first_err:-none} log=$FAILLOG" >&2

  N="$(cat "$FAIL_COUNT_FILE" 2>/dev/null || echo 0)"
  case "$N" in ''|*[!0-9]*) N=0 ;; esac
  N=$((N + 1))
  echo "$N" >"$FAIL_COUNT_FILE"

  if [ "$N" -ge "$FAIL_THRESHOLD" ]; then
    LAST="$(cat "$NOTICE_COOLDOWN_FILE" 2>/dev/null || echo 0)"
    case "$LAST" in ''|*[!0-9]*) LAST=0 ;; esac
    NOW=$(date +%s)
    if [ $((NOW - LAST)) -ge "$NOTICE_COOLDOWN_SEC" ]; then
      echo "$NOW" >"$NOTICE_COOLDOWN_FILE"
      SIT_BIN="$HOME/.local/bin/situations"
      if [ -x "$SIT_BIN" ]; then
        "$SIT_BIN" notice \
          --title "lastdb status/ops unreachable for $N consecutive polls" \
          --kind other --system lastdbd --actor last-stack-lastdb-telemetry-logger \
          --summary "status_rc=$STATUS_RC ops_rc=$OPS_RC ops_json=$OPS_JSON_STATE, polled every ${LAUNCHD_LOOP_INTERVAL_SEC:-60}s. Full output in $FAILLOG. Do not restart the primary for this alone -- check for a folddb.sock vs folddb.sock.tmp mismatch first (papercut-lastdbd-listening-on-folddb-sock-tmp-20260924)." \
          >/dev/null 2>&1 </dev/null
      fi
    fi
  fi
else
  echo 0 >"$FAIL_COUNT_FILE"
fi

find "$DIR" -maxdepth 1 -name 'lastdb-telemetry-*.tsv' -mtime "+$RETAIN_DAYS" -delete 2>/dev/null
find "$DIR" -maxdepth 1 -name 'lastdb-telemetry-failures-*.log' -mtime "+$RETAIN_DAYS" -delete 2>/dev/null

MAX_KB=$((MAX_MB * 1024))
DIR_KB="$(du -sk "$DIR" 2>/dev/null | awk '{print $1}')"
if [ -n "${DIR_KB:-}" ] && [ "$DIR_KB" -gt "$MAX_KB" ]; then
  for f in "$DIR"/lastdb-telemetry-*.tsv "$DIR"/lastdb-telemetry-failures-*.log; do
    [ -f "$f" ] || continue
    DIR_KB="$(du -sk "$DIR" 2>/dev/null | awk '{print $1}')"
    [ -n "${DIR_KB:-}" ] && [ "$DIR_KB" -le "$MAX_KB" ] && break
    rm -f "$f"
  done
fi

exit "$PASS_RC"
