#!/usr/bin/env bash
# Zero-LLM pre-dispatch gate for last-stack-milestone-driver.
#
# Ready-buffer calls `routines run last-stack-milestone-driver`. An empty
# frontier must skip the harness instead of spending a model to learn that.
#
#   exit 0  → skip harness (noop)
#   exit 10 → proceed (promote, admitted decompose, complete_proof, or
#             repair work: a decompose entry flagged repair/next-slice, a
#             proof_pending milestone whose proof card last verdict is a
#             stale FAIL, or a proof_passing milestone ready to close)
#   exit 2  → usage
#
# Skip: empty work_queue with no idle promote/empty counts and no repair
# work, admission paused or unreadable on a decompose-only queue with no
# repair work, or board/Brain unreadable.
#
# Repair work is never skipped by the admission check: the feature portfolio
# admission gates NEW feature work, and last-stack-kanban-file-pr files repair
# with --work-class repair, which admission does not gate
# (papercut-milestone-driver-gate-blind-to-proof-pending-repair-20260926).
set -euo pipefail

self_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
if [ -n "${LAST_STACK_ROOT:-}" ] && [ -d "${LAST_STACK_ROOT}/bin" ]; then
  last_stack="$LAST_STACK_ROOT"
elif [ -d "${HOME}/.last-stack/bin" ]; then
  last_stack="${HOME}/.last-stack"
else
  last_stack="$(CDPATH='' cd -- "$self_dir/.." && pwd -P)"
fi
export PATH="${HOME}/.local/bin:${last_stack}/bin:${PATH:-/usr/bin:/bin}"

usage() {
  cat <<'USAGE'
last-stack-milestone-driver-gate

Zero-LLM gate for last-stack-milestone-driver. Exit 0 = skip; 10 = proceed.

Reads `kanban milestone gap-report --json`. Decompose-only queues also run
`last-stack-feature-portfolio-admission --work-class feature --json`.

Env (optional, for tests):
  LAST_STACK_MILESTONE_DRIVER_GATE_KANBAN   kanban CLI (default kanban)
  LAST_STACK_MILESTONE_DRIVER_GATE_ADMISSION admission CLI
  LAST_STACK_ADMISSION_FIXTURE              offline admission fixture dir
  LAST_STACK_MILESTONE_DRIVER_GATE_PASS_RECORD pass-record CLI ("" disables)
  LAST_STACK_MILESTONE_DRIVER_GATE_PROOF_SCAN_MAX  max proof_pending
                                            milestones point-read (default 25)
  MILESTONE_DRIVER_CADENCE_SECONDS          FAIL staleness window (default 3600)
USAGE
}

case "${1:-}" in
  "") ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

heartbeat() {
  local line="$1"
  local helper="${last_stack}/bin/last-stack-brain-append-heartbeat"
  if [ -x "$helper" ]; then
    "$helper" --line "$line" >/dev/null 2>&1 || true
  fi
  printf '%s\n' "$line"
}

skip() {
  local reason="$1"
  heartbeat "milestone-driver-gate $(iso_now) noop ${reason}"
  printf 'MILESTONE_DRIVER_GATE skip reason=%s\n' "$reason"
  printf 'ROUTINE_RESULT outcome=noop detail=%s\n' "$reason"
  exit 0
}

proceed() {
  local reason="$1"
  printf 'MILESTONE_DRIVER_GATE proceed reason=%s\n' "$reason"
  exit 10
}

kanban_bin="${LAST_STACK_MILESTONE_DRIVER_GATE_KANBAN:-kanban}"
admission_bin="${LAST_STACK_MILESTONE_DRIVER_GATE_ADMISSION:-${last_stack}/bin/last-stack-feature-portfolio-admission}"
jq_bin="$(command -v jq 2>/dev/null || true)"
[ -n "$jq_bin" ] && [ -x "$jq_bin" ] || skip "jq-missing"

if ! command -v "$kanban_bin" >/dev/null 2>&1; then
  skip "board-unreadable missing-kanban"
fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/milestone-driver-gate.XXXXXX")"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

set +e
"$kanban_bin" milestone gap-report --json >"$tmp/gap.json" 2>"$tmp/gap.err"
gap_rc=$?
set -e
if [ "$gap_rc" -ne 0 ] || [ ! -s "$tmp/gap.json" ]; then
  skip "board-unreadable gap-report-rc=${gap_rc}"
fi
if ! "$jq_bin" -e 'type == "object"' "$tmp/gap.json" >/dev/null 2>&1; then
  skip "board-unreadable gap-report-json-invalid"
fi

# Portfolio pass record (best-effort). The auto-refill trigger needs one
# record per hourly pass. The harness used to write it as its LAST step, so a
# timed-out run (2026-09-26T11:06Z, SIGKILL at 31 min) or a gate skip on a
# paused decompose-only queue (the starved state refill exists for) left no
# record, and refill kept its stale rank-only pick. Record here, from the same
# zero-LLM gap-report, before any skip or proceed.
pass_record_bin="${LAST_STACK_MILESTONE_DRIVER_GATE_PASS_RECORD-${last_stack}/bin/last-stack-portfolio-pass-record}"
if [ -n "$pass_record_bin" ] && [ -x "$pass_record_bin" ]; then
  pass_args=(--gap-report "$tmp/gap.json" --min-interval-s 3000)
  if [ -n "${LAST_STACK_ADMISSION_FIXTURE:-}" ]; then
    pass_args+=(--fixture-dir "$LAST_STACK_ADMISSION_FIXTURE")
  fi
  "$pass_record_bin" "${pass_args[@]}" >/dev/null 2>&1 || true
fi

wq_len="$("$jq_bin" -r '(.work_queue // []) | length' "$tmp/gap.json")"
idle_promoteable="$("$jq_bin" -r '(.counts.idle_promoteable // 0) | tonumber' "$tmp/gap.json")"
idle_empty="$("$jq_bin" -r '(.counts.idle_empty // 0) | tonumber' "$tmp/gap.json")"
has_promote="$("$jq_bin" -r '[.work_queue[]? | select(.action == "promote")] | length' "$tmp/gap.json")"
has_complete="$("$jq_bin" -r '[.work_queue[]? | select(.action == "complete_proof")] | length' "$tmp/gap.json")"
has_decompose="$("$jq_bin" -r '[.work_queue[]? | select(.action == "decompose")] | length' "$tmp/gap.json")"

case "$wq_len" in ''|*[!0-9]*) wq_len=0 ;; esac
case "$idle_promoteable" in ''|*[!0-9]*) idle_promoteable=0 ;; esac
case "$idle_empty" in ''|*[!0-9]*) idle_empty=0 ;; esac
case "$has_promote" in ''|*[!0-9]*) has_promote=0 ;; esac
case "$has_complete" in ''|*[!0-9]*) has_complete=0 ;; esac
case "$has_decompose" in ''|*[!0-9]*) has_decompose=0 ;; esac

# Repair entries already on the queue: the snapshot's proof_pending repair
# entries (decompose + stale_fail_proof) and fkanban next-slice decompose
# entries (needs_next_slice). The raw gap-report does not carry the snapshot
# flags; the proof_pending scan below covers that case.
repair_flagged="$("$jq_bin" -r '
  ([.milestones[]? | select(.status == "needs_next_slice") | .slug]) as $next
  | [.work_queue[]? | select(.action == "decompose")
      | select(.stale_fail_proof == true or .needs_next_slice == true
          or .next_slice == true or .work_class == "repair"
          or .from_status == "proof_pending" or .from_status == "needs_next_slice"
          or .status == "needs_next_slice" or ((.slug // "") as $s | $next | index($s)) != null)]
  | length' "$tmp/gap.json")"
case "$repair_flagged" in ''|*[!0-9]*) repair_flagged=0 ;; esac

# Close-ready rows: fkanban reports proof_passing=true (terminal proof card
# with a PASS line) and no live Kind:pr, but scores the row idle_empty /
# decompose. The snapshot turns it into complete_proof + proof_pass_close
# (also for a stored proof_status=failing whose repair re-proved PASS). Like
# repair work, closing it is never admission-gated.
close_ready="$("$jq_bin" -r '
  [.milestones[]? | select(.proof_passing == true
      and ((.state // "") == "active" or (.state // "") == "proving")
      and ((.pr_live // 0) == 0) and ((.pr_done // 0) > 0))]
  | length' "$tmp/gap.json")"
case "$close_ready" in ''|*[!0-9]*) close_ready=0 ;; esac
repair_flagged=$((repair_flagged + close_ready))

# The verdict of one proof card: its LAST PROOF:/RESULT: verdict line. The
# rule matches _proof_verdict() in last-stack-milestone-driver-snapshot
# (tests/last-stack-milestone-driver-gate.sh checks the two agree). Prints
# `stale-fail` only for a FAIL older than one driver cadence on a card that
# is not in doing (being re-run now).
proof_card_filter='
  def verdict:
    [ (.body // "") | split("\n")[]
      | (try capture("^[ \t]*(?:PROOF|RESULT)(?:\\[(?<tag>[^\\]\n]*)\\])?:[ \t]*(?<word>\\S*)"; "i") catch null)
      | select(. != null)
      | ((.tag // "") | ascii_downcase | ltrimstr(" ") | rtrimstr(" ")) as $t
      | ((.word // "") | ascii_downcase
          | sub("^[-.,;:!\u2014\u2013]+"; "") | sub("[-.,;:!\u2014\u2013]+$"; "")) as $w
      | if ($t != "" and ($t | test("^(fail|reopened)|unmet"))) then "fail"
        elif ($t != "" and ($t | test("^pass"))) then "pass"
        elif ($w | test("^fail(ed|s|ure|ing)?$")) then "fail"
        elif ($w | test("^pass(ed|es|ing)?$")) then "pass"
        else empty end ]
    | last // "none";
  (try ((.updated_at // "") | sub("\\.[0-9]+"; "") | fromdateiso8601) catch null) as $at
  | if (.column // "") == "doing" then "running"
    elif verdict != "fail" then verdict
    elif $at == null then "fail-undated"
    elif (now - $at) > ($cadence | tonumber) then "stale-fail"
    else "fresh-fail" end'

# Count proof_pending milestones whose linked proof card last verdict is a
# stale FAIL. Bounded: at most PROOF_SCAN_MAX milestones, two point reads
# each, and only when the gate would otherwise skip.
stale_fail_proof_pending() {
  local max="${LAST_STACK_MILESTONE_DRIVER_GATE_PROOF_SCAN_MAX:-25}"
  local cadence="${MILESTONE_DRIVER_CADENCE_SECONDS:-3600}"
  case "$max" in ''|*[!0-9]*) max=25 ;; esac
  case "$cadence" in ''|*[!0-9]*|0) cadence=3600 ;; esac
  "$jq_bin" -r --argjson max "$max" '
    [.milestones[]? | select(.status == "proof_pending" or .action == "await_proof")
      | .slug | select(type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))]
    | .[:$max][]' "$tmp/gap.json" >"$tmp/proof-pending.txt" 2>/dev/null || return 0
  local n=0 slug card verdict
  while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    "$kanban_bin" milestone detail "$slug" --json >"$tmp/pp-detail.json" 2>/dev/null || continue
    card="$("$jq_bin" -r --arg slug "$slug" '
      if (.milestone.slug // "") == $slug then (.milestone.proof_card // "") else "" end
    ' "$tmp/pp-detail.json" 2>/dev/null || true)"
    case "$card" in ''|*[!A-Za-z0-9._-]*) continue ;; esac
    "$kanban_bin" show "$card" --json >"$tmp/pp-card.json" 2>/dev/null || continue
    verdict="$("$jq_bin" -r --arg cadence "$cadence" "$proof_card_filter" "$tmp/pp-card.json" 2>/dev/null || true)"
    if [ "$verdict" = "stale-fail" ]; then
      n=$((n + 1))
      printf 'MILESTONE_DRIVER_GATE proof_pending_repair slug=%s proof_card=%s\n' "$slug" "$card"
    fi
  done <"$tmp/proof-pending.txt"
  printf '%s\n' "$n" >"$tmp/proof-pending.count"
}

# One lazy scan per gate run; prints the count on the last line.
proof_pending_repair_count() {
  if [ ! -e "$tmp/proof-pending.count" ]; then
    stale_fail_proof_pending >&2
    [ -e "$tmp/proof-pending.count" ] || printf '0\n' >"$tmp/proof-pending.count"
  fi
  cat "$tmp/proof-pending.count"
}

idle=$((idle_promoteable + idle_empty))
if [ "$wq_len" -eq 0 ] && [ "$idle" -eq 0 ]; then
  if [ "$close_ready" -gt 0 ]; then
    proceed "proof-pass-close=${close_ready} work_queue=0"
  fi
  pp_repair="$(proof_pending_repair_count)"
  if [ "$pp_repair" -gt 0 ]; then
    proceed "proof-pending-repair=${pp_repair} work_queue=0"
  fi
  skip "empty-frontier work_queue=0 idle_promoteable=0 idle_empty=0"
fi

need_admission=0
if [ "$has_promote" -eq 0 ] && [ "$has_complete" -eq 0 ]; then
  if [ "$has_decompose" -gt 0 ] || [ "$idle_empty" -gt 0 ]; then
    need_admission=1
  fi
fi

# Repair work is never skipped by the admission check.
if [ "$need_admission" -eq 1 ] && [ "$repair_flagged" -gt 0 ]; then
  proceed "repair=${repair_flagged} work_queue=${wq_len}"
fi

# An admission skip first checks for proof_pending repair work.
admission_skip() {
  local reason="$1" pp_repair
  pp_repair="$(proof_pending_repair_count)"
  if [ "$pp_repair" -gt 0 ]; then
    proceed "proof-pending-repair=${pp_repair} work_queue=${wq_len} admission=${reason%% *}"
  fi
  skip "$reason"
}

if [ "$need_admission" -eq 1 ]; then
  if [ ! -x "$admission_bin" ]; then
    admission_skip "admission-unreadable missing-cli"
  fi
  # work_queue entries carry only {action, promoteable, slug} -- no
  # north_star/northStar field ever lands there. Look the real value up on
  # the milestone record itself (papercut-milestone-driver-gate-north-star-filter-dead-20260926).
  decompose_slug="$("$jq_bin" -r '
    [.work_queue[]? | select(.action == "decompose") | .slug]
    | map(select(type == "string" and length > 0)) | .[0] // empty
  ' "$tmp/gap.json")"
  north_star=""
  if [ -n "$decompose_slug" ]; then
    set +e
    "$kanban_bin" milestone show "$decompose_slug" --json >"$tmp/ms.json" 2>"$tmp/ms.err"
    ms_rc=$?
    set -e
    if [ "$ms_rc" -eq 0 ] && [ -s "$tmp/ms.json" ]; then
      north_star="$("$jq_bin" -r --arg slug "$decompose_slug" '
        if (.slug // empty) == $slug then (.north_star // empty) else empty end
      ' "$tmp/ms.json" 2>/dev/null || true)"
    fi
  fi
  set +e
  if [ -n "$north_star" ]; then
    "$admission_bin" --work-class feature --json --north-star "$north_star" \
      >"$tmp/adm.json" 2>"$tmp/adm.err"
  else
    "$admission_bin" --work-class feature --json \
      >"$tmp/adm.json" 2>"$tmp/adm.err"
  fi
  adm_rc=$?
  set -e
  if [ "$adm_rc" -eq 2 ]; then
    admission_skip "admission-paused"
  fi
  if [ "$adm_rc" -eq 1 ] || [ "$adm_rc" -ne 0 ]; then
    admission_skip "admission-unreadable rc=${adm_rc}"
  fi
  proceed "decompose-admitted work_queue=${wq_len} idle_empty=${idle_empty}"
fi

if [ "$has_promote" -gt 0 ]; then
  proceed "promote=${has_promote} work_queue=${wq_len}"
fi
if [ "$has_complete" -gt 0 ]; then
  proceed "complete_proof=${has_complete} work_queue=${wq_len}"
fi
proceed "idle-frontier idle_promoteable=${idle_promoteable} idle_empty=${idle_empty}"
