#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: last-stack-pr-venue [--json|--compare-ref] <owner/repo> [repo-root]

Print the PR/CR venue for a repo: github, forgejo, or lastgit.
With --compare-ref, print the canonical ref for local-ahead checks.

Default (2026-09-30, decision-2026-09-29-retire-lastgit-all-repos-to-github):
every EdgeVector repo is on GitHub, including an unknown one. The only exception
is EdgeVector/lastgit, which stays on Forgejo. LastGit is retired.

An explicit answer for one repo comes from, in this order:
  git config laststack.pr-venue <venue>
  git config laststack.prVenue <venue>
  .last-stack/pr-venue, first line <venue>
  LAST_STACK_FORGEJO_REPOS containing owner/repo

Repo-local config may also set:
  git config laststack.lastgit-slug <slug>
  git config laststack.lastgit-ci-context <context>
EOF
}

mode=plain
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi
while [ "${1:-}" = "--json" ] || [ "${1:-}" = "--compare-ref" ]; do
  case "$1" in
    --json)
      mode=json
      ;;
    --compare-ref)
      mode=compare_ref
      ;;
  esac
  shift
done

repo="${1:-}"
repo_root="${2:-}"

if [ -z "$repo" ]; then
  echo "LAST_STACK_PR_VENUE: missing owner/repo" >&2
  usage
  exit 2
fi

case "$repo" in
  */*) ;;
  *)
    echo "LAST_STACK_PR_VENUE: repo must be owner/name, got: $repo" >&2
    exit 2
    ;;
esac

repo_name="${repo##*/}"
default_slug="$repo_name"
ci_context="ci-required"
venue=""
reason=""
# Declared once here, not beside the gate that sets them. These two belong to
# the retired-venue gate alone; the foreign-root gate reports through its own
# `ignored_root*` fields. Initializing them later would silently wipe anything
# written before that point, which reads as a working guard and is only
# statement order -- a mutation probe caught exactly that.
ignored_venue=""
ignored_venue_source=""

# A repo root may answer only for the repo it IDENTIFIES. Nothing downstream
# re-checks this, so a root that is a checkout of something else -- or of nothing
# at all -- used to supply the venue, the slug, the CI context and the comparison
# ref for ANY repo it was asked about. The install root did exactly that for four
# repos it is not a checkout of.
#
# Requiring a git checkout would be wrong: measured 2026-10-03, of the 57
# directories under ~/code/edgevector, 49 are portal STUBS with no `.git`, 41
# carry a marker, and 36 are BOTH -- and reading those 36 markers is the
# intended, load-bearing path. So accept EITHER signal, local and network-free:
#
#   * the root's own basename equals the repo name -- this is what keeps every
#     portal stub working, git or not; or
#   * the root is a git checkout and some remote URL's path basename (minus
#     `.git`) equals the repo name -- this is what keeps worktrees working, whose
#     directory names are `<repo>-kanban-<slug>`, and what lets a root whose
#     directory is named differently from its repo still answer for it
#     (measured: ~/code/edgevector/edgevector-org-github remotes EdgeVector/.github).
#
# A git repo with no remotes falls back to the basename test, so it is never
# refused for naming itself correctly.
# papercut-pr-venue-root-marker-answers-for-a-repo-the-root-is-not-a-checkout-of-20261001
root_identifies_repo=""
if [ -n "$repo_root" ]; then
  root_identifies_repo=no
  if [ "$(basename -- "$repo_root")" = "$repo_name" ]; then
    root_identifies_repo=yes
  elif git -C "$repo_root" rev-parse --show-toplevel >/dev/null 2>&1; then
    root_remotes="$(git -C "$repo_root" remote 2>/dev/null || true)"
    for root_remote in $root_remotes; do
      root_remote_url="$(git -C "$repo_root" remote get-url "$root_remote" 2>/dev/null || true)"
      root_remote_url="${root_remote_url##*/}"
      if [ "${root_remote_url%.git}" = "$repo_name" ]; then
        root_identifies_repo=yes
        break
      fi
    done
  fi
fi

repo_config_raw() {
  key="$1"
  if [ -n "$repo_root" ] && git -C "$repo_root" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$repo_root" config --get "$key" 2>/dev/null || true
  fi
}

# Every root-derived read goes through this one gate. Adding a fourth door that
# reads $repo_root without it is the defect above, returning.
repo_config() {
  [ "$root_identifies_repo" = yes ] || return 0
  repo_config_raw "$1"
}

root_marker_raw() {
  if [ -n "$repo_root" ] && [ -f "$repo_root/.last-stack/pr-venue" ]; then
    sed -n '1{s/[[:space:]]*$//;p;}' "$repo_root/.last-stack/pr-venue"
  fi
}

remote_ref_exists() {
  remote="$1"
  branch="$2"
  [ -n "$branch" ] || return 1
  [ -n "$repo_root" ] || return 1
  git -C "$repo_root" show-ref --verify --quiet "refs/remotes/$remote/$branch"
}

canonical_compare_ref() {
  [ -n "$repo_root" ] || return 0
  # A foreign root's HEAD, upstream and origin/main are a DIFFERENT repo's refs,
  # and `origin/main` is equally plausible for both -- so an ungated answer here
  # sends a local-ahead check to compare against the wrong repo and looks right.
  [ "$root_identifies_repo" = yes ] || return 0
  git -C "$repo_root" rev-parse --show-toplevel >/dev/null 2>&1 || return 0

  branch="$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

  if [ "$venue" = "lastgit" ] && remote_ref_exists lastgit "$branch"; then
    printf 'lastgit/%s\n' "$branch"
    return 0
  fi

  upstream="$(git -C "$repo_root" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [ -n "$upstream" ]; then
    printf '%s\n' "$upstream"
    return 0
  fi

  if remote_ref_exists origin "$branch"; then
    printf 'origin/%s\n' "$branch"
    return 0
  fi

  if remote_ref_exists origin main; then
    printf 'origin/main\n'
    return 0
  fi
}

normalize_venue() {
  value="$1"
  case "$value" in
    github|forgejo|lastgit) printf '%s\n' "$value" ;;
    "") ;;
    *)
      echo "LAST_STACK_PR_VENUE: unsupported venue '$value' for $repo" >&2
      exit 2
      ;;
  esac
}

# The refused root stays VISIBLE, the same principle the retired-venue gate
# below follows: stdout carries a venue the caller can act on, and what was
# refused goes to stderr and into --json. Kept in its OWN fields rather than
# reusing ignored_venue, because that gate masks this defect's worst instance
# (the install root's `lastgit` marker) and conflating the two would re-mask it.
#
# Reported only when the root actually carried a value, so an ordinary default
# resolution against a foreign root stays quiet. The raw string is reported
# unnormalized on purpose: a foreign root's garbage marker must not exit 2.
ignored_root=""
ignored_root_venue=""
ignored_root_venue_source=""
if [ -n "$repo_root" ] && [ "$root_identifies_repo" != yes ]; then
  for root_door in git-config:laststack.pr-venue git-config:laststack.prVenue marker:.last-stack/pr-venue; do
    case "$root_door" in
      git-config:*) root_door_value="$(repo_config_raw "${root_door#git-config:}")" ;;
      *)            root_door_value="$(root_marker_raw)" ;;
    esac
    if [ -n "$root_door_value" ]; then
      ignored_root="$repo_root"
      ignored_root_venue="$root_door_value"
      ignored_root_venue_source="${root_door#marker:}"
      break
    fi
  done
  if [ -n "$ignored_root" ]; then
    echo "LAST_STACK_PR_VENUE: ignoring venue '$ignored_root_venue' from $ignored_root_venue_source: root $repo_root does not identify $repo (its basename is not '$repo_name', and it names no remote that does). Pass that repo's own root, or omit the root." >&2
  fi
fi

venue="$(normalize_venue "$(repo_config laststack.pr-venue)")"
if [ -n "$venue" ]; then
  reason="git-config:laststack.pr-venue"
fi

if [ -z "$venue" ]; then
  venue="$(normalize_venue "$(repo_config laststack.prVenue)")"
  if [ -n "$venue" ]; then
    reason="git-config:laststack.prVenue"
  fi
fi

if [ -z "$venue" ] && [ "$root_identifies_repo" = yes ] && [ -f "$repo_root/.last-stack/pr-venue" ]; then
  marker="$(root_marker_raw)"
  venue="$(normalize_venue "$marker")"
  if [ -n "$venue" ]; then
    reason=".last-stack/pr-venue"
  fi
fi

# A `lastgit` answer is never actionable: LastGit is retired
# (decision-2026-09-29-retire-lastgit-all-repos-to-github) and no repo on this
# fleet has that venue -- EdgeVector/lastgit is the repo LastGit hosted, and it
# lives on Forgejo. The ambient env door to the retired venue was closed in
# last-stack PR 138 by requiring an explicit opt-in; this is the same gate on
# the remaining door, an explicit marker or git config.
#
# The data stays VISIBLE, which was the reason the raw value used to be
# returned: the ignored value and the source that carried it go to stderr and
# into --json as `ignored_venue` / `ignored_venue_source`. What changes is that
# stdout now carries a venue a caller can act on. Returning `lastgit` sent
# every caller that follows CLAUDE.md to a retired forge, and the retired
# `lastdb:///` and archived Forgejo remotes are still present and pushable in
# stale trees -- so an always-wrong stdout value was a trap, not visibility.
# papercut-portal-pr-venue-stubs-still-say-lastgit-20260923
if [ "$venue" = "lastgit" ] && [ "${LAST_STACK_LASTGIT_ENABLED:-}" != "1" ]; then
  ignored_venue="lastgit"
  ignored_venue_source="$reason"
  echo "LAST_STACK_PR_VENUE: ignoring retired venue 'lastgit' for $repo from $reason${repo_root:+ (root $repo_root)}; LastGit is retired (decision-2026-09-29-retire-lastgit-all-repos-to-github). Set LAST_STACK_LASTGIT_ENABLED=1 to honor it." >&2
  venue=""
  reason=""
fi

list_contains_repo() {
  haystack="$1"
  old_ifs=$IFS
  IFS=', '
  for item in $haystack; do
    if [ "$item" = "$repo" ]; then
      IFS=$old_ifs
      return 0
    fi
  done
  IFS=$old_ifs
  return 1
}

# LAST_STACK_LASTGIT_NATIVE_REPOS is ignored: LastGit is retired
# (decision-2026-09-29-retire-lastgit-all-repos-to-github), so no env list can
# bring it back. An explicit `lastgit` marker or git config is ignored too,
# unless LAST_STACK_LASTGIT_ENABLED=1 -- see the gate above.

if [ -z "$venue" ] && list_contains_repo "${LAST_STACK_FORGEJO_REPOS:-}"; then
  venue="forgejo"
  reason="env:LAST_STACK_FORGEJO_REPOS"
fi

if [ -z "$venue" ]; then
  case "$repo" in
    # The one repo that stays on the local Forgejo forge (Tom, 2026-09-29):
    # LastGit hosts itself there. Every other repo is on GitHub.
    EdgeVector/lastgit)
      venue="forgejo"
      reason="default:forgejo-lastgit-repo"
      ;;
    # Everything else, moved or unknown, is a GitHub repo. History: all repos
    # moved to Forgejo on 2026-09-06 and to LastGit era 3 on 2026-09-26; both
    # were retired by decision-2026-09-29-retire-lastgit-all-repos-to-github.
    # The last repo (last-stack) moved on 2026-09-30.
    *)
      venue="github"
      reason="default:github"
      ;;
  esac
fi

configured_slug="$(repo_config laststack.lastgit-slug)"
if [ -n "$configured_slug" ]; then
  default_slug="$configured_slug"
fi

configured_context="$(repo_config laststack.lastgit-ci-context)"
if [ -n "$configured_context" ]; then
  ci_context="$configured_context"
fi

compare_ref="$(canonical_compare_ref)"

# "" when no root was passed -- there is nothing to validate, which is a
# different statement from a root that was checked and refused.
case "$root_identifies_repo" in
  yes) root_identifies_repo_json=true ;;
  no)  root_identifies_repo_json=false ;;
  *)   root_identifies_repo_json="" ;;
esac

if [ "$mode" = json ]; then
  jq -n \
    --arg repo "$repo" \
    --arg repo_root "$repo_root" \
    --arg venue "$venue" \
    --arg lastgit_slug "$default_slug" \
    --arg ci_context "$ci_context" \
    --arg reason "$reason" \
    --arg compare_ref "$compare_ref" \
    --arg ignored_venue "$ignored_venue" \
    --arg ignored_venue_source "$ignored_venue_source" \
    --arg root_identifies_repo "$root_identifies_repo_json" \
    --arg ignored_root "$ignored_root" \
    --arg ignored_root_venue "$ignored_root_venue" \
    --arg ignored_root_venue_source "$ignored_root_venue_source" \
    '{repo:$repo, repo_root:$repo_root, venue:$venue, lastgit_slug:$lastgit_slug, ci_context:$ci_context, reason:$reason, compare_ref:$compare_ref, ignored_venue:$ignored_venue, ignored_venue_source:$ignored_venue_source, root_identifies_repo:$root_identifies_repo, ignored_root:$ignored_root, ignored_root_venue:$ignored_root_venue, ignored_root_venue_source:$ignored_root_venue_source}'
elif [ "$mode" = compare_ref ]; then
  if [ -z "$compare_ref" ]; then
    if [ -n "$repo_root" ] && [ "$root_identifies_repo" != yes ]; then
      echo "LAST_STACK_PR_VENUE: refusing a comparison ref for $repo: root $repo_root does not identify it, so its refs belong to another repo" >&2
    else
      echo "LAST_STACK_PR_VENUE: no comparison ref found for $repo" >&2
    fi
    exit 1
  fi
  printf '%s\n' "$compare_ref"
else
  printf '%s\n' "$venue"
fi
