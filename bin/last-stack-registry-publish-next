#!/usr/bin/env bash
# Write one candidate set's proved rows to the registry `next` channel.
#
# Input: the candidate set the smoke installed (last-stack-canary-candidate-set)
# and the smoke's JSON verdict. Output: one change on the tap repo
# (EdgeVector/homebrew-lastdb) that adds a compat row per app to
# registry/next.json, writes registry/proofs/<proof_run>.json, re-signs the
# index, and arms auto-merge. The tap's CI checks the digest and the proof
# record, then merges; the GitHub mirror serves the file to `lastdb app resolve`.
#
# Venue: since 2026-09-30 the tap's gate of record is GitHub
# (EdgeVector/homebrew-lastdb, decision-2026-09-29-retire-lastgit-all-repos-to-github).
# The LastGit and Forgejo copies are frozen: a row merged there never reaches
# `lastdb app resolve`. The default venue is therefore `github` (push the row
# branch, `gh pr create`, `gh pr merge --squash --auto`; branch protection on
# main requires `ci-required`, and enforce_admins blocks a direct push to main).
# LAST_STACK_REGISTRY_TAP_VENUE=forgejo keeps the frozen Forgejo path for tests.
# LastGit is retired: there is no LastGit CR path.
#
# Nothing here touches the primary node.
#
# GREEN path (unchanged): every app in the candidate set gets a row.
#
# RED, per-app-isolated path: a RED verdict used to zero out every app in the
# set, even one that never touched the failing check (2026-09-28: one missing
# ~/Library/LaunchAgents dir in the smoke's isolated HOME broke install-apps
# for 6 of 9 apps; brain, kanban, situations passed every check of their own
# and still got no row). The smoke's `fails[]` array names each failed check
# (`install-apps:<app>:<mode>`, `cli:<app>=...`, `<app>:<check>` for the
# per-app CLI probes) or a shared/cross-cutting one (`prereq:*`, `setup`,
# `daemon:*`, `health:*`, `brew-service:*`, `resolver:*`, `install-apps
# missing`) that says the isolated node itself, or its install pipeline as a
# whole, never came up — in that case the proof is worthless for every app
# and this script writes zero rows, exactly as before. When every failure
# attributes to a named app, rows are written only for the apps in the
# candidate set with zero fails under their own name. This is a strictly
# NARROWER gate than GREEN-only: it can only shrink the row set, never write
# a row for an app that failed one of its own checks.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

FORGE_ROOT_URL="${FORGE_ROOT_URL:-http://localhost:3300}"
TAP_REPO="${LAST_STACK_REGISTRY_TAP_REPO:-EdgeVector/homebrew-lastdb}"
TAP_VENUE="${LAST_STACK_REGISTRY_TAP_VENUE:-github}"   # github | forgejo
GH_BIN="${GH_BIN:-gh}"
TAP_CI_CONTEXT="${LAST_STACK_REGISTRY_TAP_CI_CONTEXT:-ci-required}"
case "$TAP_VENUE" in
  github) TAP_URL="${LAST_STACK_REGISTRY_TAP_URL:-https://github.com/$TAP_REPO.git}" ;;
  forgejo) TAP_URL="${LAST_STACK_REGISTRY_TAP_URL:-$FORGE_ROOT_URL/$TAP_REPO.git}" ;;
  *) printf 'last-stack-registry-publish-next: LAST_STACK_REGISTRY_TAP_VENUE must be github or forgejo, not %s\n' "$TAP_VENUE" >&2; exit 2 ;;
esac
TAP_DIR="${LAST_STACK_REGISTRY_TAP_DIR:-$HOME/.local/state/last-stack/registry-tap}"
SIGNING_KEY="${LASTDB_REGISTRY_SIGNING_KEY:-$HOME/.lastdb/registry-index-signing.key}"
FORGE_API="${FORGE_API_BIN:-$ROOT/bin/last-stack-forge-api}"
FORGE_GIT="${FORGE_GIT_BIN:-$ROOT/bin/last-stack-forge-git}"
CHANNEL=next
DRY_RUN=0
CANDIDATE_SET=""
PROOF_JSON=""
PROOF_RUN=""
RUN_ID=""
LASTDB_BIN_OVERRIDE=""
STRICT_GREEN=0
# The 9 apps the candidate set and the smoke both know about. Overridable for
# tests against a synthetic candidate set; the production caller never sets
# this, so it always uses the real roster.
KNOWN_APPS="${LAST_STACK_REGISTRY_KNOWN_APPS:-brain kanban situations routines dogfood-graph org lastsecrets search lastdb-browser}"

usage() {
  cat <<'USAGE'
last-stack-registry-publish-next --candidate-set FILE --proof FILE [--proof-run ID] [--run-id ID] [--dry-run]

Adds one compat row per app in the candidate set to registry/next.json on the
tap repo, records the proof, signs, and opens an auto-merging change: a GitHub
PR (default, the tap's gate of record since 2026-09-30) or, for tests, a
Forgejo PR.

  --candidate-set FILE  output of last-stack-canary-candidate-set
  --proof FILE          the smoke's JSON verdict. GREEN proves every app in
                         the candidate set. A RED verdict whose fails[] all
                         attribute to named apps (see below) proves the
                         remaining apps only; a RED verdict with any
                         shared/cross-cutting fail proves nothing, same as
                         before.
  --proof-run ID        proof record name (default: llms-smoke-<UTC>-<build>)
  --run-id ID           the CI run id behind the proof; it goes into the row
                         branch name so two publishes never share a branch
                         (default: none; the process id still separates them)
  --lastdb-bin PATH     lastdb used to sign (default: $LASTDB_BIN, then PATH)
  --dry-run             write the rows in a scratch clone; no push, no PR
  --strict-green        require verdict GREEN, exactly like before per-app
                         attribution existed; a RED proof of any shape dies

Env: LAST_STACK_REGISTRY_TAP_VENUE (github|forgejo, default github),
     GH_BIN,
     LAST_STACK_REGISTRY_TAP_URL, LAST_STACK_REGISTRY_TAP_DIR,
     LAST_STACK_REGISTRY_TAP_CI_CONTEXT, LASTDB_REGISTRY_SIGNING_KEY (default
     ~/.lastdb/registry-index-signing.key),
     LAST_STACK_REGISTRY_KNOWN_APPS (space-separated, for tests)

Per-app attribution of a RED proof's fails[] entries:
  install-apps:<app>:<mode> ...   -> <app>
  cli:<app>=... / cli:<app> ...   -> <app>
  <app>:<check> ...               -> <app>  (only when <app> is a known app)
  anything else (prereq:*, setup, daemon:*, health:*, brew-service:*,
  resolver:*, install-apps missing, a bare {"verdict":"RED","reason":...}
  proof with no fails[] at all) -> shared: the isolated node or its install
  pipeline never came up, so the proof is worthless for every app.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --candidate-set) CANDIDATE_SET="$2"; shift 2 ;;
    --proof) PROOF_JSON="$2"; shift 2 ;;
    --proof-run) PROOF_RUN="$2"; shift 2 ;;
    --run-id) RUN_ID="$2"; shift 2 ;;
    --lastdb-bin) LASTDB_BIN_OVERRIDE="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --strict-green) STRICT_GREEN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

die() { printf 'last-stack-registry-publish-next: %s\n' "$*" >&2; exit 1; }
case "$RUN_ID" in *[!A-Za-z0-9._-]*) die "--run-id must be [A-Za-z0-9._-]: $RUN_ID" ;; esac
[ -n "$CANDIDATE_SET" ] && [ -f "$CANDIDATE_SET" ] || die "--candidate-set FILE is required"
[ -n "$PROOF_JSON" ] && [ -f "$PROOF_JSON" ] || die "--proof FILE is required"
command -v jq >/dev/null 2>&1 || die "jq is required"
[ -f "$SIGNING_KEY" ] || die "signing key not found at $SIGNING_KEY"

RED_ATTRIBUTION_BIN="${LAST_STACK_REGISTRY_RED_ATTRIBUTION_BIN:-$ROOT/bin/last-stack-registry-red-attribution}"
verdict="$(jq -r '.verdict // empty' "$PROOF_JSON")"
PASSED_APPS=""
PARTIAL=0
if [ "$verdict" = GREEN ]; then
  : # every app in the candidate set is proved, exactly as before
elif [ "$STRICT_GREEN" -eq 1 ]; then
  die "proof verdict is '${verdict:-absent}', not GREEN; --strict-green requires GREEN"
else
  # Delegate the fails[] -> app-or-shared classification to a standalone,
  # separately fixture-tested helper (tests/last-stack-registry-red-attribution.sh)
  # rather than re-deriving it here. See that script for the attribution rules.
  attribution="$(LAST_STACK_REGISTRY_KNOWN_APPS="$KNOWN_APPS" "$RED_ATTRIBUTION_BIN" --proof "$PROOF_JSON")"
  shared_fail="$(printf '%s\n' "$attribution" | sed -n 's/^shared_fail=//p')"
  attributed_apps="$(printf '%s\n' "$attribution" | sed -n 's/^failed_apps=//p')"
  PASSED_APPS="$(printf '%s\n' "$attribution" | sed -n 's/^passed_apps=//p')"

  if [ "$shared_fail" != 0 ]; then
    die "proof verdict is RED with a shared/cross-cutting fail (the isolated node or its install pipeline did not come up); rows are written for no app. fails: $(jq -c '.fails // .reason // empty' "$PROOF_JSON")"
  fi
  [ -n "$PASSED_APPS" ] || die "proof verdict is RED and every known app failed its own check; rows are written for no app"
  PARTIAL=1
  printf 'last-stack-registry-publish-next: RED proof, per-app isolated: failed=[%s] passed=[%s]\n' \
    "$attributed_apps" "$PASSED_APPS" >&2
fi
build="$(jq -r '.lastdb.build // empty' "$CANDIDATE_SET")"
[ -n "$build" ] || die "candidate set has no lastdb.build"
proof_build="$(jq -r '.lastdb_build // empty' "$PROOF_JSON")"
if [ -n "$proof_build" ] && [ "$proof_build" != "$build" ]; then
  die "proof names lastdb $proof_build but the candidate set is $build"
fi
proved_at="$(jq -r '.proved_at // empty' "$PROOF_JSON")"
[ -n "$proved_at" ] || proved_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ -z "$PROOF_RUN" ]; then
  PROOF_RUN="llms-smoke-$(date -u +%Y%m%dT%H%M%SZ)-$(printf '%s' "$build" | tr -c 'A-Za-z0-9.-' '_')"
fi

if [ -n "$LASTDB_BIN_OVERRIDE" ]; then
  export LASTDB_BIN="$LASTDB_BIN_OVERRIDE"
fi
lastdb_for_sign="${LASTDB_BIN:-$(command -v lastdb || true)}"
[ -n "$lastdb_for_sign" ] || die "no lastdb binary to sign with (set LASTDB_BIN)"
"$lastdb_for_sign" app index sign --help >/dev/null 2>&1 || die "$lastdb_for_sign has no \`app index sign\`; point LASTDB_BIN at a build that does"

# Fresh tap checkout on main. A stale clone would rebase onto old rows.
# Unattended git against the local forge has no keychain prompt to answer;
# hand it the forge token the way last-stack-forge-git does.
case "$TAP_URL" in
  http://localhost:3300/*|http://127.0.0.1:3300/*)
    if [ -r "$ROOT/lib/forge-token.sh" ]; then
      # shellcheck source=../lib/forge-token.sh
      . "$ROOT/lib/forge-token.sh"
      last_stack_forge_export_git_config 2>/dev/null || true
    fi ;;
esac
if [ "$DRY_RUN" -eq 1 ]; then
  TAP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/registry-tap-dry.XXXXXX")"
  trap 'rm -rf "$TAP_DIR"' EXIT
fi
if [ -d "$TAP_DIR/.git" ]; then
  # Follow the venue: a checkout cloned from the frozen Forgejo copy would
  # rebase onto rows that stopped moving at the era-3 cutover.
  if [ "$(git -C "$TAP_DIR" remote get-url origin 2>/dev/null || true)" != "$TAP_URL" ]; then
    git -C "$TAP_DIR" remote set-url origin "$TAP_URL"
  fi
  git -C "$TAP_DIR" fetch --quiet origin main
  git -C "$TAP_DIR" checkout --quiet -B main origin/main
  git -C "$TAP_DIR" reset --quiet --hard origin/main
else
  rm -rf "$TAP_DIR"
  git clone --quiet "$TAP_URL" "$TAP_DIR"
fi
# The process id keeps two publishes of one build in the same second on distinct
# branches (the second push was refused non-fast-forward; the venue and partial-rows
# tests hit it on fast runners).
# A CI run id (--run-id) is unique across runners and hosts, so it goes in too:
# a proof applied twice, or two builds applied in one second, never share a branch
# (papercut-last-stack-registry-publish-next-row-branch-same-second-collision-20260930).
branch="registry/next-$(printf '%s' "$build" | tr -c 'A-Za-z0-9.-' '_')-$(date -u +%Y%m%dT%H%M%SZ)${RUN_ID:+-$RUN_ID}-$$"
git -C "$TAP_DIR" checkout --quiet -b "$branch"

index="$TAP_DIR/registry/$CHANNEL.json"
[ -f "$index" ] || die "$index is missing on the tap; land the registry scaffold first"
mkdir -p "$TAP_DIR/registry/proofs"

api_version="$(jq -r '.lastdb.api_version // empty' "$CANDIDATE_SET")"
count=0
while IFS=$'\t' read -r app sha app_version source description; do
  [ -n "$app" ] || continue
  if [ "$PARTIAL" -eq 1 ]; then
    case " $PASSED_APPS " in
      *" $app "*) ;;
      *) continue ;;  # this app's own check failed; no row for it
    esac
  fi
  args=(add-row --index "$index" --channel "$CHANNEL" --app "$app" --source "$source"
        --app-version "$app_version" --sha "$sha" --lastdb-version "$build"
        --proved-at "$proved_at" --proof-run "$PROOF_RUN")
  [ -z "$description" ] || args+=(--description "$description")
  [ -z "$api_version" ] || args+=(--lastdb-api-version "$api_version")
  "$ROOT/bin/last-stack-registry-index" "${args[@]}"
  count=$((count + 1))
done < <(jq -r '.apps | to_entries[] | [.key, .value.sha, (.value.app_version // "0.0.0"), .value.source, (.value.description // "")] | @tsv' "$CANDIDATE_SET")
[ "$count" -gt 0 ] || die "candidate set has no apps that passed their own checks"

# The proof record: what was proved, with what, by which run. On a partial
# (RED, per-app-isolated) proof, apps_proved names exactly the rows written
# above, so a reader of the tap history can tell a full GREEN proof from a
# narrower one without re-deriving the attribution.
jq -n --arg run "$PROOF_RUN" --arg build "$build" --arg at "$proved_at" --arg channel "$CHANNEL" \
  --arg partial "$PARTIAL" --arg passed "$PASSED_APPS" \
  --slurpfile set "$CANDIDATE_SET" --slurpfile proof "$PROOF_JSON" \
  '{proof_run: $run, kind: "llms-txt-install-smoke", channel: $channel, lastdb_build: $build, proved_at: $at,
    partial: ($partial == "1"),
    apps_proved: (if $partial == "1" then ($passed | split(" ") | map(select(length > 0))) else null end),
    candidate_set: ($set[0] | {created_at, lastdb, apps: (.apps | with_entries(.value |= {sha, app_version, source}))}),
    verdict: ($proof[0] | {verdict, pass, fails, sandbox})}' >"$TAP_DIR/registry/proofs/$PROOF_RUN.json"

"$ROOT/bin/last-stack-registry-index" sign --index "$index" --key-file "$SIGNING_KEY" --lastdb-bin "$lastdb_for_sign"
"$lastdb_for_sign" app index verify --index "$index" >/dev/null

commit_subject="registry(next): lastdb $build + $count apps proved by $PROOF_RUN"
if [ "$PARTIAL" -eq 1 ]; then
  # KNOWN_APPS is deliberately unquoted here so `set --` splits it on spaces.
  # shellcheck disable=SC2086
  known_count=$(set -- $KNOWN_APPS; echo "$#")
  commit_subject="registry(next): lastdb $build + $count/$known_count apps (partial) proved by $PROOF_RUN"
fi
git -C "$TAP_DIR" add registry
if [ "$PARTIAL" -eq 1 ]; then
  git -C "$TAP_DIR" -c user.name="last-stack canary" -c user.email="canary@edgevector.local" commit --quiet -F - <<EOF
$commit_subject

The isolated llms-txt install smoke was RED, but every fail attributed to a
named app's own check (none was shared/cross-cutting), so the apps that
passed every check of their own are proved pairs with lastdb $build. Rows
land on \`next\` for those apps only; \`stable\` waits for the human publish
command.

Apps proved: $PASSED_APPS

Proof: registry/proofs/$PROOF_RUN.json
EOF
else
  git -C "$TAP_DIR" -c user.name="last-stack canary" -c user.email="canary@edgevector.local" commit --quiet -F - <<EOF
$commit_subject

The isolated llms-txt install smoke passed on this candidate set, so each
app commit in it is a proved pair with lastdb $build. Rows land on \`next\`;
\`stable\` waits for the human publish command.

Proof: registry/proofs/$PROOF_RUN.json
EOF
fi

if [ "$DRY_RUN" -eq 1 ]; then
  printf 'REGISTRY_NEXT status=dry-run build=%s apps=%s proof_run=%s dir=%s\n' "$build" "$count" "$PROOF_RUN" "$TAP_DIR"
  git -C "$TAP_DIR" show --stat HEAD | head -20
  exit 0
fi

if [ "$TAP_VENUE" = github ]; then
  command -v "$GH_BIN" >/dev/null 2>&1 || die "gh CLI not found ($GH_BIN); set GH_BIN"
  git -C "$TAP_DIR" push --quiet origin "$branch:$branch"
  if [ "$PARTIAL" -eq 1 ]; then
    body_text="$(jq -rn --arg build "$build" --arg run "$PROOF_RUN" --arg n "$count" --arg passed "$PASSED_APPS" \
      '"## What\n\n`registry/next.json`: " + $n + " compat rows proved with lastdb `" + $build + "` by `" + $run + "` (partial: the smoke was RED, but every fail attributed to a named app, and these apps had none). Apps proved: `" + $passed + "`. Proof record: `registry/proofs/" + $run + ".json`.\n\nWritten by the canary lane. `stable` is untouched.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)"')"
  else
    body_text="$(jq -rn --arg build "$build" --arg run "$PROOF_RUN" --arg n "$count" \
      '"## What\n\n`registry/next.json`: " + $n + " compat rows proved with lastdb `" + $build + "` by `" + $run + "`. Proof record: `registry/proofs/" + $run + ".json`.\n\nWritten by the canary lane after the isolated llms-txt install smoke passed on this candidate set. `stable` is untouched.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)"')"
  fi
  body_file="$(mktemp "${TMPDIR:-/tmp}/registry-next-body.XXXXXX")"
  printf '%s\n' "$body_text" >"$body_file"
  pr_url="$("$GH_BIN" pr create --repo "$TAP_REPO" --base main --head "$branch" \
    --title "$commit_subject" --body-file "$body_file")" || die "gh pr create failed for $TAP_REPO $branch"
  pr_number="${pr_url##*/}"
  case "$pr_number" in ''|*[!0-9]*) die "gh pr create returned no PR number: $pr_url" ;; esac
  "$GH_BIN" pr merge "$pr_number" --repo "$TAP_REPO" --squash --auto --delete-branch >/dev/null \
    || printf 'last-stack-registry-publish-next: PR %s opened; auto-merge not armed\n' "$pr_number" >&2
  printf 'REGISTRY_NEXT status=pr build=%s apps=%s proof_run=%s pr=%s/%s\n' "$build" "$count" "$PROOF_RUN" "$TAP_REPO" "$pr_number"
  exit 0
fi

if [ -x "$FORGE_GIT" ]; then
  "$FORGE_GIT" -C "$TAP_DIR" push --quiet -u origin "$branch"
else
  git -C "$TAP_DIR" push --quiet -u origin "$branch"
fi
[ -x "$FORGE_API" ] || die "forge api helper missing at $FORGE_API"
if [ "$PARTIAL" -eq 1 ]; then
  body="$(jq -n --arg build "$build" --arg run "$PROOF_RUN" --arg n "$count" --arg passed "$PASSED_APPS" \
    '"## What\n\n`registry/next.json`: " + $n + " compat rows proved with lastdb `" + $build + "` by `" + $run + "` (partial: the smoke was RED, but every fail attributed to a named app, and these apps had none). Apps proved: `" + $passed + "`. Proof record: `registry/proofs/" + $run + ".json`.\n\nWritten by the nightly canary lane. `stable` is untouched.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)"')"
else
  body="$(jq -n --arg build "$build" --arg run "$PROOF_RUN" --arg n "$count" \
    '"## What\n\n`registry/next.json`: " + $n + " compat rows proved with lastdb `" + $build + "` by `" + $run + "`. Proof record: `registry/proofs/" + $run + ".json`.\n\nWritten by the nightly canary lane after the isolated llms-txt install smoke passed on this candidate set. `stable` is untouched.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)"')"
fi
pr_json="$(jq -n --arg t "$commit_subject" --arg h "$branch" --arg b "$body" \
  '{title:$t, head:$h, base:"main", body:$b}')"
pr_number="$("$FORGE_API" POST --data "$pr_json" "repos/$TAP_REPO/pulls" --jq '.number')"
[ -n "$pr_number" ] && [ "$pr_number" != null ] || die "PR create returned no number"
"$FORGE_API" POST --data '{"Do":"merge","merge_when_checks_succeed":true,"delete_branch_after_merge":true}' \
  "repos/$TAP_REPO/pulls/$pr_number/merge" >/dev/null || true
printf 'REGISTRY_NEXT status=pr build=%s apps=%s proof_run=%s pr=%s/%s\n' "$build" "$count" "$PROOF_RUN" "$TAP_REPO" "$pr_number"
