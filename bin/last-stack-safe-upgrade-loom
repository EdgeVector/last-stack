#!/usr/bin/env bash
# Start or resume the Loom lastdb-safe-upgrade graph. No soak. No promotion.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"
# shellcheck source=../lib/canary-loom/loom-run-deadline.sh
. "$ROOT/lib/canary-loom/loom-run-deadline.sh"
export_loom_run_deadline_for lastdb-safe-upgrade

KEY=""
RETRY=""
CAND=""
CAND_CLI=""
SOURCE_OID=""
STAND_IN=0
DRY_RUN=0
AS_JSON=0
SAFE_UPGRADE_PROTOCOL_VERSION="6"
LOCAL_RECOVERY=0
LOCAL_RECOVERY_DIR="${LAST_STACK_LOOM_LOCAL_RECOVERY_DIR:-$HOME/.local/state/last-stack/loom/recovery}"
CONTROL_PLANE="lastdb"

usage() {
  cat <<'EOF'
Usage:
  last-stack-safe-upgrade-loom --candidate PATH [--source-git-oid OID] [--json]
  last-stack-safe-upgrade-loom --dry-run --candidate PATH [--source-git-oid OID] [--json]
  last-stack-safe-upgrade-loom --candidate PATH --retry N [--json]

The launcher derives one immutable execution key from a SHA-256 digest of the
source OID, canonical pair paths, binary hashes, and binary versions.
It refuses live use when source ancestry cannot be identified.

--retry N (N >= 2) runs attempt N of the SAME candidate pair under the key
<key>-retry-N. Use it after a terminal-failed execution whose cause was fixed
outside the candidate (for example a DEV photograph 500). Without it the
pair's key resumes the failed execution. The attempt number is in the input
and in the --json receipt.
EOF
}

die() {
  printf 'last-stack-safe-upgrade-loom: %s\n' "$*" >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --key) KEY="${2:-}"; shift 2 ;;
    --retry) RETRY="${2:-}"; shift 2 ;;
    --candidate) CAND="${2:-}"; shift 2 ;;
    --source-git-oid) SOURCE_OID="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --json) AS_JSON=1; shift ;;
    --no-heal|--stand-in) STAND_IN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

canonical_file() {
  python3 - "$1" <<'PY'
import os
import sys

print(os.path.realpath(sys.argv[1]))
PY
}

if [ "$STAND_IN" -eq 0 ]; then
  [ -n "$CAND" ] || die "--candidate is required"
  [ -x "$CAND" ] || die "candidate is not executable: $CAND"
  CAND="$(canonical_file "$CAND")"
  CAND_CLI="$(dirname -- "$CAND")/lastdb"
  [ -x "$CAND_CLI" ] || die "candidate sibling lastdb is not executable: $CAND_CLI"
  CAND_CLI="$(canonical_file "$CAND_CLI")"
  [ "$(dirname -- "$CAND_CLI")" = "$(dirname -- "$CAND")" ] \
    && [ "$(basename -- "$CAND_CLI")" = "lastdb" ] \
    || die "candidate sibling lastdb must be a real file beside lastdbd"
fi

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    die "shasum or sha256sum is required"
  fi
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    die "shasum or sha256sum is required"
  fi
}

candidate_version="stand-in"
candidate_cli_version="stand-in"
candidate_daemon_sha256="stand-in"
candidate_cli_sha256="stand-in"
if [ "$STAND_IN" -eq 0 ]; then
  candidate_version="$("$CAND" --version 2>/dev/null | awk '{print $NF}' || true)"
  [ -n "$candidate_version" ] || die "candidate version is unreadable"
  candidate_cli_version="$("$CAND_CLI" --version 2>/dev/null | awk '{print $NF}' || true)"
  [ -n "$candidate_cli_version" ] || die "candidate sibling lastdb version is unreadable"
  [ "$candidate_cli_version" = "$candidate_version" ] \
    || die "candidate pair version mismatch: lastdbd=$candidate_version lastdb=$candidate_cli_version"
  candidate_daemon_sha256="$(sha256_file "$CAND")"
  candidate_cli_sha256="$(sha256_file "$CAND_CLI")"
  printf '%s\n' "$candidate_daemon_sha256" | grep -Eq '^[0-9a-f]{64}$' \
    || die "candidate daemon SHA-256 calculation failed"
  printf '%s\n' "$candidate_cli_sha256" | grep -Eq '^[0-9a-f]{64}$' \
    || die "candidate CLI SHA-256 calculation failed"
fi

read_manifest_oid() {
  local path="$1" candidate="" value=""
  for candidate in \
    "$(dirname "$path")/manifest.json" \
    "$(dirname "$path")/lastdb-aarch64-apple-darwin.manifest.json" \
    "$(dirname "$(dirname "$path")")/manifest.json" \
    "$(dirname "$(dirname "$path")")/lastdb-aarch64-apple-darwin.manifest.json"
  do
    [ -f "$candidate" ] || continue
    value="$(jq -r '.source_git_oid // .git_oid // empty' "$candidate" 2>/dev/null || true)"
    [ -n "$value" ] && { printf '%s\n' "$value"; return 0; }
  done
  return 1
}

if [ "$STAND_IN" -eq 1 ]; then
  SOURCE_OID="stand-in"
elif [ -z "$SOURCE_OID" ]; then
  SOURCE_OID="$(read_manifest_oid "$CAND" || true)"
fi
if [ "$STAND_IN" -eq 0 ] && [ -z "$SOURCE_OID" ]; then
  SOURCE_OID="$(printf '%s\n' "$candidate_version" | sed -n 's/.*-g\([0-9a-fA-F][0-9a-fA-F]*\).*/\1/p')"
fi

fold_git="${LASTDB_SAFE_UPGRADE_FOLD_GIT_DIR:-$HOME/.cache/edgevector-git/fold.git}"
if [ "$STAND_IN" -eq 0 ]; then
  case "$SOURCE_OID" in
    ''|*[!0-9a-fA-F]*) die "candidate source Git OID is required" ;;
  esac
  [ "${#SOURCE_OID}" -ge 7 ] && [ "${#SOURCE_OID}" -le 40 ] \
    || die "candidate source Git OID must contain 7 to 40 hexadecimal characters"
  if [ "${#SOURCE_OID}" -lt 40 ]; then
    [ -d "$fold_git" ] || die "Fold mirror is required to resolve short source OID $SOURCE_OID"
    SOURCE_OID="$(git -C "$fold_git" rev-parse --verify "${SOURCE_OID}^{commit}" 2>/dev/null || true)"
  fi
  printf '%s\n' "$SOURCE_OID" | grep -Eq '^[0-9a-fA-F]{40}$' \
    || die "candidate source Git OID does not resolve to one commit"
  SOURCE_OID="$(printf '%s' "$SOURCE_OID" | tr 'A-F' 'a-f')"
fi

candidate_artifact_digest="$(printf '%s\0%s\0%s\0%s\0%s\0%s\0%s' \
  "$SOURCE_OID" \
  "$CAND" \
  "$CAND_CLI" \
  "$candidate_daemon_sha256" \
  "$candidate_cli_sha256" \
  "$candidate_version" \
  "$candidate_cli_version" \
  | sha256_stream)"
printf '%s\n' "$candidate_artifact_digest" | grep -Eq '^[0-9a-f]{64}$' \
  || die "candidate artifact digest calculation failed"

expected_key="safe-upgrade-v${SAFE_UPGRADE_PROTOCOL_VERSION}-${candidate_artifact_digest}"
# A retry of the same pair gets its own execution: the pair's key would
# resume the terminal-failed one
# (papercut-safe-upgrade-failed-execution-blocks-retry-of-same-candidate-20260922).
ATTEMPT=1
if [ -n "${RETRY:-}" ]; then
  case "$RETRY" in
    ''|*[!0-9]*) die "--retry needs an attempt number >= 2" ;;
  esac
  [ "$RETRY" -ge 2 ] || die "--retry needs an attempt number >= 2"
  ATTEMPT="$RETRY"
  expected_key="${expected_key}-retry-${RETRY}"
fi
if [ -n "$KEY" ] && [ "$KEY" != "$expected_key" ]; then
  die "--key must equal $expected_key so different candidates cannot share one execution"
fi
KEY="$expected_key"

input="$(jq -cn \
  --arg candidate "$CAND" \
  --arg candidate_cli "$CAND_CLI" \
  --arg version "$candidate_version" \
  --arg lastdbd_version "$candidate_version" \
  --arg lastdb_version "$candidate_cli_version" \
  --arg lastdbd_sha256 "$candidate_daemon_sha256" \
  --arg lastdb_sha256 "$candidate_cli_sha256" \
  --arg source_git_oid "$SOURCE_OID" \
  --arg candidate_artifact_digest "$candidate_artifact_digest" \
  --arg safe_upgrade_protocol_version "$SAFE_UPGRADE_PROTOCOL_VERSION" \
  --argjson attempt "$ATTEMPT" \
  '{candidate:$candidate,candidate_cli:$candidate_cli,version:$version,lastdbd_version:$lastdbd_version,lastdb_version:$lastdb_version,lastdbd_sha256:$lastdbd_sha256,lastdb_sha256:$lastdb_sha256,source_git_oid:$source_git_oid,candidate_artifact_digest:$candidate_artifact_digest,safe_upgrade_protocol_version:$safe_upgrade_protocol_version} + (if $attempt > 1 then {attempt:$attempt} else {} end)')"

emit_json() {
  local outcome="$1" status="$2" state="$3" execution="$4"
  jq -cn \
    --arg outcome "$outcome" \
    --arg status "$status" \
    --arg state "$state" \
    --arg execution "$execution" \
    --arg key "$KEY" \
    --arg candidate "$CAND" \
    --arg candidate_cli "$CAND_CLI" \
    --arg version "$candidate_version" \
    --arg lastdbd_version "$candidate_version" \
    --arg lastdb_version "$candidate_cli_version" \
    --arg lastdbd_sha256 "$candidate_daemon_sha256" \
    --arg lastdb_sha256 "$candidate_cli_sha256" \
    --arg source_git_oid "$SOURCE_OID" \
    --arg candidate_artifact_digest "$candidate_artifact_digest" \
    --arg safe_upgrade_protocol_version "$SAFE_UPGRADE_PROTOCOL_VERSION" \
    --arg control_plane "$CONTROL_PLANE" \
    --argjson attempt "$ATTEMPT" \
    '{attempt:$attempt,outcome:$outcome,status:$status,state:$state,execution:$execution,key:$key,candidate:$candidate,candidate_cli:$candidate_cli,version:$version,lastdbd_version:$lastdbd_version,lastdb_version:$lastdb_version,lastdbd_sha256:$lastdbd_sha256,lastdb_sha256:$lastdb_sha256,source_git_oid:$source_git_oid,candidate_artifact_digest:$candidate_artifact_digest,safe_upgrade_protocol_version:$safe_upgrade_protocol_version,control_plane:$control_plane,graph:"lastdb-safe-upgrade"}'
}

if [ "$DRY_RUN" -eq 1 ]; then
  if [ "$AS_JSON" -eq 1 ]; then
    emit_json "noop" "dry-run" "PROBE" ""
  else
    printf 'last-stack-safe-upgrade-loom dry-run graph=lastdb-safe-upgrade key=%s source_git_oid=%s\n' "$KEY" "$SOURCE_OID"
  fi
  exit 0
fi

command -v loom >/dev/null 2>&1 || die "loom is not installed"

exe="$(command -v loom)"
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$exe")"
install_root="$(dirname "$(dirname "$real")")"
defs=""
scripts=""
for candidate in "${LOOM_DEFS:-}" "$ROOT/lib/canary-loom" "$install_root/definitions"; do
  [ -n "$candidate" ] && [ -f "$candidate/lastdb-safe-upgrade.json" ] && defs="$candidate" && break
done
for candidate in "${LOOM_SCRIPTS:-}" "$ROOT/lib/canary-loom" "$install_root/scripts"; do
  [ -n "$candidate" ] && [ -f "$candidate/loom-safe-upgrade-step.sh" ] && scripts="$candidate" && break
done
[ -n "$defs" ] && [ -n "$scripts" ] || die "lastdb-safe-upgrade graph files are missing"

export LOOM_SCRIPTS="$scripts"
if [ "$STAND_IN" -eq 1 ]; then
  unset LOOM_LIVE LOOM_CANARY_LIVE || true
else
  export LOOM_LIVE=1 LOOM_CANARY_LIVE=1
fi

if ! loom ping >/dev/null 2>&1; then
  LOCAL_RECOVERY=1
else
  set +e
  probe_json="$(loom write-probe --json 2>/dev/null)"
  probe_rc=$?
  set -e
  if [ "$probe_rc" -eq 42 ] && printf '%s\n' "$probe_json" | jq -e '.recovery_eligible == true' >/dev/null 2>&1; then
    LOCAL_RECOVERY=1
  elif [ "$probe_rc" -ne 0 ]; then
    die "Loom write probe failed without a recovery authorization: ${probe_json:-no result}"
  fi
fi

if [ "$LOCAL_RECOVERY" -eq 1 ]; then
  CONTROL_PLANE="local-recovery"
  printf 'last-stack-safe-upgrade-loom: control_plane=local-recovery journal=%s\n' \
    "$LOCAL_RECOVERY_DIR/executions.jsonl" >&2
else
  loom validate "$defs/lastdb-safe-upgrade.json" >/dev/null
  loom publish "$defs/lastdb-safe-upgrade.json" >/dev/null
fi

set +e
run_args=(loom run lastdb-safe-upgrade --key "$KEY" --input "$input")
if [ "$LOCAL_RECOVERY" -eq 1 ]; then
  run_args+=(
    --local-recovery
    --definition "$defs/lastdb-safe-upgrade.json"
    --local-recovery-dir "$LOCAL_RECOVERY_DIR"
  )
fi
view="$("${run_args[@]}")"
loom_rc=$?
set -e
execution="$(printf '%s\n' "$view" | awk '/^lx-/{print; exit}')"
status="$(printf '%s\n' "$view" | awk -F': ' '/^status:/{print $2; exit}')"
state="$(printf '%s\n' "$view" | awk -F': ' '/^state:/{print $2; exit}')"

# `loom run` can return the execution view before the terminal status write is
# visible, and — measured 2026-09-20 23:24Z — before the graph is even done:
# the CUTOVER node's deploy effect restarts the primary, `loom run` came back
# with `status: running / state: CUTOVER`, and VERIFY still had ~2 minutes to
# go. A 30 s readback then reported a false red (`Loom safe-upgrade red rc=3`)
# for a cutover that finished GREEN, and the nightly gate stopped before it
# wrote the registry rows. So: while the execution is still `running`, keep
# reading it back for up to LASTDB_SAFE_UPGRADE_LOOM_RUNNING_SECS (default 20
# min, the VERIFY budget); a terminal non-success stops the wait at once.
if [ "$status" != "succeeded" ] && [ -n "$execution" ]; then
  readback_wait_secs="${LASTDB_SAFE_UPGRADE_LOOM_READBACK_SECS:-30}"
  running_wait_secs="${LASTDB_SAFE_UPGRADE_LOOM_RUNNING_SECS:-1200}"
  case "$readback_wait_secs" in
    ''|*[!0-9]*) die "LASTDB_SAFE_UPGRADE_LOOM_READBACK_SECS must be an integer" ;;
  esac
  case "$running_wait_secs" in
    ''|*[!0-9]*) die "LASTDB_SAFE_UPGRADE_LOOM_RUNNING_SECS must be an integer" ;;
  esac
  readback_deadline=$((SECONDS + readback_wait_secs))
  running_deadline=$((SECONDS + running_wait_secs))
  while :; do
    readback="$(loom show "$execution" 2>/dev/null || true)"
    readback_status="$(printf '%s\n' "$readback" | awk -F': ' '/^status:/{print $2; exit}')"
    if [ "$readback_status" = "succeeded" ]; then
      view="$readback"
      loom_rc=0
      status="$readback_status"
      state="$(printf '%s\n' "$readback" | awk -F': ' '/^state:/{print $2; exit}')"
      break
    fi
    if [ "$readback_status" = "running" ]; then
      # Still working (VERIFY after a live cutover). Not a verdict yet.
      if [ "$SECONDS" -ge "$running_deadline" ]; then
        view="$readback"
        status="$readback_status"
        state="$(printf '%s\n' "$readback" | awk -F': ' '/^state:/{print $2; exit}')"
        printf 'last-stack-safe-upgrade-loom: %s still running after %ss; reporting non-green\n' \
          "$execution" "$running_wait_secs" >&2
        break
      fi
      sleep 2
      continue
    fi
    if [ -n "$readback_status" ] && [ "$readback_status" != "succeeded" ]; then
      # A terminal failure. Report it as read; do not wait the readback out.
      view="$readback"
      status="$readback_status"
      state="$(printf '%s\n' "$readback" | awk -F': ' '/^state:/{print $2; exit}')"
      break
    fi
    [ "$SECONDS" -ge "$readback_deadline" ] && break
    sleep 1
  done
fi

outcome="error"
[ "$loom_rc" -eq 0 ] && [ "$status" = "succeeded" ] && outcome="ok"

if [ "$LOCAL_RECOVERY" -eq 1 ] && [ "$outcome" = "ok" ] && loom ping >/dev/null 2>&1; then
  loom reconcile-local "$LOCAL_RECOVERY_DIR/executions.jsonl" --json >/dev/null 2>&1 \
    || printf 'last-stack-safe-upgrade-loom: local receipt remains pending reconciliation\n' >&2
fi

if [ "$AS_JSON" -eq 1 ]; then
  emit_json "$outcome" "${status:-unknown}" "${state:-unknown}" "$execution"
else
  printf '%s\n' "$view"
fi
[ "$outcome" = "ok" ] || exit 3
