#!/usr/bin/env bash
# Install, remove, inspect, or run the hourly Loom reaper LaunchAgent.
set -euo pipefail

self="$0"
self_root="$(cd "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/last-stack-launchd-agent.sh
. "$self_root/lib/last-stack-launchd-agent.sh"

program="last-stack-loom-reaper-run"
label="com.edgevector.loom-reaper"
last_stack="$(last_stack_agent_stable_root "$self" "$program")"
plist_src="$self_root/launchd/${label}.plist"
if [ ! -f "$plist_src" ]; then
  plist_src="$last_stack/launchd/${label}.plist"
fi
plist_dst="${LOOM_REAPER_PLIST:-$HOME/Library/LaunchAgents/${label}.plist}"
cmd="${1:-status}"

install_agent() {
  [ -e "$last_stack/bin/$program" ] || [ -x "$self_root/bin/$program" ] || {
    echo "missing executable: $last_stack/bin/$program" >&2
    exit 1
  }
  [ -f "$plist_src" ] || {
    echo "missing plist: $plist_src" >&2
    exit 1
  }
  mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/last-stack/loom-reaper"
  rendered="$(mktemp "${TMPDIR:-/tmp}/loom-reaper.plist.XXXXXX")"
  last_stack_agent_render_plist "$plist_src" "$rendered" "$last_stack"
  last_stack_agent_commit_plist "$label" "$plist_dst" "$rendered" "loom-reaper"
}

status_agent() {
  echo "runner: $last_stack/bin/$program"
  echo "loom: $HOME/.local/bin/loom"
  echo "result: ${XDG_STATE_HOME:-$HOME/.local/state}/last-stack/loom-reaper/result.json"
  echo "plist: $plist_dst"
  if [ -f "$plist_dst" ]; then
    echo "plist: present"
    prog="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$plist_dst" 2>/dev/null || true)"
    interval="$(/usr/libexec/PlistBuddy -c 'Print :StartInterval' "$plist_dst" 2>/dev/null || true)"
    echo "program: ${prog:-unknown}"
    echo "interval_s: ${interval:-unknown}"
  else
    echo "plist: missing"
  fi
  if last_stack_agent_should_touch_launchd "$plist_dst" \
    && command -v launchctl >/dev/null 2>&1; then
    uid="$(id -u)"
    launchctl print "gui/${uid}/${label}" 2>/dev/null | head -25 \
      || echo "launchctl: not loaded"
  fi
}

case "$cmd" in
  install) install_agent ;;
  uninstall) last_stack_agent_uninstall "$label" "$plist_dst" "loom-reaper" ;;
  status) status_agent ;;
  run-once)
    if [ -x "$last_stack/bin/$program" ]; then
      exec "$last_stack/bin/$program" "${@:2}"
    fi
    exec "$self_root/bin/$program" "${@:2}"
    ;;
  -h|--help) echo "usage: $0 install|uninstall|status|run-once" ;;
  *) echo "usage: $0 install|uninstall|status|run-once" >&2; exit 2 ;;
esac
