#!/usr/bin/env python3
"""Redact secret-shaped values from a text stream.

A routine or agent diagnostic that prints the process environment (``env``,
a CARGO/RUST/FOLD variable listing, a crash dump) writes whatever the shell
exported. On 2026-08-18 that put a raw OpenRouter credential into a run's
stderr log and into a chat transcript
(brain ``papercut-routine-shell-exports-raw-openrouter-secret``).

This filter reads stdin and writes stdout with two redaction passes:

1. **Value pass** - every secret-shaped variable in this process's own
   environment has its literal value replaced wherever it appears, even in
   free prose. This catches a value that reached the stream without its
   variable name attached.
2. **Assignment pass** - ``NAME=VALUE``, ``NAME: VALUE`` and ``"NAME": "VALUE"``
   are redacted whenever NAME is secret-shaped, even if this process does not
   hold that variable. This is what makes the filter useful on a log file
   captured from some other run.

The filter fails closed: when a name looks like a secret, the value goes,
even if that costs a little readability.

Usage:
  some-diagnostic 2>&1 | last-stack-mask-secrets
  last-stack-mask-secrets <run.log >run.masked.log

Options:
  --min-length N   Value pass only redacts environment values at least this
                   long (default 6). Prevents a variable like DEBUG_TOKEN=1
                   from blanking every "1" in the stream. The assignment pass
                   is name-driven and ignores this.
  --placeholder S  Replacement text (default "<redacted:SECRET>"). The literal
                   "NAME" inside the placeholder is replaced by the variable
                   name when it is known.
  --self-test      Print the compiled name patterns and exit.
"""

from __future__ import annotations

import argparse
import os
import re
import sys

# Suffix-and-substring shapes that mean "this holds a credential". Matched
# case-insensitively against the whole variable name.
SECRET_NAME_PATTERNS: tuple[str, ...] = (
    r".*_API_KEY$",
    r".*_APIKEY$",
    r".*_TOKEN$",
    r".*_SECRET$",
    r".*_SECRET_KEY$",
    r".*_PASSWORD$",
    r".*_PASSWD$",
    r".*_CREDENTIALS?$",
    r".*_PRIVATE_KEY$",
    r".*_ACCESS_KEY$",
    r".*_SESSION_KEY$",
    r"^API_KEY$",
    r"^TOKEN$",
    r"^SECRET$",
    r"^PASSWORD$",
    r".*_PAT$",
    r"^GH_PAT$",
)

# Names that match a pattern above but are known-public locators, not values.
# A lastsecrets:// or https:// locator is the thing we WANT to see in a log.
SECRET_NAME_ALLOWLIST: frozenset[str] = frozenset(
    {
        "OBS_SENTRY_DSN",
    }
)

DEFAULT_PLACEHOLDER = "<redacted:NAME>"

_NAME_RE = re.compile("|".join(SECRET_NAME_PATTERNS), re.IGNORECASE)


def is_secret_name(name: str) -> bool:
    """True when a variable name is shaped like it holds a credential."""
    if name in SECRET_NAME_ALLOWLIST:
        return False
    return bool(_NAME_RE.fullmatch(name) or _NAME_RE.match(name))


def _placeholder_for(template: str, name: str) -> str:
    return template.replace("NAME", name)


def _looks_like_locator(value: str) -> bool:
    """A locator names where a secret lives; it is not the secret."""
    return value.startswith(("lastsecrets://", "https://", "http://", "file://"))


def build_value_redactions(environ, min_length: int) -> list[tuple[str, str]]:
    """Literal (value, replacement) pairs from secret-shaped env variables.

    Longest value first, so a value that contains a shorter one is redacted
    whole rather than leaving a tail behind.
    """
    pairs: list[tuple[str, str]] = []
    for name, value in environ.items():
        if not value or not is_secret_name(name):
            continue
        if len(value) < min_length or _looks_like_locator(value):
            continue
        pairs.append((value, name))
    pairs.sort(key=lambda pair: len(pair[0]), reverse=True)
    return pairs


# NAME=VALUE where the assignment opens the line (the `env` output shape).
# The value runs to end of line, because an exported value may contain spaces.
_LINE_ASSIGNMENT_RE = re.compile(
    r"^(?P<indent>\s*)(?:(?P<export>export|declare\s+-x|setenv)\s+)?"
    r"(?P<name>[A-Za-z_][A-Za-z0-9_]*)=(?P<value>.*)$"
)

# NAME=VALUE mid-line: stop at whitespace or a shell/JSON delimiter so a
# command line keeps its shape.
_INLINE_ASSIGNMENT_RE = re.compile(
    r"(?P<name>[A-Za-z_][A-Za-z0-9_]*)=(?P<quote>[\"']?)(?P<value>[^\s\"';,&|]+)(?P=quote)"
)

# "NAME": "VALUE" and NAME: VALUE (JSON, YAML, key: value logs).
_COLON_ASSIGNMENT_RE = re.compile(
    r"(?P<open>[\"']?)(?P<name>[A-Za-z_][A-Za-z0-9_]*)(?P=open)"
    r"(?P<sep>\s*:\s*)(?P<quote>[\"']?)(?P<value>[^\s\"',}\]]+)(?P=quote)"
)


def _redact_line_assignment(line: str, template: str) -> str | None:
    match = _LINE_ASSIGNMENT_RE.match(line)
    if not match:
        return None
    name = match.group("name")
    if not is_secret_name(name):
        return None
    value = match.group("value")
    if not value or _looks_like_locator(value):
        return None
    prefix = match.group("indent")
    if match.group("export"):
        prefix += match.group("export") + " "
    return f"{prefix}{name}={_placeholder_for(template, name)}"


def _redact_inline(line: str, template: str) -> str:
    def replace(match: re.Match) -> str:
        name = match.group("name")
        value = match.group("value")
        if not is_secret_name(name) or _looks_like_locator(value):
            return match.group(0)
        quote = match.group("quote")
        return f"{name}={quote}{_placeholder_for(template, name)}{quote}"

    return _INLINE_ASSIGNMENT_RE.sub(replace, line)


def _redact_colon(line: str, template: str) -> str:
    def replace(match: re.Match) -> str:
        name = match.group("name")
        value = match.group("value")
        if not is_secret_name(name) or _looks_like_locator(value):
            return match.group(0)
        quote = match.group("quote")
        opener = match.group("open")
        masked = _placeholder_for(template, name)
        return f"{opener}{name}{opener}{match.group('sep')}{quote}{masked}{quote}"

    return _COLON_ASSIGNMENT_RE.sub(replace, line)


def mask_line(line: str, value_pairs, template: str) -> str:
    """Apply the value pass then the assignment pass to one line."""
    for value, name in value_pairs:
        if value in line:
            line = line.replace(value, _placeholder_for(template, name))

    whole_line = _redact_line_assignment(line, template)
    if whole_line is not None:
        return whole_line

    line = _redact_inline(line, template)
    return _redact_colon(line, template)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="last-stack-mask-secrets",
        description="Redact secret-shaped values from a text stream.",
    )
    parser.add_argument("--min-length", type=int, default=6)
    parser.add_argument("--placeholder", default=DEFAULT_PLACEHOLDER)
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args(argv)

    if args.self_test:
        for pattern in SECRET_NAME_PATTERNS:
            print(pattern)
        return 0

    value_pairs = build_value_redactions(os.environ, args.min_length)

    # Line-buffered so a caller piping a long-running command still sees
    # masked output as it goes, rather than only at exit.
    for line in sys.stdin:
        newline = "\n" if line.endswith("\n") else ""
        masked = mask_line(line.rstrip("\n"), value_pairs, args.placeholder)
        sys.stdout.write(masked + newline)
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        # Downstream closed (head, grep -q). Not an error for a filter.
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
