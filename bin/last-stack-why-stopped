#!/usr/bin/env bash
# last-stack-why-stopped — zero-LLM Class A–H factory freeze classifier.
#
# Answers "why did shipping stop?" in one line. Optionally runs Class A heal
# and Class F unattached-outcome heal.
#
# Classes (factory graph):
#   A  host-track / last-stack install freeze
#   B  board claim path dead (empty ready + locks / pickup poison)
#   C  fold CI / forge runner SPOF
#   D  merge≠live / terminal proof gap (informational when doing has old PR)
#   E  LastDB hot (generator/backpressure)
#   F  soft idle — todo full but unclaimable (unattached-outcome / ready=0)
#      or ready queue with no in-flight work (factory looks healthy, ships nothing)
#   G  scheduler freeze — routinesd has dispatched nothing for hours, so no other
#      class is even measurable (every downstream signal reads "idle but healthy")
#   H  delivery frozen — the registry proof frontier has not advanced and at
#      least one pinned app has merged past it, so a green published artifact
#      cannot reach this host
#
# Usage:
#   last-stack-why-stopped [--json] [--heal] [--quiet]
#
# Exit: 0 always when classification succeeds; 2 on usage.
set -euo pipefail

JSON=0
HEAL=0
QUIET=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --heal) HEAL=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    -h|--help)
      echo "last-stack-why-stopped [--json] [--heal] [--quiet]"; exit 0 ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

log() { [ "$QUIET" -eq 1 ] || printf 'why-stopped: %s\n' "$*" >&2; }

# Resolve the file symlink chain before dirname: the PATH link
# ~/.local/bin/<name> points into the artifact tree, and siblings live there.
_self_src="$0"
while [ -L "$_self_src" ]; do
  _self_link="$(readlink "$_self_src")"
  case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
done
ROOT="$(CDPATH= cd -- "$(dirname -- "$_self_src")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

# Test seams (product defaults keep live CLI names).
CLASS_A_HEAL_BIN="${LASTSTACK_CLASS_A_HEAL_BIN:-last-stack-class-a-heal}"
HOST_TRACK_BIN="${LASTSTACK_WHY_STOPPED_HOST_TRACK_BIN:-host-track}"
KANBAN_BIN="${LASTSTACK_WHY_STOPPED_KANBAN_BIN:-kanban}"
CLASS_A_TIMEOUT_S="${LASTSTACK_WHY_STOPPED_CLASS_A_TIMEOUT_S:-8}"
# Class G threshold, in seconds. Derived from the real gap distribution over
# 18085 routinesd dispatches / 79 days on this host (2026-07-14 to 2026-10-01):
# p50 150s, p90 735s, p99 3432s. Gaps above 1h happen 105 times (≈1.3/day) and
# above 2h 17 times — ordinary lulls. Above 6h happens 8 times, and all eight
# ARE multi-hour freezes (9.5h to 107h). 6h is therefore the smallest bound
# that fires on every real freeze and on no lull.
CLASS_G_MAX_AGE_S="${LASTSTACK_WHY_STOPPED_DISPATCH_MAX_AGE_S:-21600}"

# Class H threshold, in seconds: how old the registry `next`-channel proof
# frontier may be before a pinned app waiting behind it counts as frozen.
# Derived from the prover's own declared cadence, not chosen: the routine that
# writes these proof rows is `llms-txt-install-smoke`
# (`rrule = FREQ=DAILY;BYHOUR=13;BYMINUTE=15`, `timeout_min = 45`), so the
# largest age a punctual prover can produce is one day plus one run, 24h45m
# (89100s). 30h leaves ~5h of margin over that and therefore cannot fire while
# the prover is running on time; it fires once a full daily cycle has been
# missed. The 2026-10-01T22:10Z frontier was 31.4h old when this class was
# written, with brain and routines both merged past it.
CLASS_H_MAX_PROOF_AGE_S="${LASTSTACK_WHY_STOPPED_PIN_PROOF_MAX_AGE_S:-108000}"

classes=()
detail=()
actions=()

have_cmd() {
  local c="$1"
  [ -n "$c" ] || return 1
  [ -x "$c" ] && return 0
  command -v "$c" >/dev/null 2>&1
}

# Hard-broken / hard-stale only. Soft-stale (stale=true, usable current) is
# not Class A — see design-last-stack-class-a-atomic-install-soft-stale.
host_track_hard_unhealthy() {
  local st freshness problem
  have_cmd "$HOST_TRACK_BIN" || return 1
  command -v jq >/dev/null 2>&1 || return 1
  st="$("$HOST_TRACK_BIN" status --json last-stack 2>/dev/null || true)"
  [ -n "$st" ] || return 1
  freshness="$(printf '%s\n' "$st" | jq -r '.freshness // empty' 2>/dev/null || true)"
  problem="$(printf '%s\n' "$st" | jq -r '.artifact_problem // empty' 2>/dev/null || true)"
  case "$freshness" in
    hard_broken|hard-broken|hard_stale|hard-stale) return 0 ;;
  esac
  if [ -n "$problem" ] && [ "$problem" != "null" ]; then
    return 0
  fi
  return 1
}

parse_heal_result() {
  printf '%s\n' "${1:-}" | awk '{
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^result=/) {
        split($i, a, "=")
        print a[2]
        exit
      }
    }
  }'
}

# --- Class A: install ---
# Wrapper timeout (timeout -k 2s 8s) is NOT Class A by itself. Heal exit 0
# (already-healthy, prompt-root-still-red, healed) is not Class A. Class A
# fires on heal result=error / exit 1, or host-track hard-broken / hard-stale.
class_a=0
CLASS_A_HEAL_RC=0
CLASS_A_HEAL_OUT=""

run_class_a() {
  local reason="$1" extra="${2:-}"
  local timeout_bin=""
  local -a cmd
  CLASS_A_HEAL_RC=0
  CLASS_A_HEAL_OUT=""
  if command -v gtimeout >/dev/null 2>&1; then
    timeout_bin="gtimeout"
  elif command -v timeout >/dev/null 2>&1; then
    timeout_bin="timeout"
  fi
  cmd=("$CLASS_A_HEAL_BIN" --reason="$reason")
  if [ -n "$extra" ]; then
    cmd+=("$extra")
  fi
  cmd+=(--quiet)
  set +e
  if [ -n "$timeout_bin" ]; then
    CLASS_A_HEAL_OUT="$("$timeout_bin" -k 2s "${CLASS_A_TIMEOUT_S}s" "${cmd[@]}" 2>/dev/null)"
  else
    CLASS_A_HEAL_OUT="$("${cmd[@]}" 2>/dev/null)"
  fi
  CLASS_A_HEAL_RC=$?
  set -e
  return 0
}

# 0 = Class A (unhealthy). 1 = not Class A.
class_a_from_heal_probe() {
  local heal_result
  heal_result="$(parse_heal_result "$CLASS_A_HEAL_OUT")"
  if [ "$CLASS_A_HEAL_RC" -eq 0 ]; then
    return 1
  fi
  # GNU timeout: 124. kill -9 after -k grace: 137.
  if [ "$CLASS_A_HEAL_RC" -eq 124 ] || [ "$CLASS_A_HEAL_RC" -eq 137 ]; then
    host_track_hard_unhealthy && return 0
    return 1
  fi
  if [ "$heal_result" = "error" ] || [ "$CLASS_A_HEAL_RC" -eq 1 ]; then
    return 0
  fi
  host_track_hard_unhealthy && return 0
  return 1
}

emit_class_a() {
  classes+=("A")
  if [ "$CLASS_A_HEAL_RC" -eq 124 ] || [ "$CLASS_A_HEAL_RC" -eq 137 ]; then
    detail+=("host-track/install hard-broken (heal timed out)")
  else
    detail+=("host-track/install unhealthy")
  fi
  actions+=("run:last-stack-class-a-heal")
}

if have_cmd "$CLASS_A_HEAL_BIN"; then
  run_class_a why-stopped
  if class_a_from_heal_probe; then
    class_a=1
    if [ "$HEAL" -eq 1 ]; then
      run_class_a why-stopped-heal --full
      if class_a_from_heal_probe; then
        emit_class_a
        detail+=("heal skipped-or-failed")
        actions+=("class-a-heal-skipped")
      else
        class_a=0
        detail+=("install was unhealthy; Class A healed")
        actions+=("class-a-heal-ok")
      fi
    else
      emit_class_a
    fi
  fi
elif have_cmd "$HOST_TRACK_BIN"; then
  if host_track_hard_unhealthy; then
    class_a=1
    classes+=("A")
    detail+=("host-track hard-broken/hard-stale")
    actions+=("host-track refresh --force last-stack")
  fi
fi

# --- Class E: LastDB pressure ---
if command -v last-stack-lastdb-pressure >/dev/null 2>&1; then
  if ! last-stack-lastdb-pressure --hot --quiet 2>/dev/null; then
    # exit 1 = hot; exit 2 = unknown — only treat hot
    rc=$?
    if [ "$rc" -eq 1 ]; then
      classes+=("E")
      detail+=("lastdb pressure hot")
      actions+=("shed generators; wait for cool")
    fi
  fi
fi

# --- Class C: forge runners ---
# Only the merge-gate runner is checked: the repo-scoped host runner served fold,
# which is on GitHub since 2026-09-29. Only the lastgit repo still gates on Forgejo.
fold_ci_down=0
for agent in com.edgevector.forgejo-runner; do
  if ! launchctl print "gui/$(id -u)/$agent" >/dev/null 2>&1; then
    fold_ci_down=1
    detail+=("launchd missing $agent")
  else
    state="$(launchctl print "gui/$(id -u)/$agent" 2>/dev/null | sed -n 's/^[[:space:]]*state = //p' | head -1)"
    if [ "$state" != "running" ]; then
      fold_ci_down=1
      detail+=("$agent state=$state")
    fi
  fi
done
if [ "$fold_ci_down" -eq 1 ]; then
  classes+=("C")
  actions+=("check forge runners; see last-stack-fold-ci-health")
fi

# --- Class B: pickup claim path ---
# Recent heartbeats: trailing stale-install or empty-todo with ready work is harder;
# use a cheap board ready count when possible.
ready=0
todo=0
doing=0
unattached=0
ps=""
if have_cmd "$KANBAN_BIN"; then
  ps="$("$KANBAN_BIN" pickup status --json 2>/dev/null || true)"
  if [ -n "$ps" ]; then
    ready="$(printf '%s\n' "$ps" | jq -r '.ready // 0' 2>/dev/null || echo 0)"
    unattached="$(printf '%s\n' "$ps" | jq -r '.counts["unattached-outcome"] // 0' 2>/dev/null || echo 0)"
    # Prefer scanned-active column tallies from status cards when present
    todo="$(printf '%s\n' "$ps" | jq -r '[.cards[]? | select(.column=="todo")] | length' 2>/dev/null || echo 0)"
    doing="$(printf '%s\n' "$ps" | jq -r '[.cards[]? | select(.column=="doing")] | length' 2>/dev/null || echo 0)"
  fi
  # column counts fallback if status omitted columns
  if { [ "${todo:-0}" -eq 0 ] 2>/dev/null && [ "${ready:-0}" -eq 0 ] 2>/dev/null; }; then
    if command -v last-stack-lastdb-pressure >/dev/null 2>&1 && last-stack-lastdb-pressure --hot --quiet 2>/dev/null; then
      :
    else
      todo="$("$KANBAN_BIN" list --column todo --json 2>/dev/null | jq 'if type=="array" then length else (.cards|length) end' 2>/dev/null || echo 0)"
      doing="$("$KANBAN_BIN" list --column doing --json 2>/dev/null | jq 'if type=="array" then length else (.cards|length) end' 2>/dev/null || echo 0)"
    fi
  fi
fi
# Trailing pickup poison from heartbeats
hb="${LAST_STACK_HEARTBEATS_PATH:-$HOME/.last-stack/logs/routine-heartbeats.log}"
pickup_poison=0
if [ -f "$hb" ]; then
  last_pick="$(grep -E 'kanban-pickup|fkanban-pickup' "$hb" 2>/dev/null | tail -1 || true)"
  case "$last_pick" in
    *stale-last-stack*|*class-a-heal-failed*|*routine-read-failed*|*class-a-heal-timeout*)
      pickup_poison=1
      ;;
  esac
fi
if [ "$pickup_poison" -eq 1 ] || { [ "${ready:-0}" -gt 0 ] 2>/dev/null && [ "${doing:-0}" -eq 0 ] 2>/dev/null && [ "$class_a" -eq 1 ]; }; then
  classes+=("B")
  detail+=("pickup claim path stuck (ready=$ready doing=$doing poison=$pickup_poison)")
  actions+=("heal Class A; check routinesd; kanban pickup claim --dry-run")
fi

# --- Class D: merge≠live smell ---
# Heuristic: doing cards with PR older than 3h (closeout lag / proof gap)
if [ "${doing:-0}" -gt 0 ] 2>/dev/null && have_cmd "$KANBAN_BIN"; then
  # cheap: if factory-health would soft-alert doing_stuck — skip heavy list here
  classes_has_d=0
  if [ "$doing" -ge 3 ]; then
    classes+=("D")
    detail+=("doing=$doing may include merge≠live / closeout lag")
    actions+=("last-stack-board-closeout-sweep; feature-prove")
    classes_has_d=1
  fi
fi

# --- Class F: soft idle (looks healthy, ships nothing) ---
# F1: todo has Kind:pr work that is unclaimable solely due to missing milestone
# F2: ready queue exists but nothing is in doing (factory paused / workers noop)
class_f=0
if [ "${unattached:-0}" -gt 0 ] 2>/dev/null && [ "${todo:-0}" -gt 0 ] 2>/dev/null; then
  class_f=1
  detail+=("soft-idle unattached-outcome=$unattached todo≈$todo ready=$ready")
  actions+=("last-stack-unattached-outcome-heal")
fi
if [ "${ready:-0}" -gt 0 ] 2>/dev/null && [ "${doing:-0}" -eq 0 ] 2>/dev/null && [ "$class_a" -eq 0 ] && [ "$pickup_poison" -eq 0 ]; then
  # Ready work, no in-flight agent — soft freeze unless Class A/B already owns it
  class_f=1
  detail+=("soft-idle ready=$ready doing=0 (claimable work, no in-flight)")
  actions+=("kanban pickup claim --dry-run; check pickup workers active")
fi
if [ "$class_f" -eq 1 ]; then
  classes+=("F")
  if [ "$HEAL" -eq 1 ]; then
    heal_bin=""
    if [ -x "$ROOT/bin/last-stack-unattached-outcome-heal" ]; then
      heal_bin="$ROOT/bin/last-stack-unattached-outcome-heal"
    elif command -v last-stack-unattached-outcome-heal >/dev/null 2>&1; then
      heal_bin="$(command -v last-stack-unattached-outcome-heal)"
    fi
    if [ -n "$heal_bin" ] && [ "${unattached:-0}" -gt 0 ] 2>/dev/null; then
      if "$heal_bin" --quiet >/dev/null 2>&1; then
        detail+=("Class F unattached-outcome heal ran")
        actions+=("unattached-outcome-heal-ok")
      else
        detail+=("Class F unattached-outcome heal failed")
        actions+=("unattached-outcome-heal-failed")
      fi
    fi
  fi
fi

# --- Class G: scheduler freeze (routinesd dispatched nothing in hours) ---
# This file was ALREADY open above for the pickup-poison grep, and it carried
# the fact that routinesd had not dispatched anything for 59h48m
# (2026-09-29T03:50:30Z -> 2026-10-01T15:38:25Z, four daemon generations, each
# up and ticking). Nothing read the newest line's TIMESTAMP, so this helper ran
# 17 minutes after the fleet came back and answered "factory may be idle or
# healthy". Every other class is downstream of dispatch: with the scheduler
# silent, ready work never gets claimed, so B and F read as a board problem.
#
# Only routinesd-written lines count. Other producers append their own shapes to
# the same log (`machine-leak-scan ok soft=0`, `automation=... north_star=...`),
# and on 2026-09-30 the ONLY two lines in the file were those — so "newest line
# in the file" would have reported the fleet 16h stale instead of 60h, and on a
# day with one such line it would have reported healthy. The routinesd signature
# is heartbeatLine()'s own shape: a leading ISO instant plus harness=, exit= and
# dur= on the same line.
dispatch_age_s=""
if [ -f "$hb" ] && [ "${CLASS_G_MAX_AGE_S}" -gt 0 ] 2>/dev/null; then
  last_dispatch_ts="$(
    grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z .* harness=.* exit=.* dur=' "$hb" 2>/dev/null \
      | tail -1 | awk '{print $1}' || true
  )"
  if [ -n "$last_dispatch_ts" ]; then
    # Same ISO-to-epoch idiom the rest of bin/ uses (89 helpers here are python3,
    # and last-stack-factory-health reads these stamps the same way). A stamp we
    # cannot parse leaves dispatch_age_s empty, so Class G stays silent rather
    # than guessing — this classifier must never invent a freeze.
    dispatch_age_s="$(
      LASTSTACK_TS="$last_dispatch_ts" python3 -c 'import os; from datetime import datetime, timezone; print(int((datetime.now(timezone.utc) - datetime.fromisoformat(os.environ["LASTSTACK_TS"].replace("Z", "+00:00"))).total_seconds()))' 2>/dev/null || true
    )"
  fi
fi
if [ -n "$dispatch_age_s" ] && [ "$dispatch_age_s" -ge "$CLASS_G_MAX_AGE_S" ] 2>/dev/null; then
  classes+=("G")
  detail+=("scheduler freeze: last routinesd dispatch ${dispatch_age_s}s ago (bound ${CLASS_G_MAX_AGE_S}s)")
  actions+=("launchctl list com.edgevector.routinesd; routines status; check Situation fences (skip-fence in routinesd.err.log)")
fi

# --- Class H: delivery frozen (registry proof frontier stale, apps waiting) ---
# `host-track` has computed `pin_behind_oid` since 2026-09-26 and the proof-row
# fields since 2026-10-03, and until now its own renderer was the only reader
# (papercut-host-track-pin-lag-fields-are-rendered-to-nobody-no-classifier-or-notice-reads-them-20261003).
# From 2026-10-01T22:10Z the six `next`-pinned apps sat on one 31h-old proof
# frontier, and brain and routines had merged past it -- EdgeVector/routines
# PR 9 and PR 11, both fixes to the only out-of-fleet fleet-freeze watchdog,
# could not reach this host. Two separate papercut-resolver passes found that
# by hand because no program said it.
#
# Class A deliberately cannot reach this: it gates on hard_broken/hard_stale and
# a frozen frontier renders `soft_stale`, which it excludes on purpose (see
# design-last-stack-class-a-atomic-install-soft-stale). That exclusion is right
# for its own reason -- the install IS current with the newest pair anyone
# proved -- and it left this condition in nobody's hands.
#
# Both conditions are required. A pinned app with a stale frontier and nothing
# merged past it is genuinely current and not a stoppage; an app that merged
# minutes ago is waiting for an ordinary prover run. The two cannot mask each
# other: a merge sets `pin_behind_oid` without touching the age, and a prover
# run clears both.
#
# Only `registry_pin_state=pinned` counts. `unreadable` means host-track could
# not read the index at all, which is "I did not look", never "nothing to see";
# `no-proved-row` and `not-on-index` leave the age empty and so stay silent here
# too. This classifier must never invent a freeze.
#
# Cost: `host-track status --json` with no app resolves the registry index for
# every pinned app over the network and measured 9.9-10.6s on this host, which is
# inside the existing run-to-run spread of this helper (14-27s unpatched). It is
# affordable here, on a two-hourly classifier, and it is NOT affordable on the
# load collector's per-sample path -- which is why the notice half of
# papercut-host-track-pin-lag-fields-are-rendered-to-nobody-no-classifier-or-notice-reads-them-20261003
# needs a cached frontier first and is deliberately not done here. The host-track
# stamps under ~/.host-track/stamps/ carry no pin or proof fields, so there is no
# cheap local source today.
pin_frozen_apps=""
pin_frozen_age=""
pin_frozen_run=""
if have_cmd "$HOST_TRACK_BIN" && command -v jq >/dev/null 2>&1 \
  && [ "${CLASS_H_MAX_PROOF_AGE_S}" -gt 0 ] 2>/dev/null; then
  ht_all="$("$HOST_TRACK_BIN" status --json 2>/dev/null || true)"
  if [ -n "$ht_all" ]; then
    # One row per blocked app: name, age, proof run. Printing the INPUTS the
    # verdict used is what lets two passes that disagree be told apart.
    pin_rows="$(
      printf '%s\n' "$ht_all" | jq -r --argjson maxage "$CLASS_H_MAX_PROOF_AGE_S" '
        (if type=="array" then . else [.] end)
        | map(select(
            (.registry_pin_state // "") == "pinned"
            and ((.pin_behind_oid // "") | tostring) != ""
            and ((.pin_behind_oid // null) != null)
            and ((.registry_pin_proof_age_secs // null) != null)
            and ((.registry_pin_proof_age_secs | tonumber?) // -1) >= $maxage
          ))
        | map([(.app // "?"), ((.registry_pin_proof_age_secs|tostring)), (.registry_pin_proof_run // "-")] | @tsv)
        | .[]
      ' 2>/dev/null || true
    )"
    if [ -n "$pin_rows" ]; then
      pin_frozen_apps="$(printf '%s\n' "$pin_rows" | awk -F'\t' '{printf "%s%s", sep, $1; sep=","} END{print ""}')"
      pin_frozen_age="$(printf '%s\n' "$pin_rows" | awk -F'\t' 'NR==1{print $2}')"
      pin_frozen_run="$(printf '%s\n' "$pin_rows" | awk -F'\t' 'NR==1{print $3}')"
    fi
  fi
fi
if [ -n "$pin_frozen_apps" ]; then
  classes+=("H")
  detail+=("delivery frozen: registry next-channel proof frontier ${pin_frozen_age}s old (bound ${CLASS_H_MAX_PROOF_AGE_S}s, newest proof ${pin_frozen_run}); merged past it and undeliverable: ${pin_frozen_apps}")
  actions+=("host-track status --json | jq -r '.[]|select(.pin_behind_oid)|[.app,.registry_pin_proof_age_secs]|@tsv'; the prover that writes proof rows is routine llms-txt-install-smoke - resume it or accept the posture (operator call, not a heal this fleet runs)")
fi

# Deduplicate classes while preserving order
seen=""
uniq=()
if [ "${#classes[@]}" -gt 0 ]; then
  for c in "${classes[@]}"; do
    case ",$seen," in
      *",$c,"*) ;;
      *) uniq+=("$c"); seen="${seen},${c}" ;;
    esac
  done
fi
classes=("${uniq[@]+"${uniq[@]}"}")

if [ "${#classes[@]}" -eq 0 ]; then
  classes=("none")
  if [ "${#detail[@]}" -eq 0 ]; then
    detail+=("no Class A–H freeze detected; factory may be idle or healthy")
  fi
  if [ "${#actions[@]}" -eq 0 ]; then
    actions+=("kanban pickup lanes; factory-health")
  fi
fi

cls_str="$(IFS=+; echo "${classes[*]}")"
det_str="$(IFS='; '; echo "${detail[*]}")"
act_str="$(IFS='; '; echo "${actions[*]}")"

# Heartbeat (never on stdout — --json must stay pure)
if [ "${LASTSTACK_WHY_STOPPED_NO_HEARTBEAT:-0}" != "1" ] && [ -x "$ROOT/bin/last-stack-brain-append-heartbeat" ]; then
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "$ROOT/bin/last-stack-brain-append-heartbeat" --line \
    "why-stopped $ts classes=$cls_str detail=$det_str" >/dev/null 2>&1 || true
fi

if [ "$JSON" -eq 1 ]; then
  # simple JSON
  printf '{"classes":"%s","detail":"%s","actions":"%s"}\n' \
    "$cls_str" "$(printf '%s' "$det_str" | tr '"' "'")" "$(printf '%s' "$act_str" | tr '"' "'")"
else
  printf 'WHY_STOPPED classes=%s\n' "$cls_str"
  printf 'detail: %s\n' "$det_str"
  printf 'actions: %s\n' "$act_str"
fi

# Finished classification is ok/noop even when classes=unknown or shipping is
# frozen. error is reserved for CLI missing (we never reach here).
routine_outcome="ok"
case "$cls_str" in
  none) routine_outcome="noop" ;;
esac
printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${routine_outcome} detail=classes=${cls_str}"

exit 0
