#!/usr/bin/env bash
# Probe latest main for legacy residue markers.
#
# Exit codes:
#   0  no matches found (green)
#   1  matches found (red; hits are printed to stdout)
#   2  repo/regex/fetch/grep error (red-unresolvable)
set -euo pipefail

repo="${1:-}"
regex="${2:-}"

if [ -z "$repo" ] || [ -z "$regex" ]; then
  echo "usage: last-stack-legacy-residue-probe <repo|path> <regex>" >&2
  exit 2
fi

repo_name="${repo##*/}"
repo_name="${repo_name%.git}"
workspace_root="${EDGEVECTOR_WORKSPACE_ROOT:-$HOME/code/edgevector}"
cache_root="${EDGEVECTOR_GIT_CACHE:-$HOME/.cache/edgevector-git}"

git_grep_tree() {
  local git_dir="$1"
  local ref="$2"

  set +e
  git -C "$git_dir" grep -nE "$regex" "$ref" -- ':!docs' ':!*.md'
  local rc=$?
  set -e

  case "$rc" in
    0) return 1 ;;
    1) return 0 ;;
    *) return 2 ;;
  esac
}

try_portal() {
  local portal="$1"
  local cache="$2"

  [ -x "$portal/bin/wt" ] || return 3
  (cd "$portal" && ./bin/wt fetch >/dev/null) || return 2
  [ -d "$cache" ] || return 2
  git_grep_tree "$cache" refs/remotes/origin/main
}

try_checkout() {
  local checkout="$1"

  git -C "$checkout" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 3
  git -C "$checkout" fetch origin main --quiet || return 2
  git_grep_tree "$checkout" origin/main
}

try_bare_cache() {
  local cache="$1"

  [ -d "$cache" ] || return 3
  git -C "$cache" rev-parse --is-bare-repository >/dev/null 2>&1 || return 3
  git -C "$cache" fetch origin main --quiet || return 2
  git_grep_tree "$cache" refs/remotes/origin/main
}

if [ -d "$repo" ]; then
  if try_portal "$repo" "$cache_root/$repo_name.git"; then
    exit 0
  else
    rc=$?
    case "$rc" in
      1) exit 1 ;;
      2) exit 2 ;;
    esac
  fi

  if try_checkout "$repo"; then
    exit 0
  else
    rc=$?
    case "$rc" in
      1) exit 1 ;;
      2) exit 2 ;;
    esac
  fi
fi

portal="$workspace_root/$repo_name"
cache="$cache_root/$repo_name.git"
if try_portal "$portal" "$cache"; then
  exit 0
else
  rc=$?
  case "$rc" in
    1) exit 1 ;;
    2) exit 2 ;;
  esac
fi

if try_bare_cache "$cache"; then
  exit 0
else
  rc=$?
  case "$rc" in
    1) exit 1 ;;
    2) exit 2 ;;
  esac
fi

if [ -d "$portal" ]; then
  if try_checkout "$portal"; then
    exit 0
  else
    rc=$?
    case "$rc" in
      1) exit 1 ;;
      2) exit 2 ;;
    esac
  fi
fi

echo "last-stack-legacy-residue-probe: unresolved repo=$repo" >&2
exit 2
