#!/usr/bin/env python3
"""Advance one bounded finite factory phase. A refusal retains the slot."""
import argparse
import json
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'lib'))
from factory_repair import (Controller, Runtime, Refusal, read_json, validate_local, set_deadline,
                            require_report_ready, routine_report, routine_heartbeat)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--once', action='store_true', required=True)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--routine-result', action='store_true')
    args = parser.parse_args(); set_deadline(1050); local = None
    try:
        local = validate_local(ROOT)
        config = read_json(ROOT / 'config/factory-repair-slot.json')
        directory = Path.home() / '.local/state/last-stack/factory-repair-slot'
        require_report_ready(directory, 'last-stack-factory-repair')
        result = Controller(config, directory, Runtime(ROOT, config, directory), local['contract_sha256']).once()
    except (Refusal, OSError, ValueError, KeyError, TypeError) as error:
        result = {'version': 1, 'result': 'error', 'reason': str(error), 'slot': 'retained'}
    if args.routine_result:
        set_deadline(120)
        if local is not None:
            result = routine_report(ROOT, 'last-stack-factory-repair', result)
            try: routine_heartbeat(ROOT, 'last-stack-factory-repair', result)
            except (Refusal, OSError, ValueError): result = {**result, 'result': 'error', 'reason': 'routine-heartbeat-unavailable'}
        outcome = 'ok' if result['result'] == 'ok' else ('noop' if result['result'] == 'noop' else 'error')
        print('ROUTINE_RESULT outcome=' + outcome + ' detail=' + result.get('phase', result.get('reason', 'retained')).replace(' ', '-'))
    else:
        print(json.dumps(result, sort_keys=True))
    return 0 if args.routine_result else (1 if result['result'] == 'error' else 0)

if __name__ == '__main__':
    sys.exit(main())
