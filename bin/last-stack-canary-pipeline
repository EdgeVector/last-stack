#!/usr/bin/env python3
from __future__ import annotations
"""Append-only ledger for the LastDB nightly canary pipeline."""
import argparse
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path


# `no_candidate` and `blocked_situation` exist so that "we never tested
# anything" cannot be recorded as "the candidate failed". They used to share
# `dogfood_red` with a genuine probe regression, which is how two dead nights —
# one with no staged build, one fenced off by an unrelated codex outage — read
# in the ledger exactly like a bad binary, and why nobody was paged for either.
# Both are RETRYABLE, not terminal: tomorrow's run must be able to move the same
# row forward. Only a real verdict (dogfood_red / soak_red) is terminal.
STATES = (
    "candidate_found",
    "no_candidate",
    "blocked_situation",
    "dogfood_started",
    "dogfood_green",
    "dogfood_red",
    "soak_started",
    "soak_green",
    "soak_red",
    "promote_prepare",
    "promoted",
)

ALLOWED = {
    "candidate_found": {"dogfood_started", "no_candidate", "blocked_situation"},
    "no_candidate": {"candidate_found", "dogfood_started", "blocked_situation"},
    "blocked_situation": {"candidate_found", "dogfood_started", "no_candidate"},
    "dogfood_started": {"dogfood_green", "dogfood_red", "no_candidate", "blocked_situation"},
    "dogfood_green": {"soak_started"},
    "dogfood_red": set(),
    "soak_started": {"soak_green", "soak_red"},
    "soak_green": {"promote_prepare", "promoted"},
    "soak_red": set(),
    "promote_prepare": {"promoted"},
    "promoted": set(),
}

# Default launchd uses LASTDB_LAUNCHD_LABEL from host env (never embed a personal
# username in committed defaults — machine-leak gate). Sidebin primary is typically
# not brew com.edgevector.lastdbd; set LASTDB_LAUNCHD_LABEL on the host.
CHECKS = (
    (
        "launchd",
        "LAST_STACK_CANARY_LAUNCHD_CHECK_CMD",
        'if [ -z "${LASTDB_LAUNCHD_LABEL:-}" ]; then echo "LASTDB_LAUNCHD_LABEL unset" >&2; exit 1; fi; launchctl print "gui/$(id -u)/$LASTDB_LAUNCHD_LABEL"',
    ),
    ("memory_guard", "LAST_STACK_CANARY_MEMORY_CHECK_CMD", "lastdb status"),
    ("board_read", "LAST_STACK_CANARY_BOARD_CHECK_CMD", "kanban ping"),
    # board_write closes the 2026-08-05 hole: every other check above is
    # liveness or a read, so a candidate that made every mutation on the node
    # ~4x slower passed all of them and would have auto-published as public
    # brew stable. See papercut-canary-soak-gate-has-no-write-path-check.
    (
        "board_write",
        "LAST_STACK_CANARY_BOARD_WRITE_CHECK_CMD",
        "last-stack-canary-write-probe",
    ),
    # The fence is SCOPED. It used to be `situations list --json | jq -e
    # "length == 0"` — the mere existence of any open Situation anywhere on the
    # host. A codex harness usage-limit, open 07-17 through 08-08 and unrelated
    # to lastdbd, was enough to hard-RED every soak in that window. Situations
    # already carries scope_systems/blocked_actions and a preflight verb that
    # evaluates them for one action; ask that instead of counting rows.
    # See papercut-canary-situation-fence-is-unscoped-any-situation-reds-the-nightly.
    (
        "situation_fence",
        "LAST_STACK_CANARY_SITUATION_CHECK_CMD",
        "situations preflight --action lastdb-safe-upgrade",
    ),
)

# Checks that mutate the primary. Skipped under --dry-run unless the caller
# explicitly overrides the command, so `proof --dry-run` and the CI fixtures
# can never write to a real node.
MUTATING_CHECKS = frozenset({"board_write"})

# label -> (env override, default budget ms, samples). A check with a budget
# fails when it SUCCEEDS BUT IS TOO SLOW — exit code alone was the whole
# problem. 0 disables the bound.
#
# The 2500ms board_write default discriminates on measured ground truth:
# a `brain put` round-trip is ~0.55s of CLI/round-trip overhead plus the
# mutation, so a healthy binary lands ~1.7s (from the 1171ms/call figure in
# brain lastdb-lock-wait-conflates-three-write-gates) and the 2026-08-05
# rollback measured 3.9s on 3 of 3 samples. The median of 3 samples is what is
# compared, so one busy moment cannot brake a good candidate — but a systemic
# regression has nowhere to hide.
#
# Failure asymmetry is deliberate: a false green ships a broken write path to
# every LastDB user, a false red only parks a candidate until the next nightly
# supersedes it. Bias to red.
CHECK_BUDGET_MS = {
    "board_write": ("LAST_STACK_CANARY_WRITE_MS_MAX", 2500, 3),
}

# label -> why it failed, for the ledger. A bare `board_write` in the evidence
# would not say whether the write ERRORED or merely ran slow, and those want
# different responses from whoever reads the red.
CHECK_FAILURE_DETAIL: dict[str, str] = {}


def soak_hours() -> float:
    raw = os.environ.get("LAST_STACK_CANARY_SOAK_HOURS", "24")
    try:
        return float(raw)
    except ValueError:
        return 24.0


def env_float(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        return float(raw)
    except ValueError:
        return default


def settle_grace_minutes() -> float:
    """How long after dogfood_green a blind identity probe is settle noise.

    The state machine starts the soak SECONDS after the live cutover, inside
    the window where the upgrade notice itself says "brief socket blips
    expected". Within this grace an unavailable identity probe defers the
    soak start (soak_pending); past it, the probe's blindness is a real
    failure. 45 minutes is under the state machine's 1h SOAK_WAIT re-tick, so
    a persistent failure still reds on the second tick.
    """
    return env_float("LAST_STACK_CANARY_SETTLE_GRACE_MIN", 45.0)


def parse_ts(value: str) -> dt.datetime | None:
    if not value:
        return None
    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"
        return dt.datetime.fromisoformat(value)
    except ValueError:
        return None


def event_ts_for_state(path: Path, candidate: str, state: str) -> dt.datetime | None:
    for event in reversed(load_events(path)):
        if event.get("candidate") == candidate and event.get("state") == state:
            return parse_ts(str(event.get("ts", "")))
    return None


def event_for_state(path: Path, candidate: str, state: str) -> dict | None:
    for event in reversed(load_events(path)):
        if event.get("candidate") == candidate and event.get("state") == state:
            return event
    return None


def primary_identity(dry_run: bool) -> tuple[str, str, str] | None:
    explicit = "LAST_STACK_CANARY_PRIMARY_IDENTITY_CMD" in os.environ
    if dry_run and not explicit:
        return ("dry-run", "dry-run", "dry-run")
    command = os.environ.get(
        "LAST_STACK_CANARY_PRIMARY_IDENTITY_CMD",
        "last-stack-lastdb-memory-guard --identity",
    )
    if command in ("pass", "true", "ok"):
        return ("stub", "stub", "stub")
    result = subprocess.run(
        command,
        shell=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        return None
    fields = {}
    for token in (result.stdout or "").strip().split():
        key, separator, value = token.partition("=")
        if separator and key in {"pid", "process_start_ts", "build"}:
            fields[key] = value
    if not fields.get("pid") or not fields.get("process_start_ts"):
        return None
    return (
        fields["pid"],
        fields["process_start_ts"],
        fields.get("build", "unknown"),
    )


def live_version() -> str:
    cmd = os.environ.get("LAST_STACK_CANARY_LIVE_VERSION_CMD", "lastdbd --version")
    if cmd in ("", "pass", "skip", "true", "ok"):
        return ""
    if cmd in ("fail", "false", "red"):
        return "__fail__"
    result = subprocess.run(cmd, shell=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        return ""
    line = (result.stdout or "").strip().splitlines()
    if not line:
        return ""
    return line[-1].split()[-1]


def version_matches(live: str, version: str, candidate: str) -> bool:
    if not live or live == "__fail__":
        return False
    needles = [v for v in (version, candidate) if v]
    # Prefer exact version match; also accept live containing version token.
    for n in needles:
        n = n.removeprefix("lastdb-").removeprefix("v")
        if not n:
            continue
        if live == n or n in live:
            return True
    return False


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def default_state_dir() -> Path:
    raw = os.environ.get("LAST_STACK_CANARY_PIPELINE_DIR")
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".local" / "state" / "last-stack" / "canary-pipeline"


def default_promote_root() -> Path:
    raw = os.environ.get("LAST_STACK_CANARY_PROMOTE_DIR")
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".local" / "state" / "last-stack" / "canary-promote"


def add_common_ledger_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--ledger", dest="command_ledger", type=Path, default=None)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="last-stack-canary-pipeline",
        description="Record and validate LastDB canary pipeline lifecycle transitions.",
    )
    parser.add_argument("--state-dir", type=Path, default=default_state_dir())
    parser.add_argument("--ledger", type=Path, default=None)
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON")

    sub = parser.add_subparsers(dest="command", required=True)

    create = sub.add_parser("create", help="create a new candidate at candidate_found")
    create.add_argument("candidate")
    create.add_argument("--version", default="")
    create.add_argument("--source", default="")
    create.add_argument("--source-git-oid", default="", help="fold main / build commit OID")
    create.add_argument("--note", default="")

    read = sub.add_parser("read", help="read the current state for one candidate")
    read.add_argument("candidate")

    advance = sub.add_parser("advance", help="append a valid transition for one candidate")
    advance.add_argument("candidate")
    advance.add_argument("state", choices=STATES)
    advance.add_argument("--note", default="")

    sub.add_parser("list", help="list latest state for every candidate")

    dogfood = sub.add_parser("dogfood", help="record a dogfooded canary SHA")
    add_common_ledger_flags(dogfood)
    dogfood.add_argument("--sha", required=True)
    dogfood.add_argument("--observed-sha", default="")
    dogfood.add_argument("--version", default="")
    dogfood.add_argument("--source", default="dogfood")
    dogfood.add_argument("--source-git-oid", default="", help="fold main / build commit OID")
    dogfood.add_argument("--dry-run", action="store_true")

    soak = sub.add_parser("soak-watch", help="evaluate hard health signals for a dogfooded SHA")
    add_common_ledger_flags(soak)
    soak.add_argument("--sha", default="")
    soak.add_argument("--dry-run", action="store_true")

    promote = sub.add_parser("promote-prepare", help="report whether a green soak is ready for promotion")
    add_common_ledger_flags(promote)
    promote.add_argument("--sha", default="")
    promote.add_argument("--dry-run", action="store_true")
    promote.add_argument("--promote-root", type=Path, default=default_promote_root())
    promote.add_argument("--no-notify", action="store_true")

    promote_exec = sub.add_parser(
        "promote-execute",
        help="auto-promote a soak_green canary to a public stable brew release (local-canonical)",
    )
    add_common_ledger_flags(promote_exec)
    promote_exec.add_argument("--sha", default="")
    promote_exec.add_argument("--dry-run", action="store_true")
    promote_exec.add_argument("--promote-root", type=Path, default=default_promote_root())
    promote_exec.add_argument("--no-notify", action="store_true")
    promote_exec.add_argument(
        "--force",
        action="store_true",
        help="allow promote without LAST_STACK_CANARY_PROMOTE_AUTO=1",
    )

    proof = sub.add_parser("proof", help="exercise dogfood, soak-watch, and promote-prepare offline")
    proof.add_argument("--dry-run", action="store_true")

    return parser.parse_args(argv)


def ledger_path(args: argparse.Namespace) -> Path:
    command_ledger = getattr(args, "command_ledger", None)
    if command_ledger is not None:
        return command_ledger.expanduser()
    if args.ledger is not None:
        return args.ledger.expanduser()
    return args.state_dir.expanduser() / "ledger.jsonl"


def die(message: str, code: int = 1) -> None:
    print(f"last-stack-canary-pipeline: {message}", file=sys.stderr)
    raise SystemExit(code)


def load_events(path: Path) -> list[dict]:
    if not path.exists():
        return []
    events = []
    with path.open("r", encoding="utf-8") as fh:
        for lineno, line in enumerate(fh, start=1):
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError as exc:
                die(f"invalid ledger JSON at {path}:{lineno}: {exc}")
            if not isinstance(event, dict):
                die(f"invalid ledger event at {path}:{lineno}: not an object")
            events.append(event)
    return events


def latest_by_candidate(events: list[dict]) -> dict[str, dict]:
    latest = {}
    for event in events:
        candidate = str(event.get("candidate", ""))
        if candidate:
            latest[candidate] = event
    return latest


def append_event(path: Path, event: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n"
    fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
    try:
        os.write(fd, payload.encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)


def lock_and_run(path: Path, fn):
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_suffix(path.suffix + ".lock")
    with lock_path.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        return fn()


def current_record(event: dict) -> dict:
    return {
        "candidate": event.get("candidate", ""),
        "state": event.get("state", ""),
        "version": event.get("version", ""),
        "source": event.get("source", ""),
        "source_git_oid": event.get("source_git_oid", ""),
        "updated_at": event.get("ts", ""),
        "note": event.get("note", ""),
        "observed_sha": event.get("observed_sha", ""),
        "evidence": event.get("evidence", ""),
    }


def emit_record(value: dict) -> None:
    print(
        "candidate={candidate} state={state} version={version} source={source} updated_at={updated_at}".format(
            **value
        )
    )


def emit(value, as_json: bool) -> None:
    if as_json:
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        return
    if isinstance(value, list):
        for item in value:
            emit_record(item)
    else:
        emit_record(value)


def base_event(candidate: str, state: str, previous_state: str = "", **extra) -> dict:
    event = {
        "ts": utc_now(),
        "candidate": candidate,
        "state": state,
    }
    if previous_state:
        event["previous_state"] = previous_state
    event.update({key: value for key, value in extra.items() if value != ""})
    return event


def create_candidate(path: Path, args: argparse.Namespace) -> dict:
    def inner() -> dict:
        latest = latest_by_candidate(load_events(path))
        if args.candidate in latest:
            die(f"candidate already exists: {args.candidate}")
        event = base_event(
            args.candidate,
            "candidate_found",
            version=args.version,
            source=args.source,
            source_git_oid=getattr(args, "source_git_oid", "") or "",
            note=args.note,
        )
        append_event(path, event)
        return current_record(event)

    return lock_and_run(path, inner)


def read_candidate(path: Path, args: argparse.Namespace) -> dict:
    latest = latest_by_candidate(load_events(path))
    event = latest.get(args.candidate)
    if event is None:
        die(f"candidate not found: {args.candidate}")
    return current_record(event)


def list_candidates(path: Path) -> list[dict]:
    latest = latest_by_candidate(load_events(path))
    return [current_record(latest[candidate]) for candidate in sorted(latest)]


def append_transition(path: Path, candidate: str, state: str, **extra) -> dict:
    events = load_events(path)
    latest = latest_by_candidate(events)
    previous = latest.get(candidate)
    if previous is None:
        die(f"candidate not found: {candidate}; create it first")
    old_state = str(previous.get("state", ""))
    if old_state == state:
        die(f"duplicate transition for {candidate}: already {state}")
    if state not in ALLOWED.get(old_state, set()):
        allowed = ", ".join(sorted(ALLOWED.get(old_state, set()))) or "none"
        die(f"invalid transition for {candidate}: {old_state} -> {state} (allowed: {allowed})")
    # Preserve source_git_oid across transitions unless the caller overrides it.
    if "source_git_oid" not in extra and previous.get("source_git_oid"):
        extra = {**extra, "source_git_oid": previous.get("source_git_oid")}
    event = base_event(
        candidate,
        state,
        previous_state=old_state,
        version=str(previous.get("version", "")),
        source=str(previous.get("source", "")),
        **extra,
    )
    append_event(path, event)
    return event


def advance_candidate(path: Path, args: argparse.Namespace) -> dict:
    def inner() -> dict:
        return current_record(append_transition(path, args.candidate, args.state, note=args.note))

    return lock_and_run(path, inner)


def dry_suffix(enabled: bool) -> str:
    return " dry_run=1 no_primary_mutation=1" if enabled else ""


def dogfood_candidate(path: Path, args: argparse.Namespace) -> dict:
    observed_sha = args.observed_sha or args.sha

    # Guard BEFORE the ledger records anything: dogfood is the step that cuts the
    # primary over, so a rollback caught here never touches the live node.
    source_oid = str(getattr(args, "source_git_oid", "") or "")
    if not args.dry_run:
        guarded = assert_not_rollback(
            args.version, args.sha, strict_unknown=False, stage="dogfood"
        )
        source_oid = source_oid or guarded

    def inner() -> dict:
        latest = latest_by_candidate(load_events(path))
        current = latest.get(args.sha)
        if current is None:
            append_event(
                path,
                base_event(
                    args.sha,
                    "candidate_found",
                    version=args.version,
                    source=args.source,
                    source_git_oid=source_oid,
                ),
            )
            append_transition(path, args.sha, "dogfood_started", note="dogfood")
            event = append_transition(
                path, args.sha, "dogfood_green", observed_sha=observed_sha, source_git_oid=source_oid
            )
        elif current.get("state") == "candidate_found":
            append_transition(path, args.sha, "dogfood_started", note="dogfood")
            event = append_transition(
                path, args.sha, "dogfood_green", observed_sha=observed_sha, source_git_oid=source_oid
            )
        elif current.get("state") == "dogfood_started":
            event = append_transition(
                path, args.sha, "dogfood_green", observed_sha=observed_sha, source_git_oid=source_oid
            )
        elif current.get("state") == "dogfood_green" and current.get("observed_sha", args.sha) == observed_sha:
            event = current
        else:
            die(f"cannot dogfood {args.sha}: current state is {current.get('state')}")
        return event

    event = lock_and_run(path, inner)
    print(
        f"DOGFOOD ledger={path} sha={args.sha} observed_sha={observed_sha} "
        f"state={event.get('state')} result=ok{dry_suffix(args.dry_run)}"
    )
    return current_record(event)


class NoActiveCandidate(Exception):
    """No candidate is soaking. A quiet lane, not a failure."""


def choose_soak_candidate(path: Path, requested_sha: str, wanted_states: set[str]) -> dict:
    events = load_events(path)
    latest = latest_by_candidate(events)
    if requested_sha:
        event = latest.get(requested_sha)
        if event is None:
            die(f"candidate not found: {requested_sha}")
        return event
    for event in reversed(events):
        candidate = str(event.get("candidate", ""))
        if not candidate:
            continue
        latest_event = latest.get(candidate, {})
        if latest_event.get("state") in wanted_states:
            return latest_event
    raise NoActiveCandidate("no candidate is currently soaking")


# --- memory guard ----------------------------------------------------------
# `memory_guard` ran `lastdb status` and looked only at the exit code. A check
# named for a bar it does not implement is worse than no check, because the
# gate reads as covered. Resolve the SAME ceiling safe-upgrade uses
# (LASTDBD_RSS_LIMIT_MB, then the LaunchAgent plist, then 16384 MB) so the two
# paths cannot disagree about what "too much memory" means.


def rss_limit_mb() -> float:
    for key in ("LASTDBD_RSS_LIMIT_MB", "LASTDB_PROBE_RSS_LIMIT_MB"):
        raw = os.environ.get(key)
        if raw:
            try:
                return float(raw)
            except ValueError:
                pass
    label = os.environ.get("LASTDB_LAUNCHD_LABEL", "")
    if label:
        plist = Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
        if plist.is_file():
            try:
                out = subprocess.run(
                    [
                        "/usr/libexec/PlistBuddy",
                        "-c",
                        "Print :EnvironmentVariables:LASTDBD_RSS_LIMIT_MB",
                        str(plist),
                    ],
                    capture_output=True,
                    text=True,
                    timeout=15,
                )
                if out.returncode == 0 and out.stdout.strip():
                    return float(out.stdout.strip())
            except (ValueError, OSError, subprocess.SubprocessError):
                pass
    try:
        return float(os.environ.get("LASTDBD_DEFAULT_RSS_LIMIT_MB", "16384"))
    except ValueError:
        return 16384.0


def parse_status_rss_mb(status_text: str) -> float | None:
    """`Memory RSS: 1.56 GiB` -> 1597.44. Returns None if absent/unparseable."""
    for line in status_text.splitlines():
        stripped = line.strip()
        if not stripped.startswith("Memory RSS:"):
            continue
        parts = stripped.split(":", 1)[1].split()
        if len(parts) < 2:
            return None
        try:
            value = float(parts[0])
        except ValueError:
            return None
        unit = parts[1].lower()
        scale = {"b": 1 / (1024 * 1024), "kib": 1 / 1024, "mib": 1.0, "gib": 1024.0, "tib": 1024.0 * 1024}
        if unit not in scale:
            return None
        return value * scale[unit]
    return None


def memory_guard_error(status_text: str) -> str | None:
    """None when within the ceiling; an evidence string when over it.

    A status output with no `Memory RSS:` line is NOT treated as a failure —
    an older binary that omits the field should not brake a soak. It is
    reported so the gap is visible rather than silently green.
    """
    rss = parse_status_rss_mb(status_text)
    if rss is None:
        print("CHECK label=memory_guard note=rss_not_reported", file=sys.stderr)
        return None
    limit = rss_limit_mb()
    try:
        headroom = float(os.environ.get("LASTDB_PROBE_RSS_HEADROOM_PCT", "10"))
    except ValueError:
        headroom = 10.0
    ceiling = limit * (100.0 - headroom) / 100.0
    if ceiling > 0 and rss >= ceiling:
        return f"rss_mb={rss:.0f}_ceiling_mb={ceiling:.0f}"
    print(f"CHECK label=memory_guard rss_mb={rss:.0f} ceiling_mb={ceiling:.0f}")
    return None


def check_budget_ms(label: str) -> tuple[float, int]:
    """(budget_ms, samples) for a check. budget 0 means no latency bound."""
    spec = CHECK_BUDGET_MS.get(label)
    if not spec:
        return 0.0, 1
    env_name, default_ms, samples = spec
    raw = os.environ.get(env_name)
    budget = float(default_ms)
    if raw:
        try:
            budget = float(raw)
        except ValueError:
            pass
    try:
        samples = max(1, int(os.environ.get("LAST_STACK_CANARY_CHECK_SAMPLES", samples)))
    except ValueError:
        pass
    return budget, samples


def run_check(label: str, env_name: str, default_cmd: str, dry_run: bool = False) -> bool:
    command = os.environ.get(env_name, default_cmd)
    explicit = env_name in os.environ
    # Never let a dry run (proof, CI fixtures) write to a real node.
    if dry_run and label in MUTATING_CHECKS and not explicit:
        print(f"CHECK label={label} result=ok mode=dry-run-skip")
        return True
    if command in ("", "pass", "true", "ok"):
        print(f"CHECK label={label} result=ok mode=stub")
        return True
    if command in ("fail", "false", "red"):
        print(f"CHECK label={label} result=fail mode=stub", file=sys.stderr)
        CHECK_FAILURE_DETAIL[label] = "stub_fail"
        return False

    budget_ms, samples = check_budget_ms(label)
    capture = label == "memory_guard"
    # A non-zero exit gets ONE bounded re-run after a settle delay before it
    # reds the soak — the same reasoning as the slow-median rule below: one
    # failed read probe is load or a blip, a failure that survives the retry
    # is the binary. The 2026-08-30 soak_red was `kanban ping` exiting 1
    # ~35s after the live cutover, inside the window the upgrade notice
    # itself calls "brief socket blips expected"; the same ping was green a
    # minute later. Budget (slow) and memory-guard verdicts are NOT retried:
    # the median already absorbed load, and an over-ceiling RSS is no blip.
    fail_retries = int(env_float("LAST_STACK_CANARY_CHECK_FAIL_RETRIES", 1))
    fail_retry_delay_s = env_float("LAST_STACK_CANARY_CHECK_FAIL_RETRY_DELAY_S", 20.0)
    attempt = 0
    while True:
        durations = []
        exit_code = 0
        for _ in range(samples):
            started = time.monotonic()
            result = subprocess.run(
                command,
                shell=True,
                stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True if capture else False,
            )
            durations.append((time.monotonic() - started) * 1000.0)
            if result.returncode != 0:
                exit_code = result.returncode
                break
            if capture:
                evidence = memory_guard_error(result.stdout or "")
                if evidence is not None:
                    print(f"CHECK label={label} result=fail {evidence}", file=sys.stderr)
                    CHECK_FAILURE_DETAIL[label] = evidence
                    return False
        if exit_code == 0:
            break
        if attempt < fail_retries:
            attempt += 1
            print(
                f"CHECK label={label} result=retry exit_{exit_code} "
                f"attempt={attempt} delay_s={fail_retry_delay_s:g}",
                file=sys.stderr,
            )
            time.sleep(fail_retry_delay_s)
            continue
        print(f"CHECK label={label} result=fail", file=sys.stderr)
        CHECK_FAILURE_DETAIL[label] = f"exit_{exit_code}"
        return False

    if budget_ms > 0:
        # Median, not mean or max: one slow sample is load, a slow median is
        # the binary. Sorting an odd/even count the same way keeps it simple.
        ordered = sorted(durations)
        median = ordered[len(ordered) // 2] if len(ordered) % 2 else (
            ordered[len(ordered) // 2 - 1] + ordered[len(ordered) // 2]
        ) / 2
        if median > budget_ms:
            print(
                f"CHECK label={label} result=slow median_ms={median:.0f} "
                f"budget_ms={budget_ms:.0f} samples={samples}",
                file=sys.stderr,
            )
            CHECK_FAILURE_DETAIL[label] = f"slow_median_ms={median:.0f}_budget_ms={budget_ms:.0f}"
            return False
        print(
            f"CHECK label={label} result=ok median_ms={median:.0f} "
            f"budget_ms={budget_ms:.0f} samples={samples}"
        )
        return True

    print(f"CHECK label={label} result=ok")
    return True


# --- commit-ancestry guard -------------------------------------------------
# Canary versions are `git describe` builds, so semver is NOT a valid ordering
# authority: on 2026-08-05 `0.23.3-canary.20260801` (built Aug 1) replaced
# `0.23.2-409-gee967a073` (built Aug 4) and the pipeline called it an upgrade.
# It was a strict rollback of 196 commits / 72 merges. Order by commit ancestry
# instead — the candidate must be a DESCENDANT of the running binary's commit.


def ancestry_guard_enabled() -> bool:
    return os.environ.get("LAST_STACK_CANARY_ANCESTRY_GUARD", "1") != "0"


def canary_manifest_oid(version: str) -> str:
    """source_git_oid for a version, from its release manifest asset alone.

    Deliberately does NOT reuse download_canary_assets(): that pulls the whole
    tarball, and the guard has to run *before* we commit to a candidate.
    Returns "" when it cannot be determined.

    Takes NO env override of its own. Callers that accept one apply it
    themselves, so the *candidate* override can never leak into the
    *running binary* lookup and collapse both sides of the comparison onto
    the same OID (which would read as `relation=identical` and pass).
    """
    if not version:
        return ""
    tag = version if version.startswith("v") else f"v{version}"
    repo = os.environ.get("LAST_STACK_CANARY_ASSET_REPO", "EdgeVector/homebrew-lastdb")
    api_base = os.environ.get("LAST_STACK_CANARY_ASSET_API_BASE", "https://api.github.com").rstrip("/")
    api = f"{api_base}/repos/{repo}/releases/tags/{tag}"
    import urllib.request

    headers = {"Accept": "application/vnd.github+json"}
    token = os.environ.get("GH_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    try:
        req = urllib.request.Request(api, headers=headers)
        with urllib.request.urlopen(req, timeout=30) as resp:
            release = json.loads(resp.read().decode("utf-8"))
        for asset in release.get("assets") or []:
            name = asset.get("name") or ""
            url = asset.get("browser_download_url") or ""
            if not name.endswith("manifest.json") or not url:
                continue
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as resp:
                manifest = json.loads(resp.read().decode("utf-8"))
            return str(manifest.get("source_git_oid") or "")
    except Exception:
        return ""
    return ""


def canary_source_oid(version: str) -> str:
    """Candidate OID: the test/operator override, else the release manifest."""
    override = os.environ.get("LAST_STACK_CANARY_SOURCE_OID")
    if override:
        return override.strip()
    return canary_manifest_oid(version)


def running_source_oid() -> str:
    """Commit of the live binary.

    First the `-g<sha>` suffix of a `git describe` build
    (`0.23.2-409-gee967a073` -> `ee967a073`). A canary or tagged build carries
    no such suffix — but its commit is still knowable, from the same release
    manifest the candidate side reads, so fall back to that.

    That fallback is the whole point rather than a nicety: a bad cutover leaves
    the primary running exactly such a canary build, so without it the guard
    goes blind precisely *after* it has already failed once, and every
    subsequent dogfood cutover is unguarded (stage=dogfood proceeds on
    unknown). Measured 2026-08-05 on the primary: live `0.23.3-canary.20260801`
    resolved to "" here while its manifest gave 6c742dc6.
    """
    override = os.environ.get("LAST_STACK_CANARY_RUNNING_OID")
    if override:
        return override.strip()
    live = live_version()
    if not live or live == "__fail__":
        return ""
    tail = live.rsplit("-", 1)[-1]
    if len(tail) >= 8 and tail.startswith("g"):
        body = tail[1:]
        if all(c in "0123456789abcdef" for c in body.lower()):
            return body
    return canary_manifest_oid(live)


def fold_mirror() -> Path | None:
    override = os.environ.get("LAST_STACK_CANARY_FOLD_MIRROR")
    candidates = [Path(override)] if override else []
    candidates.append(Path.home() / ".cache/edgevector-git/fold.git")
    for candidate in candidates:
        if candidate.is_dir():
            return candidate
    return None


def is_descendant(mirror: Path, ancestor: str, descendant: str) -> bool | None:
    """True/False, or None when either commit is absent from the mirror."""
    for oid in (ancestor, descendant):
        probe = subprocess.run(
            ["git", "-C", str(mirror), "cat-file", "-e", f"{oid}^{{commit}}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if probe.returncode != 0:
            return None
    result = subprocess.run(
        ["git", "-C", str(mirror), "merge-base", "--is-ancestor", ancestor, descendant],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def rollback_span(mirror: Path, candidate_oid: str, running_oid: str) -> str:
    def count(*args: str) -> str:
        result = subprocess.run(
            ["git", "-C", str(mirror), "rev-list", "--count", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        return (result.stdout or "").strip() or "?"

    span = f"{candidate_oid}..{running_oid}"
    return f"commits={count(span)} merges={count('--merges', span)}"


def baseline_oid_for(stage: str) -> tuple[str, str]:
    """(oid, label) of the build the candidate must be a descendant of.

    dogfood cuts the primary over, so the baseline is the RUNNING binary.
    promote publishes to the public, and by then the running binary *is* the
    candidate — the meaningful baseline is the current stable release.
    """
    if stage == "promote":
        tag = latest_stable_tag()
        if not tag:
            return "", "latest_stable"
        return canary_source_oid(tag), f"latest_stable={tag}"
    return running_source_oid(), "running"


def assert_not_rollback(version: str, candidate: str, *, strict_unknown: bool, stage: str) -> str:
    """Refuse a candidate that is not a descendant of its stage baseline.

    Returns the candidate's source OID ("" if undetermined). `strict_unknown`
    decides the posture when ancestry cannot be established: promote guards a
    PUBLIC release and fails closed; a local dogfood cutover warns and proceeds.
    """
    if not ancestry_guard_enabled():
        print(f"ANCESTRY stage={stage} result=skipped reason=guard_disabled", file=sys.stderr)
        return ""

    candidate_oid = canary_source_oid(version or candidate)
    base_oid, base_label = baseline_oid_for(stage)
    mirror = fold_mirror()

    unknown = None
    if not candidate_oid:
        unknown = "candidate_oid_unavailable"
    elif not base_oid:
        unknown = "baseline_oid_unavailable"
    elif mirror is None:
        unknown = "fold_mirror_unavailable"

    if unknown is None:
        if base_oid == candidate_oid:
            print(
                f"ANCESTRY stage={stage} result=ok candidate_oid={candidate_oid} "
                f"baseline[{base_label}]={base_oid} relation=identical"
            )
            return candidate_oid
        verdict = is_descendant(mirror, base_oid, candidate_oid)
        if verdict is None:
            unknown = "commit_not_in_mirror"
        elif not verdict:
            span = rollback_span(mirror, candidate_oid, base_oid)
            die(
                f"ANCESTRY stage={stage} result=REFUSE candidate={candidate} "
                f"candidate_oid={candidate_oid} baseline[{base_label}]={base_oid} {span}: "
                "candidate is NOT a descendant of the baseline — this is a "
                "ROLLBACK, not an upgrade. Semver is not the ordering authority "
                "for git-describe builds. Override with "
                "LAST_STACK_CANARY_ANCESTRY_GUARD=0 only with a written reason."
            )
        else:
            print(
                f"ANCESTRY stage={stage} result=ok candidate_oid={candidate_oid} "
                f"baseline[{base_label}]={base_oid} relation=descendant"
            )
            return candidate_oid

    message = (
        f"ANCESTRY stage={stage} result=unknown reason={unknown} "
        f"candidate_oid={candidate_oid or 'none'} baseline[{base_label}]={base_oid or 'none'}"
    )
    if strict_unknown:
        die(f"{message}: refusing to publish without proven ancestry")
    print(f"{message} (proceeding: local cutover is reversible)", file=sys.stderr)
    return candidate_oid


def soak_watch(path: Path, args: argparse.Namespace) -> dict:
    failures = []
    pending = None

    def inner() -> dict:
        nonlocal pending
        # Only a LIVE soak is selectable. soak_green/soak_red are terminal, and
        # including them meant the walk fell through to an already-decided
        # candidate and re-reported it forever: the 08-05 rollback sat in
        # soak_red for a day and a half, re-selected hourly, exiting 1 every
        # time, about a binary that had not been live since the day before.
        # A terminal verdict is a verdict — do not re-litigate it.
        current = choose_soak_candidate(path, args.sha, {"dogfood_green", "soak_started"})
        candidate = str(current.get("candidate", ""))
        version = str(current.get("version") or "")
        observed_sha = str(current.get("observed_sha") or candidate)

        # Live binary must still be the dogfooded canary (skip in dry-run/stub).
        if not args.dry_run:
            live = live_version()
            if live == "__fail__" or (live and not version_matches(live, version, candidate)):
                failures.append(
                    f"live_version_mismatch live={live or 'unknown'} want={version or candidate}"
                )
            # observed_sha from cutover is the live version string when set.
            if observed_sha and observed_sha != candidate and live and observed_sha not in live and live not in observed_sha:
                if not version_matches(live, version, candidate):
                    failures.append(f"sha_mismatch_expected_{observed_sha}_live_{live}")
        else:
            # Dry-run only: preserve old observed_sha == candidate equality check when set differently.
            if observed_sha != candidate and not str(current.get("version") or ""):
                failures.append(f"sha_mismatch_expected_{candidate}_observed_{observed_sha}")

        latest = latest_by_candidate(load_events(path)).get(candidate, current)
        state = str(latest.get("state", ""))
        identity_now = primary_identity(args.dry_run)
        if state == "dogfood_green":
            # Establishment tick. Never append a soak_started row WITHOUT an
            # identity baseline: the 2026-08-30 red
            # (lx-20260830T221122.295-20948-1) was this code stamping a
            # baseline-less row while the just-cut-over node was still
            # warming up, then hard-failing one branch later on
            # `primary_identity_baseline_missing` — the baseline it had
            # itself declined to write. A blind probe inside the settle
            # grace defers the soak start (soak_pending; the state machine
            # re-ticks in 1h with a warm node); past the grace it is a real
            # failure — a probe that stays blind cannot certify a 24h soak.
            if identity_now is None and not failures:
                green_ts = event_ts_for_state(path, candidate, "dogfood_green")
                grace_min = settle_grace_minutes()
                within_grace = False
                if green_ts is not None and grace_min > 0:
                    if green_ts.tzinfo is None:
                        green_ts = green_ts.replace(tzinfo=dt.timezone.utc)
                    elapsed_s = (dt.datetime.now(dt.timezone.utc) - green_ts).total_seconds()
                    within_grace = elapsed_s < grace_min * 60.0
                if within_grace:
                    pending = {
                        "candidate": candidate,
                        "state": "dogfood_green",
                        "evidence": "soak_settling primary_identity_unavailable",
                    }
                    return latest
                append_transition(path, candidate, "soak_started", observed_sha=observed_sha)
                return append_transition(
                    path,
                    candidate,
                    "soak_red",
                    observed_sha=observed_sha,
                    evidence=f"primary_identity_unavailable_past_settle_grace_{grace_min:g}m",
                )
            identity_extra = {}
            if identity_now is not None:
                identity_extra = {
                    "primary_pid": identity_now[0],
                    "primary_start_ts": identity_now[1],
                    "primary_build": identity_now[2],
                }
            latest = append_transition(
                path,
                candidate,
                "soak_started",
                observed_sha=observed_sha,
                **identity_extra,
            )
            state = "soak_started"
        if state not in {"soak_started", "soak_green", "soak_red"}:
            die(f"cannot soak-watch {candidate}: current state is {state}")
        if state in {"soak_green", "soak_red"}:
            return latest

        baseline = event_for_state(path, candidate, "soak_started") or {}
        baseline_pid = str(baseline.get("primary_pid", ""))
        baseline_start = str(baseline.get("primary_start_ts", ""))
        if not baseline_pid or not baseline_start:
            failures.append("primary_identity_baseline_missing")
        elif identity_now is None:
            failures.append("primary_identity_unavailable")
        elif identity_now[0] != baseline_pid or identity_now[1] != baseline_start:
            failures.append(
                "primary_restarted["
                f"pid={baseline_pid}->{identity_now[0]}_"
                f"start={baseline_start}->{identity_now[1]}]"
            )

        for label, env_name, default_cmd in CHECKS:
            if not run_check(label, env_name, default_cmd, dry_run=args.dry_run):
                detail = CHECK_FAILURE_DETAIL.get(label)
                failures.append(f"{label}[{detail}]" if detail else label)

        if failures:
            return append_transition(
                path, candidate, "soak_red", observed_sha=observed_sha, evidence=";".join(failures)
            )

        # Enforce soak window (default 24h). Dry-run proof uses LAST_STACK_CANARY_SOAK_HOURS=0.
        hours = soak_hours()
        started = event_ts_for_state(path, candidate, "soak_started") or event_ts_for_state(
            path, candidate, "dogfood_green"
        )
        now = dt.datetime.now(dt.timezone.utc)
        if started is not None and hours > 0:
            if started.tzinfo is None:
                started = started.replace(tzinfo=dt.timezone.utc)
            elapsed_h = (now - started).total_seconds() / 3600.0
            if elapsed_h < hours:
                pending = {
                    "candidate": candidate,
                    "state": "soak_started",
                    "elapsed_h": elapsed_h,
                    "need_h": hours,
                    "evidence": f"soak_pending elapsed_h={elapsed_h:.2f} need_h={hours}",
                }
                return latest

        return append_transition(
            path,
            candidate,
            "soak_green",
            observed_sha=observed_sha,
            evidence=f"all_hard_checks_green soak_h>={hours}",
        )

    try:
        event = lock_and_run(path, inner)
    except NoActiveCandidate:
        # Nothing is soaking. That is the steady state between a promote and the
        # next night's cutover — it is not a failure, and spelling it `exit 1`
        # made the canary lane permanently red in routine health and therefore
        # unreadable. A quiet lane must report quiet.
        print(
            f"SOAK ledger={path} sha=none status=no_active_candidate "
            f"evidence=nothing_to_soak{dry_suffix(args.dry_run)}"
        )
        return {"candidate": "", "state": "no_active_candidate"}
    if pending is not None:
        print(
            f"SOAK ledger={path} sha={pending['candidate']} status=soak_pending "
            f"evidence={pending['evidence']}{dry_suffix(args.dry_run)}"
        )
        return current_record(event)
    status = event.get("state", "")
    evidence = event.get("evidence", "all_hard_checks_green" if status == "soak_green" else "")
    print(
        f"SOAK ledger={path} sha={event.get('candidate')} status={status} "
        f"evidence={evidence}{dry_suffix(args.dry_run)}"
    )
    if status != "soak_green":
        raise SystemExit(1)
    return current_record(event)


def promote_prepare(path: Path, args: argparse.Namespace) -> dict:
    promote_output = ""

    def write_promote_material(event: dict) -> Path:
        candidate = str(event.get("candidate", ""))
        evidence = str(event.get("evidence", ""))
        output_dir = args.promote_root.expanduser() / dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d")
        output_dir.mkdir(parents=True, exist_ok=True)
        output = output_dir / "PROMOTE.md"
        output.write_text(
            "\n".join(
                [
                    "# LastDB Canary Promote Prepare",
                    "",
                    f"- Generated: {utc_now()}",
                    f"- Candidate SHA: `{candidate}`",
                    f"- Ledger: `{path}`",
                    "- Required state: `soak_green`",
                    "- Automation pushed stable tag: `false`",
                    "",
                    "## Checks Performed",
                    "",
                    f"- Confirmed `{candidate}` reached `soak_green` in the canary ledger.",
                    f"- Soak evidence: `{evidence or 'not-recorded'}`",
                    "- Wrote promotion material only; no push, artifact-promotion command, or stable tag mutation was run.",
                    "",
                    "## Manual Stable Promotion",
                    "",
                    f"1. Review this file and the soak ledger for `{candidate}`.",
                    "2. If Tom approves, promote the stable artifact/tag manually from a supervised shell.",
                    "3. Record the promotion outcome in the canary ledger.",
                    "",
                ]
            ),
            encoding="utf-8",
        )
        return output

    def inner() -> dict:
        # soak_red is not a promote input. Selecting it only produced an hourly
        # `status=blocked soak_status=soak_red` about a candidate that was never
        # going to promote — noise that outlived the candidate by days.
        current = choose_soak_candidate(path, args.sha, {"soak_green", "promote_prepare"})
        state = str(current.get("state", ""))
        candidate = str(current.get("candidate", ""))
        if state == "promote_prepare":
            return current
        if state != "soak_green":
            return current
        if args.dry_run:
            return current
        return append_transition(path, candidate, "promote_prepare", evidence=str(current.get("evidence", "")))

    try:
        event = lock_and_run(path, inner)
    except NoActiveCandidate:
        print(
            f"PROMOTE_READY ledger={path} sha=none status=no_active_candidate "
            f"evidence=nothing_awaiting_promote{dry_suffix(args.dry_run)}"
        )
        return {"candidate": "", "state": "no_active_candidate"}
    state = str(event.get("state", ""))
    candidate = str(event.get("candidate", ""))
    evidence = str(event.get("evidence", ""))
    if state in {"soak_green", "promote_prepare"}:
        output = write_promote_material(event)
        promote_output = str(output)
        if not args.dry_run and not args.no_notify:
            notify_cmd = ["ra", "notify", f"LastDB canary promote-prepare ready for {candidate}: {output}", "--priority", "high"]
            try:
                subprocess.run(notify_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            except FileNotFoundError:
                pass
        print(
            f"PROMOTE_READY ledger={path} sha={candidate} status=ready evidence={evidence} "
            f"output={promote_output}{dry_suffix(args.dry_run)}"
        )
        return current_record(event)
    print(f"PROMOTE_READY ledger={path} sha={candidate} status=blocked soak_status={state} evidence={evidence}")
    raise SystemExit(1)



def next_stable_tag_from_canary(version: str) -> str:
    """Map 0.23.4-canary.DATE or 0.23.4 to next public stable vX.Y.Z."""
    version = version.lstrip("v")
    base = version.split("-")[0]
    parts = base.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        # Fallback: use date stamp.
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d")
        return f"v0.0.{stamp}"
    # If this exact stable already exists on GH, callers recompute; default = base as stable.
    return f"v{parts[0]}.{parts[1]}.{parts[2]}"


def latest_stable_tag() -> str | None:
    url = os.environ.get(
        "LAST_STACK_CANARY_RELEASES_URL",
        "https://api.github.com/repos/EdgeVector/homebrew-lastdb/releases?per_page=30",
    )
    try:
        import urllib.request

        req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None
    if not isinstance(data, list):
        return None
    for rel in data:
        if not isinstance(rel, dict):
            continue
        if rel.get("prerelease") or rel.get("draft"):
            continue
        tag = str(rel.get("tag_name") or "")
        if tag.startswith("v") and "-" not in tag:
            return tag
    return None


def bump_patch(tag: str) -> str:
    tag = tag.lstrip("v")
    parts = tag.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        return f"v{tag}"
    return f"v{parts[0]}.{parts[1]}.{int(parts[2]) + 1}"


def resolve_stable_tag(canary_version: str) -> str:
    """Prefer next patch after latest stable if canary base already released."""
    base = next_stable_tag_from_canary(canary_version)
    latest = latest_stable_tag()
    if latest is None:
        return base
    # If base <= latest (same or older), bump.
    def tup(t: str):
        t = t.lstrip("v")
        a, b, c = t.split(".")
        return int(a), int(b), int(c)

    try:
        if tup(base) <= tup(latest):
            return bump_patch(latest)
    except Exception:
        return bump_patch(latest)
    return base


def canary_builds_root() -> Path:
    env = os.environ.get("LAST_STACK_CANARY_BUILDS_DIR")
    if env:
        return Path(env)
    return Path.home() / ".local" / "state" / "last-stack" / "canary-builds"


def stage_local_canary_assets(version: str, dest: Path, *, preferred_oid: str = "") -> dict | None:
    """Copy a local Forge canary package into dest when one is staged.

    Looks under ~/.local/state/last-stack/canary-builds/<oid>/ for a full
    package (tar.gz + manifest) or at least a lastdbd + manifest. Returns the
    manifest dict, or None when nothing usable is staged.
    """
    dest.mkdir(parents=True, exist_ok=True)
    builds = canary_builds_root()
    if not builds.is_dir():
        return None

    oid = preferred_oid.strip() or canary_source_oid(version)
    search_dirs: list[Path] = []
    if oid:
        search_dirs.append(builds / oid)
        # short prefixes
        for child in sorted(builds.iterdir(), reverse=True):
            if child.is_dir() and (oid.startswith(child.name) or child.name.startswith(oid[:12])):
                search_dirs.append(child)
    else:
        search_dirs.extend(sorted(builds.iterdir(), reverse=True))

    seen: set[Path] = set()
    for d in search_dirs:
        if not d.is_dir() or d in seen:
            continue
        seen.add(d)
        man_path = None
        for name in ("lastdb-aarch64-apple-darwin.manifest.json", "manifest.json"):
            if (d / name).is_file():
                man_path = d / name
                break
        if man_path is None:
            continue
        try:
            manifest = json.loads(man_path.read_text(encoding="utf-8"))
        except Exception:
            continue
        # Copy package files into dest
        for item in d.iterdir():
            if item.is_file():
                target = dest / item.name
                target.write_bytes(item.read_bytes())
        # Normalize manifest name for promote script
        std = dest / "lastdb-aarch64-apple-darwin.manifest.json"
        if not std.is_file():
            std.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        return manifest if isinstance(manifest, dict) else {"source_git_oid": oid}
    return None


def download_canary_assets(version: str, dest: Path, *, preferred_oid: str = "") -> dict:
    """Resolve canary package assets into dest.

    Prefer a **local Forge-staged** package under canary-builds/ (local-canonical).
    Fall back to GitHub Releases only as public CDN for the same version tag —
    never required when local assets are present.
    """
    dest.mkdir(parents=True, exist_ok=True)
    local = stage_local_canary_assets(version, dest, preferred_oid=preferred_oid)
    if local is not None:
        return local

    if os.environ.get("LAST_STACK_CANARY_ALLOW_GITHUB", "0") != "1" and not os.environ.get(
        "LAST_STACK_CANARY_RELEASES_JSON"
    ):
        # GH is opt-in for promote asset fetch too; local package is the gate of record.
        die(
            f"no local canary package staged for version={version} oid={preferred_oid or 'unknown'}; "
            f"stage under {canary_builds_root()}/<source_git_oid>/ "
            "(tar.gz + manifest) or set LAST_STACK_CANARY_ALLOW_GITHUB=1 to fetch the public CDN"
        )

    tag = version if version.startswith("v") else f"v{version}"
    api_base = os.environ.get("LAST_STACK_CANARY_ASSET_API_BASE", "https://api.github.com").rstrip("/")
    repo = os.environ.get("LAST_STACK_CANARY_ASSET_REPO", "EdgeVector/homebrew-lastdb")
    api = f"{api_base}/repos/{repo}/releases/tags/{tag}"
    import urllib.request

    headers = {"Accept": "application/vnd.github+json"}
    token = os.environ.get("GH_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(api, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as resp:
        release = json.loads(resp.read().decode("utf-8"))
    assets = release.get("assets") or []
    manifest = {}
    for asset in assets:
        name = asset.get("name") or ""
        url = asset.get("browser_download_url") or ""
        if not name or not url:
            continue
        target = dest / name
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=120) as resp:
            target.write_bytes(resp.read())
        if name.endswith("manifest.json"):
            try:
                manifest = json.loads(target.read_text(encoding="utf-8"))
            except Exception:
                manifest = {}
    return manifest


def find_fold_promote_script() -> Path | None:
    env = os.environ.get("LAST_STACK_CANARY_FORGE_PROMOTE")
    if env and Path(env).is_file():
        return Path(env)
    home = Path.home()
    candidates = [
        home / "code/edgevector/fold/scripts/release/forge-promote-homebrew-stable.sh",
    ]
    # Prefer a recent worktree if portal has no scripts
    wt_root = home / "code/edgevector/.routine-worktrees"
    if wt_root.is_dir():
        for p in sorted(wt_root.glob("*/scripts/release/forge-promote-homebrew-stable.sh"), reverse=True):
            candidates.append(p)
    for c in candidates:
        if c.is_file():
            return c
    return None


def promote_execute(path: Path, args: argparse.Namespace) -> dict:
    """Auto-promote soak_green canary using local-canonical brew promote path.

    Stages local Forge canary package assets (preferred) then republishes as the
    next stable tag via forge-promote-homebrew-stable.sh --publish. GitHub is
    only the public bottle CDN; GH asset download is opt-in when no local
    package is staged. Requires GH_TOKEN for the public CDN publish step.
    """
    auto = os.environ.get("LAST_STACK_CANARY_PROMOTE_AUTO", "0") == "1" or args.force
    if not auto and not args.dry_run:
        die("promote-execute refuses without LAST_STACK_CANARY_PROMOTE_AUTO=1 (or --force)")

    # promote-execute is an explicit, publishing action — unlike the watchers it
    # is not a lane that may legitimately be idle, so "nothing to promote" here
    # is a real error and stays one.
    try:
        current = choose_soak_candidate(path, args.sha, {"soak_green", "promote_prepare", "promoted"})
    except NoActiveCandidate:
        die("promote-execute: no candidate has passed soak")
    state = str(current.get("state", ""))
    candidate = str(current.get("candidate", ""))
    version = str(current.get("version") or "")
    preferred_oid = str(current.get("source_git_oid") or "")
    if state == "promoted":
        print(f"PROMOTE_EXECUTE ledger={path} sha={candidate} status=already_promoted")
        return current_record(current)
    if state not in {"soak_green", "promote_prepare"}:
        print(f"PROMOTE_EXECUTE ledger={path} sha={candidate} status=blocked soak_status={state}")
        raise SystemExit(1)

    # Live still on canary (skip in dry-run).
    if not args.dry_run:
        live = live_version()
        if live and not version_matches(live, version, candidate):
            die(f"refuse promote: live={live} not on canary version={version}")
        # Defence in depth: re-assert ancestry against the binary this release
        # would supersede. Fails closed on unknown — a public brew release is
        # not the place to assume ordering.
        assert_not_rollback(version, candidate, strict_unknown=True, stage="promote")

    stable_tag = resolve_stable_tag(version or candidate)
    output_dir = args.promote_root.expanduser() / dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d")
    output_dir.mkdir(parents=True, exist_ok=True)
    report = output_dir / f"PROMOTE-EXECUTE-{stable_tag}.md"
    artifact_dir = output_dir / f"artifacts-{stable_tag}"

    if args.dry_run:
        report.write_text(
            "\n".join(
                [
                    "# LastDB Canary Promote Execute (dry-run)",
                    f"- Generated: {utc_now()}",
                    f"- Candidate: `{candidate}`",
                    f"- Canary version: `{version}`",
                    f"- Planned stable tag: `{stable_tag}`",
                    "- Automation pushed stable tag: `false` (dry-run)",
                    "- Would stage local Forge canary package (or opt-in GH CDN) and run forge-promote-homebrew-stable.sh --publish",
                    "",
                ]
            ),
            encoding="utf-8",
        )
        print(
            f"PROMOTE_EXECUTE ledger={path} sha={candidate} status=ready_dry_run "
            f"stable_tag={stable_tag} output={report} dry_run=1 stable_mutation=false"
        )
        return current_record(current)

    # Mark prepare then execute.
    if state == "soak_green":
        lock_and_run(
            path,
            lambda: append_transition(path, candidate, "promote_prepare", evidence="auto-promote-start"),
        )

    try:
        manifest = download_canary_assets(version, artifact_dir, preferred_oid=preferred_oid)
    except SystemExit:
        raise
    except Exception as exc:
        die(f"failed to resolve canary assets for {version}: {exc}")

    source_oid = str(manifest.get("source_git_oid") or preferred_oid or "")
    promote_sh = find_fold_promote_script()
    if promote_sh is None:
        die("forge-promote-homebrew-stable.sh not found; set LAST_STACK_CANARY_FORGE_PROMOTE")

    env = os.environ.copy()
    if not env.get("GH_TOKEN"):
        # Best-effort: gh auth token (CDN publish only — build is local)
        gh = subprocess.run(["gh", "auth", "token"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if gh.returncode == 0 and gh.stdout.strip():
            env["GH_TOKEN"] = gh.stdout.strip()
    if not env.get("GH_TOKEN"):
        die("GH_TOKEN required for promote-execute --publish (public bottle CDN only)")

    cmd = [
        "bash",
        str(promote_sh),
        "--publish",
        "--version-tag",
        stable_tag,
        "--artifact-dir",
        str(artifact_dir),
        "--proof-report",
        str(output_dir / f"proof-{stable_tag}.json"),
    ]
    if source_oid:
        cmd.extend(["--source-git-oid", source_oid])

    proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    report.write_text(
        "\n".join(
            [
                "# LastDB Canary Promote Execute",
                f"- Generated: {utc_now()}",
                f"- Candidate: `{candidate}`",
                f"- Canary version: `{version}`",
                f"- Stable tag: `{stable_tag}`",
                f"- source_git_oid: `{source_oid or 'unknown'}`",
                f"- promote_rc: `{proc.returncode}`",
                f"- Automation pushed stable tag: `{'true' if proc.returncode == 0 else 'false'}`",
                "",
                "## stdout",
                "```",
                (proc.stdout or "")[-8000:],
                "```",
                "",
                "## stderr",
                "```",
                (proc.stderr or "")[-4000:],
                "```",
                "",
            ]
        ),
        encoding="utf-8",
    )
    if proc.returncode != 0:
        print(
            f"PROMOTE_EXECUTE ledger={path} sha={candidate} status=failed "
            f"stable_tag={stable_tag} rc={proc.returncode} output={report}"
        )
        raise SystemExit(proc.returncode)

    def mark_promoted() -> dict:
        latest = latest_by_candidate(load_events(path)).get(candidate, {})
        st = str(latest.get("state", ""))
        if st == "promoted":
            return latest
        if st == "soak_green":
            append_transition(path, candidate, "promote_prepare", evidence="auto-promote")
        return append_transition(
            path,
            candidate,
            "promoted",
            evidence=f"stable_tag={stable_tag}",
            note=f"promoted {stable_tag}",
        )

    event = lock_and_run(path, mark_promoted)
    if not args.no_notify:
        try:
            subprocess.run(
                [
                    "ra",
                    "notify",
                    f"LastDB auto-promoted {candidate} → {stable_tag} (brew public)",
                    "--priority",
                    "high",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except FileNotFoundError:
            pass
    print(
        f"PROMOTE_EXECUTE ledger={path} sha={candidate} status=promoted "
        f"stable_tag={stable_tag} output={report} stable_mutation=true"
    )
    return current_record(event)


def proof(args: argparse.Namespace) -> None:

    if not args.dry_run:
        die("proof currently requires --dry-run", 2)
    tmp = tempfile.mkdtemp(prefix="last-stack-canary-proof.")
    path = Path(tmp) / "ledger.jsonl"
    promote_root = Path(tmp) / "canary-promote"
    sha = "dryrun-canary-sha"
    dogfood_candidate(
        path,
        argparse.Namespace(sha=sha, observed_sha="", version="dry-run", source="proof", dry_run=True),
    )
    env = {
        "LAST_STACK_CANARY_LAUNCHD_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_MEMORY_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_BOARD_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_BOARD_WRITE_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_SITUATION_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_SOAK_HOURS": "0",
        "LAST_STACK_CANARY_LIVE_VERSION_CMD": "pass",
    }
    old_env = {key: os.environ.get(key) for key in env}
    os.environ.update(env)
    try:
        soak_watch(path, argparse.Namespace(sha=sha, dry_run=True))
    finally:
        for key, value in old_env.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
    promote_prepare(
        path,
        argparse.Namespace(sha=sha, dry_run=True, promote_root=promote_root, no_notify=True),
    )
    promote_files = sorted(promote_root.glob("*/PROMOTE.md"))
    if not promote_files:
        die("dry-run proof did not write PROMOTE.md")
    promote_text = promote_files[-1].read_text(encoding="utf-8")
    if f"Candidate SHA: `{sha}`" not in promote_text:
        die("dry-run PROMOTE.md did not record the soaked SHA")
    if "Automation pushed stable tag: `false`" not in promote_text:
        die("dry-run PROMOTE.md did not record stable-tag safety")
    print(
        "CANARY_PIPELINE_PROOF result=ok dry_run=1 "
        f"ledger={path} promote_output={promote_files[-1]} no_primary_mutation=1 stable_mutation=false"
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    path = ledger_path(args)
    if args.command == "create":
        emit(create_candidate(path, args), args.json)
    elif args.command == "read":
        emit(read_candidate(path, args), args.json)
    elif args.command == "advance":
        emit(advance_candidate(path, args), args.json)
    elif args.command == "list":
        emit(list_candidates(path), args.json)
    elif args.command == "dogfood":
        dogfood_candidate(path, args)
    elif args.command == "soak-watch":
        soak_watch(path, args)
    elif args.command == "promote-prepare":
        promote_prepare(path, args)
    elif args.command == "promote-execute":
        promote_execute(path, args)
    elif args.command == "proof":
        proof(args)
    else:
        die("unknown command", 2)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
