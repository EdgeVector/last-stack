#!/usr/bin/env python3
"""Append-only ledger for the LastDB nightly canary pipeline."""
import argparse
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


STATES = (
    "candidate_found",
    "dogfood_started",
    "dogfood_green",
    "dogfood_red",
    "soak_started",
    "soak_green",
    "soak_red",
    "promote_prepare",
)

ALLOWED = {
    "candidate_found": {"dogfood_started"},
    "dogfood_started": {"dogfood_green", "dogfood_red"},
    "dogfood_green": {"soak_started"},
    "dogfood_red": set(),
    "soak_started": {"soak_green", "soak_red"},
    "soak_green": {"promote_prepare"},
    "soak_red": set(),
    "promote_prepare": set(),
}

CHECKS = (
    ("launchd", "LAST_STACK_CANARY_LAUNCHD_CHECK_CMD", 'launchctl print "gui/$UID/com.edgevector.lastdbd"'),
    ("memory_guard", "LAST_STACK_CANARY_MEMORY_CHECK_CMD", "lastdb status"),
    ("board_read", "LAST_STACK_CANARY_BOARD_CHECK_CMD", "kanban ping"),
    ("situation_fence", "LAST_STACK_CANARY_SITUATION_CHECK_CMD", 'situations list --json | jq -e "length == 0"'),
)


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def default_state_dir() -> Path:
    raw = os.environ.get("LAST_STACK_CANARY_PIPELINE_DIR")
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".local" / "state" / "last-stack" / "canary-pipeline"


def default_promote_root() -> Path:
    raw = os.environ.get("LAST_STACK_CANARY_PROMOTE_DIR")
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".local" / "state" / "last-stack" / "canary-promote"


def add_common_ledger_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--ledger", dest="command_ledger", type=Path, default=None)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="last-stack-canary-pipeline",
        description="Record and validate LastDB canary pipeline lifecycle transitions.",
    )
    parser.add_argument("--state-dir", type=Path, default=default_state_dir())
    parser.add_argument("--ledger", type=Path, default=None)
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON")

    sub = parser.add_subparsers(dest="command", required=True)

    create = sub.add_parser("create", help="create a new candidate at candidate_found")
    create.add_argument("candidate")
    create.add_argument("--version", default="")
    create.add_argument("--source", default="")
    create.add_argument("--note", default="")

    read = sub.add_parser("read", help="read the current state for one candidate")
    read.add_argument("candidate")

    advance = sub.add_parser("advance", help="append a valid transition for one candidate")
    advance.add_argument("candidate")
    advance.add_argument("state", choices=STATES)
    advance.add_argument("--note", default="")

    sub.add_parser("list", help="list latest state for every candidate")

    dogfood = sub.add_parser("dogfood", help="record a dogfooded canary SHA")
    add_common_ledger_flags(dogfood)
    dogfood.add_argument("--sha", required=True)
    dogfood.add_argument("--observed-sha", default="")
    dogfood.add_argument("--version", default="")
    dogfood.add_argument("--source", default="dogfood")
    dogfood.add_argument("--dry-run", action="store_true")

    soak = sub.add_parser("soak-watch", help="evaluate hard health signals for a dogfooded SHA")
    add_common_ledger_flags(soak)
    soak.add_argument("--sha", default="")
    soak.add_argument("--dry-run", action="store_true")

    promote = sub.add_parser("promote-prepare", help="report whether a green soak is ready for promotion")
    add_common_ledger_flags(promote)
    promote.add_argument("--sha", default="")
    promote.add_argument("--dry-run", action="store_true")
    promote.add_argument("--promote-root", type=Path, default=default_promote_root())
    promote.add_argument("--no-notify", action="store_true")

    proof = sub.add_parser("proof", help="exercise dogfood, soak-watch, and promote-prepare offline")
    proof.add_argument("--dry-run", action="store_true")

    return parser.parse_args(argv)


def ledger_path(args: argparse.Namespace) -> Path:
    command_ledger = getattr(args, "command_ledger", None)
    if command_ledger is not None:
        return command_ledger.expanduser()
    if args.ledger is not None:
        return args.ledger.expanduser()
    return args.state_dir.expanduser() / "ledger.jsonl"


def die(message: str, code: int = 1) -> None:
    print(f"last-stack-canary-pipeline: {message}", file=sys.stderr)
    raise SystemExit(code)


def load_events(path: Path) -> list[dict]:
    if not path.exists():
        return []
    events = []
    with path.open("r", encoding="utf-8") as fh:
        for lineno, line in enumerate(fh, start=1):
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError as exc:
                die(f"invalid ledger JSON at {path}:{lineno}: {exc}")
            if not isinstance(event, dict):
                die(f"invalid ledger event at {path}:{lineno}: not an object")
            events.append(event)
    return events


def latest_by_candidate(events: list[dict]) -> dict[str, dict]:
    latest = {}
    for event in events:
        candidate = str(event.get("candidate", ""))
        if candidate:
            latest[candidate] = event
    return latest


def append_event(path: Path, event: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n"
    fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
    try:
        os.write(fd, payload.encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)


def lock_and_run(path: Path, fn):
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_suffix(path.suffix + ".lock")
    with lock_path.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        return fn()


def current_record(event: dict) -> dict:
    return {
        "candidate": event.get("candidate", ""),
        "state": event.get("state", ""),
        "version": event.get("version", ""),
        "source": event.get("source", ""),
        "updated_at": event.get("ts", ""),
        "note": event.get("note", ""),
        "observed_sha": event.get("observed_sha", ""),
        "evidence": event.get("evidence", ""),
    }


def emit_record(value: dict) -> None:
    print(
        "candidate={candidate} state={state} version={version} source={source} updated_at={updated_at}".format(
            **value
        )
    )


def emit(value, as_json: bool) -> None:
    if as_json:
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        return
    if isinstance(value, list):
        for item in value:
            emit_record(item)
    else:
        emit_record(value)


def base_event(candidate: str, state: str, previous_state: str = "", **extra) -> dict:
    event = {
        "ts": utc_now(),
        "candidate": candidate,
        "state": state,
    }
    if previous_state:
        event["previous_state"] = previous_state
    event.update({key: value for key, value in extra.items() if value != ""})
    return event


def create_candidate(path: Path, args: argparse.Namespace) -> dict:
    def inner() -> dict:
        latest = latest_by_candidate(load_events(path))
        if args.candidate in latest:
            die(f"candidate already exists: {args.candidate}")
        event = base_event(
            args.candidate,
            "candidate_found",
            version=args.version,
            source=args.source,
            note=args.note,
        )
        append_event(path, event)
        return current_record(event)

    return lock_and_run(path, inner)


def read_candidate(path: Path, args: argparse.Namespace) -> dict:
    latest = latest_by_candidate(load_events(path))
    event = latest.get(args.candidate)
    if event is None:
        die(f"candidate not found: {args.candidate}")
    return current_record(event)


def list_candidates(path: Path) -> list[dict]:
    latest = latest_by_candidate(load_events(path))
    return [current_record(latest[candidate]) for candidate in sorted(latest)]


def append_transition(path: Path, candidate: str, state: str, **extra) -> dict:
    events = load_events(path)
    latest = latest_by_candidate(events)
    previous = latest.get(candidate)
    if previous is None:
        die(f"candidate not found: {candidate}; create it first")
    old_state = str(previous.get("state", ""))
    if old_state == state:
        die(f"duplicate transition for {candidate}: already {state}")
    if state not in ALLOWED.get(old_state, set()):
        allowed = ", ".join(sorted(ALLOWED.get(old_state, set()))) or "none"
        die(f"invalid transition for {candidate}: {old_state} -> {state} (allowed: {allowed})")
    event = base_event(
        candidate,
        state,
        previous_state=old_state,
        version=str(previous.get("version", "")),
        source=str(previous.get("source", "")),
        **extra,
    )
    append_event(path, event)
    return event


def advance_candidate(path: Path, args: argparse.Namespace) -> dict:
    def inner() -> dict:
        return current_record(append_transition(path, args.candidate, args.state, note=args.note))

    return lock_and_run(path, inner)


def dry_suffix(enabled: bool) -> str:
    return " dry_run=1 no_primary_mutation=1" if enabled else ""


def dogfood_candidate(path: Path, args: argparse.Namespace) -> dict:
    observed_sha = args.observed_sha or args.sha

    def inner() -> dict:
        latest = latest_by_candidate(load_events(path))
        current = latest.get(args.sha)
        if current is None:
            append_event(
                path,
                base_event(args.sha, "candidate_found", version=args.version, source=args.source),
            )
            append_transition(path, args.sha, "dogfood_started", note="dogfood")
            event = append_transition(path, args.sha, "dogfood_green", observed_sha=observed_sha)
        elif current.get("state") == "candidate_found":
            append_transition(path, args.sha, "dogfood_started", note="dogfood")
            event = append_transition(path, args.sha, "dogfood_green", observed_sha=observed_sha)
        elif current.get("state") == "dogfood_started":
            event = append_transition(path, args.sha, "dogfood_green", observed_sha=observed_sha)
        elif current.get("state") == "dogfood_green" and current.get("observed_sha", args.sha) == observed_sha:
            event = current
        else:
            die(f"cannot dogfood {args.sha}: current state is {current.get('state')}")
        return event

    event = lock_and_run(path, inner)
    print(
        f"DOGFOOD ledger={path} sha={args.sha} observed_sha={observed_sha} "
        f"state={event.get('state')} result=ok{dry_suffix(args.dry_run)}"
    )
    return current_record(event)


def choose_soak_candidate(path: Path, requested_sha: str, wanted_states: set[str]) -> dict:
    events = load_events(path)
    latest = latest_by_candidate(events)
    if requested_sha:
        event = latest.get(requested_sha)
        if event is None:
            die(f"candidate not found: {requested_sha}")
        return event
    for event in reversed(events):
        candidate = str(event.get("candidate", ""))
        if not candidate:
            continue
        latest_event = latest.get(candidate, {})
        if latest_event.get("state") in wanted_states:
            return latest_event
    die("no matching canary candidate found")


def run_check(label: str, env_name: str, default_cmd: str) -> bool:
    command = os.environ.get(env_name, default_cmd)
    if command in ("", "pass", "true", "ok"):
        print(f"CHECK label={label} result=ok mode=stub")
        return True
    if command in ("fail", "false", "red"):
        print(f"CHECK label={label} result=fail mode=stub", file=sys.stderr)
        return False
    result = subprocess.run(command, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if result.returncode == 0:
        print(f"CHECK label={label} result=ok")
        return True
    print(f"CHECK label={label} result=fail", file=sys.stderr)
    return False


def soak_watch(path: Path, args: argparse.Namespace) -> dict:
    failures = []

    def inner() -> dict:
        current = choose_soak_candidate(path, args.sha, {"dogfood_green", "soak_started", "soak_green", "soak_red"})
        candidate = str(current.get("candidate", ""))
        observed_sha = str(current.get("observed_sha") or candidate)
        if observed_sha != candidate:
            failures.append(f"sha_mismatch_expected_{candidate}_observed_{observed_sha}")

        for label, env_name, default_cmd in CHECKS:
            if not run_check(label, env_name, default_cmd):
                failures.append(label)

        latest = latest_by_candidate(load_events(path)).get(candidate, current)
        state = str(latest.get("state", ""))
        if state == "dogfood_green":
            append_transition(path, candidate, "soak_started", observed_sha=observed_sha)
            state = "soak_started"
        if state not in {"soak_started", "soak_green", "soak_red"}:
            die(f"cannot soak-watch {candidate}: current state is {state}")
        if state in {"soak_green", "soak_red"}:
            return latest
        if failures:
            return append_transition(path, candidate, "soak_red", observed_sha=observed_sha, evidence=";".join(failures))
        return append_transition(
            path,
            candidate,
            "soak_green",
            observed_sha=observed_sha,
            evidence="all_hard_checks_green",
        )

    event = lock_and_run(path, inner)
    status = event.get("state", "")
    evidence = event.get("evidence", "all_hard_checks_green" if status == "soak_green" else "")
    print(f"SOAK ledger={path} sha={event.get('candidate')} status={status} evidence={evidence}{dry_suffix(args.dry_run)}")
    if status != "soak_green":
        raise SystemExit(1)
    return current_record(event)


def promote_prepare(path: Path, args: argparse.Namespace) -> dict:
    promote_output = ""

    def write_promote_material(event: dict) -> Path:
        candidate = str(event.get("candidate", ""))
        evidence = str(event.get("evidence", ""))
        output_dir = args.promote_root.expanduser() / dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d")
        output_dir.mkdir(parents=True, exist_ok=True)
        output = output_dir / "PROMOTE.md"
        output.write_text(
            "\n".join(
                [
                    "# LastDB Canary Promote Prepare",
                    "",
                    f"- Generated: {utc_now()}",
                    f"- Candidate SHA: `{candidate}`",
                    f"- Ledger: `{path}`",
                    "- Required state: `soak_green`",
                    "- Automation pushed stable tag: `false`",
                    "",
                    "## Checks Performed",
                    "",
                    f"- Confirmed `{candidate}` reached `soak_green` in the canary ledger.",
                    f"- Soak evidence: `{evidence or 'not-recorded'}`",
                    "- Wrote promotion material only; no push, artifact-promotion command, or stable tag mutation was run.",
                    "",
                    "## Manual Stable Promotion",
                    "",
                    f"1. Review this file and the soak ledger for `{candidate}`.",
                    "2. If Tom approves, promote the stable artifact/tag manually from a supervised shell.",
                    "3. Record the promotion outcome in the canary ledger.",
                    "",
                ]
            ),
            encoding="utf-8",
        )
        return output

    def inner() -> dict:
        current = choose_soak_candidate(path, args.sha, {"soak_green", "soak_red", "promote_prepare"})
        state = str(current.get("state", ""))
        candidate = str(current.get("candidate", ""))
        if state == "promote_prepare":
            return current
        if state != "soak_green":
            return current
        if args.dry_run:
            return current
        return append_transition(path, candidate, "promote_prepare", evidence=str(current.get("evidence", "")))

    event = lock_and_run(path, inner)
    state = str(event.get("state", ""))
    candidate = str(event.get("candidate", ""))
    evidence = str(event.get("evidence", ""))
    if state in {"soak_green", "promote_prepare"}:
        output = write_promote_material(event)
        promote_output = str(output)
        if not args.dry_run and not args.no_notify:
            notify_cmd = ["ra", "notify", f"LastDB canary promote-prepare ready for {candidate}: {output}", "--priority", "high"]
            try:
                subprocess.run(notify_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            except FileNotFoundError:
                pass
        print(
            f"PROMOTE_READY ledger={path} sha={candidate} status=ready evidence={evidence} "
            f"output={promote_output}{dry_suffix(args.dry_run)}"
        )
        return current_record(event)
    print(f"PROMOTE_READY ledger={path} sha={candidate} status=blocked soak_status={state} evidence={evidence}")
    raise SystemExit(1)


def proof(args: argparse.Namespace) -> None:
    if not args.dry_run:
        die("proof currently requires --dry-run", 2)
    tmp = tempfile.mkdtemp(prefix="last-stack-canary-proof.")
    path = Path(tmp) / "ledger.jsonl"
    promote_root = Path(tmp) / "canary-promote"
    sha = "dryrun-canary-sha"
    dogfood_candidate(
        path,
        argparse.Namespace(sha=sha, observed_sha="", version="dry-run", source="proof", dry_run=True),
    )
    env = {
        "LAST_STACK_CANARY_LAUNCHD_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_MEMORY_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_BOARD_CHECK_CMD": "pass",
        "LAST_STACK_CANARY_SITUATION_CHECK_CMD": "pass",
    }
    old_env = {key: os.environ.get(key) for key in env}
    os.environ.update(env)
    try:
        soak_watch(path, argparse.Namespace(sha=sha, dry_run=True))
    finally:
        for key, value in old_env.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
    promote_prepare(
        path,
        argparse.Namespace(sha=sha, dry_run=True, promote_root=promote_root, no_notify=True),
    )
    promote_files = sorted(promote_root.glob("*/PROMOTE.md"))
    if not promote_files:
        die("dry-run proof did not write PROMOTE.md")
    promote_text = promote_files[-1].read_text(encoding="utf-8")
    if f"Candidate SHA: `{sha}`" not in promote_text:
        die("dry-run PROMOTE.md did not record the soaked SHA")
    if "Automation pushed stable tag: `false`" not in promote_text:
        die("dry-run PROMOTE.md did not record stable-tag safety")
    print(
        "CANARY_PIPELINE_PROOF result=ok dry_run=1 "
        f"ledger={path} promote_output={promote_files[-1]} no_primary_mutation=1 stable_mutation=false"
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    path = ledger_path(args)
    if args.command == "create":
        emit(create_candidate(path, args), args.json)
    elif args.command == "read":
        emit(read_candidate(path, args), args.json)
    elif args.command == "advance":
        emit(advance_candidate(path, args), args.json)
    elif args.command == "list":
        emit(list_candidates(path), args.json)
    elif args.command == "dogfood":
        dogfood_candidate(path, args)
    elif args.command == "soak-watch":
        soak_watch(path, args)
    elif args.command == "promote-prepare":
        promote_prepare(path, args)
    elif args.command == "proof":
        proof(args)
    else:
        die("unknown command", 2)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
