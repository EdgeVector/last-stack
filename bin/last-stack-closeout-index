#!/usr/bin/env python3
"""Maintain a stable, point-readable recency pointer to a routine's closeouts.

Closeout records are slugged `closeout-<YYYYMMDD>-<routine>-<hhmm>` with the
AUTHOR'S OWN wall clock in the name, and nothing indexes "the newest closeout
for routine R". So a pass that wants its predecessor's open list has to GUESS
the time component, and a guess that misses returns a stale closeout that
reads exactly like a current one
(papercut-no-stable-pointer-to-a-routines-newest-closeout-so-a-pass-guesses-slugs-and-reads-a-stale-open-list-20261003).

Enumeration is not the instrument: the fleet's PreToolUse hook
`no-brain-list-census.sh` refuses the listing verb outright ("not a census
instrument ... has no completeness contract and is not getting one"). That
hook's own text cites a brain slug that does not resolve, so it is quoted here
rather than cited. `brain ask` ranks by relevance, not recency. `linked_from`
only helps when the newest closeout happened to link a record you already
picked. The only read this fleet trusts for completeness is a point get, so
this tool publishes a fixed slug to point-get:

    closeout-index-<routine>

Verbs:
  record <routine> <closeout-slug>   upsert the index, newest first
  latest <routine>                   print the newest closeout slug
  list   <routine>                   print the retained slugs, newest first

WHY A BOUNDED REWRITE AND NOT `brain append`
An append-only index puts the NEWEST entry at the BOTTOM, and `brain get`
windows a long body at ~40K chars, so for an hourly routine the newest entry
would fall outside the window in about two weeks -- the one entry a recency
pointer exists to serve. (The append-only papercut ledger in this same repo
hit LastDB's 524288-byte atom limit and needed successor chaining:
papercut-reconciler-ledger-reaches-lastdb-atom-limit-20260927.) A bounded,
newest-first rewrite keeps the record small enough that neither limit is ever
in play. `brain put` on a fixed slug is an idempotent upsert that REPLACES the
body -- measured 2026-10-03: first write `created`, second `updated`, the first
body's text gone and the new body round-tripped exactly.

CONCURRENCY: `record` is read-modify-write with no lock. Two routines never
collide because each writes its own `closeout-index-<routine>` slug; two
concurrent passes of the SAME routine can lose one index line to a last-writer
win. That costs a pointer entry, never a closeout, and `latest` still answers
with a real closeout -- so it is left unlocked deliberately.

SAFETY: because the write replaces the whole body, `record` must never rewrite
from a FAILED read -- that would silently truncate the history to one entry.
A genuinely absent record and an unreadable one are distinguished exactly:
absent is rc!=0 plus a stdout JSON `error` of `No <type>: <slug>`. Every other
failure (timeout, backpressure, non-JSON) refuses with exit 4 and writes
nothing.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import subprocess
import sys

RECORD_TYPE = "reference"
DEFAULT_KEEP = 20
INDEX_SLUG_FMT = "closeout-index-{routine}"

# A closeout slug as this fleet writes them. Deliberately permissive about the
# trailing component: the family contains -0750, -2115, -182x and -2145z, and
# that variability is the whole reason this tool exists.
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
ENTRY_RE = re.compile(r"^-\s+(?P<slug>[a-z0-9][a-z0-9-]*)\s*(?:#.*)?$")

# Entries are read ONLY below this marker. Parsing every "- word" bullet in the
# body would let prose above the list be returned as a closeout slug, and
# `latest` returning a word from a sentence is worse than returning nothing:
# the caller would point-get a slug that does not exist and read the miss as
# the closeout being gone.
LIST_MARKER = "## Closeouts, newest first"

BANNER = (
    "This body is GENERATED by `last-stack-closeout-index`. It is a recency\n"
    "pointer, not a document: the list below is rewritten on every `record`,\n"
    "so hand edits to it are overwritten. Read the newest closeout with\n"
    "`last-stack-closeout-index latest {routine}`.\n"
)


def _utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _run(args: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True)


def _absent(proc: subprocess.CompletedProcess, slug: str) -> bool:
    """True only for a definitive 'no such record', never for a failed read."""
    if proc.returncode == 0:
        return False
    try:
        payload = json.loads(proc.stdout)
    except (ValueError, TypeError):
        return False
    if not isinstance(payload, dict):
        return False
    err = payload.get("error")
    if not isinstance(err, str):
        return False
    return err.strip() == f"No {RECORD_TYPE}: {slug}"


def read_index(slug: str) -> list[str] | None:
    """Return retained slugs newest-first, or None when the record is absent.

    Refuses (SystemExit 4) when the record may exist but could not be read.
    """
    proc = _run(["brain", "get", slug, "--type", RECORD_TYPE, "--json"])
    if proc.returncode != 0:
        if _absent(proc, slug):
            return None
        sys.stderr.write(
            f"last-stack-closeout-index: refusing to write: cannot read {slug} "
            f"(rc={proc.returncode}). A rewrite from a failed read would "
            f"truncate the index to one entry.\n"
            f"  stderr: {proc.stderr.strip()[:400]}\n"
        )
        raise SystemExit(4)
    try:
        payload = json.loads(proc.stdout)
        body = payload["body"]
    except (ValueError, TypeError, KeyError) as exc:
        sys.stderr.write(
            f"last-stack-closeout-index: refusing to write: {slug} read back "
            f"unparseable ({exc}). Writing now would truncate the index.\n"
        )
        raise SystemExit(4)
    if not isinstance(body, str):
        sys.stderr.write(
            f"last-stack-closeout-index: refusing to write: {slug} body is not "
            f"text. Writing now would truncate the index.\n"
        )
        raise SystemExit(4)
    lines = body.splitlines()
    try:
        start = next(
            i for i, ln in enumerate(lines) if ln.strip() == LIST_MARKER
        )
    except StopIteration:
        sys.stderr.write(
            f"last-stack-closeout-index: refusing to write: {slug} has no "
            f"{LIST_MARKER!r} marker, so it is not an index this tool wrote. "
            f"Rewriting it would discard whatever it holds.\n"
        )
        raise SystemExit(4)
    out: list[str] = []
    for line in lines[start + 1 :]:
        m = ENTRY_RE.match(line.strip())
        if m:
            out.append(m.group("slug"))
    return out


def render(routine: str, slugs: list[str]) -> str:
    lines = [
        "---",
        f"type: {RECORD_TYPE}",
        f"slug: {INDEX_SLUG_FMT.format(routine=routine)}",
        f"title: Closeout index — {routine} (newest first)",
        "status: active",
        "---",
        "",
        BANNER.format(routine=routine),
        f"Updated: {_utc_now()}",
        "",
        "## Closeouts, newest first",
        "",
    ]
    lines.extend(f"- {s}" for s in slugs)
    lines.append("")
    return "\n".join(lines)


def cmd_record(args: argparse.Namespace) -> int:
    slug = INDEX_SLUG_FMT.format(routine=args.routine)
    existing = read_index(slug)
    retained = list(existing or [])
    # Re-recording a slug moves it to the front rather than duplicating it, so
    # the verb is idempotent and a retried close-out cannot push history out.
    retained = [s for s in retained if s != args.closeout]
    retained.insert(0, args.closeout)
    retained = retained[: args.keep]

    body = render(args.routine, retained)
    proc = subprocess.run(
        ["brain", "put", slug, "--type", RECORD_TYPE],
        input=body,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(
            f"last-stack-closeout-index: brain put {slug} failed "
            f"(rc={proc.returncode}): {proc.stderr.strip()[:400]}\n"
        )
        return 5
    verb = "created" if existing is None else "updated"
    sys.stderr.write(
        f"last-stack-closeout-index: {verb} {slug} "
        f"({len(retained)} retained, newest {args.closeout})\n"
    )
    print(slug)
    return 0


def _read_or_die(routine: str) -> list[str]:
    slug = INDEX_SLUG_FMT.format(routine=routine)
    entries = read_index(slug)
    if entries is None:
        sys.stderr.write(
            f"last-stack-closeout-index: no index yet for {routine} "
            f"({slug} does not exist). The first close-out that runs "
            f"`last-stack-closeout-index record` creates it.\n"
        )
        raise SystemExit(3)
    if not entries:
        sys.stderr.write(
            f"last-stack-closeout-index: {slug} exists but retains no "
            f"closeout slugs.\n"
        )
        raise SystemExit(3)
    return entries


def cmd_latest(args: argparse.Namespace) -> int:
    print(_read_or_die(args.routine)[0])
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    for s in _read_or_die(args.routine):
        print(s)
    return 0


def _routine(value: str) -> str:
    if not SLUG_RE.match(value):
        raise argparse.ArgumentTypeError(
            f"routine name must be lowercase kebab-case, got {value!r}"
        )
    return value


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="last-stack-closeout-index",
        description=(
            "Stable recency pointer to a routine's closeout records, so a pass "
            "point-gets its predecessor instead of guessing slug timestamps."
        ),
    )
    sub = p.add_subparsers(dest="verb", required=True)

    pr = sub.add_parser("record", help="upsert the index with a new closeout slug")
    pr.add_argument("routine", type=_routine)
    pr.add_argument("closeout", type=_routine, help="the closeout slug just written")
    pr.add_argument(
        "--keep",
        type=int,
        default=DEFAULT_KEEP,
        help=f"how many slugs to retain (default {DEFAULT_KEEP})",
    )
    pr.set_defaults(func=cmd_record)

    pl = sub.add_parser("latest", help="print the newest closeout slug")
    pl.add_argument("routine", type=_routine)
    pl.set_defaults(func=cmd_latest)

    pls = sub.add_parser("list", help="print retained closeout slugs, newest first")
    pls.add_argument("routine", type=_routine)
    pls.set_defaults(func=cmd_list)

    args = p.parse_args(argv)
    if getattr(args, "keep", DEFAULT_KEEP) < 1:
        p.error("--keep must be at least 1")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
