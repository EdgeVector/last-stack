#!/usr/bin/env bash
# last-stack-why-stopped-loom — factory freeze classifier via the loom graph.
#
# Same flags / stdout contract as last-stack-why-stopped:
#   last-stack-why-stopped-loom [--json] [--heal] [--quiet]
#   last-stack-why-stopped-loom --status   # stamp for the Bloomberg row
#
# Exit:
#   0  classified (including classes=none / unknown) or --status printed
#   2  usage
#   3  loom unavailable — caller should fall back to last-stack-why-stopped
#   4  loom ran and classified, but its execution did not reach a terminal
#      state. The classification on stdout is real. Do NOT read this as
#      "loom is down": 3 used to cover both, so every reader of the fleet
#      surface was sent to look for a missing binary while loom was up.
set -euo pipefail

JSON=0
HEAL=0
QUIET=0
STATUS=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --heal) HEAL=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --status) STATUS=1; shift ;;
    -h|--help)
      echo "last-stack-why-stopped-loom [--json] [--heal] [--quiet] [--status]"
      exit 0
      ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

STAMP="${LAST_STACK_WHY_STOPPED_STAMP:-$HOME/.last-stack/state/why-stopped-loom.json}"

write_stamp() {
  mkdir -p "$(dirname "$STAMP")"
  ST="$1" EX="${2:-}" CL="${3:-}" KY="${4:-}" RS="${5:-}" LAST_STACK_WHY_STOPPED_STAMP="$STAMP" python3 -c '
import json, os, datetime
p = os.environ["LAST_STACK_WHY_STOPPED_STAMP"]
doc = {
  "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "status": os.environ.get("ST", ""),
  "exec_id": os.environ.get("EX", ""),
  "classes": os.environ.get("CL", ""),
  "key": os.environ.get("KY", ""),
  "reason": os.environ.get("RS", ""),
  "engine": "loom",
}
open(p, "w").write(json.dumps(doc) + "\n")
'
}

print_status() {
  LAST_STACK_WHY_STOPPED_STAMP="$STAMP" python3 -c '
import json, os, sys, datetime
p = os.environ["LAST_STACK_WHY_STOPPED_STAMP"]
if not os.path.isfile(p):
    print(json.dumps({"ok": False, "missing": True, "status": "", "ageH": 99.0}))
    sys.exit(0)
try:
    d = json.load(open(p))
except Exception:
    print(json.dumps({"ok": False, "missing": True, "status": "parse", "ageH": 99.0}))
    sys.exit(0)
ts = d.get("ts") or ""
try:
    t = datetime.datetime.strptime(ts.replace("Z",""), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    age_h = (datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() / 3600.0
except Exception:
    age_h = 99.0
status = str(d.get("status") or "")
print(json.dumps({
    "ok": status == "succeeded",
    "missing": False,
    "status": status,
    "ageH": round(age_h, 4),
    "exec_id": d.get("exec_id") or "",
    "classes": d.get("classes") or "",
    "key": d.get("key") or "",
    "reason": d.get("reason") or "",
}))
'
}

if [ "$STATUS" -eq 1 ]; then
  print_status
  exit 0
fi

# LAST_LOG keeps the most recent log line so an exit can name its own cause.
# --quiet silences the print, never the record: every rc=3 branch below used to
# explain itself on a stream the caller sends to /dev/null, which left eight
# distinct failures indistinguishable as the bare word `unavailable`.
LAST_LOG=""
log() {
  LAST_LOG="$*"
  [ "$QUIET" -eq 1 ] || printf 'why-stopped-loom: %s\n' "$*" >&2
}

# Collapse a captured error text to one short single-line string. The publish
# branches below discarded loom's stderr with 2>/dev/null, so a failed hour
# reported the branch name and never the node's error.
brief() {
  printf '%s' "${1:-}" \
    | tr '\n\t' '  ' \
    | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//' \
    | cut -c1-300
}

# A stable, greppable token for the cause, derived from the log line itself so
# a branch added later still gets a real reason instead of a new blind spot.
reason_token() {
  printf '%s' "${LAST_LOG:-unknown}" \
    | tr 'A-Z' 'a-z' \
    | sed -e 's/[^a-z0-9]\{1,\}/_/g' -e 's/^_//' -e 's/_$//' \
    | cut -c1-60
}

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

if ! command -v loom >/dev/null 2>&1; then
  log "loom not on PATH"
  write_stamp unavailable "" "" "${LOOM_WHY_KEY:-}" "$(reason_token)"
  printf '{"loom":"unavailable","reason":"%s"}\n' "$(reason_token)"
  exit 3
fi
if ! loom ping >/dev/null 2>&1; then
  log "loom ping failed"
  write_stamp unavailable "" "" "${LOOM_WHY_KEY:-}" "$(reason_token)"
  printf '{"loom":"unavailable","reason":"%s"}\n' "$(reason_token)"
  exit 3
fi

exe="$(command -v loom)"
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$exe")"
install_root="$(dirname "$(dirname "$real")")"

defs=""
for cand in \
  "${LOOM_DEFS:-}" \
  "$install_root/definitions" \
  "${HOME}/.loom/definitions"; do
  if [ -n "$cand" ] && [ -f "$cand/why-stopped.json" ] && [ -f "$cand/why-stopped-probe.json" ]; then
    defs="$cand"
    break
  fi
done
if [ -z "$defs" ]; then
  log "why-stopped definitions not found"
  write_stamp unavailable "" "" "${LOOM_WHY_KEY:-}" "$(reason_token)"
  printf '{"loom":"unavailable","reason":"%s"}\n' "$(reason_token)"
  exit 3
fi

if [ -z "${LOOM_SCRIPTS:-}" ] || [ ! -f "${LOOM_SCRIPTS}/loom-why-classify.sh" ]; then
  if [ -f "$install_root/scripts/loom-why-classify.sh" ]; then
    export LOOM_SCRIPTS="$install_root/scripts"
  fi
fi
if [ ! -f "${LOOM_SCRIPTS:-}/loom-why-classify.sh" ]; then
  log "loom-why-classify.sh not in LOOM_SCRIPTS=${LOOM_SCRIPTS:-unset}"
  write_stamp unavailable "" "" "${LOOM_WHY_KEY:-}" "$(reason_token)"
  printf '{"loom":"unavailable","reason":"%s"}\n' "$(reason_token)"
  exit 3
fi

# Publish one definition, keeping loom's stderr instead of sending it to
# /dev/null. The branch name stays the reason token; the cause is its own line.
publish_def() {
  _pd_err="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack-why-stopped-publish.XXXXXX")"
  if loom publish "$1" >/dev/null 2>"$_pd_err"; then
    rm -f "$_pd_err"
    return 0
  fi
  _pd_cause="$(brief "$(cat "$_pd_err" 2>/dev/null || true)")"
  rm -f "$_pd_err"
  # The cause goes out FIRST so LAST_LOG — and therefore the reason token and
  # the stamp — keep the stable branch name. A token that absorbed free-form
  # error text would stop being greppable, which is what it exists for.
  log "loom publish $2 stderr: ${_pd_cause:-no error text}"
  log "loom publish $2 failed"
  write_stamp unavailable "" "" "${LOOM_WHY_KEY:-}" "$(reason_token)"
  printf '{"loom":"unavailable","reason":"%s"}\n' "$(reason_token)"
  return 1
}

publish_def "$defs/why-stopped.json" why-stopped || exit 3
publish_def "$defs/why-stopped-probe.json" why-stopped-probe || exit 3

if [ "$HEAL" -eq 1 ]; then
  export LOOM_WHY_HEAL=1
else
  unset LOOM_WHY_HEAL || true
fi

key="${LOOM_WHY_KEY:-why-stopped-$(date -u +%Y%m%dT%H)}"
input='{"probes":["install","node","forge","pickup"]}'

# Derive the Loom allowance from the routine gate. The fallback matches the
# 45-minute routine default. Reserve five minutes for fallback classification,
# the stamp, and closeout. The observer gate also passes its derived allowance
# as an explicit override so both wrappers use one deadline.
default_gate_timeout_ms=2700000
gate_closeout_reserve_sec=300
gate_timeout_ms="${ROUTINES_GATE_TIMEOUT_MS:-$default_gate_timeout_ms}"
case "$gate_timeout_ms" in ''|*[!0-9]*) gate_timeout_ms="$default_gate_timeout_ms" ;; esac
gate_timeout_sec=$((gate_timeout_ms / 1000))
if [ "$gate_timeout_sec" -gt "$gate_closeout_reserve_sec" ]; then
  default_gate_timeout=$((gate_timeout_sec - gate_closeout_reserve_sec))
else
  default_gate_timeout=1
fi

# Keep an internal margin below the observer's derived deadline.
# The child starts a new session. The Python launcher and the shell traps both
# reap that process group, so an external signal cannot leave `loom drive` at
# PPID 1.
gate_timeout="${LAST_STACK_WHY_STOPPED_LOOM_TIMEOUT_SEC:-$default_gate_timeout}"
timeout_headroom="${LAST_STACK_WHY_STOPPED_LOOM_HEADROOM_SEC:-15}"
case "$gate_timeout" in ''|*[!0-9]*) gate_timeout="$default_gate_timeout" ;; esac
case "$timeout_headroom" in ''|*[!0-9]*) timeout_headroom=15 ;; esac
[ "$gate_timeout" -ge 1 ] || gate_timeout="$default_gate_timeout"
[ "$timeout_headroom" -ge 1 ] || timeout_headroom=15
max_run_timeout=$(( gate_timeout - timeout_headroom ))
[ "$max_run_timeout" -ge 1 ] || max_run_timeout=1
run_timeout="${LAST_STACK_WHY_STOPPED_LOOM_RUN_TIMEOUT_SEC:-$max_run_timeout}"
case "$run_timeout" in ''|*[!0-9]*) run_timeout="$max_run_timeout" ;; esac
[ "$run_timeout" -ge 1 ] || run_timeout="$max_run_timeout"
if [ "$run_timeout" -gt "$max_run_timeout" ]; then
  run_timeout="$max_run_timeout"
fi

if [ -n "${ROUTINES_RUN_DIR:-}" ]; then
  mkdir -p "$ROUTINES_RUN_DIR"
fi
if [ -n "${LAST_STACK_WHY_STOPPED_LOOM_ERR_FILE:-}" ]; then
  loom_err_file="$LAST_STACK_WHY_STOPPED_LOOM_ERR_FILE"
elif [ -n "${ROUTINES_RUN_DIR:-}" ]; then
  loom_err_file="$ROUTINES_RUN_DIR/why-stopped-loom.err"
else
  loom_err_file="$(mktemp "${TMPDIR:-/tmp}/last-stack-why-stopped-loom.XXXXXX")"
fi
loom_pgid_file="$(mktemp "${ROUTINES_RUN_DIR:-${TMPDIR:-/tmp}}/why-stopped-loom-pgid.XXXXXX")"

cleanup_loom_group() {
  LOOM_PGID_FILE="$loom_pgid_file" python3 -c '
import os, signal, time
from pathlib import Path

path = Path(os.environ["LOOM_PGID_FILE"])
try:
    pgid = int(path.read_text(encoding="utf-8").strip())
except (FileNotFoundError, ValueError):
    pgid = 0
if pgid > 0:
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 0.5
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            break
        time.sleep(0.05)
    else:
        try:
            os.killpg(pgid, signal.SIGKILL)
        except ProcessLookupError:
            pass
try:
    path.unlink()
except FileNotFoundError:
    pass
' 2>/dev/null || true
}

cancel_loom_execution() {
  cancel_exec_id="$1"
  [ -n "$cancel_exec_id" ] || return 1
  cancel_timeout="${LAST_STACK_WHY_STOPPED_LOOM_CANCEL_TIMEOUT_SEC:-10}"
  case "$cancel_timeout" in ''|*[!0-9]*) cancel_timeout=10 ;; esac
  [ "$cancel_timeout" -ge 1 ] || cancel_timeout=10
  CANCEL_EXEC_ID="$cancel_exec_id" CANCEL_TIMEOUT="$cancel_timeout" python3 -c '
import os
import subprocess

try:
    result = subprocess.run(
        ["loom", "cancel", os.environ["CANCEL_EXEC_ID"]],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=int(os.environ["CANCEL_TIMEOUT"]),
        check=False,
    )
except subprocess.TimeoutExpired:
    raise SystemExit(1)
raise SystemExit(result.returncode)
'
}

on_loom_signal() {
  signal_name="$1"
  cleanup_loom_group
  loom_last_line="$(tail -n 1 "$loom_err_file" 2>/dev/null || true)"
  log "loom timeout signal=$signal_name loom_stderr=${loom_last_line:-none}"
  exit 124
}

trap cleanup_loom_group EXIT
trap 'on_loom_signal TERM' TERM
trap 'on_loom_signal INT' INT

: >"$loom_err_file"
log "loom run why-stopped --key $key timeout=${run_timeout}s"

set +e
view="$(python3 - "$run_timeout" "$loom_err_file" "$loom_pgid_file" "$key" "$input" <<'PY'
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

timeout_sec = int(sys.argv[1])
stderr_path = Path(sys.argv[2])
pgid_path = Path(sys.argv[3])
key = sys.argv[4]
run_input = sys.argv[5]

with stderr_path.open("a", encoding="utf-8") as stderr_file:
    process = subprocess.Popen(
        ["loom", "run", "why-stopped", "--key", key, "--input", run_input],
        stdout=subprocess.PIPE,
        stderr=stderr_file,
        text=True,
        start_new_session=True,
    )
    pgid_path.write_text(str(process.pid), encoding="utf-8")

    def clear_pgid_file():
        try:
            pgid_path.unlink()
        except FileNotFoundError:
            pass

    def stop_group():
        def group_exists():
            try:
                os.killpg(process.pid, 0)
                return True
            except ProcessLookupError:
                return False

        if not group_exists():
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + 0.5
        while time.monotonic() < deadline:
            if not group_exists():
                return
            time.sleep(0.05)
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            pass

    def handle_signal(signum, _frame):
        stop_group()
        clear_pgid_file()
        raise SystemExit(124 if signum == signal.SIGTERM else 130)

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    try:
        stdout, _ = process.communicate(timeout=timeout_sec)
    except subprocess.TimeoutExpired as exc:
        partial = exc.stdout or ""
        if isinstance(partial, bytes):
            partial = partial.decode("utf-8", errors="replace")
        stop_group()
        clear_pgid_file()
        sys.stdout.write(partial)
        raise SystemExit(124)

    clear_pgid_file()
    sys.stdout.write(stdout)
    raise SystemExit(process.returncode if process.returncode >= 0 else 124)
PY
)"
lrc=$?
set -e
if [ "$lrc" -eq 124 ] || [ "$lrc" -eq 130 ]; then
  loom_last_line="$(tail -n 1 "$loom_err_file" 2>/dev/null || true)"
  log "loom timeout after ${run_timeout}s loom_stderr=${loom_last_line:-none}"
  timeout_reason="$(reason_token)"
  timeout_exec_id="$(printf '%s\n' "$view" | awk 'NF{print; exit}')"
  cancel_state="unavailable"
  if cancel_loom_execution "$timeout_exec_id"; then
    cancel_state="cancelled"
    log "cancelled abandoned loom execution $timeout_exec_id"
  elif [ -n "$timeout_exec_id" ]; then
    cancel_state="failed"
    log "could not cancel abandoned loom execution $timeout_exec_id"
  else
    log "could not identify the abandoned loom execution"
  fi
  write_stamp timeout "$timeout_exec_id" "" "$key" "$timeout_reason"
  LOOM_TIMEOUT_REASON="$timeout_reason" \
    LOOM_TIMEOUT_DETAIL="${loom_last_line:-none}" \
    LOOM_CANCEL_STATE="$cancel_state" \
    python3 -c '
import json, os
print(json.dumps({
    "loom": "timeout",
    "reason": os.environ["LOOM_TIMEOUT_REASON"],
    "detail": os.environ["LOOM_TIMEOUT_DETAIL"],
    "deadline_reap": os.environ["LOOM_CANCEL_STATE"],
}))
'
  exit 124
fi
# rc 4 is loom reporting its own execution incomplete; it still printed the
# view, so the classification below is real. Only an empty view means loom
# gave us nothing to read.
if [ -z "$view" ]; then
  log "loom run produced no view rc=$lrc"
  write_stamp failed "" "" "$key" "$(reason_token)"
  printf '{"loom":"failed","reason":"%s"}\n' "$(reason_token)"
  exit 3
fi
if [ "$lrc" -ne 0 ] && [ "$lrc" -ne 4 ]; then
  log "loom run failed rc=$lrc"
  write_stamp failed "" "" "$key" "$(reason_token)"
  printf '{"loom":"failed","reason":"%s"}\n' "$(reason_token)"
  exit 3
fi

parsed="$(printf '%s\n' "$view" | python3 -c '
import json, sys
text = sys.stdin.read()
status = ""
ctx = {}
for line in text.splitlines():
    if line.startswith("status:"):
        status = line.split(":", 1)[1].strip()
    elif line.startswith("context."):
        key, _, rest = line.partition(":")
        key = key[len("context."):]
        rest = rest.strip()
        try:
            ctx[key] = json.loads(rest)
        except Exception:
            ctx[key] = rest.strip("\"")
classes = str(ctx.get("classes") or "unknown")
detail = str(ctx.get("detail") or "")
actions = str(ctx.get("actions") or "")
heal = str(ctx.get("heal") or "")
print(json.dumps({
    "status": status,
    "classes": classes,
    "detail": detail,
    "actions": actions,
    "heal": heal,
}))
')"

status="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status",""))')"
exec_id="$(printf '%s\n' "$view" | awk 'NF{print; exit}')"
cls_str="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("classes","unknown"))')"
det_str="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("detail",""))')"
act_str="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("actions",""))')"
emit_classification() {
  if [ "$JSON" -eq 1 ]; then
    printf '{"classes":"%s","detail":"%s","actions":"%s","engine":"loom"}\n' \
      "$cls_str" "$(printf '%s' "$det_str" | tr '"' "'")" "$(printf '%s' "$act_str" | tr '"' "'")"
  else
    printf 'WHY_STOPPED classes=%s engine=loom\n' "$cls_str"
    printf 'detail: %s\n' "$det_str"
    printf 'actions: %s\n' "$act_str"
  fi

  routine_outcome="ok"
  case "$cls_str" in
    none) routine_outcome="noop" ;;
  esac
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${routine_outcome} detail=classes=${cls_str}"
}

if [ "$status" != "succeeded" ]; then
  log "loom exec status=$status"
  write_stamp "${status:-failed}" "$exec_id" "$cls_str" "$key" "$(reason_token)"
  # A populated classification is the answer we were asked for, even though
  # the execution is unfinished. Hand it back and say the run is incomplete —
  # discarding it here is what made the fleet surface read `loom=unavailable`
  # while loom was up and answering.
  if [ -n "$cls_str" ] && [ "$cls_str" != "unknown" ]; then
    emit_classification
    exit 4
  fi
  exit 3
fi
write_stamp succeeded "$exec_id" "$cls_str" "$key"

if [ -x "$ROOT/bin/last-stack-brain-append-heartbeat" ]; then
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "$ROOT/bin/last-stack-brain-append-heartbeat" --line \
    "why-stopped $ts classes=$cls_str detail=$det_str engine=loom" >/dev/null 2>&1 || true
fi

emit_classification
exit 0
