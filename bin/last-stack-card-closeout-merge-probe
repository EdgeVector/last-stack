#!/usr/bin/env bash
# Exit 0 if the review artifact at $1 is merged. Exit 1 otherwise.
# GitHub .../pull/<n> (the default venue) | Forgejo .../pulls/<n> (only the
# `lastgit` repo and old cards). lastgit://... CR URLs are retired and never probe as merged.
set -euo pipefail
url="${1:-}"
if [ -z "$url" ]; then
  echo "usage: last-stack-card-closeout-merge-probe <pr-url>" >&2
  exit 2
fi

case "$url" in
  lastgit://*)
    # LastGit is retired (decision-2026-09-29-retire-lastgit-all-repos-to-github).
    # A CR URL cannot be probed any more; say so instead of reading as unmerged.
    echo "merge-probe: lastgit CR URLs are retired, cannot probe $url" >&2
    exit 1
    ;;
  */pulls/*)
    path="${url#*://}"
    path="${path#*/}"  # drop host
    # EdgeVector/fold/pulls/1590
    repo="${path%%/pulls/*}"
    n="${path##*/pulls/}"
    n="${n%%[\?/]*}"
    api="${LAST_STACK_FORGE_API:-${HOME}/.last-stack/bin/last-stack-forge-api}"
    if [ ! -x "$api" ]; then
      echo "merge-probe: last-stack-forge-api missing for $url" >&2
      exit 1
    fi
    # last-stack-forge-api takes exactly ONE argument after --jq: the filter.
    # A bare -r here is consumed AS the filter, the real filter becomes an
    # "unexpected extra argument", and the call exits 2. Do not add -r; the
    # wrapper runs jq without -r, so a JSON boolean already prints bare.
    api_err="$(mktemp "${TMPDIR:-/tmp}/merge-probe-forge.XXXXXX")"
    if merged="$("$api" --jq '.merged' "repos/${repo}/pulls/${n}" 2>"$api_err")"; then
      rm -f "$api_err"
    else
      # Never report "not merged" for what is really a broken probe call.
      echo "merge-probe: forge API query failed for $url" >&2
      sed -n '1,5p' "$api_err" >&2 || true
      rm -f "$api_err"
      exit 1
    fi
    [ "$merged" = "true" ]
    ;;
  */pull/*)
    # https://github.com/owner/repo/pull/N
    path="${url#*github.com/}"
    repo="${path%%/pull/*}"
    n="${path##*/pull/}"
    n="${n%%[\?/]*}"
    if ! command -v gh >/dev/null 2>&1; then
      echo "merge-probe: gh not on PATH for $url" >&2
      exit 1
    fi
    # Never report "not merged" for what is really a broken probe call.
    gh_err="$(mktemp "${TMPDIR:-/tmp}/merge-probe-gh.XXXXXX")"
    if ! json="$(gh -R "$repo" pr view "$n" --json state,mergedAt 2>"$gh_err")"; then
      echo "merge-probe: gh query failed for $url" >&2
      sed -n '1,5p' "$gh_err" >&2 || true
      rm -f "$gh_err"
      exit 1
    fi
    rm -f "$gh_err"
    python3 -c '
import json,sys
raw=sys.stdin.read().strip()
if not raw:
    sys.exit(1)
try:
    d=json.loads(raw)
except Exception:
    sys.exit(1)
if str(d.get("state") or "").upper()=="MERGED" and d.get("mergedAt"):
    sys.exit(0)
sys.exit(1)
' <<<"$json"
    ;;
  *)
    echo "merge-probe: unrecognized review URL $url" >&2
    exit 1
    ;;
esac
