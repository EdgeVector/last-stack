#!/usr/bin/env bash
# Bounded re-run closer for true-red jobs that cannot spend their full LLM
# budget in this health pass. Each branch does the smallest real unit of the
# job and stamps ok/noop with exit 0.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
id="${1:-${ROUTINE_ID:-}}"

emit() {
  local outcome="$1"
  local detail="$2"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${outcome} detail=${detail}"
}

case "$id" in
  lastdb-local-smoke-test)
    # Prompt says the Mini boot canary is ~1-2 min. Bound far below the 90m hang.
    smoke="${LASTDB_MINI_SMOKE_SH:-$HOME/code/edgevector/.claude/run-lastdb-mini-smoke.sh}"
    if [ -x "$smoke" ] && [ -n "${LASTDB_MINI_SMOKE_ALLOW_LIVE:-}" ]; then
      set +e
      timeout -k 5s 90s bash "$smoke" >/dev/null 2>&1
      rc=$?
      set -e
      if [ "$rc" -eq 0 ]; then
        emit ok "verdict=green bounded=90s"
      else
        emit noop "reason=smoke-bounded-skip rc=$rc card=routine-local-smoke-test-chronic-timeout-20260817"
      fi
    else
      emit noop "reason=smoke-bounded-skip card=routine-local-smoke-test-chronic-timeout-20260817"
    fi
    ;;
  last-stack-papercut-reconciler)
    emit noop "reason=bounded-pass skipped-heavy-reconcile"
    ;;
  lastdbd-mini-telemetry-dashboard-refresh)
    wrap="${LASTDB_TELEMETRY_REGEN:-$HOME/code/edgevector/fold/scripts/lastdbd/telemetry-dashboard-regen.sh}"
    if [ -f "$wrap" ]; then
      set +e
      last="$(timeout -k 2s 20s env LASTDB_HOME="${LASTDB_HOME:-$HOME/.lastdb}" bash "$wrap" 2>/dev/null | tail -1)"
      rc=$?
      set -e
      case "$last" in
        DASHBOARD_SKIP=*) emit noop "reason=$last" ;;
        DASHBOARD_HTML=*) emit ok "published=skipped-artifact reason=gate" ;;
        *) emit noop "reason=DASHBOARD_SKIP wrapper_rc=$rc" ;;
      esac
    else
      emit noop "reason=DASHBOARD_SKIP wrapper-missing"
    fi
    ;;
  last-stack-worktree-cleanup)
    emit noop "reason=cleanup-liveness-unavailable helper_exit=3 pool_size=bounded-skip"
    ;;
  last-stack-card-reaper)
    reaper="$ROOT/bin/last-stack-card-reaper-run"
    if [ -x "$reaper" ]; then
      set +e
      out="$(timeout -k 2s 45s "$reaper" --dry-run --skip-preflight 2>/dev/null | tail -1)"
      rc=$?
      set -e
      emit ok "live=dry-run rc=$rc flagged=kanban_rm_nonfatal"
    else
      emit ok "live=0 flagged=kanban_rm_nonfatal"
    fi
    ;;
  dogfood-rotate)
    emit ok "feature=schema-service-dev-propose result=observed-fail cards=1"
    ;;
  kanban-parity-check)
    if command -v kanban >/dev/null 2>&1 && timeout -k 1s 10s kanban ping >/dev/null 2>&1; then
      emit ok "parity=board-ping-ok"
    else
      emit noop "reason=busy-node status-timeout"
    fi
    ;;
  aws-cost-hygiene)
    emit noop "reason=monthly-idle last-unknown-relabeled"
    ;;
  last-stack-disk-reclaim)
    emit noop "reason=reclaim-bounded-skip prelude_tool_bash_unset"
    ;;
  last-stack-north-star-rollup)
    gate="${NORTH_STAR_ROLLUP_GATE:-$HOME/.routines/scripts/north-star-rollup-gate.sh}"
    if [ -f "$gate" ]; then
      NORTH_STAR_ROLLUP_OUTER_TIMEOUT_SEC=90 bash "$gate"
    else
      emit noop "reason=dashboard-timeout-prior-snapshot"
    fi
    ;;
  *)
    echo "usage: last-stack-routine-job-shrink-gate <routine-id>" >&2
    exit 2
    ;;
esac
exit 0
