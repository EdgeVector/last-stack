#!/usr/bin/env python3
"""Bounded check: a new kanban card must not contradict settled brain records.

Search is candidate slugs only (never membership). Each candidate is
point-got. A mechanical invariant over the card's own declared kind or
column fires whatever the search returned -- its slug is provenance for
the reason, not a precondition. Semantic honor of the listed slugs stays
with the filing agent.

Exit: 0 honor/clear, 2 conflict or usage, 1 brain failure (fail closed).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

RECORD_TYPE_RE = re.compile(
    r"(?im)^(?:\s*\[(decision|design|preference)\]|\s*type:\s*(decision|design|preference)\s*)"
)
DECISION_CHECK_RE = re.compile(
    r"(?ms)^##[ \t]*DECISION-CHECK\b.*?(?=^##[ \t]|\Z)"
)
GOAL_RE = re.compile(
    r"(?im)^(?:##[ \t]*)?GOAL:?[ \t]*\n?(.*?)(?=^##[ \t]|\Z)"
)

# The `kind_forbid` and `column_forbid` arms are LOCAL tests on the card's own
# declared fields and fire whatever the search returned: `slug` is PROVENANCE
# for the reason text, never a precondition. They used to be gated on the slug
# landing in the point-got set, which made both of them permanently inert --
# neither citation has ever resolved in the LastDB brain, so a card carrying
# Kind:tracker AND column review AND both forbidden body shapes at once read
# back `verdict: clear`, rc 0 (measured 2026-10-04). Even with the records
# present the gate was a lottery: the arm fired only when the hybrid search
# happened to surface its own citation among the top POINT_GET_CAP hits for
# this card's title.
#
# `body_re` stays citation-gated on purpose. It is a heuristic over prose, not
# a test on a declared field, so an unconditional refusal would be a different
# claim needing its own evidence. Its pattern WAS wrong in both directions and
# is fixed below with the measurement; the gate is unchanged, which means the
# repair defuses a landmine rather than changing today's behaviour -- neither
# INVARIANT slug resolves in the LastDB brain, so this arm is inert until one
# of them is written.
INVARIANTS = (
    {
        "slug": "preference-kanban-no-trackers-no-human-gates",
        "kind_forbid": ("tracker", "umbrella"),
        "reason": (
            "preference-kanban-no-trackers-no-human-gates: "
            "do not file Kind:tracker or Kind:umbrella"
        ),
    },
    {
        "slug": "preference-kanban-no-review-column",
        "column_forbid": ("review",),
        # Measured 2026-10-04 against 5 realistic drafts, 12 adversarial
        # drafts and all 171 live card bodies (0 hits either way). Three
        # independent defects, each fixed by one clause:
        #   1. `|kanban move \S+ review` matched a QUOTED command, so it
        #      refused the two fix cards that must quote it to describe the
        #      defect. Dropped: the card's own `--column` field is the
        #      authoritative signal and `column_forbid` now reads it
        #      unconditionally.
        #   2. `(?:a\s+)?` admitted "add a review column" and missed
        #      "restore THE review column" and "add back the review column".
        #      A bounded `(?:\w+\s+){0,2}?` filler takes all of them.
        #   3. no `(?m)`, so `$` meant end of BODY. "## GOAL\nAdd a review
        #      column\n\n## END STATE" and a "- Restore the review column"
        #      bullet both missed the boundary below.
        # The lookahead is what keeps the filler safe: a proposal ends the
        # noun phrase at "column" or continues with punctuation or a function
        # word, while a fix card continues with a NOUN ("review column guard",
        # "review column refusal test"). Function words are a closed class;
        # the nouns are not, so the boundary is stated over the closed one.
        # A hyphenated "review-column" is never matched at all -- that is the
        # compound-adjective spelling descriptive prose uses.
        # Residual, deliberately: a proposal whose next word is an open-class
        # noun ("Add a review column Tom asked for") is missed. A false
        # negative costs an advisory line; a false positive refused the fix
        # card fleet-wide. papercut-decision-check-review-column-body-regex-
        # wrong-in-both-directions-20261004.
        "body_re": (
            r"(?im)(?:add|restore|create|invent)\s+(?:\w+\s+){0,2}?"
            r"review column"
            r"(?=\s*(?:$|[.,;:!?)\]]|(?:"
            r"for|to|so|that|which|between|in|on|at|after|before|because|"
            r"and|with|where|when|if|as|from|instead|again|back|under|"
            r"until|while|but|or"
            r")\b))"
        ),
        "reason": (
            "preference-kanban-no-review-column: "
            "columns are backlog, todo, doing, done"
        ),
    },
)

TYPES = ("decision", "design", "preference")
SEARCH_LIMIT = 8
POINT_GET_CAP = 8
QUERY_CAP = 300

# Per-call budget for one `brain` subprocess, and the budget the single retry
# gets. 60 s was the original figure and it is not enough: on 2026-09-05 the
# primary node ran a warm-cache thrash for hours (brain writes 60-165 s, reads
# to 102 s), every `brain search` here hit the 60 s cap, and this script died
# with an unhandled TimeoutExpired traceback. That blocked ALL Kind:pr filing
# fleet-wide, including the card for the node defect that caused the slowness.
# A gate that a slow node turns off is not a gate. Budget generously, retry
# once, and fail with one readable line instead of a traceback.
BRAIN_CALL_TIMEOUT_S = float(os.environ.get("LAST_STACK_DECISION_CHECK_BRAIN_TIMEOUT", "180"))
BRAIN_RETRY_TIMEOUT_S = float(
    os.environ.get("LAST_STACK_DECISION_CHECK_BRAIN_RETRY_TIMEOUT", "300")
)


class BrainUnavailable(Exception):
    """The brain CLI could not be started at all (missing or not executable)."""


def run_brain(argv: list[str]) -> subprocess.CompletedProcess | None:
    """Run one `brain` call, retrying once on timeout. None means it timed out twice.

    A CLI that cannot be started raises BrainUnavailable, which main() turns
    into the same fail-closed error pack as a failing brain command. It used to
    escape as a FileNotFoundError traceback
    (papercut-decision-check-missing-brain-binary-traceback-20260923).
    """
    for budget in (BRAIN_CALL_TIMEOUT_S, BRAIN_RETRY_TIMEOUT_S):
        try:
            return subprocess.run(argv, text=True, capture_output=True, timeout=budget)
        except subprocess.TimeoutExpired:
            continue
        except OSError as exc:
            raise BrainUnavailable(f"brain CLI {argv[0]!r} cannot be started: {exc}") from exc
    return None


def default_brain_bin() -> str:
    """The brain CLI.

    Order: `$BRAIN_BIN`, else `brain`.
    lib/factory_reconcile.py sets BRAIN_BIN for the factory path.
    """
    return os.environ.get("BRAIN_BIN") or "brain"


class Brain:
    def __init__(self, bin_name: str) -> None:
        self.bin_name = bin_name
        self.gets: list[str] = []
        self.searches: list[str] = []
        self.degraded_types: list[str] = []
        self.search_failures: dict[str, str] = {}
        self.failed = False
        self.timed_out = False
        self.fail_detail = ""

    @property
    def store(self) -> str:
        return "brain"

    def read_command(self, slug: str) -> str:
        """The command a card reader runs to see this record."""
        return f"brain get {slug}"

    def get(self, slug: str) -> str | None:
        self.gets.append(slug)
        cp = run_brain([self.bin_name, "get", slug])
        if cp is None:
            self.timed_out = True
            self.fail_detail = (
                f"brain get {slug} timed out twice "
                f"({BRAIN_CALL_TIMEOUT_S:.0f}s then {BRAIN_RETRY_TIMEOUT_S:.0f}s)"
            )
            return None
        if cp.returncode != 0:
            return None
        return cp.stdout

    def search(self, query: str) -> list[dict]:
        self.searches.append(query)
        # Prefer the untyped hybrid path. It does not enumerate a type list,
        # so an incomplete list index cannot block candidate discovery.
        ask = run_brain(
            [self.bin_name, "ask", query, "--limit", str(SEARCH_LIMIT), "--json"]
        )
        if ask is not None and ask.returncode == 0:
            try:
                data = json.loads(ask.stdout or "[]")
            except json.JSONDecodeError:
                data = None
            if isinstance(data, list):
                return [x for x in data if isinstance(x, dict)]

        # Older brain clients may not expose `ask`. Fall back to separate
        # typed searches so one incomplete type index only degrades results.
        if ask is None:
            self.search_failures["untyped"] = (
                f"brain ask timed out twice "
                f"({BRAIN_CALL_TIMEOUT_S:.0f}s then {BRAIN_RETRY_TIMEOUT_S:.0f}s)"
            )
        elif ask.returncode != 0:
            self.search_failures["untyped"] = (
                ask.stderr or ask.stdout or "brain ask failed"
            ).strip()
        else:
            self.search_failures["untyped"] = "brain ask returned invalid JSON"

        hits: list[dict] = []
        successful_types = 0
        for rec_type in TYPES:
            cp = run_brain(
                [
                    self.bin_name,
                    "search",
                    query,
                    "--type",
                    rec_type,
                    "--limit",
                    str(SEARCH_LIMIT),
                    "--json",
                ]
            )
            if cp is None:
                self.degraded_types.append(rec_type)
                self.search_failures[rec_type] = (
                    f"brain search {rec_type} timed out twice "
                    f"({BRAIN_CALL_TIMEOUT_S:.0f}s then {BRAIN_RETRY_TIMEOUT_S:.0f}s)"
                )
                continue
            if cp.returncode != 0:
                self.degraded_types.append(rec_type)
                self.search_failures[rec_type] = (
                    cp.stderr or cp.stdout or f"brain search {rec_type} failed"
                ).strip()
                continue
            try:
                data = json.loads(cp.stdout or "[]")
            except json.JSONDecodeError:
                self.degraded_types.append(rec_type)
                self.search_failures[rec_type] = (
                    f"brain search {rec_type} --json is not JSON"
                )
                continue
            if isinstance(data, dict) and data.get("error"):
                self.degraded_types.append(rec_type)
                self.search_failures[rec_type] = str(data.get("error"))
                continue
            if not isinstance(data, list):
                self.degraded_types.append(rec_type)
                self.search_failures[rec_type] = (
                    f"brain search {rec_type} --json is not a list"
                )
                continue
            successful_types += 1
            hits.extend(x for x in data if isinstance(x, dict))

        if successful_types == 0:
            self.failed = True
            self.fail_detail = "; ".join(
                self.search_failures.values()
            ) or "all typed brain searches failed"
        return hits


def goal_excerpt(body: str) -> str:
    m = GOAL_RE.search(body)
    if not m:
        return ""
    return " ".join(m.group(1).split())


def record_type(raw: str) -> str:
    """Read the record type from the point-get response, not search metadata."""
    for line in raw.splitlines()[:24]:
        match = RECORD_TYPE_RE.match(line)
        if match:
            return next(group for group in match.groups() if group)
    return ""


def build_query(title: str, body: str) -> str:
    parts = [title.strip(), goal_excerpt(body)]
    q = " ".join(p for p in parts if p)
    if len(q) > QUERY_CAP:
        q = q[:QUERY_CAP].rsplit(" ", 1)[0]
    return q or title.strip() or "kanban card"


def apply_invariants(
    got_slugs: set[str], kind: str, column: str, body: str
) -> list[dict]:
    """Fire the mechanical invariants against this card.

    A hit carries `cited`: whether this run could read the record the reason
    text names. A mechanical arm is NOT suppressed when `cited` is false --
    an absent citation costs the refusal its provenance, never its teeth.
    Absent and retracted are different answers, and presence-gating could
    only ever report the first as the second. See the INVARIANTS comment for
    why `body_re` alone keeps the old gate.
    """
    hits: list[dict] = []
    kind_l = (kind or "").strip().lower()
    column_l = (column or "").strip().lower()
    for inv in INVARIANTS:
        slug = inv["slug"]
        cited = slug in got_slugs
        if kind_l and kind_l in inv.get("kind_forbid", ()):
            hits.append({"slug": slug, "reason": inv["reason"], "cited": cited})
            continue
        if column_l and column_l in inv.get("column_forbid", ()):
            hits.append({"slug": slug, "reason": inv["reason"], "cited": cited})
            continue
        body_re = inv.get("body_re")
        if cited and body_re and re.search(body_re, body):
            hits.append({"slug": slug, "reason": inv["reason"], "cited": cited})
    return hits


def stamp_block(
    verdict: str,
    slugs: list[str],
    when: str,
    reads: list[str] | None = None,
    store: str = "",
) -> str:
    """The stamp. `slugs:` keeps its one-line shape for parsers; each slug
    also gets a `read:` line (`brain get <slug>`).
    """
    slug_line = ", ".join(slugs) if slugs else "none"
    lines = [
        "## DECISION-CHECK",
        f"date: {when}",
        f"verdict: {verdict}",
        f"slugs: {slug_line}",
    ]
    if slugs and store:
        lines.append(f"store: {store}")
    for cmd in reads or []:
        lines.append(f"read: {cmd}")
    return "\n".join(lines) + "\n"


def inject_stamp(body: str, stamp: str) -> str:
    stripped = DECISION_CHECK_RE.sub("", body).rstrip() + "\n\n"
    return stripped + stamp


def assemble(
    title: str,
    body: str,
    kind: str,
    column: str,
    brain: Brain,
) -> dict:
    query = build_query(title, body)
    hits = brain.search(query)
    if brain.failed:
        return {
            "ok": False,
            "verdict": "error",
            "slugs": [],
            "conflicts": [],
            "records": [],
            "query": query,
            "error": brain.fail_detail,
            "stamp": "",
            "search_is_membership": False,
            "degraded_types": brain.degraded_types,
            "search_failures": brain.search_failures,
        }

    candidates: list[str] = []
    seen: set[str] = set()
    for hit in hits:
        slug = str(hit.get("slug") or "").strip()
        if not slug or slug in seen:
            continue
        seen.add(slug)
        candidates.append(slug)
        if len(candidates) >= POINT_GET_CAP:
            break

    records: list[dict] = []
    got_slugs: list[str] = []
    for slug in candidates:
        raw = brain.get(slug)
        rec = {"slug": slug, "got": raw is not None}
        if raw is not None:
            rec["gist"] = "\n".join(raw.splitlines()[:24])
            rec_type = record_type(raw)
            rec["type"] = rec_type
            if rec_type in TYPES:
                got_slugs.append(slug)
        records.append(rec)

    conflicts = apply_invariants(set(got_slugs), kind, column, body)
    if conflicts:
        verdict = "conflict"
    elif got_slugs:
        verdict = "honor"
    else:
        verdict = "clear"

    when = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    stamp = stamp_block(
        verdict,
        got_slugs,
        when,
        reads=[brain.read_command(s) for s in got_slugs],
        store=brain.store,
    )
    return {
        "ok": verdict != "conflict",
        "verdict": verdict,
        "slugs": got_slugs,
        "conflicts": conflicts,
        "records": records,
        "query": query,
        "error": "",
        "stamp": stamp,
        "search_is_membership": False,
        "point_gets": brain.gets,
        "degraded_types": brain.degraded_types,
        "search_failures": brain.search_failures,
    }




def factory_reviewed_assemble(title, body, kind, column, args):
    # This finite mode carries reviewed authority; it does not sample search.
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
    from factory_repair import (DECISION_POLICY_PATH, DECISION_POLICY_SHA, Refusal,
                                require, read_bytes, strict_json, sha, bounded_call)
    installed = str(Path.home() / '.local/bin/brain')
    require(args.brain is None and
            ('BRAIN_BIN' not in os.environ or os.environ['BRAIN_BIN'] == installed),
            'factory-decision-brain-override-refused')
    require(title == 'Count canonical active Loom executions once' and kind == 'pr' and column == 'backlog',
            'factory-decision-scope')
    raw = read_bytes(DECISION_POLICY_PATH, 65536)
    require(sha(raw) == DECISION_POLICY_SHA, 'factory-decision-policy-sha')
    policy = strict_json(raw); decision = policy['decision']; slug = decision['slug']
    when = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    stamp = stamp_block('honor', [slug], when, reads=['brain get ' + slug], store='brain')
    require('## DECISION-CHECK' not in body, 'factory-decision-existing-stamp')
    injected = inject_stamp(body, stamp)
    prefix = injected.split('\n## DECISION-CHECK\n', 1)[0]
    require(sha(prefix.encode()) == policy['brief_sha256'], 'factory-decision-exact-brief')
    rc, out, err = bounded_call([installed, 'get', slug, '--type', 'decision', '--json'], 20, cap=65536)
    require(rc == 0, 'factory-decision-typed-read-failed')
    value = strict_json(out)
    require(isinstance(value, dict) and value.get('type') == 'decision' and
            {key: value.get(key) for key in ('slug', 'title', 'status', 'body')} == decision,
            'factory-decision-record-drift')
    conflicts = apply_invariants({slug}, kind, column, body)
    verdict = 'conflict' if conflicts else 'honor'
    return {'ok': not conflicts, 'verdict': verdict, 'slugs': [slug], 'conflicts': conflicts,
            'records': [{'slug': slug, 'got': True, 'type': 'decision'}], 'query': '', 'error': '',
            'stamp': stamp if not conflicts else stamp_block(verdict, [slug], when, reads=['brain get ' + slug], store='brain'),
            'search_is_membership': False, 'point_gets': [slug], 'degraded_types': [], 'search_failures': {}}


STDIN_FIRST_BYTE_TIMEOUT_S = float(
    os.environ.get("LAST_STACK_DECISION_CHECK_STDIN_TIMEOUT", "20")
)


def read_body_or_fail(timeout_s: float = STDIN_FIRST_BYTE_TIMEOUT_S) -> str:
    """Read the card body from stdin, but never block on it forever.

    The card body always arrives as a pipe or a redirect, so the first byte
    (or EOF) is available immediately. An inherited descriptor that nobody
    ever writes to and nobody ever closes is the failure this guards: it
    deadlocked an agent lane for 27 hours on 2026-09-04. Wait a bounded time
    for stdin to become readable, then fail with the fix in the message.
    """
    if timeout_s > 0:
        try:
            ready, _, _ = select.select([sys.stdin], [], [], timeout_s)
        except (ValueError, OSError):
            ready = [sys.stdin]
        if not ready:
            sys.stderr.write(
                "last-stack-kanban-decision-check: no card body on stdin after "
                f"{timeout_s:g}s. This command reads the body from stdin; it "
                "does not take --body or --body-path. Pipe or redirect it:\n"
                "  last-stack-kanban-decision-check --title '...' --kind pr "
                "--column todo --inject < card.md\n"
                "Set LAST_STACK_DECISION_CHECK_STDIN_TIMEOUT=0 to wait forever.\n"
            )
            raise SystemExit(2)
    return sys.stdin.read()


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--title", default="", help="Card title")
    ap.add_argument("--kind", default="pr")
    ap.add_argument("--column", default="todo")
    ap.add_argument("--inject", action="store_true", help="Print body + stamp")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--factory-reviewed-decision", action="store_true", help="Exact reviewed Count decision; no search or caller authority")
    ap.add_argument(
        "--brain",
        default=None,
        help="brain CLI. Defaults to $BRAIN_BIN, else brain.",
    )
    args = ap.parse_args(argv)

    # Keep the raw option for the finite override fence. Resolve the CLI
    # once so the reviewed path and the Brain client use the same value.
    effective_brain = args.brain
    if effective_brain is None:
        effective_brain = (str(Path.home() / ".local/bin/brain")
                           if args.factory_reviewed_decision else default_brain_bin())

    body = read_body_or_fail()
    brain = Brain(effective_brain)
    try:
        if args.factory_reviewed_decision:
            try:
                pack = factory_reviewed_assemble(args.title, body, args.kind, args.column, args)
            except (OSError, ValueError, RuntimeError) as exc:
                raise BrainUnavailable(str(exc)) from exc
        else:
            pack = assemble(args.title, body, args.kind, args.column, brain)
    except BrainUnavailable as exc:
        pack = {
            "ok": False,
            "verdict": "error",
            "slugs": [],
            "conflicts": [],
            "records": [],
            "query": "",
            "error": str(exc),
            "stamp": "",
            "search_is_membership": False,
            "degraded_types": brain.degraded_types,
            "search_failures": brain.search_failures,
        }

    if pack["verdict"] == "error":
        print(f"last-stack-kanban-decision-check: {pack['error']}", file=sys.stderr)
        if args.json:
            print(json.dumps(pack, indent=2))
        return 1

    if pack["verdict"] == "conflict":
        for c in pack["conflicts"]:
            print(
                f"last-stack-kanban-decision-check: conflict {c['slug']}: {c['reason']}",
                file=sys.stderr,
            )
            # Say so when the refusal stands on a citation this run could not
            # read. The rule is mechanical and still applies; the reader is
            # told the provenance is unavailable rather than being sent to a
            # `brain get` that answers "No record".
            if not c.get("cited"):
                print(
                    "last-stack-kanban-decision-check: "
                    f"  note: {c['slug']} did not resolve in this run's store "
                    "-- the rule is mechanical and still applies, but its "
                    "record cannot be read back for the reason",
                    file=sys.stderr,
                )
        if args.json:
            print(json.dumps(pack, indent=2))
        elif args.inject:
            # Do not print a body on conflict — callers must not file it.
            pass
        else:
            sys.stdout.write(pack["stamp"])
        return 2

    if args.inject:
        sys.stdout.write(inject_stamp(body, pack["stamp"]))
    elif args.json:
        print(json.dumps(pack, indent=2))
    else:
        sys.stdout.write(pack["stamp"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
