#!/usr/bin/env bash
# Seed the scheduled LastDB canary build-main producer when missing.
#
# `config/routines-registry/lastdb-canary-build-main.toml` has named this
# routine since 2026-08-05, but no installer ever wrote it into a live
# registry (papercut-no-registered-routine-produces-a-lastdb-canary-candidate-20260903).
# This script is that missing installer, following the same
# seed-if-missing / --force-defaults contract as the other *-routine
# scripts in this directory.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
# shellcheck source=last-stack-routines-registry-env
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/last-stack-routines-registry-env"
last_stack_registry_paths_init

ROUTINES_HOME="${ROUTINES_HOME:-$HOME/.routines}"
REGISTRY_DIR="$ROUTINES_HOME/registry"
PROMPT_PATH="$(last_stack_registry_prompt_path lastdb-canary-build-main.md "$ROOT/routines/lastdb-canary-build-main.md")"
GATE_PATH="$REG_STABLE_ROOT/bin/last-stack-canary-build-main-gate"
ID="lastdb-canary-build-main"
DRY_RUN=0
FORCE_DEFAULTS=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --registry-dir) REGISTRY_DIR="$2"; shift 2 ;;
    --prompt-path) PROMPT_PATH="$2"; shift 2 ;;
    --gate-path) GATE_PATH="$2"; shift 2 ;;
    --id) ID="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --force-defaults) FORCE_DEFAULTS=1; shift ;;
    -h|--help) echo "last-stack-lastdb-canary-build-main-routine [--dry-run] [--force-defaults]"; exit 0 ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

[ -r "$PROMPT_PATH" ] || { echo "missing prompt: $PROMPT_PATH" >&2; exit 66; }

if [ "$DRY_RUN" -eq 0 ]; then
  last_stack_registry_assert_safe_write "$REGISTRY_DIR" "$PROMPT_PATH" "$GATE_PATH" "$REG_CWD" \
    || exit 3
fi

path="$REGISTRY_DIR/$ID.toml"
if [ "$DRY_RUN" -eq 0 ] && last_stack_registry_skip_if_exists "$path" "$FORCE_DEFAULTS"; then
  exit 0
fi

body=$(cat <<EOF
# Step 0 of the auto release loop: build Forge fold main tip into
# canary-builds/<oid> for lastdb-canary-dogfood. Never cuts over the primary.
# The gate keeps this zero-LLM when the primary is not stale or the current
# gate_head is already staged (papercut-no-registered-routine-produces-a-lastdb-canary-candidate-20260903).
id = "$ID"
harness = "claude"
model = "sonnet"
effort = "medium"
group = "dogfood"
rrule = "FREQ=HOURLY;INTERVAL=1;BYMINUTE=47;BYSECOND=0"
cwd = "$REG_CWD"
status = "active"
timeout_min = 180
prompt_path = "$PROMPT_PATH"
gate_command = "$GATE_PATH"
heartbeat_slug = "routine-heartbeats"
EOF
)

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s\n' "--- $path"
  printf '%s\n' "$body"
  exit 0
fi
mkdir -p "$REGISTRY_DIR"
tmp="$(mktemp "${TMPDIR:-/tmp}/last-stack-canary-build-main.XXXXXX")"
printf '%s\n' "$body" >"$tmp"
if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
  rm -f "$tmp"
  printf 'unchanged %s\n' "$path"
else
  mv "$tmp" "$path"
  printf 'wrote %s\n' "$path"
fi
