#!/usr/bin/env bash
# last-stack-ci-superseded — tell a Forge CI gate that its PR head is stale.
#
# A queued pull_request run keeps its place on the host lane after the PR
# merges, closes, or gets a new head. On 2026-09-23 runs 321-324 of last-stack
# waited for ~80 minutes of serial gate time on the heads of PRs 108/109/111/112,
# which were already merged, and Forgejo 15 has no token-auth cancel API
# (papercut-forge-queued-runs-for-merged-pr-heads-cannot-be-cancelled-by-agents-20260923).
# The gate asks this helper first and ends early when the answer is superseded.
#
# --branch mode is the same question for a push run. Main push runs share one
# serial concurrency group (cancel-in-progress is false on main), and each one
# needs a macos-arm64 publish slot. On 2026-09-26 eight main push runs waited
# in line behind one publish; each would test and publish a tree that the next
# run publishes anyway. A push run whose sha is no longer the branch head ends
# early; the newest run still tests and publishes the head.
# papercut-last-stack-main-push-runs-serialize-behind-publish-20260926
#
# Exit codes:
#   0  superseded (PR not open, its head is no longer --sha, or --branch moved past --sha)
#   1  current (the gate must run)
#   2  unknown (no PR number or branch, no token, forge unreachable, bad reply) — run the gate
set -uo pipefail

usage() {
  cat <<'EOF'
Usage: last-stack-ci-superseded --repo OWNER/REPO --pr N --sha SHA
       last-stack-ci-superseded --repo OWNER/REPO --branch B --sha SHA

Env: FORGE_ROOT (default: GITHUB_SERVER_URL, with host.docker.internal -> localhost on macOS,
     else http://localhost:3300), FORGE_TOKEN (required).
Exit 0 superseded, 1 current, 2 unknown. Fail-open: callers run the gate on 1 and 2.
EOF
}

repo="" pr="" branch="" sha=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="${2:-}"; shift 2 ;;
    --pr) pr="${2:-}"; shift 2 ;;
    --branch) branch="${2:-}"; shift 2 ;;
    --sha) sha="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "last-stack-ci-superseded: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "$branch" ]; then
  case "$pr" in ''|*[!0-9]*) echo "superseded-check: unknown (no PR number)"; exit 2 ;; esac
fi
if [ -z "$repo" ] || [ -z "$sha" ]; then echo "superseded-check: unknown (no repo or sha)"; exit 2; fi
if [ -z "${FORGE_TOKEN:-}" ]; then echo "superseded-check: unknown (no FORGE_TOKEN)"; exit 2; fi
command -v jq >/dev/null 2>&1 || { echo "superseded-check: unknown (no jq)"; exit 2; }

root="${FORGE_ROOT:-${GITHUB_SERVER_URL:-http://localhost:3300}}"
# The Mac host runner hands jobs host.docker.internal, which only resolves in
# a Docker job; on the Mac host itself the forge is localhost. A PC container
# job must keep host.docker.internal, so rewrite only on macOS.
if [ "$(uname -s)" = "Darwin" ]; then root="${root//host.docker.internal/localhost}"; fi
root="${root%/}"

if [ -n "$branch" ]; then
  body="$(curl -sS --max-time 20 -H "Authorization: token $FORGE_TOKEN" -H "Accept: application/json" \
    "$root/api/v1/repos/$repo/branches/$branch" 2>/dev/null)" || { echo "superseded-check: unknown (forge unreachable)"; exit 2; }
  head="$(printf '%s' "$body" | jq -r '.commit.id // empty' 2>/dev/null)"
  if [ -z "$head" ]; then echo "superseded-check: unknown (no commit id in the branch reply)"; exit 2; fi
  if [ "$head" != "$sha" ]; then
    echo "superseded-check: SUPERSEDED — $branch is now ${head:0:10}, this run tests ${sha:0:10}; the newer push run tests and publishes the head"
    exit 0
  fi
  echo "superseded-check: current — $branch is at ${sha:0:10}"
  exit 1
fi

body="$(curl -sS --max-time 20 -H "Authorization: token $FORGE_TOKEN" -H "Accept: application/json" \
  "$root/api/v1/repos/$repo/pulls/$pr" 2>/dev/null)" || { echo "superseded-check: unknown (forge unreachable)"; exit 2; }
state="$(printf '%s' "$body" | jq -r '.state // empty' 2>/dev/null)"
merged="$(printf '%s' "$body" | jq -r '.merged // false' 2>/dev/null)"
head="$(printf '%s' "$body" | jq -r '.head.sha // empty' 2>/dev/null)"
if [ -z "$state" ] || [ -z "$head" ]; then echo "superseded-check: unknown (no state/head in the PR reply)"; exit 2; fi

if [ "$state" != "open" ]; then
  echo "superseded-check: SUPERSEDED — PR #$pr is $state (merged=$merged); this run tests a dead head"
  exit 0
fi
if [ "$head" != "$sha" ]; then
  echo "superseded-check: SUPERSEDED — PR #$pr head is now ${head:0:10}, this run tests ${sha:0:10}"
  exit 0
fi
echo "superseded-check: current — PR #$pr is open at ${sha:0:10}"
exit 1
