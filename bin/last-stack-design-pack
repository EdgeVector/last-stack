#!/usr/bin/env python3
"""Assemble a design pack from point-gets + one-hop linked_from.

Search/ask hits are candidate slugs only. They are never treated as
membership. A LastDB-shaped topic whose pack is missing either canonical
LastDB model slug exits 2.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REQUIRED_SLUGS = (
    "concepts-lastdb-canonical-model",
    "concepts-lastdb-agent-access-model",
    "concepts-edgevector-agent-standing-rules",
    "autonomy-contract-dev-no-gate",
    "sop-feature-ship-loop",
    "sop-north-star-terminal-verification",
)

CANONICAL_LASTDB = (
    "concepts-lastdb-canonical-model",
    "concepts-lastdb-agent-access-model",
)

LASTDB_TOPIC_RE = re.compile(
    r"lastdb|last-db|folddb|hash[_ -]?key|hash_field|molecule|atom\b|"
    r"no-?scan|access.?pattern|canonical.?model",
    re.IGNORECASE,
)

SLUG_RE = re.compile(r"\b([a-z][a-z0-9-]{2,})\b")
LINKED_FROM_RE = re.compile(
    r"(?im)^linked_from:\s*(.+)$"
)
SEARCH_SLUG_RE = re.compile(
    r"(?im)^(?:\s*\d+\.\s+)?([a-z][a-z0-9-]{2,})\b"
)


def is_lastdb_topic(topic: str) -> bool:
    return bool(LASTDB_TOPIC_RE.search(topic))


def parse_linked_from(text: str) -> list[str]:
    slugs: list[str] = []
    seen: set[str] = set()
    m = LINKED_FROM_RE.search(text)
    if not m:
        return slugs
    # "preference foo (body), design bar (body)" — slug is the token after type
    for part in m.group(1).split(","):
        toks = part.strip().split()
        if len(toks) >= 2:
            cand = toks[1].strip("`'\"")
        elif toks:
            cand = toks[0].strip("`'\"")
        else:
            continue
        if cand and cand not in seen and cand[0].isalpha():
            seen.add(cand)
            slugs.append(cand)
    return slugs


def parse_search_candidates(text: str) -> list[str]:
    slugs: list[str] = []
    seen: set[str] = set()
    for line in text.splitlines():
        m = SEARCH_SLUG_RE.match(line.strip())
        if not m:
            continue
        slug = m.group(1)
        if slug in seen:
            continue
        seen.add(slug)
        slugs.append(slug)
    return slugs


class Brain:
    def __init__(self, bin_name: str, fixture_dir: Path | None) -> None:
        self.bin_name = bin_name
        self.fixture_dir = fixture_dir
        self.gets: list[str] = []
        self.searches: list[str] = []

    def get(self, slug: str) -> str | None:
        self.gets.append(slug)
        if self.fixture_dir is not None:
            path = self.fixture_dir / "get" / f"{slug}.txt"
            if not path.is_file():
                return None
            return path.read_text()
        cp = subprocess.run(
            [self.bin_name, "get", slug],
            text=True,
            capture_output=True,
            timeout=60,
        )
        if cp.returncode != 0:
            return None
        return cp.stdout

    def search(self, topic: str) -> str:
        self.searches.append(topic)
        if self.fixture_dir is not None:
            path = self.fixture_dir / "search.txt"
            if path.is_file():
                return path.read_text()
            return ""
        cp = subprocess.run(
            [self.bin_name, "search", topic, "--limit", "10"],
            text=True,
            capture_output=True,
            timeout=60,
        )
        return cp.stdout if cp.returncode == 0 else ""


def assemble_pack(topic: str, brain: Brain) -> dict:
    records: dict[str, dict] = {}
    missing_required: list[str] = []

    def take(slug: str, source: str) -> None:
        if slug in records:
            return
        raw = brain.get(slug)
        if raw is None:
            records[slug] = {
                "slug": slug,
                "source": source,
                "got": False,
            }
            return
        records[slug] = {
            "slug": slug,
            "source": source,
            "got": True,
            "linked_from": parse_linked_from(raw),
            "gist": "\n".join(raw.splitlines()[:20]),
        }

    for slug in REQUIRED_SLUGS:
        take(slug, "required")
        if not records[slug]["got"]:
            missing_required.append(slug)

    candidates = parse_search_candidates(brain.search(topic))
    for slug in candidates:
        if slug in records:
            continue
        take(slug, "search-candidate")

    hop: list[str] = []
    for rec in list(records.values()):
        if rec.get("got"):
            hop.extend(rec.get("linked_from") or [])
    for slug in hop:
        if slug not in records:
            take(slug, "linked_from")

    got_required = [
        s for s in REQUIRED_SLUGS if records.get(s, {}).get("got")
    ]
    lastdb = is_lastdb_topic(topic)
    missing_canonical = [s for s in CANONICAL_LASTDB if not records.get(s, {}).get("got")]
    ok = not (lastdb and missing_canonical)

    return {
        "topic": topic,
        "lastdb_shaped": lastdb,
        "ok": ok,
        "required_point_gets": list(REQUIRED_SLUGS),
        "required_got": got_required,
        "missing_required": missing_required,
        "missing_canonical": missing_canonical,
        "search_candidates": candidates,
        "search_is_membership": False,
        "point_gets": brain.gets,
        "records": list(records.values()),
    }


def render_pack(pack: dict) -> str:
    lines = [
        f"# Design pack — {pack['topic']}",
        "",
        f"lastdb_shaped: {pack['lastdb_shaped']}",
        f"search_is_membership: {pack['search_is_membership']}",
        "",
        "## Required point-gets",
    ]
    for slug in pack["required_point_gets"]:
        mark = "got" if slug in pack["required_got"] else "MISS"
        lines.append(f"- {slug} ({mark})")
    lines.append("")
    lines.append("## Search candidates (not membership)")
    if pack["search_candidates"]:
        for slug in pack["search_candidates"]:
            lines.append(f"- {slug}")
    else:
        lines.append("- (none)")
    lines.append("")
    lines.append("## Point-get order")
    for slug in pack["point_gets"]:
        lines.append(f"- {slug}")
    return "\n".join(lines) + "\n"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--topic", required=True)
    ap.add_argument("--out", help="Write markdown pack here")
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--fixture-dir",
        help="Offline brain: get/<slug>.txt and search.txt (no live node)",
    )
    ap.add_argument(
        "--brain",
        default=os.environ.get("BRAIN_BIN", "brain"),
        help="brain CLI (ignored when --fixture-dir is set)",
    )
    args = ap.parse_args(argv)

    fixture = Path(args.fixture_dir) if args.fixture_dir else None
    brain = Brain(args.brain, fixture)
    pack = assemble_pack(args.topic, brain)
    text = render_pack(pack)
    if args.out:
        Path(args.out).write_text(text)
    if args.json:
        print(json.dumps(pack, indent=2))
    else:
        sys.stdout.write(text)
    return 0 if pack["ok"] else 2


if __name__ == "__main__":
    sys.exit(main())
