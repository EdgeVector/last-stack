#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  last-stack-forge-api [--method METHOD] [--data JSON|@file] [--jq FILTER] <api-path-or-url>
  last-stack-forge-api METHOD [--data JSON|@file] [--jq FILTER] <api-path-or-url>

Examples:
  last-stack-forge-api repos/EdgeVector/fold/pulls?state=open --jq '.[] | [.number,.title] | @tsv'
  last-stack-forge-api --method POST --data @body.json repos/EdgeVector/fold/pulls
  last-stack-forge-api POST --data '{"Do":"merge","merge_when_checks_succeed":true}' repos/EdgeVector/fold/pulls/123/merge

Path forms:
  repos/OWNER/REPO/...      -> $FORGE_ROOT/api/v1/repos/OWNER/REPO/...
  /api/v1/repos/...         -> $FORGE_ROOT/api/v1/repos/...
  http://...                -> used as-is

Env:
  FORGE_ROOT     forge base URL (default http://localhost:3300)
  FORGE_TOKEN    API token override; otherwise uses keychain forgejo-token

HTTP errors:
  On non-2xx, prints "HTTP <code> <METHOD> <url>" and the response body to
  stderr, then exits 1. Never uses curl -f (which discarded the body as
  curl: (22) and made 409/405 auto-merge failures unactionable).

Run this with a shell that can reach localhost:3300. In sandboxed agent shells,
TCP to the local forge may be blocked and look like a missing curl binary.
EOF
}

method=GET
data_arg=
jq_filter=
path_arg=

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  GET|POST|PUT|PATCH|DELETE)
    method="$1"
    shift
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --method|-X)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      method="$2"
      shift 2
      ;;
    --data|-d)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      data_arg="$2"
      shift 2
      ;;
    --jq)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      # --jq takes the FILTER itself, not jq's own output flags. Callers that
      # wrote `--jq -r '.merged' <path>` silently had `-r` used as the filter
      # and the real filter rejected as an extra argument. Name the mistake.
      case "$2" in
        -r|--raw-output|-c|--compact-output|-j|--join-output|-e|--exit-status|-s|--slurp|-n|--null-input|-S|--sort-keys)
          echo "--jq takes the jq FILTER, not the jq flag '$2'." >&2
          echo "  use: --jq '.merged'   (output is already raw for scalars)" >&2
          exit 2
          ;;
      esac
      jq_filter="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 2
      ;;
    *)
      if [[ -n "$path_arg" ]]; then
        echo "unexpected extra argument: $1" >&2
        exit 2
      fi
      path_arg="$1"
      shift
      ;;
  esac
done

if [[ -z "$path_arg" && $# -gt 0 ]]; then
  path_arg="$1"
  shift
fi
if [[ -z "$path_arg" || $# -gt 0 ]]; then
  usage >&2
  exit 2
fi

forge_root="${FORGE_ROOT:-http://localhost:3300}"
forge_root="${forge_root%/}"

case "$path_arg" in
  http://*|https://*)
    url="$path_arg"
    ;;
  /api/v1/*)
    url="$forge_root$path_arg"
    ;;
  repos/*)
    url="$forge_root/api/v1/$path_arg"
    ;;
  *)
    url="$forge_root/api/v1/$path_arg"
    ;;
esac

token="${FORGE_TOKEN:-}"
if [[ -z "$token" ]]; then
  token="$(security find-generic-password -s forgejo-token -w 2>/dev/null || true)"
fi
if [[ -z "$token" ]]; then
  echo "missing Forgejo token: set FORGE_TOKEN or store keychain item forgejo-token" >&2
  exit 1
fi

# Do NOT pass curl -f. A 409/405 from merge auto-arm must keep the response
# body so agents can name the blocker (pending checks, approvals, stuck status)
# instead of collapsing to opaque "curl: (22) The requested URL returned error".
curl_args=(-sS -X "$method" -H "Authorization: token $token" -H "Accept: application/json")
if [[ -n "$data_arg" ]]; then
  curl_args+=(-H "Content-Type: application/json")
  curl_args+=(--data-binary "$data_arg")
fi
curl_args+=("$url")

body_file="$(mktemp "${TMPDIR:-/tmp}/last-stack-forge-api.XXXXXX")"
trap 'rm -f "$body_file"' EXIT

set +e
http_code="$(curl "${curl_args[@]}" -o "$body_file" -w '%{http_code}')"
curl_rc=$?
set -e

if [[ "$curl_rc" -ne 0 ]]; then
  echo "last-stack-forge-api: curl failed rc=$curl_rc method=$method url=$url" >&2
  if [[ -s "$body_file" ]]; then
    cat "$body_file" >&2
    [[ "$(tail -c1 "$body_file" 2>/dev/null || true)" == $'\n' ]] || echo >&2
  fi
  exit "$curl_rc"
fi

# A merge 405 is TWO conditions wearing one message, and Forgejo's own body
# ("Please try again later") names the wrong one. Read `mergeable` and say which:
#
#   mergeable: true   -> the status-check task is stuck. The documented
#                        empty-commit heal applies.
#   mergeable: false  -> the branch genuinely does not merge. The heal is a
#                        no-op; rebuild the branch on current base.
#
# Without this an agent reads "Please try again later" as transient, retries,
# then reaches for the one 405 heal anybody has written down. Both responses are
# wrong for an unmergeable branch and neither terminates. Cost of not printing
# it, from the transcript on brain
# `papercut-lastgit-merge-405-can-mean-unmergeable-not-a-stuck-status-check`:
# 12 merge attempts, one pointless empty commit, one CI cycle.
#
# One extra GET, only on the exact 405-on-merge-POST it partitions. It never
# changes the exit code or the body already printed — a diagnosis line, not a
# retry.
merge_405_verdict() {
  local pr_url="${url%/merge}" pr_num="${url##*/pulls/}" pr_body mergeable
  pr_num="${pr_num%%/*}"
  pr_body="$(curl -sS -X GET -H "Authorization: token $token" -H "Accept: application/json" "$pr_url" 2>/dev/null || true)"
  if [[ -z "$pr_body" ]]; then
    echo "last-stack-forge-api: could not read PR #$pr_num to tell a stuck status check from an unmergeable branch." >&2
    return
  fi
  # No jq dependency on the error path: the wrapper must stay useful on a host
  # where jq is missing, which is exactly the host where this is hardest to
  # diagnose by hand.
  if [[ "$pr_body" =~ \"mergeable\"[[:space:]]*:[[:space:]]*(true|false) ]]; then
    mergeable="${BASH_REMATCH[1]}"
  else
    mergeable="unknown"
  fi
  case "$mergeable" in
    false)
      echo "last-stack-forge-api: PR #$pr_num has mergeable=false — this 405 is a REAL CONFLICT, not a stuck status check." >&2
      echo "last-stack-forge-api: the empty-commit heal cannot fix it. Rebuild the branch on the current base and re-apply." >&2
      ;;
    true)
      echo "last-stack-forge-api: PR #$pr_num has mergeable=true — the branch merges, so the block is on the status-check side." >&2
      echo "last-stack-forge-api: with required checks green this is the stuck status-check task; the empty-commit heal applies." >&2
      ;;
    *)
      echo "last-stack-forge-api: PR #$pr_num response carries no \`mergeable\` field; cannot partition this 405." >&2
      ;;
  esac
}

# Treat only 2xx as success (Forgejo merge arm returns 200 when pending_merge is set).
if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
  echo "last-stack-forge-api: HTTP $http_code $method $url" >&2
  if [[ -s "$body_file" ]]; then
    cat "$body_file" >&2
    [[ "$(tail -c1 "$body_file" 2>/dev/null || true)" == $'\n' ]] || echo >&2
  else
    echo "(empty response body)" >&2
  fi
  if [[ "$http_code" == "405" && "$method" == "POST" && "$url" == */pulls/*/merge ]]; then
    merge_405_verdict
  fi
  exit 1
fi

if [[ -n "$jq_filter" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  jq_bin="$script_dir/last-stack-forge-json-jq"
  if [[ -x "$jq_bin" ]]; then
    "$jq_bin" "$jq_filter" <"$body_file"
  else
    jq "$jq_filter" <"$body_file"
  fi
else
  cat "$body_file"
fi
