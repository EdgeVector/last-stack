#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  last-stack-forge-api [--method METHOD] [--data JSON|@file] [--jq FILTER] <api-path-or-url>
  last-stack-forge-api METHOD [--data JSON|@file] [--jq FILTER] <api-path-or-url>

Examples:
  last-stack-forge-api repos/EdgeVector/fold/pulls?state=open --jq '.[] | [.number,.title] | @tsv'
  last-stack-forge-api --method POST --data @body.json repos/EdgeVector/fold/pulls
  last-stack-forge-api POST --data '{"Do":"merge","merge_when_checks_succeed":true}' repos/EdgeVector/fold/pulls/123/merge

Path forms:
  repos/OWNER/REPO/...      -> $FORGE_ROOT/api/v1/repos/OWNER/REPO/...
  /api/v1/repos/...         -> $FORGE_ROOT/api/v1/repos/...
  http://...                -> used as-is

Env:
  FORGE_ROOT     forge base URL (default http://localhost:3300)
  FORGE_TOKEN    API token override; otherwise uses keychain forgejo-token

HTTP errors:
  On non-2xx, prints "HTTP <code> <METHOD> <url>" and the response body to
  stderr, then exits 1. Never uses curl -f (which discarded the body as
  curl: (22) and made 409/405 auto-merge failures unactionable).

Run this with a shell that can reach localhost:3300. In sandboxed agent shells,
TCP to the local forge may be blocked and look like a missing curl binary.
EOF
}

method=GET
data_arg=
jq_filter=
path_arg=

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  GET|POST|PUT|PATCH|DELETE)
    method="$1"
    shift
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --method|-X)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      method="$2"
      shift 2
      ;;
    --data|-d)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      data_arg="$2"
      shift 2
      ;;
    --jq)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      jq_filter="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 2
      ;;
    *)
      if [[ -n "$path_arg" ]]; then
        echo "unexpected extra argument: $1" >&2
        exit 2
      fi
      path_arg="$1"
      shift
      ;;
  esac
done

if [[ -z "$path_arg" && $# -gt 0 ]]; then
  path_arg="$1"
  shift
fi
if [[ -z "$path_arg" || $# -gt 0 ]]; then
  usage >&2
  exit 2
fi

forge_root="${FORGE_ROOT:-http://localhost:3300}"
forge_root="${forge_root%/}"

case "$path_arg" in
  http://*|https://*)
    url="$path_arg"
    ;;
  /api/v1/*)
    url="$forge_root$path_arg"
    ;;
  repos/*)
    url="$forge_root/api/v1/$path_arg"
    ;;
  *)
    url="$forge_root/api/v1/$path_arg"
    ;;
esac

token="${FORGE_TOKEN:-}"
if [[ -z "$token" ]]; then
  token="$(security find-generic-password -s forgejo-token -w 2>/dev/null || true)"
fi
if [[ -z "$token" ]]; then
  echo "missing Forgejo token: set FORGE_TOKEN or store keychain item forgejo-token" >&2
  exit 1
fi

# Do NOT pass curl -f. A 409/405 from merge auto-arm must keep the response
# body so agents can name the blocker (pending checks, approvals, stuck status)
# instead of collapsing to opaque "curl: (22) The requested URL returned error".
curl_args=(-sS -X "$method" -H "Authorization: token $token" -H "Accept: application/json")
if [[ -n "$data_arg" ]]; then
  curl_args+=(-H "Content-Type: application/json")
  curl_args+=(--data-binary "$data_arg")
fi
curl_args+=("$url")

body_file="$(mktemp "${TMPDIR:-/tmp}/last-stack-forge-api.XXXXXX")"
trap 'rm -f "$body_file"' EXIT

set +e
http_code="$(curl "${curl_args[@]}" -o "$body_file" -w '%{http_code}')"
curl_rc=$?
set -e

if [[ "$curl_rc" -ne 0 ]]; then
  echo "last-stack-forge-api: curl failed rc=$curl_rc method=$method url=$url" >&2
  if [[ -s "$body_file" ]]; then
    cat "$body_file" >&2
    [[ "$(tail -c1 "$body_file" 2>/dev/null || true)" == $'\n' ]] || echo >&2
  fi
  exit "$curl_rc"
fi

# Treat only 2xx as success (Forgejo merge arm returns 200 when pending_merge is set).
if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
  echo "last-stack-forge-api: HTTP $http_code $method $url" >&2
  if [[ -s "$body_file" ]]; then
    cat "$body_file" >&2
    [[ "$(tail -c1 "$body_file" 2>/dev/null || true)" == $'\n' ]] || echo >&2
  else
    echo "(empty response body)" >&2
  fi
  exit 1
fi

if [[ -n "$jq_filter" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  jq_bin="$script_dir/last-stack-forge-json-jq"
  if [[ -x "$jq_bin" ]]; then
    "$jq_bin" "$jq_filter" <"$body_file"
  else
    jq "$jq_filter" <"$body_file"
  fi
else
  cat "$body_file"
fi
