#!/usr/bin/env bash
set -euo pipefail

# Resolve this script through symlinks so `lib/` is found in the artifact tree
# and in a checkout alike (same convention as bin/last-stack-factory-health-install).
self="${BASH_SOURCE[0]}"
while [ -h "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
self_root="$(cd -P "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/forge-token.sh
. "$self_root/lib/forge-token.sh"

usage() {
  cat <<'EOF'
Usage:
  last-stack-forge-api [--method METHOD] [--data JSON|@file] [--jq FILTER] <api-path-or-url>
  last-stack-forge-api METHOD [--data JSON|@file] [--jq FILTER] <api-path-or-url>

Examples:
  last-stack-forge-api 'repos/EdgeVector/fold/pulls?state=open' --jq '.[] | [.number,.title] | @tsv'
  last-stack-forge-api --method POST --data @body.json repos/EdgeVector/fold/pulls
  last-stack-forge-api POST --data '{"Do":"merge","merge_when_checks_succeed":true}' repos/EdgeVector/fold/pulls/123/merge

Response shapes worth knowing:
  commits/<sha>/status is ONE object, not an array:
    {"state":"success|failure|pending", "total_count":N, "statuses":[{context,status,target_url,...}]}
  last-stack-forge-api repos/EdgeVector/fold/commits/<sha>/status --jq '.state'
  last-stack-forge-api repos/EdgeVector/fold/commits/<sha>/status --jq '.statuses[] | [.context,.status] | @tsv'
  A status target_url names a RUN NUMBER (.../actions/runs/<n>/jobs/<i>); the API has
  no jobs or logs route for it. Read the job log with:
    last-stack-forge-ci-log EdgeVector/fold --pr <number>   (or --sha <sha>, or <run-number>)

Quote a path that has ? or &: zsh expands them before this helper runs
("no matches found: repos/...pulls?state=all&limit=20").

Forgejo shapes that differ from GitHub:
  The pulls list ignores ?head=<branch> and returns every PR. For one branch use
    last-stack-forge-api 'repos/EdgeVector/fold/pulls/main/<head-branch>' --jq '.number'
  A PR read has no auto-merge field: .auto_merge is ALWAYS null. To confirm
  auto-merge is armed, POST the merge again with merge_when_checks_succeed:
  HTTP 409 "already scheduled to auto merge" means it is armed; 200 arms it.
  Forgejo 15.0.3 fires a schedule only on a NEW status event: armed AFTER the
  required check is green, it never merges. Use the bounded fallback:
    last-stack-pipeline-forge-pr-ledger merge-green --repo EdgeVector/<r> --pr <n> --apply
  --jq prints strings raw (like gh api --jq); do not strip quotes.
  Forgejo 15.0.3 has NO API route to rerun or cancel an actions run (its
  swagger lists only runs, runs/{id}, tasks, runners, workflows/.../dispatches);
  POST .../actions/runs/<n>/rerun is a 404. The web route needs a password,
  which agents must not use. To re-run a required check, push a new commit to
  the PR branch (an empty commit is fine for a proven flake).

Path forms:
  repos/OWNER/REPO/...      -> $FORGE_ROOT/api/v1/repos/OWNER/REPO/...
  /api/v1/repos/...         -> $FORGE_ROOT/api/v1/repos/...
  http://...                -> used as-is

Env:
  FORGE_ROOT     forge base URL (default http://localhost:3300)
  FORGE_TOKEN    API token override; otherwise keychain forgejo-token, then
                 lastsecrets://forgejo-token (survives a locked keychain)

Merge preflight guard:
  POST .../pulls/<n>/merge first runs `situations preflight --action merge-pr
  --repo OWNER/REPO`. BLOCKED (exit 3) refuses the call with exit 3 and the
  Situation text. A missing or failing situations CLI does not block, but a
  merge URL with no readable OWNER/REPO is refused: there is no repo to ask
  about, and a silent fall-through cannot be told from an allow.
  DELETE .../pulls/<n>/merge (cancel a scheduled merge) is never guarded.
  Override (rare): LAST_STACK_FORGE_MERGE_PREFLIGHT_SKIP=1.
  Env: LAST_STACK_SITUATIONS_BIN (default: situations on PATH).
Update-branch guard:
  POST .../pulls/<n>/update is refused (exit 3) while the PR head has a pending
  check: the update cancels the in-flight run and re-queues the PR. BEHIND never
  blocks a merge on this forge. Override: LAST_STACK_FORGE_UPDATE_BRANCH_FORCE=1.

HTTP errors:
  On non-2xx, prints "HTTP <code> <METHOD> <url>" and the response body to
  stderr, then exits 1. Never uses curl -f (which discarded the body as
  curl: (22) and made 409/405 auto-merge failures unactionable).

Run this with a shell that can reach localhost:3300. In sandboxed agent shells,
TCP to the local forge may be blocked and look like a missing curl binary.
EOF
}

method=GET
data_arg=
jq_filter=
path_arg=

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  GET|POST|PUT|PATCH|DELETE)
    method="$1"
    shift
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --method|-X)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      method="$2"
      shift 2
      ;;
    --data|-d)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      data_arg="$2"
      shift 2
      ;;
    --jq)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      # --jq takes the FILTER itself, not jq's own output flags. Callers that
      # wrote `--jq -r '.merged' <path>` silently had `-r` used as the filter
      # and the real filter rejected as an extra argument. Name the mistake.
      case "$2" in
        -r|--raw-output|-c|--compact-output|-j|--join-output|-e|--exit-status|-s|--slurp|-n|--null-input|-S|--sort-keys)
          echo "--jq takes the jq FILTER, not the jq flag '$2'." >&2
          echo "  use: --jq '.merged'   (output is already raw for scalars)" >&2
          exit 2
          ;;
      esac
      jq_filter="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 2
      ;;
    *)
      if [[ -n "$path_arg" ]]; then
        echo "unexpected extra argument: $1" >&2
        exit 2
      fi
      path_arg="$1"
      shift
      ;;
  esac
done

if [[ -z "$path_arg" && $# -gt 0 ]]; then
  path_arg="$1"
  shift
fi
if [[ -z "$path_arg" || $# -gt 0 ]]; then
  usage >&2
  exit 2
fi

forge_root="${FORGE_ROOT:-http://localhost:3300}"
forge_root="${forge_root%/}"

case "$path_arg" in
  http://*|https://*)
    url="$path_arg"
    ;;
  /api/v1/*)
    url="$forge_root$path_arg"
    ;;
  repos/*)
    url="$forge_root/api/v1/$path_arg"
    ;;
  *)
    url="$forge_root/api/v1/$path_arg"
    ;;
esac

# Forgejo-shape hints, stderr only, never a change to the call
# (papercut-forge-api-pulls-head-query-unfiltered-20260922,
# papercut-forgejo-auto-merge-state-null-after-scheduled-20260923). Agents bring
# GitHub habits; these two read as "no match" / "not armed" without an error.
if [[ "$method" == "GET" && "$url" == */pulls\?* && "$url" == *[\?\&]head=* ]]; then
  echo "last-stack-forge-api: note: Forgejo ignores ?head= on the pulls list (every PR comes back). Use repos/<o>/<r>/pulls/<base>/<head-branch>." >&2
fi
if [[ "$jq_filter" == *auto_merge* && "$url" == */pulls* ]]; then
  echo "last-stack-forge-api: note: a Forgejo PR has no auto_merge field; it reads null even when armed. Re-POST the merge with merge_when_checks_succeed (409 'already scheduled' = armed)." >&2
fi

# The token goes into a 0600 curl config file, never onto argv. `ps aux` is
# readable by every local account, so `-H "Authorization: token <t>"` published
# the secret to the whole machine for the life of each call
# (papercut-last-stack-forge-api-token-on-curl-argv-20260924). Measured on this
# host 2026-09-25: `ps -E`/`ps eww` print no environment and `ps aux` prints the
# full argv, so the file (and the environment) are real boundaries and argv is not.
auth_config="$(last_stack_forge_curl_auth_config || true)"
if [[ -z "$auth_config" ]]; then
  last_stack_forge_token_missing_msg
  exit 1
fi
auth_dir="$(dirname "$auth_config")"
trap 'rm -rf "$auth_dir"' EXIT
# Every curl call in this script reads the header from $auth_config.
curl_auth=(-K "$auth_config")

# Update-branch guard (papercut-forge-pr-branch-update-cancels-in-flight-ci-20260922).
# POST .../pulls/<n>/update merges main into the PR branch. Forgejo then
# cancels the in-flight run of the old head, and the new head goes to the END
# of the host-lane queue. On 2026-09-22 this threw away 25 minutes of a
# capacity-2 lane for PR 121 and PR 120. No EdgeVector repo sets
# block_on_outdated_branch, so a BEHIND branch never blocks a merge. Refuse the
# update while the head has a pending check; override with
# LAST_STACK_FORGE_UPDATE_BRANCH_FORCE=1.
#
# Exception (papercut-forge-update-branch-guard-blocks-lane-move-20260926): a
# pull_request run uses the workflow file from the PR head. When main changes
# .forgejo/workflows after the PR branched (last-stack PR 209 moved ci-required
# from macos-arm64 to pc-linux on 2026-09-26), the old head keeps waiting on the
# old lane. Measured: ten runs waited over an hour behind a 2-slot Mac lane while
# the PC lane was free; after an update each one started within a minute. So
# the guard lets the update through when the workflow listing (name + blob sha)
# at the PR merge base differs from the base branch.
workflows_changed_since_merge_base() {
  local pr_body="$1" repo_url merge_base base_ref old_list new_list
  repo_url="${url%%\?*}"
  repo_url="${repo_url%/pulls/*}"
  merge_base="$(printf '%s' "$pr_body" | jq -r '.merge_base // empty' 2>/dev/null || true)"
  base_ref="$(printf '%s' "$pr_body" | jq -r '.base.ref // empty' 2>/dev/null || true)"
  [[ -n "$merge_base" && -n "$base_ref" ]] || return 1
  old_list="$(curl -sS -X GET "${curl_auth[@]}" -H "Accept: application/json" "$repo_url/contents/.forgejo/workflows?ref=$merge_base" 2>/dev/null \
    | jq -r 'if type == "array" then (map("\(.name)=\(.sha)") | sort | join(",")) else empty end' 2>/dev/null || true)"
  new_list="$(curl -sS -X GET "${curl_auth[@]}" -H "Accept: application/json" "$repo_url/contents/.forgejo/workflows?ref=$base_ref" 2>/dev/null \
    | jq -r 'if type == "array" then (map("\(.name)=\(.sha)") | sort | join(",")) else empty end' 2>/dev/null || true)"
  [[ -n "$old_list" && -n "$new_list" && "$old_list" != "$new_list" ]]
}
update_branch_guard() {
  local pr_url="${url%%\?*}" pr_body head_sha status_body state
  pr_url="${pr_url%/update}"
  command -v jq >/dev/null 2>&1 || return 0
  pr_body="$(curl -sS -X GET "${curl_auth[@]}" -H "Accept: application/json" "$pr_url" 2>/dev/null || true)"
  head_sha="$(printf '%s' "$pr_body" | jq -r '.head.sha // empty' 2>/dev/null || true)"
  [[ -n "$head_sha" ]] || return 0
  status_body="$(curl -sS -X GET "${curl_auth[@]}" -H "Accept: application/json" "${pr_url%/pulls/*}/commits/$head_sha/status" 2>/dev/null || true)"
  state="$(printf '%s' "$status_body" | jq -r '[.statuses[]? | select(.status == "pending")] | length' 2>/dev/null || echo 0)"
  if [[ "$state" =~ ^[0-9]+$ && "$state" -gt 0 ]] && workflows_changed_since_merge_base "$pr_body"; then
    echo "last-stack-forge-api: update-branch allowed: $state pending check(s), but main changed .forgejo/workflows after this PR branched." >&2
    echo "last-stack-forge-api: the old head runs the stale workflow (maybe a stale lane); the update moves it to main's workflow." >&2
    return 0
  fi
  if [[ "$state" =~ ^[0-9]+$ && "$state" -gt 0 ]]; then
    echo "last-stack-forge-api: REFUSED update-branch: PR head ${head_sha:0:10} has $state pending check(s)." >&2
    echo "last-stack-forge-api: an update now cancels the in-flight run and re-queues the PR at the end of the lane." >&2
    echo "last-stack-forge-api: BEHIND does not block a merge on this forge. Wait for the checks to finish." >&2
    echo "last-stack-forge-api: override (rare): LAST_STACK_FORGE_UPDATE_BRANCH_FORCE=1" >&2
    exit 3
  fi
}
if [[ "$method" == "POST" && "${url%%\?*}" == */pulls/*/update && "${LAST_STACK_FORGE_UPDATE_BRANCH_FORCE:-0}" != "1" ]]; then
  update_branch_guard
fi

# Merge preflight guard. A merge POST is a shared-system mutation, and the
# Situations preflight is the rule for those. On 2026-09-25 two callers armed
# auto-merge on EdgeVector/loom while loom-budget-schema-deployment-hold
# blocked merge-pr: the pipeline-health routine (PR 60 merged, an incident)
# and kanban-factory-manager (PR 63, cancelled). Both skipped the preflight.
# Put the check where every caller passes. BLOCKED refuses; a CLI that cannot
# run fails open, because a broken situations install must not stop every
# merge on the forge.
#
# The guard has two fail-open paths and only ONE of them is the "broken install"
# case above:
#
#   * a situations CLI that is absent or cannot run -> fail open, as designed.
#   * a merge URL this guard cannot read a repo out of -> REFUSE. There is no
#     policy to consult, because we do not know which repo is being merged, and
#     falling through silently is indistinguishable from an allow. The first
#     version matched only `/api/v1/repos/<o>/<r>/pulls/<n>/merge` and returned 0
#     on anything else, which this wrapper's OWN documented path forms reach: a
#     caller passing `/repos/<o>/<r>/pulls/<n>/merge` (leading slash, no
#     `/api/v1`) lands in the catch-all arm and builds
#     `$FORGE_ROOT/api/v1//repos/...` -- a DOUBLE slash the anchored pattern
#     cannot match, on a URL Forgejo serves happily. That form bypassed the gate
#     entirely (measured 2026-09-25, on the very call that opened last-stack#212).
merge_repo_from_url() {
  local path_only="${url%%\?*}" repo
  # Form-agnostic: everything after the FIRST /repos/ and before /pulls/. Covers
  # `repos/...`, `/api/v1/repos/...`, the `/repos/...` catch-all that doubles the
  # slash, and a full http:// URL, with no per-form pattern to keep in sync.
  case "$path_only" in */repos/*/pulls/*) ;; *) return 1 ;; esac
  repo="${path_only#*/repos/}"
  repo="${repo%%/pulls/*}"
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  printf '%s\n' "$repo"
}

situations_bin_for_merge() {
  local sit="${LAST_STACK_SITUATIONS_BIN:-situations}"
  if command -v "$sit" >/dev/null 2>&1; then
    printf '%s\n' "$sit"
    return 0
  fi
  # A sandboxed agent shell can lose ~/.local/bin from PATH. Losing the policy
  # CLI to a stripped PATH is not a broken install, so look at the known install
  # path before concluding this host has no policy store at all. An explicitly
  # NAMED binary is never second-guessed.
  if [[ -z "${LAST_STACK_SITUATIONS_BIN:-}" && -x "$HOME/.local/bin/situations" ]]; then
    printf '%s\n' "$HOME/.local/bin/situations"
    return 0
  fi
  return 1
}

merge_preflight_guard() {
  local repo sit_bin out rc
  if ! repo="$(merge_repo_from_url)"; then
    echo "last-stack-forge-api: REFUSED merge: no OWNER/REPO in $url, so merge-pr policy could not be checked." >&2
    echo "last-stack-forge-api: pass the path as repos/OWNER/REPO/pulls/<n>/merge." >&2
    echo "last-stack-forge-api: override (rare, needs clearance): LAST_STACK_FORGE_MERGE_PREFLIGHT_SKIP=1" >&2
    exit 3
  fi
  sit_bin="$(situations_bin_for_merge)" || return 0
  set +e
  out="$("$sit_bin" preflight --action merge-pr --repo "$repo" 2>&1)"
  rc=$?
  set -e
  if [[ "$rc" -eq 3 || "$out" == BLOCKED* ]]; then
    echo "last-stack-forge-api: REFUSED merge on $repo: Situations preflight says BLOCKED." >&2
    printf '%s\n' "$out" | head -5 | sed 's/^/last-stack-forge-api:   /' >&2
    echo "last-stack-forge-api: cancel a scheduled merge with --method DELETE on the same path." >&2
    echo "last-stack-forge-api: override (rare, needs clearance): LAST_STACK_FORGE_MERGE_PREFLIGHT_SKIP=1" >&2
    exit 3
  fi
}
if [[ "$method" == "POST" && "${url%%\?*}" == */pulls/*/merge && "${LAST_STACK_FORGE_MERGE_PREFLIGHT_SKIP:-0}" != "1" ]]; then
  merge_preflight_guard
fi

# Do NOT pass curl -f. A 409/405 from merge auto-arm must keep the response
# body so agents can name the blocker (pending checks, approvals, stuck status)
# instead of collapsing to opaque "curl: (22) The requested URL returned error".
curl_args=(-sS -X "$method" "${curl_auth[@]}" -H "Accept: application/json")
if [[ -n "$data_arg" ]]; then
  curl_args+=(-H "Content-Type: application/json")
  curl_args+=(--data-binary "$data_arg")
fi
curl_args+=("$url")

body_file="$(mktemp "${TMPDIR:-/tmp}/last-stack-forge-api.XXXXXX")"
# One trap for both temporaries: a second `trap ... EXIT` REPLACES the first, and
# the one it would have replaced is the one holding the token.
trap 'rm -f "$body_file"; rm -rf "$auth_dir"' EXIT

set +e
http_code="$(curl "${curl_args[@]}" -o "$body_file" -w '%{http_code}')"
curl_rc=$?
set -e

if [[ "$curl_rc" -ne 0 ]]; then
  echo "last-stack-forge-api: curl failed rc=$curl_rc method=$method url=$url" >&2
  if [[ -s "$body_file" ]]; then
    cat "$body_file" >&2
    [[ "$(tail -c1 "$body_file" 2>/dev/null || true)" == $'\n' ]] || echo >&2
  fi
  exit "$curl_rc"
fi

# A merge 405 is TWO conditions wearing one message, and Forgejo's own body
# ("Please try again later") names the wrong one. Read `mergeable` and say which:
#
#   mergeable: true   -> the status-check task is stuck. The documented
#                        empty-commit heal applies.
#   mergeable: false  -> the branch genuinely does not merge. The heal is a
#                        no-op; rebuild the branch on current base.
#
# Without this an agent reads "Please try again later" as transient, retries,
# then reaches for the one 405 heal anybody has written down. Both responses are
# wrong for an unmergeable branch and neither terminates. Cost of not printing
# it, from the transcript on brain
# `papercut-lastgit-merge-405-can-mean-unmergeable-not-a-stuck-status-check`:
# 12 merge attempts, one pointless empty commit, one CI cycle.
#
# One extra GET, only on the exact 405-on-merge-POST it partitions. It never
# changes the exit code or the body already printed — a diagnosis line, not a
# retry.
merge_405_verdict() {
  local pr_url="${url%/merge}" pr_num="${url##*/pulls/}" pr_body mergeable
  pr_num="${pr_num%%/*}"
  pr_body="$(curl -sS -X GET "${curl_auth[@]}" -H "Accept: application/json" "$pr_url" 2>/dev/null || true)"
  if [[ -z "$pr_body" ]]; then
    echo "last-stack-forge-api: could not read PR #$pr_num to tell a stuck status check from an unmergeable branch." >&2
    return
  fi
  # No jq dependency on the error path: the wrapper must stay useful on a host
  # where jq is missing, which is exactly the host where this is hardest to
  # diagnose by hand.
  if [[ "$pr_body" =~ \"mergeable\"[[:space:]]*:[[:space:]]*(true|false) ]]; then
    mergeable="${BASH_REMATCH[1]}"
  else
    mergeable="unknown"
  fi
  # Forgejo also answers 405 when the PR is already merged, and still reports
  # mergeable=true. The heal advice below would then send an agent to push an
  # empty commit onto a merged branch (seen 2026-09-26 on fkanban PR 41).
  if [[ "$pr_body" =~ \"merged\"[[:space:]]*:[[:space:]]*true ]]; then
    echo "last-stack-forge-api: PR #$pr_num is already MERGED — this 405 needs no heal. Nothing to do." >&2
    return
  fi
  # Forgejo recomputes `mergeable` asynchronously after a push, so a merge
  # POST seconds after a push can read false on a clean branch. Re-read
  # before calling it a conflict
  # (papercut-forge-api-405-misreported-as-real-conflict-20260922).
  if [[ "$mergeable" == "false" ]]; then
    local reread
    for reread in 1 2 3; do
      sleep "${LAST_STACK_FORGE_MERGEABLE_REREAD_S:-3}"
      pr_body="$(curl -sS -X GET "${curl_auth[@]}" -H "Accept: application/json" "$pr_url" 2>/dev/null || true)"
      if [[ "$pr_body" =~ \"mergeable\"[[:space:]]*:[[:space:]]*true ]]; then
        echo "last-stack-forge-api: PR #$pr_num read mergeable=false at the 405 and mergeable=true on re-read ${reread}: Forgejo was still recomputing after a push. Retry the merge call; this is not a conflict." >&2
        return
      fi
    done
  fi
  case "$mergeable" in
    false)
      echo "last-stack-forge-api: PR #$pr_num has mergeable=false — this 405 is a REAL CONFLICT, not a stuck status check." >&2
      echo "last-stack-forge-api: the empty-commit heal cannot fix it. Rebuild the branch on the current base and re-apply." >&2
      ;;
    true)
      echo "last-stack-forge-api: PR #$pr_num has mergeable=true — the branch merges, so the block is on the status-check side." >&2
      echo "last-stack-forge-api: with required checks green this is the stuck status-check task; the empty-commit heal applies." >&2
      ;;
    *)
      echo "last-stack-forge-api: PR #$pr_num response carries no \`mergeable\` field; cannot partition this 405." >&2
      ;;
  esac
}

# Treat only 2xx as success (Forgejo merge arm returns 200 when pending_merge is set).
if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
  echo "last-stack-forge-api: HTTP $http_code $method $url" >&2
  if [[ -s "$body_file" ]]; then
    cat "$body_file" >&2
    [[ "$(tail -c1 "$body_file" 2>/dev/null || true)" == $'\n' ]] || echo >&2
  else
    echo "(empty response body)" >&2
  fi
  if [[ "$http_code" == "405" && "$method" == "POST" && "$url" == */pulls/*/merge ]]; then
    merge_405_verdict
  fi
  exit 1
fi

if [[ -n "$jq_filter" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  jq_bin="$script_dir/last-stack-forge-json-jq"
  # -r: a string result prints bare, like `gh api --jq`, and as the usage
  # example (`... | @tsv`) and the --jq guard ("output is already raw")
  # promise. Without it `.state` printed "success" WITH quotes, so
  # last-stack-deploy-watch-gate's `case "$ci" in success)` never matched and
  # every @tsv line came back as one quoted string with literal \t
  # (papercut-pipeline-health-jq-display-quoting, 2026-09-22). Objects,
  # arrays, numbers and booleans print exactly as before.
  if [[ -x "$jq_bin" ]]; then
    "$jq_bin" -r "$jq_filter" <"$body_file"
  else
    jq -r "$jq_filter" <"$body_file"
  fi
else
  cat "$body_file"
fi
