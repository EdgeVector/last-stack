#!/usr/bin/env bash
# After host-track flips routines current, reload the LaunchAgent so the live
# daemon matches the new immutable artifact. PATH `routines` is not enough.
set -euo pipefail

routines_bin=""
if [ -n "${HOST_TRACK_VERSION_DIR:-}" ] && [ -x "${HOST_TRACK_VERSION_DIR}/dist/routines" ]; then
  routines_bin="${HOST_TRACK_VERSION_DIR}/dist/routines"
elif [ -n "${HOST_TRACK_INSTALL_ROOT:-}" ] && [ -x "${HOST_TRACK_INSTALL_ROOT}/current/dist/routines" ]; then
  routines_bin="${HOST_TRACK_INSTALL_ROOT}/current/dist/routines"
elif command -v routines >/dev/null 2>&1; then
  routines_bin="$(command -v routines)"
fi

if [ -z "$routines_bin" ] || [ ! -x "$routines_bin" ]; then
  echo "routines post-install: no routines binary" >&2
  exit 1
fi

out="$(mktemp "${TMPDIR:-/tmp}/routines-post-install.XXXXXX")"
trap 'rm -f "$out"' EXIT

launchctl_bin="${LAST_STACK_LAUNCHCTL_BIN:-launchctl}"
service="gui/$(id -u)/com.edgevector.routinesd"

if "$launchctl_bin" print "$service" >/dev/null 2>&1; then
  set +e
  "$launchctl_bin" kickstart -k "$service" >"$out" 2>&1
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    printf 'routines post-install: kickstart ok (%s)\n' "$service"
    exit 0
  fi

  # The stable launcher resolves host-track current at each start. A refused
  # kickstart is safe only while the existing launchd job remains registered.
  if "$launchctl_bin" print "$service" >/dev/null 2>&1; then
    echo "routines post-install: WARN kickstart failed; the LaunchAgent remains loaded" >&2
    cat "$out" >&2 || true
    exit 0
  fi

  echo "routines post-install: kickstart failed and the LaunchAgent is not loaded" >&2
  cat "$out" >&2 || true
  exit 1
fi

set +e
"$routines_bin" install-daemon >"$out" 2>&1
rc=$?
set -e
if [ "$rc" -eq 0 ]; then
  printf 'routines post-install: install-daemon ok (%s)\n' "$routines_bin"
  exit 0
fi

echo "routines post-install: install-daemon failed rc=$rc" >&2
cat "$out" >&2 || true
exit 1
