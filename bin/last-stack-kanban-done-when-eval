#!/usr/bin/env bash
set -u

usage() {
  cat >&2 <<'EOF'
usage: last-stack-kanban-done-when-eval --kind <kind> --predicate <DONE-WHEN>
       last-stack-kanban-done-when-eval --check --predicate <DONE-WHEN>

--check parses the predicate and evaluates nothing: exit 0 when the grammar
below supports it, exit 2 when it is malformed. Card creators run it before
they write a DONE-WHEN line
(papercut-kanban-validate-done-when-predicate-language-too-freeform-20260922).

A malformed predicate always prints one stable marker line:
  DONE-WHEN-MALFORMED: pred=<sha1-12 of the predicate>
Append THAT line to the card with last-stack-kanban-mark-once; do not write
free text (papercut-kanban-validate-malformed-done-when-duplicate-note-suppression-20260922).

Exit codes:
  0  predicate is satisfied
  1  predicate is false or pending
  2  predicate is malformed or errored
  3  ignored because Kind: pr still requires a merged PR

Supported predicates:
  brain <slug> exists
  brain <slug> updated-after <YYYY-MM-DD>
  routine <name> heartbeat matches /<regex>/ after <YYYY-MM-DD>
  date >= <YYYY-MM-DD>
  file <path> matches /<regex>/

Compound form:
  <predicate> AND <predicate> [AND <predicate> ...]
  Each side is one supported predicate above. The word AND is uppercase with
  a space on each side. The result is satisfied only when every side is
  satisfied; it is malformed when any side is malformed. A regex must not
  contain the text " AND ".

Not supported, on purpose: arbitrary shell commands and LastDB ops-ring
conditions. A card body is data, so the evaluator never runs a command from
it. Put that proof in a file (for example a report under
~/.last-stack/north-star-proofs/) and use `file <path> matches /<regex>/`.
EOF
}

kind=""
predicate=""
check=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --kind)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      kind="$2"
      shift 2
      ;;
    --predicate)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      predicate="$2"
      shift 2
      ;;
    --check)
      check=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [ -z "$predicate" ]; then
        predicate="$*"
        break
      fi
      usage
      exit 2
      ;;
  esac
done

[ -n "$predicate" ] || { usage; exit 2; }

pred_hash() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 1 | cut -c1-12
  else
    printf '%s' "$1" | sha1sum | cut -c1-12
  fi
}

# Every malformed exit prints the same marker for the same predicate.
malformed_marker() {
  echo "DONE-WHEN-MALFORMED: pred=$(pred_hash "$predicate")"
}

# In --check mode a matched form is well-formed; nothing is evaluated.
well_formed() {
  if [ "$check" = 1 ]; then
    echo "well-formed: $1"
    exit 0
  fi
}

if [ "$kind" = "pr" ] && [ "$check" != 1 ]; then
  echo "ignored: Kind: pr requires a verified merged PR"
  exit 3
fi

# Compound form: split on " AND " and evaluate each side with this same
# program, so every side gets exactly the single-predicate grammar below.
if [[ "$predicate" == *" AND "* ]]; then
  rest="$predicate"
  overall=0
  while :; do
    case "$rest" in
      *" AND "*)
        atom="${rest%%" AND "*}"
        rest="${rest#*" AND "}"
        ;;
      *)
        atom="$rest"
        rest=""
        ;;
    esac
    # Trim surrounding whitespace.
    atom="${atom#"${atom%%[![:space:]]*}"}"
    atom="${atom%"${atom##*[![:space:]]}"}"
    if [ -z "$atom" ]; then
      echo "malformed: empty side in compound DONE-WHEN predicate: $predicate"
      malformed_marker
      exit 2
    fi
    if [ "$check" = 1 ]; then
      atom_out="$("$0" --check --predicate "$atom")"
    else
      atom_out="$("$0" --kind "${kind:-validation}" --predicate "$atom")"
    fi
    atom_rc=$?
    # Only the whole predicate gets a marker line; drop the side's own.
    atom_out="$(printf '%s\n' "$atom_out" | grep -v '^DONE-WHEN-MALFORMED:' || true)"
    printf '  [%s] %s\n' "$atom_rc" "$atom_out"
    if [ "$atom_rc" -eq 2 ]; then
      echo "malformed: compound DONE-WHEN has an unsupported side: $atom"
      malformed_marker
      exit 2
    fi
    if [ "$atom_rc" -ne 0 ]; then
      overall=1
    fi
    [ -n "$rest" ] || break
  done
  if [ "$check" = 1 ]; then
    echo "well-formed: compound DONE-WHEN"
    exit 0
  fi
  if [ "$overall" -eq 0 ]; then
    echo "satisfied: every side of the compound DONE-WHEN is satisfied"
    exit 0
  fi
  echo "pending: at least one side of the compound DONE-WHEN is not satisfied"
  exit 1
fi

if [[ "$predicate" =~ ^brain[[:space:]]+([^[:space:]]+)[[:space:]]+exists$ ]]; then
  slug="${BASH_REMATCH[1]}"
  well_formed "brain exists"
  if brain get "$slug" >/dev/null 2>&1; then
    echo "satisfied: brain $slug exists"
    exit 0
  fi
  echo "pending: brain $slug does not exist"
  exit 1
fi

if [[ "$predicate" =~ ^brain[[:space:]]+([^[:space:]]+)[[:space:]]+updated-after[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2})$ ]]; then
  slug="${BASH_REMATCH[1]}"
  cutoff="${BASH_REMATCH[2]}"
  well_formed "brain updated-after"
  record="$(brain get "$slug" 2>/dev/null)" || {
    echo "pending: brain $slug does not exist"
    exit 1
  }
  updated="$(printf '%s\n' "$record" | awk '/^updated_at:/ { print substr($2, 1, 10); exit }')"
  if [ -n "$updated" ] && [[ "$updated" > "$cutoff" || "$updated" = "$cutoff" ]]; then
    echo "satisfied: brain $slug updated_at $updated >= $cutoff"
    exit 0
  fi
  echo "pending: brain $slug updated_at ${updated:-unknown} < $cutoff"
  exit 1
fi

if [[ "$predicate" =~ ^routine[[:space:]]+([^[:space:]]+)[[:space:]]+heartbeat[[:space:]]+matches[[:space:]]+/(.*)/[[:space:]]+after[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2})$ ]]; then
  routine="${BASH_REMATCH[1]}"
  regex="${BASH_REMATCH[2]}"
  cutoff="${BASH_REMATCH[3]}"
  well_formed "routine heartbeat"
  # Heartbeats live on the filesystem, not LastDB/brain.
  hb_file="${LAST_STACK_HEARTBEATS_FILE:-}"
  if [ -z "$hb_file" ]; then
    # Resolve the file symlink chain before dirname: the PATH link
    # ~/.local/bin/<name> points into the artifact tree, and siblings live there.
    _self_src="$0"
    while [ -L "$_self_src" ]; do
      _self_link="$(readlink "$_self_src")"
      case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
    done
    _ls_root="$(cd "$(dirname "$_self_src")/.." && pwd)"
    if [ -d "$_ls_root/logs" ]; then  # the artifact tree has no logs/; fall back to the compat root
      hb_file="$_ls_root/logs/routine-heartbeats.log"
    else
      hb_file="${HOME}/.last-stack/logs/routine-heartbeats.log"
    fi
  fi
  if [ ! -f "$hb_file" ]; then
    echo "pending: heartbeats log unavailable ($hb_file)"
    exit 1
  fi
  heartbeats="$(cat "$hb_file")"
  match_line="$(
    printf '%s\n' "$heartbeats" |
      awk -v routine="$routine" -v regex="$regex" -v cutoff="$cutoff" '
        index($0, routine) && $0 ~ regex {
          if (match($0, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/)) {
            line_date = substr($0, RSTART, RLENGTH)
            if (line_date >= cutoff) {
              print
              exit
            }
          }
        }
      '
  )"
  if [ -n "$match_line" ]; then
    echo "satisfied: routine $routine heartbeat matched after $cutoff: $match_line"
    exit 0
  fi
  echo "pending: no routine $routine heartbeat matched /$regex/ after $cutoff"
  exit 1
fi

if [[ "$predicate" =~ ^date[[:space:]]+\>=[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2})$ ]]; then
  cutoff="${BASH_REMATCH[1]}"
  well_formed "date"
  today="$(date -u +%F)"
  if [[ "$today" > "$cutoff" || "$today" = "$cutoff" ]]; then
    echo "satisfied: date $today >= $cutoff"
    exit 0
  fi
  echo "pending: date $today < $cutoff"
  exit 1
fi

if [[ "$predicate" =~ ^file[[:space:]]+([^[:space:]]+)[[:space:]]+matches[[:space:]]+/(.*)/$ ]]; then
  path="${BASH_REMATCH[1]}"
  regex="${BASH_REMATCH[2]}"
  well_formed "file matches"
  # Expand ~ and $HOME so harness reports under ~/.last-stack/north-star-proofs work.
  if [[ "$path" == "~/"* ]]; then
    path="$HOME/${path:2}"
  fi
  path="${path//\$HOME/$HOME}"
  if [ ! -f "$path" ]; then
    echo "pending: file $path does not exist"
    exit 1
  fi
  if grep -Eq "$regex" "$path"; then
    echo "satisfied: file $path matches /$regex/"
    exit 0
  fi
  echo "pending: file $path does not match /$regex/"
  exit 1
fi

echo "malformed: unsupported DONE-WHEN predicate: $predicate"
echo "  supported: brain <slug> exists | brain <slug> updated-after <date> | routine <name> heartbeat matches /<re>/ after <date> | date >= <date> | file <path> matches /<re>/ | <any of these> AND <any of these>"
echo "  commands and LastDB ops conditions are not evaluated; write the proof to a file and use: file <path> matches /<re>/"
malformed_marker
exit 2
