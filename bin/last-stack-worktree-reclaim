#!/usr/bin/env bash
# Reclaim agent worktrees under ~/.fkanban/worktrees (and legacy ~/.kanban).
#
# Tom 2026-07-30: card closeout and disk-reclaim must not leave multi-GB
# abandoned checkouts. This helper is the single reclaim path.
#
# Usage:
#   last-stack-worktree-reclaim --slug <slug> [--branch NAME] [--dry-run]
#   last-stack-worktree-reclaim --path <worktree-path> [--dry-run]
#   last-stack-worktree-reclaim --sweep-stale [--max-age-hours 48] [--dry-run]
#
# Reclaim one worktree:
#   1. Skip if the worktree is "live" (unless --force-live). Live means any of:
#        - a process has cwd inside it
#        - a process is executing an image under it (e.g. target/release/lastdb)
#        - recent cargo/node build markers under target/ / node_modules/
#   2. Strip generated caches: target/, node_modules/, .next/, dist/, build/
#      (and nested up to depth 4). Directories git TRACKS are kept — some repos
#      commit prebuilt output under those names on purpose.
#   3. If the tree is dirty: save a patch under
#      ~/.local/state/last-stack/runtime/worktree-patches/<name>-<ts>.patch
#      then remove the worktree anyway (source is recoverable from branch/PR
#      or the patch).
#   4. git worktree remove --force (or rm -rf + worktree prune).
#   5. Best-effort: delete fully-merged local branch.
#
# --sweep-stale: reclaim every managed worktree whose board card is NOT in
# doing and whose directory mtime is older than --max-age-hours (default 48).
# Generated-cache strip only runs when disk free space is under the free-floor
# (LAST_STACK_RECLAIM_FREE_FLOOR_GIB, default 80 GiB) AND the worktree is not
# live. Age-gated removal still runs when free is abundant, but still refuses
# to strip/remove live trees.
#
# Exit 0 on success (including dry-run / nothing-to-do). Never fails the caller
# hard for best-effort cleanup of a missing worktree.
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
home="${HOME:-/Users/REPLACE}"
# When WORKTREES_DIR is explicitly set (tests / agents), only scan that root so
# a private fixture never also walks the real ~/.kanban pool.
if [ -n "${WORKTREES_DIR:-}" ]; then
  worktree_roots=("$WORKTREES_DIR")
else
  worktree_roots=(
    "$home/.fkanban/worktrees"
    "$home/.kanban/worktrees"
  )
fi
patch_root="${LAST_STACK_WORKTREE_PATCH_DIR:-$home/.local/state/last-stack/runtime/worktree-patches}"
mkdir -p "$patch_root" 2>/dev/null || true

# Free GiB at or above this floor → skip broad generated-cache strip in --sweep-stale.
# Override with LAST_STACK_RECLAIM_FREE_FLOOR_GIB=0 to force strip (tests / emergency).
free_floor_gib="${LAST_STACK_RECLAIM_FREE_FLOOR_GIB:-80}"
# Build-marker freshness window (minutes). Fresh fingerprints imply an in-flight build.
build_fresh_min="${LAST_STACK_RECLAIM_BUILD_FRESH_MIN:-30}"

slug=""
branch=""
path_arg=""
sweep_stale=0
max_age_hours=48
dry_run=0
force_live=0

# Optional once-per-run live index file (paths of live worktree roots / prefixes).
# Built for --sweep-stale so we pay O(processes) once, not per worktree.
live_index=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --slug) slug="${2:-}"; shift 2 ;;
    --branch) branch="${2:-}"; shift 2 ;;
    --path) path_arg="${2:-}"; shift 2 ;;
    --sweep-stale) sweep_stale=1; shift ;;
    --max-age-hours) max_age_hours="${2:-48}"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    --force-live) force_live=1; shift ;;
    -h|--help)
      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$slug" ] && [ -z "$path_arg" ] && [ "$sweep_stale" -eq 0 ]; then
  echo "usage: last-stack-worktree-reclaim --slug S | --path P | --sweep-stale" >&2
  exit 2
fi

log() { printf 'last-stack-worktree-reclaim: %s\n' "$*"; }

# Free space on the data volume hosting $HOME (GiB). macOS df -g; Linux df -BG.
free_gib_home() {
  local g
  if g="$(df -g "$home" 2>/dev/null | awk 'NR==2 {print $4}')"; then
    case "$g" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$g"; return 0 ;;
    esac
  fi
  if g="$(df -BG "$home" 2>/dev/null | awk 'NR==2 {print $4}' | tr -d 'G')"; then
    case "$g" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$g"; return 0 ;;
    esac
  fi
  # Unknown → treat as under pressure so we still reclaim (fail-open for cleanup).
  printf '0\n'
}

under_disk_pressure() {
  local free
  free="$(free_gib_home)"
  if [ "${free:-0}" -lt "${free_floor_gib:-80}" ]; then
    return 0
  fi
  return 1
}

# Normalize a path for prefix matching (strip trailing slash).
_norm_path() {
  local p="${1%/}"
  printf '%s\n' "$p"
}

# True if $child is $parent or under $parent.
_path_under() {
  local parent child
  parent="$(_norm_path "$1")"
  child="$(_norm_path "$2")"
  case "$child" in
    "$parent"|"$parent"/*) return 0 ;;
  esac
  return 1
}

# Fresh cargo/node build markers under the worktree (cheap liveness signal).
# Bound depth hard — unbounded find over multi-GB target/ stalls the hourly sweep.
has_fresh_build_markers() {
  local wt="$1"
  local min="${build_fresh_min:-30}"
  local f
  # Cargo: .rustc_info.json at target root is rewritten during builds.
  f="$wt/target/.rustc_info.json"
  if [ -f "$f" ]; then
    if find "$f" -mmin "-${min}" 2>/dev/null | head -n 1 | grep -q .; then
      return 0
    fi
  fi
  # Fingerprint invoked.timestamp (depth-bounded under target/{debug,release}).
  if [ -d "$wt/target" ]; then
    if find "$wt/target" -maxdepth 5 -name 'invoked.timestamp' -mmin "-${min}" \
      2>/dev/null | head -n 1 | grep -q .; then
      return 0
    fi
  fi
  # Node / Next shallow markers
  if [ -d "$wt/.next" ] || [ -d "$wt/node_modules" ]; then
    if find "$wt" -maxdepth 3 \( -name 'BUILD_ID' -o -name '.yarn-integrity' \) \
      -mmin "-${min}" 2>/dev/null | head -n 1 | grep -q .; then
      return 0
    fi
  fi
  return 1
}

# Process cwd or command/exe path under worktree.
# Prefer a prebuilt live_index when present (sweep path). Never per-PID
# double-lsof — that is O(processes) and timed out at ~minutes on a busy host.
has_live_process() {
  local wt="$1"
  local line
  wt="$(_norm_path "$wt")"

  if [ -n "${live_index:-}" ] && [ -f "$live_index" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      case "$line" in
        "$wt"|"$wt"/*) return 0 ;;
      esac
      # Index may hold a parent path that equals the worktree root.
      if _path_under "$wt" "$line"; then
        return 0
      fi
    done <"$live_index"
    return 1
  fi

  # Single-target path: bulk cwd list (one lsof) + command-line path match.
  if lsof -nP -a -u "$(id -un)" -d cwd -Fn 2>/dev/null \
    | awk -v wt="$wt" '
        /^n/ {
          p = substr($0, 2)
          sub(/\/$/, "", p)
          if (p == wt || index(p, wt "/") == 1) { found = 1 }
        }
        END { exit !found }
      '; then
    return 0
  fi
  # Product binary or build tool with worktree path on argv (absolute path exec).
  # pgrep -f matches the full command line; covers target/release/<bin> runs
  # whose cwd is elsewhere.
  if pgrep -f "$wt" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

# Combined live predicate used by every strip/remove path.
# Keeps the historical name has_live_cwd for callers/tests; semantics are broader.
has_live_cwd() {
  local wt="$1"
  [ -d "$wt" ] || return 1
  if has_live_process "$wt"; then
    return 0
  fi
  if has_fresh_build_markers "$wt"; then
    return 0
  fi
  return 1
}

# One-shot process scan → live_index lines (cwd paths + argv path tokens).
# Cost: one bulk lsof (cwd) + one ps, not O(processes)×lsof.
# LAST_STACK_RECLAIM_EXTRA_LIVE_PATHS: colon-separated absolute paths forced live
# (tests inject a fixture cwd without relying on bulk lsof alone).
build_live_index() {
  local out="$1"
  local root cmd tok extra
  : >"$out"
  # Explicit extra live paths (tests / callers).
  if [ -n "${LAST_STACK_RECLAIM_EXTRA_LIVE_PATHS:-}" ]; then
    IFS=':' read -r -a _extra_paths <<< "${LAST_STACK_RECLAIM_EXTRA_LIVE_PATHS}"
    for extra in "${_extra_paths[@]}"; do
      [ -n "$extra" ] || continue
      printf '%s\n' "$(_norm_path "$extra")" >>"$out"
    done
  fi
  # All user cwds in one lsof (skip when LAST_STACK_RECLAIM_SKIP_LSOF=1 for
  # fast unit tests that inject EXTRA_LIVE_PATHS).
  if [ "${LAST_STACK_RECLAIM_SKIP_LSOF:-0}" != "1" ]; then
    lsof -nP -a -u "$(id -un)" -d cwd -Fn 2>/dev/null \
      | awk '/^n/ { p = substr($0, 2); sub(/\/$/, "", p); if (p != "") print p }' \
      >>"$out" || true
  fi
  # Command lines that mention a managed worktree root (absolute-path product
  # binaries, cargo invocations with explicit manifest paths, etc.).
  for root in "${worktree_roots[@]}"; do
    [ -d "$root" ] || continue
    root="$(_norm_path "$root")"
    while IFS= read -r cmd; do
      [ -z "$cmd" ] && continue
      # Emit space-separated tokens that contain the root prefix.
      # shellcheck disable=SC2086
      for tok in $cmd; do
        case "$tok" in
          "$root"|"$root"/*)
            printf '%s\n' "$(_norm_path "$tok")" >>"$out"
            ;;
        esac
      done
    done < <(ps -axo command= 2>/dev/null | grep -F -- "$root" || true)
  done
  if [ -s "$out" ]; then
    sort -u "$out" -o "$out" 2>/dev/null || true
  fi
}

strip_generated() {
  local wt="$1"
  local d tracked
  local is_repo=0

  # Shared call-site guard (won't-undo): every path that deletes target/ must
  # refuse when the worktree is live. --force-live bypasses for explicit ops.
  if [ "$force_live" -eq 0 ] && has_live_cwd "$wt"; then
    log "skip strip live $wt"
    return 0
  fi

  if git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    is_repo=1
  fi
  # top-level + nested (bounded)
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    # A "generated" NAME is not proof the content is generated. Some repos
    # commit prebuilt output under one of these names on purpose and un-ignore
    # it explicitly (fkanban/brain/situations all vendor an SDK as
    # vendor/lastdb-app-sdk/dist, kept tracked by a `!` rule in .gitignore).
    # Deleting those leaves the worktree permanently dirty with 30-40 tracked
    # deletions, and the standing "stage the whole worktree with git add -A
    # before committing" rule would then commit the removal of files the build
    # needs. Strip only what git does not track.
    if [ "$is_repo" -eq 1 ]; then
      tracked="$(git -C "$wt" ls-files -- "$d" 2>/dev/null | head -n 1 || true)"
      if [ -n "$tracked" ]; then
        log "kept tracked $d"
        continue
      fi
    fi
    if [ "$dry_run" -eq 1 ]; then
      log "dry-run strip $d"
    else
      rm -rf "$d" 2>/dev/null || true
      log "stripped $d"
    fi
  done < <(
    find "$wt" -maxdepth 4 \( \
      -type d \( -name target -o -name node_modules -o -name .next -o -name dist -o -name build \) \
      -o -type d -name '__pycache__' \
    \) 2>/dev/null || true
  )
}

save_dirty_patch() {
  local wt="$1"
  local name
  name="$(basename "$wt")"
  if ! git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi
  if [ -z "$(git -C "$wt" status --porcelain 2>/dev/null || true)" ]; then
    return 0
  fi
  local ts patch
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  patch="$patch_root/${name}-${ts}.patch"
  if [ "$dry_run" -eq 1 ]; then
    log "dry-run would save dirty patch $patch"
    return 0
  fi
  # Best-effort: tracked + untracked as binary-capable patch
  {
    git -C "$wt" diff HEAD 2>/dev/null || true
    git -C "$wt" diff --cached 2>/dev/null || true
    # untracked as empty-file diffs when possible
    git -C "$wt" ls-files --others --exclude-standard 2>/dev/null | head -200 | while IFS= read -r f; do
      [ -f "$wt/$f" ] || continue
      git -C "$wt" diff --no-index -- /dev/null "$f" 2>/dev/null || true
    done
  } >"$patch" 2>/dev/null || true
  if [ -s "$patch" ]; then
    log "saved dirty patch $patch bytes=$(wc -c <"$patch" | tr -d ' ')"
  else
    rm -f "$patch" 2>/dev/null || true
    log "dirty but empty patch for $name (generated-only?)"
  fi
}

resolve_repo() {
  local wt="$1"
  local common repo
  common=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  [ -n "$common" ] || { echo ""; return 0; }
  case "$common" in
    */.git) repo=$(dirname "$common") ;;
    */.git/worktrees/*) repo=$(dirname "$(dirname "$(dirname "$common")")") ;;
    *) repo=$(dirname "$common") ;;
  esac
  echo "$repo"
}

remove_worktree() {
  local wt="$1"
  local repo br
  [ -d "$wt" ] || return 0
  if [ "$force_live" -eq 0 ] && has_live_cwd "$wt"; then
    log "skip live-cwd $wt"
    return 0
  fi
  strip_generated "$wt"
  save_dirty_patch "$wt"
  br="$(git -C "$wt" branch --show-current 2>/dev/null || true)"
  repo="$(resolve_repo "$wt")"
  if [ "$dry_run" -eq 1 ]; then
    log "dry-run remove $wt repo=${repo:-none} branch=${br:-none}"
    return 0
  fi
  if [ -n "$repo" ] && [ -d "$repo/.git" ] || [ -f "$repo/.git" ]; then
    if git -C "$repo" worktree remove --force "$wt" 2>/dev/null; then
      log "removed worktree $wt"
    else
      rm -rf "$wt"
      git -C "$repo" worktree prune 2>/dev/null || true
      log "force-rm worktree $wt (pruned $repo)"
    fi
    # Best-effort delete merged branch (never force-delete unique WIP)
    if [ -n "$br" ] && [ "$br" != "main" ] && [ "$br" != "master" ]; then
      if git -C "$repo" merge-base --is-ancestor "$br" HEAD 2>/dev/null \
        || git -C "$repo" branch -d "$br" 2>/dev/null; then
        git -C "$repo" branch -d "$br" 2>/dev/null || true
        log "deleted branch $br in $repo (if merged)"
      else
        # try -d only; do not -D unique work
        git -C "$repo" branch -d "$br" 2>/dev/null || log "kept branch $br (not fully merged)"
      fi
    fi
  else
    rm -rf "$wt"
    log "rm orphan path $wt"
  fi
}

find_slug_paths() {
  local s="$1"
  local root
  for root in "${worktree_roots[@]}"; do
    [ -d "$root" ] || continue
    # exact and *-kanban-<slug> and *<slug>*
    for d in "$root"/*; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      case "$name" in
        "$s"|*-kanban-"$s"|*"$s"*) printf '%s\n' "$d" ;;
      esac
    done
  done
}

doing_slugs() {
  # Tests / offline runs can skip the board round-trip.
  if [ "${LAST_STACK_RECLAIM_SKIP_BOARD:-0}" = "1" ]; then
    return 0
  fi
  local cli=""
  if command -v kanban >/dev/null 2>&1; then cli=kanban
  else
    return 0
  fi
  "$cli" list --column doing --json 2>/dev/null | python3 - <<'PY' 2>/dev/null || true
import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
cards=d.get("cards") if isinstance(d,dict) else d
if not isinstance(cards,list):
    cards=[]
for c in cards:
    if not isinstance(c,dict):
        continue
    s=str(c.get("slug") or "").strip()
    if s:
        print(s)
PY
}

reclaimed=0
stripped_only=0
strip_skipped_live=0
strip_skipped_pressure=0

if [ -n "$path_arg" ]; then
  remove_worktree "$path_arg"
  reclaimed=1
fi

if [ -n "$slug" ]; then
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    remove_worktree "$p"
    reclaimed=$((reclaimed + 1))
  done < <(find_slug_paths "$slug" | sort -u)
  # also try branch name if provided
  if [ -n "$branch" ]; then
    bsafe="${branch//\//-}"
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      remove_worktree "$p"
      reclaimed=$((reclaimed + 1))
    done < <(find_slug_paths "$bsafe" | sort -u)
  fi
fi

if [ "$sweep_stale" -eq 1 ]; then
  # Build doing protect set
  protect_file="$(mktemp)"
  doing_slugs >"$protect_file" || true
  now_epoch="$(date -u +%s)"
  max_age_sec=$((max_age_hours * 3600))

  # Once-per-sweep live process index (cwd + exe paths).
  live_index="$(mktemp)"
  build_live_index "$live_index" || true

  free_now="$(free_gib_home)"
  do_strip=1
  if ! under_disk_pressure; then
    do_strip=0
    strip_skipped_pressure=1
    log "broad_sweep_skipped_disk_pressure free_gib=${free_now} floor_gib=${free_floor_gib}"
  else
    log "disk_pressure free_gib=${free_now} floor_gib=${free_floor_gib} strip_enabled=1"
  fi

  for root in "${worktree_roots[@]}"; do
    [ -d "$root" ] || continue
    for d in "$root"/*; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"

      # Generated-cache strip: only under disk pressure, and never for live trees.
      # Guard lives inside strip_generated; we still skip the call when free.
      if [ "$do_strip" -eq 1 ]; then
        if [ "$force_live" -eq 0 ] && has_live_cwd "$d"; then
          log "keep live strip-skip $name"
          strip_skipped_live=$((strip_skipped_live + 1))
        else
          strip_generated "$d"
          stripped_only=$((stripped_only + 1))
        fi
      fi

      # protect doing slugs (substring match)
      prot=0
      while IFS= read -r s; do
        [ -z "$s" ] && continue
        case "$name" in
          *"$s"*) prot=1; break ;;
        esac
      done <"$protect_file"
      case "$name" in
        salvage-*|tombstone-*|locked*) prot=1 ;;
      esac
      # live process / fresh build: never remove the worktree either
      if [ "$force_live" -eq 0 ] && has_live_cwd "$d"; then
        prot=1
      fi
      if [ "$prot" -eq 1 ]; then
        log "keep protected $name"
        continue
      fi
      # age by directory mtime
      mtime="$(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || echo 0)"
      age=$((now_epoch - mtime))
      if [ "$age" -lt "$max_age_sec" ]; then
        log "keep young ${name} age_h=$((age / 3600))"
        continue
      fi
      remove_worktree "$d"
      reclaimed=$((reclaimed + 1))
    done
  done
  rm -f "$protect_file" "$live_index"
  live_index=""
fi

log "done reclaimed=$reclaimed stripped_paths=$stripped_only strip_skipped_live=$strip_skipped_live strip_skipped_pressure=$strip_skipped_pressure free_floor_gib=$free_floor_gib dry_run=$dry_run"
exit 0
