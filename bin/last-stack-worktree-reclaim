#!/usr/bin/env bash
# Reclaim agent worktrees under ~/.fkanban/worktrees (and legacy ~/.kanban).
#
# Tom 2026-07-30: card closeout and disk-reclaim must not leave multi-GB
# abandoned checkouts. This helper is the single reclaim path.
#
# Usage:
#   last-stack-worktree-reclaim --slug <slug> [--branch NAME] [--dry-run]
#   last-stack-worktree-reclaim --path <worktree-path> [--dry-run]
#   last-stack-worktree-reclaim --sweep-stale [--max-age-hours 48] [--dry-run]
#
# Reclaim one worktree:
#   1. Skip if the worktree is "live" (unless --force-live). Live means any of:
#        - a process has cwd inside it
#        - a process is executing an image under it (e.g. target/release/lastdb)
#        - recent cargo/node build markers under target/ / node_modules/
#   2. Strip generated caches: target/, node_modules/, .next/, dist/, build/
#      (and nested up to depth 4). Directories git TRACKS are kept — some repos
#      commit prebuilt output under those names on purpose.
#   3. If the tree is dirty: save a patch under
#      ~/.local/state/last-stack/runtime/worktree-patches/<name>-<ts>.patch
#      then remove the worktree anyway (source is recoverable from branch/PR
#      or the patch).
#   4. git worktree remove --force (or rm -rf + worktree prune).
#   5. Best-effort: delete fully-merged local branch.
#
# --sweep-stale: reclaim every managed worktree whose board card is NOT in
# doing and whose directory mtime is older than --max-age-hours (default 48).
# Generated-cache strip only runs when disk free space is under the free-floor
# (LAST_STACK_RECLAIM_FREE_FLOOR_GIB, default 80 GiB) AND the worktree is not
# live. Age-gated removal still runs when free is abundant, but still refuses
# to strip/remove live trees.
#
# Exit 0 on success (including dry-run / nothing-to-do). Never fails the caller
# hard for best-effort cleanup of a missing worktree.
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
home="${HOME:-/Users/REPLACE}"
# When WORKTREES_DIR is explicitly set (tests / agents), only scan that root so
# a private fixture never also walks the real ~/.kanban pool.
if [ -n "${WORKTREES_DIR:-}" ]; then
  worktree_roots=("$WORKTREES_DIR")
else
  worktree_roots=(
    "$home/.fkanban/worktrees"
    "$home/.kanban/worktrees"
  )
fi
patch_root="${LAST_STACK_WORKTREE_PATCH_DIR:-$home/.local/state/last-stack/runtime/worktree-patches}"
mkdir -p "$patch_root" 2>/dev/null || true

# Free GiB at or above this floor → skip broad generated-cache strip in --sweep-stale.
# Override with LAST_STACK_RECLAIM_FREE_FLOOR_GIB=0 to force strip (tests / emergency).
free_floor_gib="${LAST_STACK_RECLAIM_FREE_FLOOR_GIB:-80}"
# Build-marker freshness window (minutes). Fresh fingerprints imply an in-flight build.
build_fresh_min="${LAST_STACK_RECLAIM_BUILD_FRESH_MIN:-30}"

slug=""
branch=""
path_arg=""
sweep_stale=0
max_age_hours=48
# Grace period before a CLEAN, idle, unprotected worktree is reclaimable.
# Finished work does not become safe to delete by aging — it is already safe.
# Age is only a proxy for "might still be in use", and we have better signals
# (doing-card, live process, fresh build markers, dirty tree). This short grace
# exists purely to avoid racing a worktree created seconds before the sweep.
min_age_minutes="${LAST_STACK_RECLAIM_MIN_AGE_MIN:-60}"
dry_run=0
force_live=0

# Optional once-per-run live index file (paths of live worktree roots / prefixes).
# Built for --sweep-stale so we pay O(processes) once, not per worktree.
live_index=""
# Set by has_live_cwd so destructive-path logs explain why a tree was spared.
live_reason=""
# 1 when the process-inspection instruments (lsof/ps) did not work this run.
# Hard-closed behaviour (no board protect set): every tree is treated as live
# and nothing is removed. Soft-degrade (board read succeeded this run): keep
# board protect + fresh build markers, skip process-based live checks, still
# reclaim finished non-doing worktrees. See build_live_index / has_live_cwd.
# A sandbox that denies ps/lsof previously produced an EMPTY index, which is
# indistinguishable from "the machine is idle" — so every worktree looked
# reclaimable until fail-closed landed. The soft path exists because the
# scheduled disk-reclaim harness runs under a sandbox that denies ps while
# board reads still work (2026-08-17: free space collapsed ~100 GiB while
# hourly runs hard-aborted with liveness_unavailable=1 reclaimed_gb=0).
liveness_unavailable=0
# 1 when soft-degrade is active (liveness probe failed but board protect is real).
liveness_soft=0
# 1 when the board could not be read, so the doing-card protect set is empty
# for lack of knowledge rather than lack of active work. The fast reclaim path
# is disabled in that case; only the conservative age gate applies.
board_unavailable=0
# 1 only after a successful board list this run (not SKIP_BOARD, not a failed read).
# Soft-degrade requires this: without a real protect set we stay hard-closed.
board_read_ok=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --slug) slug="${2:-}"; shift 2 ;;
    --branch) branch="${2:-}"; shift 2 ;;
    --path) path_arg="${2:-}"; shift 2 ;;
    --sweep-stale) sweep_stale=1; shift ;;
    --max-age-hours) max_age_hours="${2:-48}"; shift 2 ;;
    --min-age-minutes) min_age_minutes="${2:-60}"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    --force-live) force_live=1; shift ;;
    -h|--help)
      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$slug" ] && [ -z "$path_arg" ] && [ "$sweep_stale" -eq 0 ]; then
  echo "usage: last-stack-worktree-reclaim --slug S | --path P | --sweep-stale" >&2
  exit 2
fi

log() { printf 'last-stack-worktree-reclaim: %s\n' "$*"; }

# Free space on the data volume hosting $HOME (GiB). macOS df -g; Linux df -BG.
free_gib_home() {
  local g
  if g="$(df -g "$home" 2>/dev/null | awk 'NR==2 {print $4}')"; then
    case "$g" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$g"; return 0 ;;
    esac
  fi
  if g="$(df -BG "$home" 2>/dev/null | awk 'NR==2 {print $4}' | tr -d 'G')"; then
    case "$g" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$g"; return 0 ;;
    esac
  fi
  # Unknown → treat as under pressure so we still reclaim (fail-open for cleanup).
  printf '0\n'
}

under_disk_pressure() {
  local free
  free="$(free_gib_home)"
  if [ "${free:-0}" -lt "${free_floor_gib:-80}" ]; then
    return 0
  fi
  return 1
}

# Normalize a path for prefix matching (strip trailing slash).
_norm_path() {
  local p="${1%/}"
  printf '%s\n' "$p"
}

# True if $child is $parent or under $parent.
_path_under() {
  local parent child
  parent="$(_norm_path "$1")"
  child="$(_norm_path "$2")"
  case "$child" in
    "$parent"|"$parent"/*) return 0 ;;
  esac
  return 1
}

# Fresh cargo/node build markers under the worktree (cheap liveness signal).
# Bound depth hard — unbounded find over multi-GB target/ stalls the hourly sweep.
has_fresh_build_markers() {
  local wt="$1"
  local min="${build_fresh_min:-30}"
  local f
  # Cargo: .rustc_info.json at target root is rewritten during builds.
  f="$wt/target/.rustc_info.json"
  if [ -f "$f" ]; then
    if find "$f" -mmin "-${min}" 2>/dev/null | head -n 1 | grep -q .; then
      return 0
    fi
  fi
  # Fingerprint invoked.timestamp (depth-bounded under target/{debug,release}).
  if [ -d "$wt/target" ]; then
    if find "$wt/target" -maxdepth 5 -name 'invoked.timestamp' -mmin "-${min}" \
      2>/dev/null | head -n 1 | grep -q .; then
      return 0
    fi
  fi
  # Node / Next shallow markers
  if [ -d "$wt/.next" ] || [ -d "$wt/node_modules" ]; then
    if find "$wt" -maxdepth 3 \( -name 'BUILD_ID' -o -name '.yarn-integrity' \) \
      -mmin "-${min}" 2>/dev/null | head -n 1 | grep -q .; then
      return 0
    fi
  fi
  return 1
}

# Process cwd or command/exe path under worktree.
# Prefer a prebuilt live_index when present (sweep path). Never per-PID
# double-lsof — that is O(processes) and timed out at ~minutes on a busy host.
has_live_process() {
  local wt="$1"
  local reason line
  wt="$(_norm_path "$wt")"
  live_reason=""

  if [ -n "${live_index:-}" ] && [ -f "$live_index" ]; then
    while IFS=$'\t' read -r reason line; do
      # Accept the old plain-path format when a caller supplies its own index.
      if [ -z "${line:-}" ]; then
        line="$reason"
        reason="live_exec_image"
      fi
      [ -z "$line" ] && continue
      case "$line" in
        "$wt"|"$wt"/*)
          live_reason="${reason:-live_exec_image}"
          return 0
          ;;
      esac
      # Index may hold a parent path that equals the worktree root.
      if _path_under "$wt" "$line"; then
        live_reason="${reason:-live_exec_image}"
        return 0
      fi
    done <"$live_index"
    return 1
  fi

  # Single-target path: one bulk cwd pass plus command/executable path match.
  reason="$(lsof -nP -a -u "$(id -un)" -d cwd -Fn 2>/dev/null \
    | awk -v wt="$wt" '
        /^n/ {
          p = substr($0, 2)
          sub(/\/$/, "", p)
          if (p == wt || index(p, wt "/") == 1) {
            print "live_cwd"
            exit
          }
        }
      ' || true)"
  if [ -n "$reason" ]; then
    live_reason="$reason"
    return 0
  fi
  # Product binary or build tool with worktree path on argv (absolute path exec).
  # pgrep -f matches the full command line; covers target/release/<bin> runs
  # whose cwd is elsewhere.
  if pgrep -f "$wt" >/dev/null 2>&1; then
    live_reason="live_exec_image"
    return 0
  fi
  return 1
}

# Combined live predicate used by every strip/remove path.
# Keeps the historical name has_live_cwd for callers/tests; semantics are broader.
has_live_cwd() {
  local wt="$1"
  live_reason=""
  [ -d "$wt" ] || return 1
  # Process table missing:
  #   hard (no board_read_ok): fail CLOSED — treat everything as live.
  #   soft (board_read_ok): only fresh build markers count as live; process
  #   checks are skipped. Board protect covers doing cards separately.
  if [ "$liveness_unavailable" -eq 1 ]; then
    if [ "${liveness_soft:-0}" -eq 1 ]; then
      if has_fresh_build_markers "$wt"; then
        live_reason="fresh_build_marker"
        return 0
      fi
      return 1
    fi
    live_reason="liveness_unavailable"
    return 0
  fi
  if has_live_process "$wt"; then
    return 0
  fi
  if has_fresh_build_markers "$wt"; then
    live_reason="fresh_build_marker"
    return 0
  fi
  return 1
}

# True when the worktree has nothing uncommitted to lose (no modified, staged,
# or untracked files). Used to decide whether a tree still needs the long
# conservative age gate or can be reclaimed on the short grace period.
# A non-repo path is NOT treated as clean — we cannot inspect it, so it keeps
# the conservative path.
worktree_is_clean() {
  local wt="$1"
  git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ]
}

# One-shot process scan → reason<TAB>path index lines.
# Cost: one bulk lsof (cwd) + one ps pass, not O(processes)×lsof.
# LAST_STACK_RECLAIM_EXTRA_LIVE_PATHS: colon-separated absolute paths forced live
# (tests inject a fixture cwd without relying on bulk lsof alone).
# LAST_STACK_RECLAIM_EXTRA_LIVE_EXEC_PATHS: executable-image fixture paths for
# constrained test runners whose process table is sandboxed.
build_live_index() {
  local out="$1"
  local root cmd tok extra
  : >"$out"
  # Explicit extra live paths (tests / callers).
  if [ -n "${LAST_STACK_RECLAIM_EXTRA_LIVE_PATHS:-}" ]; then
    IFS=':' read -r -a _extra_paths <<< "${LAST_STACK_RECLAIM_EXTRA_LIVE_PATHS}"
    for extra in "${_extra_paths[@]}"; do
      [ -n "$extra" ] || continue
      printf 'live_cwd\t%s\n' "$(_norm_path "$extra")" >>"$out"
    done
  fi
  if [ -n "${LAST_STACK_RECLAIM_EXTRA_LIVE_EXEC_PATHS:-}" ]; then
    IFS=':' read -r -a _extra_exec_paths <<< "${LAST_STACK_RECLAIM_EXTRA_LIVE_EXEC_PATHS}"
    for extra in "${_extra_exec_paths[@]}"; do
      [ -n "$extra" ] || continue
      printf 'live_exec_image\t%s\n' "$(_norm_path "$extra")" >>"$out"
    done
  fi
  # All user cwd paths in one lsof (skip when LAST_STACK_RECLAIM_SKIP_LSOF=1 for
  # fast unit tests that inject EXTRA_LIVE_PATHS).
  #
  # Instrument verification (won't-undo): `lsof`/`ps` failures were previously
  # swallowed by `2>/dev/null || true`, leaving an EMPTY index that reads
  # exactly like a machine with nothing running. Under a sandbox that denies
  # them (observed: `ps_denied=1`, `ps_unavailable=sandbox` in the
  # last-stack-disk-reclaim heartbeats) every worktree would classify as idle.
  # A live process ALWAYS has a cwd, so zero cwd rows means the probe failed,
  # never that the host is idle. Same for a ps that cannot see even itself.
  if [ "${LAST_STACK_RECLAIM_SKIP_LSOF:-0}" != "1" ]; then
    lsof_rows=0
    lsof_rows="$(
      lsof -nP -a -u "$(id -un)" -d cwd -Fn 2>/dev/null \
        | awk '/^n/ { p = substr($0, 2); sub(/\/$/, "", p); if (p != "") print "live_cwd\t" p }' \
        | tee -a "$out" | wc -l | tr -d ' '
    )" || lsof_rows=0
    if [ "${lsof_rows:-0}" -eq 0 ]; then
      liveness_unavailable=1
      log "liveness_probe_failed instrument=lsof rows=0 (cannot prove any tree is idle)"
    fi
    # ps must at least see this very process.
    if ! ps -axo pid= 2>/dev/null | grep -q '[0-9]'; then
      liveness_unavailable=1
      log "liveness_probe_failed instrument=ps (cannot enumerate processes)"
    fi
  fi
  # Command lines that mention a managed worktree root (absolute-path product
  # binaries, cargo invocations with explicit manifest paths, etc.).
  for root in "${worktree_roots[@]}"; do
    [ -d "$root" ] || continue
    root="$(_norm_path "$root")"
    while IFS= read -r cmd; do
      [ -z "$cmd" ] && continue
      # Emit space-separated tokens that contain the root prefix.
      # shellcheck disable=SC2086
      for tok in $cmd; do
        case "$tok" in
          "$root"|"$root"/*)
            printf 'live_exec_image\t%s\n' "$(_norm_path "$tok")" >>"$out"
            ;;
        esac
      done
    done < <(
      { ps -axo comm= 2>/dev/null || true; ps -axo command= 2>/dev/null || true; } \
        | grep -F -- "$root" || true
    )
  done
  if [ -s "$out" ]; then
    sort -u "$out" -o "$out" 2>/dev/null || true
  fi
}

strip_generated() {
  local wt="$1"
  local d tracked
  local is_repo=0

  # Shared call-site guard (won't-undo): every path that deletes target/ must
  # refuse when the worktree is live. --force-live bypasses for explicit ops.
  if [ "$force_live" -eq 0 ] && has_live_cwd "$wt"; then
    log "skip strip reason=${live_reason:-live} $wt"
    return 0
  fi

  if git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    is_repo=1
  fi
  # top-level + nested (bounded)
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    # A "generated" NAME is not proof the content is generated. Some repos
    # commit prebuilt output under one of these names on purpose and un-ignore
    # it explicitly (fkanban/brain/situations all vendor an SDK as
    # vendor/lastdb-app-sdk/dist, kept tracked by a `!` rule in .gitignore).
    # Deleting those leaves the worktree permanently dirty with 30-40 tracked
    # deletions, and the standing "stage the whole worktree with git add -A
    # before committing" rule would then commit the removal of files the build
    # needs. Strip only what git does not track.
    if [ "$is_repo" -eq 1 ]; then
      tracked="$(git -C "$wt" ls-files -- "$d" 2>/dev/null | head -n 1 || true)"
      if [ -n "$tracked" ]; then
        log "kept tracked $d"
        continue
      fi
    fi
    if [ "$dry_run" -eq 1 ]; then
      log "dry-run strip $d"
    else
      rm -rf "$d" 2>/dev/null || true
      log "stripped $d"
    fi
  done < <(
    find "$wt" -maxdepth 4 \( \
      -type d \( -name target -o -name node_modules -o -name .next -o -name dist -o -name build \) \
      -o -type d -name '__pycache__' \
    \) 2>/dev/null || true
  )
}

save_dirty_patch() {
  local wt="$1"
  local name
  name="$(basename "$wt")"
  if ! git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi
  if [ -z "$(git -C "$wt" status --porcelain 2>/dev/null || true)" ]; then
    return 0
  fi
  local ts patch
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  patch="$patch_root/${name}-${ts}.patch"
  if [ "$dry_run" -eq 1 ]; then
    log "dry-run would save dirty patch $patch"
    return 0
  fi
  # Best-effort: tracked + untracked as binary-capable patch
  {
    git -C "$wt" diff HEAD 2>/dev/null || true
    git -C "$wt" diff --cached 2>/dev/null || true
    # untracked as empty-file diffs when possible
    git -C "$wt" ls-files --others --exclude-standard 2>/dev/null | head -200 | while IFS= read -r f; do
      [ -f "$wt/$f" ] || continue
      git -C "$wt" diff --no-index -- /dev/null "$f" 2>/dev/null || true
    done
  } >"$patch" 2>/dev/null || true
  if [ -s "$patch" ]; then
    log "saved dirty patch $patch bytes=$(wc -c <"$patch" | tr -d ' ')"
  else
    rm -f "$patch" 2>/dev/null || true
    log "dirty but empty patch for $name (generated-only?)"
  fi
}

resolve_repo() {
  local wt="$1"
  local common repo
  common=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  [ -n "$common" ] || { echo ""; return 0; }
  case "$common" in
    */.git) repo=$(dirname "$common") ;;
    */.git/worktrees/*) repo=$(dirname "$(dirname "$(dirname "$common")")") ;;
    *) repo=$(dirname "$common") ;;
  esac
  echo "$repo"
}

remove_worktree() {
  local wt="$1"
  local repo br
  [ -d "$wt" ] || return 0
  if [ "$force_live" -eq 0 ] && has_live_cwd "$wt"; then
    log "skip remove reason=${live_reason:-live} $wt"
    return 0
  fi
  strip_generated "$wt"
  save_dirty_patch "$wt"
  br="$(git -C "$wt" branch --show-current 2>/dev/null || true)"
  repo="$(resolve_repo "$wt")"
  if [ "$dry_run" -eq 1 ]; then
    log "dry-run remove $wt repo=${repo:-none} branch=${br:-none}"
    return 0
  fi
  if [ -n "$repo" ] && [ -d "$repo/.git" ] || [ -f "$repo/.git" ]; then
    if git -C "$repo" worktree remove --force "$wt" 2>/dev/null; then
      log "removed worktree $wt"
    else
      rm -rf "$wt"
      git -C "$repo" worktree prune 2>/dev/null || true
      log "force-rm worktree $wt (pruned $repo)"
    fi
    # Best-effort delete merged branch (never force-delete unique WIP)
    if [ -n "$br" ] && [ "$br" != "main" ] && [ "$br" != "master" ]; then
      if git -C "$repo" merge-base --is-ancestor "$br" HEAD 2>/dev/null \
        || git -C "$repo" branch -d "$br" 2>/dev/null; then
        git -C "$repo" branch -d "$br" 2>/dev/null || true
        log "deleted branch $br in $repo (if merged)"
      else
        # try -d only; do not -D unique work
        git -C "$repo" branch -d "$br" 2>/dev/null || log "kept branch $br (not fully merged)"
      fi
    fi
  else
    rm -rf "$wt"
    log "rm orphan path $wt"
  fi
}

find_slug_paths() {
  local s="$1"
  local root
  for root in "${worktree_roots[@]}"; do
    [ -d "$root" ] || continue
    # exact and *-kanban-<slug> and *<slug>*
    for d in "$root"/*; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      case "$name" in
        "$s"|*-kanban-"$s"|*"$s"*) printf '%s\n' "$d" ;;
      esac
    done
  done
}

doing_slugs() {
  # Tests / offline runs can skip the board round-trip.
  # Empty protect set is intentional here — keep board_unavailable=0 so the
  # finished-work reclaim path still runs. Soft-degrade must NOT arm
  # (board_read_ok stays 0) because there is no real protect set.
  if [ "${LAST_STACK_RECLAIM_SKIP_BOARD:-0}" = "1" ]; then
    board_read_ok=0
    return 0
  fi
  local cli=""
  if command -v kanban >/dev/null 2>&1; then cli=kanban
  else
    # No board CLI: protect set is unknown, not proven empty.
    board_unavailable=1
    board_read_ok=0
    return 0
  fi
  # Read the board into a FILE, never a pipe into `python3 -`.
  # Won't-undo: `... --json | python3 - <<'PY'` is broken — the heredoc IS
  # stdin, so it supplies the program and `json.load(sys.stdin)` then reads an
  # exhausted stream, raises, and the `except: sys.exit(0)` swallows it. That
  # silently produced an EMPTY protect set on every run, so no doing-card
  # worktree was ever protected. shellcheck catches this as SC2259.
  local tmp
  tmp="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")" || return 0
  if ! "$cli" list --column doing --json >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    # A board we cannot read is not a board with nothing in it.
    log "WARNING doing_slugs: board read failed — protect set empty, sweeping conservatively"
    board_unavailable=1
    board_read_ok=0
    return 0
  fi
  board_read_ok=1
  board_unavailable=0
  if command -v jq >/dev/null 2>&1; then
    jq -r '(if type=="object" then (.cards // []) else . end)[]? | .slug // empty' \
      "$tmp" 2>/dev/null || true
  else
    python3 - "$tmp" <<'PY' 2>/dev/null || true
import json,sys
try:
    with open(sys.argv[1]) as fh:
        d=json.load(fh)
except Exception:
    sys.exit(0)
cards=d.get("cards") if isinstance(d,dict) else d
if not isinstance(cards,list):
    cards=[]
for c in cards:
    if not isinstance(c,dict):
        continue
    s=str(c.get("slug") or "").strip()
    if s:
        print(s)
PY
  fi
  rm -f "$tmp"
}

reclaimed=0
stripped_only=0
strip_skipped_live=0
strip_skipped_pressure=0

if [ -n "$path_arg" ]; then
  remove_worktree "$path_arg"
  reclaimed=1
fi

if [ -n "$slug" ]; then
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    remove_worktree "$p"
    reclaimed=$((reclaimed + 1))
  done < <(find_slug_paths "$slug" | sort -u)
  # also try branch name if provided
  if [ -n "$branch" ]; then
    bsafe="${branch//\//-}"
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      remove_worktree "$p"
      reclaimed=$((reclaimed + 1))
    done < <(find_slug_paths "$bsafe" | sort -u)
  fi
fi

if [ "$sweep_stale" -eq 1 ]; then
  # Build doing protect set
  protect_file="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  doing_slugs >"$protect_file" || true
  now_epoch="$(date -u +%s)"
  max_age_sec=$((max_age_hours * 3600))
  min_age_sec=$((min_age_minutes * 60))

  # Once-per-sweep live process index (cwd + exe paths).
  live_index="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  build_live_index "$live_index" || true
  if [ "$liveness_unavailable" -eq 1 ]; then
    if [ "${board_read_ok:-0}" -eq 1 ]; then
      # Soft-degrade: process table missing but doing-card protect set is real.
      # Still reclaim finished non-doing trees; do not strip caches under
      # pressure (rebuild cost without process proof is the wrong trade).
      liveness_soft=1
      log "SOFT_DEGRADE process inspection unavailable; board protect active — reclaim finished non-doing trees only (no pressure strip)"
    else
      log "REFUSING broad sweep: process inspection unavailable and board protect unavailable — cannot prove any worktree is idle"
    fi
  fi

  free_now="$(free_gib_home)"
  # The pressure floor governs stripping caches out from under work we are
  # KEEPING — that trades disk for an expensive rebuild, so it should wait for
  # real pressure. It must NOT govern stripping a worktree that is idle and
  # unprotected: that tree's target/ is pure waste at any disk level, and
  # gating it on scarcity is why an hourly sweep sat at reclaimed=0 with 195
  # GiB free while the pool grew unbounded.
  do_strip=1
  if [ "${liveness_soft:-0}" -eq 1 ]; then
    # Soft path: never strip under pressure without process proof.
    do_strip=0
    strip_skipped_pressure=1
    log "pressure_skip soft_liveness free_gib=${free_now} floor_gib=${free_floor_gib}"
  elif ! under_disk_pressure; then
    do_strip=0
    strip_skipped_pressure=1
    log "pressure_skip broad_sweep_skipped_disk_pressure free_gib=${free_now} floor_gib=${free_floor_gib}"
  else
    log "disk_pressure free_gib=${free_now} floor_gib=${free_floor_gib} strip_enabled=1"
  fi

  for root in "${worktree_roots[@]}"; do
    [ -d "$root" ] || continue
    for d in "$root"/*; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"

      # Generated-cache strip: only under disk pressure, and never for live trees.
      # Pressure-gating is deliberate — stripping a tree we KEEP costs its owner
      # a full rebuild, so it waits for real scarcity. Removal of finished work
      # below is NOT pressure-gated; that is the part that bounds the pool.
      if [ "$do_strip" -eq 1 ]; then
        if [ "$force_live" -eq 0 ] && has_live_cwd "$d"; then
          log "keep strip-skip reason=${live_reason:-live} $name"
          strip_skipped_live=$((strip_skipped_live + 1))
        else
          strip_generated "$d"
          stripped_only=$((stripped_only + 1))
        fi
      fi

      # Protect doing slugs. Matching is deliberately generous in BOTH
      # directions: worktree names are "<repo>-[kanban-]<card-slug>" but the
      # card slug often carries a suffix the directory does not
      # (observed: dir `state-machine-factory-heal-state-machine` vs card
      # `factory-heal-state-machine-def`). A one-directional substring test
      # missed that and reclaimed an active card's checkout. Try the name with
      # up to three leading "<token>-" segments stripped, and accept
      # containment either way.
      prot=0
      while IFS= read -r s; do
        [ -z "$s" ] && continue
        cand="$name"
        i=0
        while [ "$i" -le 3 ]; do
          # Forward: the directory carries the whole card slug. Slugs are long
          # and specific, so this needs no length guard.
          case "$name" in *"$s"*) prot=1 ;; esac
          # Reverse: the card slug carries the directory's tail (dir
          # `state-machine-factory-heal-state-machine` vs card
          # `factory-heal-state-machine-def`). Stripping segments shortens the
          # candidate, so this MUST have a length floor — without one,
          # `finished-a` strips to `a`, which is a substring of nearly every
          # slug and protects the entire pool.
          if [ "${#cand}" -ge 8 ]; then
            case "$s" in *"$cand"*) prot=1 ;; esac
          fi
          [ "$prot" -eq 1 ] && break
          case "$cand" in
            *-*) cand="${cand#*-}" ;;
            *) break ;;
          esac
          i=$((i + 1))
        done
        [ "$prot" -eq 1 ] && break
      done <"$protect_file"
      case "$name" in
        salvage-*|tombstone-*|locked*) prot=1 ;;
      esac
      # live process / fresh build: never remove the worktree either
      if [ "$force_live" -eq 0 ] && has_live_cwd "$d"; then
        prot=1
      fi
      if [ "$prot" -eq 1 ]; then
        log "keep protected $name"
        continue
      fi
      # age by directory mtime
      mtime="$(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || echo 0)"
      age=$((now_epoch - mtime))

      # Short grace: never race a worktree created moments before this sweep,
      # whose owning process may not have opened it yet.
      if [ "$age" -lt "$min_age_sec" ]; then
        log "keep fresh ${name} age_min=$((age / 60)) grace_min=${min_age_minutes}"
        continue
      fi

      # Finished work is reclaimable NOW. By this point the tree is not
      # protected (no doing-card, not salvage/tombstone/locked) and not live.
      # If it also has nothing uncommitted, waiting for it to reach
      # --max-age-hours does not make deletion safer — it only lets the pool
      # grow. This is what let a generator producing ~10 worktrees/hour
      # outrun an hourly sweep whose population was permanently "young".
      if [ "$board_unavailable" -eq 0 ] && worktree_is_clean "$d"; then
        log "reclaim finished ${name} age_h=$((age / 3600)) clean=1"
        remove_worktree "$d"
        reclaimed=$((reclaimed + 1))
        continue
      fi

      # Dirty tree: keep the conservative age gate. remove_worktree still saves
      # a patch first, but give a human the full window to notice it.
      if [ "$age" -lt "$max_age_sec" ]; then
        log "keep dirty ${name} age_h=$((age / 3600)) (waiting out max_age_hours=${max_age_hours})"
        continue
      fi
      remove_worktree "$d"
      reclaimed=$((reclaimed + 1))
    done
  done
  rm -f "$protect_file" "$live_index"
  live_index=""
fi

log "done reclaimed=$reclaimed stripped_paths=$stripped_only strip_skipped_live=$strip_skipped_live strip_skipped_pressure=$strip_skipped_pressure liveness_unavailable=$liveness_unavailable liveness_soft=$liveness_soft board_read_ok=$board_read_ok free_floor_gib=$free_floor_gib min_age_min=$min_age_minutes dry_run=$dry_run"

# Hard stop only when process inspection failed AND we lack a real board protect
# set. Soft-degrade (board_read_ok) already reclaimed finished non-doing trees
# above and must exit 0 so disk-reclaim can report worktrees_pruned>0.
# A blind no-board no-op must not report success — `ok reclaimed_gb=0` is
# indistinguishable from "nothing to do", which is how this went unnoticed.
if [ "$liveness_unavailable" -eq 1 ] && [ "${liveness_soft:-0}" -eq 0 ]; then
  log "exit=3 liveness_unavailable — grant this run ps/lsof, pass --force-live, or ensure board protect is readable for soft-degrade"
  exit 3
fi
if [ "${liveness_soft:-0}" -eq 1 ]; then
  log "exit=0 liveness_soft=1 reclaimed=$reclaimed"
fi
exit 0
