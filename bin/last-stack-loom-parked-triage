#!/usr/bin/env python3
"""Resume parked Loom land-card walks that do not need a human.

A land-card walk that hits a node error parks at AWAIT_HUMAN and waits for
`loom signal <id> card-decision`. Nothing signals it except a person. On
2026-09-25 five walks sat parked; the kanban-factory-manager classified them
by hand and found only two shapes, and neither needed judgement:

  escalate  REVISE failed ("reviser produced no commit") or review escalated
            at the cap, on a card routed `fast` (Haiku). Three of five parks.
            The signal payload merges into the walk context, so a retry with
            `card_difficulty: normal` reruns REVISE on the matrix `normal`
            row. Done once per walk; a second park stays for a human.
  resume    The PR is already merged (a person or the forge merged it while
            the walk was parked, or CLOSE_CARD failed on an install lag).
            `merge` goes to MERGE, which sees merged and passes, then
            CLOSE_CARD. Rate-limited per walk because CLOSE_CARD can fail
            again until host-track installs the merge.
  unfence   MERGE was refused because a Situation blocked merge-pr on the
            repo (for example a timed pause). The walk stays parked while
            `situations preflight --action merge-pr` still blocks; once it
            passes, `merge` goes back to MERGE. Without this rule the walk
            parked forever after the Situation ended (2026-09-26, fold PR
            2203). Rate-limited like resume; counted under resumed=.
  handoff   The PR is merged, one resume was already signalled, and the walk
            parked again after the retry window. CLOSE_CARD keeps refusing
            (for example "Merge is not done. Add a positive PROOF line"), so
            another `merge` only loops. The card goes to the validate lane
            through last-stack-card-reopen-validate (doing + pr_url + PROOF
            marker, block_status cleared), then the walk gets `drop`. Before
            this rule two merged cards sat in backlog as needs_human for 4-10h
            and the validate routine skipped them by policy (2026-09-26).

  requeue   The walk parked on "node error" before it opened a PR, and the
            error block is empty or says "no evidence recorded". Nothing is
            there for a person to judge and a signal only reruns the dead
            node. The walk is cancelled and the card goes back to todo for a
            fresh walk (block_status cleared, one RESET line). Once per card;
            a second such park stays for a human. Before this rule two cards
            sat in backlog as needs_human for 36h (2026-09-26).

Anything else is left parked and listed as `left`.

Usage:
  last-stack-loom-parked-triage [--apply] [--json] [--gate]
      [--merge-retry-hours 6] [--limit 20]

`--gate` is the routinesd gate_command form: it implies --apply, prints a
`ROUTINE_RESULT outcome=ok|noop` trailer, and exits 0 so no LLM harness
starts. An unreadable `loom list` exits 1 (routinesd records a failed run).

Dry run by default. `--apply` starts each signal detached (the signal drives
the walk in the foreground and can run for an hour), logs it under the state
dir, and marks the card with one PROGRESS line.

The last stdout line carries heartbeat tokens:
  parked_seen= escalated= resumed= handed_off= requeued= left= errors=

Test knobs: LOOM_BIN, KANBAN_BIN, FORGE_API_BIN, SITUATIONS_BIN, REOPEN_BIN,
LAST_STACK_LOOM_TRIAGE_STATE (state dir).
"""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

LOOM = os.environ.get("LOOM_BIN", "loom")
KANBAN = os.environ.get("KANBAN_BIN", "kanban")
FORGE_API = os.environ.get("FORGE_API_BIN", "last-stack-forge-api")
SITUATIONS = os.environ.get("SITUATIONS_BIN", "situations")
REOPEN = os.environ.get(
    "REOPEN_BIN", str(Path(__file__).resolve().parent / "last-stack-card-reopen-validate"))
STATE_DIR = Path(os.environ.get(
    "LAST_STACK_LOOM_TRIAGE_STATE",
    str(Path.home() / ".local/state/last-stack/loom-parked-triage")))

ESCALATE_MARKERS = ("reviser produced no commit", "review escalated at cap")
NO_EVIDENCE_MARKER = "no evidence recorded"
PR_RE = re.compile(r"/([^/]+/[^/]+)/pulls/(\d+)")
# last-stack-forge-api's refusal line when a Situation blocks the merge.
MERGE_FENCED_RE = re.compile(r"REFUSED merge on ([\w.-]+/[\w.-]+): Situations preflight says BLOCKED")


def run(cmd, timeout=90):
    try:
        cp = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)
    return cp.returncode, cp.stdout, cp.stderr


def parked_walks(limit):
    # `loom list` defaults to the 20 newest walks in 36h. Parked walks age
    # out of that view while newer walks run, so the triage saw 3 of 11
    # parked walks on 2026-09-26. Read a week, far past any daily volume.
    rc, out, err = run([LOOM, "list", "land-card", "--window-hours", "168", "--limit", "1000"])
    if rc != 0:
        raise RuntimeError(f"loom list land-card failed: {err.strip()[:200]}")
    rows = []
    for line in out.splitlines():
        cols = line.split("\t")
        if len(cols) >= 4 and cols[2] == "parked" and cols[3] == "AWAIT_HUMAN":
            rows.append(cols[1])
    return rows[:limit]


def parse_show(text):
    """Top-level fields, context.* values, and the error block of `loom show`."""
    view = {"context": {}, "error": "", "failed_nodes": []}
    in_error = False
    for line in text.splitlines():
        if line.startswith("context."):
            in_error = False
            key, _, raw = line[len("context."):].partition(": ")
            try:
                view["context"][key] = json.loads(raw)
            except json.JSONDecodeError:
                view["context"][key] = raw
        elif line.startswith("error: "):
            in_error = True
            view["error"] += line[len("error: "):] + "\n"
        elif line.startswith("node "):
            in_error = False
            m = re.match(r"node (\w+)#\d+ failed", line)
            if m:
                view["failed_nodes"].append(m.group(1))
        elif ": " in line and not line.startswith(" ") and not in_error:
            key, _, val = line.partition(": ")
            view[key] = val
        elif in_error:
            view["error"] += line + "\n"
    return view


def pr_merged(ctx):
    if ctx.get("merged") is True:
        return True
    m = PR_RE.search(str(ctx.get("pr_url") or ""))
    if not m:
        return False
    rc, out, _ = run([FORGE_API, f"repos/{m.group(1)}/pulls/{m.group(2)}", "--jq", ".merged"], 60)
    return rc == 0 and out.strip() == "true"


def merge_fence_clear(repo):
    """True only when preflight positively allows merge-pr on the repo."""
    rc, _, _ = run([SITUATIONS, "preflight", "--action", "merge-pr", "--repo", repo], 60)
    return rc == 0


def load_state():
    try:
        return json.loads((STATE_DIR / "state.json").read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_DIR / f"state.json.tmp.{os.getpid()}"
    tmp.write_text(json.dumps(state, indent=1, sort_keys=True))
    tmp.replace(STATE_DIR / "state.json")


def classify(exec_id, view, state, merge_retry_s, now):
    ctx = view["context"]
    seen = state.get(exec_id, {})
    text = (view["error"] + " " + str(ctx.get("park_reason") or "")).lower()
    if pr_merged(ctx):
        last = seen.get("resume_at", 0)
        if now - last < merge_retry_s:
            return "left", "merged; resume signalled recently", None
        if last:
            return "handoff", "merged; parked again after resume", {"human_decision": "drop"}
        return "resume", "PR merged", {"human_decision": "merge"}
    fenced = MERGE_FENCED_RE.search(view["error"])
    if fenced:
        repo = fenced.group(1)
        if not merge_fence_clear(repo):
            return "left", f"situation still blocks merge-pr on {repo}", None
        if now - seen.get("resume_at", 0) < merge_retry_s:
            return "left", "merge fence cleared; resume signalled recently", None
        return "unfence", f"situation no longer blocks merge-pr on {repo}", {"human_decision": "merge"}
    if any(m in text for m in ESCALATE_MARKERS):
        if ctx.get("card_difficulty", "fast") != "fast" or ctx.get("triage_escalated") or seen.get("escalated_at"):
            return "left", "already escalated; needs a human", None
        return "escalate", "fast reviser stalled", {
            "human_decision": "retry", "card_difficulty": "normal", "triage_escalated": True}
    error = view["error"].strip().lower()
    if (not ctx.get("pr_url") and str(ctx.get("park_reason") or "") == "node error"
            and (not error or NO_EVIDENCE_MARKER in error)):
        if state.get(f"card:{ctx.get('card')}", {}).get("requeued_at"):
            return "left", "no-PR node error again after a requeue; needs a human", None
        return "requeue", "node error before a PR; no evidence to judge", None
    return "left", "no automatic rule", None


def signal(exec_id, payload, card):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(STATE_DIR / f"{exec_id}.log", "a")
    log.write(f"--- {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} signal {json.dumps(payload)}\n")
    log.flush()
    subprocess.Popen([LOOM, "signal", exec_id, "card-decision", "--payload", json.dumps(payload)],
                     stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                     start_new_session=True)
    if card:
        run([KANBAN, "mark", card,
             f"PROGRESS: loom-parked-triage exec={exec_id} signalled {payload['human_decision']}"
             + (f" card_difficulty={payload['card_difficulty']}" if "card_difficulty" in payload else "")], 60)


def handoff(exec_id, view, card):
    """Send a merged card to the validate lane. True when the board took it."""
    if not card:
        return False
    first = next((l.strip() for l in view["error"].splitlines() if l.strip()), "")
    reason = f"loom walk {exec_id} merged but CLOSE_CARD parked again after a resume: {first[:200]}"
    # Reopen first: a card with block_status cleared but still in backlog
    # can be promoted to todo and claimed as WORK with nothing to change.
    rc, _, _ = run([REOPEN, card, "--pr-url", str(view["context"].get("pr_url") or ""),
                    "--reason", reason, "--board-cli", KANBAN], 120)
    if rc != 0:
        return False
    rc, _, _ = run([KANBAN, "set", card, "--block-status", "none"], 60)
    return rc == 0


def requeue(exec_id, card):
    """Cancel a dead walk and put its card back in todo. True on success."""
    if not card:
        return False
    rc, out, _ = run([KANBAN, "show", card, "--json"], 60)
    try:
        column = json.loads(out).get("column") if rc == 0 else None
    except (json.JSONDecodeError, AttributeError):
        column = None
    # A done card means a newer walk already landed it; never pull it back.
    if column not in ("backlog", "todo", "doing"):
        return False
    rc, _, _ = run([LOOM, "cancel", exec_id], 90)
    if rc != 0:
        return False
    run([KANBAN, "mark", card,
         f"RESET loom-parked-triage: walk {exec_id} parked on a node error before any PR "
         "(no evidence recorded). Walk cancelled; card back to todo for a fresh walk."], 60)
    rc, _, _ = run([KANBAN, "set", card, "--block-status", "none", "--block-reason", ""], 60)
    if rc != 0:
        return False
    rc, _, _ = run([KANBAN, "move", card, "todo"], 60)
    return rc == 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--gate", action="store_true")
    ap.add_argument("--merge-retry-hours", type=float, default=6.0)
    ap.add_argument("--limit", type=int, default=20)
    args = ap.parse_args()
    if args.gate:
        args.apply = True

    now = time.time()
    state = load_state()
    rows, counts = [], {"parked_seen": 0, "escalated": 0, "resumed": 0, "handed_off": 0, "requeued": 0, "left": 0, "errors": 0}
    try:
        ids = parked_walks(args.limit)
    except RuntimeError as exc:
        print(f"last-stack-loom-parked-triage: {exc}", file=sys.stderr)
        print("parked_seen=0 escalated=0 resumed=0 handed_off=0 requeued=0 left=0 errors=1")
        return 1
    for exec_id in ids:
        counts["parked_seen"] += 1
        rc, out, err = run([LOOM, "show", exec_id])
        if rc != 0:
            counts["errors"] += 1
            rows.append({"exec": exec_id, "action": "error", "why": err.strip()[:200]})
            continue
        view = parse_show(out)
        action, why, payload = classify(exec_id, view, state, args.merge_retry_hours * 3600, now)
        card = view["context"].get("card")
        rows.append({"exec": exec_id, "card": card, "action": action, "why": why})
        if action == "left":
            counts["left"] += 1
            continue
        if action == "handoff":
            if args.apply and not handoff(exec_id, view, card):
                counts["errors"] += 1
                rows[-1]["why"] += "; reopen-validate failed, walk left parked"
                continue
            counts["handed_off"] += 1
            if args.apply:
                signal(exec_id, payload, card)
                state.setdefault(exec_id, {})["handoff_at"] = now
            continue
        if action == "requeue":
            if args.apply:
                if not requeue(exec_id, card):
                    counts["errors"] += 1
                    rows[-1]["why"] += "; requeue failed, walk left parked"
                    continue
                state.setdefault(f"card:{card}", {})["requeued_at"] = now
            counts["requeued"] += 1
            continue
        counts["escalated" if action == "escalate" else "resumed"] += 1
        if args.apply:
            signal(exec_id, payload, card)
            key = "escalated_at" if action == "escalate" else "resume_at"
            state.setdefault(exec_id, {})[key] = now
    if args.apply:
        save_state(state)
    if args.json:
        print(json.dumps({"apply": args.apply, "walks": rows}, indent=1))
    else:
        for r in rows:
            print(f"{r['action']}\t{r['exec']}\t{r.get('card') or '-'}\t{r['why']}")
    tokens = " ".join(f"{k}={v}" for k, v in counts.items())
    if args.gate:
        acted = counts["escalated"] + counts["resumed"] + counts["handed_off"] + counts["requeued"]
        print(f"ROUTINE_RESULT outcome={'ok' if acted else 'noop'} detail={tokens.replace(' ', ',')}")
    print(tokens)
    return 0


if __name__ == "__main__":
    sys.exit(main())
