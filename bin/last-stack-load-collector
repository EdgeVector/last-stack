#!/usr/bin/env python3
"""last-stack-load-collector — LastDB load sampler that works when LastDB is loaded.

Why (Tom, 2026-09-29): "know exactly how much load is on lastdb and from what",
and it must keep running at load. The old monitors read `lastdb status` with no
deadline, at Nice 10, and raised alerts through LastDB (Situations). Under
saturation they hung or went blind. North Star: north-star-lastdb-load-monitoring.

One pass per call (wrap it in last-stack-launchd-loop). Each pass writes ONE
JSON line to $LOAD_MON_DIR/load-YYYYMMDD.jsonl:

  host   load avg, swap, top processes by CPU (any process, e.g. fseventsd),
         primary lastdbd pid/cpu/rss     -- from ps/sysctl only, never the node
  node   one direct UDS GET /api/status and one `lastdb ops --by-app`, each
         under a hard deadline. A timeout is a VALUE, not an error:
         state = ok | busy | shedding | down | error

Alerts (node not ok for N passes, lastdbd CPU high for N passes) go to
alerts.jsonl and a macOS notification. A Situations notice is best-effort,
detached, and never awaited. No alert path blocks on LastDB.

Usage:
  last-stack-load-collector [sample]        one pass (default)
  last-stack-load-collector report [--minutes N] [--json]

Env (defaults):
  LOAD_MON_DIR            ~/.local/state/last-stack/load-monitor
  LOAD_MON_SOCKET         ~/.lastdb/data/folddb.sock
  LOAD_MON_DEADLINE_SEC   2.0    hard deadline for each node call
  LOAD_MON_RETAIN_DAYS    14
  LOAD_MON_MAX_MB         300
  LOAD_MON_ALERT_NODE_CONSEC   3
  LOAD_MON_ALERT_CPU_PCT       100   lastdbd %CPU (100 = one core)
  LOAD_MON_ALERT_CPU_CONSEC    5
  LOAD_MON_ALERT_FOOTPRINT_MB  13107  lastdbd phys_footprint (guard ceiling 16384)
  LOAD_MON_ALERT_FOOTPRINT_CONSEC 3
  LOAD_MON_ALERT_SYNC_CONSEC   10      passes with sync degraded_reasons set
  LOAD_MON_ALERT_LANES_CONSEC  2       passes with an unhealthy or quarantined persist lane
  LOAD_MON_ALERT_SWAP_MB       20480  host swap used (MB)
  LOAD_MON_ALERT_SWAP_CONSEC   3
  LOAD_MON_ALERT_LOAD1         32     host 1-min load average
  LOAD_MON_ALERT_LOAD_CONSEC   5
  LOAD_MON_ALERT_HOG_PCT       90     one non-lastdbd process, %CPU
  LOAD_MON_ALERT_HOG_CONSEC    15
  LOAD_MON_ALERT_COOLDOWN_SEC  1800
  LOAD_MON_ALERT_FREEZE_WATCH_CONSEC 2   passes with the routines fleet-freeze
                                       watchdog not producing checks
  LOAD_MON_ALERT_DISPATCH_FROZEN_CONSEC 2  passes with routinesd not dispatching
                                       inside the watchdog's bound AND no live
                                       watchdog to report it
  LOAD_MON_ALERT_FRONTIER_CONSEC 2     passes with host-track holding an install
                                       on a registry pin that cannot clear
  LOAD_MON_FRONTIER_DIR                host-track's frontier observation cache
  LOAD_MON_FRONTIER_MAX_OBS_AGE_SEC 3600  an observation older than this is not
                                       evidence about the present
  LOAD_MON_FREEZE_WATCH_LABEL          launchd label to assert (default
                                       com.edgevector.routines-freeze-watch)
  LOAD_MON_FREEZE_WATCH_PLIST          its plist; absent => not installed, no alert
  LOAD_MON_FREEZE_WATCH_LOG            its stdout log, checked for growth
  LOAD_MON_FREEZE_WATCH_INTERVAL_SEC 900  its StartInterval; stale past 2x
  LOAD_MON_LAUNCHCTL           /bin/launchctl
  LOAD_MON_NOTIFY         1      0 = no osascript notification, no Situations
  LOAD_MON_PHONE          =NOTIFY  1 = push to Tom's phone with `ra notify` (Telegram, no LastDB)
  LOAD_MON_RA             ~/.local/bin/ra
  LOAD_MON_SENTRY         =NOTIFY  1 = send each alert to Sentry (lastdb-mini DSN cached in $DIR/.sentry-dsn)
  LOAD_MON_SENTRY_DSN     -      DSN override (skips the cache file and lastsecrets)
  LOAD_MON_CURL           /usr/bin/curl
  LOAD_MON_LASTDB         lastdb  CLI used for `ops --by-app`
"""

import argparse
import datetime as dt
import json
import os
import re
import signal
import socket
import statistics
import subprocess
import sys
import threading
import time
import uuid

HOME = os.path.expanduser("~")
DIR = os.environ.get("LOAD_MON_DIR", os.path.join(HOME, ".local/state/last-stack/load-monitor"))
SOCK = os.environ.get("LOAD_MON_SOCKET", os.path.join(HOME, ".lastdb/data/folddb.sock"))
LASTDB = os.environ.get("LOAD_MON_LASTDB", "lastdb")


def envf(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return float(default)


DEADLINE = envf("LOAD_MON_DEADLINE_SEC", 2.0)
RETAIN_DAYS = envf("LOAD_MON_RETAIN_DAYS", 14)
MAX_MB = envf("LOAD_MON_MAX_MB", 300)
NODE_CONSEC = int(envf("LOAD_MON_ALERT_NODE_CONSEC", 3))
CPU_PCT = envf("LOAD_MON_ALERT_CPU_PCT", 100)
CPU_CONSEC = int(envf("LOAD_MON_ALERT_CPU_CONSEC", 5))
FP_MB = envf("LOAD_MON_ALERT_FOOTPRINT_MB", 13107)  # 80% of the 16 GiB guard
FP_CONSEC = int(envf("LOAD_MON_ALERT_FOOTPRINT_CONSEC", 3))
SYNC_CONSEC = int(envf("LOAD_MON_ALERT_SYNC_CONSEC", 10))
LANES_CONSEC = int(envf("LOAD_MON_ALERT_LANES_CONSEC", 2))
SWAP_MB = envf("LOAD_MON_ALERT_SWAP_MB", 20480)
SWAP_CONSEC = int(envf("LOAD_MON_ALERT_SWAP_CONSEC", 3))
LOAD1 = envf("LOAD_MON_ALERT_LOAD1", 32)
LOAD_CONSEC = int(envf("LOAD_MON_ALERT_LOAD_CONSEC", 5))
HOG_PCT = envf("LOAD_MON_ALERT_HOG_PCT", 90)
HOG_CONSEC = int(envf("LOAD_MON_ALERT_HOG_CONSEC", 15))
COOLDOWN = envf("LOAD_MON_ALERT_COOLDOWN_SEC", 1800)
# lastdbd refuses to load a cold group over its cap (LASTSTORE_COLD_GROUP_TOO_LARGE); warn at 90%
COLD_CAP_BYTES = int(envf("LOAD_MON_COLD_GROUP_CAP_BYTES", 2147483648))
COLD_WARN_PCT = envf("LOAD_MON_ALERT_COLD_GROUP_PCT", 90)
# The routines fleet-freeze watchdog is the only detector that is not dispatched BY
# routinesd, so it is the only one that can report a scheduler freeze. It is also
# labelled com.edgevector.routines-freeze-watch, which puts it inside the family an
# operator sweeps with `launchctl disable` during a maintenance window. On
# 2026-10-02 that happened: the agent was disabled at 00:44:45Z with routinesd,
# routines-hygiene and admin-routines-status, and the fleet then sat at
# active=0/81 for ~1h45m with nothing reporting it. A watchdog cannot report its
# own absence, so the assertion has to come from here: this agent is outside that
# family and stayed enabled through the window.
FW_LABEL = os.environ.get("LOAD_MON_FREEZE_WATCH_LABEL", "com.edgevector.routines-freeze-watch")
FW_PLIST = os.environ.get(
    "LOAD_MON_FREEZE_WATCH_PLIST",
    os.path.join(HOME, "Library/LaunchAgents", FW_LABEL + ".plist"))
FW_LOG = os.environ.get(
    "LOAD_MON_FREEZE_WATCH_LOG", os.path.join(HOME, ".routines/daemon/freeze-watch.out.log"))
FW_INTERVAL = envf("LOAD_MON_FREEZE_WATCH_INTERVAL_SEC", 900)
FW_CONSEC = int(envf("LOAD_MON_ALERT_FREEZE_WATCH_CONSEC", 2))
LAUNCHCTL = os.environ.get("LOAD_MON_LAUNCHCTL", "/bin/launchctl")
# Re-enabling a disabled watchdog is the right repair only when the installed
# watchdog would then be RIGHT. There is a fourth state freeze_watch_down did not
# name: disabled, and the installed build computes a false `dispatch-stale`.
# Measured 2026-10-03T10:23Z, read-only, against the build host-track has
# installed (f8b51b5):
#
#   routines freeze-watch -> FROZEN dispatch-stale dispatch_age=123258s bound=21600s
#   routinesd.err.log     -> "kind":"dispatch" 472s earlier
#
# That build infers scheduler liveness from `harness=` lines in the heartbeat log,
# which writeHeartbeat appends only for routines whose registry entry sets
# heartbeat_slug — 0 of the 3 active routines do. A false `dispatch-stale` and a
# real one share the episode key `frozen:dispatch-stale`, and decideSurfacing
# returns `none` once a key is notified, so enabling the watchdog in this state
# posts ONE wrong notice and then surfaces a genuine dispatch freeze with
# nothing, permanently. This agent had prescribed exactly that, every 30 s, for
# 3595 passes.
# papercut-freeze-watch-dispatch-staleness-reads-an-opt-in-heartbeat-signal-20261002
# EdgeVector/routines PR 11 (merge 82f14a1) takes dispatch liveness from
# routinesd's own records as well, which removes the false positive. The
# discriminator is that fix's own function name, the grep the papercut prescribes.
FW_TWO_SOURCE_MARK = os.environ.get("LOAD_MON_FREEZE_WATCH_FIX_MARK", "newestDaemonDispatchAt")
FW_ROUTINES_BIN = os.environ.get(
    "LOAD_MON_ROUTINES_BIN", os.path.join(HOME, ".host-track/apps/routines/current/dist/routines"))
FW_DAEMON_LOG = os.environ.get(
    "LOAD_MON_ROUTINESD_LOG", os.path.join(HOME, ".routines/daemon/routinesd.err.log"))
FW_HEARTBEAT_LOG = os.environ.get(
    "LOAD_MON_HEARTBEAT_LOG", os.path.join(HOME, ".last-stack/logs/routine-heartbeats.log"))
# The bound the installed watchdog itself uses for condition A. Read from env so a
# watchdog that retunes it does not leave this agent judging against a dead number.
FW_DISPATCH_BOUND = envf("LOAD_MON_FREEZE_WATCH_DISPATCH_BOUND_SEC", 21600)
# Both logs are append-only and large: routinesd.err.log measured 133 MB on
# 2026-10-03. Seek the tail, never read the file — the same mistake tailBytes made
# in the watchdog, where a 15-minute agent pulled 136 MB through memory to look at
# the end of it.
FW_TAIL_BYTES = int(envf("LOAD_MON_FREEZE_WATCH_TAIL_BYTES", 1 << 21))
# The registry delivery frontier. `host-track refresh` decides, every 1200 s,
# whether a pinned app can be installed; when the registry index holds no row
# proved on the build this host runs, it holds the install and prints one line
# to a stderr log nobody reads. Measured 2026-10-03: 124 such lines per held
# app, six apps, while `brain` and `routines` sat undeliverable for 34 h with
# the fix for the fleet-freeze watchdog among the commits it was holding. No
# notice, no situation and no live classifier said so — every consumer of
# `last-stack-why-stopped`, which gained a class for it that morning, is among
# the 78 paused routines. This agent is a LaunchAgent and is running, so it is
# the only live surface left.
#
# The read is one small local JSON file per held app, written by whoever already
# paid for the resolve. No node, no network, no launchctl — same contract as
# freeze_watch_down.
# papercut-host-track-pin-lag-fields-are-rendered-to-nobody-no-classifier-or-notice-reads-them-20261003
FRONTIER_DIR = os.environ.get(
    "LOAD_MON_FRONTIER_DIR", os.path.join(HOME, ".local/state/last-stack/host-track-frontier"))
# An observation older than this is not evidence about the present. 3600 s is
# three ticks of the 1200 s host-track-refresh agent, so one missed tick does
# not silence the alert and a dead writer does not keep it alive.
FRONTIER_MAX_OBS_AGE = envf("LOAD_MON_FRONTIER_MAX_OBS_AGE_SEC", 3600)
FRONTIER_CONSEC = int(envf("LOAD_MON_ALERT_FRONTIER_CONSEC", 2))
# The scheduler freeze ITSELF, as opposed to the absence of the watchdog that
# reports it. `freeze_watch_down` says, in its own alert text, "while it is down,
# a scheduler freeze is reported by nothing" — and `watchdog_latch_hazard`, four
# lines in, already measures the dispatch age from routinesd's own records and
# throws it away in the one branch where the freeze is REAL. So this agent has
# held the number the whole time and reported a different fact.
#
# Nine dispatch gaps over the watchdog's bound are recorded in this host's own
# routinesd.err.log between 2026-07-13 and 2026-10-03: 9.3h, 105.7h, 12.3h,
# 30.9h, 8.9h, 14.3h, 59.8h, 19.0h. Through the 19.0h one (2026-10-02T00:08Z to
# 19:08Z) the watchdog was launchctl-disabled from 00:44:45Z, so the fleet was
# frozen AND unwatched, and the only thing this agent said was "the agent is
# launchctl-disabled, `launchctl enable` then bootstrap it".
DISPATCH_FROZEN_CONSEC = int(envf("LOAD_MON_ALERT_DISPATCH_FROZEN_CONSEC", 2))
# Any routinesd record's timestamp, whatever its kind. Used ONLY to lower-bound
# the dispatch age when the tail window holds no dispatch record at all: if the
# window reaches back to T and contains no dispatch, the newest dispatch is at
# least now-T old. Measured 2026-10-03: the 2 MiB tail covers 51.6 h of this log
# (15496 records, one 19 h freeze inside that span), against a 6 h bound — ample
# normally, and still short of the 105.7 h episode above, which is exactly the
# longest one and the one a freeze detector must not go quiet on.
FW_ANY_TS_RE = re.compile(r'"ts":"(\d{4}-\d{2}-\d{2}T[0-9:.]+Z)"')
NOTIFY = os.environ.get("LOAD_MON_NOTIFY", "1") != "0"
PHONE = os.environ.get("LOAD_MON_PHONE", "1" if NOTIFY else "0") != "0"
RA = os.environ.get("LOAD_MON_RA", os.path.join(HOME, ".local/bin/ra"))
SENTRY = os.environ.get("LOAD_MON_SENTRY", "1" if NOTIFY else "0") != "0"
CURL = os.environ.get("LOAD_MON_CURL", "/usr/bin/curl")
DSN_SLUG = "obs-sentry-dsn-lastdb-mini"
DSN_TTL = 86400

OPS_RE = re.compile(
    r"app=(\S+) verb=(\S+) count=(\d+) avg=(\d+)ms .*?max=(\d+)ms err=(\d+)"
)


def run(argv, timeout):
    """Run argv, return (rc, stdout). Kill the whole group at the deadline.

    A sandbox can deny setsid or exec; that must degrade to "no data", never
    to a missing sample. rc None = deadline, 127 = could not run.
    """
    p = None
    for new_session in (True, False):
        try:
            p = subprocess.Popen(
                argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, text=True, start_new_session=new_session,
            )
            break
        except (OSError, subprocess.SubprocessError):
            p = None
    if p is None:
        return 127, ""
    try:
        out, _ = p.communicate(timeout=timeout)
        return p.returncode, out
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            p.kill()
        p.communicate()
        return None, ""


def helper_read(argv, bound, label, degraded):
    """A bounded host-helper read whose DEGRADED outcome is recorded, not discarded.

    `run()` already distinguishes a deadline (rc None) from "could not run" (127),
    and every caller here used to throw both away — so a `ps` that lost its race
    left `top` empty with nothing anywhere saying why, in the fixture and in
    production alike. An empty `top` then reads as an idle host. The reason goes in
    the sample itself (rotated with it) rather than in collector-errors.log, which
    is never rotated and whose contract is "a section raised an exception".
    """
    rc, out = run(argv, bound)
    if rc is None:
        degraded[label] = "deadline after %gs" % bound
    elif rc == 127:
        degraded[label] = "not runnable"
    elif rc != 0:
        degraded[label] = "rc=%s" % rc
    return out


def host_sample():
    h = {"ncpu": os.cpu_count()}
    degraded = {}
    try:
        h["load"] = [round(x, 2) for x in os.getloadavg()]
    except OSError:
        h["load"] = None
    out = helper_read(["sysctl", "-n", "vm.swapusage"], 3, "sysctl", degraded)
    m = re.search(r"used = ([0-9.]+)M", out or "")
    h["swap_used_mb"] = int(float(m.group(1))) if m else None
    out = helper_read(["ps", "-Ao", "pid=,%cpu=,rss=,comm="], 3, "ps", degraded)
    rows = []
    for line in (out or "").splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        try:
            rows.append((int(parts[0]), float(parts[1]), int(parts[2]) // 1024, parts[3]))
        except ValueError:
            continue
    rows.sort(key=lambda r: r[1], reverse=True)
    h["top"] = [[p, c, r, os.path.basename(n)] for p, c, r, n in rows[:12]]
    h["cold_group"] = cold_group_max()
    h["lastdbd"] = None
    h["lastdbd_other"] = []
    cands = [r for r in rows if os.path.basename(r[3]) == "lastdbd"]
    if cands:
        out = helper_read(["ps", "-o", "pid=,command=", "-p", ",".join(str(r[0]) for r in cands)],
                          3, "ps_cmd", degraded)
        cmd = {}
        for line in (out or "").splitlines():
            a, _, b = line.strip().partition(" ")
            if a.isdigit():
                cmd[int(a)] = b
        for p, c, r, n in cands:
            dd = re.search(r"--data-dir[= ](\S+)", cmd.get(p, ""))
            # the primary owns ~/.lastdb; a dev/test node passes another --data-dir
            if dd and os.path.realpath(os.path.expanduser(dd.group(1))) != os.path.realpath(os.path.join(HOME, ".lastdb")):
                h["lastdbd_other"].append({"pid": p, "cpu": c, "rss_mb": r, "data_dir": dd.group(1)})
            elif h["lastdbd"] is None:
                h["lastdbd"] = {"pid": p, "cpu": c, "rss_mb": r}
    if degraded:
        h["degraded"] = degraded
    return h


def cold_group_max(data_root=None):
    """Largest keep_small group dir in bytes, from stat only (about 20 files). Never raises."""
    root = os.path.join(data_root or os.environ.get("LOAD_MON_DATA_ROOT") or os.path.join(HOME, ".lastdb/data/data"), "keep_small")
    best = None
    try:
        for shard in os.scandir(root):
            g = os.path.join(shard.path, "g")
            if not os.path.isdir(g):
                continue
            for grp in os.scandir(g):
                total = 0
                with os.scandir(grp.path) as it:
                    for i, f in enumerate(it):
                        if i >= 5000:  # bound the walk
                            break
                        total += f.stat().st_size
                if best is None or total > best[1]:
                    best = (grp.name, total)
    except OSError:
        return None
    return {"group": best[0], "bytes": best[1]} if best else None


def status_vitals(buf):
    """Compact node internals from the /api/status body. Never raises."""
    try:
        body = buf.split(b"\r\n\r\n", 1)[-1]
        st = json.loads(body.decode("utf-8", "replace"))
        if isinstance(st.get("status"), dict):
            st = st["status"]
        mb = st.get("memory_budget") or {}
        qos = st.get("qos") or {}
        uds = st.get("uds") or {}
        sy = st.get("sync") or {}
        lanes = (st.get("request_ops") or {}).get("persist_lanes") or []
        res = st.get("resident") or {}
        return {
            # write-path health: a node can answer /api/status "ok" while persist lanes refuse writes
            "pl_unhealthy": sum(int(l.get("unhealthy_lanes") or 0) for l in lanes),
            "pl_quarantined": sum(1 for l in lanes if l.get("quarantined")),
            "pl_breaker": sum(int(l.get("breaker_trips") or 0) for l in lanes),
            "pl_fail": res.get("persist_lane_failures"),
            "dp_failed": res.get("deferred_persist_failed"),
            "fp_mb": int((st.get("phys_footprint_bytes") or 0) / 1048576),
            "cpu": st.get("cpu_percent"),
            "up_s": st.get("uptime_secs"),
            "evict": mb.get("eviction_events"),
            "gov": mb.get("governor_state"),
            "slow_ms": mb.get("slowest_request_ms"),
            "qos_in": qos.get("total_in_use"),
            "sheds": (qos.get("bulk_sheds") or 0) + (qos.get("interactive_sheds") or 0),
            "uds_in": uds.get("in_flight"),
            "uds_rej": uds.get("queue_full_rejects"),
            "sync": sy.get("state"),
            "sync_why": sy.get("degraded_reasons"),
            # mutation_log_lag is nanoseconds; store seconds so the trend reads as an RPO
            "mlog_lag_s": int(sy["mutation_log_lag"] / 1e9) if isinstance(sy.get("mutation_log_lag"), (int, float)) else None,
            "rp_age_s": sy.get("mutation_log_recovery_point_age_secs"),
            # the cause of a sync lag: the cloud error text, its age, and the download backlog
            "sync_err": (sy.get("last_error") or "")[:160] or None,
            "sync_err_at": sy.get("last_error_at"),
            "dl_deferred": (sy.get("last_download") or {}).get("entries_deferred"),
        }
    except Exception as e:  # a parse failure must not cost the sample
        return {"error": type(e).__name__}


def tap_status():
    """Direct UDS GET /api/status under one monotonic deadline."""
    t0 = time.monotonic()
    res = {"state": "down", "reason": "no_socket", "ms": 0, "http": None}
    if not os.path.exists(SOCK):
        return res
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(DEADLINE)
        s.connect(SOCK)
        s.sendall(
            b"GET /api/status HTTP/1.1\r\nHost: localhost\r\n"
            b"X-LastDB-Client: load-collector\r\nConnection: close\r\n\r\n"
        )
        buf = b""
        while len(buf) < 65536:
            left = DEADLINE - (time.monotonic() - t0)
            if left <= 0:
                raise socket.timeout()
            s.settimeout(left)
            chunk = s.recv(8192)
            if not chunk:
                break
            buf += chunk
            if b"\r\n\r\n" in buf and buf.startswith(b"HTTP/1.1 5"):
                break
        m = re.match(rb"HTTP/1\.[01] (\d+)", buf)
        code = int(m.group(1)) if m else None
        res["http"] = code
        if code == 200:
            res.update(state="ok", reason="")
            res["vitals"] = status_vitals(buf)
        elif code == 503:
            body = buf.split(b"\r\n\r\n", 1)[-1][:200].decode("utf-8", "replace")
            em = re.search(r'"error"\s*:\s*"([^"]+)"', body)
            res.update(state="shedding", reason=em.group(1) if em else "503")
        else:
            res.update(state="error", reason="http_%s" % code)
    except socket.timeout:
        res.update(state="busy", reason="deadline")
    except (ConnectionRefusedError, FileNotFoundError):
        res.update(state="down", reason="refused")
    except OSError as e:
        res.update(state="error", reason=type(e).__name__)
    finally:
        s.close()
        res["ms"] = int((time.monotonic() - t0) * 1000)
    return res


def tap_ops():
    t0 = time.monotonic()
    rc, out = run([LASTDB, "ops", "--by-app"], DEADLINE)
    ms = int((time.monotonic() - t0) * 1000)
    if rc is None:
        return {"state": "busy", "ms": ms, "rows": []}
    if rc != 0:
        return {"state": "error", "ms": ms, "rows": []}
    rows = []
    for m in OPS_RE.finditer(out):
        a, v, c, avg, mx, err = m.groups()
        rows.append([a, v, int(c), int(avg), int(mx), int(err)])
    rows.sort(key=lambda r: r[2], reverse=True)
    return {"state": "ok", "ms": ms, "rows": rows[:12]}


def node_sample():
    box = {}
    ths = [
        threading.Thread(target=lambda: box.__setitem__("status", tap_status())),
        threading.Thread(target=lambda: box.__setitem__("ops", tap_ops())),
    ]
    for t in ths:
        t.daemon = True
        t.start()
    for t in ths:
        t.join(DEADLINE + 2)
    st = box.get("status") or {"state": "busy", "reason": "tap_hung", "ms": int(DEADLINE * 1000), "http": None}
    return {"status": st, "ops": box.get("ops") or {"state": "busy", "ms": int(DEADLINE * 1000), "rows": []}}


def load_state():
    try:
        with open(os.path.join(DIR, ".state.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(st):
    tmp = os.path.join(DIR, ".state.json.tmp")
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, os.path.join(DIR, ".state.json"))


def tool_env():
    """Child env with the user tool dirs on PATH. launchd PATH has no ~/.bun/bin, so
    `ra` (exec bun) exited 127 and no phone alert ever left the host (2026-09-30)."""
    extra = os.environ.get("LOAD_MON_EXTRA_PATH", os.path.join(HOME, ".bun/bin") + ":" + os.path.join(HOME, ".local/bin"))
    env = dict(os.environ)
    env["PATH"] = extra + ":" + env.get("PATH", "/usr/bin:/bin")
    return env


def detach(argv, env=None):
    """Start argv and never wait for it. Failure to start is not an error."""
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, env=env)
    except (OSError, subprocess.SubprocessError):
        pass


def detach_logged(channel, alert, argv):
    """Like detach, but append one delivery.jsonl row with the exit code.

    An alert that leaves no outcome cannot be told from an alert that arrived.
    """
    log = os.path.join(DIR, "delivery.jsonl")
    detach(["/bin/sh", "-c",
            'a="$1"; c="$2"; l="$3"; shift 3; s=$(date +%s); "$@" >/dev/null 2>&1; rc=$?; '
            'printf \'{"ts":"%s","alert":"%s","channel":"%s","rc":%d,"secs":%d}\\n\' '
            '"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$a" "$c" "$rc" "$(( $(date +%s) - s ))" >>"$l"',
            "sh", alert, channel, log] + list(argv), env=tool_env())


def sentry_dsn(now):
    """Return the cached DSN. A stale or missing cache starts a detached refresh.

    The main path reads a file only. `lastsecrets` reads LastDB, so it runs
    detached with a deadline and can never delay a sample or an alert.
    """
    dsn = os.environ.get("LOAD_MON_SENTRY_DSN")
    if dsn:
        return dsn
    path = os.path.join(DIR, ".sentry-dsn")
    try:
        with open(path) as f:
            dsn = f.read().strip()
        age = now - os.path.getmtime(path)
    except OSError:
        dsn, age = "", DSN_TTL + 1
    if age > DSN_TTL:
        ls = os.path.join(HOME, ".local/bin/lastsecrets")
        if os.access(ls, os.X_OK):
            tmp = path + ".tmp"
            detach(["/bin/sh", "-c",
                    'umask 077; env -u OBS_SENTRY_DSN /usr/bin/perl -e "alarm 20; exec @ARGV" "$0" get "$1" >"$2" '
                    '&& grep -q "^https://" "$2" && mv "$2" "$3"; rm -f "$2"',
                    ls, DSN_SLUG, tmp, path])
    return dsn if dsn.startswith("http") else ""


def sentry_event(name, msg, now):
    """POST one envelope with curl, detached, 10 s cap. Reads no LastDB state."""
    dsn = sentry_dsn(now)
    m = re.fullmatch(r"(https?)://([^@/]+)@([^/]+)/(\d+)", dsn)
    if not m:
        return
    scheme, key, host, project = m.groups()
    eid = uuid.uuid4().hex
    ev = {"event_id": eid, "timestamp": now, "level": "warning", "platform": "python",
          "logger": "last-stack-load-collector", "message": msg,
          "fingerprint": ["lastdb-load", name], "tags": {"alert": name, "component": "load-collector"},
          "server_name": socket.gethostname()}
    body = "\n".join([json.dumps({"event_id": eid, "dsn": dsn}), json.dumps({"type": "event"}),
                      json.dumps(ev)]) + "\n"
    f = os.path.join(DIR, ".sentry-envelope-%s.json" % eid)
    try:
        with open(f, "w") as fh:
            fh.write(body)
    except OSError:
        return
    detach_logged("sentry", name, ["/bin/sh", "-c", '"$@"; rc=$?; rm -f "$0"; exit $rc', f, CURL, "-sS", "-f", "-o", "/dev/null",
                  "--max-time", "10", "-X", "POST", "--data-binary", "@" + f,
                  "-H", "Content-Type: application/x-sentry-envelope",
                  "-H", "X-Sentry-Auth: Sentry sentry_version=7, sentry_key=%s, sentry_client=load-collector/1" % key,
                  "%s://%s/api/%s/envelope/" % (scheme, host, project)])


def launchctl_text(args):
    """One bounded launchctl read. Returns "" on any failure; never raises."""
    try:
        out = subprocess.run([LAUNCHCTL] + list(args), capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return ""
    return (out.stdout or b"").decode("utf-8", "replace")


def tail_text(path, nbytes=None):
    """The last nbytes of a file, decoded. Seeks; never reads the whole file.

    Returns "" on any failure. A partial first line is expected and harmless:
    every caller matches whole lines or whole JSON records anchored on their own
    delimiters, so a truncated head simply does not match.
    """
    want = FW_TAIL_BYTES if nbytes is None else nbytes
    try:
        with open(path, "rb") as fh:
            size = os.fstat(fh.fileno()).st_size
            if size > want:
                fh.seek(size - want)
            return fh.read(want).decode("utf-8", "replace")
    except OSError:
        return ""


# routinesd writes one JSON record per dispatch, unconditionally, with no registry
# opt-in. `kind` MUST be one of dispatch/complete and never `tick`: through the
# 59h48m freeze the daemon kept ticking `80 routines in_flight=0` and dispatched
# nothing, so a matcher that accepted ticks would read that log as fresh forever
# and mask the exact outage this is about.
FW_DISPATCH_RE = re.compile(r'"ts":"([^"]+)","kind":"(?:dispatch|complete)"')
# The heartbeat log's liveness shape, as the installed watchdog matches it: a
# leading ISO timestamp plus harness=, exit= and dur=. Other producers write
# timestamp-first lines there without those tokens and the watchdog rejects them,
# so this agent must reject them too or it would judge against a signal the
# watchdog cannot see.
FW_HEARTBEAT_RE = re.compile(
    r"^(\d{4}-\d{2}-\d{2}T[0-9:.]+Z)\b.*?\bharness=.*?\bexit=.*?\bdur=", re.M)


def newest_epoch(text, pattern):
    """The newest epoch among a pattern's capture-group-1 timestamps, or None."""
    best = None
    for m in pattern.finditer(text):
        t = epoch_z(m.group(1))
        if t is not None and (best is None or t > best):
            best = t
    return best


def oldest_epoch(text, pattern):
    """The oldest epoch among a pattern's capture-group-1 timestamps, or None.

    How far back the tail window actually reaches. `dispatch_frozen` uses it to
    lower-bound the dispatch age when the window holds no dispatch record, so a
    freeze longer than the window cannot read as "cannot tell".
    """
    best = None
    for m in pattern.finditer(text):
        t = epoch_z(m.group(1))
        if t is not None and (best is None or t < best):
            best = t
    return best


def watchdog_latch_hazard(now):
    """Why enabling the disabled watchdog right now would silence it, or None.

    Returns the reason as one sentence, or None when enabling is the right repair.

    Two conditions, and both are needed:

      A. the installed watchdog is SINGLE-SOURCE — its binary does not carry the
         two-source fix, so its dispatch arm sees only the heartbeat log; and
      B. that one source is BLIND right now — routinesd's own log shows a
         dispatch inside the watchdog's bound while the heartbeat log's newest
         liveness line is outside it.

    B alone is not enough and must not be used alone: the heartbeat log stays
    opt-in after the fix, so B holds indefinitely on this host and a rule keyed on
    it would never stop firing. A alone is not enough either — a single-source
    watchdog on a host whose heartbeat log is fresh computes the right answer.

    Every "cannot tell" answer is None, which keeps the plain enable advice:
    an unreadable binary (no host-track install of routines), an unreadable or
    quiet daemon log (the fleet may really be frozen, and then enabling IS the
    repair). Inverting a correct repair on a guess is worse than not inverting it.

    Order is cheapest-first: two tail seeks before a scan of the 62 MB binary, so
    a host whose heartbeat log is fresh never pays for the scan.
    """
    dispatch = newest_epoch(tail_text(FW_DAEMON_LOG), FW_DISPATCH_RE)
    if dispatch is None or now - dispatch > FW_DISPATCH_BOUND:
        return None
    beat = newest_epoch(tail_text(FW_HEARTBEAT_LOG), FW_HEARTBEAT_RE)
    if beat is not None and now - beat <= FW_DISPATCH_BOUND:
        return None
    if not single_source_watchdog():
        return None
    return ("routinesd dispatched %ds ago (bound %ds) but the heartbeat log the installed "
            "watchdog reads has no liveness line for %s, so enabling it NOW posts one false "
            "frozen:dispatch-stale, latches notifiedEpisode and leaves a real dispatch freeze "
            "surfaced by nothing. Do NOT enable yet: install EdgeVector/routines 82f14a1 "
            "(PR 11) first, confirm with `routines freeze-watch` printing OK, then enable"
            % (int(now - dispatch), int(FW_DISPATCH_BOUND),
               "ever" if beat is None else "%ds" % int(now - beat)))


def single_source_watchdog():
    """True when the installed watchdog's dispatch arm reads only the heartbeat log.

    False when the binary carries the two-source fix AND when it cannot be read —
    an unreadable binary is not evidence of a defect, and this answer only ever
    suppresses advice.
    """
    try:
        with open(FW_ROUTINES_BIN, "rb") as fh:
            mark, keep = FW_TWO_SOURCE_MARK.encode(), b""
            while True:
                chunk = fh.read(1 << 20)
                if not chunk:
                    return True
                if mark in keep + chunk:
                    return False
                keep = chunk[-len(mark):]
    except OSError:
        return False


def freeze_watch_down(now):
    """Why the fleet-freeze watchdog is not producing checks, or None if it is.

    Four distinct causes with four different repairs, so each one is named:
    `launchctl disable` (re-enable), booted out (bootstrap), loaded but not
    writing (read the plist and the err log), and disabled while the installed
    build would compute a FALSE freeze (do not enable — see
    watchdog_latch_hazard). The fourth repair is the opposite of the first, which
    is why naming the cause is not enough: this agent prescribed `launchctl
    enable` for 3595 consecutive passes in a state where acting on it would have
    silenced the only out-of-fleet freeze detector for good.

    Absent plist is NOT a fault — the watchdog is optional and this must not alert
    on a host that never installed it. Reads four files, launchctl and the
    installed watchdog's own bytes; no node, no daemon, no board, matching the
    watchdog's own contract.
    """
    if not os.path.exists(FW_PLIST):
        return None
    uid = os.getuid()
    disabled = launchctl_text(["print-disabled", "gui/%d" % uid])
    if disabled:
        m = re.search(r'"%s"\s*=>\s*(\w+)' % re.escape(FW_LABEL), disabled)
        if m and m.group(1) == "disabled":
            hazard = watchdog_latch_hazard(now)
            if hazard:
                # The imperative leads, because headline() cuts this at 120
                # characters and the notice TITLE is what gets skimmed. Written
                # the natural way round ("the agent is launchctl-disabled ... and
                # must STAY disabled") the title rendered byte-identical to the
                # harmful version and only the body disagreed with it.
                return "DO NOT ENABLE yet (launchctl-disabled): %s" % hazard
            return ("the agent is launchctl-disabled (plist present and valid); "
                    "`launchctl enable gui/%d/%s` then bootstrap it" % (uid, FW_LABEL))
    listing = launchctl_text(["list"])
    if listing and not re.search(r"\s%s$" % re.escape(FW_LABEL), listing, re.M):
        return ("the agent is not loaded (plist present); "
                "`launchctl bootstrap gui/%d %s`" % (uid, FW_PLIST))
    try:
        age = now - os.path.getmtime(FW_LOG)
    except OSError:
        return "the agent is loaded but has never written %s" % FW_LOG
    if age > 2 * FW_INTERVAL:
        return ("the agent is loaded but %s has not grown for %ds (interval %ds); "
                "read freeze-watch.err.log" % (FW_LOG, int(age), int(FW_INTERVAL)))
    return None


def frontier_frozen(now):
    """Apps whose install host-track is holding on a registry pin that cannot clear.

    Returns a message describing the held set, or None.

    The predicate is NOT "the frontier is old". An old frontier is ambiguous:
    after a LastDB version change every pinned app legitimately holds until the
    daily prover writes a row for the new build, which can be most of a day, and
    alerting through that window every 30 minutes is noise an operator learns to
    ignore. The discriminator is that the prover produced a row for a DIFFERENT
    build AFTER it last served this host:

        index_build_match == "mismatch"  and  index_newest_proved_at > ORIGIN

    A benign post-upgrade wait ends when a row for the running build appears, so
    it reads `match` and never fires. A prover that is briskly filling the index
    for a build this host does not run will never serve this host, no matter how
    long anyone waits — that needs an operator, and it is true the moment the
    newest row passes ORIGIN. So this rule needs no age threshold and
    cannot disagree with `last-stack-why-stopped` Class H, which fires on age
    because it had no second side to compare against.

    ORIGIN IS THE REGISTRY FRONTIER FOR THE RUNNING BUILD, NOT first_observed_at.
    `running_build_proved_at` is the newest row the index ever proved ON the build
    this host runs, so it marks when the prover last served this host. That is a
    fact about the registry and holds however young this detector is.

    `first_observed_at` marks when host-track first WROTE the observation file,
    which is when this cache was installed. Using it as ORIGIN silences the rule
    on every hold older than the detector, and that is not a corner case: it is
    how this rule met its first real freeze. Measured 2026-10-03T18:1xZ:

        routines  first_observed_at 08:53:35Z   newest row proved 06:49:16Z
        brain     first_observed_at 09:17:12Z   newest row proved 06:49:16Z

    The freeze began 2026-10-01T22:10Z and the cache was installed 34 h into it,
    so `proved <= first` skipped BOTH held apps, `held` came back empty, and this
    rule reported nothing for the whole 9 h it had been installed, during the
    exact freeze it was written for, with the merged fix for the fleet's only
    freeze watchdog among the held commits. Three resolver passes read that
    silence as correct.

    The failure is one-directional and self-renewing: it can only stay quiet when
    it should speak, and `first_observed_at` resets whenever the observation file
    is removed, so any state prune re-silences a live freeze.
    papercut-frontier-frozen-compares-the-newest-row-against-the-detectors-own-install-date-20261003

    The fallback to `first_observed_at` is kept for an observation written by a
    host-track that predates `running_build_proved_at`, and for a running build
    the index has never proved at all: there no frontier exists, and the
    observation is the only origin there is.

    An ABSENT directory is not a fault: nothing is held, or no host-track that
    writes observations is installed yet. A STALE observation is not evidence
    either way and is skipped — but it is skipped per app, so one wedged file
    cannot silence a held sibling.
    """
    try:
        names = sorted(f for f in os.listdir(FRONTIER_DIR) if f.endswith(".json"))
    except OSError:
        return None
    held, newest_ver, newest_at, newest_oid, running, oldest = [], None, None, None, None, None
    obs_age = None
    # Which origin each app's newest row was actually compared against, so the
    # message can name the input its verdict depended on and not only the
    # verdict. Two apps can take different arms during a rollout, while one
    # observation file still predates `running_build_proved_at`.
    run_proved_at, basis = None, set()
    for name in names:
        try:
            with open(os.path.join(FRONTIER_DIR, name)) as fh:
                o = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(o, dict) or o.get("index_build_match") != "mismatch":
            continue
        observed, first = epoch_z(o.get("observed_at")), epoch_z(o.get("first_observed_at"))
        proved = epoch_z(o.get("index_newest_proved_at"))
        if observed is None or first is None or proved is None:
            continue
        if now - observed > FRONTIER_MAX_OBS_AGE:
            continue
        # Prefer the registry fact. `first_observed_at` is a valid origin only
        # while this detector is older than the hold, and it was not.
        run_proved = epoch_z(o.get("running_build_proved_at"))
        if run_proved is None:
            origin, kind = first, "observation"
        else:
            origin, kind = run_proved, "frontier"
        if proved <= origin:
            continue
        basis.add(kind)
        if run_proved is not None:
            run_proved_at = o.get("running_build_proved_at")
        held.append(o.get("app") or name[:-5])
        newest_ver = o.get("index_newest_version") or newest_ver
        newest_at = o.get("index_newest_proved_at") or newest_at
        newest_oid = o.get("index_newest_oid") or newest_oid
        running = o.get("running_lastdb_version") or running
        oldest = first if oldest is None else min(oldest, first)
        obs_age = now - observed if obs_age is None else min(obs_age, now - observed)
    if not held:
        return None
    # Two passes that disagree are indistinguishable unless the row prints the
    # input it compared against.
    if "frontier" in basis and run_proved_at:
        why = ("that row postdates the index's own frontier for the running build (%s), so the "
               "prover has moved past this host" % run_proved_at)
    else:
        why = ("that row landed after host-track first recorded the hold, so the prover is "
               "working past this host")
    return ("host-track is holding installs for %s: the next-channel registry index has no row "
            "proved on the build this host runs (%s), while its newest row is %s proved %s and "
            "names %s -- the exact commit these apps are held behind. A prover filling the index "
            "for another build will never serve this host: prove the running build, or finish the "
            "move. %s. Held since %s (first recorded); observed by host-track %ds ago"
            % (",".join(sorted(held)), running or "unknown", newest_ver or "unknown",
               newest_at or "unknown", (newest_oid or "unknown")[:12], why, iso(oldest),
               int(obs_age)))


def dispatch_frozen(now, watchdog_down):
    """The routine fleet has stopped dispatching and no live watchdog says so.

    Returns the message, or None. `watchdog_down` is `freeze_watch_down`'s answer
    for this pass, reused rather than recomputed so the two rules cannot disagree
    and so the pass still pays for only one launchctl read.

    WHY THIS LIVES HERE. The fleet-freeze watchdog is the detector for this
    condition, and it cannot report its own absence — which is the whole reason
    `freeze_watch_down` exists. But `freeze_watch_down` reports the ABSENCE and
    not the CONDITION, and its own alert text says so out loud: "while it is
    down, a scheduler freeze is reported by nothing". That sentence has been
    true and shipped. Meanwhile `watchdog_latch_hazard` reads routinesd's own
    dispatch records on every pass and, in the one branch where the freeze is
    real, returns None — correctly for its own question, and discarding the
    measurement. So the number has been in hand the whole time and the fact was
    never published.

    THE GATE IS "NOBODY LIVE IS WATCHING", and it is taken from the sibling
    rather than re-derived:

      * plist absent  -> the watchdog was never installed, so nothing reports a
        freeze; this rule is the only surface. `freeze_watch_down` returns None
        here because an uninstalled optional agent is not a fault — that is a
        statement about the WATCHDOG, not about the fleet.
      * `watchdog_down` set -> disabled, booted out or silent; nothing reports.
      * plist present and `watchdog_down` None -> the watchdog is live and
        producing checks. It owns this verdict and this rule stays quiet, so an
        operator never gets two notices for one freeze.

    AGE, AND WHY AN ABSENT RECORD IS NOT "CANNOT TELL". The tail window is
    bounded (2 MiB) because routinesd.err.log measured 133 MB. When the window
    holds a dispatch record the age is exact. When it holds none, the window
    still proves something: it reaches back to its own oldest record, and it
    contains no dispatch, so the newest dispatch is AT LEAST that old. That
    lower bound fires when it already exceeds the bound and otherwise answers
    None. Without this arm the rule would go quiet on precisely the longest
    episodes: the window covers 51.6 h of this log and the worst recorded gap is
    105.7 h, so the 2026-07-25 freeze would have read as "cannot tell" from hour
    52 onward — a freeze detector that gives up as the freeze gets worse.

    `kind` must be dispatch/complete and never `tick`: through the 59h48m freeze
    the daemon kept ticking `80 routines in_flight=0` and dispatched nothing, so
    a matcher that accepted ticks would read the log as fresh forever. The tick
    lines are still useful here, but only through FW_ANY_TS_RE as window reach.

    The one genuine "cannot tell" is a tail with no parseable record at all — an
    absent, empty or rotated log. That answers None, and it is the only silence
    this rule can produce while the fleet is unwatched.
    """
    if os.path.exists(FW_PLIST) and not watchdog_down:
        return None
    text = tail_text(FW_DAEMON_LOG, FW_TAIL_BYTES)
    dispatch = newest_epoch(text, FW_DISPATCH_RE)
    if dispatch is not None:
        age, exact, newest = now - dispatch, True, iso(dispatch)
    else:
        reach = oldest_epoch(text, FW_ANY_TS_RE)
        if reach is None:
            return None
        age, exact, newest = now - reach, False, "none in the window since %s" % iso(reach)
    if age <= FW_DISPATCH_BOUND:
        return None
    watcher = watchdog_down or ("the watchdog is not installed on this host (no %s)" % FW_PLIST)
    return ("the routine fleet has not dispatched for %ds (bound %ds, newest dispatch %s)%s and "
            "no fleet-freeze watchdog is live to report it: %s. Read `routines freeze-watch` for "
            "the full verdict, then bootstrap routinesd or restore the watchdog"
            % (int(age), int(FW_DISPATCH_BOUND), newest,
               "" if exact else " -- a LOWER BOUND: the tail window holds no dispatch record",
               watcher))


# Every notice this agent posts used to go out as `--kind other --system lastdbd`
# with no severity hint, because fire() hard-coded one label for all of them. Four
# of the eleven rules are not about lastdbd at all: fleet_freeze_watchdog_down is
# about the routines scheduler, and the three host_* rules are about the host. On
# 2026-10-02 the only alert on the timeline about a silenced routines watchdog read
# `INFO other systems=lastdbd` three times, so an operator filtering the notices
# timeline by system could not find it under routines. The rule name already knows
# the subject; this table is where it stops being thrown away at the render site.
#
# severity_hint is `warn` only where the system is REFUSING work or has become
# UNREPORTABLE — a state an operator must act on, not a threshold crossing. Every
# pressure rule (swap, load, hog, footprint, cpu, cold-group) stays `info`,
# because those fire on a bound being crossed and recover on their own. Disagree
# with that criterion rather than with any single row.
ALERT_SCOPE = {
    "fleet_dispatch_frozen":           (("routinesd",), "other",   "warn"),
    "fleet_freeze_watchdog_down":      (("routinesd",), "other",   "warn"),
    "registry_delivery_frozen":        (("host-track",), "other",  "warn"),
    "lastdb_persist_lanes_unhealthy":  (("lastdbd",),   "other",   "warn"),
    "node_unresponsive":               (("lastdbd",),   "other",   "warn"),
    "lastdbd_restarted":               (("lastdbd",),   "restart", "info"),
    "lastdb_sync_degraded":            (("lastdbd",),   "other",   "info"),
    "lastdb_cold_group_near_cap":      (("lastdbd",),   "other",   "info"),
    "lastdbd_footprint_high":          (("lastdbd",),   "other",   "info"),
    "lastdbd_cpu_high":                (("lastdbd",),   "other",   "info"),
    "host_swap_high":                  (("host",),      "other",   "info"),
    "host_load_high":                  (("host",),      "other",   "info"),
    "host_process_hog":                (("host",),      "other",   "info"),
}
# An unknown name keeps the pre-table behaviour instead of raising: an alert path
# must never cost the sample. tests/last-stack-load-collector-notice-scope.py is
# what refuses a rule that ships without a row here.
ALERT_SCOPE_DEFAULT = (("lastdbd",), "other", "info")


def alert_scope(name):
    return ALERT_SCOPE.get(name, ALERT_SCOPE_DEFAULT)


def headline(msg, limit=120):
    """A one-line title cut on a word boundary, never mid-word.

    `--title msg[:120]` rendered the live notices as "...plist present and va",
    which reads as a corrupted message rather than an elided one.
    """
    msg = " ".join(msg.split())
    if len(msg) <= limit:
        return msg
    cut = msg[:limit - 1]
    sp = cut.rfind(" ")
    return (cut[:sp] if sp > limit // 2 else cut).rstrip(" ,;:(") + "\u2026"


def notice_argv(sit, name, msg):
    """The `situations notice` argv for one alert. Pure, so the labels are testable."""
    systems, kind, sev = alert_scope(name)
    argv = [sit, "notice", "--title", headline(msg), "--kind", kind]
    for s in systems:
        argv += ["--system", s]
    return argv + ["--severity-hint", sev,
                   "--actor", "last-stack-load-collector", "--summary", msg]


def fire(name, msg, now):
    rec = {"ts": iso(now), "alert": name, "message": msg}
    with open(os.path.join(DIR, "alerts.jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")
    if PHONE and os.access(RA, os.X_OK):  # Telegram push; reads no LastDB state
        detach_logged("phone", name, ["/usr/bin/perl", "-e", "alarm 15; exec @ARGV", RA, "notify",
                                      "LastDB load: " + msg, "--priority", "high"])
    if SENTRY:
        try:
            sentry_event(name, msg, now)
        except Exception:  # an alert path must never cost the sample
            pass
    if not NOTIFY:
        return
    script = 'display notification %s with title "LastDB load" sound name "Basso"' % json.dumps(msg)
    detach(["osascript", "-e", script])
    sit = os.path.join(HOME, ".local/bin/situations")
    if os.access(sit, os.X_OK):  # best effort: goes through LastDB, never awaited
        detach(["/usr/bin/perl", "-e", "alarm 5; exec @ARGV"] + notice_argv(sit, name, msg))


def sync_cause(v, now):
    """Alert suffix naming why sync lags: cloud error (if recent), recovery-point age, backlog."""
    parts = []
    err_at = v.get("sync_err_at")
    if v.get("sync_err") and isinstance(err_at, (int, float)) and now - err_at < 900:
        parts.append("last error %ds ago: %s" % (now - err_at, v["sync_err"]))
    if v.get("rp_age_s") is not None:
        parts.append("recovery point %ss old" % v["rp_age_s"])
    if v.get("dl_deferred"):
        parts.append("%s download entries deferred" % v["dl_deferred"])
    return " (%s)" % "; ".join(parts) if parts else ""


def evaluate_alerts(rec, now):
    st = load_state()
    st["node_bad"] = st.get("node_bad", 0) + 1 if rec["node"]["status"]["state"] != "ok" else 0
    lastdbd = rec["host"].get("lastdbd")
    hot = bool(lastdbd) and lastdbd["cpu"] >= CPU_PCT
    st["cpu_hot"] = st.get("cpu_hot", 0) + 1 if hot else 0
    v = rec["node"]["status"].get("vitals") or {}
    st["fp_hot"] = st.get("fp_hot", 0) + 1 if (v.get("fp_mb") or 0) >= FP_MB else 0
    st["sync_bad"] = st.get("sync_bad", 0) + 1 if v.get("sync_why") else 0
    lanes_bad = bool(v.get("pl_unhealthy") or v.get("pl_quarantined"))
    st["lanes_bad"] = st.get("lanes_bad", 0) + 1 if lanes_bad else 0
    swap = rec["host"].get("swap_used_mb")
    st["swap_hot"] = st.get("swap_hot", 0) + 1 if swap is not None and swap >= SWAP_MB else 0
    load = rec["host"].get("load") or [0]
    st["load_hot"] = st.get("load_hot", 0) + 1 if load[0] >= LOAD1 else 0
    prim = (lastdbd or {}).get("pid")
    restart_msg = None
    if prim:
        old = st.get("lastdbd_pid")
        if old and old != prim:
            restart_msg = "lastdbd restarted: pid %s -> %s (node up %s)" % (
                old, prim, "%ss" % v["up_s"] if v.get("up_s") is not None else "unknown")
        st["lastdbd_pid"] = prim
    cold = rec["host"].get("cold_group")
    cold_hot = bool(cold) and cold["bytes"] >= COLD_CAP_BYTES * COLD_WARN_PCT / 100
    st["cold_hot"] = st.get("cold_hot", 0) + 1 if cold_hot else 0
    hog = next(((t[3], t[1]) for t in rec["host"].get("top") or [] if t[0] != prim), None)
    hog_name = hog[0] if hog and hog[1] >= HOG_PCT else None
    st["hog_hot"] = st.get("hog_hot", 0) + 1 if hog_name and hog_name == st.get("hog_name") else (1 if hog_name else 0)
    st["hog_name"] = hog_name
    fw_why = guarded(lambda: freeze_watch_down(now), None)
    st["fw_down"] = st.get("fw_down", 0) + 1 if fw_why else 0
    dispatch_why = guarded(lambda: dispatch_frozen(now, fw_why), None)
    st["dispatch_frozen"] = st.get("dispatch_frozen", 0) + 1 if dispatch_why else 0
    frozen_why = guarded(lambda: frontier_frozen(now), None)
    st["frontier_frozen"] = st.get("frontier_frozen", 0) + 1 if frozen_why else 0
    last = st.setdefault("last_alert", {})
    checks = [
        # Before the watchdog's absence, because the freeze is the thing an
        # operator acts on and the absence is why they had not heard about it.
        ("fleet_dispatch_frozen", st["dispatch_frozen"] >= DISPATCH_FROZEN_CONSEC,
         "the routine fleet is FROZEN for %d passes: %s" % (st["dispatch_frozen"], dispatch_why)),
        ("fleet_freeze_watchdog_down", st["fw_down"] >= FW_CONSEC,
         "the routines fleet-freeze watchdog is not running for %d passes: %s "
         "(while it is down, a scheduler freeze is reported by nothing)"
         % (st["fw_down"], fw_why)),
        ("registry_delivery_frozen", st["frontier_frozen"] >= FRONTIER_CONSEC,
         "registry delivery frozen for %d passes: %s"
         % (st["frontier_frozen"], frozen_why)),
        ("lastdb_cold_group_near_cap", st["cold_hot"] >= 2,
         "keep_small group %s is %s MB of the %d MB cold-load cap (>= %d%%): the node refuses to load it over the cap"
         % (cold and cold["group"], cold and cold["bytes"] // 1048576, COLD_CAP_BYTES // 1048576, COLD_WARN_PCT)),
        ("host_swap_high", st["swap_hot"] >= SWAP_CONSEC,
         "host swap %s MB >= %d MB for %d passes" % (swap, SWAP_MB, st["swap_hot"])),
        ("host_load_high", st["load_hot"] >= LOAD_CONSEC,
         "host load1 %.1f >= %g for %d passes (top: %s)"
         % (load[0], LOAD1, st["load_hot"], hog[0] if hog else "-")),
        ("host_process_hog", st["hog_hot"] >= HOG_CONSEC,
         "%s at >= %d%% CPU for %d passes" % (hog_name, HOG_PCT, st["hog_hot"])),
        ("lastdbd_footprint_high", st["fp_hot"] >= FP_CONSEC,
         "lastdbd footprint %s MB >= %d MB for %d passes (gov=%s)" % (v.get("fp_mb"), FP_MB, st["fp_hot"], v.get("gov"))),
        ("lastdb_persist_lanes_unhealthy", st["lanes_bad"] >= LANES_CONSEC,
         "LastDB persist lanes refuse writes for %d passes: unhealthy=%s quarantined=%s breaker_trips=%s failures=%s "
         "(status can still read ok; this is the write path)"
         % (st["lanes_bad"], v.get("pl_unhealthy"), v.get("pl_quarantined"), v.get("pl_breaker"), v.get("pl_fail"))),
        ("lastdb_sync_degraded", st["sync_bad"] >= SYNC_CONSEC,
         "LastDB sync degraded for %d passes: %s%s" % (st["sync_bad"], v.get("sync_why"), sync_cause(v, now))),
        ("node_unresponsive", st["node_bad"] >= NODE_CONSEC,
         "LastDB node %s (%s) for %d passes"
         % (rec["node"]["status"]["state"], rec["node"]["status"].get("reason", ""), st["node_bad"])),
        ("lastdbd_cpu_high", st["cpu_hot"] >= CPU_CONSEC,
         "lastdbd CPU >= %d%% for %d passes" % (CPU_PCT, st["cpu_hot"])),
    ]
    if restart_msg:
        last["lastdbd_restarted"] = now
        fire("lastdbd_restarted", restart_msg, now)
    for name, cond, msg in checks:
        if cond and now - last.get(name, 0) >= COOLDOWN:
            last[name] = now
            fire(name, msg, now)
    save_state(st)


def iso(t):
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def epoch_z(ts):
    """Epoch seconds from an ISO-8601 Z timestamp, or None. Never raises.

    Fractional seconds are accepted. They are ISO-8601 and the docstring always
    claimed the whole format, but the only pattern was "%Y-%m-%dT%H:%M:%SZ", so
    every millisecond timestamp parsed as None. Both of this host's scheduler
    logs write them — routinesd's records and the heartbeat log's liveness lines
    are all `...:16.498Z` — and a None reads to every caller as "cannot tell",
    which is silence, not an error. Found 2026-10-03 while adding
    watchdog_latch_hazard, whose two sources were therefore both unreadable.
    Widening can only turn a None into a number, so no caller that already worked
    changes; what it can do is arm a rule that was quietly dead.
    """
    if not isinstance(ts, str) or not ts:
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S.%fZ"):
        try:
            return dt.datetime.strptime(ts, fmt).replace(
                tzinfo=dt.timezone.utc).timestamp()
        except ValueError:
            continue
    return None


def rotate(now):
    cutoff = now - RETAIN_DAYS * 86400
    files = sorted(f for f in os.listdir(DIR) if re.fullmatch(r"(load|writes)-\d{8}\.jsonl", f))
    for f in list(files):
        p = os.path.join(DIR, f)
        if os.path.getmtime(p) < cutoff:
            os.unlink(p)
            files.remove(f)
    total = sum(os.path.getsize(os.path.join(DIR, f)) for f in files)
    while files and total > MAX_MB * 1048576:
        f = files.pop(0)
        total -= os.path.getsize(os.path.join(DIR, f))
        os.unlink(os.path.join(DIR, f))


def guarded(fn, fallback):
    """A failing section becomes an "error" field; the sample is still written.

    The fallback is returned UNCHANGED when it is not a dict. It used to be
    `dict(fallback)` unconditionally, and two call sites pass a non-dict —
    `guarded(lambda: freeze_watch_down(now), None)` passes None — so a raise
    inside those sections made `dict(None)` raise TypeError out of the except
    block, killing `evaluate_alerts` and silently dropping EVERY alert for that
    pass. Probed against the installed binary 2026-10-03: `guarded(boom, None)`
    raised `TypeError: 'NoneType' object is not iterable`, where
    `guarded(boom, {})` returned `{'error': ...}` as documented. A guard that
    raises is worse than no guard, because the call site reads as protected.

    There were also two definitions of this function, identical in purpose; the
    second shadowed the first, whose richer error log was dead code. Merged.
    """
    try:
        return fn()
    except Exception as e:
        log_error(e)
        if not isinstance(fallback, dict):
            return fallback
        out = dict(fallback)
        out["error"] = "%s: %s" % (type(e).__name__, e)
        return out


def log_error(e):
    sys.stderr.write("last-stack-load-collector: %s: %s\n" % (type(e).__name__, e))
    try:
        os.makedirs(DIR, exist_ok=True)
        with open(os.path.join(DIR, "collector-errors.log"), "a") as f:
            f.write("%s %s: %s\n" % (iso(time.time()), type(e).__name__, e))
    except OSError:
        pass


WRITE_ROOTS = [r for r in os.environ.get("LOAD_MON_WRITE_ROOTS", ":".join(
    os.path.join(HOME, x) for x in (".lastdb", ".fkanban/worktrees", ".local/state/last-stack",
                                    ".routines", ".cache/edgevector-git"))).split(":") if r]
WRITE_BUDGET = envf("LOAD_MON_WRITE_BUDGET_SEC", 60)  # whole detached scan, all roots
WRITE_DEPTH = int(envf("LOAD_MON_WRITE_DEPTH", 7))
WRITE_TOP = 3


def write_sample(now):
    """Files written per second under each hot root since the previous pass.

    The answer to "who is feeding fseventsd" without root: every file write is
    a filesystem event, so a root with a high rate is a candidate source.
    `find -newer <marker>` gives an exact interval (no double count between
    passes); the marker is replaced after the scan. Depth and time are bounded.
    """
    marker = os.path.join(DIR, ".write-marker")
    nxt = marker + ".next"
    with open(nxt, "w"):
        pass
    prev = os.path.getmtime(marker) if os.path.exists(marker) else None
    out = {"interval_s": None if prev is None else round(now - prev, 1), "roots": {}}
    deadline = time.monotonic() + WRITE_BUDGET
    if prev is not None:
        for root in WRITE_ROOTS:
            left = deadline - time.monotonic()
            if left <= 0 or not os.path.isdir(root):
                out["roots"][root] = {"state": "skipped"}
                continue
            rc, txt = run(["find", root, "-maxdepth", str(WRITE_DEPTH), "-type", "f",
                           "-newer", marker], min(left, 25))
            if rc != 0 and not txt:
                out["roots"][root] = {"state": "timeout" if rc is None else "error"}
                continue
            subs = {}
            n = 0
            for line in txt.splitlines():
                n += 1
                parts = line[len(root):].strip("/").split("/")
                k = "/".join(parts[:3]) if len(parts) > 3 else "/".join(parts[:-1]) or "."
                subs[k] = subs.get(k, 0) + 1
            out["roots"][root] = {"n": n, "top": sorted(subs.items(), key=lambda x: -x[1])[:WRITE_TOP],
                                  **({"partial": True} if rc is None else {})}
    os.replace(nxt, marker)
    return out


WRITE_EVERY = envf("LOAD_MON_WRITE_EVERY_SEC", 300)


def writes_pass():
    """One scan, appended to writes-YYYYMMDD.jsonl. Run detached by sample()."""
    os.makedirs(DIR, exist_ok=True)
    now = time.time()
    out = guarded(lambda: write_sample(now), {"roots": {}})
    out["ts"] = iso(now)
    day = dt.datetime.fromtimestamp(now, dt.timezone.utc).strftime("%Y%m%d")
    with open(os.path.join(DIR, "writes-%s.jsonl" % day), "a") as f:
        f.write(json.dumps(out, separators=(",", ":")) + "\n")


def maybe_start_writes(now):
    """Start a detached scan when the last one is old enough and none is running.

    The scan walks the hot roots. Under swap pressure it can take many seconds,
    so it must never sit on the sampling path (a monitor must cost less than
    what it watches). The lock is a file whose mtime expires after 3 budgets.
    """
    lock = os.path.join(DIR, ".write-scan.lock")
    marker = os.path.join(DIR, ".write-marker")
    if os.path.exists(lock) and now - os.path.getmtime(lock) < WRITE_BUDGET * 3:
        return
    if os.path.exists(marker) and now - os.path.getmtime(marker) < WRITE_EVERY:
        return
    with open(lock, "w"):
        pass
    detach(["/bin/sh", "-c", 'python3 "$0" writes; rm -f "$1"', os.path.abspath(__file__), lock])


def sample():
    os.makedirs(DIR, exist_ok=True)
    t0 = time.monotonic()
    now = time.time()
    rec = {"ts": iso(now), "host": guarded(host_sample, {"top": [], "lastdbd": None}),
           "node": guarded(node_sample, {"status": {"state": "error", "reason": "collector", "ms": 0, "http": None},
                                         "ops": {"state": "error", "ms": 0, "rows": []}})}
    rec["collector_ms"] = int((time.monotonic() - t0) * 1000)
    day = dt.datetime.fromtimestamp(now, dt.timezone.utc).strftime("%Y%m%d")
    with open(os.path.join(DIR, "load-%s.jsonl" % day), "a") as f:
        f.write(json.dumps(rec, separators=(",", ":")) + "\n")
    evaluate_alerts(rec, now)
    if os.environ.get("LOAD_MON_WRITES", "1") != "0":
        guarded(lambda: maybe_start_writes(now), {})
    rotate(now)


def read_window(minutes):
    cutoff = time.time() - minutes * 60
    recs = []
    for f in sorted(x for x in os.listdir(DIR) if re.fullmatch(r"load-\d{8}\.jsonl", x)) if os.path.isdir(DIR) else []:
        try:
            with open(os.path.join(DIR, f)) as fh:
                for line in fh:
                    try:
                        r = json.loads(line)
                    except ValueError:
                        continue
                    t = dt.datetime.strptime(r["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc).timestamp()
                    if t >= cutoff:
                        recs.append(r)
        except OSError:
            continue
    return recs


def read_delivery(minutes):
    """Count alert delivery outcomes per channel in the window (rc 0 = delivered)."""
    cutoff = time.time() - minutes * 60
    res = {}
    try:
        with open(os.path.join(DIR, "delivery.jsonl")) as fh:
            for line in fh:
                try:
                    r = json.loads(line)
                    t = dt.datetime.strptime(r["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc).timestamp()
                except (ValueError, KeyError):
                    continue
                if t >= cutoff:
                    c = res.setdefault(r["channel"], {"ok": 0, "failed": 0, "last_rc": None})
                    c["ok" if r["rc"] == 0 else "failed"] += 1
                    c["last_rc"] = r["rc"]
    except OSError:
        pass
    return res


def read_writes(minutes):
    cutoff = time.time() - minutes * 60
    recs = []
    for f in sorted(x for x in os.listdir(DIR) if re.fullmatch(r"writes-\d{8}\.jsonl", x)) if os.path.isdir(DIR) else []:
        try:
            with open(os.path.join(DIR, f)) as fh:
                for line in fh:
                    try:
                        r = json.loads(line)
                        t = dt.datetime.strptime(r["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc).timestamp()
                    except (ValueError, KeyError):
                        continue
                    if t >= cutoff:
                        recs.append(r)
        except OSError:
            continue
    return recs


def write_report(recs):
    """Files/s per root over the window, with the busiest subdirectories."""
    secs = 0.0
    tot = {}
    for r in recs:
        w = r
        roots = w.get("roots") or {}
        if not w.get("interval_s") or not any("n" in v for v in roots.values()):
            continue
        secs += w["interval_s"]
        for root, v in roots.items():
            if "n" not in v:
                continue
            t = tot.setdefault(root, {"n": 0, "subs": {}})
            t["n"] += v["n"]
            for k, c in v.get("top", []):
                t["subs"][k] = t["subs"].get(k, 0) + c
    if not secs:
        return None
    rows = [[root, round(t["n"] / secs, 2), sorted(t["subs"].items(), key=lambda x: -x[1])[:WRITE_TOP]]
            for root, t in tot.items()]
    rows.sort(key=lambda x: -x[1])
    return {"seconds": int(secs), "roots": rows}


def report(minutes, as_json):
    recs = read_window(minutes)
    out = {"minutes": minutes, "samples": len(recs)}
    states = {}
    ms = []
    cpu_by_proc = {}
    for r in recs:
        s = r["node"]["status"]
        states[s["state"]] = states.get(s["state"], 0) + 1
        ms.append(s["ms"])
        for _, c, _, n in r["host"].get("top", []):
            cpu_by_proc.setdefault(n, []).append(c)
    out["node_states"] = states
    if ms:
        srt = sorted(ms)
        out["status_ms"] = {"p50": srt[len(srt) // 2], "p95": srt[min(len(srt) - 1, int(len(srt) * 0.95))], "max": srt[-1]}
    n = max(len(recs), 1)
    # A sample whose bounded `ps` read lost its race has an empty top, which is
    # indistinguishable from an idle host unless the report says so.
    deg = {}
    for r in recs:
        for label, why in (r["host"].get("degraded") or {}).items():
            deg["%s %s" % (label, why)] = deg.get("%s %s" % (label, why), 0) + 1
    out["degraded_host_reads"] = deg or None
    out["cpu_by_process"] = sorted(
        ([name, round(sum(v) / n, 1), max(v)] for name, v in cpu_by_proc.items()),
        key=lambda x: x[1], reverse=True)[:8]
    d = [r["host"]["lastdbd"]["cpu"] for r in recs if r["host"].get("lastdbd")]
    out["lastdbd_cpu"] = {"avg": round(statistics.mean(d), 1), "max": max(d)} if d else None
    swaps = [r["host"]["swap_used_mb"] for r in recs if r["host"].get("swap_used_mb") is not None]
    out["swap_used_mb_max"] = max(swaps) if swaps else None
    loads = [r["host"]["load"][0] for r in recs if r["host"].get("load")]
    out["load1_max"] = max(loads) if loads else None
    first = {}
    last = {}
    for r in recs:
        for row in r["node"]["ops"].get("rows", []):
            key = (row[0], row[1])
            first.setdefault(key, row)
            last[key] = row
    deltas = []
    for key, row in last.items():
        c0 = first[key][2] if row[2] >= first[key][2] else 0  # counter reset on restart
        deltas.append([key[0], key[1], row[2] - c0, row[3], row[4], row[5]])
    deltas.sort(key=lambda x: x[2], reverse=True)
    out["ops_by_count_delta"] = deltas[:8]
    vs = [r["node"]["status"]["vitals"] for r in recs if isinstance(r["node"]["status"].get("vitals"), dict) and "error" not in r["node"]["status"]["vitals"]]
    if vs:
        ev = [x["evict"] for x in vs if x.get("evict") is not None]
        sync = {}
        for x in vs:
            k = "%s%s" % (x.get("sync"), " (%s)" % x["sync_why"] if x.get("sync_why") else "")
            sync[k] = sync.get(k, 0) + 1
        out["vitals"] = {
            "fp_mb_max": max((x.get("fp_mb") or 0) for x in vs),
            "evictions": (ev[-1] - ev[0]) if ev and ev[-1] >= ev[0] else None,
            "sheds": (vs[-1].get("sheds") or 0) - (vs[0].get("sheds") or 0),
            "slow_ms_max": max((x.get("slow_ms") or 0) for x in vs),
            "uds_rej_max": max((x.get("uds_rej") or 0) for x in vs),
            "gov": sorted({str(x.get("gov")) for x in vs}),
            "sync": sync,
            "mlog_lag_s_max": max([x["mlog_lag_s"] for x in vs if x.get("mlog_lag_s") is not None] or [None], key=lambda v: -1 if v is None else v),
            "mlog_lag_s_last": vs[-1].get("mlog_lag_s"),
            "rp_age_s_max": max([x["rp_age_s"] for x in vs if x.get("rp_age_s") is not None] or [None], key=lambda v: -1 if v is None else v),
        }
    out["delivery"] = read_delivery(minutes)
    out["writes"] = write_report(read_writes(minutes))
    if as_json:
        print(json.dumps(out, indent=1))
        return
    print("window %dm  samples=%d  node=%s" % (minutes, out["samples"], states or "none"))
    if "status_ms" in out:
        print("status_ms p50=%(p50)s p95=%(p95)s max=%(max)s" % out["status_ms"])
    print("load1_max=%s swap_used_mb_max=%s lastdbd_cpu=%s" % (out["load1_max"], out["swap_used_mb_max"], out["lastdbd_cpu"]))
    if "vitals" in out:
        print("node vitals: %s" % json.dumps(out["vitals"], sort_keys=True))
    print("alert delivery: %s" % (json.dumps(out["delivery"], sort_keys=True) if out["delivery"] else "none in window"))
    if out.get("writes"):
        print("file writes/s by root (fs-event sources, %ds):" % out["writes"]["seconds"])
        for root, rate, top in out["writes"]["roots"]:
            print("  %-44s %8.2f  %s" % (root.replace(HOME, "~"), rate, " ".join("%s=%d" % (k, c) for k, c in top)))
    if out["degraded_host_reads"]:
        print("degraded host reads: %s  (an empty top is a lost race, not an idle host)"
              % json.dumps(out["degraded_host_reads"], sort_keys=True))
    print("host CPU by process (avg%, max%):")
    for name, avg, mx in out["cpu_by_process"]:
        print("  %-28s %6.1f %6.1f" % (name, avg, mx))
    print("LastDB requests in window (app verb +count avg_ms max_ms err):")
    for a, v, c, avg, mx, err in out["ops_by_count_delta"]:
        print("  %-28s %-14s +%-7d %5d %6d %d" % (a, v, c, avg, mx, err))


def main():
    ap = argparse.ArgumentParser(prog="last-stack-load-collector")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("sample")
    sub.add_parser("writes")  # one file-write-rate scan; sample starts this detached
    rp = sub.add_parser("report")
    rp.add_argument("--minutes", type=int, default=60)
    rp.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd == "report":
        report(a.minutes, a.json)
        return 0
    if a.cmd == "writes":
        try:
            writes_pass()
        except Exception as e:
            log_error(e)
        return 0
    try:
        sample()
    except Exception as e:  # a collector failure must never end the loop
        log_error(e)
    return 0


if __name__ == "__main__":
    sys.exit(main())
