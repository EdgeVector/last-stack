#!/usr/bin/env python3
"""Report brain slugs that shipped agent prose cites and the brain cannot serve.

A dangling citation is worse than no citation: it reads as an audited ground
truth, so the agent stops looking, and the standing rule it supports arrives
with no evidence anyone can check. 22 of ~62 real citations were dangling when
this was measured (2026-09-26, prose at last-stack c083521f0), mostly because
gbrain was primary from 2026-09-06 to 2026-09-25 and holds records that were
never migrated back into LastDB. The citations were correct when written; the
corpus moved out from under them and nothing noticed.

papercut-shipped-prose-cites-brain-slugs-that-do-not-resolve-20260926

With --one-hop it also point-gets every `[[target]]` inside the records that
prose cites. That is one level down and a different extractor: inside `[[ ]]` a
token is a citation by construction, so the hop needs no type vocabulary and
catches the untyped record names (`open-decisions`, `dogfood-registry`) that the
prefix table can never reach. Measured 2026-10-04 one hop from the installed
prose: 23 of 67 targets did not resolve.

The prefixes checked are the brain's whole record-type vocabulary (CITED_TYPES).
That matters for reading the output: a `dangling 0` is only as broad as this
table, and while the table held four of the eleven types, `dangling 0` read as
"no dangling citations" and meant "none among papercut/sop/decision/preference".

Deliberately NOT a merge gate. A required gate here would make CI depend on the
brain node being reachable, so a busy node would turn a correct PR red, and the
suite must pass on a GitHub runner that has no brain at all.

That left it with no caller. Its only automatic one was a step in
routines/papercut-reconciler.md, and the fleet has been at 4 active / 77 paused,
so it had not run on a schedule for days; every number this record carries was
produced by hand. A checker nothing runs is the same artifact as no checker.

So the live caller is `--changed-since <ref>` from close-out (2026-10-04),
which runs on this host after every substantive change, by every agent, and
cannot be silenced by a paused fleet. The per-change set is a handful of files,
so the sweep is a few point gets instead of ~90 (29 s -> about 1 s), and it
fails only on prose the author just touched. The full-root sweep stays the
periodic instrument for the legacy corpus.

The narrowing's residual risk is one-directional and belongs in the method
line: a citation in a file you did NOT touch is never read in this mode.

A transient node error is reported as `unknown`, never as `dangling`, and it
sets its own exit code. A checker that reports a busy node as a dangling
citation would be ignored within a day, and then the real dangling citations
ride along with the noise.

Exit codes:
  0  every citation resolves (or was deliberately skipped)
  1  at least one citation does not resolve
  2  usage error, or `--changed-since` could not determine the changed set.
     NOT a pass: a narrowing that silently covers nothing prints `dangling 0`
     and reads exactly like a clean corpus.
  3  at least one citation could not be determined (node transient) and none
     were proved dangling
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Iterable

# Prefix -> the `--type` that `brain get` needs for it. A point get is the
# authoritative reader here: enumeration under-reports on this store, so an
# absence taken from a listing would be a false positive.
#
# This set is the brain CLI's OWN record-type vocabulary -- the ten `<type> new`
# commands `brain help` prints, plus `papercut`, which is its own subcommand. It
# is deliberately the whole vocabulary and not a shortlist: this table has been
# widened twice before, once per prefix someone noticed, and each widening made
# the checker report a batch of dangling citations that had been invisible while
# it answered `dangling 0`. Measured 2026-10-03 when the last seven types were
# added, against prose nothing else had changed:
#
#     root                 dangling before   dangling after
#     ~/.last-stack             16               24
#     ~/code/edgevector          2                6
#
# Three of the four newly-found workspace citations are records the workspace
# CLAUDE.md names as mandatory reading before any work starts.
#
# `concepts` is an alias, not a type. This host's prose cites concept records
# under both `concept-` and `concepts-`, and both spellings resolve for some
# records, so the extractor has to accept the plural and the point get has to
# ask for the singular type.
CITED_TYPES = {
    "papercut": "papercut",
    "decision": "decision",
    "sop": "sop",
    "preference": "preference",
    "design": "design",
    "task": "task",
    "concept": "concept",
    "concepts": "concept",
    "reference": "reference",
    "agent": "agent",
    "project": "project",
    "spike": "spike",
}

# Longest prefix first. Defensive only, and measured as such 2026-10-03: Python
# backtracks across an alternation, so `concept|concepts` already matches the
# plural and reverting the sort leaves every case green. It is kept because the
# order is what a reader checks first when a plural prefix misbehaves, not
# because anything depends on it.
#
# `/` joins the lookbehind because a token after a slash is a PATH SEGMENT, not
# a citation: `https://thelastdb.com/docs/agent-access-model` is a URL, not a
# dangling `agent` record. Measured over both roots 2026-10-03 -- every
# slash-preceded token was a path segment and none was a citation -- so this
# needs no allowlist, the same shape as the one-character-past-the-token rule
# for generator prefixes below.
TOKEN_RE = re.compile(
    r"(?<![A-Za-z0-9/-])("
    + "|".join(sorted(CITED_TYPES, key=len, reverse=True))
    + r")-[a-z0-9][a-z0-9-]*"
)

# A `[[target]]` inside a brain record body is a citation BY CONSTRUCTION, so the
# one-hop extractor needs no type vocabulary and no path-segment lookbehind. That
# is why this surface is worth checking at all: the prose extractor can only find
# a token that starts with one of the eleven CITED_TYPES, so an untyped record
# name (`open-decisions`, `dogfood-registry`, `north-star-...`) is invisible to it
# forever, and those are exactly the links a SOP uses to point a reader onward.
#
# Measured 2026-10-04 over the 71 records that this install's prose cites, one hop:
#
#     distinct [[targets]]     70
#     resolve                  44
#     DO NOT RESOLVE           25   (36%)
#
# The three non-citations in that 70 were all shape, not semantics: `-n "$repo"`
# and `:space:` come from `[[ -n "$repo" ]]` and `[[:space:]]` in shell snippets
# quoted inside record bodies, and `north-star-...` is an ellipsis placeholder in
# prose. WIKI_SLUG_RE refuses all three and needs no allowlist. It also refuses a
# memory-file reference such as `[[feedback_always_file_papercuts]]`: records do
# link to those, they are files under ~/.claude and not brain records, and 0 of
# the 164 slugs that resolved in that measurement contained an underscore.
WIKILINK_RE = re.compile(r"\[\[([^\[\]|]{1,200}?)(?:\|[^\[\]]*)?\]\]")
WIKI_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")

# Prose lives in these places and nowhere else. Named, not searched: a walk over
# an install or state root resolves into unpruned artifact version trees.
#
# `hooks/*.sh` is prose. A PreToolUse hook's deny text is the HIGHEST-RISK
# citation surface on this host and was unscanned until 2026-10-04: it arrives
# mid-task, it is phrased as an instruction, it names a slug as the authority
# for a refusal the agent must now work around, and the agent is in a hurry.
# Every other prose surface is read deliberately. The defect was found the way
# it is meant to be: an agent copied a dangling slug out of a deny message into
# a shipped docstring.
#
# Measured 2026-10-04 over this repo's four `hooks/*.sh` before the widening --
# the false-positive count the record asked for, because a shell file is full of
# kebab-case tokens (command names, paths, variable values) and this record has
# twice predicted that a noisy citation checker gets ignored:
#
#     distinct tokens extracted   6
#     false positives             0
#     dangling                    3   (50%, against an *.md corpus a pass had
#                                      healed to `dangling 0` the same day)
#
# A 50% dangling rate on the unscanned surface, next to 0% on the scanned one,
# is what an unchecked set looks like after the checked set gets attention.
PROSE_ROOT_FILES = ("CLAUDE.md", "AGENTS.md")
PROSE_GLOBS = (
    "routines/*.md",
    "instructions/*.md",
    "skills/*/SKILL.md",
    "skills/*/*.md",
    "hooks/*.sh",
)

# Names under these dirs are how a token can be a LOCAL name rather than a
# citation: `papercut-lifecycle-close` is bin/last-stack-papercut-lifecycle-close,
# `papercut-filing-contract` is a test. A checker that reports those is ignored.
LOCAL_NAME_DIRS = ("bin", "tests", "tests/acceptance", "tests/ci", "lib", "hooks")

TRANSIENT_SIGNALS = (
    "node socket not reachable",
    "not reachable",
    "service_timeout",
    "did not respond",
    "too many concurrent reads",
    "uds_connection_limit",
    "persist_queue_full",
    "node_locked",
    "timed out",
)

# `brain get <slug> --type sop` on an absent record answers, on stderr:
#     error: No sop: sop-lastdb-safe-upgrade
#     hint:  No sop with that slug. Drop --type to search every type ...
# The first draft of this checker looked for "no record with slug" and so
# classified all 49 real absences as `unknown`. That is the safe direction to
# fail in, and it is still wrong: a checker that can only say `unknown` reports
# nothing. Match what the CLI actually prints.
MISSING_RE = re.compile(r"\berror:\s*no\b", re.IGNORECASE)

# A generator template's slug PREFIX is not a citation: `papercut-pipeline-forge-`
# in `papercut-pipeline-forge-<repo>-pr-<n>` names a family the routine mints at
# run time. The tell is in the source text, one character past the token, so it
# needs no allowlist and cannot go stale as new families are added.
TEMPLATE_NEXT = ("<", "*", "\u2026", "{", "$")


def brain_bin() -> str:
    return os.environ.get("PROSE_CITATION_BRAIN_BIN", "brain")


def iter_prose_files(root: Path, limit_to: set[str] | None = None) -> list[Path]:
    """Prose files under `root`, optionally narrowed to `limit_to` relpaths."""
    found: list[Path] = []
    for name in PROSE_ROOT_FILES:
        path = root / name
        if path.is_file():
            found.append(path)
    for pattern in PROSE_GLOBS:
        found.extend(sorted(p for p in root.glob(pattern) if p.is_file()))
    unique: list[Path] = []
    seen: set[Path] = set()
    for path in found:
        resolved = path.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        if limit_to is not None and str(path.relative_to(root)) not in limit_to:
            continue
        unique.append(path)
    return unique


def changed_paths(root: Path, ref: str) -> tuple[set[str] | None, str]:
    """(relpaths changed vs `ref`, detail). `None` means git could not answer.

    Compared against the WORKING TREE, not HEAD, so the same command answers
    before and after the commit -- close-out runs at both points. Untracked
    files are added separately because `git diff` does not see them, and a brand
    new routine or hook is exactly the file most likely to carry a fresh
    citation.
    """

    def git(*args: str) -> subprocess.CompletedProcess:
        return subprocess.run(
            ["git", "-C", str(root), *args], text=True, capture_output=True, check=False
        )

    base = git("merge-base", ref, "HEAD")
    if base.returncode != 0:
        detail = (base.stderr or base.stdout or "").strip().splitlines()
        return None, detail[0][:200] if detail else f"git merge-base {ref} HEAD failed"
    merge_base = base.stdout.strip()
    names: set[str] = set()
    for argv in (
        ("diff", "--name-only", merge_base),
        ("ls-files", "--others", "--exclude-standard"),
    ):
        proc = git(*argv)
        if proc.returncode != 0:
            detail = (proc.stderr or "").strip().splitlines()
            return None, detail[0][:200] if detail else f"git {argv[0]} failed"
        names.update(line for line in proc.stdout.splitlines() if line)
    return names, f"merge-base {merge_base[:12]}"


def local_names(root: Path) -> set[str]:
    """Basenames the repo itself owns, so a tool name is not read as a slug."""
    names: set[str] = set()
    for dirname in LOCAL_NAME_DIRS:
        base = root / dirname
        if not base.is_dir():
            continue
        for path in base.iterdir():  # one level: these dirs hold files, not trees
            if not path.is_file():
                continue
            stem = path.name
            names.add(stem)
            for suffix in (".sh", ".py", ".rb", ".ts"):
                if stem.endswith(suffix):
                    names.add(stem[: -len(suffix)])
    return names


def is_local_name(token: str, names: set[str]) -> bool:
    return any(token in name for name in names)


def read_ignore(path: Path | None) -> dict[str, str]:
    """`<token><space><reason>` per line. A reason is required: an unexplained
    exclusion is how a real dangling citation gets parked forever."""
    if path is None or not path.is_file():
        return {}
    ignored: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        token, _, reason = line.partition(" ")
        ignored[token] = reason.strip() or "(no reason given)"
    return ignored


def collect_citations(paths: list[Path], root: Path) -> dict[str, list[str]]:
    """token -> the prose files that cite it."""
    cites: dict[str, list[str]] = {}
    for path in paths:
        text = path.read_text(encoding="utf-8", errors="replace")
        where = str(path.relative_to(root))
        for match in TOKEN_RE.finditer(text):
            raw = match.group(0)
            tail = text[match.end() : match.end() + 2]
            if raw.endswith("-") and tail[:1] in TEMPLATE_NEXT:
                continue
            if tail.startswith("-") and tail[1:2] in TEMPLATE_NEXT:
                continue
            token = raw.rstrip("-.,;:)]}")
            if token.count("-") < 2:
                # `papercut-pipeline` and friends: a prefix, not a slug.
                continue
            cites.setdefault(token, [])
            if where not in cites[token]:
                cites[token].append(where)
    return cites


def get_once(argv: list[str], attempts: int = 3) -> tuple[str, str]:
    """('ok'|'missing'|'unknown', detail) for one `brain get` shape."""
    last = ""
    for attempt in range(1, attempts + 1):
        proc = subprocess.run(argv, text=True, capture_output=True, check=False)
        if proc.returncode == 0:
            return "ok", ""
        last = ((proc.stderr or "") + " " + (proc.stdout or "")).strip()
        lowered = last.lower()
        if any(signal in lowered for signal in TRANSIENT_SIGNALS):
            if attempt < attempts:
                time.sleep(1.5 * attempt)
                continue
            return "unknown", last.splitlines()[0][:200]
        if MISSING_RE.search(last):
            return "missing", last.splitlines()[0][:200] if last else "no record"
        # An unclassified non-zero exit is NOT evidence the record is absent.
        return "unknown", last.splitlines()[0][:200] if last else f"exit {proc.returncode}"
    return "unknown", last[:200]


def resolve(token: str) -> tuple[str, str]:
    """('ok'|'missing'|'unknown', detail).

    A typed miss is retried WITHOUT `--type`, which is what the CLI's own hint
    tells a human to do: `papercut-prevention-registry` and
    `papercut-reconciler-ledger` are cited with a papercut-shaped slug and
    filed as `reference`, so the typed get alone calls two live records dead.
    """
    record_type = CITED_TYPES[token.split("-", 1)[0]]
    state, detail = get_once([brain_bin(), "get", token, "--type", record_type])
    if state != "missing":
        return state, detail
    wide_state, wide_detail = get_once([brain_bin(), "get", token])
    if wide_state == "ok":
        return "ok", f"resolves without --type {record_type}"
    if wide_state == "unknown":
        return "unknown", wide_detail
    return "missing", detail


def fetch_record(token: str) -> tuple[str, str]:
    """('ok'|'missing'|'unknown', record text). The body, which get_once drops."""
    proc = subprocess.run(
        [brain_bin(), "get", token], text=True, capture_output=True, check=False
    )
    if proc.returncode == 0:
        return "ok", proc.stdout
    last = ((proc.stderr or "") + " " + (proc.stdout or "")).strip()
    if any(signal in last.lower() for signal in TRANSIENT_SIGNALS):
        return "unknown", ""
    if MISSING_RE.search(last):
        return "missing", ""
    return "unknown", ""


def collect_wikilinks(sources: list[str]) -> tuple[dict[str, list[str]], list[dict]]:
    """[[target]] -> the record slugs that link to it, plus the refused shapes.

    The refusals are RETURNED, not dropped. A hop that silently narrows reports
    `hop_dangling 0` and reads like a clean corpus, which is the same failure
    --changed-since has an exit-2 branch for.
    """
    links: dict[str, list[str]] = {}
    refused: list[dict] = []
    seen_refused: set[tuple[str, str]] = set()
    for slug in sources:
        state, text = fetch_record(slug)
        if state != "ok":
            continue
        for match in WIKILINK_RE.finditer(text):
            target = match.group(1).strip()
            if not WIKI_SLUG_RE.match(target):
                key = (target, slug)
                if key not in seen_refused:
                    seen_refused.add(key)
                    refused.append(
                        {
                            "target": target[:80],
                            "linked_from": slug,
                            "reason": "not a brain slug shape (shell snippet, path, "
                            "memory-file name or prose placeholder)",
                        }
                    )
                continue
            if target == slug:
                continue
            links.setdefault(target, [])
            if slug not in links[target]:
                links[target].append(slug)
    return links, refused


def main(argv: Iterable[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="last-stack-prose-citation-check",
        description="Point-get every brain slug cited in shipped agent prose.",
    )
    parser.add_argument(
        "--root",
        default=os.environ.get("LAST_STACK_ROOT", str(Path.home() / ".last-stack")),
        help="install root or checkout whose prose is checked (default: $LAST_STACK_ROOT)",
    )
    parser.add_argument(
        "--ignore-file",
        default=None,
        help="token+reason exclusions (default: <root>/config/prose-citation-ignore.txt)",
    )
    parser.add_argument(
        "--changed-since",
        metavar="REF",
        default=None,
        help=(
            "check only the prose files that differ from REF (merge-base vs the "
            "working tree, plus untracked files). This is the per-change mode a "
            "pre-PR caller uses; it CANNOT see a citation in prose you did not touch."
        ),
    )
    parser.add_argument(
        "--one-hop",
        action="store_true",
        help=(
            "also point-get every [[target]] inside the records this prose cites. "
            "Opt-in: it costs one brain get per cited record plus one per distinct "
            "target, which the per-change pre-PR caller cannot afford on the full "
            "root. It composes with --changed-since, and there the source set is "
            "only the records the change itself points a reader at."
        ),
    )
    parser.add_argument("--json", action="store_true", help="machine-readable report on stdout")
    parser.add_argument(
        "--list-only",
        action="store_true",
        help="print the cited tokens and exit 0 without touching the brain",
    )
    args = parser.parse_args(list(argv))

    root = Path(args.root).expanduser()
    if not root.is_dir():
        print(f"error: root is not a directory: {root}", file=sys.stderr)
        return 2

    ignore_path = (
        Path(args.ignore_file)
        if args.ignore_file
        else root / "config" / "prose-citation-ignore.txt"
    )
    ignored = read_ignore(ignore_path)
    names = local_names(root)

    limit_to: set[str] | None = None
    scope = "every prose file under the root"
    if args.changed_since is not None:
        limit_to, detail = changed_paths(root, args.changed_since)
        if limit_to is None:
            # Not a pass. A narrowing that silently covers nothing reports
            # `dangling 0` and reads exactly like a clean corpus -- the failure
            # this checker exists to stop. Exit 2 is the usage/environment code
            # and is distinguishable from both 0 and 1.
            print(
                f"error: --changed-since {args.changed_since}: cannot determine the "
                f"changed set ({detail})",
                file=sys.stderr,
            )
            return 2
        scope = f"ONLY prose changed vs {args.changed_since} ({detail})"

    prose_files = iter_prose_files(root, limit_to)
    cites = collect_citations(prose_files, root)

    checked: list[dict] = []
    skipped: list[dict] = []
    for token in sorted(cites):
        if token in ignored:
            skipped.append(
                {"slug": token, "reason": f"ignore-file: {ignored[token]}", "cited_in": cites[token]}
            )
            continue
        if is_local_name(token, names):
            skipped.append(
                {
                    "slug": token,
                    "reason": "names a file in this repo, not a brain record",
                    "cited_in": cites[token],
                }
            )
            continue
        checked.append({"slug": token, "cited_in": cites[token]})

    if args.list_only:
        for row in checked:
            print(row["slug"])
        return 0

    dangling: list[dict] = []
    unknown: list[dict] = []
    for row in checked:
        state, detail = resolve(row["slug"])
        row["state"] = state
        row["detail"] = detail
        if state == "missing":
            dangling.append(row)
        elif state == "unknown":
            unknown.append(row)

    hop_sources = [row["slug"] for row in checked if row["state"] == "ok"]
    hop_links: dict[str, list[str]] = {}
    hop_refused: list[dict] = []
    hop_dangling: list[dict] = []
    hop_unknown: list[dict] = []
    if args.one_hop:
        hop_links, hop_refused = collect_wikilinks(hop_sources)
        for target in sorted(hop_links):
            state, detail = get_once([brain_bin(), "get", target])
            row = {"slug": target, "linked_from": hop_links[target], "detail": detail}
            if state == "missing":
                hop_dangling.append(row)
            elif state == "unknown":
                hop_unknown.append(row)

    report = {
        "root": str(root),
        "scope": scope,
        "changed_since": args.changed_since,
        "prose_files": len(prose_files),
        "cited": len(cites),
        "checked": len(checked),
        "skipped": len(skipped),
        "resolved": len(checked) - len(dangling) - len(unknown),
        "dangling": dangling,
        "unknown": unknown,
        "skipped_rows": skipped,
        "one_hop": args.one_hop,
        "hop_sources": len(hop_sources) if args.one_hop else None,
        "hop_targets": len(hop_links) if args.one_hop else None,
        "hop_resolved": (
            len(hop_links) - len(hop_dangling) - len(hop_unknown) if args.one_hop else None
        ),
        "hop_dangling": hop_dangling,
        "hop_unknown": hop_unknown,
        "hop_refused": hop_refused,
        "method": (
            "point-get per cited slug via `brain get <slug> --type <type>`; "
            "a transient node error is reported as unknown after 3 attempts, never as dangling; "
            "tokens naming a file under bin/tests/lib/hooks and tokens in the ignore file are skipped; "
            f"scanned {scope}"
            + (
                "; one hop: every [[target]] inside the cited records, point-got "
                "untyped, with non-slug shapes reported as hop_refused rather than dropped"
                if args.one_hop
                else "; NO hop: a [[target]] inside a cited record is NOT checked "
                "(pass --one-hop)"
            )
        ),
    }

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(
            f"prose files {report['prose_files']}  cited {report['cited']}  "
            f"checked {report['checked']}  resolved {report['resolved']}  "
            f"dangling {len(dangling)}  unknown {len(unknown)}  skipped {report['skipped']}"
        )
        for row in dangling:
            print(f"DANGLING {row['slug']}  cited_in={','.join(row['cited_in'])}")
        for row in unknown:
            print(f"UNKNOWN  {row['slug']}  {row['detail']}")
        if args.one_hop:
            print(
                f"one hop: records {report['hop_sources']}  targets {report['hop_targets']}  "
                f"resolved {report['hop_resolved']}  dangling {len(hop_dangling)}  "
                f"unknown {len(hop_unknown)}  refused {len(hop_refused)}"
            )
            for row in hop_dangling:
                print(
                    f"HOP-DANGLING {row['slug']}  linked_from={','.join(row['linked_from'])}"
                )
            for row in hop_unknown:
                print(f"HOP-UNKNOWN  {row['slug']}  {row['detail']}")
        print(f"scope: {scope}")
        print(f"method: {report['method']}")

    # A detector that renders a finding and exits 0 is the defect this repo keeps
    # filing against other people's tools, so the hop counts toward the status.
    if dangling or hop_dangling:
        return 1
    if unknown or hop_unknown:
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
