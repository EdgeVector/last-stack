#!/usr/bin/env bash
# Atomic post-merge board closeout for pickup/kanban-agent.
#
# Usage:
#   last-stack-card-closeout <slug> [--board-cli fkanban|kanban] \
#     [--pr-url URL] [--branch NAME] [--force]
#
# 1. Optionally stamps --pr-url / --branch via add (preserves column).
# 2. Refuses deploy-gated closeout unless Requires-Deploy has terminal success,
#    a positive PROOF line, or (for helper-cutover END STATE / awaiting-deploy)
#    live proof in the body. Merge receipt alone is not done.
# 3. Refuses legacy-residue closeout unless latest main has zero marker hits
#    and the card OUTCOME records that grep-zero proof.
# 4. Moves the card to done (with lastdb-retry).
# 5. Verifies show --json reports column=done; retries once if not.
# 6. Best-effort: reclaim the card's agent worktree (strip target/node_modules,
#    save dirty patch, git worktree remove) via last-stack-worktree-reclaim.
# 7. Exits 0 only when the card is in the terminal column.
#
# Refuse final_column=done in ROUTINE_RESULT unless this helper exits 0.
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
slug="${1:-}"
shift || true
if [ -z "$slug" ]; then
  echo "usage: last-stack-card-closeout <slug> [--board-cli fkanban|kanban] [--pr-url u] [--branch b] [--force]" >&2
  exit 2
fi

board_cli=""
pr_url=""
branch=""
force=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --board-cli) board_cli="${2:-}"; shift 2 ;;
    --pr-url) pr_url="${2:-}"; shift 2 ;;
    --branch) branch="${2:-}"; shift 2 ;;
    --force) force=1; shift ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$board_cli" ]; then
  if command -v kanban >/dev/null 2>&1; then board_cli=kanban
  else
    echo "last-stack-card-closeout: need kanban on PATH" >&2
    exit 2
  fi
fi

sanitize_lib="$self_dir/../lib/sanitize_structured_fields.py"
if [ -n "$pr_url" ] && [ -f "$sanitize_lib" ]; then
  cleaned="$(python3 "$sanitize_lib" pr-url "$pr_url" 2>/dev/null || true)"
  if [ -n "$cleaned" ]; then
    pr_url="$cleaned"
  fi
fi

retry=( )
if [ -x "$self_dir/last-stack-lastdb-retry" ]; then
  retry=( "$self_dir/last-stack-lastdb-retry" --attempts 3 -- )
fi

command_timeout_sec="${LAST_STACK_CARD_CLOSEOUT_COMMAND_TIMEOUT_SEC:-50}"
case "$command_timeout_sec" in
  ''|*[!0-9]*) command_timeout_sec=50 ;;
esac
if [ "$command_timeout_sec" -lt 1 ]; then
  command_timeout_sec=1
fi

timeout_bin=""
if command -v gtimeout >/dev/null 2>&1; then
  timeout_bin="gtimeout"
elif command -v timeout >/dev/null 2>&1; then
  timeout_bin="timeout"
fi

with_timeout() {
  if [ -n "$timeout_bin" ]; then
    "$timeout_bin" -k 10s "${command_timeout_sec}s" "$@"
  else
    "$@"
  fi
}

run() {
  if [ "${#retry[@]}" -gt 0 ]; then
    with_timeout "${retry[@]}" "$@"
  else
    with_timeout "$@"
  fi
}

card_json="$(run "$board_cli" show "$slug" --json 2>/dev/null || true)"
if [ -z "$card_json" ]; then
  echo "last-stack-card-closeout: FAILED card-read-failed slug=$slug" >&2
  exit 1
fi

deploy_info="$(CARD_JSON="$card_json" python3 - <<'PY'
import json, re, sys
import os

try:
    raw = json.loads(os.environ.get("CARD_JSON", "{}"))
except Exception:
    sys.exit(0)
card = raw.get("card") if isinstance(raw, dict) else None
if not isinstance(card, dict):
    card = raw if isinstance(raw, dict) else {}
body = str(card.get("body") or "")
repo = str(card.get("repo") or "")
if not repo:
    m = re.search(r"(?im)^\s*Repo:\s*(\S+)\s*$", body)
    if m:
        repo = m.group(1)
repo_name = repo.rsplit("/", 1)[-1] if repo else ""
print(f"repo={repo_name}")
seen = set()
for line in body.splitlines():
    m = re.match(r"^\s*Requires-Deploy:\s*(.+?)\s*$", line)
    if not m:
        continue
    for part in re.split(r"[, ]+", m.group(1).strip()):
        if not part:
            continue
        if part in seen:
            continue
        seen.add(part)
        print(f"requires={part}")

tags = card.get("tags") or []
if isinstance(tags, str):
    tags = [p for p in re.split(r"[,\s]+", tags) if p]
parked = {
    "awaiting-deploy",
    "live-proof",
    "deploy-gate",
    "needs-safe-upgrade",
    "awaiting-validation",
}
has_parked_tag = any(str(t).strip().lower() in parked for t in tags)
print(f"parked_tag={1 if has_parked_tag else 0}")

section_lines = []
in_end = False
for line in body.splitlines():
    if re.match(r"^##[ \t]+", line):
        in_end = bool(re.match(r"^##[ \t]+END[ \t]+STATE\b", line, re.I))
    if in_end:
        section_lines.append(line)
    if re.match(r"^\s*DONE-WHEN\s*:", line, re.I):
        section_lines.append(line)
section = "\n".join(section_lines)
cutover_re = re.compile(
    r"(?i)\b(helper[ -]?cutover|host-track|live\s+scheduled[- ]fire|"
    r"installed\s+(?:helper|binary|cli)|safe-upgrade|awaiting-deploy)\b"
)
print(f"helper_cutover_end_state={1 if cutover_re.search(section) else 0}")

positive_words = re.compile(
    r"(?i)\b(pass|passed|verified|proven|green|satisfied|met|confirmed|"
    r"success|successful|complete|completed)\b"
)
proof = False
for line in body.splitlines():
    match = re.match(r"(?i)^\s*(?:[-*]\s*)?PROOF\s*:\s*(.*?)\s*$", line)
    if match and positive_words.search(match.group(1)):
        proof = True
        break
print(f"positive_proof={1 if proof else 0}")
PY
)"

deploy_repo="$(printf '%s\n' "$deploy_info" | sed -n 's/^repo=//p' | head -n 1)"
deploy_reqs="$(printf '%s\n' "$deploy_info" | sed -n 's/^requires=//p')"
parked_tag="$(printf '%s\n' "$deploy_info" | sed -n 's/^parked_tag=//p' | head -n 1)"
helper_cutover_end_state="$(printf '%s\n' "$deploy_info" | sed -n 's/^helper_cutover_end_state=//p' | head -n 1)"
positive_proof="$(printf '%s\n' "$deploy_info" | sed -n 's/^positive_proof=//p' | head -n 1)"
parked_tag="${parked_tag:-0}"
helper_cutover_end_state="${helper_cutover_end_state:-0}"
positive_proof="${positive_proof:-0}"
deploy_pipeline_ok=0

refuse_helper_cutover() {
  local reason="$1"
  echo "last-stack-card-closeout: FAILED helper-cutover-unmet slug=$slug reason=$reason" >&2
  echo "  Merge is not done. Add a positive PROOF line, or wait for helper cutover / host-track / deploy success." >&2
  run "$board_cli" mark "$slug" \
    "CLOSEOUT-DEFERRED: helper-cutover/deploy gate unmet (reason=$reason); merge is not done" \
    </dev/null >/dev/null 2>&1 || true
  exit 1
}

if [ "$positive_proof" = "1" ]; then
  echo "last-stack-card-closeout: body PROOF satisfies helper-cutover/deploy gate slug=$slug" >&2
elif [ -n "$deploy_reqs" ]; then
  if [ -z "$deploy_repo" ]; then
    echo "last-stack-card-closeout: FAILED deploy-gate-missing-repo slug=$slug" >&2
    exit 1
  fi
  if [ ! -x "$self_dir/last-stack-pipeline-deploy-scan" ]; then
    echo "last-stack-card-closeout: FAILED deploy-scan-missing slug=$slug" >&2
    exit 1
  fi
  # --repo always yields a row for this repo, including the synthesized
  # not-applicable / unconfigured states. Fall back to the whole-tree scan when
  # the installed scanner predates --repo.
  deploy_scan_json="$("$self_dir/last-stack-pipeline-deploy-scan" --json --repo "$deploy_repo" 2>/dev/null || true)"
  if [ -z "$deploy_scan_json" ]; then
    deploy_scan_json="$("$self_dir/last-stack-pipeline-deploy-scan" --json 2>/dev/null || true)"
  fi
  if [ -z "$deploy_scan_json" ]; then
    echo "last-stack-card-closeout: FAILED deploy-scan-empty slug=$slug repo=$deploy_repo" >&2
    exit 1
  fi
  while IFS= read -r deploy_req; do
    [ -n "$deploy_req" ] || continue
    if [ "$deploy_req" != "deploy-pipeline" ]; then
      echo "last-stack-card-closeout: FAILED unsupported-deploy-gate=$deploy_req slug=$slug" >&2
      exit 1
    fi
    gate_status="$(DEPLOY_SCAN_JSON="$deploy_scan_json" DEPLOY_REPO="$deploy_repo" python3 - <<'PY'
import json, os

repo = os.environ.get("DEPLOY_REPO", "")
try:
    rows = json.loads(os.environ.get("DEPLOY_SCAN_JSON", "[]"))
except Exception:
    rows = []
match = None
for row in rows if isinstance(rows, list) else []:
    if str(row.get("repo") or "") == repo:
        match = row
        break
if not match:
    print("missing|true|deploy log missing")
else:
    print(f"{match.get('status','')}|{str(bool(match.get('blocked'))).lower()}|{match.get('reason','')}")
PY
)"
    IFS='|' read -r gate_state gate_blocked gate_reason <<EOF
$gate_status
EOF
    # A repo with no deploy-pipeline producer can never satisfy this gate. Before
    # 2026-08-08 that read as `missing|blocked` and jammed the card in `doing`
    # forever — board-closeout flagged close-failed on every pass for 10h, and
    # the 24h park expiry would then have bounced merged, deployed work back to
    # todo. Not-applicable is a pass, and it says so out loud.
    # Brain: papercut-deploy-pipeline-gate-has-no-producer-for-non-lastgit-repos
    if [ "$gate_state" = "not-applicable" ] && [ "$gate_blocked" = "false" ]; then
      echo "last-stack-card-closeout: deploy gate not-applicable slug=$slug repo=$deploy_repo requires=$deploy_req reason=$gate_reason" >&2
      continue
    fi
    if [ "$gate_state" != "success" ] || [ "$gate_blocked" != "false" ]; then
      echo "last-stack-card-closeout: deploy gate pending slug=$slug repo=$deploy_repo requires=$deploy_req status=${gate_state:-unknown} reason=$gate_reason" >&2
      exit 1
    fi
    deploy_pipeline_ok=1
  done <<EOF
$deploy_reqs
EOF
fi

if [ "$positive_proof" = "1" ] || [ "$deploy_pipeline_ok" = "1" ]; then
  :
elif [ "$parked_tag" = "1" ]; then
  refuse_helper_cutover "awaiting-deploy-tag"
elif [ "$helper_cutover_end_state" = "1" ]; then
  refuse_helper_cutover "end-state-helper-cutover"
fi

legacy_info="$(CARD_JSON="$card_json" python3 - <<'PY'
import json
import os
import re
import shlex
import sys

try:
    raw = json.loads(os.environ.get("CARD_JSON", "{}"))
except Exception:
    sys.exit(0)

card = raw.get("card") if isinstance(raw, dict) else None
if not isinstance(card, dict):
    card = raw if isinstance(raw, dict) else {}

body = str(card.get("body") or "")
repo = str(card.get("repo") or "")
if not repo:
    m = re.search(r"(?im)^\s*Repo:\s*(\S+)\s*$", body)
    if m:
        repo = m.group(1)

section_match = re.search(
    r"(?ims)^##[ \t]+LEGACY[ \t]+(?:RESIDUE|REMOVAL)\b.*?(?=^##[ \t]+|\Z)",
    body,
)
required = bool(section_match)
print(f"legacy_required={1 if required else 0}")
if not required:
    sys.exit(0)

section = section_match.group(0)
marker_match = re.search(
    r"(?im)^\s*(?:[-*]\s*)?(?:legacy_markers?|markers?|regex|pattern)\s*[:=]\s*(.+?)\s*$",
    section,
)
regex = ""
if marker_match:
    raw_markers = marker_match.group(1).strip()
    # Avoid grave-accent chars in this snippet: nested under bash $(...) they
    # close command substitution (same class of bug as card-reaper-run).
    _q = "'" + '"'
    raw_markers = raw_markers.strip(_q)
    if "|" in raw_markers:
        regex = raw_markers
    else:
        parts = [
            p.strip().strip(_q)
            for p in re.split(r"\s*,\s*|\s+", raw_markers)
            if p.strip().strip(_q)
        ]
        regex = "|".join(parts)

repo_match = re.search(r"(?im)^\s*(?:[-*]\s*)?(?:repo|legacy_repo)\s*:\s*(\S+)\s*$", section)
if repo_match:
    repo = repo_match.group(1)

outcome_match = re.search(r"(?ims)^##[ \t]+OUTCOME\b.*?(?=^##[ \t]+|\Z)", body)
outcome = outcome_match.group(0) if outcome_match else ""
proof = bool(
    re.search(r"\b0[ \t-]+hits\b", outcome, re.I)
    and re.search(r"(last-stack-legacy-residue-probe|git[ \t]+grep)", outcome, re.I)
    and re.search(r"\b[\w./-]+@[0-9a-f]{7,40}\b", outcome, re.I)
)

print(f"legacy_repo={shlex.quote(repo)}")
print(f"legacy_regex={shlex.quote(regex)}")
print(f"legacy_proof={1 if proof else 0}")
PY
)"

legacy_required=0
legacy_repo=""
legacy_regex=""
legacy_proof=0
eval "$legacy_info"

if [ "$legacy_required" = "1" ]; then
  if [ -z "$legacy_repo" ] || [ -z "$legacy_regex" ]; then
    echo "last-stack-card-closeout: FAILED legacy-residue-missing-marker slug=$slug" >&2
    exit 1
  fi
  if [ ! -x "$self_dir/last-stack-legacy-residue-probe" ]; then
    echo "last-stack-card-closeout: FAILED legacy-residue-probe-missing slug=$slug" >&2
    exit 1
  fi
  if [ "$legacy_proof" != "1" ]; then
    echo "last-stack-card-closeout: FAILED legacy-residue-proof-missing slug=$slug" >&2
    exit 1
  fi
  probe_out="/tmp/last-stack-legacy-residue-probe.$$"
  set +e
  "$self_dir/last-stack-legacy-residue-probe" "$legacy_repo" "$legacy_regex" >"$probe_out" 2>&1
  probe_rc=$?
  set -e
  if [ "$probe_rc" -ne 0 ]; then
    cat "$probe_out" >&2
    rm -f "$probe_out"
    echo "last-stack-card-closeout: FAILED legacy-residue-probe-red slug=$slug repo=$legacy_repo regex=$legacy_regex exit=$probe_rc" >&2
    exit 1
  fi
  rm -f "$probe_out"
fi

# Use the passed review URL. If it is absent, use the URL on the card. This
# prevents a caller from skipping merge proof by omitting --pr-url.
card_pr_url="$(CARD_JSON="$card_json" python3 - <<'PY'
import json
import os
import sys

try:
    raw = json.loads(os.environ.get("CARD_JSON", "{}"))
except Exception:
    sys.exit(0)

card = raw.get("card") if isinstance(raw, dict) else None
if not isinstance(card, dict):
    card = raw if isinstance(raw, dict) else {}
print(str(card.get("pr_url") or ""))
PY
)"

effective_pr_url="$pr_url"
if [ -z "$effective_pr_url" ]; then
  effective_pr_url="$card_pr_url"
fi
if [ -n "$effective_pr_url" ] && [ -f "$sanitize_lib" ]; then
  cleaned="$(python3 "$sanitize_lib" pr-url "$effective_pr_url" 2>/dev/null || true)"
  if [ -n "$cleaned" ]; then
    effective_pr_url="$cleaned"
  fi
fi

# Verify merge state before any close marker is written. An old order wrote a
# CLOSED-ON-MERGE marker before the review check.
if [ -n "$effective_pr_url" ]; then
  merge_probe="$self_dir/last-stack-card-closeout-merge-probe"
  if [ -x "$merge_probe" ]; then
    if ! merge_out="$(run "$merge_probe" "$effective_pr_url" 2>&1)"; then
      echo "$merge_out" >&2
      echo "last-stack-card-closeout: FAILED unmerged-review slug=$slug pr_url=$effective_pr_url" >&2
      echo "  Kind:pr is only done when the review artifact is merged." >&2
      exit 1
    fi
  fi
fi

# END STATE audit and close signal. A positive PROOF line is a terminal claim.
# The signal changes only when the merged review URL or positive proof changes.
# A reopened card cannot close again on the same signal.
end_state_gate="${LAST_STACK_CARD_CLOSEOUT_END_STATE_GATE:-0}"
end_state_info="$(CARD_JSON="$card_json" EFFECTIVE_PR_URL="$effective_pr_url" python3 - <<'PY'
import hashlib
import json
import os
import re
import sys

try:
    raw = json.loads(os.environ.get("CARD_JSON", "{}"))
except Exception:
    sys.exit(0)

card = raw.get("card") if isinstance(raw, dict) else None
if not isinstance(card, dict):
    card = raw if isinstance(raw, dict) else {}

body = str(card.get("body") or "")
column = str(card.get("column") or "")

has_end_state = bool(
    re.search(r"(?im)^##[ \t]+END[ \t]+STATE\b", body)
    or re.search(r"(?im)^\s*DONE-WHEN\s*:", body)
)
print(f"end_state_required={1 if has_end_state else 0}")

outcome_match = re.search(r"(?ims)^##[ \t]+OUTCOME\b.*?(?=^##[ \t]+|\Z)", body)
outcome = outcome_match.group(0) if outcome_match else ""
outcome_claimed = bool(
    re.search(r"(?i)\bEND[ \t]+STATE\b|\bDONE-WHEN\b", outcome)
    and re.search(
        r"(?i)\b(met|unmet|satisfied|verified|proven|holds|confirmed|measured|passed|green)\b",
        outcome,
    )
)

positive_words = re.compile(
    r"(?i)\b(pass|passed|verified|proven|green|satisfied|met|confirmed|success|successful|complete|completed)\b"
)
proof_lines = []
for line in body.splitlines():
    match = re.match(r"(?i)^\s*(?:[-*]\s*)?PROOF\s*:\s*(.*?)\s*$", line)
    if match and positive_words.search(match.group(1)):
        proof_lines.append(" ".join(match.group(1).split()))

claimed = outcome_claimed or bool(proof_lines)
effective_pr_url = os.environ.get("EFFECTIVE_PR_URL", "")
signal_material = "closeout-v1\npr=" + effective_pr_url + "\nproof=" + "\n".join(proof_lines)
signal = hashlib.sha256(signal_material.encode("utf-8")).hexdigest()
markers = re.findall(
    r"(?im)^\s*CLOSEOUT-DECISION\s+signal=([0-9a-f]{64})\s+state=closed\b",
    body,
)

print(f"end_state_claimed={1 if claimed else 0}")
print(f"closeout_initial_column={column}")
print(f"closeout_previous_signal={markers[-1] if markers else ''}")
print(f"closeout_signal={signal}")
PY
)"

end_state_required=0
end_state_claimed=0
closeout_initial_column=""
closeout_previous_signal=""
closeout_signal=""
eval "$end_state_info"

if [ -z "$closeout_signal" ]; then
  echo "last-stack-card-closeout: FAILED closeout-signal-missing slug=$slug" >&2
  exit 1
fi

if [ "$closeout_initial_column" != "done" ] \
  && [ -n "$closeout_previous_signal" ] \
  && [ "$closeout_previous_signal" = "$closeout_signal" ]; then
  echo "last-stack-card-closeout: FAILED reopened-same-signal slug=$slug signal=$closeout_signal" >&2
  echo "  Add a new positive PROOF line or link a new merged review before closeout." >&2
  exit 1
fi

end_state_warning=0
if [ "$end_state_required" = "1" ] && [ "$end_state_claimed" != "1" ]; then
  if [ "$end_state_gate" = "1" ]; then
    echo "last-stack-card-closeout: FAILED end-state-unverified slug=$slug" >&2
    echo "  This card declares an END STATE. A merged PR is not evidence that it" >&2
    echo "  holds. Add an ## OUTCOME naming the END STATE and a verdict, or leave" >&2
    echo "  the card in doing for whoever can evaluate it." >&2
    exit 1
  fi
  echo "last-stack-card-closeout: WARN end-state-unverified slug=$slug — closing on merge without an evaluated END STATE" >&2
  end_state_warning=1
fi

# Stamp PR/branch without changing column (add preserves existing column).
# todo/backlog cannot carry --pr-url/--branch; claim doing first.
# After done, restamp again and fail closed if the requested fields are missing.

column_of() {
  run "$board_cli" show "$slug" --json 2>/dev/null | python3 -c '
import sys, json
d = json.load(sys.stdin)
c = d.get("card") or d
print(c.get("column") or "")
' 2>/dev/null || true
}

field_of() {
  local key="$1"
  run "$board_cli" show "$slug" --json 2>/dev/null | python3 -c '
import sys, json
key = sys.argv[1]
d = json.load(sys.stdin)
c = d.get("card") or d
v = c.get(key)
print("" if v is None else v)
' "$key" 2>/dev/null || true
}

move_to() {
  local dest="$1"
  if [ "$force" -eq 1 ]; then
    run "$board_cli" move "$slug" "$dest" --force
  else
    run "$board_cli" move "$slug" "$dest"
  fi
}

restamp_fields() {
  if [ -z "$pr_url" ] && [ -z "$branch" ]; then
    return 0
  fi
  local add_args add_out add_rc
  add_args=( "$board_cli" add "$slug" )
  [ -n "$pr_url" ] && add_args+=( --pr-url "$pr_url" )
  [ -n "$branch" ] && add_args+=( --branch "$branch" )
  # kanban add waits 2s for stdin body when none is passed. Close stdin so
  # restamp of --pr-url/--branch cannot hang (papercut-kanban-add-stdin-timeout-in-closeout).
  add_out="$(run "${add_args[@]}" </dev/null 2>&1)" || {
    add_rc=$?
    echo "$add_out" >&2
    echo "last-stack-card-closeout: WARN board-add-failed slug=$slug exit=$add_rc" >&2
    return 0
  }
  [ -z "$add_out" ] || printf '%s\n' "$add_out"
}

claim_doing_if_needed() {
  local col
  col="$(column_of)"
  case "$col" in
    todo|backlog)
      move_to doing || true
      ;;
  esac
}

verify_linkage() {
  [ -n "$pr_url" ] || [ -n "$branch" ] || return 0
  local got_url got_branch
  got_url="$(field_of pr_url)"
  got_branch="$(field_of branch)"
  if [ -n "$pr_url" ] && [ "$got_url" != "$pr_url" ]; then
    echo "last-stack-card-closeout: FAILED linkage-missing slug=$slug wanted_pr_url=$pr_url got_pr_url=$got_url" >&2
    return 1
  fi
  if [ -n "$branch" ] && [ "$got_branch" != "$branch" ]; then
    echo "last-stack-card-closeout: FAILED linkage-missing slug=$slug wanted_branch=$branch got_branch=$got_branch" >&2
    return 1
  fi
  return 0
}

claim_doing_if_needed
restamp_fields

move_to done || true
col="$(column_of)"
if [ "$col" != "done" ]; then
  echo "last-stack-card-closeout: column=$col after first move; retrying with --force" >&2
  force=1
  move_to done || true
  col="$(column_of)"
fi

if [ "$col" != "done" ]; then
  echo "last-stack-card-closeout: FAILED column=$col (wanted done) slug=$slug" >&2
  exit 1
fi

# done may carry --pr-url/--branch even when todo rejected the first restamp.
restamp_fields
if ! verify_linkage; then
  exit 1
fi

closeout_marker="CLOSEOUT-DECISION signal=$closeout_signal state=closed"
if ! run "$board_cli" mark "$slug" "$closeout_marker" >/dev/null 2>&1; then
  echo "last-stack-card-closeout: FAILED closeout-marker-write slug=$slug signal=$closeout_signal" >&2
  if [ "$closeout_initial_column" != "done" ]; then
    force=1
    move_to doing >/dev/null 2>&1 || true
  fi
  exit 1
fi

if [ "$end_state_warning" = "1" ]; then
  run "$board_cli" mark "$slug" \
    "CLOSED-ON-MERGE $(date -u +%Y-%m-%dT%H:%M:%SZ) — card moved to done because a PR merged; its ## END STATE was NOT evaluated. Re-open if any clause is still unmet. (last-stack-card-closeout end-state audit)" \
    >/dev/null 2>&1 || true
fi

echo "last-stack-card-closeout: ok slug=$slug column=done signal=$closeout_signal"
exit 0
