#!/usr/bin/env bash
# last-stack-canary-loom — tick the lastdb-canary-release loom graph.
# One key per candidate. WAIT parks; this command resumes.
#
#   last-stack-canary-loom [--json] [--quiet] [--dry-run] [--no-heal] [--status]
#   last-stack-canary-loom --start [--oid SHA]
#   last-stack-canary-loom --recover --child <lx-id>
#
# --recover relaunches the canary graph in verified-live mode for a GREEN
# safe-upgrade child that already cut over. It reads the child receipt from
# loom, builds the recovery input, and launches with the full env contract
# (PATH, LOOM_SCRIPTS, live flags). Hand-rolled `loom run` calls miss that
# contract and fail the RECOVER_LIVE node at spawn with no recorded output
# (lx-20260830T122141.772-6345-1).
#
# Exit: 0 ran/noop, 2 usage, 3 loom unavailable.
set -euo pipefail

JSON=0
QUIET=0
STATUS=0
DRY=0
HEAL=1
START=0
RECOVER=0
CHILD=""
OID=""
KEY=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --status) STATUS=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --no-heal) HEAL=0; shift ;;
    --heal) HEAL=1; shift ;;
    --start) START=1; shift ;;
    --recover) RECOVER=1; shift ;;
    --child) CHILD="${2:-}"; shift 2 ;;
    --oid) OID="${2:-}"; shift 2 ;;
    --key) KEY="${2:-}"; shift 2 ;;
    -h|--help)
      echo "last-stack-canary-loom [--json] [--dry-run] [--no-heal] [--start] [--oid SHA] [--recover --child LX-ID] [--key KEY]"
      exit 0
      ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

if [ "$RECOVER" -eq 1 ]; then
  [ -n "$CHILD" ] || { echo "canary-loom: --recover requires --child <lx-id>" >&2; exit 2; }
  [ "$HEAL" -eq 1 ] || { echo "canary-loom: --recover with --no-heal would run the stand-in path against a live receipt" >&2; exit 2; }
  [ "$START" -eq 0 ] || { echo "canary-loom: --recover and --start are mutually exclusive" >&2; exit 2; }
  case "$CHILD" in
    lx-*) ;;
    *) echo "canary-loom: --child must be a loom execution id (lx-*)" >&2; exit 2 ;;
  esac
  # A fresh key per relaunch: recovery verification is read-only up to the
  # idempotent LEDGER/SOAK nodes, and reusing a failed attempt's key would
  # only replay the failed execution instead of starting a new one.
  [ -n "$KEY" ] || KEY="canary-recover-$(date -u +%Y%m%dT%H%M%SZ)-${CHILD}"
fi

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"
# shellcheck source=../lib/canary-loom/loom-run-deadline.sh
. "$ROOT/lib/canary-loom/loom-run-deadline.sh"
STAMP="${LAST_STACK_CANARY_LOOM_STAMP:-$HOME/.last-stack/state/canary-loom.json}"
ACTIVE="${LAST_STACK_CANARY_LOOM_ACTIVE:-$(dirname "$STAMP")/canary-loom-active.json}"
CANARY_LOOM_DEFINITION="${LAST_STACK_CANARY_DEFINITION:-lastdb-canary-release}"
CANARY_LOOM_DISCOVER_WINDOW_H="${LAST_STACK_CANARY_LOOM_DISCOVER_WINDOW_HOURS:-72}"
CANARY_LOOM_DISCOVER_LIMIT="${LAST_STACK_CANARY_LOOM_DISCOVER_LIMIT:-25}"
# Parent CALL_A drives a lastdb-safe-upgrade child; size the drive for CUTOVER.
export_loom_run_deadline_for "$CANARY_LOOM_DEFINITION"
DEADLINE_SECS="${LOOM_RUN_DEADLINE_SECS:-}"

log() { [ "$QUIET" -eq 1 ] || printf 'canary-loom: %s\n' "$*" >&2; }

write_stamp() {
  mkdir -p "$(dirname "$STAMP")"
  ST="$1" KY="${2:-}" OC="${3:-}" DT="${4:-}" DL="${DEADLINE_SECS:-}" LAST_STACK_CANARY_LOOM_STAMP="$STAMP" python3 -c '
import json, os, datetime
p = os.environ["LAST_STACK_CANARY_LOOM_STAMP"]
doc = {
  "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "status": os.environ.get("ST", ""),
  "key": os.environ.get("KY", ""),
  "outcome": os.environ.get("OC", ""),
  "detail": os.environ.get("DT", ""),
  "deadline_secs": os.environ.get("DL", ""),
  "engine": "loom",
}
tmp = f"{p}.tmp.{os.getpid()}"
open(tmp, "w").write(json.dumps(doc) + "\n")
os.replace(tmp, p)
'
}

write_active() {
  mkdir -p "$(dirname "$ACTIVE")"
  active_tmp="$(mktemp "$(dirname "$ACTIVE")/.canary-loom-active.XXXXXX")"
  jq -cn \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg key "$1" \
    --arg execution "$2" \
    --arg status "$3" \
    --arg state "$4" \
    '{ts:$ts,key:$key,execution:$execution,status:$status,state:$state,engine:"loom"}' \
    >"$active_tmp"
  mv "$active_tmp" "$ACTIVE"
}

clear_active() {
  [ -f "$ACTIVE" ] || return 0
  active_key="$(jq -r '.key // empty' "$ACTIVE" 2>/dev/null || true)"
  [ -z "$active_key" ] || [ "$active_key" = "$1" ] || return 0
  rm -f "$ACTIVE"
}

if [ "$STATUS" -eq 1 ]; then
  LAST_STACK_CANARY_LOOM_STAMP="$STAMP" python3 -c '
import json, os
p = os.environ["LAST_STACK_CANARY_LOOM_STAMP"]
if not os.path.isfile(p):
    print(json.dumps({"ok": False, "missing": True}))
else:
    print(open(p).read().strip())
'
  exit 0
fi

resolve_oid() {
  if [ -n "$OID" ]; then
    printf '%s\n' "$OID"
    return
  fi
  git -C "${HOME}/.cache/edgevector-git/fold.git" rev-parse refs/heads/main 2>/dev/null || true
}

export LAST_STACK_CANARY_LOOM_STAMP="$STAMP"

# The active marker is separate from the last-result stamp. A true idle check
# may replace the last result, but it must never erase the only resume key for
# a native Loom execution.
if [ -z "$KEY" ] && [ -f "$ACTIVE" ]; then
  KEY="$(jq -r '.key // empty' "$ACTIVE" 2>/dev/null || true)"
  if [ -z "$KEY" ]; then
    write_stamp invalid "" "error" "active-marker-invalid"
    if [ "$JSON" -eq 1 ]; then
      jq -cn '{outcome:"error",detail:"active-marker-invalid",engine:"loom",key:"",status:"invalid",execution:""}'
    else
      printf '%s\n' 'CANARY_LOOM outcome=error detail=active-marker-invalid'
    fi
    printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=active-marker-invalid"
    exit 3
  fi
fi
if [ -z "$KEY" ] && [ -f "$STAMP" ]; then
  stamp_status="$(jq -r '.status // empty' "$STAMP" 2>/dev/null || true)"
  # `idle` is NOT terminal for key discovery. An idle tick writes an empty key,
  # and treating that as the end of the search is what made the no-key state
  # absorbing (papercut-canary-loom-active-marker-loss-returns-no-key).
  case "$stamp_status" in
    succeeded|failed|cancelled|dry-run) ;;
    *) KEY="$(jq -r '.key // empty' "$STAMP" 2>/dev/null || true)" ;;
  esac
fi

# Both local files are caches of a fact loom owns. When they are empty, ask
# loom: any execution of this definition still in waiting/running carries its
# own resume key in `idempotency_key`. A hand-made key (one no `canary-<oid>`
# reconstruction can guess) is only recoverable this way.
discover_key_from_loom() {
  if [ -n "${CANARY_LOOM_LIST_FILE:-}" ]; then
    cat "$CANARY_LOOM_LIST_FILE"
    return $?
  fi
  "$ROOT/bin/last-stack-loom-exec-latest" \
    --definition "$CANARY_LOOM_DEFINITION" \
    --window-hours "$CANARY_LOOM_DISCOVER_WINDOW_H" \
    --limit "$CANARY_LOOM_DISCOVER_LIMIT"
}

pick_live_key() {
  LOOM_ROWS_FILE="$1" python3 -c '
import json, os, sys
path = os.environ.get("LOOM_ROWS_FILE") or ""
try:
    with open(path) as fh:
        rows = json.load(fh)
except Exception:
    raise SystemExit(2)
if not isinstance(rows, list):
    raise SystemExit(2)
live = [r for r in rows if isinstance(r, dict)
        and str(r.get("status") or "") in ("waiting", "running")
        and str(r.get("idempotency_key") or "")]
live.sort(key=lambda r: str(r.get("updated_at") or r.get("updatedAt") or ""), reverse=True)
if live:
    print(json.dumps({
        "key": str(live[0].get("idempotency_key") or ""),
        "execution": str(live[0].get("id") or live[0].get("exec_id") or ""),
        "status": str(live[0].get("status") or ""),
        "state": str(live[0].get("state") or ""),
    }, separators=(",", ":")))
else:
    print("{}")
'
}

discovered_execution=""
discovered_status=""
discovered_state=""
discovery_failed=0
if [ -z "$KEY" ] && [ "$START" -eq 0 ] && [ "$RECOVER" -eq 0 ] && [ "$DRY" -eq 0 ]; then
  discover_file="$(mktemp "${TMPDIR:-/tmp}/canary-loom-discover.XXXXXX")"
  if discover_key_from_loom >"$discover_file" 2>/dev/null; then
    if discovered="$(pick_live_key "$discover_file")"; then
      KEY="$(printf '%s\n' "$discovered" | jq -r '.key // empty')"
      discovered_execution="$(printf '%s\n' "$discovered" | jq -r '.execution // empty')"
      discovered_status="$(printf '%s\n' "$discovered" | jq -r '.status // empty')"
      discovered_state="$(printf '%s\n' "$discovered" | jq -r '.state // empty')"
      if [ -n "$KEY" ]; then
        log "recovered resume key from loom: key=$KEY exec=${discovered_execution:-none}"
        write_active "$KEY" "$discovered_execution" \
          "${discovered_status:-unknown}" "${discovered_state:-unknown}"
      fi
    else
      log "loom execution listing returned invalid JSON during key discovery"
      discovery_failed=1
    fi
  else
    log "loom execution listing failed during key discovery"
    discovery_failed=1
  fi
  rm -f "$discover_file"
fi

if [ "$START" -eq 1 ]; then
  oid="$(resolve_oid)"
  [ -n "$oid" ] || { echo "canary-loom: no main oid" >&2; exit 3; }
  [ -n "$KEY" ] || KEY="canary-${oid}"
  OID="$oid"
fi

if [ "$DRY" -eq 1 ]; then
  det="key=${KEY:-} start=${START} oid=${OID:-} deadline_secs=${DEADLINE_SECS:-} definition=${CANARY_LOOM_DEFINITION}"
  oc="noop"
  [ "$START" -eq 1 ] && oc="ok"
  write_stamp dry-run "$KEY" "$oc" "$det"
  if [ "$JSON" -eq 1 ]; then
    printf '{"outcome":"%s","detail":"%s","engine":"loom","key":"%s"}\n' "$oc" "$det" "$KEY"
  else
    printf 'canary-loom dry-run %s\n' "$det"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${det}"
  exit 0
fi

if [ -z "$KEY" ] && [ "$discovery_failed" -eq 1 ]; then
  write_stamp unavailable "" "error" "loom-list-unreadable"
  if [ "$JSON" -eq 1 ]; then
    jq -cn '{outcome:"error",detail:"loom-list-unreadable",engine:"loom",key:"",status:"unavailable",execution:""}'
  else
    printf '%s\n' 'CANARY_LOOM outcome=error detail=loom-list-unreadable'
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' 'outcome=error detail=loom-list-unreadable'
  exit 3
fi

if [ -z "$KEY" ]; then
  write_stamp idle "" "noop" "no-key"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=noop detail=no-key"
  exit 0
fi

if ! command -v loom >/dev/null 2>&1; then
  log "loom not on PATH"
  write_stamp unavailable "$KEY" "error" "loom-missing"
  exit 3
fi
if ! loom ping >/dev/null 2>&1; then
  log "loom ping failed"
  write_stamp unavailable "$KEY" "error" "loom-ping-failed"
  exit 3
fi

exe="$(command -v loom)"
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$exe")"
install_root="$(dirname "$(dirname "$real")")"
defs=""
scripts=""
for cand in "${LOOM_DEFS:-}" "$ROOT/lib/canary-loom" "$install_root/definitions"; do
  [ -n "$cand" ] && [ -f "$cand/lastdb-canary-release.json" ] && defs="$cand" && break
done
for cand in "${LOOM_SCRIPTS:-}" "$ROOT/lib/canary-loom" "$install_root/scripts"; do
  [ -n "$cand" ] && [ -f "$cand/loom-canary-step.sh" ] && scripts="$cand" && break
done
if [ -z "$defs" ] || [ -z "$scripts" ] || [ ! -f "$defs/lastdb-safe-upgrade.json" ]; then
  log "lastdb-canary-release definitions/scripts not found"
  write_stamp unavailable "$KEY" "error" "defs-missing"
  exit 3
fi
export LOOM_SCRIPTS="$scripts"
if [ "$HEAL" -eq 1 ]; then
  export LOOM_CANARY_LIVE=1
  export LOOM_LIVE=1
  export LOOM_CANARY_RED_LIVE=1
else
  unset LOOM_CANARY_LIVE LOOM_LIVE LOOM_CANARY_RED_LIVE || true
fi

# Publish the child first. The parent CALL_A node resolves the named definition
# from LastDB, so publishing only the parent can leave an older cutover graph
# active after the local artifact changes.
loom validate "$defs/lastdb-safe-upgrade.json" >/dev/null
loom validate "$defs/lastdb-canary-release.json" >/dev/null
loom publish "$defs/lastdb-safe-upgrade.json" >/dev/null
loom publish "$defs/lastdb-canary-release.json" >/dev/null
if [ "$RECOVER" -eq 1 ]; then
  # Build verified-live recovery input from the GREEN child's own receipt.
  # RECOVER_LIVE re-verifies all of this against the live node before the
  # graph records anything, so a stale receipt fails closed there.
  recover_show="$(loom show "$CHILD" 2>&1)" || {
    log "cannot read recovery child $CHILD"
    write_stamp unavailable "$KEY" "error" "recover-child-unreadable child=$CHILD"
    printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=recover-child-unreadable child=$CHILD"
    exit 3
  }
  recover_field() {
    printf '%s\n' "$recover_show" | sed -n "s/^context\.$1: //p" | head -1 \
      | jq -r 'if type == "string" then . else empty end' 2>/dev/null || true
  }
  recover_status="$(printf '%s\n' "$recover_show" | awk -F': ' '/^status:/{print $2; exit}')"
  recover_state="$(printf '%s\n' "$recover_show" | awk -F': ' '/^state:/{print $2; exit}')"
  recover_candidate="$(recover_field candidate)"
  recover_candidate_cli="$(recover_field candidate_cli)"
  recover_oid="$(recover_field source_git_oid)"
  recover_version="$(recover_field version)"
  recover_lastdbd_version="$(recover_field lastdbd_version)"
  recover_lastdb_version="$(recover_field lastdb_version)"
  recover_lastdbd_sha256="$(recover_field lastdbd_sha256)"
  recover_lastdb_sha256="$(recover_field lastdb_sha256)"
  recover_artifact_digest="$(recover_field candidate_artifact_digest)"
  recover_protocol_version="$(recover_field safe_upgrade_protocol_version)"
  recover_verdict="$(recover_field verdict)"
  recover_cutover="$(recover_field cutover)"
  recover_verify="$(recover_field verify)"
  if [ "$recover_status" != "succeeded" ] || [ "$recover_state" != "DONE" ] \
    || [ "$recover_protocol_version" != "6" ] || [ "$recover_verdict" != "green" ] \
    || [ "$recover_cutover" != "live" ] || [ "$recover_verify" != "live" ] \
    || [ -z "$recover_candidate" ] || [ -z "$recover_candidate_cli" ] \
    || [ -z "$recover_oid" ] || [ -z "$recover_version" ] \
    || [ -z "$recover_lastdbd_version" ] || [ -z "$recover_lastdb_version" ] \
    || [ -z "$recover_lastdbd_sha256" ] || [ -z "$recover_lastdb_sha256" ] \
    || [ -z "$recover_artifact_digest" ]; then
    det="recover-child-not-exact-v6 child=$CHILD status=${recover_status:-none} state=${recover_state:-none} protocol=${recover_protocol_version:-none}"
    log "$det"
    write_stamp invalid "$KEY" "error" "$det"
    printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=$det"
    exit 3
  fi
  input="$(jq -cn \
    --arg oid "$recover_oid" \
    --arg child "$CHILD" \
    --arg candidate "$recover_candidate" \
    --arg candidate_cli "$recover_candidate_cli" \
    --arg version "$recover_version" \
    --arg lastdbd_version "$recover_lastdbd_version" \
    --arg lastdb_version "$recover_lastdb_version" \
    --arg lastdbd_sha256 "$recover_lastdbd_sha256" \
    --arg lastdb_sha256 "$recover_lastdb_sha256" \
    --arg artifact_digest "$recover_artifact_digest" \
    --arg protocol_version "$recover_protocol_version" \
    '{main_oid:$oid,max_attempts:3,recovery_mode:"verified-live",recovery_child_execution:$child,recovery_candidate:$candidate,recovery_candidate_cli:$candidate_cli,recovery_source_git_oid:$oid,recovery_version:$version,recovery_lastdbd_version:$lastdbd_version,recovery_lastdb_version:$lastdb_version,recovery_lastdbd_sha256:$lastdbd_sha256,recovery_lastdb_sha256:$lastdb_sha256,recovery_candidate_artifact_digest:$artifact_digest,recovery_safe_upgrade_protocol_version:$protocol_version}')"
else
  input="$(OID="${OID:-}" python3 -c 'import json,os; print(json.dumps({"main_oid":os.environ.get("OID") or "","max_attempts":3},separators=(",",":")))')"
fi

log "loom run lastdb-canary-release --key $KEY loom_run_deadline_secs=${DEADLINE_SECS:-default}"
run_log_dir="${ROUTINES_RUN_DIR:-$(dirname "$STAMP")}"
stdout_log="${LAST_STACK_CANARY_LOOM_STDOUT_LOG:-$run_log_dir/canary-loom.stdout.log}"
stderr_log="${LAST_STACK_CANARY_LOOM_STDERR_LOG:-$run_log_dir/canary-loom.stderr.log}"
mkdir -p "$(dirname "$stdout_log")" "$(dirname "$stderr_log")"
set +e
view="$(loom run lastdb-canary-release --key "$KEY" --input "$input" 2>"$stderr_log")"
loom_rc=$?
set -e
printf '%s\n' "$view" > "$stdout_log"
exec_id="$(printf '%s\n' "$view" | awk '/^lx-/{print; exit}')"
status="$(printf '%s\n' "$view" | awk -F': ' '/^status:/{print $2; exit}')"
state="$(printf '%s\n' "$view" | awk -F': ' '/^state:/{print $2; exit}')"
rendered_status="${status:-unknown}"
rendered_state="${state:-unknown}"
det="exec=${exec_id:-none} key=${KEY} status=${rendered_status} state=${rendered_state} loom_rc=${loom_rc} deadline_secs=${DEADLINE_SECS:-default}"
case "$status" in
  succeeded|waiting|parked|running) oc="ok" ;;
  *) oc="error" ;;
esac
[ "$loom_rc" -eq 0 ] || oc="error"
if [ "$oc" = "error" ]; then
  error_line="$(sed -n '1p' "$stderr_log" | tr '\r\n' '  ' | cut -c1-240)"
  if [ -z "$error_line" ]; then
    error_line="$(printf '%s\n' "$view" | awk '/^node .* failed:/{print; exit}' | cut -c1-240)"
  fi
  [ -z "$error_line" ] || det="$det error=$error_line"
fi
case "$status" in
  waiting|parked|running)
    write_active "$KEY" "${exec_id:-}" "$rendered_status" "$rendered_state"
    ;;
esac
write_stamp "$rendered_status" "$KEY" "$oc" "$det"
case "$status" in
  succeeded|failed|cancelled)
    clear_active "$KEY"
    ;;
esac
if [ "$JSON" -eq 1 ]; then
  OC="$oc" DT="$det" KY="$KEY" ST="$rendered_status" EX="${exec_id:-}" DL="${DEADLINE_SECS:-}" python3 -c '
import json, os
print(json.dumps({
  "outcome": os.environ["OC"],
  "detail": os.environ["DT"],
  "engine": "loom",
  "key": os.environ["KY"],
  "status": os.environ["ST"],
  "execution": os.environ["EX"],
  "deadline_secs": os.environ["DL"],
}, separators=(",", ":")))
'
else
  printf 'CANARY_LOOM outcome=%s %s\n' "$oc" "$det"
fi
printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${det}"
[ "$oc" = "error" ] && exit 3
exit 0
