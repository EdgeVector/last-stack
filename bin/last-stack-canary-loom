#!/usr/bin/env bash
# last-stack-canary-loom — tick the lastdb-canary-release loom graph.
# One key per candidate. WAIT parks; this command resumes.
#
#   last-stack-canary-loom [--json] [--quiet] [--dry-run] [--no-heal] [--status]
#   last-stack-canary-loom --start [--oid SHA]
#
# Exit: 0 ran/noop, 2 usage, 3 loom unavailable.
set -euo pipefail

JSON=0
QUIET=0
STATUS=0
DRY=0
HEAL=1
START=0
OID=""
KEY=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --status) STATUS=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --no-heal) HEAL=0; shift ;;
    --heal) HEAL=1; shift ;;
    --start) START=1; shift ;;
    --oid) OID="${2:-}"; shift 2 ;;
    --key) KEY="${2:-}"; shift 2 ;;
    -h|--help)
      echo "last-stack-canary-loom [--json] [--dry-run] [--no-heal] [--start] [--oid SHA] [--key KEY]"
      exit 0
      ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"
STAMP="${LAST_STACK_CANARY_LOOM_STAMP:-$HOME/.last-stack/state/canary-loom.json}"
ACTIVE="${LAST_STACK_CANARY_LOOM_ACTIVE:-$(dirname "$STAMP")/canary-loom-active.json}"

log() { [ "$QUIET" -eq 1 ] || printf 'canary-loom: %s\n' "$*" >&2; }

write_stamp() {
  mkdir -p "$(dirname "$STAMP")"
  ST="$1" KY="${2:-}" OC="${3:-}" DT="${4:-}" LAST_STACK_CANARY_LOOM_STAMP="$STAMP" python3 -c '
import json, os, datetime
p = os.environ["LAST_STACK_CANARY_LOOM_STAMP"]
doc = {
  "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "status": os.environ.get("ST", ""),
  "key": os.environ.get("KY", ""),
  "outcome": os.environ.get("OC", ""),
  "detail": os.environ.get("DT", ""),
  "engine": "loom",
}
tmp = f"{p}.tmp.{os.getpid()}"
open(tmp, "w").write(json.dumps(doc) + "\n")
os.replace(tmp, p)
'
}

write_active() {
  mkdir -p "$(dirname "$ACTIVE")"
  active_tmp="$(mktemp "$(dirname "$ACTIVE")/.canary-loom-active.XXXXXX")"
  jq -cn \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg key "$1" \
    --arg execution "$2" \
    --arg status "$3" \
    --arg state "$4" \
    '{ts:$ts,key:$key,execution:$execution,status:$status,state:$state,engine:"loom"}' \
    >"$active_tmp"
  mv "$active_tmp" "$ACTIVE"
}

clear_active() {
  [ -f "$ACTIVE" ] || return 0
  active_key="$(jq -r '.key // empty' "$ACTIVE" 2>/dev/null || true)"
  [ -z "$active_key" ] || [ "$active_key" = "$1" ] || return 0
  rm -f "$ACTIVE"
}

if [ "$STATUS" -eq 1 ]; then
  LAST_STACK_CANARY_LOOM_STAMP="$STAMP" python3 -c '
import json, os
p = os.environ["LAST_STACK_CANARY_LOOM_STAMP"]
if not os.path.isfile(p):
    print(json.dumps({"ok": False, "missing": True}))
else:
    print(open(p).read().strip())
'
  exit 0
fi

resolve_oid() {
  if [ -n "$OID" ]; then
    printf '%s\n' "$OID"
    return
  fi
  git -C "${HOME}/.cache/edgevector-git/fold.git" rev-parse refs/heads/main 2>/dev/null || true
}

export LAST_STACK_CANARY_LOOM_STAMP="$STAMP"

# The active marker is separate from the last-result stamp. A true idle check
# may replace the last result, but it must never erase the only resume key for
# a native Loom execution.
if [ -z "$KEY" ] && [ -f "$ACTIVE" ]; then
  KEY="$(jq -r '.key // empty' "$ACTIVE" 2>/dev/null || true)"
  if [ -z "$KEY" ]; then
    write_stamp invalid "" "error" "active-marker-invalid"
    if [ "$JSON" -eq 1 ]; then
      jq -cn '{outcome:"error",detail:"active-marker-invalid",engine:"loom",key:"",status:"invalid",execution:""}'
    else
      printf '%s\n' 'CANARY_LOOM outcome=error detail=active-marker-invalid'
    fi
    printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=active-marker-invalid"
    exit 3
  fi
fi
if [ -z "$KEY" ] && [ -f "$STAMP" ]; then
  stamp_status="$(jq -r '.status // empty' "$STAMP" 2>/dev/null || true)"
  case "$stamp_status" in
    succeeded|failed|cancelled|idle|dry-run) ;;
    *) KEY="$(jq -r '.key // empty' "$STAMP" 2>/dev/null || true)" ;;
  esac
fi

if [ "$START" -eq 1 ]; then
  oid="$(resolve_oid)"
  [ -n "$oid" ] || { echo "canary-loom: no main oid" >&2; exit 3; }
  KEY="canary-${oid}"
  OID="$oid"
fi

if [ "$DRY" -eq 1 ]; then
  det="key=${KEY:-} start=${START} oid=${OID:-}"
  oc="noop"
  [ "$START" -eq 1 ] && oc="ok"
  write_stamp dry-run "$KEY" "$oc" "$det"
  if [ "$JSON" -eq 1 ]; then
    printf '{"outcome":"%s","detail":"%s","engine":"loom","key":"%s"}\n' "$oc" "$det" "$KEY"
  else
    printf 'canary-loom dry-run %s\n' "$det"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${det}"
  exit 0
fi

if [ -z "$KEY" ]; then
  write_stamp idle "" "noop" "no-key"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=noop detail=no-key"
  exit 0
fi

if ! command -v loom >/dev/null 2>&1; then
  log "loom not on PATH"
  write_stamp unavailable "$KEY" "error" "loom-missing"
  exit 3
fi
if ! loom ping >/dev/null 2>&1; then
  log "loom ping failed"
  write_stamp unavailable "$KEY" "error" "loom-ping-failed"
  exit 3
fi

exe="$(command -v loom)"
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$exe")"
install_root="$(dirname "$(dirname "$real")")"
defs=""
scripts=""
for cand in "${LOOM_DEFS:-}" "$ROOT/lib/canary-loom" "$install_root/definitions"; do
  [ -n "$cand" ] && [ -f "$cand/lastdb-canary-release.json" ] && defs="$cand" && break
done
for cand in "${LOOM_SCRIPTS:-}" "$ROOT/lib/canary-loom" "$install_root/scripts"; do
  [ -n "$cand" ] && [ -f "$cand/loom-canary-step.sh" ] && scripts="$cand" && break
done
if [ -z "$defs" ] || [ -z "$scripts" ] || [ ! -f "$defs/lastdb-safe-upgrade.json" ]; then
  log "lastdb-canary-release definitions/scripts not found"
  write_stamp unavailable "$KEY" "error" "defs-missing"
  exit 3
fi
export LOOM_SCRIPTS="$scripts"
if [ "$HEAL" -eq 1 ]; then
  export LOOM_CANARY_LIVE=1
  export LOOM_LIVE=1
  export LOOM_CANARY_RED_LIVE=1
else
  unset LOOM_CANARY_LIVE LOOM_LIVE LOOM_CANARY_RED_LIVE || true
fi

# Publish the child first. The parent CALL_A node resolves the named definition
# from LastDB, so publishing only the parent can leave an older cutover graph
# active after the local artifact changes.
loom validate "$defs/lastdb-safe-upgrade.json" >/dev/null
loom validate "$defs/lastdb-canary-release.json" >/dev/null
loom publish "$defs/lastdb-safe-upgrade.json" >/dev/null
loom publish "$defs/lastdb-canary-release.json" >/dev/null
input="$(OID="${OID:-}" python3 -c 'import json,os; print(json.dumps({"main_oid":os.environ.get("OID") or "","max_attempts":3},separators=(",",":")))')"

log "loom run lastdb-canary-release --key $KEY"
run_log_dir="${ROUTINES_RUN_DIR:-$(dirname "$STAMP")}"
stdout_log="${LAST_STACK_CANARY_LOOM_STDOUT_LOG:-$run_log_dir/canary-loom.stdout.log}"
stderr_log="${LAST_STACK_CANARY_LOOM_STDERR_LOG:-$run_log_dir/canary-loom.stderr.log}"
mkdir -p "$(dirname "$stdout_log")" "$(dirname "$stderr_log")"
set +e
view="$(loom run lastdb-canary-release --key "$KEY" --input "$input" 2>"$stderr_log")"
loom_rc=$?
set -e
printf '%s\n' "$view" > "$stdout_log"
exec_id="$(printf '%s\n' "$view" | awk '/^lx-/{print; exit}')"
status="$(printf '%s\n' "$view" | awk -F': ' '/^status:/{print $2; exit}')"
state="$(printf '%s\n' "$view" | awk -F': ' '/^state:/{print $2; exit}')"
rendered_status="${status:-unknown}"
rendered_state="${state:-unknown}"
det="exec=${exec_id:-none} key=${KEY} status=${rendered_status} state=${rendered_state} loom_rc=${loom_rc}"
case "$status" in
  succeeded|waiting|parked|running) oc="ok" ;;
  *) oc="error" ;;
esac
[ "$loom_rc" -eq 0 ] || oc="error"
if [ "$oc" = "error" ]; then
  error_line="$(sed -n '1p' "$stderr_log" | tr '\r\n' '  ' | cut -c1-240)"
  if [ -z "$error_line" ]; then
    error_line="$(printf '%s\n' "$view" | awk '/^node .* failed:/{print; exit}' | cut -c1-240)"
  fi
  [ -z "$error_line" ] || det="$det error=$error_line"
fi
case "$status" in
  waiting|parked|running)
    write_active "$KEY" "${exec_id:-}" "$rendered_status" "$rendered_state"
    ;;
esac
write_stamp "$rendered_status" "$KEY" "$oc" "$det"
case "$status" in
  succeeded|failed|cancelled)
    clear_active "$KEY"
    ;;
esac
if [ "$JSON" -eq 1 ]; then
  OC="$oc" DT="$det" KY="$KEY" ST="$rendered_status" EX="${exec_id:-}" python3 -c '
import json, os
print(json.dumps({
  "outcome": os.environ["OC"],
  "detail": os.environ["DT"],
  "engine": "loom",
  "key": os.environ["KY"],
  "status": os.environ["ST"],
  "execution": os.environ["EX"],
}, separators=(",", ":")))
'
else
  printf 'CANARY_LOOM outcome=%s %s\n' "$oc" "$det"
fi
printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${det}"
[ "$oc" = "error" ] && exit 3
exit 0
