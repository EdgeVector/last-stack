#!/usr/bin/env bash
# Install/update the daily fleet-performance registry entry.
# Emits difficulty-only routing (no harness/model/pin) so host-track refresh
# does not re-pin the live matrix fleet.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
# shellcheck source=last-stack-routines-registry-env
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/last-stack-routines-registry-env"
last_stack_registry_paths_init

ROUTINES_HOME="${ROUTINES_HOME:-$HOME/.routines}"
REGISTRY_DIR="$ROUTINES_HOME/registry"
PROMPT_PATH="$(last_stack_registry_prompt_path fleet-performance.md "$ROOT/routines/fleet-performance.md")"
ID="last-stack-fleet-performance"
DRY_RUN=0
FORCE_DEFAULTS=0
PROMPT_PATH_SET=0

usage() {
  cat <<'USAGE'
last-stack-fleet-performance-routine [options]

Writes the routines registry entry for the daily fleet-performance auditor.
Re-running is idempotent and preserves live rrule/difficulty/status unless
--force-defaults is passed.

Options:
  --registry-dir <p>  registry directory (default: $ROUTINES_HOME/registry)
  --prompt-path <p>   prompt path (default: stable last-stack)
  --id <id>           automation id (default: last-stack-fleet-performance)
  --force-defaults    replace live rrule/difficulty/status with compiled defaults
  --dry-run           print target path and contents without writing
  -h, --help          show this help
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --registry-dir) REGISTRY_DIR="$2"; shift 2 ;;
    --registry-dir=*) REGISTRY_DIR="${1#*=}"; shift ;;
    --prompt-path) PROMPT_PATH="$2"; PROMPT_PATH_SET=1; shift 2 ;;
    --prompt-path=*) PROMPT_PATH="${1#*=}"; PROMPT_PATH_SET=1; shift ;;
    --id) ID="$2"; shift 2 ;;
    --id=*) ID="${1#*=}"; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --force-defaults) FORCE_DEFAULTS=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$ID" in
  ""|*/*)
    echo "unsafe automation id: $ID" >&2
    exit 2
    ;;
esac

if [ ! -r "$PROMPT_PATH" ]; then
  echo "prompt path is not readable: $PROMPT_PATH" >&2
  exit 66
fi

if [ "$DRY_RUN" -eq 0 ]; then
  last_stack_registry_assert_safe_write "$REGISTRY_DIR" "$PROMPT_PATH" "$REG_CWD" \
    || exit 3
fi

path="$REGISTRY_DIR/$ID.toml"
DEFAULT_DIFFICULTY="normal"
DEFAULT_RRULE="FREQ=DAILY;BYHOUR=7;BYMINUTE=10;BYSECOND=0"
DEFAULT_STATUS="active"
DIFFICULTY="$DEFAULT_DIFFICULTY"
RRULE="$DEFAULT_RRULE"
STATUS="$DEFAULT_STATUS"

if [ "$FORCE_DEFAULTS" -eq 0 ] && [ -f "$path" ]; then
  existing="$(last_stack_registry_toml_string "$path" difficulty)"
  [ -z "$existing" ] || DIFFICULTY="$existing"
  existing="$(last_stack_registry_toml_string "$path" rrule)"
  [ -z "$existing" ] || RRULE="$existing"
  existing="$(last_stack_registry_toml_string "$path" status)"
  [ -z "$existing" ] || STATUS="$existing"
fi

workspace_cwd="${LAST_STACK_WORKSPACE:-$REG_CWD}"

body=$(cat <<EOF
# Daily fleet-performance auditor: measure outcomes, apply a small cadence /
# difficulty / status slice, or add one missing routine. Matrix-routed.
id = "$ID"
difficulty = "$DIFFICULTY"
effort = "medium"
rrule = "$RRULE"
cwd = "$workspace_cwd"
status = "$STATUS"
timeout_min = 30
prompt_path = "$PROMPT_PATH"
heartbeat_slug = "routine-heartbeats"
group = "ops"
EOF
)

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s\n' "--- $path"
  printf '%s\n' "$body"
  exit 0
fi

mkdir -p "$REGISTRY_DIR"
tmp="$(mktemp "${TMPDIR:-/tmp}/last-stack-fleet-performance.XXXXXX")"
printf '%s\n' "$body" >"$tmp"
if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
  rm -f "$tmp"
  printf 'unchanged %s\n' "$path"
else
  mv "$tmp" "$path"
  printf 'wrote %s\n' "$path"
fi
printf 'configured %s in %s\n' "$ID" "$REGISTRY_DIR"
