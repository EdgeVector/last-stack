#!/usr/bin/env python3
"""Fail closed before a pipeline-health PR mutation; never cache an allow result.

Venue (2026-09-30): every EdgeVector repo except `lastgit` is on GitHub, read
through `gh api` (PR row, `ci-required` check runs; a queued or in-progress
check run is an active task). Only the `lastgit` repo stays on Forgejo (combined
status + actions/tasks through last-stack-forge-api). `--venue auto` (default)
asks last-stack-pr-venue and falls back to github.
"""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from urllib.parse import urlparse

ACTIVE = ("unknown", "waiting", "blocked", "running")
TERMINAL = {"success", "failure", "error", "cancelled", "skipped"}
PAGE_SIZE = 100
MAX_PAGES = 5
BUDGET_SECONDS = 60


class Denied(Exception):
    pass


# A deny is correct, but a bare reason leaves the caller with no next step and
# it retries forever (papercut-pipeline-pr-guard-unbound-green-pr, lastgit#622).
# `recovery` is advice only: it never changes the verdict or the exit code.
RECOVERY = {
    "unbound-card": (
        "No Kind:pr card in `doing`, with an empty assignee, is bound to this PR "
        "(repo, kanban/<slug> branch, pr_url). This guard protects an active owner and "
        "will always deny an unbound PR: do not retry it. If the PR is an intentionally "
        "unbound green fix (for example a papercut-resolver branch), its producer merges it: "
        "`gh pr merge <n> -R <owner/repo> --auto --squash` (GitHub), or for the lastgit repo on Forgejo "
        "last-stack-pipeline-forge-pr-ledger merge-green --repo <owner/repo> --pr <n> --arm --apply "
        "(it runs its own Situations merge-pr preflight). Otherwise bind the card to the PR, or leave "
        "the PR and record the deny in the papercut."
    ),
    "owned-pr": "An owner holds the card. Leave the PR to its owner; do not clear the assignee.",
}


class Guard:
    def __init__(self, args):
        self.args = args
        self.deadline = time.monotonic() + BUDGET_SECONDS
        here = Path(__file__).resolve()
        self.venue = args.venue if args.venue != "auto" else self.route(here)
        if self.venue == "github":
            self.api = [os.environ.get("LAST_STACK_GH_BIN", "gh"), "api"]
        else:
            self.api = [str(here.with_name("last-stack-forge-api"))]
        self.prefix = f"repos/{args.repo}"

    def route(self, here):
        binary = os.environ.get("LAST_STACK_PR_VENUE_BIN") or str(here.with_name("last-stack-pr-venue"))
        try:
            out = subprocess.run([binary, self.args.repo], capture_output=True, text=True, timeout=10).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            out = ""
        return "forgejo" if out == "forgejo" else "github"

    def read(self, command):
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise Denied("read-budget")
        try:
            result = subprocess.run(command, capture_output=True, timeout=min(10, remaining), check=True)
            return json.loads(result.stdout)
        except (OSError, subprocess.SubprocessError, ValueError):
            # Do not echo API bodies, stderr, board content, or credentials.
            raise Denied("unreadable-evidence") from None

    def card(self, slug):
        # kanban show exits 1 with empty stdout for a missing slug. That is a
        # distinguishable "no card bound to this branch" condition, not a
        # read/exec failure, so it must not collapse into unreadable-evidence.
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise Denied("read-budget")
        try:
            result = subprocess.run(["kanban", "show", slug, "--json"], capture_output=True,
                                     timeout=min(10, remaining))
        except (OSError, subprocess.SubprocessError):
            raise Denied("unreadable-evidence") from None
        if result.returncode == 0:
            try:
                return json.loads(result.stdout)
            except ValueError:
                raise Denied("unreadable-evidence") from None
        if result.returncode == 1 and not result.stdout.strip():
            raise Denied("unbound-card")
        raise Denied("unreadable-evidence")

    def pr(self):
        pr = self.read([*self.api, f"{self.prefix}/pulls/{self.args.pr}"])
        if not isinstance(pr, dict) or pr.get("number") != self.args.pr:
            raise Denied("invalid-pr")
        if pr.get("state") != "open" or pr.get("merged") is not False or pr.get("draft") is not False:
            raise Denied("pr-not-open-ready")
        head = pr.get("head")
        if not isinstance(head, dict) or head.get("sha") != self.args.expected_head:
            raise Denied("head-changed")
        if not isinstance(head.get("ref"), str) or not head["ref"].startswith("kanban/"):
            raise Denied("unbound-card")
        return head["ref"]

    def owner(self, branch):
        slug = branch.removeprefix("kanban/")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", slug):
            raise Denied("unbound-card")
        card = self.card(slug)
        if not isinstance(card, dict) or card.get("slug") != slug or card.get("repo") != self.args.repo:
            raise Denied("unbound-card")
        if card.get("branch") != branch or card.get("kind") != "pr":
            raise Denied("unbound-card")
        link = card.get("pr_url")
        if not isinstance(link, str):
            raise Denied("unbound-card")
        try:
            path = urlparse(link).path.rstrip("/")
        except ValueError:
            raise Denied("unbound-card") from None
        want = f"/{self.args.repo}/pull/{self.args.pr}" if self.venue == "github" else f"/{self.args.repo}/pulls/{self.args.pr}"
        if path != want:
            raise Denied("unbound-card")
        if not isinstance(card.get("assignee"), str) or not isinstance(card.get("column"), str):
            raise Denied("unreadable-owner")
        # An owner must release the card explicitly. Age/another checkout is not a release.
        if card["assignee"].strip():
            raise Denied("owned-pr")
        if card["column"] != "doing" or card.get("blocked") is not False:
            raise Denied("card-not-active")

    def statuses(self):
        if self.venue == "github":
            return self.check_runs()
        data = self.read([*self.api, f"{self.prefix}/commits/{self.args.expected_head}/status"])
        if not isinstance(data, dict) or not isinstance(data.get("statuses"), list):
            raise Denied("unreadable-status")
        rows = data["statuses"]
        if type(data.get("total_count")) is not int or data["total_count"] != len(rows):
            raise Denied("incomplete-status")
        if data.get("state") not in TERMINAL and not (data.get("state") == "" and not rows):
            raise Denied("active-or-unknown-status")
        for row in rows:
            if not isinstance(row, dict) or row.get("status") not in TERMINAL:
                raise Denied("active-or-unknown-status")

    def check_runs(self):
        # GitHub: one read answers both "terminal status" and "active task". A
        # check run that has not completed is an active run on this exact head.
        data = self.read([*self.api, f"{self.prefix}/commits/{self.args.expected_head}/check-runs?per_page=100"])
        if not isinstance(data, dict) or not isinstance(data.get("check_runs"), list):
            raise Denied("unreadable-status")
        rows = data["check_runs"]
        if type(data.get("total_count")) is not int or data["total_count"] != len(rows):
            raise Denied("incomplete-status")
        for row in rows:
            if not isinstance(row, dict):
                raise Denied("unreadable-status")
            if row.get("status") != "completed":
                raise Denied("active-head-task")

    def tasks(self):
        if self.venue == "github":
            return
        # Forgejo's finite nonterminal status set. Filtering avoids walking task history.
        # Every response must honor its filter and complete within the page/read budgets.
        for state in ACTIVE:
            seen = set()
            total = None
            for page in range(1, MAX_PAGES + 1):
                data = self.read([*self.api, f"{self.prefix}/actions/tasks?status={state}&page={page}&limit={PAGE_SIZE}"])
                if not isinstance(data, dict) or not isinstance(data.get("workflow_runs"), list):
                    raise Denied("unreadable-tasks")
                rows = data["workflow_runs"]
                count = data.get("total_count")
                if type(count) is not int or count < 0 or len(rows) > PAGE_SIZE:
                    raise Denied("unreadable-tasks")
                if total is not None and total != count:
                    raise Denied("tasks-changed")
                total = count
                for row in rows:
                    if not isinstance(row, dict) or type(row.get("id")) is not int:
                        raise Denied("unreadable-tasks")
                    if row.get("status") != state or not isinstance(row.get("head_sha"), str):
                        raise Denied("unreadable-tasks")
                    if not re.fullmatch(r"[0-9a-f]{40}", row["head_sha"]):
                        raise Denied("unreadable-tasks")
                    if row["id"] in seen:
                        raise Denied("incomplete-tasks")
                    seen.add(row["id"])
                    if row["head_sha"] == self.args.expected_head:
                        raise Denied("active-head-task")
                if len(seen) == total:
                    break
                if not rows or len(seen) > total:
                    raise Denied("incomplete-tasks")
            else:
                raise Denied("task-page-budget")

    def check(self):
        branch = self.pr()
        self.owner(branch)
        self.statuses()
        self.tasks()
        # A same-head owner retry does not change a Git lease. Re-read the owner and
        # statuses after task reads, then the head, immediately before the command.
        self.owner(branch)
        self.statuses()
        if self.pr() != branch:
            raise Denied("branch-changed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--pr", required=True, type=int)
    parser.add_argument("--expected-head", required=True)
    parser.add_argument("--venue", choices=("auto", "github", "forgejo"), default="auto")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="-- COMMAND [ARG ...]; omit for a read-only probe")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.repo) or args.pr <= 0:
        parser.error("invalid repo or PR")
    if not re.fullmatch(r"[0-9a-f]{40}", args.expected_head):
        parser.error("expected-head must be a full commit SHA")
    command = args.command
    if command[:1] == ["--"]:
        command = command[1:]
    try:
        Guard(args).check()
    except Denied as error:
        answer = {"version": 1, "verdict": "deny", "reason": str(error)}
        if str(error) in RECOVERY:
            answer["recovery"] = RECOVERY[str(error)]
        print(json.dumps(answer))
        return 3
    print(json.dumps({"version": 1, "verdict": "allow", "head": args.expected_head}), flush=True)
    if command:
        os.execvp(command[0], command)
    return 0


if __name__ == "__main__":
    sys.exit(main())
