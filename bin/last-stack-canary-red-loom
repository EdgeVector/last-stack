#!/usr/bin/env bash
# last-stack-canary-red-loom — when a LastDB canary goes RED, run a loom graph
# that investigates, lands a fix, and retries the upgrade up to 3 times.
#
#   last-stack-canary-red-loom [--json] [--quiet] [--dry-run] [--no-heal] [--status]
#                             [--lane-stale-hours H]
#   last-stack-canary-red-loom --exec exec_… [--key canary-red-exec_…]
#
# Same-key resume: a repeated --key returns the existing loom execution.
# Default live heal. --no-heal runs stand-in nodes (no live agent, no retry).
#
# Exit:
#   0  ran (including idle noop / in-flight resume)
#   2  usage
#   3  loom unavailable, defs missing, or bounded run with no progress
set -euo pipefail

JSON=0
QUIET=0
STATUS=0
DRY=0
HEAL=1
KEY=""
EXEC_ID=""
LOOKBACK_H="${LAST_STACK_CANARY_RED_LOOKBACK_HOURS:-12}"
# A live lane row legitimately parks for hours (a canary soak waits 24 h), so
# total age says nothing. `updated_at` does: loom touches it every time the
# execution advances or re-checks, and the 2026-08-31 soak
# lx-20260830T140407.992-49336-1 sat in SOAK_WAIT two days with a 2.5 h-old
# `updated_at`. The 2026-09-02 wedge lx-20260902T172952.304-31149-1 stopped at
# `updated_at` 22:25:22Z in state DECIDE_BUILD and reported a healthy hourly
# `noop idle reason=lane_busy` for the next 17 h. So the bar is how long the
# row has failed to advance, not how long it has existed. 6 h clears a normal
# soak re-check (~2.5 h observed) with margin; the card's suggested 2 h would
# page on every healthy soak.
LANE_STALE_H="${LAST_STACK_CANARY_RED_LANE_STALE_HOURS:-6}"
# Same exec id in listing_stale across this many hourly fires expires the
# resume key. 2 = first fire drops the key, second fire pages once.
LISTING_STALE_MAX_HITS="${LAST_STACK_CANARY_RED_LISTING_STALE_HITS:-2}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --status) STATUS=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --no-heal) HEAL=0; shift ;;
    --heal) HEAL=1; shift ;;
    --exec) EXEC_ID="${2:-}"; shift 2 ;;
    --exec=*) EXEC_ID="${1#*=}"; shift ;;
    --key) KEY="${2:-}"; shift 2 ;;
    --key=*) KEY="${1#*=}"; shift ;;
    --lookback-hours) LOOKBACK_H="${2:-}"; shift 2 ;;
    --lane-stale-hours) LANE_STALE_H="${2:-}"; shift 2 ;;
    --lane-stale-hours=*) LANE_STALE_H="${1#*=}"; shift ;;
    -h|--help)
      echo "last-stack-canary-red-loom [--json] [--quiet] [--dry-run] [--no-heal] [--status] [--exec ID] [--key KEY] [--lane-stale-hours H]"
      exit 0
      ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"
STAMP="${LAST_STACK_CANARY_RED_STAMP:-$HOME/.last-stack/state/canary-red-loom.json}"

log() { [ "$QUIET" -eq 1 ] || printf 'canary-red-loom: %s\n' "$*" >&2; }

write_stamp() {
  mkdir -p "$(dirname "$STAMP")"
  ST="$1" EX="${2:-}" DT="${3:-}" KY="${4:-}" OC="${5:-}" \
  LSTALE_EXEC="${6:-}" LSTALE_HITS="${7:-}" LAST_STACK_CANARY_RED_STAMP="$STAMP" python3 -c '
import json, os, datetime
p = os.environ["LAST_STACK_CANARY_RED_STAMP"]
doc = {
  "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "status": os.environ.get("ST", ""),
  "exec_id": os.environ.get("EX", ""),
  "detail": os.environ.get("DT", ""),
  "key": os.environ.get("KY", ""),
  "outcome": os.environ.get("OC", ""),
  "engine": "loom",
}
lstale = os.environ.get("LSTALE_EXEC") or ""
if lstale:
    doc["listing_stale_exec"] = lstale
    try:
        doc["listing_stale_hits"] = int(os.environ.get("LSTALE_HITS") or "1")
    except ValueError:
        doc["listing_stale_hits"] = 1
open(p, "w").write(json.dumps(doc) + "\n")
'
}

stamp_field() {
  LAST_STACK_CANARY_RED_STAMP="$STAMP" STAMP_FIELD="$1" python3 -c '
import json, os
p = os.environ["LAST_STACK_CANARY_RED_STAMP"]
f = os.environ["STAMP_FIELD"]
try:
    d = json.load(open(p))
except Exception:
    d = {}
v = d.get(f)
if v is None or v is False:
    print("")
else:
    print(v)
'
}

# listing_stale_apply <picked_id>
# Always drops the resume key. Tracks consecutive listing_stale hits for the
# same exec in the stamp (not as exec_id/key). Sets LS_OC / LS_DETAIL / LS_EXIT
# / LS_TRACK_EXEC / LS_HITS for the caller.
listing_stale_apply() {
  local picked="${1:-}"
  local prev_exec prev_hits prev_outcome hits max_hits
  prev_exec="$(stamp_field listing_stale_exec)"
  [ -n "$prev_exec" ] || prev_exec="$(stamp_field exec_id)"
  prev_hits="$(stamp_field listing_stale_hits)"
  prev_outcome="$(stamp_field outcome)"
  case "$prev_hits" in
    ''|*[!0-9]*) prev_hits=0 ;;
  esac
  max_hits="$LISTING_STALE_MAX_HITS"
  case "$max_hits" in
    ''|*[!0-9]*) max_hits=2 ;;
  esac
  [ "$max_hits" -ge 1 ] || max_hits=2
  hits=1
  if [ -n "$picked" ] && [ "$picked" = "$prev_exec" ]; then
    hits=$((prev_hits + 1))
  fi
  LS_TRACK_EXEC="$picked"
  LS_HITS="$hits"
  # Resume key stays empty on every listing_stale tick.
  if [ "$hits" -ge "$max_hits" ] && [ "$prev_outcome" != "error" ]; then
    LS_OC="error"
    LS_DETAIL="listing_stale_expired hits=${hits} dropped=${picked:-none}"
    LS_EXIT=3
  else
    LS_OC="noop"
    LS_DETAIL="idle reason=listing_stale exec="
    LS_EXIT=0
  fi
}

print_status() {
  LAST_STACK_CANARY_RED_STAMP="$STAMP" python3 -c '
import json, os, datetime
p = os.environ["LAST_STACK_CANARY_RED_STAMP"]
if not os.path.isfile(p):
    print(json.dumps({"ok": False, "missing": True, "status": "", "ageH": 99.0}))
    raise SystemExit(0)
try:
    d = json.load(open(p))
except Exception:
    print(json.dumps({"ok": False, "missing": True, "status": "parse", "ageH": 99.0}))
    raise SystemExit(0)
ts = d.get("ts") or ""
try:
    t = datetime.datetime.strptime(ts.replace("Z",""), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    age_h = (datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() / 3600.0
except Exception:
    age_h = 99.0
status = str(d.get("status") or "")
print(json.dumps({
    "ok": status in ("succeeded", "running", "idle"),
    "missing": False,
    "status": status,
    "ageH": round(age_h, 4),
    "exec_id": d.get("exec_id") or "",
    "detail": d.get("detail") or "",
    "key": d.get("key") or "",
    "outcome": d.get("outcome") or "",
}))
'
}

if [ "$STATUS" -eq 1 ]; then
  print_status
  exit 0
fi

# The lane is orchestrated by loom, so the gate must list loom's own
# executions. `sm` holds a retired copy of the lane that stopped issuing ids on
# 2026-08-26; reading it reports a quiet lane while loom is red
# (papercut-canary-red-heal-lists-retired-sm-not-loom).
CANARY_LANE_ORCHESTRATOR="loom"
CANARY_LANE_DEFINITION="${LAST_STACK_CANARY_DEFINITION:-lastdb-canary-release}"
CANARY_RED_HEAL_DEFINITION="${LAST_STACK_CANARY_RED_HEAL_DEFINITION:-canary-red-heal}"
CANARY_RED_KEY_PREFIX="canary-red-"
LIST_LIMIT="${LAST_STACK_CANARY_RED_LIST_LIMIT:-25}"
case "$LIST_LIMIT" in
  ''|*[!0-9]*) LIST_LIMIT=25 ;;
esac
[ "$LIST_LIMIT" -ge 1 ] || LIST_LIMIT=25

list_executions() {
  if [ -n "${CANARY_RED_LOOM_LIST_FILE:-}" ]; then
    cat "$CANARY_RED_LOOM_LIST_FILE"
    return 0
  fi
  # Probe wider than the verdict window: an execution can start before the
  # lookback and fail inside it. The age test still runs on updated_at.
  #
  # The floor must clear a whole SOAK. The lister windows on the START stamp
  # embedded in the id, not on updated_at, so a 24 h floor drops a canary soak
  # at exactly the moment it completes its 24 h park. On 2026-08-31T16:05Z
  # `--window-hours 24` returned 8 rows without the live SOAK_WAIT execution
  # lx-20260830T140407.992-49336-1 (updated 13:34:44Z, 2.5 h old); the same
  # call at 96 h returned it. An invisible soak is worse than a masked red:
  # the `waiting` guard below never fires, so the gate heals underneath a live
  # lane. Cover the soak (24 h) plus a full verdict window.
  window_h="$(awk -v h="$LOOKBACK_H" 'BEGIN { w = h * 2; if (w < 48) w = 48; printf "%d", w }')"
  if [ -n "$EXEC_ID" ]; then
    "$ROOT/bin/last-stack-loom-exec-latest" --exec "$EXEC_ID"
  else
    # --limit defaults to 1 in the lister, and one row is not a window: any
    # newer cancelled/succeeded execution then masks every older FAILED one
    # (papercut-canary-red-heal-newest-execution-masks-older-failed).
    "$ROOT/bin/last-stack-loom-exec-latest" \
      --definition "$CANARY_LANE_DEFINITION" --window-hours "$window_h" \
      --limit "$LIST_LIMIT"
  fi
}

# The heal graph's executions, keyed by `canary-red-<lane exec id>`. Read only
# when the lane is actually red, so a quiet tick still costs one listing.
list_heal_executions() {
  if [ -n "${CANARY_RED_LOOM_HEAL_LIST_FILE:-}" ]; then
    cat "$CANARY_RED_LOOM_HEAL_LIST_FILE"
    return 0
  fi
  # Same floor as the lane listing: a heal keyed to a soak-era execution must
  # stay visible for as long as that execution can still be parked.
  window_h="$(awk -v h="$LOOKBACK_H" 'BEGIN { w = h * 2; if (w < 48) w = 48; printf "%d", w }')"
  "$ROOT/bin/last-stack-loom-exec-latest" \
    --definition "$CANARY_RED_HEAL_DEFINITION" --window-hours "$window_h" \
    --limit "$LIST_LIMIT"
}

pick_failed() {
  LOOKBACK_H="$LOOKBACK_H" LANE_STALE_H="$LANE_STALE_H" EXEC_ID="$EXEC_ID" \
  LOOM_ROWS_FILE="$1" \
  LOOM_HEAL_ROWS_FILE="${2:-}" KEY_PREFIX="$CANARY_RED_KEY_PREFIX" python3 -c '
import json, os, sys
from datetime import datetime, timezone, timedelta

want = (os.environ.get("EXEC_ID") or "").strip()
key_prefix = os.environ.get("KEY_PREFIX") or "canary-red-"
lookback_h = os.environ.get("LOOKBACK_H") or "12"
try:
    lookback_h = float(lookback_h)
except ValueError:
    lookback_h = 12.0
lane_stale_h = os.environ.get("LANE_STALE_H") or "6"
try:
    lane_stale_h = float(lane_stale_h)
except ValueError:
    lane_stale_h = 6.0
if lane_stale_h <= 0:
    lane_stale_h = 6.0

path = os.environ.get("LOOM_ROWS_FILE") or ""
try:
    with open(path) as fh:
        rows = json.load(fh)
except Exception as e:
    print(json.dumps({"ok": False, "reason": "listing_unreadable", "error": str(e)}))
    raise SystemExit(3)
if not isinstance(rows, list):
    rows = []

# Heal executions already ended for these keys. A red whose heal is terminal
# needs a new key, not another hourly launch under the old one
# (papercut-canary-red-heal-failed-key-never-rotates owns that rotation).
TERMINAL = ("succeeded", "failed", "cancelled")
healed_keys = set()
heal_path = os.environ.get("LOOM_HEAL_ROWS_FILE") or ""
if heal_path:
    try:
        with open(heal_path) as fh:
            heal_rows = json.load(fh)
    except Exception:
        heal_rows = []
    if isinstance(heal_rows, list):
        for r in heal_rows:
            if not isinstance(r, dict):
                continue
            if str(r.get("status") or "") in TERMINAL:
                k = str(r.get("idempotency_key") or "")
                if k:
                    healed_keys.add(k)

def parse_ts(s):
    s = str(s or "").replace("Z", "")
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(s, fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            continue
    return None

now = datetime.now(timezone.utc)
cutoff = now - timedelta(hours=lookback_h)
parsed = []
for r in rows:
    if not isinstance(r, dict):
        continue
    rid = str(r.get("id") or r.get("exec_id") or "")
    status = str(r.get("status") or "")
    ts = parse_ts(r.get("updated_at") or r.get("updatedAt") or "")
    parsed.append((ts or datetime.fromtimestamp(0, tz=timezone.utc), rid, status, r))
parsed.sort(key=lambda t: t[0], reverse=True)

if want:
    hit = next((r for _, rid, _, r in parsed if rid == want), None)
    if hit is None:
        print(json.dumps({"ok": True, "idle": True, "reason": "exec_not_listed", "exec_id": want}))
        raise SystemExit(0)
    print(json.dumps({"ok": True, "idle": False, "exec_id": want, "status": hit.get("status"), "state": hit.get("state")}))
    raise SystemExit(0)

# No lastdb-canary-release row inside the verdict window is a quiet lane.
# Paging `error` for listing_stale every hour (2026-09-02 retro) is worse
# than idle: the listed exec already aged out. A broken lister still fails
# at list_executions (loom-list-failed). A RED that is actually in the
# window still heals or alarms below.
if not parsed:
    print(json.dumps({
        "ok": True,
        "idle": True,
        "reason": "listing_stale",
        "lookback_hours": lookback_h,
        "drop_key": True,
    }))
    raise SystemExit(0)

newest = parsed[0][3]
nid = str(newest.get("id") or newest.get("exec_id") or "")
nstatus = str(newest.get("status") or "")
nts = parsed[0][0]
if nts < cutoff:
    print(json.dumps({
        "ok": True,
        "idle": True,
        "reason": "listing_stale",
        "exec_id": nid,
        "updated_at": newest.get("updated_at") or newest.get("updatedAt") or "",
        "lookback_hours": lookback_h,
        "drop_key": True,
    }))
    raise SystemExit(0)
# The newest row does not have to be the failed one. Pick every FAILED
# execution inside the window; a later cancelled or succeeded row no longer
# masks them.
failed = [(ts, rid, r) for ts, rid, status, r in parsed
          if status == "failed" and ts >= cutoff]

# A live newest row still stops the heal — starting a retry underneath a
# running execution would fight it. It must NOT also hide the reds behind it.
# A canary soak sits `waiting` for a full 24 h, and on 2026-08-31 four FAILED
# canary releases idled behind one soak, reported hourly as a healthy `noop`.
# The guard stays; the silence does not.
if nstatus in ("running", "waiting"):
    # How long the live row has failed to advance. A wedged execution holds
    # `running` forever, so an unbounded `lane_busy` noop is how one stuck
    # exec blocked the lane for 20 h
    # (papercut-canary-red-heal-fifth-consecutive-day-same-class-20260903).
    lane_age_h = (now - nts).total_seconds() / 3600.0
    lane_stale = lane_age_h >= lane_stale_h
    out = {"ok": True, "idle": True, "reason": "lane_busy",
           "exec_id": nid, "status": nstatus, "state": newest.get("state") or "",
           "updated_at": newest.get("updated_at") or newest.get("updatedAt") or "",
           "lane_age_hours": round(lane_age_h, 2),
           "lane_stale_hours": lane_stale_h,
           "lane_stale": lane_stale}
    unhealed = [rid for _, rid, _ in failed
                if rid != nid and (key_prefix + rid) not in healed_keys]
    if failed and not heal_path:
        # healed_keys is unknown on the first pass. Ask the caller for the
        # heal listing before calling these reds unhealed.
        out["needs_heal_listing"] = True
        out["failed_in_window"] = len(failed)
    elif unhealed:
        out["reason"] = "lane_busy_masking_reds"
        out["masked"] = len(unhealed)
        out["masked_ids"] = unhealed
        out["oldest_failed"] = unhealed[-1]
    elif lane_stale:
        # No masked red to name, and the lane itself has not moved. Escalate
        # instead of another healthy-looking hourly noop.
        out["reason"] = "lane_stale"
    print(json.dumps(out))
    raise SystemExit(0)
if not failed:
    print(json.dumps({"ok": True, "idle": True, "reason": "no_failed_in_window",
                      "exec_id": nid, "status": nstatus, "scanned": len(parsed)}))
    raise SystemExit(0)

skipped = []
for ts, rid, r in failed:
    if (key_prefix + rid) in healed_keys:
        skipped.append(rid)
        continue
    print(json.dumps({
        "ok": True,
        "idle": False,
        "exec_id": rid,
        "status": "failed",
        "state": r.get("state"),
        "updatedAt": r.get("updated_at") or r.get("updatedAt") or "",
        "candidates": len(failed),
        "skipped_healed": skipped,
    }))
    raise SystemExit(0)

# Every red in the window already had its heal run to a terminal state. Say so
# instead of relaunching a spent key every hour.
print(json.dumps({"ok": True, "idle": True, "reason": "heal_already_terminal",
                  "exec_id": failed[0][1], "status": "failed",
                  "skipped_healed": skipped}))
raise SystemExit(0)
'
}

json_field() {
  printf '%s\n' "$2" | JSON_FIELD="$1" python3 -c '
import json, os, sys
d = json.load(sys.stdin)
v = d.get(os.environ["JSON_FIELD"])
if v is True:
    print("1")
elif v is False or v is None:
    print("")
else:
    print(v)
'
}

rows_file="$(mktemp "${TMPDIR:-/tmp}/canary-red-rows.XXXXXX")"
heal_rows_file="$(mktemp "${TMPDIR:-/tmp}/canary-red-heal-rows.XXXXXX")"
trap 'rm -f "$rows_file" "$heal_rows_file"' EXIT

if ! list_executions >"$rows_file" 2>/dev/null; then
  log "$CANARY_LANE_ORCHESTRATOR execution listing failed"
  write_stamp unavailable "" "loom-list-failed" "${KEY:-}" "error"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=loom-list-failed"
  exit 3
fi

picked_rc=0
picked="$(pick_failed "$rows_file")" || picked_rc=$?

# Second pass only when the first found a red. The heal listing is one more
# loom read, and a quiet lane must not pay for it every tick.
# A busy lane that is masking reds also needs the heal listing: only that
# listing says whether those reds are already healed.
picked_needs_heal="$(json_field needs_heal_listing "$picked")"
if [ -n "$picked" ] && [ "$(json_field ok "$picked")" = "1" ] && [ -z "$EXEC_ID" ] \
   && { [ -z "$(json_field idle "$picked")" ] || [ "$picked_needs_heal" = "1" ]; }; then
  if list_heal_executions >"$heal_rows_file" 2>/dev/null; then
    picked_rc=0
    picked="$(pick_failed "$rows_file" "$heal_rows_file")" || picked_rc=$?
  else
    log "heal execution listing failed; healing the newest unmasked red"
  fi
fi

if [ -z "$picked" ]; then
  log "$CANARY_LANE_ORCHESTRATOR execution listing unreadable"
  write_stamp unavailable "" "loom-list-unreadable" "${KEY:-}" "error"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=loom-list-unreadable"
  exit 3
fi

picked_ok="$(json_field ok "$picked")"
picked_reason="$(json_field reason "$picked")"
picked_id="$(json_field exec_id "$picked")"
# Read the flag, not the reason: `lane_busy_masking_reds` names a louder
# problem and wins the reason slot, and a failed heal listing leaves the
# first-pass `lane_busy` reason in place. Either way the lane is still wedged.
picked_lane_stale="$(json_field lane_stale "$picked")"
[ -n "$picked_lane_stale" ] || picked_lane_stale="0"

if [ "$picked_ok" != "1" ]; then
  # No usable row inside the window. Fail loudly: a blind healer must not
  # report a red lane as quiet.
  log "listing has no ${CANARY_LANE_DEFINITION} execution in the window (${picked_reason:-unknown})"
  write_stamp unavailable "${picked_id:-}" "reason=${picked_reason:-unknown}" "${KEY:-}" "error"
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$picked"
  else
    printf 'canary-red error reason=%s exec=%s\n' "${picked_reason:-unknown}" "${picked_id:-}"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=reason=${picked_reason:-unknown} exec=${picked_id:-}"
  exit 3
fi

idle="$(json_field idle "$picked")"
[ -n "$idle" ] || idle="0"

if [ "$DRY" -eq 1 ]; then
  oc="noop"
  [ "$idle" = "1" ] || oc="ok"
  dry_detail="idle=${idle} exec=${picked_id:-} reason=${picked_reason}"
  dry_id="${picked_id:-}"
  dry_key="${KEY:-}"
  if [ "$picked_reason" = "lane_busy_masking_reds" ]; then
    oc="error"
    dry_detail="lane_busy_masking_reds masked=$(json_field masked "$picked") oldest_failed=$(json_field oldest_failed "$picked") lane=${picked_id:-}"
  elif [ "$picked_lane_stale" = "1" ]; then
    oc="error"
    dry_detail="lane_stale exec=${picked_id:-} age_hours=$(json_field lane_age_hours "$picked") stale_hours=$(json_field lane_stale_hours "$picked") state=$(json_field state "$picked")"
  elif [ "$picked_reason" = "listing_stale" ]; then
    listing_stale_apply "${picked_id:-}"
    dry_id=""
    dry_key=""
    oc="$LS_OC"
    dry_detail="$LS_DETAIL"
    log "listing has no ${CANARY_LANE_DEFINITION} execution in the window; dropping stale exec key ${picked_id:-none} hits=${LS_HITS}"
  fi
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$picked"
  else
    printf 'canary-red dry-run idle=%s exec=%s reason=%s\n' \
      "$idle" "${dry_id}" "${picked_reason:-}"
  fi
  if [ "$picked_reason" = "listing_stale" ]; then
    write_stamp dry-run "$dry_id" "$dry_detail" "$dry_key" "$oc" \
      "$LS_TRACK_EXEC" "$LS_HITS"
  else
    write_stamp dry-run "$dry_id" "idle=${idle} reason=${picked_reason}" "$dry_key" "$oc"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${dry_detail}"
  exit 0
fi

if [ "$idle" = "1" ] && [ "$picked_reason" = "lane_busy_masking_reds" ]; then
  # The lane is live, so no heal starts here. Unhealed reds behind it are a
  # backlog, not quiet — reporting them as `noop` is what let four sit for a
  # day. Say it loudly and let the next free tick heal them.
  masked="$(json_field masked "$picked")"
  oldest="$(json_field oldest_failed "$picked")"
  log "lane busy on ${picked_id:-} while ${masked:-0} unhealed red(s) wait; oldest ${oldest:-none}"
  write_stamp idle "${picked_id:-}" \
    "reason=${picked_reason} masked=${masked:-0} oldest_failed=${oldest:-}" \
    "${KEY:-}" "error"
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$picked"
  else
    printf 'canary-red lane_busy_masking_reds masked=%s oldest_failed=%s lane=%s\n' \
      "${masked:-0}" "${oldest:-}" "${picked_id:-}"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' \
    "outcome=error detail=lane_busy_masking_reds masked=${masked:-0} oldest_failed=${oldest:-} lane=${picked_id:-}"
  exit 3
fi

if [ "$idle" = "1" ] && [ "$picked_lane_stale" = "1" ]; then
  # The lane row is still `running`/`waiting`, but it has not advanced past
  # the staleness bar. Another `noop idle reason=lane_busy` is what let one
  # wedged exec hold the lane for 20 h across 11 hourly fires. `error` reaches
  # routinesd error-escalate (brain papercut-routine-non-p0-failures) and
  # routine-fleet-health's reds count, so a human sees it inside the hour.
  lane_age="$(json_field lane_age_hours "$picked")"
  lane_bar="$(json_field lane_stale_hours "$picked")"
  lane_state="$(json_field state "$picked")"
  lane_updated="$(json_field updated_at "$picked")"
  log "lane exec ${picked_id:-} has not advanced in ${lane_age:-?}h (bar ${lane_bar:-?}h, state ${lane_state:-unknown}, updated ${lane_updated:-unknown}); escalating instead of another lane_busy noop"
  write_stamp idle "${picked_id:-}" \
    "reason=lane_stale age_hours=${lane_age:-} stale_hours=${lane_bar:-} state=${lane_state:-}" \
    "${KEY:-}" "error"
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$picked"
  else
    printf 'canary-red lane_stale exec=%s age_hours=%s stale_hours=%s state=%s updated=%s\n' \
      "${picked_id:-}" "${lane_age:-}" "${lane_bar:-}" "${lane_state:-}" "${lane_updated:-}"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' \
    "outcome=error detail=lane_stale exec=${picked_id:-} age_hours=${lane_age:-} stale_hours=${lane_bar:-} state=${lane_state:-}"
  exit 3
fi

if [ "$idle" = "1" ] && [ "$picked_reason" = "listing_stale" ]; then
  # Drop the resume key on every listing_stale tick. Reprinting picked_id in
  # ROUTINE_RESULT is how lx-20260902T215510.402-45278-1 stayed the hourly
  # outcome for 12 fires after the stamp already went empty.
  listing_stale_apply "${picked_id:-}"
  log "listing has no ${CANARY_LANE_DEFINITION} execution in the window; dropping stale exec key ${picked_id:-none} hits=${LS_HITS}"
  write_stamp idle "" "$LS_DETAIL" "" "$LS_OC" "$LS_TRACK_EXEC" "$LS_HITS"
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$picked"
  else
    printf 'canary-red %s\n' "$LS_DETAIL"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${LS_OC} detail=${LS_DETAIL}"
  exit "$LS_EXIT"
fi

if [ "$idle" = "1" ]; then
  write_stamp idle "${picked_id:-}" "reason=${picked_reason}" "${KEY:-}" "noop"
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$picked"
  else
    printf 'canary-red idle reason=%s exec=%s\n' "${picked_reason:-}" "${picked_id:-}"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=noop detail=idle reason=${picked_reason} exec=${picked_id:-}"
  exit 0
fi

# Every exit below is an `error` outcome, so each one must print its own
# ROUTINE_RESULT. Without it routinesd falls back to the exit code and records
# the whole failure as the string "exit 3" — which is what the 2026-08-31T16:36Z
# fire recorded for a publish that a manual retry showed was a busy node.
if ! command -v loom >/dev/null 2>&1; then
  log "loom not on PATH"
  write_stamp unavailable "${picked_id}" "loom-missing" "${KEY:-}" "error"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=loom-missing exec=${picked_id:-}"
  exit 3
fi
if ! loom ping >/dev/null 2>&1; then
  log "loom ping failed"
  write_stamp unavailable "${picked_id}" "loom-ping-failed" "${KEY:-}" "error"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=loom-ping-failed exec=${picked_id:-}"
  exit 3
fi

exe="$(command -v loom)"
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$exe")"
install_root="$(dirname "$(dirname "$real")")"

defs=""
scripts=""
for cand in \
  "${LOOM_DEFS:-}" \
  "$ROOT/lib/canary-red" \
  "$install_root/definitions" \
  "${HOME}/.loom/definitions"; do
  if [ -n "$cand" ] && [ -f "$cand/canary-red-heal.json" ]; then
    defs="$cand"
    break
  fi
done
for cand in \
  "${LOOM_SCRIPTS:-}" \
  "$ROOT/lib/canary-red" \
  "$install_root/scripts" \
  "${HOME}/.loom/scripts"; do
  if [ -n "$cand" ] && [ -f "$cand/loom-canary-collect.sh" ] && [ -f "$cand/loom-canary-heal.sh" ]; then
    scripts="$cand"
    break
  fi
done
if [ -z "$defs" ] || [ -z "$scripts" ]; then
  log "canary-red definitions/scripts not found"
  write_stamp unavailable "${picked_id}" "defs-missing" "${KEY:-}" "error"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=error detail=defs-missing exec=${picked_id:-}"
  exit 3
fi
export LOOM_SCRIPTS="$scripts"

# `>/dev/null 2>&1` threw the reason away. A publish fails for a malformed
# graph (never self-heals, needs a person) and for a busy node
# (service_timeout / too many concurrent reads — retries on the next tick).
# Those need opposite responses and the discarded stderr was the only thing
# that told them apart. Keep a bounded excerpt.
publish_err="$(mktemp "${TMPDIR:-/tmp}/canary-red-publish.XXXXXX")"
if ! loom publish "$defs/canary-red-heal.json" >/dev/null 2>"$publish_err"; then
  publish_excerpt="$(tr '\n' ' ' <"$publish_err" | tr -s ' ' | cut -c1-200)"
  rm -f "$publish_err"
  log "loom publish canary-red-heal failed: ${publish_excerpt:-<no stderr>}"
  write_stamp unavailable "${picked_id}" "publish-failed" "${KEY:-}" "error"
  printf '%s %s\n' 'ROUTINE_RESULT' \
    "outcome=error detail=publish-failed exec=${picked_id:-} err=${publish_excerpt:-none}"
  exit 3
fi
rm -f "$publish_err"

if [ "$HEAL" -eq 1 ]; then
  export LOOM_CANARY_RED_LIVE=1
  export LOOM_LIVE=1
else
  unset LOOM_CANARY_RED_LIVE || true
fi

if [ -z "$KEY" ]; then
  KEY="${LOOM_CANARY_RED_KEY:-${CANARY_RED_KEY_PREFIX}${picked_id}}"
fi

input="$(PICKED_ID="$picked_id" python3 -c '
import json, os
print(json.dumps({
    "exec_id": os.environ["PICKED_ID"],
    "max_attempts": 3,
}, separators=(",", ":")))
')"

TIMEOUT_SEC="${LAST_STACK_CANARY_RED_LOOM_TIMEOUT_SEC:-2400}"
case "$TIMEOUT_SEC" in
  ''|*[!0-9]*) TIMEOUT_SEC=2400 ;;
esac
[ "$TIMEOUT_SEC" -ge 1 ] || TIMEOUT_SEC=2400
export LAST_STACK_CANARY_RED_LOOM_TIMEOUT_SEC="$TIMEOUT_SEC"

emit_result() {
  local oc="$1"
  local det="$2"
  if [ "$JSON" -eq 1 ]; then
    printf '{"outcome":"%s","detail":"%s","engine":"loom","key":"%s","exec_id":"%s"}\n' \
      "$oc" "$(printf '%s' "$det" | tr '"' "'")" "$KEY" "$picked_id"
  else
    printf 'CANARY_RED outcome=%s engine=loom exec=%s\n' "$oc" "$picked_id"
    printf 'detail: %s\n' "$det"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${det}"
}

log "loom run canary-red-heal --key $KEY exec=$picked_id timeout=${TIMEOUT_SEC}s"

export LOOM_CANARY_RED_RUN_KEY="$KEY"
export LOOM_CANARY_RED_RUN_INPUT="$input"

set +e
view="$(
  python3 -c '
import os, signal, subprocess, sys
argv = [
    "loom", "run", "canary-red-heal",
    "--key", os.environ["LOOM_CANARY_RED_RUN_KEY"],
    "--input", os.environ["LOOM_CANARY_RED_RUN_INPUT"],
]
p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                     text=True, start_new_session=True)
try:
    out, err = p.communicate(timeout=int(os.environ.get("LAST_STACK_CANARY_RED_LOOM_TIMEOUT_SEC", "2400")))
except subprocess.TimeoutExpired:
    try:
        os.killpg(p.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        out, err = p.communicate(timeout=5)
    except Exception:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        raise SystemExit(124)
    raise SystemExit(124)
sys.stdout.write(out or "")
if p.returncode not in (0, None):
    sys.stderr.write(err or "")
    raise SystemExit(p.returncode or 1)
' 
)"
rc=$?
set -e

parse_view() {
  python3 -c '
import json, sys
text = sys.stdin.read()
status = ""
ctx = {}
exec_id = ""
for i, line in enumerate(text.splitlines()):
    if i == 0 and line.strip() and not line.startswith("status:") and not line.startswith("context.") and not line.startswith("state:"):
        exec_id = line.strip()
    if line.startswith("status:"):
        status = line.split(":", 1)[1].strip()
    elif line.startswith("context."):
        key, _, rest = line.partition(":")
        key = key[len("context."):]
        rest = rest.strip()
        try:
            ctx[key] = json.loads(rest)
        except Exception:
            ctx[key] = rest.strip("\"")
print(json.dumps({
    "status": status,
    "loom_id": exec_id,
    "verdict": str(ctx.get("verdict") or ""),
    "attempt": ctx.get("attempt"),
    "outcome": str(ctx.get("outcome") or ""),
    "detail": str(ctx.get("detail") or ""),
    "heal_status": str(ctx.get("heal_status") or ""),
}))
'
}

if [ "$rc" -eq 124 ]; then
  write_stamp timed-out "$picked_id" "loom-timeout=${TIMEOUT_SEC}" "$KEY" "error"
  emit_result error "exec=${picked_id} loom-timeout=${TIMEOUT_SEC}s key=${KEY}"
  exit 3
fi

parsed="$(printf '%s\n' "$view" | parse_view)"
loom_status="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status") or "")')"
verdict="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("verdict") or "")')"
heal_status="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("heal_status") or "")')"
loom_id="$(printf '%s\n' "$parsed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("loom_id") or "")')"

det="exec=${picked_id} loom=${loom_id} status=${loom_status} verdict=${verdict} heal=${heal_status} key=${KEY}"
if [ "$loom_status" = "succeeded" ] || [ "$verdict" = "green" ]; then
  write_stamp succeeded "$picked_id" "$det" "$KEY" "ok"
  emit_result ok "$det"
  exit 0
fi
if [ "$loom_status" = "running" ] || [ "$loom_status" = "waiting" ] || [ "$loom_status" = "parked" ]; then
  write_stamp running "$picked_id" "$det" "$KEY" "ok"
  emit_result ok "$det"
  exit 0
fi
if [ "$verdict" = "idle" ]; then
  write_stamp idle "$picked_id" "$det" "$KEY" "noop"
  emit_result noop "$det"
  exit 0
fi
write_stamp "${loom_status:-failed}" "$picked_id" "$det" "$KEY" "error"
emit_result error "$det"
exit 3
