#!/usr/bin/env bash
# last-stack-kanban-file-pr — file a pickup-ready Kind:pr card.
#
# The last-stack host-track artifact must publish this helper to ~/.local/bin:
# routinesd generator shells may use PATH without sourcing shell-prelude.
#
# Generators MUST use this instead of raw `kanban add` for Kind:pr work.
# Pickup will not claim a card that lacks a live --north-star and
# --milestone; fkanban refuses Kind:pr in default/todo without a milestone.
# Raw `kanban add --column todo` without those flags either fails or parks
# the card as unattached-outcome in backlog.
#
# Usage:
#   last-stack-kanban-file-pr <slug> --title TEXT --repo OWNER/NAME \
#     --north-star SLUG --milestone SLUG [options] < body.md
#
# Options:
#   --column todo|backlog   default: todo
#   --base BRANCH           default: main
#   --kind pr               only pr is accepted (this helper is the PR path)
#   --priority P0-P3
#   --tags a,b
#   --deps a,b
#   --surfaces a,b
#   --board BOARD           default: default
#   --ensure-milestone      create the milestone if it is missing
#   --board-cli PATH        kanban/fkanban binary (tests)
#   --decision-fixture DIR  offline brain for last-stack-kanban-decision-check
#   --skip-decision-check   tests/operator only — generators must not pass this
#   --work-class CLASS      feature (default, gated) | closeout | proof |
#                           repair | incident (not gated by admission)
#   --admission-fixture DIR offline brain for last-stack-feature-portfolio-admission
#   --dry-run
#
# Exit: 0 on file, 2 on usage/validation, 1 on board write failure.
# A decision-check conflict is exit 2 and does not write the card.
# A paused North Star is exit 2; an unreadable admission record is exit 1.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

usage() {
  printf '%s\n' \
    "last-stack-kanban-file-pr <slug> --title TEXT --repo OWNER/NAME --north-star SLUG --milestone SLUG [options] < body.md" >&2
  exit 2
}

slug="${1:-}"
[ -n "$slug" ] && [ "$slug" != "-h" ] && [ "$slug" != "--help" ] || usage
shift

title=""
repo=""
north_star=""
milestone=""
column="todo"
base="main"
kind="pr"
priority=""
tags=""
deps=""
surfaces=""
board="default"
ensure_ms=0
board_cli=""
dry=0
decision_fixture=""
skip_decision_check=0
work_class="feature"
admission_fixture=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --title) title="${2:-}"; shift 2 ;;
    --repo) repo="${2:-}"; shift 2 ;;
    --north-star) north_star="${2:-}"; shift 2 ;;
    --milestone) milestone="${2:-}"; shift 2 ;;
    --column) column="${2:-}"; shift 2 ;;
    --base) base="${2:-}"; shift 2 ;;
    --kind) kind="${2:-}"; shift 2 ;;
    --priority) priority="${2:-}"; shift 2 ;;
    --tags) tags="${2:-}"; shift 2 ;;
    --deps) deps="${2:-}"; shift 2 ;;
    --surfaces) surfaces="${2:-}"; shift 2 ;;
    --board) board="${2:-}"; shift 2 ;;
    --ensure-milestone) ensure_ms=1; shift ;;
    --board-cli) board_cli="${2:-}"; shift 2 ;;
    --decision-fixture) decision_fixture="${2:-}"; shift 2 ;;
    --skip-decision-check) skip_decision_check=1; shift ;;
    --work-class) work_class="${2:-}"; shift 2 ;;
    --admission-fixture) admission_fixture="${2:-}"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -h|--help) usage ;;
    *)
      printf 'unknown arg: %s\n' "$1" >&2
      usage
      ;;
  esac
done

die() {
  printf 'last-stack-kanban-file-pr: %s\n' "$*" >&2
  exit 2
}

[ -n "$title" ] || die "missing --title"
[ -n "$repo" ] || die "missing --repo"
[ -n "$north_star" ] || die "missing --north-star (pickup will not claim an unattached Kind:pr)"
[ -n "$milestone" ] || die "missing --milestone (pickup will not claim an unattached Kind:pr)"
[ "$kind" = "pr" ] || die "only --kind pr is supported (got $kind)"
case "$column" in
  todo|backlog) ;;
  *) die "column must be todo or backlog (got $column)" ;;
esac
case "$repo" in
  */*) ;;
  *) die "repo must be owner/name (got $repo)" ;;
esac
case "$work_class" in
  feature|closeout|proof|repair|incident) ;;
  *) die "work-class must be feature, closeout, proof, repair, or incident (got $work_class)" ;;
esac

if [ -z "$board_cli" ]; then
  if command -v kanban >/dev/null 2>&1; then
    board_cli=kanban
  else
    die "kanban not on PATH"
  fi
fi

body="$(cat || true)"
[ -n "$body" ] || die "empty body (pipe the brief on stdin)"

# Require a real work brief so default/todo pickup-readiness will accept it.
printf '%s\n' "$body" | grep -Eq '(^|[[:space:]])##[[:space:]]*GOAL\b|^GOAL:' \
  || die "body missing ## GOAL (pickup refuses hollow Kind:pr)"
printf '%s\n' "$body" | grep -Eq '(^|[[:space:]])##[[:space:]]*END STATE\b|^END STATE:|^DONE WHEN:' \
  || die "body missing ## END STATE (or DONE WHEN)"

# Repo: header must be a clean owner/name token when present.
header_repo="$(printf '%s\n' "$body" | sed -n -E 's/^Repo:[[:space:]]*//p' | head -1 | tr -d '\r')"
if [ -n "$header_repo" ] && [ "$header_repo" != "$repo" ]; then
  die "body Repo: '$header_repo' does not match --repo $repo"
fi

# Two-outcome portfolio admission. One exact Brain point get, never a list or
# a search. `feature` is gated; closeout/proof/repair/incident are not.
# decision-2026-08-31-two-admitted-feature-outcomes
admission_bin="$ROOT/bin/last-stack-feature-portfolio-admission"
[ -x "$admission_bin" ] || die "missing $admission_bin"
admission_args=(--north-star "$north_star" --work-class "$work_class")
if [ -n "$admission_fixture" ]; then
  admission_args+=(--fixture-dir "$admission_fixture")
fi
set +e
"$admission_bin" "${admission_args[@]}" >/dev/null
admission_rc=$?
set -e
if [ "$admission_rc" -eq 2 ]; then
  die "admission refused this card: '$north_star' is not an admitted feature outcome"
elif [ "$admission_rc" -ne 0 ]; then
  die "admission record unreadable (exit $admission_rc) — not filing"
fi

# Settled design/decision/preference check. Fail closed: do not file a card
# that contradicts a retrieved record, and do not file if the check cannot run.
if [ "$skip_decision_check" -ne 1 ]; then
  check_bin="$ROOT/bin/last-stack-kanban-decision-check"
  [ -x "$check_bin" ] || die "missing $check_bin"
  check_args=(--title "$title" --kind "$kind" --column "$column" --inject)
  if [ -n "$decision_fixture" ]; then
    check_args+=(--fixture-dir "$decision_fixture")
  elif [ -n "${LAST_STACK_DECISION_FIXTURE:-}" ]; then
    check_args+=(--fixture-dir "$LAST_STACK_DECISION_FIXTURE")
  fi
  check_err="$(mktemp "${TMPDIR:-/tmp}/last-stack-decision-check.XXXXXX")"
  set +e
  injected="$(printf '%s' "$body" | "$check_bin" "${check_args[@]}" 2>"$check_err")"
  check_rc=$?
  set -e
  if [ "$check_rc" -ne 0 ]; then
    if [ -s "$check_err" ]; then
      cat "$check_err" >&2
    fi
    rm -f "$check_err"
    if [ "$check_rc" -eq 2 ]; then
      die "decision-check refused this card (conflicts with a settled brain record)"
    fi
    die "decision-check failed (exit $check_rc) — not filing"
  fi
  rm -f "$check_err"
  [ -n "$injected" ] || die "decision-check returned an empty body"
  body="$injected"
fi

is_live_ms_state() {
  case "${1:-}" in
    active|planned|proving) return 0 ;;
    *) return 1 ;;
  esac
}

ms_json=""
ms_json="$("$board_cli" milestone show "$milestone" --json 2>/dev/null || true)"
ms_state=""
ms_ns=""
if [ -n "$ms_json" ]; then
  ms_state="$(printf '%s\n' "$ms_json" | jq -r '.state // empty' 2>/dev/null || true)"
  ms_ns="$(printf '%s\n' "$ms_json" | jq -r '.north_star // empty' 2>/dev/null || true)"
fi

if [ -z "$ms_json" ]; then
  if [ "$ensure_ms" -ne 1 ]; then
    die "milestone '$milestone' not found — create it first or pass --ensure-milestone"
  fi
  if [ "$dry" -eq 1 ]; then
    printf 'DRY would create milestone %s --north-star %s --state active\n' \
      "$milestone" "$north_star"
  else
    if ! "$board_cli" milestone add "$milestone" \
      --title "$title" \
      --state active \
      --north-star "$north_star" \
      --driver last-stack-milestone-driver >/dev/null; then
      die "failed to create milestone $milestone"
    fi
  fi
  ms_state=active
  ms_ns="$north_star"
elif ! is_live_ms_state "$ms_state"; then
  # --ensure-milestone means "make this milestone usable": a completed outcome
  # that gets new incident work reopens instead of silently blocking the
  # auto-filer (2026-09-04: soak RED card lost because this refused
  # state=complete). Abandoned and unknown states still refuse.
  if [ "$ensure_ms" -eq 1 ] && [ "$ms_state" = "complete" ]; then
    if [ "$dry" -eq 1 ]; then
      printf 'DRY would reopen milestone %s complete → active\n' "$milestone"
    elif ! "$board_cli" milestone state "$milestone" active >/dev/null; then
      die "failed to reopen milestone $milestone (state=complete)"
    fi
    ms_state=active
  else
    die "milestone '$milestone' is not live (state=${ms_state:-empty}) — pick an active/planned/proving outcome"
  fi
fi

if [ -n "$ms_ns" ] && [ "$ms_ns" != "$north_star" ]; then
  die "milestone '$milestone' is under north_star '$ms_ns', not '$north_star'"
fi

add_args=(
  add "$slug"
  --title "$title"
  --board "$board"
  --column "$column"
  --kind pr
  --repo "$repo"
  --base "$base"
  --north-star "$north_star"
  --milestone "$milestone"
)
[ -n "$priority" ] && add_args+=(--priority "$priority")
[ -n "$tags" ] && add_args+=(--tags "$tags")
[ -n "$deps" ] && add_args+=(--deps "$deps")
[ -n "$surfaces" ] && add_args+=(--surfaces "$surfaces")

if [ "$dry" -eq 1 ]; then
  printf 'DRY %s' "$board_cli"
  printf ' %q' "${add_args[@]}"
  printf '\n'
  exit 0
fi

if ! printf '%s' "$body" | "$board_cli" "${add_args[@]}"; then
  printf 'last-stack-kanban-file-pr: kanban add failed for %s\n' "$slug" >&2
  exit 1
fi

printf 'filed %s column=%s north_star=%s milestone=%s\n' \
  "$slug" "$column" "$north_star" "$milestone"
exit 0
