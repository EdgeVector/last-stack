#!/usr/bin/env bash
# last-stack-lastgit-ci-coverage — is last-stack ci-required already covered?
#
# Last-stack ci-required is served by the fleet supervisor:
#   lastgit forge run --all --context ci-required
# (LaunchAgent com.edgevector.lastgit-forge-primary). A second
#   lastgit ci watch --repo last-stack --context ci-required
# on the same context is a duplicate: it re-reads LastgitRefEvent and
# bypasses --max-per-repo-concurrency. Do not install that watcher.
#
# Repo selection: `--repo <slug>` wins. Without it the helper reads
# $LASTGIT_REPO, then the basename of the git `origin` remote of $PWD. It never
# falls back to a fixed repo: a silent `last-stack` default once reported
# `covered=true` while the CR under check belonged to `laststore`
# (papercut-last-stack-lastgit-ci-coverage-defaults-to-last-stack-repo).
#
# Head scoping: `--head <oid>` asks whether THAT commit is covered. A forge run
# or a per-repo watch covers every head of the repo. A `--ref` watch covers a
# head only when its ref names that oid (full or >=7-char prefix). Without
# --head, --ref watches are listed but never count as coverage (unchanged).
#
# Exit:
#   0  forge-run covers the repo, no duplicate repo watch
#   1  uncovered
#   2  usage (bad flag, no repo resolvable, malformed --head)
#   3  forge-run covers the repo AND a duplicate repo watch is running
#   4  only an unsupervised ci watch covers it (per-repo, or per-ref for --head)
set -euo pipefail

repo=""
repo_source=""
head=""
context="ci-required"
ps_file=""
launchctl_file=""
json=0

usage() {
  cat >&2 <<'EOF'
usage: last-stack-lastgit-ci-coverage --repo <slug> [--head <oid>]
                                      [--context ci-required]
                                      [--ps-file PATH] [--launchctl-file PATH]
                                      [--json]
  --repo   LastGit repo slug. Omitted: $LASTGIT_REPO, else the basename of
           the git origin remote of the current directory. No fixed default.
  --head   commit oid (7-64 hex). Scope the answer to that head.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) repo="${2:-}"; repo_source="flag"; shift 2 ;;
    --repo=*) repo="${1#*=}"; repo_source="flag"; shift ;;
    --head) head="${2:-}"; shift 2 ;;
    --head=*) head="${1#*=}"; shift ;;
    --context) context="${2:-}"; shift 2 ;;
    --ps-file) ps_file="${2:-}"; shift 2 ;;
    --launchctl-file) launchctl_file="${2:-}"; shift 2 ;;
    --json) json=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

if [ -z "$repo" ] && [ -n "${LASTGIT_REPO:-}" ]; then
  repo="$LASTGIT_REPO"
  repo_source="env:LASTGIT_REPO"
fi
if [ -z "$repo" ]; then
  origin_url="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [ -n "$origin_url" ]; then
    repo="${origin_url%/}"
    repo="${repo##*/}"
    repo="${repo%.git}"
    repo_source="git-origin"
  fi
fi
if [ -z "$repo" ]; then
  echo "last-stack-lastgit-ci-coverage: no repo: pass --repo <slug> (no LASTGIT_REPO, no git origin remote in $PWD)" >&2
  usage
  exit 2
fi
if [ -z "$context" ]; then
  echo "last-stack-lastgit-ci-coverage: --context must be non-empty" >&2
  exit 2
fi
if [ -n "$head" ]; then
  head="$(printf '%s' "$head" | tr 'A-F' 'a-f')"
  case "$head" in
    *[!0-9a-f]*) echo "last-stack-lastgit-ci-coverage: --head must be a 7-64 char hex oid, got '$head'" >&2; exit 2 ;;
  esac
  if [ "${#head}" -lt 7 ] || [ "${#head}" -gt 64 ]; then
    echo "last-stack-lastgit-ci-coverage: --head must be a 7-64 char hex oid, got '$head'" >&2
    exit 2
  fi
fi

ps_tmp=""
launchctl_tmp=""
cleanup_ps_tmp() {
  if [ -n "$ps_tmp" ]; then
    rm -f "$ps_tmp"
  fi
  if [ -n "$launchctl_tmp" ]; then
    rm -f "$launchctl_tmp"
  fi
}
trap cleanup_ps_tmp EXIT
if [ -n "$ps_file" ]; then
  ps_tmp="$ps_file"
  trap - EXIT
else
  ps_tmp="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack-ci-coverage.XXXXXX")"
  ps -axww -o pid=,command= >"$ps_tmp" 2>/dev/null || : >"$ps_tmp"
fi

if [ -n "$launchctl_file" ]; then
  launchctl_tmp="$launchctl_file"
elif [ -z "$ps_file" ] && command -v launchctl >/dev/null 2>&1; then
  launchctl_tmp="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack-ci-launchctl.XXXXXX")"
  launchctl print "gui/$(id -u)/com.edgevector.lastgit-forge-primary" \
    >"$launchctl_tmp" 2>/dev/null || : >"$launchctl_tmp"
fi

export COVERAGE_REPO="$repo"
export COVERAGE_REPO_SOURCE="$repo_source"
export COVERAGE_HEAD="$head"
export COVERAGE_CONTEXT="$context"
export COVERAGE_JSON="$json"
export COVERAGE_PS_FILE="$ps_tmp"
export COVERAGE_LAUNCHCTL_FILE="$launchctl_tmp"
python3 - <<'PY'
import json
import os
import sys

repo = os.environ["COVERAGE_REPO"]
repo_source = os.environ.get("COVERAGE_REPO_SOURCE") or "flag"
head = os.environ.get("COVERAGE_HEAD") or None
want_context = os.environ["COVERAGE_CONTEXT"]
want_json = os.environ.get("COVERAGE_JSON") == "1"
ps_path = os.environ["COVERAGE_PS_FILE"]
launchctl_path = os.environ.get("COVERAGE_LAUNCHCTL_FILE", "")
default_context = "ci-required"

def tokens(line):
    return line.strip().split()

def is_lastgit_verb(toks, verb):
    if not toks:
        return False
    base = toks[0].replace("\\", "/").split("/")[-1]
    if base != "lastgit":
        return False
    return toks[1 : 1 + len(verb)] == verb

def argv_flag(toks, name):
    flag = "--" + name
    eq = "--" + name + "="
    i = 0
    while i < len(toks):
        tok = toks[i]
        if tok == flag:
            nxt = toks[i + 1] if i + 1 < len(toks) else None
            if nxt and not nxt.startswith("--"):
                return nxt
            return None
        if tok.startswith(eq):
            return tok[len(eq):] or None
        i += 1
    return None

def has_flag(toks, name):
    return ("--" + name) in toks

def split_csv(value):
    if not value:
        return []
    return [part.strip() for part in value.split(",") if part.strip()]

def ref_names_head(ref, oid):
    """True when a `--ref` value names the requested head oid.

    A ref watch on `refs/heads/main` may or may not sit on the oid; this
    helper has no git access to the LastGit repo, so only an explicit oid
    (full, or a >=7-char prefix of the requested head) counts.
    """
    if not ref or not oid:
        return False
    ref = ref.strip().lower()
    if ref == oid:
        return True
    if len(ref) >= 7 and all(c in "0123456789abcdef" for c in ref):
        return oid.startswith(ref) or ref.startswith(oid)
    return False

def pid_and_cmd(line):
    stripped = line.strip()
    if not stripped:
        return None, ""
    parts = stripped.split(None, 1)
    pid = None
    cmd = stripped
    try:
        pid = int(parts[0])
        cmd = parts[1] if len(parts) > 1 else ""
    except ValueError:
        pid = None
        cmd = stripped
    return pid, cmd

forge = []
launchd_forge = []
repo_watch = []
ref_watch = []

with open(ps_path, encoding="utf-8") as fh:
    lines = fh.read().splitlines()
for raw in lines:
    pid, cmd = pid_and_cmd(raw)
    toks = tokens(cmd)
    if is_lastgit_verb(toks, ["forge", "run"]):
        ctx = argv_flag(toks, "context") or default_context
        if ctx != want_context:
            continue
        exclude = set(split_csv(argv_flag(toks, "exclude")))
        if repo in exclude:
            continue
        repos_flag = argv_flag(toks, "repos")
        if has_flag(toks, "all") or not repos_flag:
            forge.append({"pid": pid, "command": cmd, "scope": "all"})
            continue
        repos = set(split_csv(repos_flag))
        if repo in repos:
            forge.append({"pid": pid, "command": cmd, "scope": "repos"})
        continue
    if is_lastgit_verb(toks, ["ci", "watch"]):
        watch_repo = argv_flag(toks, "repo")
        if watch_repo != repo:
            continue
        ctx = argv_flag(toks, "context") or default_context
        if ctx != want_context:
            continue
        ref = argv_flag(toks, "ref")
        row = {"pid": pid, "command": cmd, "ref": ref}
        if ref:
            ref_watch.append(row)
        else:
            repo_watch.append(row)

if launchctl_path:
    with open(launchctl_path, encoding="utf-8") as fh:
        launchctl_text = fh.read()
    if (
        "com.edgevector.lastgit-forge-primary" in launchctl_text
        and "state = running" in launchctl_text
        and ".lastgit/forge-run.sh" in launchctl_text
    ):
        launchd_forge.append({
            "label": "com.edgevector.lastgit-forge-primary",
            "scope": "all",
        })

# A --ref watch that names the requested head covers that head only.
head_ref_watch = [row for row in ref_watch if head and ref_names_head(row["ref"], head)]

covered_by_forge = bool(forge or launchd_forge)
duplicate = covered_by_forge and bool(repo_watch)
orphan_only = (not covered_by_forge) and bool(repo_watch)
orphan_ref_only = (not covered_by_forge) and (not repo_watch) and bool(head_ref_watch)
covered = covered_by_forge or orphan_only or orphan_ref_only
if covered_by_forge:
    if forge:
        supervisor = "forge-run-all" if any(row["scope"] == "all" for row in forge) else "forge-run-repos"
    else:
        supervisor = "launchd-forge-primary"
elif orphan_only:
    supervisor = "orphan-ci-watch"
elif orphan_ref_only:
    supervisor = "orphan-ref-watch"
else:
    supervisor = None

target = f"{repo} {want_context}"
if head:
    target = f"{repo}@{head} {want_context}"
if covered_by_forge and not duplicate:
    rc = 0
    detail = f"{supervisor} covers {target}"
elif duplicate:
    rc = 3
    detail = f"{supervisor} covers {target}; duplicate lastgit ci watch --repo {repo} is running"
elif orphan_only:
    rc = 4
    detail = f"unsupervised lastgit ci watch --repo {repo} --context {want_context} (not forge run --all)"
elif orphan_ref_only:
    rc = 4
    detail = f"unsupervised lastgit ci watch --repo {repo} --ref {head_ref_watch[0]['ref']} covers only {target} (not forge run --all)"
else:
    rc = 1
    if head and ref_watch:
        detail = f"no lastgit forge run covering {target}; {len(ref_watch)} --ref watch(es) name other refs"
    else:
        detail = f"no lastgit forge run covering {target}"

payload = {
    "repo": repo,
    "repo_source": repo_source,
    "head": head,
    "context": want_context,
    "covered": covered,
    "supervised": covered_by_forge,
    "supervisor": supervisor,
    "duplicate_repo_watch": duplicate,
    "forge": forge,
    "launchd_forge": launchd_forge,
    "repo_watch": repo_watch,
    "ref_watch": ref_watch,
    "head_ref_watch": head_ref_watch,
    "detail": detail,
    "exit": rc,
}
if want_json:
    print(json.dumps(payload, separators=(",", ":")))
else:
    print(detail)
sys.exit(rc)
PY
