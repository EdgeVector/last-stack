#!/usr/bin/env bash
# Run ONE mutation probe: break a property on purpose, confirm the guard that
# claims to protect it goes RED, then restore the tree to the exact bytes.
#
# Why this exists
# ---------------
# The standing rules make a mutation probe mandatory for every guard added, and
# every pass hand-rolls the loop. Hand-rolled probes fail in ONE direction: a
# patch whose anchor does not match the file mutates NOTHING, the guard test
# then passes, and GREEN reads as "the guard is fine" or "the property is
# protected twice" -- the opposite of the truth. Measured 2026-10-03 on
# EdgeVector/last-stack: two of six probes for one new guard came back GREEN
# because one used 6 spaces of indentation where the file carries 12, and one
# wrote `\\\\t` in a Python string literal where the file holds one backslash.
# Neither guard was weak; both probes had replaced nothing.
#
# So here a probe that changed no byte is an ERROR with its own exit code, never
# a green. That is the whole value; the rest is what every pass already writes
# by hand.
# brain: papercut-no-mutation-probe-helper-so-a-no-op-probe-reads-as-a-passing-guard-20261003
#
# Usage
# -----
#   last-stack-mutation-probe --name <probe> --target <file> [--target <file>]...
#                             --patch <command> --test <command>
#                             [--expect red|green] [--expect-red-on <ere>]
#                             [--keep-on-fail]
#
# --expect-red-on <ere> states WHICH assertion the red must be about. Without
# it the strongest claim a probe can make is "something failed", and every
# reader of `verdict=RED expect=RED` upgrades that silently to "the guard
# caught MY defect". Measured 2026-10-04 on EdgeVector/last-stack PR 236: of
# six probes against one five-case guard test, THREE went red on a different
# case than the one they targeted, and two of the five cases had no
# independent verdict available at all. Every one of the six printed
# `mutated=yes verdict=RED expect=RED restored=ok offtarget=none`.
# brain: papercut-mutation-probe-cannot-state-which-assertion-the-red-should-be-about-20261004
#
# --patch and --test are shell commands run with `bash -c` from the caller's
# cwd. The patch must change at least one --target; creating a target that was
# absent, or removing one that was present, both count as a mutation.
#
# A --target that is a directory is compared as a tree (every file under it).
#
# Exit codes
# ----------
#   0  the probe behaved as expected (default --expect red: the test went RED)
#   1  the probe ran and the verdict was NOT the expected one. With the default
#      --expect red that means the guard does NOT catch this defect.
#   2  usage or environment error
#   3  THE PATCH MUTATED NOTHING. The probe is invalid and there is no verdict.
#      The test is not run. Never read this as a green.
#   4  the restore did not return every target to its original bytes. The
#      snapshot directory is kept and printed; repair the tree from it.
#   5  THE PATCH MUTATED A FILE OUTSIDE --target. That file was never
#      snapshotted, so it is STILL mutated and this helper cannot restore it.
#      The offending paths are named; repair them yourself. The test is not run.
#      Checked BEFORE 3, because exit 3's advice -- fix the anchor and run it
#      again -- is then taken on a tree that no longer matches the commit.
#   6  THE RED WAS NOT THE ONE YOU ASKED FOR. --expect-red-on was given, the
#      test went RED, and nothing in its output matched the pattern. The probe
#      has no verdict about the assertion it targeted. Only possible with
#      --expect-red-on; a probe without one can never reach this code, which is
#      the point of reporting expect_red_on= on every verdict line.
set -euo pipefail

name=""
patch_cmd=""
test_cmd=""
expect="red"
expect_red_on=""
expect_red_on_set=0
keep_on_fail=0
targets=()

die() { printf 'last-stack-mutation-probe: %s\n' "$*" >&2; exit 2; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)   [ "$#" -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
    --target) [ "$#" -ge 2 ] || die "--target needs a value"; targets+=("$2"); shift 2 ;;
    --patch)  [ "$#" -ge 2 ] || die "--patch needs a value"; patch_cmd="$2"; shift 2 ;;
    --test)   [ "$#" -ge 2 ] || die "--test needs a value"; test_cmd="$2"; shift 2 ;;
    --expect) [ "$#" -ge 2 ] || die "--expect needs a value"; expect="$2"; shift 2 ;;
    --expect-red-on)
      [ "$#" -ge 2 ] || die "--expect-red-on needs a value"
      # Refused rather than last-wins: two patterns would read as "either of
      # these", and a probe that accepts either red is the weak claim this
      # option exists to remove.
      [ "$expect_red_on_set" -eq 0 ] || die "--expect-red-on may be given once; two patterns would read as 'either red will do'"
      expect_red_on="$2"; expect_red_on_set=1; shift 2 ;;
    --keep-on-fail) keep_on_fail=1; shift ;;
    -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

[ -n "$name" ] || die "--name is required"
[ "${#targets[@]}" -gt 0 ] || die "--target is required at least once"
[ -n "$patch_cmd" ] || die "--patch is required"
[ -n "$test_cmd" ] || die "--test is required"
case "$expect" in red|green) ;; *) die "--expect must be red or green, got: $expect" ;; esac
if [ "$expect_red_on_set" -eq 1 ]; then
  [ -n "$expect_red_on" ] || die "--expect-red-on needs a non-empty pattern"
  [ "$expect" = "red" ] || die "--expect-red-on is meaningless with --expect green: there is no red for it to be about"
  printf 'x\n' | grep -E -- "$expect_red_on" >/dev/null 2>&1 || [ "$?" -le 1 ] \
    || die "--expect-red-on is not a valid extended regular expression: $expect_red_on"
fi

abs_path() {
  # Absolute, symlink-resolved as far as the parent directory. The leaf may not
  # exist yet (a probe may CREATE its target), so only the dirname is resolved.
  local p="$1" d b rd
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  d="$(dirname -- "$p")"; b="$(basename -- "$p")"
  if rd="$(cd "$d" 2>/dev/null && pwd -P)"; then printf '%s/%s\n' "${rd%/}" "$b"
  else printf '%s\n' "$p"; fi
}

target_abs=()
for target in "${targets[@]}"; do target_abs+=("$(abs_path "$target")"); done

# ---------------------------------------------------------------------------
# Off-target detection
#
# The snapshot below covers exactly the --target paths, so a patch that edits
# anything else is never restored: the edit survives the probe. Exit 3 then
# prints `mutated=no`, which is true of the targets and false of the tree, and
# the natural next action (fix the anchor, re-run) happens on a tree that no
# longer matches the commit. Measured 2026-10-03: one probe of twelve deleted a
# line from a test file that was not a --target; it was found by a later grep,
# not by this helper.
# brain: papercut-mutation-probe-leaves-an-off-target-mutation-in-the-tree-and-calls-it-no-op-20261003
#
# `git status --porcelain` on its own CANNOT see it. That recorded instance
# edited a file that was ALREADY modified, so its status line read the same
# before and after. What moves is the dirty set PLUS a content id per path, so
# that is what gets compared.
#
# The window checked is the PATCH only. A guard test may legitimately write
# files (the suite for this helper writes a marker), so running the same check
# after the test would refuse correct probes.
#
# Scope, stated rather than implied: the comparison is per-path CONTENT, so a
# patch that only moves something in or out of the index without changing a
# file's bytes is not reported. That shape has not been measured; file contents
# are what the recorded instance left behind.
repo_root=""
if command -v git >/dev/null 2>&1; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -z "$repo_root" ] || repo_root="$(cd "$repo_root" 2>/dev/null && pwd -P)" || repo_root=""
fi

dirty_fingerprint() {
  # One "<abs path>\t<content id>" line per path git reports as not clean,
  # sorted. A path that appears, disappears, or changes content moves a line.
  local rec expect_source=0 xy rest abs id
  while IFS= read -r -d '' rec; do
    if [ "$expect_source" -eq 1 ]; then
      expect_source=0
      rest="$rec"                       # the source half of a rename or copy
    else
      xy="${rec:0:2}"; rest="${rec:3}"
      case "$xy" in *R*|*C*) expect_source=1 ;; esac
    fi
    [ -n "$rest" ] || continue
    abs="$repo_root/$rest"
    if [ -L "$abs" ]; then id="symlink:$(readlink -- "$abs" 2>/dev/null || printf '?')"
    elif [ -d "$abs" ]; then id="dir"
    elif [ -f "$abs" ]; then id="$(git hash-object -- "$abs" 2>/dev/null || printf 'UNHASHABLE')"
    elif [ -e "$abs" ]; then id="other"
    else id="ABSENT"
    fi
    printf '%s\t%s\n' "$abs" "$id"
  done < <(git -C "$repo_root" status --porcelain -z --untracked-files=all 2>/dev/null) \
  | LC_ALL=C sort
}

on_target() {
  local p="$1" t
  for t in "${target_abs[@]}"; do
    [ "$p" = "$t" ] && return 0
    case "$p" in "$t"/*) return 0 ;; esac
  done
  return 1
}

snap_dir="$(mktemp -d "${TMPDIR:-/tmp}/last-stack-mutation-probe.XXXXXX")"
snap_kept=0

cleanup() {
  [ "$snap_kept" -eq 1 ] || rm -rf -- "$snap_dir"
}
trap cleanup EXIT

# Snapshot. A target is copied under <snap>/<n>/payload when it exists, and
# recorded as absent otherwise, so creating a missing file counts as a mutation
# and so does deleting a present one.
index=0
for target in "${targets[@]}"; do
  slot="$snap_dir/$index"
  mkdir -p "$slot"
  printf '%s\n' "$target" > "$slot/path"
  if [ -e "$target" ]; then
    printf 'present\n' > "$slot/state"
    cp -R -- "$target" "$slot/payload"
  else
    printf 'absent\n' > "$slot/state"
  fi
  index=$((index + 1))
done

# Is any target different from its snapshot right now?
any_target_differs() {
  local i=0 slot state path
  while [ "$i" -lt "${#targets[@]}" ]; do
    slot="$snap_dir/$i"
    path="${targets[$i]}"
    state="$(cat "$slot/state")"
    if [ "$state" = "absent" ]; then
      [ -e "$path" ] && return 0
    else
      [ -e "$path" ] || return 0
      if [ -d "$slot/payload" ]; then
        diff -r -- "$slot/payload" "$path" >/dev/null 2>&1 || return 0
      else
        [ -d "$path" ] && return 0
        cmp -s -- "$slot/payload" "$path" || return 0
      fi
    fi
    i=$((i + 1))
  done
  return 1
}

restore_targets() {
  local i=0 slot state path
  while [ "$i" -lt "${#targets[@]}" ]; do
    slot="$snap_dir/$i"
    path="${targets[$i]}"
    state="$(cat "$slot/state")"
    # Tolerant on purpose: a restore that cannot write is reported as
    # restored=FAILED with the snapshot kept, not as an unhandled abort under
    # `set -e` that leaves the operator with a mutated tree and no message.
    rm -rf -- "$path" 2>/dev/null || true
    if [ "$state" = "present" ]; then
      mkdir -p -- "$(dirname -- "$path")" 2>/dev/null || true
      cp -R -- "$slot/payload" "$path" 2>/dev/null || true
    fi
    i=$((i + 1))
  done
}

# 1. record what the worktree already looks like, then apply the patch
offtarget_state="unchecked"
if [ -n "$repo_root" ]; then
  dirty_fingerprint > "$snap_dir/dirty-before"
  offtarget_state="none"
fi

patch_rc=0
bash -c "$patch_cmd" || patch_rc=$?

mutated="no"
if any_target_differs; then mutated="yes"; fi

# 2. REFUSE a probe that mutated a path this helper did not snapshot. Before the
#    no-op check, because the two mistakes need different answers and only this
#    one leaves the tree dirty: "your anchor missed" vs "your target list is
#    wrong". Before the test, for the same reason as the no-op refusal -- a
#    verdict computed on a tree carrying an unobserved change is not a verdict.
if [ "$offtarget_state" = "none" ]; then
  dirty_fingerprint > "$snap_dir/dirty-after"
  : > "$snap_dir/offtarget"
  {
    LC_ALL=C comm -23 "$snap_dir/dirty-before" "$snap_dir/dirty-after"
    LC_ALL=C comm -13 "$snap_dir/dirty-before" "$snap_dir/dirty-after"
  } | cut -f1 | LC_ALL=C sort -u > "$snap_dir/changed"
  while IFS= read -r changed_path; do
    [ -n "$changed_path" ] || continue
    on_target "$changed_path" || printf '%s\n' "$changed_path" >> "$snap_dir/offtarget"
  done < "$snap_dir/changed"
  if [ -s "$snap_dir/offtarget" ]; then offtarget_state="found"; fi
fi

if [ "$offtarget_state" = "found" ]; then
  restore_targets
  printf 'probe %s mutated=%s verdict=NONE patch_rc=%s offtarget=%s\n' \
    "$name" "$mutated" "$patch_rc" "$(wc -l < "$snap_dir/offtarget" | tr -d ' ')"
  printf 'last-stack-mutation-probe: %s mutated %s path(s) OUTSIDE --target; they were never snapshotted and are STILL mutated. Repair them, then add them to --target or keep the patch inside the targets:\n' \
    "$name" "$(wc -l < "$snap_dir/offtarget" | tr -d ' ')" >&2
  sed 's/^/  off-target: /' "$snap_dir/offtarget" >&2
  exit 5
fi

# 3. REFUSE a probe that mutated nothing. This runs before the test, so a no-op
#    probe can never produce a verdict to misread.
if [ "$mutated" = "no" ]; then
  restore_targets
  printf 'probe %s mutated=no verdict=NONE patch_rc=%s offtarget=%s\n' "$name" "$patch_rc" "$offtarget_state"
  printf 'last-stack-mutation-probe: %s changed no byte of any --target; the probe is invalid, not green. Check the patch anchor (indentation and backslash escaping are the two recorded causes).\n' \
    "$name" >&2
  exit 3
fi

# 4. run the guard test against the mutated tree.
#
#    The output is captured ONLY when --expect-red-on asked for it, so the
#    default path keeps the two streams separate exactly as every existing
#    caller sees them today. With the option, stdout and stderr are merged and
#    teed: merged because a guard may print its FAIL line on either, and teed
#    so a long test still streams while it runs.
test_rc=0
test_output=""
if [ "$expect_red_on_set" -eq 1 ]; then
  test_output="$snap_dir/test-output"
  set +o pipefail
  bash -c "$test_cmd" 2>&1 | tee "$test_output"
  test_rc="${PIPESTATUS[0]}"
  set -o pipefail
else
  bash -c "$test_cmd" || test_rc=$?
fi
if [ "$test_rc" -eq 0 ]; then verdict="GREEN"; else verdict="RED"; fi

# 5. restore, then prove the restore landed. The standing rule is not to assume
#    it worked, so compare bytes rather than trusting cp.
restore_targets
restored="ok"
if any_target_differs; then
  restored="FAILED"
fi

# The pattern is reported on EVERY verdict line, including when it was not
# given. A probe without one is then visibly the weaker claim -- `something
# failed` rather than `this assertion failed` -- instead of looking identical
# to a targeted probe.
expect_red_on_field="-"
[ "$expect_red_on_set" -eq 0 ] || expect_red_on_field="'$expect_red_on'"

printf 'probe %s mutated=yes verdict=%s expect=%s restored=%s test_rc=%s offtarget=%s expect_red_on=%s\n' \
  "$name" "$verdict" "$(printf '%s' "$expect" | tr '[:lower:]' '[:upper:]')" "$restored" "$test_rc" "$offtarget_state" "$expect_red_on_field"

if [ "$restored" = "FAILED" ]; then
  snap_kept=1
  printf 'last-stack-mutation-probe: %s did not restore every --target to its original bytes; snapshot kept at %s\n' \
    "$name" "$snap_dir" >&2
  exit 4
fi

case "$expect" in
  red)   [ "$verdict" = "RED" ]   || { printf 'last-stack-mutation-probe: %s expected RED and the test PASSED; the guard does not catch this defect\n' "$name" >&2; [ "$keep_on_fail" -eq 0 ] || snap_kept=1; exit 1; } ;;
  green) [ "$verdict" = "GREEN" ] || { printf 'last-stack-mutation-probe: %s expected GREEN and the test FAILED (test_rc=%s)\n' "$name" "$test_rc" >&2; [ "$keep_on_fail" -eq 0 ] || snap_kept=1; exit 1; } ;;
esac

# 6. REFUSE a red that is not the one the caller asked for. The verdict is
#    already RED here, so without this the probe exits 0 and the operator reads
#    "the guard caught my defect" off a line that only says a test failed.
if [ "$expect_red_on_set" -eq 1 ]; then
  matched=""
  matched="$(grep -E -m1 -- "$expect_red_on" "$test_output" 2>/dev/null || true)"
  if [ -n "$matched" ]; then
    printf '  red-on: %s\n' "$matched"
  else
    [ "$keep_on_fail" -eq 0 ] || snap_kept=1
    printf 'last-stack-mutation-probe: %s went RED, but nothing in the test output matched --expect-red-on %s. The test failed on a DIFFERENT assertion, so this probe has no verdict about the one it targeted. Narrow the guard test (a positional case filter is the recorded fix) or correct the pattern.\n' \
      "$name" "$expect_red_on" >&2
    printf 'last-stack-mutation-probe: the test output it DID produce (last 20 lines):\n' >&2
    tail -20 -- "$test_output" | sed 's/^/  test: /' >&2
    exit 6
  fi
fi

exit 0
