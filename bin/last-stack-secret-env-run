#!/usr/bin/env bash
# Resolve one LastSecrets locator at exec time and expose it only to the child.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  last-stack-secret-env-run --env NAME --ref lastsecrets://SLUG -- COMMAND [ARG...]

The secret value is fetched only after argument validation, is never written to
a file or command argument, and is exported only in the process that immediately
execs COMMAND. The calling routine keeps only the lastsecrets:// locator.
EOF
}

env_name=""
secret_ref=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --env)
      [ "$#" -ge 2 ] || { echo "--env requires a value" >&2; exit 2; }
      env_name="$2"
      shift 2
      ;;
    --env=*)
      env_name="${1#*=}"
      shift
      ;;
    --ref)
      [ "$#" -ge 2 ] || { echo "--ref requires a value" >&2; exit 2; }
      secret_ref="$2"
      shift 2
      ;;
    --ref=*)
      secret_ref="${1#*=}"
      shift
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unexpected argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$env_name" in
  ''|[0-9]*|*[!A-Za-z0-9_]*)
    echo "--env must be a shell environment variable name" >&2
    exit 2
    ;;
esac
case "$secret_ref" in
  lastsecrets://?*) secret_slug="${secret_ref#lastsecrets://}" ;;
  *)
    echo "--ref must be a lastsecrets:// locator" >&2
    exit 2
    ;;
esac
[ "$#" -gt 0 ] || { echo "COMMAND is required after --" >&2; exit 2; }

lastsecrets_bin="${LASTSECRETS_CLI:-lastsecrets}"
command -v "$lastsecrets_bin" >/dev/null 2>&1 || {
  echo "lastsecrets CLI is unavailable" >&2
  exit 127
}

# Never inherit tracing into the value-bearing section. OBS_SENTRY_DSN is a
# public locator in routine shells, but some LastSecrets installs do not bundle
# the optional Sentry SDK; it must not prevent secret retrieval.
set +x
secret_value="$(env -u OBS_SENTRY_DSN "$lastsecrets_bin" get "$secret_slug")" || {
  echo "could not resolve LastSecrets locator" >&2
  exit 1
}
[ -n "$secret_value" ] || { echo "LastSecrets locator resolved empty" >&2; exit 1; }
case "$secret_value" in
  *$'\n'*|*$'\r'*)
    unset secret_value
    echo "LastSecrets value must be a single line" >&2
    exit 1
    ;;
esac

# printf/export are shell builtins, so the value never becomes an argv entry.
printf -v "$env_name" '%s' "$secret_value"
export "$env_name"
unset secret_value
exec "$@"
