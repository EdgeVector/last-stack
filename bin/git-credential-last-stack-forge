#!/usr/bin/env bash
# git credential helper for the local Forgejo forge (git-credential(1) protocol).
#
# Plain `git fetch` in a portal mirror or worktree used the global osxkeychain
# helper. When the login keychain is locked to non-interactive readers it prints
# "failed to get -25293", git falls back to a terminal prompt, and an unattended
# run dies on "could not read Username for http://localhost:3300: Device not
# configured" (papercut-forgejo-direct-fetch-prompts-for-username-20260923).
# This helper answers `get` from lib/forge-token.sh (FORGE_TOKEN, then keychain,
# then lastsecrets), the same resolution every forge helper uses. Forgejo takes a
# token as the basic-auth password with any username.
#
# last-stack-portal-wt registers it on each forge mirror (repo-local config, so
# every worktree of the mirror inherits it). It answers only for the forge hosts
# below and ignores `store` and `erase`.
set -uo pipefail

self="${BASH_SOURCE[0]}"
while [ -h "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
self_root="$(cd -P "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/forge-token.sh
. "$self_root/lib/forge-token.sh"

[ "${1:-}" = "get" ] || { cat >/dev/null 2>&1 || true; exit 0; }

host=""
while IFS= read -r line; do
  [ -n "$line" ] || break
  case "$line" in host=*) host="${line#host=}" ;; esac
done

case "$host" in
  localhost:3300|127.0.0.1:3300|100.109.94.59:3300) ;;
  *) exit 0 ;;
esac

token="$(last_stack_forge_token 2>/dev/null || true)"
[ -n "$token" ] || exit 0
printf 'username=forge-token\npassword=%s\n' "$token"
