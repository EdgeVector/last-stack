#!/usr/bin/env bash
# Canary-soak every artifact CLI via host-track (not lastgit / LastDB Mini).
# refresh parks canary when soak_hours>0; soak-watch promotes ready ones.
# last-stack has soak_hours=0 (probe-then-activate; it is the soak runner).
set -euo pipefail
# Resolve the file symlink chain before dirname: the PATH link
# ~/.local/bin/<name> points into the artifact tree, and siblings live there.
_self_src="$0"
while [ -L "$_self_src" ]; do
  _self_link="$(readlink "$_self_src")"
  case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
done
ROOT="$(cd "$(dirname "$_self_src")" && pwd -P)"
HT="$ROOT/host-track"
[ -x "$HT" ] || HT="$(command -v host-track)"
[ -x "$HT" ] || {
  echo "host-track not found" >&2
  exit 127
}

# LastDB Mini is deployment-only (lastdb-safe-upgrade). lastgit is bootstrap.
# Everything else in the default registry is an artifact app with probes.
apps=(last-stack brain situations kanban routines lastsecrets configurations lastseek search remote state-machine lastdb-browser)
fail=0
for app in "${apps[@]}"; do
  printf '\n======== safe-upgrade %s ========\n' "$app"
  if "$HT" refresh "$app"; then
    printf 'OK %s\n' "$app"
  else
    printf 'FAIL %s\n' "$app" >&2
    fail=1
  fi
done
printf '\n======== soak-watch --all ========\n'
if "$HT" soak-watch --all; then
  printf 'OK soak-watch\n'
else
  printf 'FAIL soak-watch\n' >&2
  fail=1
fi
if [ "$fail" -ne 0 ]; then
  echo "safe-upgrade-all-local: one or more apps failed" >&2
  exit 1
fi
echo "safe-upgrade-all-local: all OK"
