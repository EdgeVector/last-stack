#!/usr/bin/env bash
# Install/update the scheduled Feature Ship Loop proof routine.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
# shellcheck source=last-stack-routines-registry-env
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/last-stack-routines-registry-env"
last_stack_registry_paths_init

ROUTINES_HOME="${ROUTINES_HOME:-$HOME/.routines}"
REGISTRY_DIR="$ROUTINES_HOME/registry"
# Prefer stable host install prompt; fall back to this tree (tests / first install).
PROMPT_PATH="$(last_stack_registry_prompt_path feature-prove.md "$ROOT/routines/feature-prove.md")"
ID="last-stack-feature-prove"
DRY_RUN=0
PROMPT_PATH_SET=0
FORCE_DEFAULTS=0

usage() {
  cat <<'USAGE'
last-stack-feature-prove-routine [options]

Writes the routines registry entry for the Feature Ship Loop product-proof
routine. Re-running is idempotent and preserves live rrule/difficulty (and
any existing harness/model/pin keys) unless --force-defaults is passed.

Options:
  --registry-dir <p>  registry directory (default: $ROUTINES_HOME/registry)
  --prompt-path <p>   feature-prove prompt path (default: stable last-stack)
  --id <id>           automation id (default: last-stack-feature-prove)
  --force-defaults    replace live rrule/difficulty with compiled defaults
  --dry-run           print target path and contents without writing
  -h, --help          show this help
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --registry-dir)
      REGISTRY_DIR="$2"
      shift 2
      ;;
    --registry-dir=*)
      REGISTRY_DIR="${1#*=}"
      shift
      ;;
    --prompt-path)
      PROMPT_PATH="$2"
      PROMPT_PATH_SET=1
      shift 2
      ;;
    --prompt-path=*)
      PROMPT_PATH="${1#*=}"
      PROMPT_PATH_SET=1
      shift
      ;;
    --id)
      ID="$2"
      shift 2
      ;;
    --id=*)
      ID="${1#*=}"
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --force-defaults)
      FORCE_DEFAULTS=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$ID" in
  ""|*/*)
    echo "unsafe automation id: $ID" >&2
    exit 2
    ;;
esac

if [ ! -r "$PROMPT_PATH" ]; then
  echo "prompt path is not readable: $PROMPT_PATH" >&2
  exit 66
fi

# Host-safe guard: never bake REPLACE or sandbox paths into the live host registry.
if [ "$DRY_RUN" -eq 0 ]; then
  last_stack_registry_assert_safe_write "$REGISTRY_DIR" "$PROMPT_PATH" "$REG_CWD" \
    || exit 3
fi

path="$REGISTRY_DIR/$ID.toml"
last_stack_registry_runtime_values "$path" grok grok-4.5 "$FORCE_DEFAULTS" difficulty
last_stack_registry_rrule "$path" \
  "FREQ=DAILY;BYHOUR=10;BYMINUTE=40;BYSECOND=0" "$FORCE_DEFAULTS"

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s\n' "--- $path"
fi

{
  printf '# Feature Ship Loop product-proof routine.\n'
  printf '# Sweeps ship-mode North Star/milestone terminals; writes PASS proof or files fix-forward work.\n'
  printf 'id = "%s"\n' "$ID"
  last_stack_registry_emit_runtime_values
  printf 'effort = "high"\n'
  printf 'rrule = "%s"\n' "$REG_RUNTIME_RRULE"
  # Prefer LAST_STACK_WORKSPACE when set (main); else REG_CWD from
  # last-stack-routines-registry-env (host-safe REPLACE + sandbox HOME).
  workspace_cwd="${LAST_STACK_WORKSPACE:-$REG_CWD}"
  printf 'cwd = "%s"\n' "$workspace_cwd"
  printf 'status = "active"\n'
  printf 'timeout_min = 45\n'
  printf 'prompt_path = "%s"\n' "$PROMPT_PATH"
} | if [ "$DRY_RUN" -eq 1 ]; then
  cat
else
  mkdir -p "$REGISTRY_DIR"
  tmp="$(mktemp "${TMPDIR:-/tmp}/last-stack-feature-prove.XXXXXX")"
  cat >"$tmp"
  if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
    rm -f "$tmp"
    printf 'unchanged %s\n' "$path"
  else
    mv "$tmp" "$path"
    printf 'wrote %s\n' "$path"
  fi
fi

printf 'configured %s in %s\n' "$ID" "$REGISTRY_DIR"
