#!/usr/bin/env bash
# last-stack-post-merge-safe-upgrade — after a LastGit CR merges to main, run
# local safe-upgrade for mapped agent CLIs. CI stays pure; this is install-only.
#
# Pattern mirrors lastgit `.lastgit/notify-discord.sh --all`:
#   one fleet open-CR index read → detect open→gone → point-view → if merged
#   to main and repo is mapped → last-stack-safe-upgrade-cli <app>
#
# Failure does NOT unmerge. Logs + leaves CR un-recorded so next poll retries
# (capped by LAST_STACK_POST_MERGE_MAX_ATTEMPTS, default 3).
#
# Usage:
#   last-stack-post-merge-safe-upgrade --all [<state-dir>]
#   last-stack-post-merge-safe-upgrade --once --all [<state-dir>]
#   last-stack-post-merge-safe-upgrade --map   # print repo→app map
#
# Env:
#   LAST_STACK_POST_MERGE_INTERVAL   poll seconds (default 20)
#   LAST_STACK_POST_MERGE_STATE_DIR  default ~/.lastgit/post-merge-safe-upgrade
#   LAST_STACK_POST_MERGE_TIMEOUT    seconds per upgrade (default 600)
#   LAST_STACK_POST_MERGE_MAX_ATTEMPTS  retries per CR (default 3)
#   LAST_STACK_POST_MERGE_DRY_RUN=1  log only
#   LAST_STACK_POST_MERGE_BUILD_TIMEOUT  seconds to build+publish a missing
#                                    artifact from source (default 1500)
set -euo pipefail

ONCE=0
MODE=""
STATE_DIR=""
SHOW_MAP=0

while [ $# -gt 0 ]; do
  case "$1" in
    --once) ONCE=1; shift ;;
    --all) MODE=all; shift ;;
    --map) SHOW_MAP=1; shift ;;
    -h|--help)
      sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --) shift; break ;;
    -*)
      echo "post-merge-safe-upgrade: unknown flag: $1" >&2
      exit 2
      ;;
    *)
      if [ -z "$STATE_DIR" ]; then STATE_DIR=$1; shift
      else
        echo "post-merge-safe-upgrade: unexpected arg: $1" >&2
        exit 2
      fi
      ;;
  esac
done

# repo slug → install action (empty = skip)
# Artifact-backed apps use `artifact:<host-track-app>` so merge → host-track
# refresh (track_gate_main promotes stable to green+published main). Remaining
# local-safe CLIs keep last-stack-safe-upgrade-cli.
map_repo_to_app() {
  case "$1" in
    last-stack) printf 'artifact:last-stack\n' ;;
    brain) printf 'artifact:brain\n' ;;
    situations) printf 'artifact:situations\n' ;;
    # The repo is still `fkanban`; the host-track APP and public CLI are
    # `kanban`. Emitting `artifact:fkanban` would name an app that no longer
    # exists in the registry.
    fkanban|kanban) printf 'artifact:kanban\n' ;;
    routines) printf 'artifact:routines\n' ;;
    lastsecrets) printf 'artifact:lastsecrets\n' ;;
    configurations) printf 'artifact:configurations\n' ;;
    remote) printf 'artifact:remote\n' ;;
    search) printf 'artifact:search\n' ;;
    loom) printf 'artifact:loom\n' ;;
    *) printf '\n' ;;
  esac
}

if [ "$SHOW_MAP" = 1 ]; then
  for r in last-stack brain situations fkanban kanban routines lastsecrets configurations remote search loom; do
    printf '%-16s -> %s\n' "$r" "$(map_repo_to_app "$r")"
  done
  exit 0
fi

[ "$MODE" = "all" ] || {
  echo "usage: last-stack-post-merge-safe-upgrade --all [<state-dir>] [--once]" >&2
  exit 2
}

STATE_DIR="${STATE_DIR:-${LAST_STACK_POST_MERGE_STATE_DIR:-$HOME/.lastgit/post-merge-safe-upgrade}}"
INTERVAL="${LAST_STACK_POST_MERGE_INTERVAL:-20}"
UPGRADE_TIMEOUT="${LAST_STACK_POST_MERGE_TIMEOUT:-600}"
MAX_ATTEMPTS="${LAST_STACK_POST_MERGE_MAX_ATTEMPTS:-3}"
DRY_RUN="${LAST_STACK_POST_MERGE_DRY_RUN:-0}"
BUILD_TIMEOUT="${LAST_STACK_POST_MERGE_BUILD_TIMEOUT:-1500}"

UPGRADE_BIN="$(command -v last-stack-safe-upgrade-cli 2>/dev/null || true)"
if [ -z "$UPGRADE_BIN" ] && [ -x "$HOME/.local/bin/last-stack-safe-upgrade-cli" ]; then
  UPGRADE_BIN="$HOME/.local/bin/last-stack-safe-upgrade-cli"
fi
if [ -z "$UPGRADE_BIN" ] && [ -x "$HOME/.last-stack/bin/last-stack-safe-upgrade-cli" ]; then
  UPGRADE_BIN="$HOME/.last-stack/bin/last-stack-safe-upgrade-cli"
fi

timeout_bin=""
if command -v timeout >/dev/null 2>&1; then
  timeout_bin="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  timeout_bin="gtimeout"
fi

mkdir -p "$STATE_DIR"
LOG="${LAST_STACK_POST_MERGE_LOG:-$STATE_DIR/post-merge.log}"

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG" >&2
}

fleet_open_path() { printf '%s/fleet.open\n' "$STATE_DIR"; }
handled_path() { printf '%s/%s.handled\n' "$STATE_DIR" "$1"; }
attempts_path() { printf '%s/%s.attempts\n' "$STATE_DIR" "$1"; }

attempt_count() {
  # $1=repo $2=cr_id
  local f
  f="$(attempts_path "$1")"
  [ -f "$f" ] || { printf '0\n'; return; }
  awk -v id="$2" '$1==id {c=$2} END{print c+0}' "$f"
}

bump_attempt() {
  local repo="$1" id="$2" f tmp c
  f="$(attempts_path "$repo")"
  mkdir -p "$(dirname "$f")"
  touch "$f"
  c="$(attempt_count "$repo" "$id")"
  c=$((c + 1))
  tmp="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  awk -v id="$id" -v c="$c" '
    $1==id {next}
    {print}
    END {print id, c}
  ' "$f" >"$tmp"
  mv "$tmp" "$f"
  printf '%s\n' "$c"
}

mark_handled() {
  local repo="$1" id="$2" f
  f="$(handled_path "$repo")"
  mkdir -p "$(dirname "$f")"
  touch "$f"
  grep -qx "$id" "$f" 2>/dev/null && return 0
  printf '%s\n' "$id" >>"$f"
}

is_handled() {
  local repo="$1" id="$2" f
  f="$(handled_path "$repo")"
  [ -f "$f" ] && grep -qx "$id" "$f" 2>/dev/null
}

find_artifact_manifest() {
  local app="$1" repo="$2" oid="$3" artifact_root="${LASTGIT_ARTIFACT_ROOT:-$HOME/.lastgit/artifacts}"
  local f digest platform path
  [ -n "$oid" ] || return 1
  # Prefer builds/<app>/<oid>/<platform>.json (what CI publishes).
  platform="$(uname -s 2>/dev/null)-$(uname -m 2>/dev/null)"
  case "$platform" in
    Darwin-arm64) platform=darwin-arm64 ;;
    Darwin-x86_64) platform=darwin-x64 ;;
    Linux-x86_64|Linux-amd64) platform=linux-x64 ;;
    Linux-aarch64|Linux-arm64) platform=linux-arm64 ;;
    *) platform=darwin-arm64 ;;
  esac
  path="$artifact_root/builds/$app/$oid/$platform.json"
  if [ -f "$path" ]; then
    digest="$(jq -r '.manifest_digest // empty' "$path" 2>/dev/null || true)"
    if [ -n "$digest" ]; then
      printf '%s\n' "$digest"
      return 0
    fi
  fi
  for f in "$artifact_root"/manifests/*.json; do
    [ -f "$f" ] || continue
    digest="$(jq -r --arg app "$app" --arg repo "$repo" --arg oid "$oid" '
      select(.app == $app and (.repo == $repo or .repo == $app) and .source_oid == $oid)
      | .manifest_digest // empty
    ' "$f" 2>/dev/null || true)"
    if [ -n "$digest" ]; then
      printf '%s\n' "$digest"
      return 0
    fi
  done
  return 1
}

# build_and_publish_artifact — a LastGit-native repo has no Forgejo `publish`
# job to build the binary and call `lastgit artifact publish` after a merge
# (that job lives in .forgejo/workflows/ci.yml, which only Forgejo Actions
# runs). This is only reached for a repo whose merge came in as a LastGit CR
# in the first place (poll_fleet reads `lastgit cr list --all-open`), so a
# Forgejo-venue repo (disabled on LastGit) never takes this path — see
# repo_venue(). Reproduces the same steps as that workflow's publish job:
# checkout the exact merge oid, run .lastgit/ci.sh once to produce build
# outputs, then `lastgit artifact publish` every .lastgit/artifacts.json entry
# for this app.
build_and_publish_artifact() {
  local app="$1" repo="$2" oid="$3" artifact_root="${LASTGIT_ARTIFACT_ROOT:-$HOME/.lastgit/artifacts}"
  local checkout entry app_paths platform digest rc
  [ -n "$oid" ] || return 1
  checkout="$(mktemp -d "${TMPDIR:-/tmp}/last-stack-post-merge-build.XXXXXX")"
  trap 'rm -rf "$checkout"' RETURN

  log "cloning lastdb:///$repo to build a missing $app artifact for oid=$oid ..."
  if ! git clone -q "lastdb:///$repo" "$checkout" >>"$LOG" 2>&1; then
    log "ERROR: git clone lastdb:///$repo failed; cannot build $app for oid=$oid"
    return 1
  fi
  if ! git -C "$checkout" checkout -q --detach "$oid" >>"$LOG" 2>&1; then
    log "ERROR: checkout $oid failed in $repo clone; cannot build $app"
    return 1
  fi
  if [ ! -f "$checkout/.lastgit/artifacts.json" ]; then
    log "ERROR: $repo@$oid has no .lastgit/artifacts.json; cannot build $app"
    return 1
  fi
  app_paths="$(jq -r --arg app "$app" '
    [.artifacts[]? | select(.app == $app and (.context == null or .context == "ci-required"))] | length
  ' "$checkout/.lastgit/artifacts.json" 2>/dev/null || printf 0)"
  if [ "$app_paths" = 0 ]; then
    log "ERROR: $repo@$oid's .lastgit/artifacts.json has no ci-required entry for app=$app; cannot build"
    return 1
  fi
  if [ ! -x "$checkout/.lastgit/ci.sh" ] && [ ! -f "$checkout/.lastgit/ci.sh" ]; then
    log "ERROR: $repo@$oid has no .lastgit/ci.sh; cannot build $app"
    return 1
  fi

  log "building $repo@$oid (.lastgit/ci.sh) to publish $app ..."
  rc=0
  if [ -n "$timeout_bin" ]; then
    ( cd "$checkout" \
      && LASTGIT_CI_CONTEXT=ci-required LASTGIT_CI_REPO="$repo" LASTGIT_CI_OID="$oid" \
         "$timeout_bin" "$BUILD_TIMEOUT" bash .lastgit/ci.sh ) >>"$LOG" 2>&1 || rc=$?
  else
    ( cd "$checkout" \
      && LASTGIT_CI_CONTEXT=ci-required LASTGIT_CI_REPO="$repo" LASTGIT_CI_OID="$oid" \
         bash .lastgit/ci.sh ) >>"$LOG" 2>&1 || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    log "ERROR: $repo@$oid .lastgit/ci.sh exited rc=$rc; cannot publish $app"
    return 1
  fi

  digest=""
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    app_paths="$(printf '%s' "$entry" | jq -r '.paths | join(",")')"
    platform="$(printf '%s' "$entry" | jq -r '.platform // empty')"
    digest="$(cd "$checkout" && lastgit artifact publish \
        --app "$app" --repo "$repo" --oid "$oid" --input . --paths "$app_paths" \
        ${platform:+--platform "$platform"} --root "$artifact_root" --json 2>>"$LOG" \
      | jq -r 'select(.manifest_digest != null) | .manifest_digest' | tail -n 1)"
    [ -n "$digest" ] || { log "ERROR: publish produced no manifest_digest for $app@$repo@$oid"; return 1; }
  done < <(jq -c --arg app "$app" \
    '.artifacts[] | select(.app == $app and (.context == null or .context == "ci-required"))' \
    "$checkout/.lastgit/artifacts.json")

  [ -n "$digest" ] || return 1
  printf '%s\n' "$digest"
}

run_artifact_promote_upgrade() {
  local app="$1" repo="$2" id="$3" oid="$4" artifact_root="${LASTGIT_ARTIFACT_ROOT:-$HOME/.lastgit/artifacts}"
  local digest
  if [ "$DRY_RUN" = 1 ]; then
    log "DRY_RUN: would promote $app artifact and refresh host-track repo=$repo cr=$id oid=$oid"
    return 0
  fi
  digest="$(find_artifact_manifest "$app" "$repo" "$oid" || true)"
  if [ -z "$digest" ]; then
    log "no published $app manifest for repo=$repo oid=$oid; building from source (LastGit-native merge, no Forgejo publish job) ..."
    digest="$(build_and_publish_artifact "$app" "$repo" "$oid" || true)"
  fi
  if [ -z "$digest" ]; then
    log "ERROR: $app artifact manifest missing and build failed repo=$repo cr=$id oid=$oid root=$artifact_root"
    return 1
  fi
  log "promoting $app artifact repo=$repo cr=$id oid=$oid manifest=$digest ..."
  lastgit artifact promote \
    --app "$app" \
    --channel stable \
    --manifest "$digest" \
    --repo "$repo" \
    --oid "$oid" \
    --context ci-required \
    --root "$artifact_root" \
    --json >/dev/null
  log "refreshing host-track $app from promoted artifact ..."
  host-track refresh "$app"
}

run_upgrade() {
  local app="$1" repo="$2" id="$3" oid="${4:-}" ht_app
  case "$app" in
    artifact:*)
      ht_app="${app#artifact:}"
      run_artifact_promote_upgrade "$ht_app" "$repo" "$id" "$oid"
      return
      ;;
  esac
  if [ ! -x "$UPGRADE_BIN" ]; then
    log "ERROR: last-stack-safe-upgrade-cli not found; cannot upgrade $app for $repo $id"
    return 1
  fi
  if [ "$DRY_RUN" = 1 ]; then
    log "DRY_RUN: would upgrade app=$app repo=$repo cr=$id"
    return 0
  fi
  log "upgrading app=$app repo=$repo cr=$id …"
  if [ -n "$timeout_bin" ]; then
    "$timeout_bin" "$UPGRADE_TIMEOUT" "$UPGRADE_BIN" "$app"
  else
    "$UPGRADE_BIN" "$app"
  fi
}

handle_departure() {
  # $1=repo $2=cr_id  (left the open set)
  local repo="$1" id="$2" view state base app attempts merge_oid head_oid upgrade_oid
  is_handled "$repo" "$id" && return 0

  app="$(map_repo_to_app "$repo")"
  if [ -z "$app" ]; then
    # Not a local-safe agent CLI — ignore permanently
    mark_handled "$repo" "$id"
    return 0
  fi

  view="$(lastgit cr view "$repo" "$id" --json 2>/dev/null || printf '{}')"
  state="$(printf '%s' "$view" | jq -r '.state // empty')"
  case "$state" in
    merged) ;;
    open|merging|'')
      # Transient: the CR left the open index while the completer (or a lagging
      # view read) still shows it in flight. Marking it handled here burns the
      # only departure event this watcher gets for the CR, so a merge that
      # lands seconds later is never installed (loom cr-mtgf4rnz-5d48,
      # 2026-08-30). Defer: the caller keeps the key in the open snapshot and
      # the next pass re-reads the settled state.
      log "defer $repo $id state=${state:-unreadable} (transient; next pass re-reads)"
      return 2
      ;;
    *)
      # closed without merge — don't upgrade, don't retry forever
      mark_handled "$repo" "$id"
      log "skip $repo $id state=$state (not merged)"
      return 0
      ;;
  esac

  base="$(printf '%s' "$view" | jq -r '.base_ref // .base_branch // empty' | sed 's#^refs/heads/##')"
  if [ -n "$base" ] && [ "$base" != "main" ]; then
    mark_handled "$repo" "$id"
    log "skip $repo $id base=$base (not main)"
    return 0
  fi

  merge_oid="$(printf '%s' "$view" | jq -r '.merge_oid // empty')"
  head_oid="$(printf '%s' "$view" | jq -r '.head_oid // empty')"
  upgrade_oid="${merge_oid:-$head_oid}"

  if run_upgrade "$app" "$repo" "$id" "$upgrade_oid"; then
    mark_handled "$repo" "$id"
    log "OK upgraded app=$app after $repo $id oid=$upgrade_oid"
    return 0
  fi

  attempts="$(bump_attempt "$repo" "$id")"
  log "FAIL upgrade app=$app repo=$repo cr=$id attempt=$attempts/$MAX_ATTEMPTS"
  if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
    mark_handled "$repo" "$id"
    case "$app" in
      artifact:*)
        log "GIVE_UP app=$app repo=$repo cr=$id after $attempts attempts (main stays merged; publish+promote $repo@$upgrade_oid for app=${app#artifact:} by hand, then run: host-track refresh ${app#artifact:})"
        ;;
      *)
        log "GIVE_UP app=$app repo=$repo cr=$id after $attempts attempts (main stays merged; run manually: last-stack-safe-upgrade-cli $app)"
        ;;
    esac
  fi
  return 0
}

poll_fleet() {
  local open_path tmp_open key repo id rc
  mkdir -p "$STATE_DIR"
  open_path="$(fleet_open_path)"
  tmp_open="$(mktemp "${TMPDIR:-/tmp}/post-merge-open.XXXXXX")"

  if ! lastgit cr list --all-open --json 2>/dev/null \
      | jq -r '.[] | "\(.repo):\(.cr_id)"' \
      | sort -u >"$tmp_open"; then
    log "fleet open list failed; skipping pass"
    rm -f "$tmp_open"
    return 0
  fi

  if [ ! -f "$open_path" ]; then
    # Cold seed: do not upgrade historical merges
    mv "$tmp_open" "$open_path"
    log "seeded fleet open set ($(grep -c . "$open_path" 2>/dev/null || echo 0) open CRs; no upgrades)"
    return 0
  fi

  while IFS= read -r key; do
    [ -n "$key" ] || continue
    if grep -qx "$key" "$tmp_open" 2>/dev/null; then
      continue
    fi
    repo="${key%%:*}"
    id="${key#*:}"
    [ -n "$repo" ] && [ -n "$id" ] || continue
    rc=0
    handle_departure "$repo" "$id" || rc=$?
    if [ "$rc" -eq 2 ]; then
      # Still in flight: keep the key so the next pass sees the departure again.
      printf '%s\n' "$key" >>"$tmp_open"
    fi
  done <"$open_path"

  mv "$tmp_open" "$open_path"
}

# --- convergence tail --------------------------------------------------------
# A main tip used to get its CI record and published build only when the NEXT
# CR merged, so a quiet repo stranded its last merge as main_unpublished
# (papercut-post-merge-pass-certifies-previous-merge-quiet-repo-strands-tip).
# A ref watcher cannot recover that tip after its cursor passes the merge event.
# Run the exact object directly instead. The command does not read or advance a
# ref-event cursor. Re-read the exact tip status before refresh.

CONVERGE="${LAST_STACK_POST_MERGE_CONVERGE:-1}"
CONVERGE_AFTER="${LAST_STACK_POST_MERGE_CONVERGE_AFTER:-300}"
CONVERGE_TIMEOUT="${LAST_STACK_POST_MERGE_CONVERGE_TIMEOUT:-600}"
CONVERGE_INTERVAL="${LAST_STACK_POST_MERGE_CONVERGE_INTERVAL:-300}"

converge_repos() {
  printf 'last-stack\nbrain\nsituations\nfkanban\nroutines\nlastsecrets\nconfigurations\nremote\nsearch\nloom\n'
}

tip_seen_path() { printf '%s/%s.tip-seen\n' "$STATE_DIR" "$1"; }

# Gate of record for a repo: lastgit, forgejo, or github. Forgejo-venue repos
# (fold, lastgit, and since 2026-09-05 last-stack, fkanban, routines, loom —
# brain decision-2026-09-05-factory-repos-venue-back-to-forgejo) have no
# moving LastGit ref and no ci-required row on the node: their Forge CI
# publish job promotes the stable channel, so the only convergence left here
# is "install the channel head". Reading `lastgit ref`/`ci status` for them
# would answer from a frozen tip, or fail once the repo is disabled.
repo_venue() {
  local resolver
  resolver="$(command -v last-stack-pr-venue 2>/dev/null || true)"
  # Resolve the file symlink chain before dirname: the PATH link
  # ~/.local/bin/<name> points into the artifact tree, and siblings live there.
  _self_src="$0"
  while [ -L "$_self_src" ]; do
    _self_link="$(readlink "$_self_src")"
    case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
  done
  [ -x "$resolver" ] || resolver="$(dirname "$_self_src")/last-stack-pr-venue"
  [ -x "$resolver" ] || resolver="$HOME/.last-stack/bin/last-stack-pr-venue"
  [ -x "$resolver" ] || { printf 'lastgit\n'; return 0; }
  "$resolver" "EdgeVector/$1" 2>/dev/null || printf 'lastgit\n'
}

converge_one() {
  # NOTE: the two `success)` branches below call plain `host-track refresh
  # "$ht_app"` on the assumption that a manifest for this tip is already
  # published to the stable channel. That assumption does not hold for a
  # LastGit-native repo with no Forgejo publish job (see
  # build_and_publish_artifact / run_artifact_promote_upgrade above, added
  # for era-3's merge-departure path) — a lone ci-required success here never
  # built or published anything. Left as a known follow-up gap rather than
  # widened in this change: this tail only fires when a repo went quiet
  # without a next CR to certify its tip, an edge case, not the common path.
  local repo="$1" app ht_app ht_status eligible tip state seen_file seen_tip seen_epoch now
  local attempt_key attempts ci_rc current_tip
  app="$(map_repo_to_app "$repo")"
  case "$app" in
    artifact:*) ht_app="${app#artifact:}" ;;
    *) return 0 ;;
  esac

  if [ "$(repo_venue "$repo")" = "forgejo" ]; then
    ht_status="$(host-track status --json "$ht_app" 2>/dev/null || true)"
    if [ "$(printf '%s\n' "$ht_status" | jq -r '.stale // "null" | tostring' 2>/dev/null)" = "true" ]; then
      log "converge $repo (forgejo venue): stable channel moved; refreshing $ht_app"
      host-track refresh "$ht_app" >/dev/null 2>&1 \
        || log "converge $repo: refresh failed (next tick retries)"
    fi
    rm -f "$(tip_seen_path "$repo")"
    return 0
  fi

  seen_file="$(tip_seen_path "$repo")"
  ht_status="$(host-track status --json "$ht_app" 2>/dev/null || true)"
  eligible="$(printf '%s\n' "$ht_status" | jq -r '
    if .install_mode == "artifact"
      and .stale == false
      and .main_unpublished == true
    then "1" else "0" end
  ' 2>/dev/null || printf 0)"
  if [ "$eligible" != 1 ]; then
    rm -f "$seen_file"
    return 0
  fi

  tip="$(lastgit ref "$repo" main 2>/dev/null | awk '{print $1}')"
  [ -n "$tip" ] || return 0
  state="$(lastgit ci status "$tip" --repo "$repo" --json 2>/dev/null \
    | jq -r '.state // empty' 2>/dev/null || true)"
  case "$state" in
    success)
      rm -f "$seen_file"
      log "converge $repo tip=$tip: status already success; refreshing $ht_app"
      host-track refresh "$ht_app" >/dev/null 2>&1 \
        || log "converge $repo: refresh failed (next tick retries)"
      return 0
      ;;
    failure)
      rm -f "$seen_file"
      log "converge $repo tip=$tip: ci-required failure is visible; not retrying a terminal verdict"
      return 0
      ;;
  esac
  now="$(date +%s)"
  seen_tip=""
  seen_epoch=""
  if [ -f "$seen_file" ]; then
    seen_tip="$(awk '{print $1}' "$seen_file")"
    seen_epoch="$(awk '{print $2}' "$seen_file")"
  fi
  if [ "$seen_tip" != "$tip" ]; then
    # First sighting: give the forge its own window before hand-running.
    printf '%s %s\n' "$tip" "$now" >"$seen_file"
    return 0
  fi
  if [ $((now - ${seen_epoch:-$now})) -lt "$CONVERGE_AFTER" ]; then
    return 0
  fi
  attempt_key="tip-$tip"
  attempts="$(attempt_count "$repo" "$attempt_key")"
  if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
    log "GIVE_UP converge repo=$repo tip=$tip after $attempts attempts; ci state=${state:-missing} remains visible"
    return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then
    log "DRY_RUN: would run ci-required for exact current tip repo=$repo tip=$tip (unpublished ${CONVERGE_AFTER}s+)"
    return 0
  fi

  log "converge $repo tip=$tip: unpublished for ${CONVERGE_AFTER}s+; exact-object ci run"
  set +e
  if [ -n "$timeout_bin" ]; then
    "$timeout_bin" "$((CONVERGE_TIMEOUT + 30))" lastgit ci run \
      --repo "$repo" --oid "$tip" --context ci-required \
      --timeout-ms "$((CONVERGE_TIMEOUT * 1000))" \
      --json >>"$LOG" 2>&1
    ci_rc=$?
  else
    lastgit ci run --repo "$repo" --oid "$tip" --context ci-required \
      --timeout-ms "$((CONVERGE_TIMEOUT * 1000))" \
      --json >>"$LOG" 2>&1
    ci_rc=$?
  fi
  set -e

  state="$(lastgit ci status "$tip" --repo "$repo" --json 2>/dev/null \
    | jq -r '.state // empty' 2>/dev/null || true)"
  case "$state" in
    success)
      current_tip="$(lastgit ref "$repo" main 2>/dev/null | awk '{print $1}')"
      if [ "$current_tip" != "$tip" ]; then
        rm -f "$seen_file"
        log "converge $repo: main moved during gate old=$tip current=$current_tip; next tick owns current"
        return 0
      fi
      rm -f "$seen_file"
      log "converge $repo: exact tip certified; refreshing $ht_app"
      host-track refresh "$ht_app" >/dev/null 2>&1 \
        || log "converge $repo: refresh failed (next tick retries)"
      log "converged $repo tip=$tip"
      ;;
    failure)
      rm -f "$seen_file"
      log "FAIL converge repo=$repo tip=$tip state=failure; terminal ci-required verdict remains visible"
      ;;
    *)
      attempts="$(bump_attempt "$repo" "$attempt_key")"
      log "converge $repo: exact ci run rc=$ci_rc left state=${state:-missing} attempt=$attempts/$MAX_ATTEMPTS"
      if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
        log "GIVE_UP converge repo=$repo tip=$tip after $attempts attempts; status remains ${state:-missing}"
      fi
      ;;
  esac
}

converge_pass() {
  [ "$CONVERGE" = "1" ] || return 0
  command -v lastgit >/dev/null 2>&1 || return 0
  local marker now last repo
  marker="$STATE_DIR/last-converge-epoch"
  now="$(date +%s)"
  last="$(cat "$marker" 2>/dev/null || printf 0)"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge "$CONVERGE_INTERVAL" ] || return 0
  printf '%s\n' "$now" >"$marker"
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    converge_one "$repo" || true
  done < <(converge_repos)
}

log "start mode=all state_dir=$STATE_DIR interval=${INTERVAL}s once=$ONCE upgrade=${UPGRADE_BIN:-MISSING} dry_run=$DRY_RUN"

if [ "$ONCE" = 1 ]; then
  poll_fleet
  converge_pass || true
  exit 0
fi

while true; do
  poll_fleet || true
  converge_pass || true
  sleep "$INTERVAL"
done
