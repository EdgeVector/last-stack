#!/usr/bin/env bash
# last-stack-post-merge-safe-upgrade — after a PR merges to main on GitHub, run
# host-track refresh for the mapped artifact apps. CI stays pure; this is
# install-only. LastGit is retired (decision-2026-09-29-retire-lastgit-all-repos-to-github):
# the GitHub `ci-required` + publish workflow builds the artifact and
# `host-track refresh <app>` pulls it (last-stack-github-artifact-pull).
#
# Flow (one pass):
#   for each mapped repo: `gh pr list --state merged --base main` → a merged PR
#   not yet handled → `host-track refresh <app>`. The first pass only seeds the
#   handled set (no upgrades for history). A refresh can hold while the publish
#   job is still running, so the convergence tail re-runs the refresh whenever
#   host-track reports the app stale or main unpublished.
#
# Failure does NOT unmerge. Logs + leaves the PR un-recorded so the next poll
# retries (capped by LAST_STACK_POST_MERGE_MAX_ATTEMPTS, default 3).
#
# Usage:
#   last-stack-post-merge-safe-upgrade --all [<state-dir>]
#   last-stack-post-merge-safe-upgrade --once --all [<state-dir>]
#   last-stack-post-merge-safe-upgrade --map   # print repo→app map
#
# Env:
#   LAST_STACK_POST_MERGE_INTERVAL   poll seconds (default 20)
#   LAST_STACK_POST_MERGE_STATE_DIR  default ~/.local/state/last-stack/post-merge-safe-upgrade
#   LAST_STACK_POST_MERGE_TIMEOUT    seconds per upgrade (default 600)
#   LAST_STACK_POST_MERGE_MAX_ATTEMPTS  retries per PR (default 3)
#   LAST_STACK_POST_MERGE_DRY_RUN=1  log only
#   LAST_STACK_POST_MERGE_GH_ORG     GitHub org (default EdgeVector)
set -euo pipefail

ONCE=0
MODE=""
STATE_DIR=""
SHOW_MAP=0

while [ $# -gt 0 ]; do
  case "$1" in
    --once) ONCE=1; shift ;;
    --all) MODE=all; shift ;;
    --map) SHOW_MAP=1; shift ;;
    -h|--help)
      awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 0
      ;;
    --) shift; break ;;
    -*)
      echo "post-merge-safe-upgrade: unknown flag: $1" >&2
      exit 2
      ;;
    *)
      if [ -z "$STATE_DIR" ]; then STATE_DIR=$1; shift
      else
        echo "post-merge-safe-upgrade: unexpected arg: $1" >&2
        exit 2
      fi
      ;;
  esac
done

# repo slug → install action (empty = skip)
# Artifact-backed apps use `artifact:<host-track-app>` so merge → host-track
# refresh (track_gate_main promotes stable to green+published main). Remaining
# local-safe CLIs keep last-stack-safe-upgrade-cli.
map_repo_to_app() {
  case "$1" in
    last-stack) printf 'artifact:last-stack\n' ;;
    brain) printf 'artifact:brain\n' ;;
    situations) printf 'artifact:situations\n' ;;
    # The repo is still `fkanban`; the host-track APP and public CLI are
    # `kanban`. Emitting `artifact:fkanban` would name an app that no longer
    # exists in the registry.
    fkanban|kanban) printf 'artifact:kanban\n' ;;
    routines) printf 'artifact:routines\n' ;;
    lastsecrets) printf 'artifact:lastsecrets\n' ;;
    configurations) printf 'artifact:configurations\n' ;;
    remote) printf 'artifact:remote\n' ;;
    search) printf 'artifact:search\n' ;;
    loom) printf 'artifact:loom\n' ;;
    *) printf '\n' ;;
  esac
}

if [ "$SHOW_MAP" = 1 ]; then
  for r in last-stack brain situations fkanban kanban routines lastsecrets configurations remote search loom; do
    printf '%-16s -> %s\n' "$r" "$(map_repo_to_app "$r")"
  done
  exit 0
fi

[ "$MODE" = "all" ] || {
  echo "usage: last-stack-post-merge-safe-upgrade --all [<state-dir>] [--once]" >&2
  exit 2
}

STATE_DIR="${STATE_DIR:-${LAST_STACK_POST_MERGE_STATE_DIR:-$HOME/.local/state/last-stack/post-merge-safe-upgrade}}"
INTERVAL="${LAST_STACK_POST_MERGE_INTERVAL:-20}"
UPGRADE_TIMEOUT="${LAST_STACK_POST_MERGE_TIMEOUT:-600}"
MAX_ATTEMPTS="${LAST_STACK_POST_MERGE_MAX_ATTEMPTS:-3}"
DRY_RUN="${LAST_STACK_POST_MERGE_DRY_RUN:-0}"
GH_ORG="${LAST_STACK_POST_MERGE_GH_ORG:-EdgeVector}"

UPGRADE_BIN="$(command -v last-stack-safe-upgrade-cli 2>/dev/null || true)"
if [ -z "$UPGRADE_BIN" ] && [ -x "$HOME/.local/bin/last-stack-safe-upgrade-cli" ]; then
  UPGRADE_BIN="$HOME/.local/bin/last-stack-safe-upgrade-cli"
fi
if [ -z "$UPGRADE_BIN" ] && [ -x "$HOME/.last-stack/bin/last-stack-safe-upgrade-cli" ]; then
  UPGRADE_BIN="$HOME/.last-stack/bin/last-stack-safe-upgrade-cli"
fi

timeout_bin=""
if command -v timeout >/dev/null 2>&1; then
  timeout_bin="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  timeout_bin="gtimeout"
fi

mkdir -p "$STATE_DIR"
LOG="${LAST_STACK_POST_MERGE_LOG:-$STATE_DIR/post-merge.log}"

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG" >&2
}

fleet_open_path() { printf '%s/fleet.open\n' "$STATE_DIR"; }
handled_path() { printf '%s/%s.handled\n' "$STATE_DIR" "$1"; }
attempts_path() { printf '%s/%s.attempts\n' "$STATE_DIR" "$1"; }

attempt_count() {
  # $1=repo $2=cr_id
  local f
  f="$(attempts_path "$1")"
  [ -f "$f" ] || { printf '0\n'; return; }
  awk -v id="$2" '$1==id {c=$2} END{print c+0}' "$f"
}

bump_attempt() {
  local repo="$1" id="$2" f tmp c
  f="$(attempts_path "$repo")"
  mkdir -p "$(dirname "$f")"
  touch "$f"
  c="$(attempt_count "$repo" "$id")"
  c=$((c + 1))
  tmp="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  awk -v id="$id" -v c="$c" '
    $1==id {next}
    {print}
    END {print id, c}
  ' "$f" >"$tmp"
  mv "$tmp" "$f"
  printf '%s\n' "$c"
}

mark_handled() {
  local repo="$1" id="$2" f
  f="$(handled_path "$repo")"
  mkdir -p "$(dirname "$f")"
  touch "$f"
  grep -qx "$id" "$f" 2>/dev/null && return 0
  printf '%s\n' "$id" >>"$f"
}

is_handled() {
  local repo="$1" id="$2" f
  f="$(handled_path "$repo")"
  [ -f "$f" ] && grep -qx "$id" "$f" 2>/dev/null
}


run_upgrade() {
  local app="$1" repo="$2" id="$3" oid="${4:-}" ht_app
  case "$app" in
    artifact:*)
      ht_app="${app#artifact:}"
      if [ "$DRY_RUN" = 1 ]; then
        log "DRY_RUN: would refresh host-track $ht_app repo=$repo pr=$id oid=$oid"
        return 0
      fi
      log "refreshing host-track $ht_app after $repo pr=$id oid=$oid ..."
      if [ -n "$timeout_bin" ]; then
        "$timeout_bin" "$UPGRADE_TIMEOUT" host-track refresh "$ht_app" >>"$LOG" 2>&1
      else
        host-track refresh "$ht_app" >>"$LOG" 2>&1
      fi
      return
      ;;
  esac
  if [ ! -x "$UPGRADE_BIN" ]; then
    log "ERROR: last-stack-safe-upgrade-cli not found; cannot upgrade $app for $repo $id"
    return 1
  fi
  if [ "$DRY_RUN" = 1 ]; then
    log "DRY_RUN: would upgrade app=$app repo=$repo pr=$id"
    return 0
  fi
  log "upgrading app=$app repo=$repo pr=$id …"
  if [ -n "$timeout_bin" ]; then
    "$timeout_bin" "$UPGRADE_TIMEOUT" "$UPGRADE_BIN" "$app"
  else
    "$UPGRADE_BIN" "$app"
  fi
}

handle_merge() {
  # $1=repo $2=pr number $3=merge commit oid (may be empty)
  local repo="$1" id="$2" oid="$3" app attempts
  is_handled "$repo" "$id" && return 0

  app="$(map_repo_to_app "$repo")"
  if [ -z "$app" ]; then
    # Not a mapped app — ignore permanently
    mark_handled "$repo" "$id"
    return 0
  fi

  if run_upgrade "$app" "$repo" "$id" "$oid"; then
    mark_handled "$repo" "$id"
    log "OK upgraded app=$app after $repo pr=$id oid=$oid"
    return 0
  fi

  attempts="$(bump_attempt "$repo" "$id")"
  log "FAIL upgrade app=$app repo=$repo pr=$id attempt=$attempts/$MAX_ATTEMPTS"
  if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
    mark_handled "$repo" "$id"
    case "$app" in
      artifact:*)
        log "GIVE_UP app=$app repo=$repo pr=$id after $attempts attempts (main stays merged; run by hand: host-track refresh ${app#artifact:})"
        ;;
      *)
        log "GIVE_UP app=$app repo=$repo pr=$id after $attempts attempts (main stays merged; run manually: last-stack-safe-upgrade-cli $app)"
        ;;
    esac
  fi
  return 0
}

converge_repos() {
  printf 'last-stack\nbrain\nsituations\nfkanban\nroutines\nlastsecrets\nconfigurations\nremote\nsearch\nloom\n'
}

# Gate of record for a repo: github (default) or forgejo (only the lastgit repo).
repo_venue() {
  local resolver
  # Prefer the sibling of this script (same artifact tree) over PATH: the PATH
  # link ~/.local/bin/<name> points into the artifact tree, so resolve the
  # symlink chain before dirname.
  _self_src="$0"
  while [ -L "$_self_src" ]; do
    _self_link="$(readlink "$_self_src")"
    case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
  done
  resolver="$(dirname "$_self_src")/last-stack-pr-venue"
  [ -x "$resolver" ] || resolver="$(command -v last-stack-pr-venue 2>/dev/null || true)"
  [ -x "$resolver" ] || resolver="$HOME/.last-stack/bin/last-stack-pr-venue"
  [ -x "$resolver" ] || { printf 'github\n'; return 0; }
  "$resolver" "$GH_ORG/$1" 2>/dev/null || printf 'github\n'
}

# poll_fleet — read merged PRs on main for each mapped github-venue repo. The
# first pass only seeds the handled set, so history is never upgraded.
poll_fleet() {
  local repo seed_marker rows num oid
  mkdir -p "$STATE_DIR"
  seed_marker="$STATE_DIR/github.seeded"
  if ! command -v gh >/dev/null 2>&1; then
    log "gh not on PATH; skipping merge poll"
    return 0
  fi
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    [ "$(repo_venue "$repo")" = "github" ] || continue
    rows="$(gh pr list -R "$GH_ORG/$repo" --state merged --base main --limit 20 \
      --json number,mergeCommit --jq '.[] | "\(.number)\t\(.mergeCommit.oid // "-")"' 2>/dev/null)" || {
      log "merged PR list failed for $repo; skipping"
      continue
    }
    # Oldest first, so installs follow merge order.
    rows="$(printf '%s\n' "$rows" | sort -n)"
    while IFS=$'\t' read -r num oid; do
      [ -n "$num" ] || continue
      [ "$oid" != "-" ] || oid=""
      if [ ! -f "$seed_marker" ]; then
        mark_handled "$repo" "$num"
        continue
      fi
      handle_merge "$repo" "$num" "$oid" </dev/null || true
    done < <(printf '%s\n' "$rows")
  done < <(converge_repos)
  if [ ! -f "$seed_marker" ]; then
    : >"$seed_marker"
    log "seeded merged PR set (no upgrades for history)"
  fi
}

# --- convergence tail --------------------------------------------------------
# A refresh right after a merge can hold: the GitHub publish job is still
# building the artifact, and `host-track refresh` keeps the channel (exit 0)
# until main is green and published. Re-run the refresh while host-track says
# the app is stale or main is unpublished, so a quiet repo still converges.

CONVERGE="${LAST_STACK_POST_MERGE_CONVERGE:-1}"
CONVERGE_INTERVAL="${LAST_STACK_POST_MERGE_CONVERGE_INTERVAL:-300}"

converge_one() {
  local repo="$1" app ht_app ht_status behind
  app="$(map_repo_to_app "$repo")"
  case "$app" in
    artifact:*) ht_app="${app#artifact:}" ;;
    *) return 0 ;;
  esac
  [ "$(repo_venue "$repo")" = "github" ] || return 0
  ht_status="$(host-track status --json "$ht_app" 2>/dev/null || true)"
  behind="$(printf '%s\n' "$ht_status" | jq -r '
    if .install_mode == "artifact"
      and (.stale == true or .main_unpublished == true)
    then "1" else "0" end
  ' 2>/dev/null || printf 0)"
  [ "$behind" = 1 ] || return 0
  if [ "$DRY_RUN" = 1 ]; then
    log "DRY_RUN: would refresh host-track $ht_app (converge repo=$repo)"
    return 0
  fi
  log "converge $repo: $ht_app is stale or main unpublished; refreshing"
  host-track refresh "$ht_app" >>"$LOG" 2>&1 \
    || log "converge $repo: refresh failed (next tick retries)"
}

converge_pass() {
  [ "$CONVERGE" = "1" ] || return 0
  command -v host-track >/dev/null 2>&1 || return 0
  local marker now last repo
  marker="$STATE_DIR/last-converge-epoch"
  now="$(date +%s)"
  last="$(cat "$marker" 2>/dev/null || printf 0)"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge "$CONVERGE_INTERVAL" ] || return 0
  printf '%s\n' "$now" >"$marker"
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    converge_one "$repo" || true
  done < <(converge_repos)
}

log "start mode=all state_dir=$STATE_DIR interval=${INTERVAL}s once=$ONCE upgrade=${UPGRADE_BIN:-MISSING} dry_run=$DRY_RUN"

if [ "$ONCE" = 1 ]; then
  poll_fleet
  converge_pass || true
  exit 0
fi

while true; do
  poll_fleet || true
  converge_pass || true
  sleep "$INTERVAL"
done
