#!/usr/bin/env python3
"""Close Brain papercuts whose completed review or prevention evidence is covered."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any


TRANSIENT_ERRORS = (
    "node socket not reachable",
    "service_timeout",
    "node did not respond",
    "too many concurrent reads",
    "uds_connection_limit",
)
LASTGIT_RE = re.compile(r"\blastgit://([^/\s)>\]]+)/cr/([^/\s)>\]]+)")
FORGE_RE = re.compile(r"https?://[^/\s)>\]]+/([^/\s)>\]]+)/([^/\s)>\]]+)/pulls?/(\d+)")
GITHUB_RE = re.compile(r"https?://github\.com/([^/\s)>\]]+)/([^/\s)>\]]+)/pull/(\d+)")
PIPELINE_STUCK_SLUG_RE = re.compile(r"^papercut-pipeline-stuck-(cr|forge|pr)-")
# A LastGit CR id carries a disambiguator suffix (`cr-msc85npn-c483`), so the
# tail is at most two `-`-joined runs. Bounded on purpose: an unbounded
# `([a-z0-9-]+)$` would let the prefix give back a repo name containing `-cr-`.
STUCK_CR_SLUG_RE = re.compile(r"^papercut-pipeline-stuck-cr-(.+?)-cr-([a-z0-9]+(?:-[a-z0-9]+)?)$")
# `pipeline-health` files these as `...-forge-<repo>-pr-<num>` / `...-pr-<repo>-pr-<num>`.
# A greedy `(.+)-(\d+)` swallowed the `-pr` marker into the repo name and then
# called a repo that does not exist (`EdgeVector/fold-pr/pulls/826` -> 404).
# Both `-pr-1018` and `-pr1018` are in the ledger; the second spelling is the
# more common one and matched nothing until 2026-09-04.
STUCK_FORGE_SLUG_RE = re.compile(r"^papercut-pipeline-stuck-forge-(.+?)(?:-pr-?|-)(\d+)$")
STUCK_PR_SLUG_RE = re.compile(r"^papercut-pipeline-stuck-pr-(.+?)(?:-pr-?|-)(\d+)$")
# `pipeline-health` also files a forge PR under the `-cr-` prefix
# (`...-cr-fold-1709`), and a CR with no `-cr-` before its short id
# (`...-cr-last-stack-msh21rhh`). Neither shape reaches the two patterns above.
STUCK_CR_PREFIXED_PR_SLUG_RE = re.compile(r"^papercut-pipeline-stuck-cr-(.+)-(\d+)$")
STUCK_BARE_CR_SLUG_RE = re.compile(r"^papercut-pipeline-stuck-cr-(.+)-([a-z0-9]{6,12})$")
CR_FULL_RE = re.compile(r"\b(cr-[0-9a-z]{6,12}-[0-9a-z]{2,8})\b")
REPO_HEADER_RE = re.compile(r"(?im)^Repo:\s*(\S+)")
# Only a labeled field may contribute a review ref. A bare `cr-…`-shaped token
# in prose is a mention of somebody else's CR, not this papercut's own ref.
LABELED_REF_LINE_RE = re.compile(
    r"(?im)^\s*(?:PR|CR|Review|Change[- ]Request|Fixed[- ]by|Merged[- ]by)\s*:\s*(.+)$"
)
# Characters that quote or terminate a ref inside prose but are never part of a
# LastGit CR id, a forge repo name, or a PR number.
REF_TOKEN_TRIM = "`'\"*_~,;:.!?()[]{}<>"
FORGE_VENUE_REPOS = frozenset({"fold", "lastgit", "exemem-infra", "exemem-workspace"})


@dataclass(frozen=True)
class ReviewRef:
    kind: str
    url: str
    repo: str
    ident: str
    owner: str = ""


@dataclass(frozen=True)
class RegistryEntry:
    slug: str
    card: str


class BudgetExhausted(RuntimeError):
    """The pass used its whole wall-clock budget and must stop at a boundary."""


class Deadline:
    """One monotonic budget for the whole pass.

    Per-call timeouts alone do not bound a pass: `--limit 200` with a 20s read
    timeout and two retries is a 200-minute worst case, all-or-nothing, with no
    partial result. A loaded node turned that into a run that outlived its
    caller and printed nothing. Every call clamps to what is left here, and the
    pass stops at a record boundary and still reports.
    """

    def __init__(self, seconds: float | None) -> None:
        self.seconds = seconds
        self.exhausted = False
        self.unread = 0
        self._start = time.monotonic()

    def remaining(self) -> float:
        if self.seconds is None:
            return float("inf")
        return self.seconds - (time.monotonic() - self._start)

    def expired(self) -> bool:
        if self.remaining() > 0:
            return False
        self.exhausted = True
        return True

    def clamp(self, timeout: int) -> float:
        left = self.remaining()
        if left <= 0:
            self.exhausted = True
            raise BudgetExhausted(f"budget of {self.seconds}s exhausted")
        return min(float(timeout), left)


DEADLINE = Deadline(None)
# A killed child gets this long to release the pipe before we abandon its output.
KILL_DRAIN_SECONDS = 5


def _kill_tree(proc: subprocess.Popen[str]) -> None:
    """Kill the child and anything it spawned.

    `subprocess.run` kills only the direct child and then drains the pipe with
    no timeout. A grandchild that inherited stdout keeps that pipe open, so the
    drain never returns. Killing the session and bounding the drain closes both
    halves of that trap.
    """
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.kill()
        except ProcessLookupError:
            pass


def run(argv: list[str], *, stdin: str | None = None, timeout: int = 60) -> subprocess.CompletedProcess[str]:
    limit = DEADLINE.clamp(timeout)
    proc = subprocess.Popen(
        argv,
        stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=os.environ,
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(input=stdin, timeout=limit)
    except subprocess.TimeoutExpired:
        _kill_tree(proc)
        try:
            proc.communicate(timeout=KILL_DRAIN_SECONDS)
        except subprocess.TimeoutExpired:
            pass
        # A call the budget cut short is a budget stop, not a read timeout.
        # Callers handle the two differently: a read timeout skips one slug and
        # continues, which would spin through the rest of the list once the
        # budget is gone.
        if DEADLINE.remaining() <= 0:
            DEADLINE.exhausted = True
            raise BudgetExhausted(f"budget of {DEADLINE.seconds}s exhausted") from None
        raise
    except BaseException:
        _kill_tree(proc)
        raise
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


def is_transient(text: str) -> bool:
    return any(signal in text for signal in TRANSIENT_ERRORS)


def run_json(argv: list[str], *, timeout: int = 60) -> Any:
    last_error = ""
    for attempt in range(1, 4):
        proc = run(argv, timeout=timeout)
        if proc.returncode == 0:
            parsed = parse_json_stream(proc.stdout)
            if parsed is not None:
                return parsed
            raise RuntimeError(f"{' '.join(argv)} did not return JSON")
        last_error = f"{proc.stderr.strip()} {proc.stdout.strip()}".strip()
        if attempt == 3 or not is_transient(last_error):
            raise RuntimeError(f"{' '.join(argv)} failed: {last_error}")
        time.sleep(0.75)
    raise RuntimeError(last_error)


def parse_json_stream(raw: str) -> Any | None:
    decoder = json.JSONDecoder()
    idx = 0
    candidates: list[Any] = []
    while idx < len(raw):
        while idx < len(raw) and raw[idx].isspace():
            idx += 1
        if idx >= len(raw):
            break
        try:
            value, end = decoder.raw_decode(raw, idx)
        except json.JSONDecodeError:
            idx += 1
            continue
        candidates.append(value)
        idx = end
    if not candidates:
        return None
    for value in candidates:
        if isinstance(value, dict) and not is_timing_event(value):
            return value
    return candidates[0]


def is_timing_event(value: dict[str, Any]) -> bool:
    return value.get("event") == "verb_timing" or "duration_ms" in value and "verb" in value


def as_items(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    if isinstance(value, dict):
        for key in ("records", "items", "results", "rows"):
            items = value.get(key)
            if isinstance(items, list):
                return [item for item in items if isinstance(item, dict)]
    return []


def tool(name: str, env_name: str) -> str | None:
    override = os.environ.get(env_name)
    if override:
        return override
    return shutil.which(name)


def parse_registry_entries(registry: str, limit: int) -> list[RegistryEntry]:
    entries: list[RegistryEntry] = []
    current_slug = ""
    prevention = ""
    card = ""

    def flush() -> None:
        nonlocal current_slug, prevention, card
        if current_slug.startswith("papercut-") and prevention == "COVERED" and card:
            entries.append(RegistryEntry(current_slug, card))
        current_slug = ""
        prevention = ""
        card = ""

    for raw_line in registry.splitlines():
        line = raw_line.strip()
        heading = re.match(r"^#{3,}\s+(.+)$", line)
        if heading:
            flush()
            first = heading.group(1).split()[0].strip("`:,")
            current_slug = first if first.startswith("papercut-") else ""
            continue
        papercut = re.match(r"^-\s*Papercut:\s*`?([^`\s]+)`?", line)
        if papercut:
            current_slug = papercut.group(1)
            continue
        if re.match(r"^-\s*Prevention:\s*COVERED\b", line):
            prevention = "COVERED"
            continue
        card_match = re.match(r"^-\s*Card:\s*`?([^`\s()]+)`?", line)
        if card_match:
            card = card_match.group(1)
            continue
    flush()
    return entries[:limit]


def try_registry_close(args: argparse.Namespace, iso: str) -> dict[str, Any] | None:
    brain = tool(args.brain_bin, "LAST_STACK_PAPERCUT_LIFECYCLE_BRAIN")
    kanban = tool("kanban", "LAST_STACK_PAPERCUT_LIFECYCLE_KANBAN")
    if not brain or not kanban:
        missing = ",".join(name for name, path in (("brain", brain), ("kanban", kanban)) if not path)
        return {"ok": False, "reason": "lifecycle_dependency_missing", "missing": missing, "scanned": 0, "fixed": 0}

    try:
        registry_proc = run([brain, "get", "papercut-prevention-registry", "--type", "reference"], timeout=args.read_timeout)
    except subprocess.TimeoutExpired:
        return {"ok": False, "reason": "registry_read_timeout", "scanned": 0, "fixed": 0}
    if registry_proc.returncode != 0:
        return None

    entries = parse_registry_entries(registry_proc.stdout, args.limit)
    if not entries:
        return None

    scanned = 0
    fixed = 0
    skipped: list[str] = []
    for entry in entries:
        scanned += 1
        try:
            card_proc = run([kanban, "show", entry.card, "--json"], timeout=args.read_timeout)
        except subprocess.TimeoutExpired:
            skipped.append(f"{entry.slug}:card_timeout")
            continue
        if card_proc.returncode != 0:
            skipped.append(f"{entry.slug}:card_unreadable")
            continue
        try:
            card = json.loads(card_proc.stdout)
        except json.JSONDecodeError:
            skipped.append(f"{entry.slug}:card_bad_json")
            continue
        if card.get("column") != "done":
            skipped.append(f"{entry.slug}:card_not_done")
            continue

        try:
            typed_proc = run(
                [brain, "get", entry.slug, "--type", "papercut", "--json"],
                timeout=args.read_timeout,
            )
        except subprocess.TimeoutExpired:
            skipped.append(f"{entry.slug}:record_timeout")
            continue
        typed_record = parse_json_stream(typed_proc.stdout) if typed_proc.returncode == 0 else None
        if isinstance(typed_record, dict):
            if str(typed_record.get("status") or "") != "open":
                skipped.append(f"{entry.slug}:not_open")
                continue
            if args.dry_run:
                skipped.append(f"{entry.slug}:dry_run")
                continue
            evidence = (
                f"card:{entry.card} is done and the prevention registry is COVERED; "
                "confirmed by last-stack-papercut-lifecycle-close."
            )
            try:
                close_proc = run(
                    [
                        brain,
                        "papercut",
                        "close",
                        entry.slug,
                        "--status",
                        "fixed",
                        "--evidence",
                        evidence,
                        "--fixed-by",
                        f"card:{entry.card}",
                    ],
                    timeout=args.read_timeout,
                )
            except subprocess.TimeoutExpired:
                skipped.append(f"{entry.slug}:close_timeout")
                continue
            if close_proc.returncode != 0:
                skipped.append(f"{entry.slug}:close_failed")
                continue
            fixed += 1
            continue

        # Typed ledger miss: do not fall back to a prose Status: FIXED append.
        # That leaves queryable status=open while the body looks healed.
        skipped.append(f"{entry.slug}:untyped_skipped")

    return {
        "ok": True,
        "scanned": scanned,
        "candidates": len(entries),
        "fixed": fixed,
        "dry_run": args.dry_run,
        "skipped": skipped,
    }


def load_records(args: argparse.Namespace) -> list[dict[str, Any]]:
    if args.records_json:
        records = as_items(json.loads(Path(args.records_json).read_text(encoding="utf-8")))
        for record in records:
            if not str(record.get("status") or ""):
                body = str(record.get("body") or "")
                record["status"] = "open" if status_is_open(body) else "fixed"
            record["_typed"] = True
        return records
    if args.slug:
        records = []
        for index, slug in enumerate(args.slug):
            if DEADLINE.expired():
                DEADLINE.unread = len(args.slug) - index
                print(
                    f"warning: budget exhausted; {DEADLINE.unread} of {len(args.slug)} slugs unread",
                    file=sys.stderr,
                )
                break
            record = brain_get(args, slug)
            record["_typed"] = True
            records.append(record)
        return records
    previews = as_items(list_open_queue(args))
    slugs = [str(item.get("slug") or "") for item in previews if str(item.get("slug") or "").startswith("papercut-")]
    # Prefer the pipeline-stuck cluster so --limit 200 covers it instead of
    # the first page of unrelated open papercuts (the registry path used to
    # return after 3 COVERED rows and never reach this list at all).
    stuck = [slug for slug in slugs if PIPELINE_STUCK_SLUG_RE.match(slug)]
    rest = [slug for slug in slugs if slug not in set(stuck)]
    ordered = stuck + rest
    records: list[dict[str, Any]] = []
    selected = ordered[: args.limit]
    for index, slug in enumerate(selected):
        if DEADLINE.expired():
            DEADLINE.unread = len(selected) - index
            print(
                f"warning: budget exhausted; {DEADLINE.unread} of {len(selected)} slugs unread",
                file=sys.stderr,
            )
            break
        try:
            record = brain_get(args, slug)
            record["_typed"] = True
            records.append(record)
        except BudgetExhausted:
            DEADLINE.unread = len(selected) - index
            print(
                f"warning: budget exhausted; {DEADLINE.unread} of {len(selected)} slugs unread",
                file=sys.stderr,
            )
            break
        except Exception as exc:
            print(f"warning: skipped {slug}: {exc}", file=sys.stderr)
    return records


# Index-only first: one keyed partition read, no per-row hydrate. The hydrated
# open ledger measured 214s wall on the primary (2026-09-03, 2171 rows), 10x
# this helper's --read-timeout, so every pass since 2026-08-30 ended in
# `brain_papercut_list_timeout` (papercut-lastdb-reconciler-policies-query-slow).
# Only the slug column is used here; each selected slug is point-got below.
OPEN_QUEUE_INDEX_ONLY = ["papercut", "list", "--status", "open", "--index-only", "--json"]
OPEN_QUEUE_HYDRATED = ["papercut", "list", "--status", "open", "--json"]


def rejects_index_only(proc: subprocess.CompletedProcess[str]) -> bool:
    """True when the installed brain predates `--index-only` and refused the flag."""
    text = f"{proc.stdout or ''}\n{proc.stderr or ''}".lower()
    if "index-only" not in text:
        return False
    return any(word in text for word in ("unknown", "unexpected", "unrecognized", "invalid option"))


def list_open_queue(args: argparse.Namespace) -> Any:
    """Open-queue rows; same transient retry as run_json, plus the old-brain fallback."""
    argv = [args.brain_bin, *OPEN_QUEUE_INDEX_ONLY]
    last_error = ""
    for attempt in range(1, 4):
        proc = run(argv, timeout=args.list_timeout)
        if proc.returncode == 0:
            parsed = parse_json_stream(proc.stdout)
            if parsed is not None:
                return parsed
            raise RuntimeError(f"{' '.join(argv)} did not return JSON")
        if rejects_index_only(proc):
            return run_json([args.brain_bin, *OPEN_QUEUE_HYDRATED], timeout=args.list_timeout)
        last_error = f"{proc.stderr.strip()} {proc.stdout.strip()}".strip()
        if attempt == 3 or not is_transient(last_error):
            raise RuntimeError(f"{' '.join(argv)} failed: {last_error}")
        time.sleep(0.75)
    raise RuntimeError(last_error)


def brain_get(args: argparse.Namespace, slug: str) -> dict[str, Any]:
    value = run_json(
        [args.brain_bin, "get", slug, "--type", "papercut", "--json"],
        timeout=args.read_timeout,
    )
    if not isinstance(value, dict):
        raise RuntimeError(f"brain get {slug} returned non-object JSON")
    return value


def status_is_open(body: str) -> bool:
    statuses = [m.group(1).upper() for m in re.finditer(r"(?im)^\s*Status:\s*([A-Z_]+)", body)]
    if not statuses:
        return False
    return statuses[-1] == "OPEN"


def repo_token(raw: str) -> str:
    token = ref_token(raw).rstrip("/")
    if "/" in token:
        token = token.rsplit("/", 1)[-1]
    return ref_token(token)


def ref_token(raw: str) -> str:
    """Strip the quoting/terminating punctuation prose wraps a ref in.

    Bodies write `lastgit://last-stack/cr/cr-mt1t6wpi-33a6;` or backtick-quote
    the URL. Those characters are not part of the id, and passing them through
    made every `lastgit cr view` call fail on a ref that really exists.
    """
    return raw.strip().strip(REF_TOKEN_TRIM).strip()


def owner_repo(raw: str) -> tuple[str, str]:
    """Split an `owner/name` header into its parts; owner may be absent."""
    token = ref_token(raw).rstrip("/")
    if "/" in token:
        owner, name = token.rsplit("/", 1)
        return ref_token(owner), ref_token(name)
    return "", ref_token(token)


def labeled_ref_values(body: str) -> list[str]:
    """Return the values of labeled ref fields (`PR:`, `Fixed by:`, …) only."""
    return [match.group(1) for match in LABELED_REF_LINE_RE.finditer(body)]


def review_refs(body: str, slug: str = "") -> tuple[list[ReviewRef], list[str]]:
    """Resolve a papercut's own review refs.

    Returns the resolvable refs plus typed reasons for refs that were named but
    could not be resolved. A ref is only taken from a structured source: an
    explicit review URL, a labeled `PR:`/`Fixed by:`-style field, or the
    papercut's own `pipeline-stuck-*` slug. Free prose is never scanned — a
    `cr-…`-shaped token elsewhere in the body belongs to some other record.
    """
    refs: list[ReviewRef] = []
    skips: list[str] = []
    seen: set[str] = set()

    def add(ref: ReviewRef) -> None:
        if ref.url not in seen:
            seen.add(ref.url)
            refs.append(ref)

    def skip(reason: str) -> None:
        if reason not in skips:
            skips.append(reason)

    for raw_repo, raw_ident in LASTGIT_RE.findall(body):
        repo = repo_token(raw_repo)
        ident = ref_token(raw_ident)
        if not repo or not ident:
            skip(f"unparseable-lastgit-ref:{raw_repo}/{raw_ident}")
            continue
        add(ReviewRef("lastgit", f"lastgit://{repo}/cr/{ident}", repo, ident))
    for raw_owner, raw_repo, num in GITHUB_RE.findall(body):
        owner = repo_token(raw_owner)
        repo = repo_token(raw_repo)
        if not owner or not repo:
            skip(f"unparseable-github-ref:{raw_owner}/{raw_repo}#{num}")
            continue
        add(ReviewRef("github", f"https://github.com/{owner}/{repo}/pull/{num}", repo, num, owner))
    for match in FORGE_RE.finditer(body):
        if "github.com" in match.group(0):
            continue
        owner = repo_token(match.group(1))
        repo = repo_token(match.group(2))
        num = match.group(3)
        if not owner or not repo:
            skip(f"unparseable-forge-ref:{match.group(1)}/{match.group(2)}#{num}")
            continue
        add(ReviewRef("forge", f"{owner}/{repo}/pulls/{num}", repo, num, owner))

    header_match = REPO_HEADER_RE.search(body)
    header_owner, header_repo = owner_repo(header_match.group(1)) if header_match else ("", "")
    stuck_cr = STUCK_CR_SLUG_RE.match(slug)
    if stuck_cr:
        repo = repo_token(stuck_cr.group(1))
        short = ref_token(stuck_cr.group(2))
        ident = f"cr-{short}"
        for full in CR_FULL_RE.findall(body):
            if full == ident or full.startswith(f"cr-{short}-"):
                ident = full
                break
        if repo:
            add(ReviewRef("lastgit", f"lastgit://{repo}/cr/{ident}", repo, ident))
        else:
            skip(f"unparseable-stuck-cr-slug:{slug}")
    stuck_forge = STUCK_FORGE_SLUG_RE.match(slug)
    if stuck_forge:
        # The body header names the real repo; the slug fragment is a guess.
        repo = header_repo or repo_token(stuck_forge.group(1))
        owner = header_owner or "EdgeVector"
        num = stuck_forge.group(2)
        if header_repo or repo in FORGE_VENUE_REPOS:
            add(ReviewRef("forge", f"{owner}/{repo}/pulls/{num}", repo, num, owner))
        else:
            skip(f"unmapped-forge-repo:{repo}")
    stuck_pr = STUCK_PR_SLUG_RE.match(slug)
    if stuck_pr:
        repo = header_repo or repo_token(stuck_pr.group(1))
        owner = header_owner or "EdgeVector"
        num = stuck_pr.group(2)
        if repo in FORGE_VENUE_REPOS:
            add(ReviewRef("forge", f"{owner}/{repo}/pulls/{num}", repo, num, owner))
        elif header_repo:
            add(ReviewRef("github", f"https://github.com/{owner}/{repo}/pull/{num}", repo, num, owner))
        else:
            skip(f"unmapped-pr-repo:{repo}")
    # A forge PR filed under the `-cr-` prefix: the tail is a PR number, not a
    # CR id, so `-cr-` in the slug says nothing about the venue.
    stuck_cr_pr = (
        STUCK_CR_PREFIXED_PR_SLUG_RE.match(slug) if not stuck_cr else None
    )
    if stuck_cr_pr:
        repo = header_repo or repo_token(stuck_cr_pr.group(1))
        owner = header_owner or "EdgeVector"
        num = stuck_cr_pr.group(2)
        if repo in FORGE_VENUE_REPOS:
            add(ReviewRef("forge", f"{owner}/{repo}/pulls/{num}", repo, num, owner))
        else:
            skip(f"unmapped-cr-pr-repo:{repo}")
    # A CR short id with no `-cr-` separator (`...-cr-last-stack-msh21rhh`).
    # The slug alone cannot tell a short id from a repo-name fragment, so the
    # body must corroborate it with a real `cr-<short>-<suffix>` token. Without
    # that the ref is a guess, and a guessed ref is what invented
    # `EdgeVector/fold-pr` and 404ed for four passes.
    stuck_bare_cr = (
        STUCK_BARE_CR_SLUG_RE.match(slug)
        if not stuck_cr and not stuck_cr_pr
        else None
    )
    if stuck_bare_cr:
        repo = repo_token(stuck_bare_cr.group(1))
        short = ref_token(stuck_bare_cr.group(2))
        ident = ""
        for full in CR_FULL_RE.findall(body):
            if full == f"cr-{short}" or full.startswith(f"cr-{short}-"):
                ident = full
                break
        if repo and ident:
            add(ReviewRef("lastgit", f"lastgit://{repo}/cr/{ident}", repo, ident))
        else:
            skip(f"uncorroborated-stuck-cr-slug:{slug}")
    if (
        header_repo
        and not stuck_cr
        and not stuck_forge
        and not stuck_pr
        and not stuck_cr_pr
        and not stuck_bare_cr
    ):
        for value in labeled_ref_values(body):
            for full in CR_FULL_RE.findall(value):
                add(ReviewRef("lastgit", f"lastgit://{header_repo}/cr/{full}", header_repo, full))
    return refs, skips


def review_state(args: argparse.Namespace, ref: ReviewRef) -> tuple[str, str]:
    """Normalized review state: `merged`, `closed`, `open`, or `unknown`.

    `merged` and `closed` are both TERMINAL — the review will not move again.
    Only a `pipeline-stuck` papercut may act on `closed`; see
    close_review_records for why the two classes read the same state
    differently.
    """
    if ref.kind == "lastgit":
        data = run_json([args.lastgit_bin, "cr", "view", ref.repo, ref.ident, "--json"], timeout=60)
        cr = data.get("cr") or data.get("change_request") or data if isinstance(data, dict) else {}
        state = str(cr.get("state") or cr.get("status") or "").lower()
        merge_oid = str(cr.get("merge_oid") or cr.get("mergeOid") or "")
        detail = f"lastgit:{ref.repo}/{ref.ident}"
        if state == "merged" or merge_oid:
            return "merged", detail
        return (state if state in ("closed", "open") else "unknown"), detail
    if ref.kind == "forge":
        data = run_json([args.forge_api_bin, f"repos/{ref.owner}/{ref.repo}/pulls/{ref.ident}"], timeout=60)
        state = str(data.get("state") or "").lower() if isinstance(data, dict) else ""
        merged = bool(data.get("merged")) if isinstance(data, dict) else False
        detail = f"forge:{ref.owner}/{ref.repo}#{ref.ident}"
        if merged or state == "merged":
            return "merged", detail
        return (state if state in ("closed", "open") else "unknown"), detail
    data = run_json(
        [
            args.gh_bin,
            "pr",
            "view",
            ref.ident,
            "-R",
            f"{ref.owner}/{ref.repo}",
            "--json",
            "state,mergedAt",
        ],
        timeout=60,
    )
    state = str(data.get("state") or "").lower() if isinstance(data, dict) else ""
    merged_at = str(data.get("mergedAt") or "") if isinstance(data, dict) else ""
    detail = f"github:{ref.owner}/{ref.repo}#{ref.ident}"
    if state == "merged" or merged_at:
        return "merged", detail
    return (state if state in ("closed", "open") else "unknown"), detail


def merged_status(args: argparse.Namespace, ref: ReviewRef) -> tuple[bool, str]:
    state, detail = review_state(args, ref)
    return state == "merged", detail


def append_brain(args: argparse.Namespace, slug: str, text: str) -> None:
    if args.dry_run:
        return
    proc = run([args.brain_bin, "append", slug, "--type", "reference"], stdin=text, timeout=60)
    if proc.returncode != 0:
        raise RuntimeError(f"brain append {slug} failed: {proc.stderr.strip()}")


def close_record(
    args: argparse.Namespace,
    record: dict[str, Any],
    ref: ReviewRef,
    detail: str,
    iso: str,
    state: str = "merged",
) -> None:
    slug = str(record.get("slug") or "")
    title = str(record.get("title") or slug)
    if args.dry_run:
        return
    if state == "merged":
        status = "fixed"
        evidence = f"lifecycle closer confirmed {ref.url} is merged ({detail})."
    else:
        # The claim was "this review is STUCK". A review that was closed without
        # merging is not stuck any more, and nothing was fixed — `wontfix` is the
        # only honest terminal status left in the enum.
        #
        # `wontfix` on a defect that still reproduces is status laundering
        # (papercut-reconciler-hygiene-retires-unfixed-defects-as-wontfix-...).
        # This close is not that: the condition retired here is the review being
        # stuck, and that condition provably ended. But a pipeline-stuck body
        # often ALSO carries a root-cause claim, and no automatic closer can
        # split that out into its own slug. So the evidence says so in its own
        # words, and every such close is reported separately from `fixed`.
        status = "wontfix"
        evidence = (
            f"lifecycle closer confirmed {ref.url} is closed without merging ({detail}); "
            "the stuck condition ended when the review was abandoned, so there is no fix to cite. "
            "Retires the stuck-review claim ONLY: any root-cause or suggested-fix text in this "
            "body is unaddressed and needs its own papercut if it still reproduces."
        )
    close_argv = [
        args.brain_bin,
        "papercut",
        "close",
        slug,
        "--status",
        status,
        "--evidence",
        evidence,
    ]
    if status == "fixed":
        close_argv += ["--fixed-by", detail]
    proc = run(close_argv, timeout=60)
    if proc.returncode != 0:
        raise RuntimeError(f"brain papercut close {slug} failed: {proc.stderr.strip()}")
    ledger = f"{iso} {slug} -> card:none | pattern:lifecycle-auto-close | skip:{status}:{detail}\n"
    append_brain(args, args.ledger_slug, ledger)
    line = f"{status} {slug} via {detail}: {title}"
    if args.json_out:
        print(line, file=sys.stderr)
    else:
        print(line)


def close_review_records(args: argparse.Namespace, iso: str) -> dict[str, Any]:
    result: dict[str, Any] = {
        "ok": True,
        "checked": 0,
        "fixed": [],
        "closed_unmerged": [],
        "skipped": [],
        "errors": [],
        "pipeline_stuck_checked": 0,
    }
    records = load_records(args)
    for index, record in enumerate(records):
        if DEADLINE.expired():
            result["skipped"].append(
                {"slug": "", "reason": "budget-exhausted", "unprocessed": len(records) - index}
            )
            break
        slug = str(record.get("slug") or "")
        if not slug.startswith("papercut-"):
            continue
        result["checked"] += 1
        if PIPELINE_STUCK_SLUG_RE.match(slug):
            result["pipeline_stuck_checked"] += 1
        body = str(record.get("body") or "")
        if record.get("_typed"):
            is_open = str(record.get("status") or "") == "open"
        else:
            is_open = status_is_open(body)
        if not is_open:
            result["skipped"].append({"slug": slug, "reason": "not-open"})
            continue
        refs, ref_skips = review_refs(body, slug)
        if not refs:
            entry: dict[str, Any] = {"slug": slug, "reason": "no-review-ref"}
            if ref_skips:
                entry["reason"] = "unresolved-review-ref"
                entry["details"] = ref_skips
            result["skipped"].append(entry)
            continue
        # A `pipeline-stuck` papercut claims "this review is STUCK", so BOTH
        # terminal review states resolve it: merged, and closed-without-merging.
        # Every other papercut class claims "the fix is covered by this review",
        # where a closed-unmerged review means the fix was ABANDONED — closing
        # the papercut on it would be wrong. Measured 2026-09-04 on the primary:
        # 43 open p0 pipeline-stuck rows skipped `review-not-merged`, and 41 of
        # them named a review that was already closed. `merged`-only made the
        # whole cluster permanently unclosable.
        closed_is_terminal = bool(PIPELINE_STUCK_SLUG_RE.match(slug))
        fixed = False
        last_state = ""
        for ref in refs:
            try:
                state, detail = review_state(args, ref)
            except BudgetExhausted:
                result["skipped"].append({"slug": slug, "reason": "budget-exhausted"})
                return result
            except Exception as exc:
                result["errors"].append({"slug": slug, "ref": ref.url, "error": str(exc)})
                continue
            last_state = state
            if state == "merged" or (state == "closed" and closed_is_terminal):
                try:
                    close_record(args, record, ref, detail, iso, state=state)
                except BudgetExhausted:
                    result["skipped"].append({"slug": slug, "reason": "budget-exhausted-before-close"})
                    return result
                entry = {"slug": slug, "ref": ref.url, "detail": detail, "review_state": state}
                if state == "merged":
                    result["fixed"].append(entry)
                else:
                    result["closed_unmerged"].append(entry)
                fixed = True
                break
        if not fixed:
            if last_state == "closed":
                # Not a pipeline-stuck row: the cited fix was abandoned, so this
                # papercut needs a human decision, not an automatic close.
                reason = "review-closed-not-merged"
            elif last_state == "open":
                reason = "review-still-open"
            else:
                reason = "review-not-merged"
            result["skipped"].append({"slug": slug, "reason": reason})
    return result


def _fixed_count(value: Any) -> int:
    if isinstance(value, int):
        return value
    if isinstance(value, list):
        return len(value)
    return 0


def merge_default_results(registry: dict[str, Any], review: dict[str, Any]) -> dict[str, Any]:
    """Keep the registry COVERED closer and still walk open review refs.

    Returning only the registry payload used to hide the pipeline-stuck
    cluster: scanned stayed at 3 COVERED rows and close_review_records
    never ran.
    """
    reg_scanned = int(registry.get("scanned") or 0)
    rev_checked = int(review.get("checked") or 0)
    skipped: list[Any] = []
    if isinstance(registry.get("skipped"), list):
        skipped.extend(registry["skipped"])
    if isinstance(review.get("skipped"), list):
        skipped.extend(review["skipped"])
    errors = review.get("errors") if isinstance(review.get("errors"), list) else []
    return {
        "ok": bool(registry.get("ok", True)) and bool(review.get("ok", True)),
        "scanned": reg_scanned + rev_checked,
        "checked": rev_checked,
        "fixed": _fixed_count(registry.get("fixed")) + _fixed_count(review.get("fixed")),
        "skipped": skipped,
        "errors": errors,
        "dry_run": bool(registry.get("dry_run") or review.get("dry_run")),
        "registry_scanned": reg_scanned,
        "review_checked": rev_checked,
        "pipeline_stuck_checked": int(review.get("pipeline_stuck_checked") or 0),
        "fixed_refs": review.get("fixed") if isinstance(review.get("fixed"), list) else [],
        # Terminal closes that cite an ABANDONED review, kept apart from `fixed`
        # so a reader can never mistake a wontfix for a shipped fix.
        "closed_unmerged": _fixed_count(review.get("closed_unmerged")),
        "closed_unmerged_refs": (
            review.get("closed_unmerged") if isinstance(review.get("closed_unmerged"), list) else []
        ),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("slug", nargs="*", help="specific papercut slugs; default lists recent references")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--json", action="store_true", dest="json_out")
    parser.add_argument("--limit", type=int, default=200)
    parser.add_argument("--read-timeout", type=int, default=20)
    # The open-queue list is one call over the whole partition (11.8s measured
    # for 2187 rows on the primary, 2026-09-03); the per-slug point reads keep
    # --read-timeout. Both stay inside --budget-seconds.
    parser.add_argument("--list-timeout", type=int, default=90)
    parser.add_argument(
        "--budget-seconds",
        type=int,
        default=300,
        help="overall wall-clock budget for the pass; 0 disables the budget",
    )
    parser.add_argument("--records-json")
    parser.add_argument("--brain-bin", default="brain")
    parser.add_argument("--lastgit-bin", default="lastgit")
    parser.add_argument("--forge-api-bin", default="last-stack-forge-api")
    parser.add_argument("--gh-bin", default="gh")
    parser.add_argument("--ledger-slug", default="papercut-reconciler-ledger")
    args = parser.parse_args()

    if args.limit < 1:
        payload = {"ok": False, "reason": "invalid_limit", "limit": args.limit}
        print(json.dumps(payload, sort_keys=True) if args.json_out else "ok=False reason=invalid_limit")
        return 2
    if args.budget_seconds < 0:
        payload = {"ok": False, "reason": "invalid_budget", "budget_seconds": args.budget_seconds}
        print(json.dumps(payload, sort_keys=True) if args.json_out else "ok=False reason=invalid_budget")
        return 2

    global DEADLINE
    DEADLINE = Deadline(float(args.budget_seconds) if args.budget_seconds > 0 else None)

    iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    if args.slug or args.records_json:
        # The explicit-slug path must obey the same invariant as the default
        # one: always terminate, always print a result.
        try:
            result = close_review_records(args, iso)
        except BudgetExhausted as exc:
            result = {
                "ok": True,
                "checked": 0,
                "fixed": [],
                "skipped": [{"slug": "", "reason": "budget-exhausted", "detail": str(exc)}],
                "errors": [],
                "closed_unmerged": [],
                "pipeline_stuck_checked": 0,
            }
    else:
        try:
            registry_result = try_registry_close(args, iso)
        except BudgetExhausted:
            registry_result = None
        try:
            review_result = close_review_records(args, iso)
        except BudgetExhausted as exc:
            review_result = {
                "ok": True,
                "checked": 0,
                "fixed": [],
                "skipped": [{"slug": "", "reason": "budget-exhausted", "detail": str(exc)}],
                "errors": [],
                "closed_unmerged": [],
                "pipeline_stuck_checked": 0,
            }
        except Exception as exc:
            review_result = {
                "ok": False,
                "checked": 0,
                "fixed": [],
                "skipped": [],
                "errors": [{"error": str(exc)}],
                "closed_unmerged": [],
                "pipeline_stuck_checked": 0,
            }
        if registry_result is None:
            result = review_result
        else:
            result = merge_default_results(registry_result, review_result)

    result["budget_seconds"] = args.budget_seconds
    result["budget_exhausted"] = DEADLINE.exhausted
    result["unread"] = DEADLINE.unread

    if args.json_out:
        print(json.dumps(result, sort_keys=True))
    else:
        fixed = result.get("fixed", [])
        fixed_count = fixed if isinstance(fixed, int) else len(fixed)
        checked = result.get("checked", result.get("scanned", 0))
        skipped = result.get("skipped", [])
        print(
            "papercut-lifecycle-close "
            f"checked={checked} fixed={fixed_count} "
            f"closed_unmerged={_fixed_count(result.get('closed_unmerged'))} "
            f"skipped={len(skipped) if isinstance(skipped, list) else 0} "
            f"errors={len(result.get('errors', [])) if isinstance(result.get('errors', []), list) else 0}"
            + (
                f" budget_exhausted=true unread={DEADLINE.unread}"
                if DEADLINE.exhausted
                else ""
            )
        )
    return 1 if result.get("errors") and not result.get("fixed") else 0


if __name__ == "__main__":
    sys.exit(main())
