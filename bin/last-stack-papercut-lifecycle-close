#!/usr/bin/env python3
"""Close Brain papercuts whose completed review or prevention evidence is covered."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any


TRANSIENT_ERRORS = (
    "node socket not reachable",
    "service_timeout",
    "node did not respond",
    "too many concurrent reads",
    "uds_connection_limit",
)
LASTGIT_RE = re.compile(r"\blastgit://([^/\s)>\]]+)/cr/([^/\s)>\]]+)")
FORGE_RE = re.compile(r"https?://[^/\s)>\]]+/([^/\s)>\]]+)/([^/\s)>\]]+)/pulls?/(\d+)")
GITHUB_RE = re.compile(r"https?://github\.com/([^/\s)>\]]+)/([^/\s)>\]]+)/pull/(\d+)")


@dataclass(frozen=True)
class ReviewRef:
    kind: str
    url: str
    repo: str
    ident: str
    owner: str = ""


@dataclass(frozen=True)
class RegistryEntry:
    slug: str
    card: str


def run(argv: list[str], *, stdin: str | None = None, timeout: int = 60) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        input=stdin,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        env=os.environ,
    )


def is_transient(text: str) -> bool:
    return any(signal in text for signal in TRANSIENT_ERRORS)


def run_json(argv: list[str], *, timeout: int = 60) -> Any:
    last_error = ""
    for attempt in range(1, 4):
        proc = run(argv, timeout=timeout)
        if proc.returncode == 0:
            parsed = parse_json_stream(proc.stdout)
            if parsed is not None:
                return parsed
            raise RuntimeError(f"{' '.join(argv)} did not return JSON")
        last_error = f"{proc.stderr.strip()} {proc.stdout.strip()}".strip()
        if attempt == 3 or not is_transient(last_error):
            raise RuntimeError(f"{' '.join(argv)} failed: {last_error}")
        time.sleep(0.75)
    raise RuntimeError(last_error)


def parse_json_stream(raw: str) -> Any | None:
    decoder = json.JSONDecoder()
    idx = 0
    candidates: list[Any] = []
    while idx < len(raw):
        while idx < len(raw) and raw[idx].isspace():
            idx += 1
        if idx >= len(raw):
            break
        try:
            value, end = decoder.raw_decode(raw, idx)
        except json.JSONDecodeError:
            idx += 1
            continue
        candidates.append(value)
        idx = end
    if not candidates:
        return None
    for value in candidates:
        if isinstance(value, dict) and not is_timing_event(value):
            return value
    return candidates[0]


def is_timing_event(value: dict[str, Any]) -> bool:
    return value.get("event") == "verb_timing" or "duration_ms" in value and "verb" in value


def as_items(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    if isinstance(value, dict):
        for key in ("records", "items", "results", "rows"):
            items = value.get(key)
            if isinstance(items, list):
                return [item for item in items if isinstance(item, dict)]
    return []


def tool(name: str, env_name: str) -> str | None:
    override = os.environ.get(env_name)
    if override:
        return override
    return shutil.which(name)


def parse_registry_entries(registry: str, limit: int) -> list[RegistryEntry]:
    entries: list[RegistryEntry] = []
    current_slug = ""
    prevention = ""
    card = ""

    def flush() -> None:
        nonlocal current_slug, prevention, card
        if current_slug.startswith("papercut-") and prevention == "COVERED" and card:
            entries.append(RegistryEntry(current_slug, card))
        current_slug = ""
        prevention = ""
        card = ""

    for raw_line in registry.splitlines():
        line = raw_line.strip()
        heading = re.match(r"^#{3,}\s+(.+)$", line)
        if heading:
            flush()
            first = heading.group(1).split()[0].strip("`:,")
            current_slug = first if first.startswith("papercut-") else ""
            continue
        papercut = re.match(r"^-\s*Papercut:\s*`?([^`\s]+)`?", line)
        if papercut:
            current_slug = papercut.group(1)
            continue
        if re.match(r"^-\s*Prevention:\s*COVERED\b", line):
            prevention = "COVERED"
            continue
        card_match = re.match(r"^-\s*Card:\s*`?([^`\s()]+)`?", line)
        if card_match:
            card = card_match.group(1)
            continue
    flush()
    return entries[:limit]


def try_registry_close(args: argparse.Namespace, iso: str) -> dict[str, Any] | None:
    brain = tool(args.brain_bin, "LAST_STACK_PAPERCUT_LIFECYCLE_BRAIN")
    kanban = tool("kanban", "LAST_STACK_PAPERCUT_LIFECYCLE_KANBAN")
    if not brain or not kanban:
        missing = ",".join(name for name, path in (("brain", brain), ("kanban", kanban)) if not path)
        return {"ok": False, "reason": "lifecycle_dependency_missing", "missing": missing, "scanned": 0, "fixed": 0}

    try:
        registry_proc = run([brain, "get", "papercut-prevention-registry", "--type", "reference"], timeout=args.read_timeout)
    except subprocess.TimeoutExpired:
        return {"ok": False, "reason": "registry_read_timeout", "scanned": 0, "fixed": 0}
    if registry_proc.returncode != 0:
        return None

    entries = parse_registry_entries(registry_proc.stdout, args.limit)
    if not entries:
        return None

    scanned = 0
    fixed = 0
    skipped: list[str] = []
    for entry in entries:
        scanned += 1
        try:
            card_proc = run([kanban, "show", entry.card, "--json"], timeout=args.read_timeout)
        except subprocess.TimeoutExpired:
            skipped.append(f"{entry.slug}:card_timeout")
            continue
        if card_proc.returncode != 0:
            skipped.append(f"{entry.slug}:card_unreadable")
            continue
        try:
            card = json.loads(card_proc.stdout)
        except json.JSONDecodeError:
            skipped.append(f"{entry.slug}:card_bad_json")
            continue
        if card.get("column") != "done":
            skipped.append(f"{entry.slug}:card_not_done")
            continue

        try:
            typed_proc = run(
                [brain, "get", entry.slug, "--type", "papercut", "--json"],
                timeout=args.read_timeout,
            )
        except subprocess.TimeoutExpired:
            skipped.append(f"{entry.slug}:record_timeout")
            continue
        typed_record = parse_json_stream(typed_proc.stdout) if typed_proc.returncode == 0 else None
        if isinstance(typed_record, dict):
            if str(typed_record.get("status") or "") != "open":
                skipped.append(f"{entry.slug}:not_open")
                continue
            if args.dry_run:
                skipped.append(f"{entry.slug}:dry_run")
                continue
            evidence = (
                f"card:{entry.card} is done and the prevention registry is COVERED; "
                "confirmed by last-stack-papercut-lifecycle-close."
            )
            try:
                close_proc = run(
                    [
                        brain,
                        "papercut",
                        "close",
                        entry.slug,
                        "--status",
                        "fixed",
                        "--evidence",
                        evidence,
                        "--fixed-by",
                        f"card:{entry.card}",
                    ],
                    timeout=args.read_timeout,
                )
            except subprocess.TimeoutExpired:
                skipped.append(f"{entry.slug}:close_timeout")
                continue
            if close_proc.returncode != 0:
                skipped.append(f"{entry.slug}:close_failed")
                continue
            fixed += 1
            continue

        # Typed ledger miss: do not fall back to a prose Status: FIXED append.
        # That leaves queryable status=open while the body looks healed.
        skipped.append(f"{entry.slug}:untyped_skipped")

    return {
        "ok": True,
        "scanned": scanned,
        "candidates": len(entries),
        "fixed": fixed,
        "dry_run": args.dry_run,
        "skipped": skipped,
    }


def load_records(args: argparse.Namespace) -> list[dict[str, Any]]:
    if args.records_json:
        records = as_items(json.loads(Path(args.records_json).read_text(encoding="utf-8")))
        for record in records:
            if not str(record.get("status") or ""):
                body = str(record.get("body") or "")
                record["status"] = "open" if status_is_open(body) else "fixed"
            record["_typed"] = True
        return records
    if args.slug:
        records = [brain_get(args, slug) for slug in args.slug]
        for record in records:
            record["_typed"] = True
        return records
    previews = as_items(
        run_json(
            [
                args.brain_bin,
                "papercut",
                "list",
                "--status",
                "open",
                "--json",
            ],
            timeout=args.read_timeout,
        )
    )
    slugs = [str(item.get("slug") or "") for item in previews[: args.limit]]
    records: list[dict[str, Any]] = []
    for slug in slugs:
        if not slug.startswith("papercut-"):
            continue
        try:
            record = brain_get(args, slug)
            record["_typed"] = True
            records.append(record)
        except Exception as exc:
            print(f"warning: skipped {slug}: {exc}", file=sys.stderr)
    return records


def brain_get(args: argparse.Namespace, slug: str) -> dict[str, Any]:
    value = run_json(
        [args.brain_bin, "get", slug, "--type", "papercut", "--json"],
        timeout=args.read_timeout,
    )
    if not isinstance(value, dict):
        raise RuntimeError(f"brain get {slug} returned non-object JSON")
    return value


def status_is_open(body: str) -> bool:
    statuses = [m.group(1).upper() for m in re.finditer(r"(?im)^\s*Status:\s*([A-Z_]+)", body)]
    if not statuses:
        return False
    return statuses[-1] == "OPEN"


def review_refs(body: str) -> list[ReviewRef]:
    refs: list[ReviewRef] = []
    seen: set[str] = set()

    def add(ref: ReviewRef) -> None:
        if ref.url not in seen:
            seen.add(ref.url)
            refs.append(ref)

    for repo, ident in LASTGIT_RE.findall(body):
        add(ReviewRef("lastgit", f"lastgit://{repo}/cr/{ident}", repo, ident))
    for owner, repo, num in GITHUB_RE.findall(body):
        add(ReviewRef("github", f"https://github.com/{owner}/{repo}/pull/{num}", repo, num, owner))
    for match in FORGE_RE.finditer(body):
        if "github.com" in match.group(0):
            continue
        owner, repo, num = match.group(1), match.group(2), match.group(3)
        add(ReviewRef("forge", f"{owner}/{repo}/pulls/{num}", repo, num, owner))
    return refs


def merged_status(args: argparse.Namespace, ref: ReviewRef) -> tuple[bool, str]:
    if ref.kind == "lastgit":
        data = run_json([args.lastgit_bin, "cr", "view", ref.repo, ref.ident, "--json"], timeout=60)
        cr = data.get("cr") or data.get("change_request") or data if isinstance(data, dict) else {}
        state = str(cr.get("state") or cr.get("status") or "").lower()
        merge_oid = str(cr.get("merge_oid") or cr.get("mergeOid") or "")
        return state == "merged" or bool(merge_oid), f"lastgit:{ref.repo}/{ref.ident}"
    if ref.kind == "forge":
        data = run_json([args.forge_api_bin, f"repos/{ref.owner}/{ref.repo}/pulls/{ref.ident}"], timeout=60)
        state = str(data.get("state") or "").lower() if isinstance(data, dict) else ""
        merged = bool(data.get("merged")) if isinstance(data, dict) else False
        return merged or state == "merged", f"forge:{ref.owner}/{ref.repo}#{ref.ident}"
    data = run_json(
        [
            args.gh_bin,
            "pr",
            "view",
            ref.ident,
            "-R",
            f"{ref.owner}/{ref.repo}",
            "--json",
            "state,mergedAt",
        ],
        timeout=60,
    )
    state = str(data.get("state") or "").upper() if isinstance(data, dict) else ""
    merged_at = str(data.get("mergedAt") or "") if isinstance(data, dict) else ""
    return state == "MERGED" or bool(merged_at), f"github:{ref.owner}/{ref.repo}#{ref.ident}"


def append_brain(args: argparse.Namespace, slug: str, text: str) -> None:
    if args.dry_run:
        return
    proc = run([args.brain_bin, "append", slug, "--type", "reference"], stdin=text, timeout=60)
    if proc.returncode != 0:
        raise RuntimeError(f"brain append {slug} failed: {proc.stderr.strip()}")


def close_record(args: argparse.Namespace, record: dict[str, Any], ref: ReviewRef, detail: str, iso: str) -> None:
    slug = str(record.get("slug") or "")
    title = str(record.get("title") or slug)
    if args.dry_run:
        return
    evidence = f"lifecycle closer confirmed {ref.url} is merged ({detail})."
    proc = run(
        [
            args.brain_bin,
            "papercut",
            "close",
            slug,
            "--status",
            "fixed",
            "--evidence",
            evidence,
            "--fixed-by",
            detail,
        ],
        timeout=60,
    )
    if proc.returncode != 0:
        raise RuntimeError(f"brain papercut close {slug} failed: {proc.stderr.strip()}")
    ledger = f"{iso} {slug} -> card:none | pattern:lifecycle-auto-close | skip:fixed:{detail}\n"
    append_brain(args, args.ledger_slug, ledger)
    line = f"fixed {slug} via {detail}: {title}"
    if args.json_out:
        print(line, file=sys.stderr)
    else:
        print(line)


def close_review_records(args: argparse.Namespace, iso: str) -> dict[str, Any]:
    result: dict[str, Any] = {"ok": True, "checked": 0, "fixed": [], "skipped": [], "errors": []}
    for record in load_records(args):
        slug = str(record.get("slug") or "")
        if not slug.startswith("papercut-"):
            continue
        result["checked"] += 1
        body = str(record.get("body") or "")
        if record.get("_typed"):
            is_open = str(record.get("status") or "") == "open"
        else:
            is_open = status_is_open(body)
        if not is_open:
            result["skipped"].append({"slug": slug, "reason": "not-open"})
            continue
        refs = review_refs(body)
        if not refs:
            result["skipped"].append({"slug": slug, "reason": "no-review-ref"})
            continue
        fixed = False
        for ref in refs:
            try:
                merged, detail = merged_status(args, ref)
            except Exception as exc:
                result["errors"].append({"slug": slug, "ref": ref.url, "error": str(exc)})
                continue
            if merged:
                close_record(args, record, ref, detail, iso)
                result["fixed"].append({"slug": slug, "ref": ref.url, "detail": detail})
                fixed = True
                break
        if not fixed:
            result["skipped"].append({"slug": slug, "reason": "review-not-merged"})
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("slug", nargs="*", help="specific papercut slugs; default lists recent references")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--json", action="store_true", dest="json_out")
    parser.add_argument("--limit", type=int, default=200)
    parser.add_argument("--read-timeout", type=int, default=20)
    parser.add_argument("--records-json")
    parser.add_argument("--brain-bin", default="brain")
    parser.add_argument("--lastgit-bin", default="lastgit")
    parser.add_argument("--forge-api-bin", default="last-stack-forge-api")
    parser.add_argument("--gh-bin", default="gh")
    parser.add_argument("--ledger-slug", default="papercut-reconciler-ledger")
    args = parser.parse_args()

    if args.limit < 1:
        payload = {"ok": False, "reason": "invalid_limit", "limit": args.limit}
        print(json.dumps(payload, sort_keys=True) if args.json_out else "ok=False reason=invalid_limit")
        return 2

    iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    result = None if args.slug or args.records_json else try_registry_close(args, iso)
    if result is None:
        result = close_review_records(args, iso)

    if args.json_out:
        print(json.dumps(result, sort_keys=True))
    else:
        fixed = result.get("fixed", [])
        fixed_count = fixed if isinstance(fixed, int) else len(fixed)
        checked = result.get("checked", result.get("scanned", 0))
        skipped = result.get("skipped", [])
        print(
            "papercut-lifecycle-close "
            f"checked={checked} fixed={fixed_count} "
            f"skipped={len(skipped) if isinstance(skipped, list) else 0} "
            f"errors={len(result.get('errors', [])) if isinstance(result.get('errors', []), list) else 0}"
        )
    return 1 if result.get("errors") and not result.get("fixed") else 0


if __name__ == "__main__":
    sys.exit(main())
