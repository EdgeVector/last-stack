#!/bin/bash
# Run the existing primary snapshot job through the signed owner API.
set -euo pipefail

snapshot_home="${LASTDB_HOME:-$HOME/.lastdb}"
snapshot_socket="$snapshot_home/data/folddb.sock"
snapshot_cli="$HOME/.lastdb/current/lastdb"
snapshot_log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/last-stack/cloud-backup"
mkdir -p "$snapshot_log_dir"

record() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$snapshot_log_dir/kick.log"
}

fail() {
  record "FAIL $*"
  printf 'lastdb-cloud-backup-kick: %s\n' "$*" >&2
  exit 1
}

[ -S "$snapshot_socket" ] || fail "primary socket unavailable"
[ -x "$snapshot_cli" ] || fail "primary LastDB CLI unavailable"

if ! snapshot_status=$(curl --fail --silent --max-time 30 --unix-socket "$snapshot_socket" \
  -H 'X-LastDB-Client: cloud-backup-kick' http://localhost/api/status); then
  fail "primary status unavailable"
fi

if ! snapshot_state=$(jq -er '
  .status.cloud_sync as $cloud |
  if .ok != true or ($cloud.connected | type) != "boolean" then
    error("signed cloud status unavailable")
  elif $cloud.connected != true then "disconnected"
  elif $cloud.environment != "prod" then "wrong-environment"
  elif $cloud.payment_hold == true then "payment-hold"
  elif $cloud.captures_accepted != true then "capture-unavailable"
  else "ready"
  end' <<< "$snapshot_status" 2>/dev/null); then
  fail "signed cloud status unavailable"
fi

case "$snapshot_state" in
  disconnected)
    record "SKIP signed cloud backup is disconnected"
    exit 0
    ;;
  ready) ;;
  *) fail "$snapshot_state" ;;
esac

if ! snapshot_reply=$("$snapshot_cli" --data-dir "$snapshot_home" backup snapshot \
  --database personal --wait 2>&1); then
  case "$snapshot_reply" in
    *"signed snapshot did not reach the log head"*)
      fail "snapshot completion did not arrive before the CLI deadline"
      ;;
    *)
      fail "owner snapshot request did not complete"
      ;;
  esac
fi

snapshot_through=$(sed -n 's/^snapshot_through=\([0-9][0-9]*\)$/\1/p' <<< "$snapshot_reply")
[[ "$snapshot_through" =~ ^[0-9]+$ ]] || fail "snapshot completion receipt missing"
record "OK snapshot_through=$snapshot_through"
