#!/usr/bin/env bash
# Print the log of a failing forge (Forgejo) CI job — the ONE sanctioned recipe.
#
# Why this exists: when a forge CI run goes red, agents have no obvious way to
# read the failing job's log. Two traps bite every time:
#   1. `curl` to http://localhost:3300 dies with `command not found: curl` under
#      a SANDBOXED Bash tool call (the sandbox blocks the TCP path even though
#      /usr/bin/curl exists). Fix: run this helper — and any forge curl — with
#      `dangerouslyDisableSandbox: true`. (curl over --unix-socket to folddb.sock
#      is unaffected; only TCP-to-:3300 is blocked.)
#   2. Forgejo has NO /api/v1 log endpoint. The logs live behind a WEB route that
#      needs a browser SESSION COOKIE (an API token 303-redirects to login), and
#      the working path includes an /attempt/<n>/ segment everyone omits:
#          GET /{owner}/{repo}/actions/runs/{run}/jobs/{job}/attempt/{attempt}/logs
#      returns the job's plain-text combined log.
#
# This helper does the whole thing: token-auth the /api/v1/actions/tasks list to
# resolve the run + jobs for a red run, log in for a session cookie, then fetch
# the failing job's log and print its tail.
#
#   3. Both credentials live in the login keychain, which locks to
#      non-interactive readers and then exits 51/25293 with an EMPTY stderr. On
#      2026-09-06 that made this helper exit 3 on every unattended pass while
#      five p0 papercuts (routines#10, loom#9/#11/#12, fold#1954/#1955,
#      last-stack#20/#21) recorded "the failure remains unclassified" for six
#      hours. The token now resolves through lib/forge-token.sh (env > keychain
#      > lastsecrets) like every other forge helper, and the log body has a
#      credential-free path: on the forge host the job log is a plain file, so
#      the web session is only needed when that file is absent.
#
# MUST be run with dangerouslyDisableSandbox:true (TCP to :3300 is sandbox-blocked).
set -euo pipefail

# Resolve through symlinks so lib/ is found in the artifact tree and in a
# checkout alike (same convention as bin/last-stack-forge-api).
self="${BASH_SOURCE[0]}"
while [ -h "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
self_root="$(cd -P "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/forge-token.sh
. "$self_root/lib/forge-token.sh"

ROOT="${FORGE_ROOT:-http://localhost:3300}"
TAIL="${FORGE_CI_LOG_TAIL:-80}"
# Forgejo writes each task's combined log to
#   <root>/<owner>/<repo>/<taskid%256 as %02x>/<taskid>.log[.zst]
# That file needs no credential at all, which is the only reason this helper
# still works while the login keychain is locked.
ACTIONS_LOG_ROOT="${FORGE_ACTIONS_LOG_ROOT:-/opt/homebrew/var/forgejo/data/actions_log}"


usage() {
  cat <<'EOF'
Usage:
  last-stack-forge-ci-log <owner/repo> <run-number> [job-index] [attempt]
  last-stack-forge-ci-log <owner/repo> --run <run-number> [job-index] [attempt]
  last-stack-forge-ci-log <owner/repo> --sha <head-sha>   # every red run for a commit

Prints the plain-text log tail of a forge (Forgejo) CI job.

Arguments:
  <owner/repo>   e.g. EdgeVector/fold
  <run-number>   the per-repo run index shown in the run URL
                 (.../actions/runs/<run-number>) — this is `run_number` in the
                 /api/v1/.../actions/tasks list, NOT the global task id, and
                 NOT a pull-request number. A number that is also a live PR
                 whose head ran elsewhere is REFUSED, with the --sha command
                 to use instead.
  --run <n>      force <n> through as a run number, skipping that PR check.
  [job-index]    0-based job within the run. Default: auto — dumps EVERY failing
                 job's log (and lists the jobs it found).
  [attempt]      re-run attempt. Default: 1 (first run).

  --sha <sha>    resolve EVERY run for <head-sha> and dump every failing job
                 across all of them.

Env:
  FORGE_ROOT           forge base URL (default http://localhost:3300)
  FORGE_CI_LOG_TAIL    lines of tail to print per job (default 80; 0 = whole log)

Env (cont.):
  FORGE_ACTIONS_LOG_ROOT
                       forge on-disk actions_log root
                       (default /opt/homebrew/var/forgejo/data/actions_log)

Auth:
  api token   $FORGE_TOKEN, else keychain `forgejo-token`, else
              lastsecrets://forgejo-token  (lib/forge-token.sh)
  job log     read from ACTIONS_LOG_ROOT when present — no credential needed.
              Only when the file is absent does this fall back to a web
              session, which needs $FORGE_WEB_PASSWORD or keychain
              `forgejo-admin` (user $FORGE_WEB_USER, default `tom`).

⚠️  Run this with `dangerouslyDisableSandbox: true` — a sandboxed Bash tool call
    blocks TCP to localhost:3300 and fails with `command not found: curl`.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "$#" -lt 2 ]; then
  usage
  [ "$#" -lt 2 ] && exit 2 || exit 0
fi

repo="$1"; shift
case "$repo" in */*) ;; *) echo "repo must be owner/name: $repo" >&2; exit 2 ;; esac

TOKEN="$(last_stack_forge_token || true)"
[ -n "$TOKEN" ] || { last_stack_forge_token_missing_msg; exit 3; }

api() { curl -fsS -H "Authorization: token $TOKEN" "$ROOT/api/v1/$1"; }

# ── Resolve the run(s) + the list of failing job indices ──────────────────────
run_number=""
run_numbers=""
sha=""
job_index=""
attempt="1"
force_run=0

if [ "${1:-}" = "--sha" ]; then
  sha="${2:?--sha needs a value}"
else
  if [ "${1:-}" = "--run" ]; then
    force_run=1
    shift
  fi
  run_number="${1:-}"
  case "$run_number" in ''|*[!0-9]*) echo "run-number must be numeric (or use --sha): $run_number" >&2; exit 2 ;; esac
  if [ -n "${2:-}" ]; then job_index="$2"; fi
  if [ -n "${3:-}" ]; then attempt="$3"; fi
fi

# ── A pull-request number is not a run number ─────────────────────────────────
# Measured recurrences: `… EdgeVector/fold 1912` and `… EdgeVector/lastgit 554`
# each dumped a months-old SUCCEEDED run and were read as CI evidence for a
# pull request that was failing at the time. Both numbers WERE live runs, so
# "does this run exist?" cannot catch it. The discriminator is that the number
# is also a live PR whose head ran under a different run number.
# papercut-last-stack-forge-ci-log-pr-number-as-run-number
pr_head=""
if [ -n "$run_number" ] && [ "$force_run" -eq 0 ]; then
  pr_json="$(api "repos/$repo/pulls/$run_number" 2>/dev/null || true)"
  if [ -n "$pr_json" ]; then
    pr_head="$(printf '%s' "$pr_json" | jq -r '.head.sha // empty' 2>/dev/null || true)"
  fi
fi

# Pull the tasks list once; it maps run_number -> per-job status/name.
# Measured 2026-09-06: this endpoint IGNORES ?limit and returns the repo's
# complete history (fold: total_count == returned == 22366). So every run for a
# head is already in hand — the old first-match resolver was a selection bug,
# never a paging one, and no message here may blame truncation.
tasks_json="$(api "repos/$repo/actions/tasks?limit=100")"

if [ -n "$pr_head" ]; then
  run_head="$(printf '%s' "$tasks_json" | jq -r --argjson rn "$run_number" \
    '[.workflow_runs[] | select(.run_number == $rn)] | (.[0].head_sha // empty)')"
  if [ -n "$run_head" ] && [ "$run_head" != "$pr_head" ]; then
    cat >&2 <<MSG
$repo #$run_number is a live pull request, and run $run_number is a DIFFERENT
commit ($run_head). Reading it as CI evidence for that PR is the defect this
check exists to stop. The PR's head is $pr_head:

    last-stack-forge-ci-log $repo --sha $pr_head

Pass --run $run_number to read run $run_number anyway.
MSG
    exit 2
  fi
fi

# ── Resolve ALL runs for a head sha, not the first one listed ─────────────────
# Two runs per head is the NORMAL shape in fold, which posts heavy clippy from a
# separate workflow file with its own concurrency group. Measured 2026-09-06
# over fold's complete task history: 4589 distinct heads, 2246 with more than
# one run, and on 288 of them the run the old `.[0]` resolver picked contained
# NO failing task while a red sibling existed for the same commit. A further
# 279 heads have failing jobs in more than one run, so "prefer a failing run"
# would have hidden a red sibling on almost as many heads as it fixed. Every
# run for the head is dumped instead.
# papercut-forge-ci-log-sha-selects-first-run-and-hides-failing-sibling
if [ -n "$sha" ]; then
  run_numbers="$(printf '%s' "$tasks_json" | jq -r --arg s "$sha" \
    '[.workflow_runs[] | select(.head_sha|startswith($s)) | .run_number] | unique | .[]')"
  if [ -z "$run_numbers" ]; then
    echo "no run found for sha $sha in this repo's complete tasks list" >&2
    exit 4
  fi
  echo "resolved sha $sha -> run(s) $(printf '%s' "$run_numbers" | tr '\n' ' ')" >&2
fi

# Jobs of the selected run(s), in the order Forgejo assigns web job-indices
# (ascending id WITHIN each run). Emit "run<TAB>idx<TAB>status<TAB>name<TAB>id".
if [ -n "$sha" ]; then
  jobs_tsv="$(printf '%s' "$tasks_json" | jq -r --arg s "$sha" '
    [ .workflow_runs[] | select(.head_sha|startswith($s)) ]
    | group_by(.run_number) | sort_by(.[0].run_number)
    | map(sort_by(.id) | to_entries
          | map("\(.value.run_number)\t\(.key)\t\(.value.status)\t\(.value.name)\t\(.value.id)"))
    | flatten | .[]')"
else
  jobs_tsv="$(printf '%s' "$tasks_json" | jq -r --argjson rn "$run_number" '
    [ .workflow_runs[] | select(.run_number == $rn) ] | sort_by(.id)
    | to_entries[] | "\(.value.run_number)\t\(.key)\t\(.value.status)\t\(.value.name)\t\(.value.id)"')"
fi

if [ -z "$jobs_tsv" ]; then
  echo "no jobs found for run $run_number — this repo's tasks list is complete (the API ignores ?limit), so that run number does not exist here" >&2
  exit 4
fi

echo "jobs (run / idx / status / name / task-id):" >&2
printf '%s\n' "$jobs_tsv" | sed 's/^/  /' >&2

# Decide which jobs to dump, as run:idx pairs.
targets=""
if [ -n "$job_index" ]; then
  targets="$run_number:$job_index"
else
  targets="$(printf '%s\n' "$jobs_tsv" | awk -F'\t' '$3=="failure"{print $1":"$2}')"
  if [ -z "$targets" ]; then
    # Nothing failed in ANY run for this head. Dump the newest run only; the
    # listing above already named every run, so no sibling is hidden.
    newest="$(printf '%s\n' "$jobs_tsv" | awk -F'\t' '{print $1}' | sort -n | tail -1)"
    targets="$(printf '%s\n' "$jobs_tsv" | awk -F'\t' -v r="$newest" '$1==r{print $1":"$2}')"
  fi
fi

# ── On-disk log (no credential) ───────────────────────────────────────────────
# Forgejo shards by task-id modulo 256; the file is zstd-compressed when the
# instance has log compression on, plain otherwise. Prints nothing and returns
# non-zero when neither exists.
disk_log() {
  local task_id="$1" shard base
  [ -n "$task_id" ] && [ "$task_id" != "null" ] || return 1
  shard="$(printf '%02x' "$(( task_id % 256 ))")"
  base="$ACTIONS_LOG_ROOT/$repo/$shard/$task_id.log"
  if [ -f "$base.zst" ]; then
    zstdcat "$base.zst"
  elif [ -f "$base" ]; then
    cat "$base"
  else
    return 1
  fi
}

# ── Web session cookie (the log route rejects the API token) ──────────────────
# Established lazily: a locked keychain must not stop a job whose log is on
# disk. Exits 3 only when the web route is the one path left.
cookie=""
web_login() {
  [ -z "$cookie" ] || return 0
  local web_user web_pass csrf
  web_user="${FORGE_WEB_USER:-tom}"
  web_pass="${FORGE_WEB_PASSWORD:-$(security find-generic-password -s forgejo-admin -w 2>/dev/null || true)}"
  if [ -z "$web_pass" ]; then
    cat >&2 <<'MSG'
this job has no log under FORGE_ACTIONS_LOG_ROOT, so the web route is the only
path left — and it needs a password. Tried $FORGE_WEB_PASSWORD (unset) and
keychain item `forgejo-admin` (absent, or the login keychain is locked to
non-interactive readers: `security ... -w` exits 51/25293 silently).
MSG
    return 3
  fi
  cookie="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  curl -fsS -c "$cookie" "$ROOT/user/login" -o /dev/null
  csrf="$(awk '/_csrf/{v=$7} END{print v}' "$cookie")"
  curl -fsS -b "$cookie" -c "$cookie" -X POST "$ROOT/user/login" \
    --data-urlencode "_csrf=$csrf" \
    --data-urlencode "user_name=$web_user" \
    --data-urlencode "password=$web_pass" -o /dev/null
}
trap '[ -n "$cookie" ] && rm -f "$cookie"' EXIT

# ── Fetch + print each target job's log ───────────────────────────────────────
read_ok=0
unreadable=0
for target in $targets; do
  run="${target%%:*}"
  idx="${target##*:}"
  name="$(printf '%s\n' "$jobs_tsv" | awk -F'\t' -v r="$run" -v i="$idx" '$1==r && $2==i{print $4}')"
  task_id="$(printf '%s\n' "$jobs_tsv" | awk -F'\t' -v r="$run" -v i="$idx" '$1==r && $2==i{print $5}')"
  web_url="$ROOT/$repo/actions/runs/$run/jobs/$idx/attempt/$attempt/logs"
  body=""
  source_desc=""
  if body="$(disk_log "$task_id" 2>/dev/null)"; then
    source_desc="$ACTIONS_LOG_ROOT/$repo/$(printf '%02x' "$(( task_id % 256 ))")/$task_id.log (on disk)"
  elif web_login && body="$(curl -fsS -b "$cookie" "$web_url")"; then
    source_desc="$web_url"
  else
    # One unreadable job must not sink the command. Forgejo does not keep a log
    # for every task — loom run 35's GREEN `ci-required` (task 35096) has no
    # file while the `skipped` job in the same run does — so a missing log is a
    # normal per-job outcome, not a reason to lose the jobs that did read.
    echo >&2
    echo "===== run $run job $idx  ($name, task $task_id)  —  NO LOG AVAILABLE =====" >&2
    unreadable=$(( unreadable + 1 ))
    continue
  fi
  read_ok=$(( read_ok + 1 ))
  echo
  echo "===== run $run job $idx  ($name, task $task_id)  —  $source_desc ====="
  if [ "$TAIL" = "0" ]; then
    printf '%s\n' "$body"
  else
    printf '%s\n' "$body" | tail -n "$TAIL"
  fi
done

# Exit 4 only when NOTHING was readable; a partial read is a useful answer and
# the per-job banners above say exactly which jobs are missing.
if [ "$read_ok" -eq 0 ] && [ "$unreadable" -gt 0 ]; then
  echo "no log could be read for any of the $unreadable target job(s)" >&2
  exit 4
fi
