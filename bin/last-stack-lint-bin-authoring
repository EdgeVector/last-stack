#!/usr/bin/env bash
# Static gate for helper authoring. Two defects, one linter:
#
#   1. HARD  an unbounded recursive walk. `Path.rglob(...)`, `os.walk(...)`,
#            `glob("**")`, or a shell `find`/`fd` rooted at a workspace root
#            (~/code/edgevector, ~/.fkanban, ~/.cache/edgevector-git) with no
#            depth bound. On this host such a walk crosses ~20 worktrees, each
#            carrying a cargo `target/` tree, and takes minutes; a background
#            task then times out and reads as product failure. A walk line
#            passes only when it states its bound: `# walk-ok: <reason>`.
#   2. SOFT  a bash helper in bin/ that nests a Python program through a
#            heredoc (`python3 - <<'PY'`). Two languages in one file fight over
#            quoting, env flags and argparse, and every draft is a partial
#            script. New helpers use ONE language. Existing nests are held in
#            config/bin-authoring-baseline.tsv and may only shrink.
#   3. HARD  a `stat -t` format that ends in a LITERAL Z. BSD stat renders %F
#            and %T from the LOCAL broken-down time and emits a trailing Z as a
#            literal character, so the helper writes a stamp in the exact shape
#            every UTC timestamp on this fleet uses, 25200s in the past. It
#            parses, sorts and compares cleanly, and it is one-directional:
#            always OLDER, so it manufactures stalls and never hides one. In a
#            SHIPPED helper that becomes a scheduled false incident rather than
#            one agent's wasted five minutes -- it already did, six recorded
#            times, in last-stack-north-star-dashboard-run
#            (papercut-north-star-dashboard-html-mtime-zulu-is-local, fixed
#            instance-only 2026-09-23 with no guard, then the class recurred in
#            agent shell on 2026-10-03). `%Z` is a real strftime conversion and
#            is not this defect; `TZ=UTC` on the same line makes the value
#            correct and passes. Prefer `date -u -r`. A line that genuinely
#            wants it states why: `# stat-zulu-ok: <reason>`.
#   4. HARD  an auth header built onto a child process's ARGV: a
#            `git -c http.<base>.extraHeader=Authorization: ...` word, or a
#            `curl -H "Authorization: ..."` word. `ps aux` lists argv to every
#            local account, so those publish the Forge token machine-wide for the
#            life of the call. Two live sightings:
#            papercut-forge-git-extraheader-token-visible-in-ps-20260923 (p0) and
#            papercut-last-stack-forge-api-token-on-curl-argv-20260924 (p1).
#            The safe forms are in lib/forge-token.sh:
#            `last_stack_forge_export_git_config` (GIT_CONFIG_* in the
#            environment; measured 2026-09-25, `ps -E`/`ps eww` print no
#            environment on this host) and `last_stack_forge_curl_auth_config`
#            (a 0600 `curl -K` config file). A line that genuinely needs argv
#            states why: `# argv-token-ok: <reason>`.
#   5. HARD  a READ of this host's real state whose default bypasses the file's
#            own `host_path()` helper. Once a program routes host-state reads
#            through one switch, a knob that goes straight to
#            `os.environ.get(NAME, os.path.join(HOME, ...))` is invisible to
#            that switch, so a fixture cannot isolate from it and nobody finds
#            out until an alert count moves. This rule only applies to files
#            that DEFINE `host_path(`, so adopting the helper is what opts a
#            program in -- it never fires on an unrelated helper. Two alert
#            rules in bin/last-stack-load-collector shipped this way; both
#            documented knobs were already set in all three fixtures when the
#            second one landed, and a THIRD unenumerated knob was still opening
#            this host's real 133 MB routinesd.err.log during every fixture run
#            (measured 2026-10-03 on main tip 514043dd8). CI stayed green
#            because a runner has no such log, so the gate was red only for
#            agents on this host -- which teaches the fleet to ignore its gate.
#            A default that is genuinely not a read of host state says why:
#            `# host-path-ok: <reason>`.
#            papercut-load-collector-alert-rules-read-real-host-state-with-no-hermetic-switch-so-each-new-rule-breaks-the-count-fixtures-20261003
#
# Ground truth: brain papercut-agent-zero-llm-cli-bash-python-heredoc-rglob
# (filed 2026-08-02). The bounded replacement for a walk is
# bin/last-stack-locate-file (explicit env var, fixed candidates, then a
# depth-bounded, time-budgeted search of named roots).
#
# Modes:
#   (default) / --ci      gate: exit 1 on any hard finding or a non-baselined nest
#   --report              print every finding; exit 0 always
#   --write-baseline      rewrite both baselines from the findings present now
#   --root DIR            tree to lint (default: this checkout)
#   --baseline PATH       nest baseline (default: <root>/config/bin-authoring-baseline.tsv)
#   --argv-token-baseline PATH
#                         argv-token baseline (default: <root>/config/forge-token-argv-baseline.tsv)
#   -h | --help           print this usage
set -euo pipefail

SELF_ROOT="$(cd "$(dirname "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd -P)"
ROOT="$SELF_ROOT"
MODE=gate
BASELINE_PATH=""
ARGV_TOKEN_BASELINE_PATH=""

# Print the whole leading comment block, minus the shebang. A line RANGE went
# stale the moment the header grew: `sed -n '2,30p'` silently stopped printing the
# Modes section when a third finding class was documented above it, so --help lost
# the flags it exists to list. Stop at the first non-comment line instead.
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --ci) MODE=gate; shift ;;
    --report) MODE=report; shift ;;
    --write-baseline) MODE=write_baseline; shift ;;
    --root) ROOT="${2:-}"; shift 2 ;;
    --root=*) ROOT="${1#*=}"; shift ;;
    --baseline) BASELINE_PATH="${2:-}"; shift 2 ;;
    --baseline=*) BASELINE_PATH="${1#*=}"; shift ;;
    --argv-token-baseline) ARGV_TOKEN_BASELINE_PATH="${2:-}"; shift 2 ;;
    --argv-token-baseline=*) ARGV_TOKEN_BASELINE_PATH="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -d "$ROOT" ] || { echo "last-stack-lint-bin-authoring: no such root: $ROOT" >&2; exit 2; }
ROOT="$(cd "$ROOT" && pwd -P)"
[ -n "$BASELINE_PATH" ] || BASELINE_PATH="$ROOT/config/bin-authoring-baseline.tsv"
[ -n "$ARGV_TOKEN_BASELINE_PATH" ] || ARGV_TOKEN_BASELINE_PATH="$ROOT/config/forge-token-argv-baseline.tsv"

# Never lint this linter: its rule definitions contain deliberate bad examples.
skip_path() {
  case "$1" in
    bin/last-stack-lint-bin-authoring) return 0 ;;
  esac
  return 1
}

# Python recursive walk calls. `.glob("*.md")` is one level and stays out; only
# a `**` glob is recursive.
WALK_RE='\.rglob\(|os\.walk\(|\.glob\([^)]*\*\*|glob\.i?glob\([^)]*\*\*'
# Workspace roots that hold many checkouts. A depth-free walk here is the
# multi-minute case.
ROOT_RE='code/edgevector|\.fkanban|\.cache/edgevector-git|\$HOME/code([[:space:]/"'"'"']|$)|~/code([[:space:]/"'"'"']|$)'
DEPTH_RE='-maxdepth|--max-depth|(^|[[:space:]])-(d|L)[[:space:]]*[0-9]'
FIND_RE='(^|[[:space:];&|(`])[[:space:]]*(sudo[[:space:]]+)?(time[[:space:]]+)?(find|fd)[[:space:]]'
NEST_RE='python3?[[:space:]]+-[[:space:]]*<<'
# An auth header assembled into a child's argv. Two observed shapes: a git
# `-c http.<base>.extraHeader=Authorization: ...` word, and a curl
# `-H "Authorization: ..."` word. The safe spellings (GIT_CONFIG_VALUE_n=... in
# the environment, and `header = "Authorization: ..."` written into a curl -K
# config file) do not match, on purpose.
ARGV_TOKEN_RE='extraHeader=Authorization|-H[[:space:]]*["'"'"']?Authorization:'
# A stat -t format ending in a literal Z. The char before the final Z must not
# be `%` (that is the honest %Z zone-name conversion). Both quote styles are
# spelled out because POSIX ERE has no backreferences.
# NOTE: this pattern begins with `-`, so it MUST be passed as `grep -e "$STAT_ZULU_RE"`.
# Without -e, BSD grep reads it as an option, exits 2 with a usage error that
# 2>/dev/null hides, and the guard silently never fires (caught by its own test).
STAT_ZULU_RE="-t[[:space:]]+('[^']*[^%']Z'|\"[^\"]*[^%\"]Z\")"
STAT_WORD_RE='(^|[^[:alnum:]_-])stat([[:space:]]|$)'
TZ_UTC_RE='(^|[^[:alnum:]_-])TZ=(UTC|utc|Etc/UTC)([[:space:]]|$)'
# Rule 5: a host-state default that bypasses host_path(). Only files that DEFINE
# the helper are in scope. `os.environ.get(` and its HOME-rooted default sit on
# different lines in the commonest spelling, so awk joins the statement (the
# opener plus up to two continuation lines) and matches the joined text.
HOST_PATH_ADOPTER_RE='def[[:space:]]+host_path\('

tmpdir="$(mktemp -d "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack-lint-bin-authoring.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT
hard="$tmpdir/hard.tsv"
nests="$tmpdir/nests.txt"
argv_tokens="$tmpdir/argv-tokens.txt"
stat_zulu="$tmpdir/stat-zulu.tsv"
host_paths="$tmpdir/host-paths.tsv"
: >"$hard"
: >"$nests"
: >"$argv_tokens"
: >"$stat_zulu"
: >"$host_paths"

# Files in scope: every regular file directly under bin/, lib/, hooks/ and
# skills/*/scripts/. A bounded listing, on purpose.
list_targets() {
  local d
  for d in bin lib hooks; do
    [ -d "$ROOT/$d" ] || continue
    find "$ROOT/$d" -maxdepth 1 -type f | sort
  done
  if [ -d "$ROOT/skills" ]; then
    find "$ROOT/skills" -maxdepth 3 -type f -path '*/scripts/*' | sort
  fi
}

is_shell() {
  local first
  first="$(sed -n '1p' "$1")"
  case "$first" in
    '#!'*bash*|'#!'*'/sh'*|'#!'*' sh'*) return 0 ;;
  esac
  return 1
}

while IFS= read -r file; do
  [ -n "$file" ] || continue
  rel="${file#"$ROOT"/}"
  skip_path "$rel" && continue

  # Hard 1: Python recursive walk with no stated bound.
  grep -nE "$WALK_RE" "$file" 2>/dev/null \
    | grep -v 'walk-ok:' \
    | grep -vE '^[0-9]+:[[:space:]]*#' \
    | while IFS= read -r hit; do
        lineno="${hit%%:*}"
        content="${hit#*:}"
        printf 'walk\t%s\t%s\t%s\n' "$rel" "$lineno" "$(printf '%s' "$content" | tr -s '[:space:]' ' ' | cut -c1-160)" >>"$hard"
      done || true

  # Hard 2: shell find/fd over a workspace root without a depth flag.
  grep -nE "$FIND_RE" "$file" 2>/dev/null \
    | grep -E "$ROOT_RE" \
    | grep -vE -- "$DEPTH_RE" \
    | grep -v 'walk-ok:' \
    | grep -vE '^[0-9]+:[[:space:]]*#' \
    | while IFS= read -r hit; do
        lineno="${hit%%:*}"
        content="${hit#*:}"
        printf 'find\t%s\t%s\t%s\n' "$rel" "$lineno" "$(printf '%s' "$content" | tr -s '[:space:]' ' ' | cut -c1-160)" >>"$hard"
      done || true

  # Hard 3: a stat -t format ending in a literal Z (local time wearing a UTC
  # marker). TZ=UTC on the same line makes it correct, so it is excluded.
  grep -nE -e "$STAT_ZULU_RE" "$file" 2>/dev/null \
    | grep -E "$STAT_WORD_RE" \
    | grep -vE "$TZ_UTC_RE" \
    | grep -v 'stat-zulu-ok:' \
    | grep -vE '^[0-9]+:[[:space:]]*#' \
    | while IFS= read -r hit; do
        lineno="${hit%%:*}"
        content="${hit#*:}"
        printf 'stat-zulu\t%s\t%s\t%s\n' "$rel" "$lineno" "$(printf '%s' "$content" | tr -s '[:space:]' ' ' | cut -c1-160)" >>"$stat_zulu"
      done || true

  # Hard 4: in a file that has adopted host_path(), a host-state default that
  # goes around it. Scoped to adopters so it cannot fire on an unrelated helper.
  if grep -qE "$HOST_PATH_ADOPTER_RE" "$file" 2>/dev/null; then
    awk '
      /^[[:space:]]*#/ { next }
      {
        stmt = $0; n = NR
        if (stmt ~ /os\.environ\.get\(/) {
          # Join continuations so a default on the next line is seen.
          while (stmt !~ /host-path-ok:/ && split(stmt, a, /\(/) - 1 > split(stmt, b, /\)/) - 1) {
            if ((getline nxt) <= 0) break
            stmt = stmt " " nxt
          }
          if (stmt ~ /os\.path\.join\(HOME|os\.path\.expanduser\(/ && stmt !~ /host-path-ok:/) {
            gsub(/[[:space:]]+/, " ", stmt)
            print n "\t" substr(stmt, 1, 160)
          }
        }
      }
    ' "$file" 2>/dev/null \
      | while IFS=$'\t' read -r lineno content; do
          printf '%s\t%s\t%s\n' "$rel" "$lineno" "$content" >>"$host_paths"
        done || true
  fi

  # Soft: an auth header on a child process's argv.
  if grep -nE "$ARGV_TOKEN_RE" "$file" 2>/dev/null \
    | grep -v 'argv-token-ok:' \
    | grep -vE '^[0-9]+:[[:space:]]*#' \
    | grep -q .; then
    printf '%s\n' "$rel" >>"$argv_tokens"
  fi

  # Soft: bash→python heredoc nest in a bin/ helper.
  case "$rel" in
    bin/*)
      if is_shell "$file" && grep -qE "$NEST_RE" "$file" 2>/dev/null; then
        printf '%s\n' "$rel" >>"$nests"
      fi
      ;;
  esac
done < <(list_targets)

sort -u "$hard" -o "$hard"
sort -u "$nests" -o "$nests"
sort -u "$argv_tokens" -o "$argv_tokens"
sort -u "$stat_zulu" -o "$stat_zulu"
sort -u "$host_paths" -o "$host_paths"
hard_count="$(wc -l <"$hard" | tr -d ' ')"
stat_zulu_count="$(wc -l <"$stat_zulu" | tr -d ' ')"
host_path_count="$(wc -l <"$host_paths" | tr -d ' ')"
nest_count="$(wc -l <"$nests" | tr -d ' ')"
argv_token_count="$(wc -l <"$argv_tokens" | tr -d ' ')"

write_baseline() {
  mkdir -p "$(dirname "$BASELINE_PATH")"
  {
    printf '# bin-authoring baseline: bin/ helpers that nest a Python program in a bash heredoc.\n'
    printf '# This list may only SHRINK. A new helper with a nest fails the gate; rewrite it in one language.\n'
    printf '# Regenerate after removing a nest: bin/last-stack-lint-bin-authoring --write-baseline\n'
    printf '# path\n'
    cat "$nests"
  } >"$BASELINE_PATH"
  echo "wrote baseline nests=$nest_count -> $BASELINE_PATH"
  mkdir -p "$(dirname "$ARGV_TOKEN_BASELINE_PATH")"
  {
    printf '# forge-token argv baseline: helpers that still build an auth header onto a child process argv.\n'
    printf '# `ps aux` is readable by every local account, so each of these publishes the token machine-wide\n'
    printf '# for the life of the call. This list may only SHRINK. Convert a helper with the safe forms in\n'
    printf '# lib/forge-token.sh: last_stack_forge_export_git_config (GIT_CONFIG_* env) or\n'
    printf '# last_stack_forge_curl_auth_config (0600 curl -K file). Regenerate after converting one:\n'
    printf '#   bin/last-stack-lint-bin-authoring --write-baseline\n'
    printf '# path\n'
    cat "$argv_tokens"
  } >"$ARGV_TOKEN_BASELINE_PATH"
  echo "wrote baseline argv_tokens=$argv_token_count -> $ARGV_TOKEN_BASELINE_PATH"
}

if [ "$MODE" = "write_baseline" ]; then
  write_baseline
  exit 0
fi

baseline="$tmpdir/baseline.txt"
: >"$baseline"
if [ -f "$BASELINE_PATH" ]; then
  grep -vE '^[[:space:]]*(#|$)' "$BASELINE_PATH" | sort -u >"$baseline" || true
fi
argv_baseline="$tmpdir/argv_baseline.txt"
: >"$argv_baseline"
if [ -f "$ARGV_TOKEN_BASELINE_PATH" ]; then
  grep -vE '^[[:space:]]*(#|$)' "$ARGV_TOKEN_BASELINE_PATH" | sort -u >"$argv_baseline" || true
fi
new_argv_tokens="$tmpdir/new_argv_tokens.txt"
retired_argv_tokens="$tmpdir/retired_argv_tokens.txt"
comm -23 "$argv_tokens" "$argv_baseline" >"$new_argv_tokens"
comm -13 "$argv_tokens" "$argv_baseline" >"$retired_argv_tokens"
new_argv_count="$(wc -l <"$new_argv_tokens" | tr -d ' ')"
retired_argv_count="$(wc -l <"$retired_argv_tokens" | tr -d ' ')"

new_nests="$tmpdir/new_nests.txt"
retired_nests="$tmpdir/retired_nests.txt"
comm -23 "$nests" "$baseline" >"$new_nests"
comm -13 "$nests" "$baseline" >"$retired_nests"
new_count="$(wc -l <"$new_nests" | tr -d ' ')"
retired_count="$(wc -l <"$retired_nests" | tr -d ' ')"

if [ "$MODE" = "report" ]; then
  echo "bin-authoring report root=$ROOT hard=$hard_count stat_zulu=$stat_zulu_count host_paths=$host_path_count nests=$nest_count new_nests=$new_count retired_nests=$retired_count argv_tokens=$argv_token_count new_argv_tokens=$new_argv_count retired_argv_tokens=$retired_argv_count"
  [ "$hard_count" -eq 0 ] || { echo "-- hard (kind path line content)"; cat "$hard"; }
  [ "$stat_zulu_count" -eq 0 ] || { echo "-- stat local-zulu (kind path line content)"; cat "$stat_zulu"; }
  [ "$nest_count" -eq 0 ] || { echo "-- nests"; cat "$nests"; }
  [ "$retired_count" -eq 0 ] || { echo "-- retired nests (run --write-baseline)"; cat "$retired_nests"; }
  [ "$host_path_count" -eq 0 ] || { echo "-- host-state defaults bypassing host_path()"; cat "$host_paths"; }
  [ "$argv_token_count" -eq 0 ] || { echo "-- argv token headers"; cat "$argv_tokens"; }
  [ "$retired_argv_count" -eq 0 ] || { echo "-- retired argv token headers (run --write-baseline)"; cat "$retired_argv_tokens"; }
  exit 0
fi

status=0
if [ "$hard_count" -ne 0 ]; then
  status=1
  echo "FAIL last-stack-lint-bin-authoring: $hard_count unbounded walk(s)." >&2
  echo "A depth-free walk over a workspace root takes minutes on this host and reads as a hang." >&2
  echo "Use bin/last-stack-locate-file (env var, fixed candidates, bounded roots), or find ... -maxdepth N," >&2
  echo "or state the bound on the line: # walk-ok: <reason>" >&2
  cat "$hard" >&2
fi
if [ "$host_path_count" -ne 0 ]; then
  status=1
  echo "FAIL last-stack-lint-bin-authoring: $host_path_count host-state default(s) bypass host_path()." >&2
  echo "This file routes reads of the host's real state through one switch so a fixture can isolate from" >&2
  echo "them. A default taken straight from os.environ.get(NAME, os.path.join(HOME, ...)) is invisible to" >&2
  echo "that switch: no fixture can turn it off, and nobody finds out until an alert count moves on the one" >&2
  echo "host that has the files, while CI stays green." >&2
  echo "Use host_path(NAME, default), or say why it is not a read: # host-path-ok: <reason>" >&2
  cat "$host_paths" >&2
fi
if [ "$stat_zulu_count" -ne 0 ]; then
  status=1
  echo "FAIL last-stack-lint-bin-authoring: $stat_zulu_count stat -t format(s) end in a LITERAL Z." >&2
  echo "BSD stat renders %F/%T in the LOCAL zone and emits a trailing Z as a literal character, so the" >&2
  echo "helper writes local time wearing a UTC marker -- 25200s in the past, always OLDER, which" >&2
  echo "manufactures stalls. In a shipped helper that is a scheduled false incident." >&2
  echo "Use: date -u -r \"\$(stat -f %m -- \"\$f\")\" +%FT%TZ   (or compare epochs and never format)" >&2
  echo "TZ=UTC on the same line passes. If a line genuinely wants this, state why: # stat-zulu-ok: <reason>" >&2
  cat "$stat_zulu" >&2
fi
if [ "$new_count" -ne 0 ]; then
  status=1
  echo "FAIL last-stack-lint-bin-authoring: $new_count bin/ helper(s) nest a Python program in a bash heredoc:" >&2
  cat "$new_nests" >&2
  echo "Write a new helper in ONE language (#!/usr/bin/env python3 with argparse, or pure bash)." >&2
  echo "The baseline at $BASELINE_PATH only shrinks; it is not the place for a new nest." >&2
fi
if [ "$new_argv_count" -ne 0 ]; then
  status=1
  echo "FAIL last-stack-lint-bin-authoring: $new_argv_count helper(s) build an auth header onto a child process argv:" >&2
  cat "$new_argv_tokens" >&2
  echo "\`ps aux\` is readable by every local account, so the token is published machine-wide for the call." >&2
  echo "Use lib/forge-token.sh: last_stack_forge_export_git_config (GIT_CONFIG_* in the environment) for git," >&2
  echo "or last_stack_forge_curl_auth_config (a 0600 file passed as curl -K) for curl." >&2
  echo "If a line genuinely needs argv, state why on it: # argv-token-ok: <reason>" >&2
  echo "The baseline at $ARGV_TOKEN_BASELINE_PATH only shrinks; it is not the place for a new site." >&2
fi
if [ "$status" -eq 0 ]; then
  echo "ok last-stack-lint-bin-authoring hard=0 stat_zulu=0 host_paths=0 nests=$nest_count baseline=$(wc -l <"$baseline" | tr -d ' ') retired=$retired_count argv_tokens=$argv_token_count argv_baseline=$(wc -l <"$argv_baseline" | tr -d ' ') argv_retired=$retired_argv_count"
fi
exit "$status"
