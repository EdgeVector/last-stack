#!/usr/bin/env bash
# last-stack-forge-runner-watchdog — page the owner when a CI runner lane is dead.
#
# Watches the lanes that, when down, silently stop merges:
#   merge_gate — mac-forge-runner (macos-arm64), the CI lane of the lastgit repo
#                (the one repo left on Forgejo; the host lanes for fold and
#                exemem-infra are no longer watched, those repos are on GitHub)
#   lastgit    — the `lastgit forge run` supervisor that merges LastGit CRs
#
# Why this exists: `last-stack-forge-runner-lanes` defaults to config-on-disk, so
# it reported heavy_ok=true for the ~2 days (2026-07-28 -> 07-30) both heavy
# runners were unloaded. Nothing asserted LIVE state on a schedule, and nothing
# paged. See brain papercut-forge-heavy-runners-unloaded-and-fold-queue-63-deep.
#
# Revive policy (standing permission covers crashed runners, NOT deliberate
# pauses): a lane is auto-revived only when its plist is present and unsuffixed.
# A `.paused-*` sibling means a human parked it on purpose — report, never revive.
# Note a bare `launchctl disable` with no marker is NOT distinguishable from a
# crash; we treat it as revivable and say so in the page.
#
# The gaming PC runners (heavy, pc-linux) and their owner-pause file were
# retired on 2026-09-29 when Tom moved every EdgeVector dependency off the PC.
#
# Exit: 0 all lanes healthy (or only deliberately-paused), 1 a lane is down.

set -u

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Absolute defaults so a launchd run never depends on PATH; overridable so the
# test suite can stub launchd/forge/ra without touching the real machine.
LAUNCHCTL="${FORGE_WATCHDOG_LAUNCHCTL:-/bin/launchctl}"
JQ="${FORGE_WATCHDOG_JQ:-/usr/bin/jq}"
RA_BIN="${FORGE_WATCHDOG_RA:-$HOME/.local/bin/ra}"
LANES_BIN="${FORGE_WATCHDOG_LANES:-$BIN_DIR/last-stack-forge-runner-lanes}"
SITUATIONS_BIN="${FORGE_WATCHDOG_SITUATIONS:-$HOME/.local/bin/situations}"
PLIST_DIR="${FORGE_WATCHDOG_PLIST_DIR:-$HOME/Library/LaunchAgents}"
STATE_DIR="${FORGE_WATCHDOG_STATE_DIR:-$HOME/.local/state/last-stack/forge-runner-watchdog}"
STATE_FILE="$STATE_DIR/state.json"
LOG_FILE="$STATE_DIR/watchdog.log"
FORGE_LOG="${FORGE_WATCHDOG_FORGE_LOG:-$HOME/.lastgit/forge-primary/forge.log}"

# Re-page cadence for a condition that stays broken (seconds). Page is immediate
# on a new failure; this only throttles the nagging.
REPAGE_AFTER="${FORGE_WATCHDOG_REPAGE_AFTER:-14400}"   # 4h
# forge.log older than this means the LastGit supervisor is not cycling.
FORGE_LOG_STALE_AFTER="${FORGE_WATCHDOG_FORGE_STALE:-1800}"  # 30m

DRY_RUN=0
NO_REVIVE=0
FORCE_PAGE=0

usage() {
  cat <<'EOF' >&2
usage: last-stack-forge-runner-watchdog [--dry-run] [--no-revive] [--force-page]

Checks that every CI runner lane is LIVE (not merely configured), revives a
crashed lane when standing permission allows, and pages the owner via `ra notify`
only when something is actually down.

  --dry-run     probe and print; never revive, never page
  --no-revive   page on failure but do not touch launchd
  --force-page  ignore the re-page cooldown (for testing the channel)

State: $HOME/.local/state/last-stack/forge-runner-watchdog/state.json
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --no-revive) NO_REVIVE=1; shift ;;
    --force-page) FORCE_PAGE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

mkdir -p "$STATE_DIR" 2>/dev/null || true
[ -f "$STATE_FILE" ] || printf '{}\n' > "$STATE_FILE"

now_epoch() { /bin/date +%s; }
stamp() { /bin/date -u +%Y-%m-%dT%H:%M:%SZ; }

log() {
  printf '%s %s\n' "$(stamp)" "$*" >> "$LOG_FILE" 2>/dev/null || true
  [ "$DRY_RUN" -eq 1 ] && printf '%s\n' "$*"
  return 0
}

# --- findings accumulator -----------------------------------------------------
# Parallel newline-delimited lists (bash 3.2: no associative arrays).
DOWN_KEYS=""
DOWN_MSGS=""
DOWN_NAMES=""
INFO_MSGS=""

add_down() {  # key, human message, short name (defaults to the key)
  DOWN_KEYS="${DOWN_KEYS}$1
"
  DOWN_MSGS="${DOWN_MSGS}$2
"
  DOWN_NAMES="${DOWN_NAMES}${3:-$1}
"
}

# Short name for a key, by position in the parallel lists.
name_for_key() {
  local want="$1" i=1 k
  while IFS= read -r k; do
    [ "$k" = "$want" ] && { printf '%s' "$(printf '%s' "$DOWN_NAMES" | /usr/bin/sed -n "${i}p")"; return 0; }
    i=$((i + 1))
  done <<EOF
$DOWN_KEYS
EOF
  printf '%s' "$want"
}
add_info() { INFO_MSGS="${INFO_MSGS}$1
"; }

# --- launchd helpers ----------------------------------------------------------

agent_loaded() {  # label -> 0 if loaded
  $LAUNCHCTL list 2>/dev/null | /usr/bin/grep -q "[[:space:]]$1\$"
}

# A lane is "deliberately parked" only when a .paused-* plist exists and the
# live plist does not. That is the marker a human pause leaves behind.
deliberately_paused() {  # label
  local live="$PLIST_DIR/$1.plist"
  local parked
  parked="$(/bin/ls "$PLIST_DIR" 2>/dev/null | /usr/bin/grep -c "^$1\.plist\.paused-" || true)"
  [ ! -f "$live" ] && [ "${parked:-0}" -gt 0 ]
}

revive_agent() {  # label -> 0 on success
  local label="$1" plist="$PLIST_DIR/$1.plist"
  [ -f "$plist" ] || { log "revive $label: no plist at $plist"; return 1; }
  if [ "$DRY_RUN" -eq 1 ] || [ "$NO_REVIVE" -eq 1 ]; then
    log "revive $label: skipped (dry-run/no-revive)"
    return 1
  fi
  # `launchctl disable` outlives a plist rename and silently defeats bootstrap,
  # so enable must come first. This is what made the 07-29 forge-primary restore
  # look like an opaque I/O error.
  $LAUNCHCTL enable "gui/$(/usr/bin/id -u)/$label" 2>/dev/null || true
  $LAUNCHCTL bootstrap "gui/$(/usr/bin/id -u)" "$plist" 2>/dev/null || true
  /bin/sleep 3
  agent_loaded "$label"
}

# Preflight guards shared-system mutation against an active Situation.
preflight_ok() {
  local sit="$SITUATIONS_BIN"
  [ -x "$sit" ] || return 0   # cannot check -> do not block the revive
  "$sit" preflight --action revive-forge-runner >/dev/null 2>&1
  local rc=$?
  [ "$rc" -eq 3 ] && return 1
  return 0
}

# --- live forge inventory ------------------------------------------------------
# Read once, before the launchd checks. `launchctl list` answers for the caller's
# own launchd view: from a sandboxed or routine shell it can omit a runner that
# is loaded and serving jobs. On 2026-09-22 two pickup runs saw --dry-run report
# all three lanes NOT loaded (WOULD PAGE) while `last-stack-forge-runner-lanes
# --check --live` showed the same runners active/idle on the forge. The forge's
# own runner inventory is the ground truth for "is this lane serving jobs".
# papercut-forge-runner-watchdog-dry-run-misclassifies-live-runners-20260922
#
# The lanes helper exits 0 even when its live read fails; the failure is only in
# the JSON (`.live.ok == false`, `.live.error`). So there are three states:
#   LIVE_OK=1            complete inventory (`.live.ok == true`)
#   LIVE_READ=1, OK=0    the helper ran but the inventory is unreadable or
#                        partial (e.g. HTTP 403, token lacks read:admin)
#   LIVE_READ=0          the helper failed or printed no JSON (forge API down)
# An unreadable inventory must never read as "no runners": on 2026-09-23 a 403
# made an empty admin list page "heavy lane down" and "pc-linux not registered".
# papercut-forge-runner-watchdog-treats-failed-live-read-as-empty-inventory-20260923
LIVE_JSON="$STATE_DIR/lanes-live.json"
LIVE_OK=0
LIVE_READ=0
LIVE_ERROR=""
if "$LANES_BIN" --live --json > "$LIVE_JSON" 2>/dev/null \
   && "$JQ" -e 'type == "object"' "$LIVE_JSON" >/dev/null 2>&1; then
  LIVE_READ=1
  if "$JQ" -e '.live.ok == true' "$LIVE_JSON" >/dev/null 2>&1; then
    LIVE_OK=1
  else
    LIVE_ERROR="$($JQ -r '.live.error // "unknown error"' "$LIVE_JSON" 2>/dev/null || echo 'unknown error')"
  fi
fi

# Forge status (idle/active/offline/...) of a runner by name, or empty. A
# partial inventory still counts: a runner the forge DOES list as idle/active is
# serving jobs even when another endpoint (admin) was unreadable.
runner_live_status() {  # runner-name
  [ "$LIVE_READ" -eq 1 ] || return 0
  $JQ -r --arg n "$1" '
    [ (.live.admin_runners // [])[], ((.live.repo_runners // {}) | .[][]?) ]
    | map(select(.name == $n)) | .[0].status // empty' "$LIVE_JSON" 2>/dev/null || true
}

# --- launchd view sentinel -----------------------------------------------------
# A sandboxed or routine shell can get an empty or foreign `launchctl list`. The
# watchdog's own LaunchAgent is always loaded in the owner's gui domain, so when
# the caller cannot see it, the caller's launchd view is blind: "not listed"
# then proves nothing. On 2026-09-23T05:58Z a blind shell ran the paging mode
# while the forge inventory was a 403, and paged all three Mac lanes DOWN; the
# scheduled run 12 minutes later paged "healthy again".
LAUNCHD_SENTINEL="${FORGE_WATCHDOG_LAUNCHD_SENTINEL:-com.edgevector.forge-runner-watchdog}"
LAUNCHD_VIEW_OK=1
agent_loaded "$LAUNCHD_SENTINEL" || LAUNCHD_VIEW_OK=0

# --- lane checks --------------------------------------------------------------

check_local_lane() {  # label, human-name, what-it-blocks, [forge runner name]
  local label="$1" name="$2" blocks="$3" runner="${4:-}" status
  if agent_loaded "$label"; then
    return 0
  fi
  # launchd did not list it. When the forge reports the runner idle or active,
  # the lane IS serving jobs: record the disagreement, never revive or page.
  if [ -n "$runner" ]; then
    status="$(runner_live_status "$runner")"
    case "$status" in
      idle|active)
        add_info "$name: launchctl in this shell does not list $label, but the forge reports runner $runner '$status'. Treated as live."
        return 0
        ;;
    esac
  fi
  if deliberately_paused "$label"; then
    add_info "$name is parked on purpose (.paused-* marker) — not reviving."
    return 0
  fi
  # Blind launchd view AND no complete forge inventory: there is no evidence
  # either way. Do not revive from a domain we cannot see, and do not page.
  if [ "$LAUNCHD_VIEW_OK" -eq 0 ] && [ "$LIVE_OK" -eq 0 ]; then
    add_info "$name: this shell cannot see launchd ($LAUNCHD_SENTINEL not listed) and the forge inventory is incomplete. Lane state unknown here; not reviving, not paging."
    log "$name ($label): launchd view blind and forge inventory incomplete; skipped"
    return 0
  fi
  log "$name ($label) is NOT loaded; attempting revive"
  if preflight_ok && revive_agent "$label"; then
    add_info "$name was down and has been revived automatically."
    return 0
  fi
  add_down "$label" "$name is DOWN and could not be revived. Blocks: $blocks." "$name"
  return 1
}

# 1. Local Forgejo runner lane (Mac). Only the merge-gate runner is watched: the
#    repo-scoped host runners served fold and exemem-infra, which moved to GitHub
#    (fold 2026-09-29, exemem-infra 2026-09-30), and every other repo except
#    EdgeVector/lastgit moved too. This watchdog does not revive, page about, or
#    stop com.edgevector.forgejo-runner-host or -host-exemem-infra any more.
check_local_lane com.edgevector.forgejo-runner \
  "Forge merge-gate runner" "all macos-arm64 CI jobs of the lastgit repo" mac-forge-runner

# 3. Live registration, not just a running process. The Mac runners are checked
#    through launchd above (with the forge inventory as the tie-breaker); a
#    complete inventory adds no further lane check.
if [ "$LIVE_OK" -eq 1 ]; then
  :
elif [ "$LIVE_READ" -eq 1 ]; then
  # The forge answered, but the runner inventory is unreadable. That is an
  # observability failure, not a runner outage: name it as such.
  add_down "forge-inventory-unreadable" \
    "Forge runner inventory is unreadable ($LIVE_ERROR). The watchdog cannot confirm the live runner lanes. This does NOT mean the runners are down. Fix: store a read:admin token as lastsecrets forgejo-admin-read-token, or unlock the login keychain (forgejo-token)." \
    "forge runner inventory"
else
  add_down "forge-api" "Could not query the Forgejo runner API — forge may be down, or the token is unreadable." "forge API"
fi

# 4. LastGit forge supervisor: merges every LastGit-native CR. When it stops,
#    CRs sit green-but-unmerged and each one looks like an independent mystery.
if [ -f "$FORGE_LOG" ]; then
  log_mtime="$(/usr/bin/stat -f %m "$FORGE_LOG" 2>/dev/null || echo 0)"
  age=$(( $(now_epoch) - ${log_mtime:-0} ))
  if [ "$age" -gt "$FORGE_LOG_STALE_AFTER" ]; then
    if deliberately_paused com.edgevector.lastgit-forge-primary; then
      add_info "LastGit forge supervisor is parked on purpose — LastGit CRs will not auto-merge."
    else
      check_local_lane com.edgevector.lastgit-forge-primary \
        "LastGit forge supervisor" "auto-merge for every LastGit-native CR"
      # Revived or not, a stale log is the symptom worth naming.
      if [ "$age" -gt "$FORGE_LOG_STALE_AFTER" ]; then
        add_info "LastGit forge.log had not advanced in $(( age / 60 )) min."
      fi
    fi
  fi
fi

# --- paging -------------------------------------------------------------------

should_page() {  # key -> 0 if we should page now
  [ "$FORCE_PAGE" -eq 1 ] && return 0
  local key="$1" last
  last="$($JQ -r --arg k "$key" '.[$k].last_paged // 0' "$STATE_FILE" 2>/dev/null || echo 0)"
  [ $(( $(now_epoch) - ${last:-0} )) -ge "$REPAGE_AFTER" ]
}

record_state() {  # key, last_paged_epoch
  local key="$1" paged="$2" tmp="$STATE_FILE.tmp"
  [ "$DRY_RUN" -eq 1 ] && return 0   # a probe must never rewrite paging history
  $JQ --arg k "$key" --arg nm "$(name_for_key "$key")" \
      --argjson p "$paged" --argjson n "$(now_epoch)" \
    '.[$k] = {last_paged: $p, last_seen: $n, name: $nm}' "$STATE_FILE" > "$tmp" 2>/dev/null \
    && /bin/mv "$tmp" "$STATE_FILE"
}

# Prints the friendly name of a cleared key on stdout; exit 0 if it had been failing.
clear_state() {  # key
  local key="$1" tmp="$STATE_FILE.tmp" had nm
  had="$($JQ -r --arg k "$key" 'has($k) | tostring' "$STATE_FILE" 2>/dev/null || echo false)"
  nm="$($JQ -r --arg k "$key" '.[$k].name // $k' "$STATE_FILE" 2>/dev/null || printf '%s' "$key")"
  if [ "$DRY_RUN" -eq 0 ]; then
    $JQ --arg k "$key" 'del(.[$k])' "$STATE_FILE" > "$tmp" 2>/dev/null && /bin/mv "$tmp" "$STATE_FILE"
  fi
  [ "$had" = "true" ] || return 1
  printf '%s' "$nm"
}

notify() {  # priority, message
  local prio="$1" msg="$2" ra="$RA_BIN"
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'WOULD PAGE [%s]: %s\n' "$prio" "$msg"
    return 0
  fi
  [ -x "$ra" ] || { log "PAGE FAILED (no ra): $msg"; return 1; }
  "$ra" notify "$msg" --priority "$prio" >/dev/null 2>&1 || { log "PAGE FAILED: $msg"; return 1; }
  log "paged [$prio]: $msg"
}

# Recovery: anything previously failing that is healthy now.
#
RECOVERED=""
if [ -s "$STATE_FILE" ]; then
  for key in $($JQ -r 'keys[]?' "$STATE_FILE" 2>/dev/null); do
    case "$DOWN_KEYS" in
      *"$key"*) : ;;
      *) nm="$(clear_state "$key")" && RECOVERED="${RECOVERED}${RECOVERED:+, }$nm" ;;
    esac
  done
fi

if [ -n "$(printf '%s' "$DOWN_KEYS" | /usr/bin/tr -d '[:space:]')" ]; then
  BODY="🚨 CI runner lane down"
  PAGE_PRIO=high
  # An unreadable inventory alone is a blind watchdog, not a dead lane: say so,
  # and page at normal priority.
  if [ "$(printf '%s' "$DOWN_KEYS" | /usr/bin/grep -v -x -e 'forge-inventory-unreadable' -e '' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" = "0" ]; then
    BODY="⚠️ CI runner watchdog is blind: forge runner inventory unreadable"
    PAGE_PRIO=normal
  fi
  while IFS= read -r m; do
    [ -n "$m" ] && BODY="$BODY
• $m"
  done <<EOF
$DOWN_MSGS
EOF
  while IFS= read -r m; do
    [ -n "$m" ] && BODY="$BODY
ℹ️ $m"
  done <<EOF
$INFO_MSGS
EOF
  BODY="$BODY

Auto-revive was attempted where standing permission allows. This one needs a human.
Check: last-stack-forge-runner-lanes --check --live"

  PAGED_ANY=0
  while IFS= read -r key; do
    [ -z "$key" ] && continue
    if should_page "$key"; then PAGED_ANY=1; fi
  done <<EOF
$DOWN_KEYS
EOF

  if [ "$PAGED_ANY" -eq 1 ]; then
    notify "$PAGE_PRIO" "$BODY"
    NOWP="$(now_epoch)"
    while IFS= read -r key; do
      [ -n "$key" ] && record_state "$key" "$NOWP"
    done <<EOF
$DOWN_KEYS
EOF
  else
    log "lane(s) still down but within re-page cooldown; not paging"
    NOWP=0
    while IFS= read -r key; do
      [ -n "$key" ] && record_state "$key" \
        "$($JQ -r --arg k "$key" '.[$k].last_paged // 0' "$STATE_FILE" 2>/dev/null || echo 0)"
    done <<EOF
$DOWN_KEYS
EOF
  fi
  exit 1
fi

# Healthy. Announce recovery once, plus any self-heal we performed, then go quiet.
if [ -n "$RECOVERED" ]; then
  notify normal "✅ CI runner lanes healthy again ($RECOVERED). Merges are unblocked."
elif [ -n "$(printf '%s' "$INFO_MSGS" | /usr/bin/tr -d '[:space:]')" ]; then
  # Self-healed this run, or a lane is parked on purpose: log it, do not page.
  while IFS= read -r m; do
    [ -n "$m" ] && log "info: $m"
  done <<EOF
$INFO_MSGS
EOF
fi

log "all lanes healthy"
exit 0
