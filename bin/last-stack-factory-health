#!/usr/bin/env python3
"""Hourly Kanban Factory health check — configurable bands, low false positives.

Phase 1: diagnose + ra notify Tom. Auto-fix is opt-in via config.

Usage:
  last-stack-factory-health [--dry-run] [--config PATH] [--json] [--no-notify]

Exit 0 always after a completed pass (including alerts). Exit 2 on usage error.
Heartbeat line:
  factory-health <ISO> ok|soft|hard|noop alerts=N … factory=…
    runnable_by_ns=<ns>:<cards>/<active_ms>/<decomposable_ms>,… jammed=<ns,…|none|unknown>
    jam_passes=N

Supply (runnable cards per admitted North Star): an admitted North Star with
zero runnable Kind:pr cards and zero in_flight/idle_promoteable milestones is
jammed. A jam makes the verdict soft on the first pass and pages (hard) once it
holds for [supply] alarm_after_passes consecutive passes. State and
supply-latest.json live in ~/.local/state/last-stack/factory-health/
(override FACTORY_HEALTH_SUPPLY_STATE_DIR).
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import socket
import statistics
import subprocess
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass, field, asdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Optional

try:
    from zoneinfo import ZoneInfo
except ImportError:  # pragma: no cover
    ZoneInfo = None  # type: ignore


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def iso_z(dt: Optional[datetime] = None) -> str:
    d = dt or utc_now()
    return d.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(cmd: list[str], timeout: float = 60.0) -> tuple[int, str, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout or "", p.stderr or ""
    except Exception as e:
        return 1, "", str(e)


def strip_controls(s: str) -> str:
    return re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", " ", s or "")


def parse_json(raw: str) -> Any:
    return json.loads(strip_controls(raw))


def load_toml(path: Path) -> dict[str, Any]:
    text = path.read_text(encoding="utf-8")
    try:
        import tomllib  # py311+

        return tomllib.loads(text)
    except ModuleNotFoundError:
        pass
    # Minimal fallback for known flat sections (no nested arrays of tables).
    data: dict[str, Any] = {}
    section = ""
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            data.setdefault(section, {})
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip(), v.strip()
        if v.startswith("[") and v.endswith("]"):
            inner = v[1:-1].strip()
            if not inner:
                val: Any = []
            else:
                parts = [p.strip() for p in inner.split(",")]
                out = []
                for p in parts:
                    if p.startswith('"') and p.endswith('"'):
                        out.append(p[1:-1])
                    else:
                        try:
                            out.append(int(p))
                        except ValueError:
                            try:
                                out.append(float(p))
                            except ValueError:
                                out.append(p)
                val = out
        elif v in ("true", "false"):
            val = v == "true"
        elif v.startswith('"') and v.endswith('"'):
            val = v[1:-1]
        else:
            try:
                val = int(v)
            except ValueError:
                try:
                    val = float(v)
                except ValueError:
                    val = v
        if section:
            data[section][k] = val
        else:
            data[k] = val
    return data


def cfg_get(cfg: dict[str, Any], section: str, key: str, default: Any) -> Any:
    sec = cfg.get(section) or {}
    if not isinstance(sec, dict):
        return default
    return sec[key] if key in sec else default


@dataclass
class Alert:
    severity: str  # soft | hard
    code: str
    title: str
    detail: str
    recommendations: list[str] = field(default_factory=list)
    # False keeps the alert in the verdict and the heartbeat but out of the
    # out-of-band message: a first supply-jam pass must not page on its own.
    notify: bool = True


@dataclass
class Snapshot:
    ts: str
    pickup_ready: int = -1
    todo: int = 0
    doing: int = 0
    backlog: int = 0
    done: int = 0
    ships_last_h: Optional[float] = 0.0
    ships_24h: Optional[float] = 0.0
    ships_per_hour_24h: Optional[float] = 0.0
    # False when a window has no measured value (null / available=false).
    # A missing reading must not become a zero that pages Tom.
    ships_available: bool = True
    ships_source: str = ""
    max_doing_age_h: float = 0.0
    stale_doing: int = 0
    doing_with_pr: int = 0
    # Backlog cards that claim to be runnable work but structurally cannot be
    # claimed — see unreachable_backlog_cards().
    parked_ungated: int = 0
    parked_ungated_oldest_h: float = 0.0
    parked_ungated_slugs: list[str] = field(default_factory=list)


def default_config_path(last_stack: Path) -> Path:
    env = os.environ.get("FACTORY_HEALTH_CONFIG")
    if env:
        return Path(env)
    return last_stack / "config" / "factory-health.toml"


def state_dir(last_stack: Path) -> Path:
    env = os.environ.get("FACTORY_HEALTH_STATE_DIR")
    if env:
        return Path(env)
    return Path.home() / ".last-stack" / "state" / "factory-health"


def load_state(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"history": [], "streaks": {}, "last_alert": {}}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {"history": [], "streaks": {}, "last_alert": {}}


def save_state(path: Path, state: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


@dataclass
class FactoryFetch:
    """Result of GET /api/state. kind is ok|timeout|refused|http|parse|down."""

    data: Optional[dict[str, Any]] = None
    kind: str = "down"
    elapsed_s: float = 0.0
    detail: str = ""


@dataclass
class ShipRead:
    """One ship-meter reading. None counts mean unavailable, never a silent 0."""

    last_h: Optional[float]
    h24: Optional[float]
    per_hour_24h: Optional[float]
    hourly: list[dict[str, Any]]
    available: bool
    source: str

    @staticmethod
    def missing(source: str = "unavailable") -> "ShipRead":
        return ShipRead(None, None, None, [], False, source)


# Cold dashboard probes on 2026-09-04 took up to 13.07s and still returned HTTP
# 200. 4s sat inside that spread and painted factory=down. 20s is above the
# measured spread (the same budget as the curl -m 20 probes).
DEFAULT_FACTORY_TIMEOUT_S = 20.0
HOUR_S = 3600.0


def _is_timeout_exc(exc: BaseException) -> bool:
    if isinstance(exc, (TimeoutError, socket.timeout)):
        return True
    reason = getattr(exc, "reason", None)
    if isinstance(reason, (TimeoutError, socket.timeout)):
        return True
    text = str(reason or exc).lower()
    return "timed out" in text or "timeout" in text


def _is_refused_exc(exc: BaseException) -> bool:
    if isinstance(exc, ConnectionRefusedError):
        return True
    reason = getattr(exc, "reason", None)
    if isinstance(reason, ConnectionRefusedError):
        return True
    text = str(reason or exc).lower()
    return "connection refused" in text or "refused" in text


def fetch_factory(url: str, timeout: float = DEFAULT_FACTORY_TIMEOUT_S) -> FactoryFetch:
    """GET /api/state. A slow 200 is ok; a timeout is not a down dashboard."""
    t0 = time.time()
    try:
        req = urllib.request.Request(url.rstrip("/") + "/api/state", method="GET")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            data = parse_json(raw)
            if not isinstance(data, dict):
                return FactoryFetch(
                    kind="parse",
                    elapsed_s=time.time() - t0,
                    detail="api/state was not an object",
                )
            return FactoryFetch(data=data, kind="ok", elapsed_s=time.time() - t0)
    except urllib.error.HTTPError as e:
        return FactoryFetch(
            kind="http",
            elapsed_s=time.time() - t0,
            detail=f"HTTP {e.code}",
        )
    except Exception as e:
        elapsed = time.time() - t0
        if _is_timeout_exc(e):
            return FactoryFetch(kind="timeout", elapsed_s=elapsed, detail=str(e)[:200])
        if _is_refused_exc(e):
            return FactoryFetch(kind="refused", elapsed_s=elapsed, detail=str(e)[:200])
        return FactoryFetch(kind="down", elapsed_s=elapsed, detail=str(e)[:200])


def _opt_float(value: Any) -> Optional[float]:
    if value is None:
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def dashboard_is_merge_derived(velocity: dict[str, Any]) -> bool:
    """True when /api/state velocity is the ship-meter, not the old card count."""
    ships = velocity.get("ships")
    h24 = ships.get("h24") if isinstance(ships, dict) else None
    if not isinstance(h24, dict):
        h24 = {}
    return (
        isinstance(velocity.get("available"), bool)
        or "available" in h24
        or "boardCompletions" in velocity
        or "unavailableRepos" in velocity
        or "unlanded" in h24
    )


def ships_from_dashboard(
    factory: Optional[dict[str, Any]], use_completed_hour: bool
) -> Optional[ShipRead]:
    """Read merge-derived ships from /api/state. None → caller should fall back."""
    if not factory or not isinstance(factory.get("velocity"), dict):
        return None
    vel = factory["velocity"]
    if not dashboard_is_merge_derived(vel):
        # Old card-based meter. A reaper deletes the history; do not trust it.
        return None
    ships = vel.get("ships") if isinstance(vel.get("ships"), dict) else {}
    h24 = ships.get("h24") if isinstance(ships.get("h24"), dict) else {}
    hourly = list(vel.get("hourly") or [])
    h24_count = h24.get("count")
    h24_avail = h24.get("available")
    if h24_avail is None:
        h24_avail = vel.get("available")
    window_missing = h24_count is None
    available = (h24_avail is not False) and not window_missing
    # `unknown` merges are ones the dashboard could not test because its local
    # mirror (~/.cache/edgevector-git, never fetched by the meter) lacks the
    # object. They are never counted. On 2026-09-26 the same forge history read
    # h24=46, then 1, then 22 (unknown=34) within 25 minutes while Forgejo held
    # 54 merges, and the 1 raised ship_volume_hard. When unknown merges
    # outnumber counted ones the count is a floor, not a measurement.
    # papercut-factory-health-ship-count-swings-on-stale-local-mirrors-20260926
    h24_unknown = _opt_float(h24.get("unknown"))
    unknown_heavy = (h24_unknown is not None and h24_count is not None
                     and h24_unknown > float(h24_count))
    if unknown_heavy:
        available = False

    target_ago = 1 if use_completed_hour else 0
    last_h: Optional[float] = None
    last_avail = True
    for b in hourly:
        if int(b.get("hourAgo", -1)) == target_ago:
            last_h = _opt_float(b.get("ships"))
            if "available" in b:
                last_avail = bool(b.get("available"))
            break
    if last_h is None and hourly and available:
        last_h = _opt_float(hourly[-1].get("ships"))

    per_hour = _opt_float(h24.get("perHour"))
    h24_f = _opt_float(h24_count)
    if h24_f is not None and per_hour is None:
        per_hour = h24_f / 24.0
    if not last_avail:
        last_h = None
    if window_missing or h24_avail is False or unknown_heavy:
        # A partial read (some repos unreadable) is not a measured count. The
        # dashboard read 0 with available=false on 2026-09-25 while the forge
        # held 21 merges; the 0 went to Tom as ships_24h=0.
        h24_f = None
        per_hour = None
    return ShipRead(
        last_h=last_h,
        h24=h24_f,
        per_hour_24h=per_hour,
        hourly=hourly,
        available=available and last_avail,
        source="dashboard",
    )


def parse_merge_ts(raw: Any) -> Optional[float]:
    if raw is None or raw == "":
        return None
    if isinstance(raw, (int, float)):
        v = float(raw)
        # ns/ms/s heuristic
        if v > 1e12:
            return v / 1000.0
        return v
    try:
        dt = datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
        return dt.timestamp()
    except Exception:
        return None


def ships_from_merge_times(
    timestamps: list[float],
    now: Optional[float] = None,
    use_completed_hour: bool = True,
    source: str = "lastgit",
) -> ShipRead:
    """Bucket merge timestamps into last completed hour and the last 24 h."""
    now = time.time() if now is None else now
    last_h = 0
    h24 = 0
    hourly_counts = [0] * 24
    for ts in timestamps:
        age_h = (now - ts) / HOUR_S
        if age_h < 0 or age_h > 24:
            continue
        h24 += 1
        bucket = min(int(age_h), 23)
        hourly_counts[bucket] += 1
        if use_completed_hour:
            if 1.0 <= age_h < 2.0:
                last_h += 1
        elif age_h < 1.0:
            last_h += 1
    hourly = [
        {"hourAgo": i, "ships": hourly_counts[i], "available": True}
        for i in range(24)
    ]
    return ShipRead(
        last_h=float(last_h),
        h24=float(h24),
        per_hour_24h=(h24 / 24.0) if h24 else 0.0,
        hourly=hourly,
        available=True,
        source=source,
    )


def lastgit_merged_times(
    since_h: float = 26.0, runner=None
) -> Optional[list[float]]:
    """Fleet merged-CR timestamps, or None when the CLI itself failed."""
    runner = runner or run
    code, out, _err = runner(
        [
            "lastgit",
            "cr",
            "list",
            "--all-repos",
            "--state",
            "merged",
            "--since",
            f"{int(since_h)}h",
            "--json",
        ],
        timeout=45.0,
    )
    if code != 0:
        return None
    try:
        rows = parse_json(out)
    except Exception:
        return None
    if not isinstance(rows, list):
        return None
    times: list[float] = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        ts = parse_merge_ts(
            row.get("merged_at")
            or row.get("mergedAt")
            or row.get("closed_at")
            or row.get("updated_at")
        )
        if ts is not None:
            times.append(ts)
    return times


FORGEJO_PAGE_LIMIT = 20
FORGEJO_MAX_PAGES = 5


def forgejo_merged_times(
    since_h: float = 26.0,
    org: str = "EdgeVector",
    runner=None,
    now: Optional[float] = None,
    budget_s: float = 90.0,
) -> Optional[list[float]]:
    """Merged Forgejo PR timestamps across one org. None = the listing failed.

    A 50-PR page carries every PR body and took 10-44 s under host load on
    2026-09-25. Repos not updated inside the window hold no merge inside it
    and are skipped; the rest are read in 20-PR pages that stop at the window
    edge. A budget that runs out before every active repo is read returns
    None: a partial read is not a measured count.
    """
    runner = runner or run
    now = time.time() if now is None else now
    cutoff = now - since_h * HOUR_S
    t0 = time.time()
    api = "last-stack-forge-api"
    repos: list[Any] = []
    for page in range(1, 6):
        code, out, _err = runner(
            [api, f"orgs/{org}/repos?limit=50&page={page}"],
            timeout=20.0,
        )
        if code != 0:
            return None
        try:
            batch = parse_json(out)
        except Exception:
            return None
        if not isinstance(batch, list):
            return None
        repos.extend(batch)
        if len(batch) < 50:
            break
    times: list[float] = []
    any_ok = False
    for repo in repos:
        name = ""
        if isinstance(repo, dict):
            if repo.get("archived") or repo.get("mirror"):
                continue
            updated = parse_merge_ts(repo.get("updated_at"))
            if updated is not None and updated < cutoff:
                any_ok = True
                continue
            name = str(repo.get("name") or repo.get("full_name") or "")
            if "/" in name:
                name = name.rsplit("/", 1)[-1]
        if not name:
            continue
        for page in range(1, FORGEJO_MAX_PAGES + 1):
            if time.time() - t0 > budget_s:
                return None
            code, out, _err = runner(
                [
                    api,
                    f"repos/{org}/{name}/pulls?state=closed&limit={FORGEJO_PAGE_LIMIT}"
                    f"&page={page}&sort=recentupdate&type=pulls",
                ],
                timeout=45.0,
            )
            if code != 0:
                break
            try:
                prs = parse_json(out)
            except Exception:
                break
            if not isinstance(prs, list):
                break
            any_ok = True
            oldest = None
            for pr in prs:
                if not isinstance(pr, dict):
                    continue
                upd = parse_merge_ts(pr.get("updated_at"))
                if upd is not None:
                    oldest = upd if oldest is None else min(oldest, upd)
                if not pr.get("merged"):
                    continue
                ts = parse_merge_ts(pr.get("merged_at") or pr.get("mergedAt"))
                if ts is None or ts < cutoff:
                    continue
                times.append(ts)
            if len(prs) < FORGEJO_PAGE_LIMIT or (oldest is not None and oldest < cutoff):
                break
    if not any_ok:
        return None
    return times


def resolve_ships(
    factory: Optional[dict[str, Any]],
    use_completed_hour: bool,
    now: Optional[float] = None,
    runner=None,
) -> ShipRead:
    """Dashboard merge-derived first, then lastgit, then Forgejo. Never board cards."""
    dash = ships_from_dashboard(factory, use_completed_hour)
    if dash is not None and dash.available:
        return dash
    direct = _resolve_ships_direct(use_completed_hour, now=now, runner=runner)
    if direct.source == "unavailable" and dash is not None:
        return dash
    return direct


def _resolve_ships_direct(
    use_completed_hour: bool,
    now: Optional[float] = None,
    runner=None,
) -> ShipRead:
    """lastgit, then Forgejo. Used when the dashboard is absent or unavailable."""
    lg = lastgit_merged_times(since_h=26.0, runner=runner)
    if lg:
        return ships_from_merge_times(
            lg, now=now, use_completed_hour=use_completed_hour, source="lastgit"
        )
    fg = forgejo_merged_times(since_h=26.0, runner=runner, now=now)
    if fg:
        return ships_from_merge_times(
            fg, now=now, use_completed_hour=use_completed_hour, source="forgejo"
        )
    # lastgit returned [] and forgejo failed, or both failed.
    if lg is None and fg is None:
        return ShipRead.missing("unavailable")
    # A successful empty lastgit with a failed forgejo is not a measured zero
    # after the 2026-09-06 venue flip (LastGit repos are disabled).
    if lg is not None and len(lg) == 0 and fg is None:
        return ShipRead.missing("unavailable")
    if fg is not None and len(fg) == 0:
        return ships_from_merge_times(
            fg, now=now, use_completed_hour=use_completed_hour, source="forgejo"
        )
    if lg is not None:
        return ships_from_merge_times(
            lg, now=now, use_completed_hour=use_completed_hour, source="lastgit"
        )
    return ShipRead.missing("unavailable")


def factory_status_label(fetch: FactoryFetch) -> str:
    if fetch.kind == "ok":
        return "up"
    if fetch.kind == "timeout":
        return "timeout"
    if fetch.kind == "refused":
        return "refused"
    return "down"


def fmt_ships(value: Optional[float]) -> str:
    if value is None:
        return "unavailable"
    return f"{value:.0f}"


def list_cards(board_cli: str) -> list[dict[str, Any]]:
    # Prefer --all; fall back.
    for args in (
        [board_cli, "list", "--json", "--all"],
        [board_cli, "list", "--json"],
    ):
        code, out, err = run(args, timeout=120)
        if code != 0:
            continue
        try:
            data = parse_json(out)
        except Exception:
            continue
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            for k in ("cards", "items"):
                if isinstance(data.get(k), list):
                    return data[k]
    return []


def pickup_ready_count(board_cli: str) -> Optional[int]:
    """Read the supported pickup-ready count. Return None on any bad read."""
    code, out, _ = run([board_cli, "pickup", "status", "--json"], timeout=120)
    if code != 0:
        return None
    try:
        value = parse_json(out).get("ready")
    except Exception:
        return None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value < 0 or int(value) != value:
        return None
    return int(value)


def fetch_gap_report(board_cli: str) -> tuple[Optional[dict[str, Any]], str]:
    """Read `milestone gap-report --json` once. Return (data, error)."""
    code, out, err = run(
        [board_cli, "milestone", "gap-report", "--json"], timeout=120
    )
    if code != 0:
        return None, (err or out or f"exit {code}").strip()[:160]
    try:
        data = parse_json(out)
    except Exception:
        return None, "malformed gap-report"
    if not isinstance(data, dict):
        return None, "malformed gap-report"
    return data, ""


def safe_milestone_frontier(board_cli: str) -> tuple[Optional[bool], str]:
    """Report whether gap-report exposes work that the driver can safely add."""
    data, error = fetch_gap_report(board_cli)
    return frontier_from_gap_report(data, error)


def frontier_from_gap_report(
    data: Optional[dict[str, Any]], error: str = ""
) -> tuple[Optional[bool], str]:
    if data is None:
        return None, error or "malformed gap-report"
    queue = data.get("work_queue") if isinstance(data, dict) else None
    if not isinstance(queue, list):
        return None, "gap-report has no work_queue"
    safe = [
        str(item.get("slug") or item.get("milestone") or "?")
        for item in queue
        if isinstance(item, dict)
        and str(item.get("action") or "") in {"promote", "decompose"}
    ]
    if safe:
        return True, ",".join(safe[:5])
    return False, "no promote or decompose action"


# ── Supply: runnable cards per admitted North Star ─────────────────────────
# On 2026-09-26 the Primary North Star had zero runnable cards for hours. Every
# routine said "healthy" and this check only said todo_runway_hard, which names
# a symptom and no cause. The supply signal counts runnable work per ADMITTED
# North Star and, when one has none, names each open milestone and why it
# cannot produce a card. Reads: one Brain point get, one gap-report, capped
# todo/doing lists, and bounded `kanban show` for blocked backlog cards of a
# jammed North Star only. Never a Brain list or search.

ADMISSION_SLUG = "preference-feature-delivery-portfolio-admission"
ADMISSION_FIELDS = ("primary", "secondary", "backfill")
TERMINAL_MILESTONE_STATUSES = {"complete", "abandoned"}
ACTIVE_MILESTONE_STATUSES = {"in_flight", "idle_promoteable"}
DECOMPOSABLE_MILESTONE_STATUSES = {"needs_next_slice", "idle_empty"}
EMPTY_ADMISSION_VALUES = {"", "-", "none", "null", "n/a", "tbd"}
SUPPLY_LIST_LIMIT = 200


def supply_state_dir() -> Path:
    env = os.environ.get("FACTORY_HEALTH_SUPPLY_STATE_DIR")
    if env:
        return Path(env)
    return Path.home() / ".local" / "state" / "last-stack" / "factory-health"


def parse_admission(body: str) -> dict[str, Optional[str]]:
    """Read Primary/Secondary/Backfill from the admission record body.

    The first line for each key wins. `Backfill:` is optional; an absent line or
    a placeholder value (none, -, tbd) reads as None.
    """
    admitted: dict[str, Optional[str]] = {k: None for k in ADMISSION_FIELDS}
    for raw in (body or "").splitlines():
        m = re.match(r"^\s*[-*]?\s*(Primary|Secondary|Backfill)\s*:\s*(.*)$", raw, re.I)
        if not m:
            continue
        key = m.group(1).lower()
        if admitted[key] is not None:
            continue
        value = m.group(2).strip().strip("`*").strip()
        value = re.split(r"[\s,;]", value, maxsplit=1)[0].strip("`*.")
        if value.lower() in EMPTY_ADMISSION_VALUES:
            continue
        admitted[key] = value
    return admitted


def read_admission(brain_cli: str, slug: str) -> tuple[Optional[dict[str, Optional[str]]], str]:
    """One exact Brain point get of the admission record."""
    code, out, err = run(
        [brain_cli, "get", slug, "--type", "preference", "--json"], timeout=60
    )
    if code != 0:
        return None, (err or out or f"exit {code}").strip()[:160]
    try:
        data = parse_json(out)
    except Exception:
        return None, "malformed admission record"
    body = data.get("body") if isinstance(data, dict) else None
    if not isinstance(body, str):
        return None, "admission record has no body"
    admitted = parse_admission(body)
    if not admitted.get("primary") and not admitted.get("secondary"):
        return None, "admission record names no Primary or Secondary"
    return admitted, ""


def list_column(board_cli: str, column: str) -> tuple[Optional[list[dict[str, Any]]], bool]:
    """Capped read of one column. Return (cards or None on failure, truncated)."""
    code, out, _ = run(
        [board_cli, "list", "--column", column, "--json", "--limit", str(SUPPLY_LIST_LIMIT)],
        timeout=120,
    )
    if code != 0:
        return None, False
    try:
        data = parse_json(out)
    except Exception:
        return None, False
    if isinstance(data, list):
        return data, False
    if isinstance(data, dict) and isinstance(data.get("cards"), list):
        return data["cards"], bool(data.get("truncated"))
    return None, False


def show_card(board_cli: str, slug: str) -> Optional[dict[str, Any]]:
    code, out, _ = run([board_cli, "show", slug, "--json"], timeout=60)
    if code != 0:
        return None
    try:
        data = parse_json(out)
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def admitted_list(admitted: dict[str, Optional[str]]) -> list[str]:
    out: list[str] = []
    for key in ADMISSION_FIELDS:
        ns = admitted.get(key)
        if ns and ns not in out:
            out.append(ns)
    return out


def milestone_reason(
    ms: dict[str, Any],
    card_lookup: Any,
    budget: list[int],
) -> str:
    """Name why one open milestone produces no runnable card."""
    status = str(ms.get("status") or "?")
    parts = [str(ms.get("reason") or "").strip() or "no reason given"]
    state = str(ms.get("state") or "")
    if state and state not in {"active", status}:
        parts.append(f"state={state}")
    blocked = [str(s) for s in (ms.get("blocked_backlog") or []) if s]
    if blocked:
        named: list[str] = []
        for slug in blocked:
            why = ""
            if budget[0] > 0 and card_lookup is not None:
                budget[0] -= 1
                card = card_lookup(slug)
                if card is None:
                    why = "unreadable"
                else:
                    why = str(card.get("block_reason") or "").strip()
                    status_b = str(card.get("block_status") or "").strip()
                    deps = card.get("blockedBy") or card.get("missingDeps") or []
                    if not why and deps:
                        why = "dep-blocked by " + ",".join(str(d) for d in deps[:3])
                    if status_b:
                        why = f"{status_b}: {why}" if why else status_b
            named.append(f"{slug} ({why or 'no block_reason'})")
        parts.append("blocked backlog: " + "; ".join(named))
    if status == "proof_pending":
        if ms.get("has_proof_card"):
            parts.append("proof card FAIL (proof_passing=false)")
        else:
            parts.append("no proof card")
    return " | ".join(p for p in parts if p)


def compute_supply(
    admitted: dict[str, Optional[str]],
    gap_report: dict[str, Any],
    todo_cards: list[dict[str, Any]],
    doing_cards: list[dict[str, Any]],
    card_lookup: Any = None,
    max_lookups: int = 12,
) -> dict[str, Any]:
    """Pure supply computation over already-read inputs (fixture-testable)."""
    milestones = [m for m in (gap_report.get("milestones") or []) if isinstance(m, dict)]
    ms_ns = {str(m.get("slug")): str(m.get("north_star") or "") for m in milestones}
    ns_list = admitted_list(admitted)
    runnable: dict[str, dict[str, int]] = {
        ns: {"cards": 0, "active_milestones": 0, "decomposable_milestones": 0}
        for ns in ns_list
    }
    for card in list(todo_cards) + list(doing_cards):
        if str(card.get("kind") or "").lower() != "pr":
            continue
        ns = str(card.get("north_star") or "") or ms_ns.get(str(card.get("milestone") or ""), "")
        if ns in runnable:
            runnable[ns]["cards"] += 1
    for m in milestones:
        ns = str(m.get("north_star") or "")
        if ns not in runnable:
            continue
        status = str(m.get("status") or "")
        if status in ACTIVE_MILESTONE_STATUSES:
            runnable[ns]["active_milestones"] += 1
        elif status in DECOMPOSABLE_MILESTONE_STATUSES:
            runnable[ns]["decomposable_milestones"] += 1
    jammed: list[dict[str, Any]] = []
    budget = [max(0, int(max_lookups))]
    for ns in ns_list:
        row = runnable[ns]
        if row["cards"] > 0 or row["active_milestones"] > 0:
            continue
        named = []
        for m in milestones:
            if str(m.get("north_star") or "") != ns:
                continue
            status = str(m.get("status") or "")
            if status in TERMINAL_MILESTONE_STATUSES:
                continue
            named.append(
                {
                    "slug": str(m.get("slug") or "?"),
                    "status": status or "?",
                    "reason": milestone_reason(m, card_lookup, budget),
                }
            )
        jammed.append({"ns": ns, "milestones": named})
    return {
        "admitted": {k: admitted.get(k) for k in ADMISSION_FIELDS},
        "runnable_by_ns": runnable,
        "jammed": jammed,
    }


def advance_jam_streaks(
    previous: dict[str, Any], jammed_ns: list[str]
) -> tuple[dict[str, int], int]:
    """Per-North-Star consecutive jam counts. A clear pass resets that NS."""
    prev = previous.get("jam_streaks") if isinstance(previous, dict) else None
    prev = prev if isinstance(prev, dict) else {}
    streaks: dict[str, int] = {}
    for ns in jammed_ns:
        try:
            streaks[ns] = int(prev.get(ns) or 0) + 1
        except (TypeError, ValueError):
            streaks[ns] = 1
    return streaks, max(streaks.values(), default=0)


def format_runnable(supply: Optional[dict[str, Any]]) -> str:
    """Heartbeat token: <ns>:<cards>/<active_ms>/<decomposable_ms>,..."""
    if not supply:
        return "unavailable"
    rows = supply.get("runnable_by_ns") or {}
    if not rows:
        return "none"
    return ",".join(
        f"{ns}:{r['cards']}/{r['active_milestones']}/{r['decomposable_milestones']}"
        for ns, r in rows.items()
    )


def format_jammed(supply: Optional[dict[str, Any]]) -> str:
    if not supply:
        return "unknown"
    names = [j["ns"] for j in supply.get("jammed") or []]
    return ",".join(names) if names else "none"


def jam_detail(supply: dict[str, Any]) -> str:
    lines: list[str] = []
    for jam in supply.get("jammed") or []:
        lines.append(f"{jam['ns']}: 0 runnable cards, 0 in_flight/idle_promoteable milestones")
        if not jam["milestones"]:
            lines.append("  - no open milestone (the North Star driver must add one)")
        for m in jam["milestones"]:
            lines.append(f"  - {m['slug']} [{m['status']}] {m['reason']}")
    return "\n  ".join(lines)


def collect_supply(
    cfg: dict[str, Any],
    board_cli: str,
    brain_cli: str,
    gap_report: Optional[dict[str, Any]],
    gap_error: str,
) -> tuple[Optional[dict[str, Any]], str]:
    """Read the inputs and compute supply. Return (supply or None, error)."""
    slug = str(cfg_get(cfg, "supply", "admission_slug", ADMISSION_SLUG))
    admitted, error = read_admission(brain_cli, slug)
    if admitted is None:
        return None, f"admission: {error}"
    if gap_report is None:
        return None, f"gap-report: {gap_error or 'unavailable'}"
    todo, todo_trunc = list_column(board_cli, "todo")
    doing, doing_trunc = list_column(board_cli, "doing")
    if todo is None or doing is None:
        return None, "board: todo/doing list unreadable"
    supply = compute_supply(
        admitted,
        gap_report,
        todo,
        doing,
        card_lookup=lambda s: show_card(board_cli, s),
        max_lookups=int(cfg_get(cfg, "supply", "max_block_lookups", 12)),
    )
    supply["lists_truncated"] = bool(todo_trunc or doing_trunc)
    return supply, ""


def evaluate_supply(
    cfg: dict[str, Any],
    supply: Optional[dict[str, Any]],
    supply_error: str,
    consecutive: int,
) -> list[Alert]:
    """Jam alerts. Any jam keeps the verdict off `ok`; only a sustained jam pages."""
    if not cfg_get(cfg, "supply", "enabled", True):
        return []
    if supply is None:
        return [
            Alert(
                severity="soft",
                code="supply_unreadable",
                title="Supply per admitted North Star unreadable",
                detail=supply_error or "unavailable",
                notify=False,
            )
        ]
    if not supply.get("jammed"):
        return []
    alarm_after = int(cfg_get(cfg, "supply", "alarm_after_passes", 2))
    names = format_jammed(supply)
    recs = [
        "Unblock or re-scope a named milestone, or let the North Star driver add a milestone.",
        "Backfill: admit a paused North Star with idle milestones (preference-feature-delivery-portfolio-admission).",
    ]
    if consecutive >= alarm_after:
        return [
            Alert(
                severity="hard",
                code="supply_jam_sustained",
                title=f"Admitted North Star jammed for {consecutive} passes: {names}",
                detail=jam_detail(supply),
                recommendations=recs,
            )
        ]
    return [
        Alert(
            severity="soft",
            code="supply_jam",
            title=f"Admitted North Star jammed (pass {consecutive}/{alarm_after}): {names}",
            detail=jam_detail(supply),
            recommendations=recs,
            notify=False,
        )
    ]


def write_supply_files(
    sdir: Path,
    supply: Optional[dict[str, Any]],
    streaks: dict[str, int],
    consecutive: int,
    ts: str,
) -> None:
    sdir.mkdir(parents=True, exist_ok=True)
    if supply is not None:
        (sdir / "supply-state.json").write_text(
            json.dumps(
                {
                    "ts": ts,
                    "jammed": [j["ns"] for j in supply.get("jammed") or []],
                    "jam_streaks": streaks,
                },
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
    latest = supply_latest_payload(supply, consecutive, ts)
    tmp = sdir / "supply-latest.json.tmp"
    tmp.write_text(json.dumps(latest, indent=2) + "\n", encoding="utf-8")
    tmp.replace(sdir / "supply-latest.json")


def supply_latest_payload(
    supply: Optional[dict[str, Any]], consecutive: int, ts: str
) -> dict[str, Any]:
    if supply is None:
        return {
            "ts": ts,
            "available": False,
            "admitted": None,
            "runnable_by_ns": None,
            "jammed": None,
            "consecutive_jam_passes": consecutive,
        }
    return {
        "ts": ts,
        "available": True,
        "admitted": supply["admitted"],
        "runnable_by_ns": supply["runnable_by_ns"],
        "jammed": supply["jammed"],
        "consecutive_jam_passes": consecutive,
        "lists_truncated": bool(supply.get("lists_truncated")),
    }


def age_hours(card: dict[str, Any], now: float) -> float:
    """How long this card has been working, in hours.

    `first_doing_at` FIRST, and the order is the whole point of the function.

    `position` is fkanban's column-enter stamp. It is rewritten on every
    `todo -> doing` move, so it measures time since the LAST claim, not time
    since work started. On a card that is genuinely stuck those are the same
    number only until something re-dispatches it — and re-dispatch is what the
    pipeline does to stuck cards. The clock is reset by the loop it is supposed
    to measure.

    Measured 2026-09-22: `lastdb-streaming-file-blob-put` fenced 4 ready cards
    and 6 pickup workers via surface-overlap, unresolved since 2026-09-17. This
    function returned 8.17h at 05:17Z, 0.54h at 06:17Z, 6.53h at 12:17Z and
    0.16h at 13:17Z. `hard_max_age_h` is 5.0, so the band was crossed and
    cleared twice in one day and no streak ever formed. Five days of total
    pipeline starvation, never alerted. Brain
    `papercut-kanban-doing-age-clock-resets-on-re-dispatch`.

    `first_doing_at` (kanban PR 20) is the monotone stamp: set on first entry
    into `doing`, preserved across a re-dispatch to `todo`, cleared only when
    the card leaves the work loop. Prefer it whenever the board supplies it.

    `position` stays as the fallback so this keeps working against a board
    written by an older kanban, and against cards stamped before PR 20 landed.
    A legacy card reads `first_doing_at: ""` and falls through unchanged.
    """
    first_doing = str(card.get("first_doing_at") or "").strip()
    if first_doing:
        try:
            dt = datetime.fromisoformat(first_doing.replace("Z", "+00:00"))
            return max(0.0, (now - dt.timestamp()) / 3600.0)
        except Exception:
            pass

    pos = card.get("position")
    try:
        p = float(pos)
        if p > 1e12:
            return max(0.0, (now - p / 1000.0) / 3600.0)
        if p > 1e9:
            return max(0.0, (now - p) / 3600.0)
    except Exception:
        pass
    for key in ("updated_at", "created_at"):
        raw = card.get(key) or ""
        if not raw:
            continue
        try:
            dt = datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
            return max(0.0, (now - dt.timestamp()) / 3600.0)
        except Exception:
            continue
    return 0.0


def dep_blocked(card: dict[str, Any]) -> bool:
    """Is this card actually waiting on an unfinished dependency?

    `deps` lists every dependency the card ever declared, satisfied or not, so
    it answers "does it have deps", not "is it waiting". `missingDeps` and
    `blocked` are fkanban's derived truth. Falls back to the raw list only when
    neither derived field is present (older CLI), where over-reporting a wait is
    the safer error for a band that is otherwise silent.
    """
    if "missingDeps" in card or "blocked" in card:
        return bool(card.get("missingDeps")) or card.get("blocked") is True
    return bool(card.get("deps"))


def unreachable_backlog_cards(
    cards: list[dict[str, Any]], now: float, min_age_h: float
) -> list[tuple[str, float]]:
    """Backlog cards that claim to be runnable work but can never be claimed.

    fkanban refuses a Kind:pr card into default/todo without a milestone
    (`live_pr_milestone_required`). A card that is ALSO ungated and
    dependency-free is therefore not parked for any stated reason — it is
    simply unreachable, and no other band here notices: ship rate stays
    plausible, todo depth reads as merely thin, and the work is invisible.

    Kept deliberately narrow so it cannot fire on the legitimate park:
      - kind pr (empty normalizes to pr, matching fkanban's normalizeKind)
      - block_status none  → nobody held it on purpose
      - not dep-blocked    → the dep guard already voices a real wait
      - no milestone       → the condition that actually strands it

    "Not dep-blocked" reads `missingDeps`/`blocked`, NOT the raw `deps` list. A
    card whose dependencies are all satisfied still carries them in `deps`, and
    three of the 19 stranded cards on 2026-08-08 looked like dependency waits
    under the coarse reading while `missingDeps` was empty and `blocked` false.
    Treating a satisfied dep as an excuse would have hidden them.

    Body-brief emptiness is NOT checked: `kanban list` returns truncated body
    previews, and judging a brief from a preview would make this a lying
    instrument about the one thing it exists to report honestly.

    Returns (slug, age_hours) for each, oldest first.
    """
    KINDS = {"pr", "registry", "tracker", "umbrella", "meta", "program", "capstone", "validation"}
    out: list[tuple[str, float]] = []
    for c in cards:
        if str(c.get("column") or "").lower() != "backlog":
            continue
        kind = str(c.get("kind") or "").strip().lower()
        if kind not in KINDS:
            kind = "pr"  # fkanban normalizeKind: empty/unknown → pr
        if kind != "pr":
            continue
        block = str(c.get("block_status") or c.get("blockStatus") or "").strip().lower()
        if block and block != "none":
            continue
        if dep_blocked(c):
            continue
        if str(c.get("milestone") or "").strip():
            continue
        age = age_hours(c, now)
        if age < min_age_h:
            continue
        out.append((str(c.get("slug") or "?"), age))
    out.sort(key=lambda t: -t[1])
    return out


def mean_std(xs: list[float]) -> tuple[float, float]:
    if not xs:
        return 0.0, 0.0
    if len(xs) == 1:
        return float(xs[0]), 0.0
    m = statistics.fmean(xs)
    s = statistics.pstdev(xs)
    return float(m), float(s)


def local_hour(cfg: dict[str, Any]) -> int:
    tz_name = cfg_get(cfg, "general", "timezone", "") or ""
    if tz_name and ZoneInfo is not None:
        try:
            return datetime.now(ZoneInfo(tz_name)).hour
        except Exception:
            pass
    return datetime.now().astimezone().hour


def in_quiet_hours(cfg: dict[str, Any]) -> bool:
    q = cfg_get(cfg, "notify", "quiet_hours", [0, 8])
    if not isinstance(q, list) or len(q) < 2:
        return False
    start, end = int(q[0]), int(q[1])
    h = local_hour(cfg)
    if start == end:
        return False
    if start < end:
        return start <= h < end
    # wraps midnight
    return h >= start or h < end


def diagnose_ship(alerts_context: dict[str, Any]) -> list[str]:
    recs: list[str] = []
    doing = alerts_context.get("doing", 0)
    todo = alerts_context.get("todo", 0)
    stale = alerts_context.get("stale_doing", 0)
    max_age = alerts_context.get("max_doing_age_h", 0)
    profile = alerts_context.get("routines_profile", "")
    install_behind = alerts_context.get("install_behind", False)
    install_stale_hb = int(alerts_context.get("install_stale_heartbeats", 0) or 0)
    if install_behind or install_stale_hb:
        recs.append(
            "Run zero-LLM Class A heal: `last-stack-class-a-heal --reason=manual` "
            "(or wait for factory-health auto_fix)."
        )
        recs.append(
            "Last Stack install freshness gate is failing — run "
            "`$LAST_STACK_ROOT/bin/last-stack-self-upgrade` and "
            "`last-stack-update-check` (expect UP_TO_DATE)."
        )
        recs.append(
            "Confirm launchd healer: `last-stack-self-upgrade-install status` "
            "(com.edgevector.last-stack-self-upgrade)."
        )
        recs.append(
            "If fetch keeps failing while ls-remote works: inspect LastGit/LastDB "
            "socket and recent self-upgrade stderr (fetch is no longer silent)."
        )
    if stale or max_age >= 2:
        recs.append(
            "Run `last-stack-board-closeout-sweep` — merged PR cards may be stuck in doing "
            "(especially if low-credit paused kanban-watch)."
        )
        recs.append("Check LaunchAgent: `last-stack-board-closeout-install status`.")
    if todo == 0 and doing == 0:
        recs.append("Queue empty — check program-driver / groom-board / backlog promotions.")
    elif todo > 0 and doing == 0 and not (install_behind or install_stale_hb):
        recs.append(
            "Todo backlog with empty doing — pickup may be paused, locked, or failing; "
            "`routines status` + recent kanban-pickup heartbeats."
        )
    elif todo > 0 and doing > 0 and stale:
        recs.append(
            "Work is claimed but not finishing — look at CI/merge babysit and surface-overlap ghosts."
        )
    if profile == "low-credit":
        recs.append(
            "Active profile is low-credit (watch/groom paused). Ship-only is expected to be thinner; "
            "ensure board-closeout LaunchAgent is loaded, or `routines-profile apply normal` when flush."
        )
    if not recs:
        recs.append("Inspect factory http://127.0.0.1:4177 and last hour of routine-heartbeats for pickup/watch.")
    return recs


def update_check_status(last_stack: Path) -> str:
    """Return raw last-stack-update-check stdout (first line) or empty."""
    bin_path = last_stack / "bin" / "last-stack-update-check"
    if not bin_path.exists():
        return ""
    code, out, _ = run([str(bin_path)], timeout=45)
    if code != 0 and not out.strip():
        return ""
    line = (out or "").strip().splitlines()
    return line[0] if line else ""


def install_is_behind(status: str) -> bool:
    s = (status or "").strip()
    return s.startswith("GIT_UPDATE_AVAILABLE") or s.startswith("UPGRADE_AVAILABLE")


def count_trailing_stale_install_heartbeats(scan_lines: int = 200) -> int:
    """Count consecutive newest-to-oldest pickup heartbeats that are install-stale noops.

    Scans ~/.last-stack/logs/routine-heartbeats.log (and ~/.routines fallback).
    """
    candidates = [
        Path.home() / ".last-stack" / "logs" / "routine-heartbeats.log",
        Path.home() / ".routines" / "routine-heartbeats.log",
        Path.home() / ".routines" / "heartbeats.log",
    ]
    path = next((p for p in candidates if p.is_file()), None)
    if not path:
        return 0
    try:
        # Read last scan_lines efficiently
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            chunk = min(size, max(scan_lines, 50) * 200)
            f.seek(max(0, size - chunk))
            text = f.read().decode("utf-8", errors="replace")
    except Exception:
        return 0
    lines = [ln for ln in text.splitlines() if ln.strip()]
    # Walk from newest: only count pickup-related lines; stop on first
    # non-stale pickup success/other outcome after we started counting.
    stale_re = re.compile(
        r"(kanban-pickup|fkanban-pickup|last-stack-fkanban-pickup).*"
        r"(stale-last-stack-install|stale-last-stack-artifact|"
        r"routine-read-failed|class-a-heal-failed|refresh-failed)",
        re.I,
    )
    healed_re = re.compile(
        r"(kanban-pickup|fkanban-pickup|last-stack-fkanban-pickup).*"
        r"(healed-before-claim|refreshed-before-claim|upgraded-before-claim)",
        re.I,
    )
    pickup_re = re.compile(r"(kanban-pickup|fkanban-pickup|last-stack-fkanban-pickup)", re.I)
    count = 0
    for ln in reversed(lines[-scan_lines:]):
        if not pickup_re.search(ln):
            continue
        # A successful Class A heal ends the freeze streak (next fire should claim).
        if healed_re.search(ln):
            if count > 0:
                break
            continue
        if stale_re.search(ln) or (
            "stale-last-stack-install" in ln and "routine-read-failed" in ln
        ):
            count += 1
            continue
        # A newer non-stale pickup line ends the trailing streak.
        if count > 0:
            break
        # Haven't started streak; keep scanning older lines.
    return count


def build_snapshot(
    cards: list[dict[str, Any]],
    factory: Optional[dict[str, Any]],
    use_completed_hour: bool,
    parked_min_age_h: float = 3.0,
    ship_read: Optional[ShipRead] = None,
) -> tuple[Snapshot, dict[str, Any]]:
    now = time.time()
    cols = {"backlog": 0, "todo": 0, "doing": 0, "done": 0, "review": 0}
    max_age = 0.0
    stale = 0
    with_pr = 0
    soft_age = 2.0  # default; caller may recompute stale with config
    doing_cards: list[dict[str, Any]] = []

    for c in cards:
        col = str(c.get("column") or "").lower()
        if col in cols:
            cols[col] += 1
        if col == "doing":
            doing_cards.append(c)
            age = age_hours(c, now)
            max_age = max(max_age, age)
            if age >= soft_age:
                stale += 1
            if c.get("pr_url") or c.get("prUrl") or c.get("pr"):
                with_pr += 1

    hourly: list[dict[str, Any]] = []
    velocity: dict[str, Any] = {}
    if factory and isinstance(factory.get("velocity"), dict):
        velocity = factory["velocity"]
        hourly = list(velocity.get("hourly") or [])

    ship = ship_read or resolve_ships(factory, use_completed_hour, now=now)
    ships_last_h = ship.last_h
    ships_24h = ship.h24
    ships_per_hour_24h = ship.per_hour_24h
    if ship.hourly:
        hourly = ship.hourly

    # Prefer factory summary counts when present
    if factory and isinstance(factory.get("summary"), dict):
        sc = factory["summary"].get("counts") or {}
        for k in ("backlog", "todo", "doing", "done"):
            if k in sc:
                cols[k] = int(sc[k])

    # Derived from the raw card rows, never from the factory summary — the
    # summary carries column COUNTS only, and this needs per-card kind /
    # block_status / deps / milestone. If the board read came back empty this
    # stays 0 rather than guessing, same as every other card-derived field.
    parked = unreachable_backlog_cards(cards, now, parked_min_age_h)

    snap = Snapshot(
        ts=iso_z(),
        todo=cols["todo"],
        doing=cols["doing"],
        backlog=cols["backlog"],
        done=cols["done"],
        ships_last_h=ships_last_h,
        ships_24h=ships_24h,
        ships_per_hour_24h=ships_per_hour_24h,
        ships_available=ship.available,
        ships_source=ship.source,
        max_doing_age_h=round(max_age, 2),
        stale_doing=stale,
        doing_with_pr=with_pr,
        parked_ungated=len(parked),
        parked_ungated_oldest_h=round(parked[0][1], 2) if parked else 0.0,
        parked_ungated_slugs=[slug for slug, _ in parked[:5]],
    )
    meta = {
        "hourly": hourly,
        "velocity": velocity,
        "doing_cards": doing_cards,
        "factory_ok": factory is not None and factory.get("ok", True) is not False,
        "ships_source": ship.source,
        "ships_available": ship.available,
        "routines_profile": "",
    }
    if factory and isinstance(factory.get("routinesProfile"), dict):
        meta["routines_profile"] = str(
            factory["routinesProfile"].get("active")
            or factory["routinesProfile"].get("name")
            or ""
        )
    # ACTIVE profile file
    active = Path.home() / ".routines" / "profiles" / "ACTIVE"
    if active.exists():
        try:
            meta["routines_profile"] = active.read_text(encoding="utf-8").strip() or meta["routines_profile"]
        except Exception:
            pass
    return snap, meta


def is_deploy_parked(card: dict[str, Any]) -> bool:
    """Doing cards waiting on a deploy/live-proof gate are not factory stuck.

    Closeout demotes these to backlog with deferred, but a pickup fire can
    still leave one in doing until the next sweep. Counting them toward
    doing_stuck / closeout_stale pages Tom about work that is correctly parked.
    """
    tags = card.get("tags") or []
    parked = {
        "awaiting-deploy",
        "live-proof",
        "deploy-gate",
        "needs-safe-upgrade",
        "awaiting-validation",
    }
    for t in tags:
        if str(t).strip().lower() in parked:
            return True
    body = str(card.get("body") or "")
    if re.search(r"(?im)^requires-deploy\s*:", body):
        return True
    if re.search(r"\b(LIVE PROOF|deploy-pipeline proof|awaiting deploy)\b", body, re.I) and re.search(
        r"\b(pending|do not mark done|returning the card|leave(?:ing)? this card)\b",
        body,
        re.I,
    ):
        return True
    section_lines = []
    in_end = False
    for line in body.splitlines():
        if re.match(r"^##[ \t]+", line):
            in_end = bool(re.match(r"^##[ \t]+END[ \t]+STATE\b", line, re.I))
        if in_end:
            section_lines.append(line)
        if re.match(r"^\s*DONE-WHEN\s*:", line, re.I):
            section_lines.append(line)
    section = "\n".join(section_lines)
    if re.search(
        r"(?i)\b(helper[ -]?cutover|host-track|live\s+scheduled[- ]fire|"
        r"installed\s+(?:helper|binary|cli)|safe-upgrade|awaiting-deploy)\b",
        section,
    ):
        return True
    return False


def actionable_doing(doing_cards: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [c for c in doing_cards if not is_deploy_parked(c)]


def recompute_stale(doing_cards: list[dict[str, Any]], soft_age: float) -> tuple[float, int]:
    now = time.time()
    max_age = 0.0
    stale = 0
    for c in doing_cards:
        age = age_hours(c, now)
        max_age = max(max_age, age)
        if age >= soft_age:
            stale += 1
    return round(max_age, 2), stale


def evaluate(cfg: dict[str, Any], snap: Snapshot, meta: dict[str, Any], state: dict[str, Any]) -> list[Alert]:
    alerts: list[Alert] = []
    streaks: dict[str, Any] = state.setdefault("streaks", {})
    ctx = {
        "doing": snap.doing,
        "todo": snap.todo,
        "stale_doing": snap.stale_doing,
        "max_doing_age_h": snap.max_doing_age_h,
        "routines_profile": meta.get("routines_profile") or "",
    }

    # ── pickup-ready buffer ───────────────────────────────────────────────
    # The controller acts every 30 minutes below three ready cards. This band
    # reports a controller failure only after two hourly observations prove a
    # sustained zero while gap-report still exposes a safe generator action.
    if cfg_get(cfg, "ready_buffer", "enabled", True):
        zero_key = "ready_buffer_zero_since_epoch"
        ready = snap.pickup_ready
        frontier = meta.get("safe_milestone_frontier")
        now_epoch = float(meta.get("now_epoch") or time.time())
        wait_s = int(cfg_get(cfg, "ready_buffer", "zero_alert_after_s", 3600))
        if ready == 0 and frontier is True:
            try:
                since = float(streaks.get(zero_key) or now_epoch)
            except (TypeError, ValueError):
                since = now_epoch
            if since > now_epoch:
                since = now_epoch
            streaks[zero_key] = since
            elapsed = max(0, int(now_epoch - since))
            if elapsed >= wait_s:
                alerts.append(
                    Alert(
                        severity="hard",
                        code="ready_buffer_zero_sustained",
                        title="Pickup-ready buffer stayed empty",
                        detail=(
                            f"pickup_ready=0 for {elapsed}s; safe milestone frontier="
                            f"{meta.get('safe_milestone_frontier_detail') or 'present'}"
                        ),
                        recommendations=[
                            "Check com.edgevector.factory-ready-buffer and its logs.",
                            "Run `last-stack-factory-ready-buffer-install status`.",
                            "Run the controller once after the board read is healthy.",
                        ],
                    )
                )
        else:
            streaks.pop(zero_key, None)

    # ── ship rate ──────────────────────────────────────────────────────────
    if cfg_get(cfg, "ship_rate", "enabled", True) and snap.ships_available:
        hourly = meta.get("hourly") or []
        use_completed = bool(cfg_get(cfg, "general", "use_completed_hour", True))
        series: list[float] = []
        # Baseline: hourAgo 1..window (completed hours only)
        window = int(cfg_get(cfg, "ship_rate", "window_hours", 24))
        by_ago: dict[int, float] = {}
        for b in hourly:
            v = _opt_float(b.get("ships"))
            if v is None:
                continue
            by_ago[int(b.get("hourAgo", -1))] = v
        for ago in range(1 if use_completed else 0, window + 1):
            if ago in by_ago:
                series.append(by_ago[ago])
        last_raw = by_ago.get(1 if use_completed else 0, snap.ships_last_h)
        last = float(last_raw) if last_raw is not None else 0.0
        mean, std = mean_std(series[1:] if len(series) > 1 else series)  # exclude last hour from baseline when present
        # Prefer baseline without the evaluated hour
        if series:
            # series[0] is most recent completed if we built 1..N in order
            # Rebuild cleanly:
            base_vals = [by_ago[a] for a in range(2, window + 1) if a in by_ago]
            if not base_vals:
                base_vals = [by_ago[a] for a in range(1, window + 1) if a in by_ago and a != (1 if use_completed else 0)]
            mean, std = mean_std(base_vals)

        min_mean = float(cfg_get(cfg, "ship_rate", "min_baseline_mean", 1.0))
        soft_ratio = float(cfg_get(cfg, "ship_rate", "soft_ratio", 0.5))
        hard_ratio = float(cfg_get(cfg, "ship_rate", "hard_ratio", 0.25))
        z = float(cfg_get(cfg, "ship_rate", "z_score", 1.5))
        need_streak = int(cfg_get(cfg, "ship_rate", "consecutive_hours", 2))
        abs_floor = float(cfg_get(cfg, "ship_rate", "absolute_floor", 0))

        # Dual test: ratio AND z-score (when std meaningful)
        # Dual gate (AND) to cut false positives:
        #   ratio_fail: last < soft_ratio * mean
        #   z_fail:     last < mean − z·σ  (or true when σ≈0 so ratio alone applies)
        quiet = in_quiet_hours(cfg)
        suppress_relative = quiet or mean < min_mean

        if mean > 0:
            ratio_soft = last < soft_ratio * mean
            ratio_hard = last < hard_ratio * mean
            z_fail = std <= 1e-9 or last < (mean - z * std)
            below_soft = ratio_soft and z_fail
            below_hard = ratio_hard and z_fail
        else:
            below_soft = False
            below_hard = False

        if abs_floor > 0 and last >= abs_floor:
            below_soft = False
            below_hard = False

        key = "ship_rate_soft"
        if suppress_relative:
            streaks[key] = 0
            streaks["ship_rate_hard"] = 0
        else:
            if below_soft:
                streaks[key] = int(streaks.get(key) or 0) + 1
            else:
                streaks[key] = 0
            if below_hard:
                streaks["ship_rate_hard"] = int(streaks.get("ship_rate_hard") or 0) + 1
            else:
                streaks["ship_rate_hard"] = 0

            if int(streaks.get("ship_rate_hard") or 0) >= need_streak:
                alerts.append(
                    Alert(
                        severity="hard",
                        code="ship_rate_hard",
                        title="Ship rate collapsed",
                        detail=(
                            f"Last completed hour ships={last:.0f}; "
                            f"24h baseline mean={mean:.2f}/h std={std:.2f}; "
                            f"hard band <{hard_ratio:.0%} mean & z≥{z}; "
                            f"streak={streaks['ship_rate_hard']}/{need_streak}"
                        ),
                        recommendations=diagnose_ship(ctx),
                    )
                )
            elif int(streaks.get(key) or 0) >= need_streak:
                alerts.append(
                    Alert(
                        severity="soft",
                        code="ship_rate_soft",
                        title="Ship rate below band",
                        detail=(
                            f"Last completed hour ships={last:.0f}; "
                            f"24h baseline mean={mean:.2f}/h std={std:.2f}; "
                            f"soft requires <{soft_ratio:.0%} mean AND <mean−{z}σ; "
                            f"streak={streaks[key]}/{need_streak}"
                        ),
                        recommendations=diagnose_ship(ctx),
                    )
                )

    # ── doing ──────────────────────────────────────────────────────────────
    if cfg_get(cfg, "doing", "enabled", True):
        soft_age = float(cfg_get(cfg, "doing", "soft_max_age_h", 2.0))
        hard_age = float(cfg_get(cfg, "doing", "hard_max_age_h", 5.0))
        soft_stale_n = int(cfg_get(cfg, "doing", "soft_stale_count", 3))
        hard_stale_n = int(cfg_get(cfg, "doing", "hard_stale_count", 8))
        soft_count = int(cfg_get(cfg, "doing", "soft_count", 12))
        hard_count = int(cfg_get(cfg, "doing", "hard_count", 20))

        doing_for_stuck = actionable_doing(meta.get("doing_cards") or [])
        max_age, stale = recompute_stale(doing_for_stuck, soft_age)
        snap.max_doing_age_h = max_age
        snap.stale_doing = stale
        ctx["max_doing_age_h"] = max_age
        ctx["stale_doing"] = stale
        ctx["actionable_doing"] = len(doing_for_stuck)

        if max_age >= hard_age or stale >= hard_stale_n or len(doing_for_stuck) >= hard_count:
            oldest = ""
            if doing_for_stuck:
                now = time.time()
                best = max(doing_for_stuck, key=lambda c: age_hours(c, now))
                oldest = f" oldest={best.get('slug')} ({age_hours(best, now):.1f}h)"
            alerts.append(
                Alert(
                    severity="hard",
                    code="doing_stuck_hard",
                    title="Doing column critically stuck",
                    detail=(
                        f"doing={snap.doing} max_age={max_age:.1f}h stale(≥{soft_age}h)={stale}"
                        f"{oldest}"
                    ),
                    recommendations=[
                        "Run `last-stack-board-closeout-sweep` (merged → done; zombie → todo).",
                        "If low-credit: watch is paused — closeout LaunchAgent is the safety net.",
                        "Inspect open PRs that are not merged and live workers on worktrees.",
                    ]
                    + diagnose_ship(ctx),
                )
            )
        elif max_age >= soft_age or stale >= soft_stale_n or len(doing_for_stuck) >= soft_count:
            alerts.append(
                Alert(
                    severity="soft",
                    code="doing_stuck_soft",
                    title="Doing column elevated",
                    detail=f"doing={snap.doing} max_age={max_age:.1f}h stale(≥{soft_age}h)={stale}",
                    recommendations=[
                        "Dry-run: `last-stack-board-closeout-sweep --dry-run`",
                        "Check factory doing lane for multi-hour chips with merged PRs.",
                    ],
                )
            )

    # ── backlog black hole ─────────────────────────────────────────────────
    if cfg_get(cfg, "backlog", "enabled", True) and snap.parked_ungated:
        soft_b = int(cfg_get(cfg, "backlog", "soft_count", 1))
        hard_b = int(cfg_get(cfg, "backlog", "hard_count", 10))
        shown = ", ".join(snap.parked_ungated_slugs)
        more = snap.parked_ungated - len(snap.parked_ungated_slugs)
        if more > 0:
            shown += f", +{more} more"
        detail = (
            f"parked_ungated={snap.parked_ungated} oldest={snap.parked_ungated_oldest_h:.1f}h "
            f"— Kind:pr, no hold, no deps, NO MILESTONE, so `move … todo` refuses them "
            f"(live_pr_milestone_required) and pickup never sees them. [{shown}]"
        )
        recs = [
            "Confirm with `kanban pickup explain <slug>` — the write-guard names the missing field.",
            "Stamp a real outcome: `kanban set <slug> --milestone <ms>` then `kanban move <slug> todo`.",
            "If a card genuinely belongs in backlog, park it honestly "
            "(`--block-status needs_human/deferred` or a non-pr `--kind`) so the hold is visible.",
        ]
        if snap.parked_ungated >= hard_b:
            alerts.append(
                Alert(
                    severity="hard",
                    code="backlog_unreachable_hard",
                    title="Backlog is swallowing runnable work",
                    detail=detail + f" (hard≥{hard_b})",
                    recommendations=recs,
                )
            )
        elif snap.parked_ungated >= soft_b:
            alerts.append(
                Alert(
                    severity="soft",
                    code="backlog_unreachable_soft",
                    title="Runnable cards stranded in backlog",
                    detail=detail + f" (soft≥{soft_b})",
                    recommendations=recs,
                )
            )

    # ── todo ───────────────────────────────────────────────────────────────
    if cfg_get(cfg, "todo", "enabled", True):
        soft_t = int(cfg_get(cfg, "todo", "soft_count", 25))
        hard_t = int(cfg_get(cfg, "todo", "hard_count", 50))
        if snap.todo >= hard_t:
            alerts.append(
                Alert(
                    severity="hard",
                    code="todo_depth_hard",
                    title="Todo pile critically deep",
                    detail=f"todo={snap.todo} (hard≥{hard_t})",
                    recommendations=[
                        "Scale pickup workers or clear blockers (needs_human / deps).",
                        "Run groom-board / program-driver if backlog isn't promoting cleanly.",
                    ],
                )
            )
        elif snap.todo >= soft_t:
            alerts.append(
                Alert(
                    severity="soft",
                    code="todo_depth_soft",
                    title="Todo pile elevated",
                    detail=f"todo={snap.todo} (soft≥{soft_t})",
                    recommendations=["Check pickup capacity and blocked/human-gated cards."],
                )
            )
        min_rate = float(cfg_get(cfg, "ship_rate", "min_baseline_mean", 1.0))

        # Supply runway. Depth alone cannot say how long the queue lasts: nine
        # cards is eight hours at 1 ship/h and ninety minutes at 6, so no
        # constant count is correct for both. Divide the claimable supply by
        # the rate that is actually draining it.
        #
        # Prefer pickup_ready over todo. A todo card the lanes cannot claim is
        # not supply, and pickup_ready is the number the lanes really consume.
        if cfg_get(cfg, "todo", "runway_enabled", True):
            soft_h = float(cfg_get(cfg, "todo", "runway_soft_hours", 2.0))
            hard_h = float(cfg_get(cfg, "todo", "runway_hard_hours", 1.0))
            soft_streak = int(cfg_get(cfg, "todo", "runway_soft_streak", 2))
            hard_streak = int(cfg_get(cfg, "todo", "runway_hard_streak", 1))
            supply = snap.pickup_ready if snap.pickup_ready >= 0 else snap.todo
            supply_name = "ready" if snap.pickup_ready >= 0 else "todo"
            # The last completed hour tracks the drain happening now; the 24h
            # mean is the fallback when the hourly bucket is not populated yet.
            rate = snap.ships_last_h or snap.ships_per_hour_24h or 0.0
            # An idle factory has no runway problem, only an idle one, and
            # ship_rate_* already owns that. Stay quiet below the baseline.
            live = supply > 0 and rate >= min_rate
            runway_h = (supply / rate) if live and rate > 0 else None

            for key, bound, sev, need in (
                ("todo_runway_hard", hard_h, "hard", hard_streak),
                ("todo_runway_soft", soft_h, "soft", soft_streak),
            ):
                if runway_h is not None and runway_h < bound:
                    streaks[key] = int(streaks.get(key) or 0) + 1
                else:
                    streaks[key] = 0

            recs = [
                "Refill supply now: run last-stack-papercut-reconciler, "
                "last-stack-groom-board, or last-stack-milestone-driver.",
                "Backlog depth is not supply — check `kanban pickup status` "
                "for deferred holds whose condition is already met.",
                "A producer routine that bailed reports outcome=noop, so read "
                "its detail line, not just its outcome "
                "(papercut-routine-outcome-vocabulary-has-no-deferred-value).",
            ]
            if runway_h is not None and runway_h < hard_h and int(
                streaks.get("todo_runway_hard") or 0
            ) >= hard_streak:
                alerts.append(
                    Alert(
                        severity="hard",
                        code="todo_runway_hard",
                        title="Supply runs out within the hour",
                        detail=(
                            f"{supply_name}={supply:.0f} draining at {rate:.2f}/h "
                            f"→ runway≈{runway_h:.1f}h (hard<{hard_h:.1f}h)"
                        ),
                        recommendations=recs,
                    )
                )
            elif runway_h is not None and runway_h < soft_h and int(
                streaks.get("todo_runway_soft") or 0
            ) >= soft_streak:
                alerts.append(
                    Alert(
                        severity="soft",
                        code="todo_runway_soft",
                        title="Supply runway short",
                        detail=(
                            f"{supply_name}={supply:.0f} draining at {rate:.2f}/h "
                            f"→ runway≈{runway_h:.1f}h (soft<{soft_h:.1f}h); "
                            f"streak={streaks['todo_runway_soft']}/{soft_streak}"
                        ),
                        recommendations=recs,
                    )
                )

        # An empty queue is worth saying while the last cards are still in
        # flight. That is the only moment a refill can still keep the lanes
        # busy, so this no longer waits for doing to reach zero as well.
        if (
            cfg_get(cfg, "todo", "empty_todo_with_baseline", True)
            and snap.todo == 0
            and snap.ships_available
            and (snap.ships_per_hour_24h or 0) >= min_rate
        ):
            alerts.append(
                Alert(
                    severity="soft",
                    code="todo_starved",
                    title="Queue empty while factory was shipping",
                    detail=(
                        f"todo=0 doing={snap.doing} but 24h ship rate"
                        f"≈{snap.ships_per_hour_24h:.2f}/h — "
                        "may be fine if intentionally drained"
                    ),
                    recommendations=[
                        "If unexpected: promote next program slices / unstick backlog deps.",
                    ],
                )
            )

    # ── ship volume 24h vs history ─────────────────────────────────────────
    # An unavailable window is not a measured zero. Do not page on it.
    if (
        cfg_get(cfg, "ship_volume", "enabled", True)
        and snap.ships_available
        and snap.ships_24h is not None
    ):
        hist = state.get("history") or []
        min_pts = int(cfg_get(cfg, "ship_volume", "min_history_points", 6))
        soft_r = float(cfg_get(cfg, "ship_volume", "soft_ratio", 0.5))
        hard_r = float(cfg_get(cfg, "ship_volume", "hard_ratio", 0.25))
        past = [float(h.get("ships_24h") or 0) for h in hist[-48:] if h.get("ships_24h") is not None]
        if len(past) >= min_pts and not in_quiet_hours(cfg):
            m, s = mean_std(past)
            if m >= float(cfg_get(cfg, "ship_rate", "min_baseline_mean", 1.0)) * 8:  # rough daily floor
                if snap.ships_24h < hard_r * m:
                    alerts.append(
                        Alert(
                            severity="hard",
                            code="ship_volume_hard",
                            title="24h ship volume collapsed vs history",
                            detail=f"ships_24h={snap.ships_24h:.0f} history_mean={m:.1f} hard_ratio={hard_r}",
                            recommendations=diagnose_ship(ctx),
                        )
                    )
                elif snap.ships_24h < soft_r * m:
                    alerts.append(
                        Alert(
                            severity="soft",
                            code="ship_volume_soft",
                            title="24h ship volume soft vs history",
                            detail=f"ships_24h={snap.ships_24h:.0f} history_mean={m:.1f} soft_ratio={soft_r}",
                            recommendations=diagnose_ship(ctx),
                        )
                    )

    # ── closeout smell ─────────────────────────────────────────────────────
    if cfg_get(cfg, "closeout", "enabled", True):
        age_lim = float(cfg_get(cfg, "closeout", "merged_suspect_age_h", 1.5))
        suspects = []
        now = time.time()
        closeout_cards = actionable_doing(meta.get("doing_cards") or [])
        for c in closeout_cards:
            if not (c.get("pr_url") or c.get("prUrl") or c.get("pr")):
                continue
            age = age_hours(c, now)
            if age >= age_lim:
                suspects.append(f"{c.get('slug')}({age:.1f}h)")
        hard_age = float(cfg_get(cfg, "doing", "hard_max_age_h", 5.0))
        pr_ages = [
            age_hours(c, now)
            for c in closeout_cards
            if (c.get("pr_url") or c.get("prUrl") or c.get("pr"))
        ]
        max_pr_age = max(pr_ages) if pr_ages else 0.0
        if len(suspects) >= 1 and max_pr_age >= hard_age:
            alerts.append(
                Alert(
                    severity="hard",
                    code="closeout_stale_pr_card",
                    title="Aged doing card with PR (closeout lag)",
                    detail=f"max_pr_age={max_pr_age:.1f}h suspects={', '.join(suspects[:8])}",
                    recommendations=["Run board-closeout sweep; check watch paused under low-credit."],
                )
            )
        elif len(suspects) >= 3:
            alerts.append(
                Alert(
                    severity="soft",
                    code="closeout_backlog",
                    title="Many aged doing cards still carry PR URLs",
                    detail=f"count={len(suspects)} sample={', '.join(suspects[:5])}",
                    recommendations=[
                        "Likely merged-but-not-closed — run `last-stack-board-closeout-sweep`.",
                        "Confirm com.edgevector.board-closeout LaunchAgent is loaded.",
                    ],
                )
            )

    # ── install freshness (self-upgrade gate) ──────────────────────────────
    if cfg_get(cfg, "install", "enabled", True):
        last_stack = Path(meta.get("last_stack") or Path.home() / ".last-stack")
        status = str(meta.get("install_update_status") or "")
        behind = bool(meta.get("install_behind"))
        if not status and last_stack.exists():
            status = update_check_status(last_stack)
            behind = install_is_behind(status)
        scan_n = int(cfg_get(cfg, "install", "heartbeat_scan_lines", 200))
        hb_stale = int(meta.get("install_stale_heartbeats") or 0)
        if not hb_stale:
            hb_stale = count_trailing_stale_install_heartbeats(scan_n)
        soft_n = int(cfg_get(cfg, "install", "heartbeat_stale_soft", 3))
        hard_n = int(cfg_get(cfg, "install", "heartbeat_stale_hard", 6))
        soft_when_behind = bool(cfg_get(cfg, "install", "soft_when_behind", True))
        ctx = {
            "doing": snap.doing,
            "todo": snap.todo,
            "stale_doing": snap.stale_doing,
            "max_doing_age_h": snap.max_doing_age_h,
            "routines_profile": meta.get("routines_profile", ""),
            "install_behind": behind,
            "install_stale_heartbeats": hb_stale,
        }
        recs = diagnose_ship(ctx)
        # Hard: known-behind with idle factory, or long stale-install noop streak
        if behind and snap.todo > 0 and snap.doing == 0:
            alerts.append(
                Alert(
                    severity="hard",
                    code="install_stale_hard",
                    title="Last Stack install behind; pickup cannot claim",
                    detail=(
                        f"update_check={status[:120]!r} todo={snap.todo} doing={snap.doing} "
                        f"stale_install_heartbeats={hb_stale}"
                    ),
                    recommendations=recs,
                )
            )
        elif hb_stale >= hard_n and snap.todo > 0:
            alerts.append(
                Alert(
                    severity="hard",
                    code="install_stale_hard",
                    title="Pickup stuck on stale-last-stack-install",
                    detail=(
                        f"trailing_stale_install_heartbeats={hb_stale} (hard≥{hard_n}) "
                        f"todo={snap.todo} doing={snap.doing} update_check={status[:80]!r}"
                    ),
                    recommendations=recs,
                )
            )
        elif soft_when_behind and behind:
            alerts.append(
                Alert(
                    severity="soft",
                    code="install_stale_soft",
                    title="Last Stack install reports update available",
                    detail=f"update_check={status[:120]!r} stale_install_heartbeats={hb_stale}",
                    recommendations=recs,
                )
            )
        elif hb_stale >= soft_n and snap.todo > 0 and snap.doing == 0:
            alerts.append(
                Alert(
                    severity="soft",
                    code="install_stale_soft",
                    title="Pickup nooping on stale install while todo has work",
                    detail=(
                        f"trailing_stale_install_heartbeats={hb_stale} (soft≥{soft_n}) "
                        f"todo={snap.todo} doing={snap.doing}"
                    ),
                    recommendations=recs,
                )
            )

    return alerts


def fingerprint(alerts: list[Alert]) -> str:
    return "|".join(sorted(f"{a.severity}:{a.code}" for a in alerts))


def should_notify(state: dict[str, Any], fp: str, cooldown_s: int) -> bool:
    la = state.get("last_alert") or {}
    if la.get("fp") != fp:
        return True
    try:
        last = float(la.get("ts_epoch") or 0)
    except Exception:
        return True
    return (time.time() - last) >= cooldown_s


def format_message(snap: Snapshot, alerts: list[Alert], meta: dict[str, Any]) -> str:
    hard = [a for a in alerts if a.severity == "hard"]
    soft = [a for a in alerts if a.severity == "soft"]
    level = "HARD" if hard else "SOFT"
    lines = [
        f"🏭 Factory health {level} — {snap.ts}",
        f"board todo={snap.todo} doing={snap.doing} backlog={snap.backlog} done={snap.done}"
        + (f" (unreachable={snap.parked_ungated})" if snap.parked_ungated else ""),
        f"ships last_h={fmt_ships(snap.ships_last_h)}  24h={fmt_ships(snap.ships_24h)}"
        + (
            f" (~{(snap.ships_per_hour_24h or 0):.2f}/h)"
            if snap.ships_per_hour_24h is not None
            else " (unavailable)"
        )
        + (f" source={snap.ships_source}" if snap.ships_source else ""),
        f"doing max_age={snap.max_doing_age_h}h stale={snap.stale_doing} profile={meta.get('routines_profile') or '?'}",
        "",
    ]
    for a in hard + soft:
        lines.append(f"• [{a.severity.upper()}] {a.title}")
        lines.append(f"  {a.detail}")
        for r in a.recommendations[:4]:
            lines.append(f"  → {r}")
        lines.append("")
    lines.append(
        "Phase: auto_fix may start factory-heal (state-machine) and "
        "class_a_heal on install_stale_* (see factory-health.toml [auto_fix])."
    )
    lines.append("Config: last-stack/config/factory-health.toml")
    return "\n".join(lines).strip()


def notify_tom(msg: str, priority: str, dry_run: bool) -> tuple[bool, str]:
    if dry_run:
        return True, "dry-run"
    # Prefer ra notify
    code, out, err = run(["ra", "notify", msg, "--priority", priority], timeout=45)
    if code == 0:
        return True, (out or "ok").strip()[:200]
    return False, (err or out or f"exit {code}")[:300]


def maybe_auto_fix(cfg: dict[str, Any], alerts: list[Alert], last_stack: Path, dry_run: bool) -> list[str]:
    if not cfg_get(cfg, "auto_fix", "enabled", False):
        return []
    allowed = set(cfg_get(cfg, "auto_fix", "actions", []) or [])
    actions: list[str] = []
    if not allowed:
        return actions
    codes = {a.code for a in alerts}
    if "class_a_heal" in allowed and codes & {
        "install_stale_hard",
        "install_stale_soft",
    }:
        bin_path = last_stack / "bin" / "last-stack-class-a-heal"
        if bin_path.exists():
            if dry_run:
                actions.append("would:class_a_heal")
            else:
                code, out, err = run(
                    [str(bin_path), "--reason=factory-health"],
                    timeout=300,
                )
                actions.append(f"class_a_heal:exit={code}")
                if code != 0 and (err or out):
                    actions.append(f"class_a_heal:detail={(err or out).strip()[:120]}")
    if "board_closeout" in allowed and codes & {
        "doing_stuck_hard",
        "doing_stuck_soft",
        "closeout_backlog",
        "closeout_stale_pr_card",
        "ship_rate_hard",
        "ship_rate_soft",
    }:
        bin_path = last_stack / "bin" / "last-stack-board-closeout-sweep"
        if bin_path.exists():
            if dry_run:
                actions.append("would:board_closeout")
            else:
                code, out, err = run([str(bin_path)], timeout=180)
                actions.append(f"board_closeout:exit={code}")
    if "factory_heal" in allowed:
        # A factory-heal STARTS only on an alerting hour, but it must be TICKED
        # every hour. The tick used to sit inside the `and alerts` gate, so an
        # execution started on an alerting hour stalled mid-flight as soon as
        # the board went quiet, and its concurrency key then refused the next
        # start. Observed 2026-09-03: exec_29bd266a6bbf4fb8 sat in VERIFY from
        # 21:19Z to 23:09Z through a quiet 22:17Z run, and finished in one
        # second on a hand tick.
        sm = ""
        for cand in ("state-machine", "sm"):
            code_w, out_w, _ = run(["sh", "-c", f"command -v {cand}"], timeout=5)
            if code_w == 0 and (out_w or "").strip():
                sm = (out_w or "").strip().splitlines()[0]
                break
        if sm:
            if dry_run:
                actions.append("would:factory_heal" if alerts else "would:factory_heal_tick")
            else:
                start_code = None
                start_out = ""
                start_err = ""
                if alerts:
                    hour = utc_now().strftime("%Y%m%d%H")
                    input_json = json.dumps(
                        {"source": "factory-health", "codes": sorted(codes)}
                    )
                    start_code, start_out, start_err = run(
                        [
                            sm,
                            "start",
                            "factory-heal",
                            "--concurrency-key",
                            "factory-heal",
                            "--idempotency-key",
                            f"factory-heal-{hour}",
                            "--input",
                            input_json,
                        ],
                        timeout=60,
                    )
                tick_code, tick_out, tick_err = run(
                    [sm, "tick", "--definition", "factory-heal", "--cap", "8"],
                    timeout=300,
                )
                start_label = "skip" if start_code is None else start_code
                actions.append(f"factory_heal:start={start_label} tick={tick_code}")
                if start_code not in (None, 0) and (start_err or start_out):
                    actions.append(
                        f"factory_heal:start_detail={(start_err or start_out).strip()[:120]}"
                    )
                if tick_code != 0 and (tick_err or tick_out):
                    actions.append(
                        f"factory_heal:tick_detail={(tick_err or tick_out).strip()[:120]}"
                    )
        elif alerts:
            actions.append("factory_heal:sm-missing")
    return actions


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="Kanban factory health (hourly bands)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--config", default="")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-notify", action="store_true")
    ap.add_argument("--last-stack", default="")
    args = ap.parse_args(argv)

    self_dir = Path(__file__).resolve().parent
    last_stack = Path(args.last_stack) if args.last_stack else self_dir.parent
    cfg_path = Path(args.config) if args.config else default_config_path(last_stack)
    if not cfg_path.exists():
        print(f"factory-health: missing config {cfg_path}", file=sys.stderr)
        return 2
    cfg = load_toml(cfg_path)

    sdir = state_dir(last_stack)
    state_path = sdir / "state.json"
    state = load_state(state_path)

    board_cli = "kanban"
    code_k, _, _ = run(["sh", "-c", "command -v kanban"], timeout=5)
    if code_k != 0:
        board_cli = "fkanban"

    factory_url = str(cfg_get(cfg, "general", "factory_url", "http://127.0.0.1:4177"))
    factory_timeout = float(
        cfg_get(cfg, "general", "factory_timeout_s", DEFAULT_FACTORY_TIMEOUT_S)
    )
    fetch = fetch_factory(factory_url, timeout=factory_timeout)
    factory = fetch.data
    cards = list_cards(board_cli)
    if not cards and fetch.kind != "ok":
        line = f"factory-health {iso_z()} noop alerts=0 flagged=board-and-factory-unavailable"
        print(line)
        return 0

    use_completed = bool(cfg_get(cfg, "general", "use_completed_hour", True))
    ship = resolve_ships(factory, use_completed)
    snap, meta = build_snapshot(
        cards,
        factory,
        use_completed,
        parked_min_age_h=float(cfg_get(cfg, "backlog", "min_age_h", 3.0)),
        ship_read=ship,
    )
    ready = pickup_ready_count(board_cli)
    snap.pickup_ready = ready if ready is not None else -1
    gap_report, gap_error = fetch_gap_report(board_cli)
    frontier, frontier_detail = frontier_from_gap_report(gap_report, gap_error)
    meta["safe_milestone_frontier"] = frontier
    meta["safe_milestone_frontier_detail"] = frontier_detail
    # refresh stale with config soft age for snapshot fields before evaluate mutates
    soft_age = float(cfg_get(cfg, "doing", "soft_max_age_h", 2.0))
    max_age, stale = recompute_stale(
        actionable_doing(meta.get("doing_cards") or []), soft_age
    )
    snap.max_doing_age_h = max_age
    snap.stale_doing = stale

    # Install freshness context for evaluate()
    meta["last_stack"] = str(last_stack)
    try:
        uc = update_check_status(last_stack)
    except Exception:
        uc = ""
    meta["install_update_status"] = uc
    meta["install_behind"] = install_is_behind(uc)
    try:
        meta["install_stale_heartbeats"] = count_trailing_stale_install_heartbeats(
            int(cfg_get(cfg, "install", "heartbeat_scan_lines", 200))
        )
    except Exception:
        meta["install_stale_heartbeats"] = 0

    alerts = evaluate(cfg, snap, meta, state)

    # Supply per admitted North Star. Kept out of evaluate() so the band tests
    # that call evaluate() with an empty meta keep their exact alert lists.
    supply: Optional[dict[str, Any]] = None
    supply_error = "disabled"
    consecutive = 0
    streaks: dict[str, int] = {}
    ssdir = supply_state_dir()
    if cfg_get(cfg, "supply", "enabled", True):
        brain_cli = str(cfg_get(cfg, "supply", "brain_cli", "brain"))
        try:
            supply, supply_error = collect_supply(
                cfg, board_cli, brain_cli, gap_report, gap_error
            )
        except Exception as exc:  # a supply read must never kill the pass
            supply, supply_error = None, f"error: {exc}"[:160]
        previous = load_state(ssdir / "supply-state.json")
        if supply is not None:
            streaks, consecutive = advance_jam_streaks(
                previous, [j["ns"] for j in supply.get("jammed") or []]
            )
        else:
            # An unreadable pass neither extends nor clears a jam streak.
            prev = previous.get("jam_streaks") if isinstance(previous, dict) else {}
            streaks = dict(prev) if isinstance(prev, dict) else {}
            consecutive = max((int(v) for v in streaks.values()), default=0)
        alerts.extend(evaluate_supply(cfg, supply, supply_error, consecutive))
        meta["supply"] = supply_latest_payload(supply, consecutive, iso_z())
        meta["supply_error"] = supply_error

    # Append history ring (keep ~7d hourly)
    hist = state.setdefault("history", [])
    hist.append(asdict(snap))
    state["history"] = hist[-24 * 7 :]

    # Supply alerts name work that no closeout or install heal can create, so
    # they do not start factory-heal.
    actions = maybe_auto_fix(
        cfg, [a for a in alerts if not a.code.startswith("supply_")], last_stack, args.dry_run
    )

    severity = "ok"
    if any(a.severity == "hard" for a in alerts):
        severity = "hard"
    elif any(a.severity == "soft" for a in alerts):
        severity = "soft"
    elif not alerts:
        severity = "ok"

    notified = False
    notify_detail = "skipped"
    notifiable = [a for a in alerts if a.notify]
    if not notifiable and alerts:
        notify_detail = "not-notifiable"
    if notifiable and cfg_get(cfg, "notify", "enabled", True) and not args.no_notify:
        quiet = in_quiet_hours(cfg)
        hard_only = [a for a in notifiable if a.severity == "hard"]
        if quiet and not cfg_get(cfg, "notify", "quiet_allows_hard", True):
            notify_detail = "quiet-hours"
        elif quiet and not hard_only and cfg_get(cfg, "notify", "quiet_allows_hard", True):
            # soft only during quiet — skip
            notify_detail = "quiet-soft-suppressed"
        else:
            to_send = hard_only if quiet else notifiable
            if not to_send:
                notify_detail = "quiet-no-hard"
            else:
                fp = fingerprint(to_send)
                cooldown = int(cfg_get(cfg, "notify", "cooldown_s", 3600))
                if should_notify(state, fp, cooldown):
                    msg = format_message(snap, to_send, meta)
                    pri = (
                        str(cfg_get(cfg, "notify", "priority_hard", "high"))
                        if any(a.severity == "hard" for a in to_send)
                        else str(cfg_get(cfg, "notify", "priority_soft", "normal"))
                    )
                    ok, detail = notify_tom(msg, pri, args.dry_run)
                    notified = ok
                    notify_detail = detail
                    if ok and not args.dry_run:
                        state["last_alert"] = {"fp": fp, "ts_epoch": time.time(), "ts": iso_z()}
                else:
                    notify_detail = "cooldown"

    if not args.dry_run:
        save_state(state_path, state)
        if cfg_get(cfg, "supply", "enabled", True):
            try:
                write_supply_files(ssdir, supply, streaks, consecutive, iso_z())
            except OSError as exc:
                print(f"factory-health: supply state write failed: {exc}", file=sys.stderr)

    codes = ",".join(a.code for a in alerts) if alerts else "none"
    line = (
        f"factory-health {iso_z()} {severity} alerts={len(alerts)} codes={codes} "
        f"ready={snap.pickup_ready} todo={snap.todo} doing={snap.doing} "
        f"parked_ungated={snap.parked_ungated} "
        f"ships_h={fmt_ships(snap.ships_last_h)} "
        f"ships_24h={fmt_ships(snap.ships_24h)} "
        f"ships_source={snap.ships_source or 'unavailable'} "
        f"max_doing_age_h={snap.max_doing_age_h} "
        f"notified={int(notified)} notify={notify_detail} "
        f"auto_fix={','.join(actions) if actions else 'none'} "
        f"factory={factory_status_label(fetch)} "
        f"runnable_by_ns={format_runnable(supply)} "
        f"jammed={format_jammed(supply)} "
        f"jam_passes={consecutive}"
    )
    print(line)
    if args.json:
        print(
            json.dumps(
                {
                    "snapshot": asdict(snap),
                    "alerts": [asdict(a) for a in alerts],
                    "meta": {k: v for k, v in meta.items() if k != "doing_cards"},
                    "notified": notified,
                    "notify_detail": notify_detail,
                    "actions": actions,
                },
                indent=2,
            )
        )

    # Heartbeat best-effort
    hb = last_stack / "bin" / "last-stack-brain-append-heartbeat"
    if not args.dry_run and hb.exists():
        run([str(hb), "--line", line], timeout=30)

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
