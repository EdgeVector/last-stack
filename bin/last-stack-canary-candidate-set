#!/usr/bin/env python3
"""Write the nightly candidate set: one LastDB build plus one commit per app.

The candidate set is what the isolated llms-txt smoke installs and what the
registry `next` rows record when that smoke is GREEN. Fixing the app commits
before the smoke is the whole point: the pair that was proved is the pair
that gets published, not "whatever main was when the user cloned".

Per app the commit comes from, in order:
  1. --pin <app>=<sha>                    operator override
  2. the artifact CAS channel             channels/<artifact_app>/<channel>.json
     (the app's released head: built and green-published)
  3. `git ls-remote <source> refs/heads/main`

`--sha-source github-ci` replaces steps 2 and 3 for a host with no artifact CAS
(a GitHub Actions runner): per app, the newest of the last 20 commits on GitHub
`main` whose `ci-required` check run is `success` AND, for an app that publishes
an artifact (`artifact_app` set), whose Actions artifact `ht-artifact-<sha>`
exists and has not expired. That is the same "released head" the Mac reads from
the CAS. An app with no `artifact_app` needs only the green check. No such
commit in the window is an error (exit 3): the set never pairs a build with an
unreleased head. The GitHub reads go through `gh` (override: LAST_STACK_GH_BIN).

The source is the app's gate of record: `github` (the GitHub repo) in
config/registry/apps.json. Every EdgeVector repo except `lastgit` is on GitHub
(2026-09-30, decision-2026-09-29-retire-lastgit-all-repos-to-github); LastGit is
retired and this script no longer reads it. Each repo's Forgejo copy (`forge`)
is frozen read-only and never gets a new commit. A set that names the frozen
copy pins commits it cannot serve: measured 2026-09-27, routines' artifact head
3bf55c676a14 was not on the frozen copy, and every primary-rows smoke went RED
on it. `--source-venue` picks the venues: `auto` tries `github` (when the app
has one), then `forge`; `github` or `forge` tries only that one.

Each pin is probed on each candidate source in order (one depth-1 fetch into
a throwaway repo), and the first source that serves it wins. A fallback is
normal for a commit released before a repo was seeded from a squash
(situations, 2026-09-28: artifact head 38b0b7f6d689 was on the frozen Forgejo
copy but not on the squash-seeded repo). It prints a NOTE and the row records
`source_fallback_from`. A pin that no source serves prints a WARNING and the
row records `source_reachable: false`; the smoke then fails that app alone.

The set records the chosen `source` (what last-stack-install-apps --pins
clones from and what `next` rows carry), `source_venue`, `source_reachable`,
`forge_source`, and the untouched `public_source` (what `stable` rows carry).

The app version is read from `package.json` at that commit through a small
bounded bare cache (one shallow fetch per app), else `0.0.0`.

No walk. Every path comes from a flag or a fixed default under
~/.local/state/last-stack.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
DEFAULT_APPS_CONFIG = ROOT / "config" / "registry" / "apps.json"
DEFAULT_ARTIFACT_ROOT = HOME / ".lastgit" / "artifacts"
DEFAULT_CACHE_ROOT = HOME / ".local" / "state" / "last-stack" / "registry-cache"
DEFAULT_OUT_ROOT = HOME / ".local" / "state" / "last-stack" / "canary-candidate-sets"


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def die(message: str, code: int = 1) -> None:
    print(f"last-stack-canary-candidate-set: {message}", file=sys.stderr)
    raise SystemExit(code)


_FORGE_GIT_ENV: dict[str, str] | None = None


def forge_git_env() -> dict[str, str]:
    """git env with the local forge token as an HTTP extraHeader (GIT_CONFIG_*).

    The candidate set reads Forge repos unattended; there is no keychain
    prompt to answer, so the token rides in the environment the same way
    last-stack-forge-git passes it on the command line."""
    global _FORGE_GIT_ENV
    if _FORGE_GIT_ENV is not None:
        return _FORGE_GIT_ENV
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "RUST_LOG": "off"}
    # lib/forge-token.sh is the one place that names the token sources
    # ($FORGE_TOKEN, keychain, lastsecrets); a python helper sources it
    # through bash instead of keeping its own copy of that order.
    token = os.environ.get("FORGE_TOKEN", "").strip()
    if not token:
        lib = ROOT / "lib" / "forge-token.sh"
        proc = subprocess.run(["bash", "-c", f'. "{lib}" && last_stack_forge_token'],
                              capture_output=True, text=True, check=False)
        token = proc.stdout.strip() if proc.returncode == 0 else ""
    if token:
        # Append to the caller's GIT_CONFIG_* entries; never replace them.
        try:
            n = int(env.get("GIT_CONFIG_COUNT") or "0")
        except ValueError:
            n = 0
        env["GIT_CONFIG_COUNT"] = str(n + 1)
        env[f"GIT_CONFIG_KEY_{n}"] = "http.http://localhost:3300/.extraHeader"
        env[f"GIT_CONFIG_VALUE_{n}"] = f"Authorization: token {token}"
    _FORGE_GIT_ENV = env
    return env


def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=timeout,
        env=forge_git_env(),
        check=False,
    )


def lastdbd_build(bin_path: Path) -> str:
    proc = run([str(bin_path), "--version"], timeout=20)
    if proc.returncode != 0:
        die(f"{bin_path} --version failed: {proc.stderr.strip()[:200]}")
    for line in proc.stdout.splitlines():
        line = line.strip()
        if line.startswith("lastdbd "):
            return line.split(None, 1)[1].strip()
    die(f"{bin_path} --version printed no `lastdbd <build>` line")
    return ""


def build_abbrev(build: str) -> str:
    """The `g<hex>` tail of a `git describe --long` build string, hex only.

    `0.23.3-2378-gbe41e547e` -> `be41e547e`. Empty for a build with no tail."""
    tail = build.rsplit("-g", 1)
    if len(tail) == 2 and tail[1] and all(c in "0123456789abcdef" for c in tail[1]):
        return tail[1]
    return ""


def check_oid_matches_build(oid: str, build: str) -> None:
    """A recorded oid must be a full 40-hex id that the build string names.

    `git describe --abbrev=9` puts the first nine hex digits of the source oid
    in the build, so an oid that does not start with them names another commit.
    Exits 2 on a mismatch so a row never pairs a build with the wrong source."""
    if len(oid) != 40 or any(c not in "0123456789abcdef" for c in oid):
        die(f"lastdb oid {oid!r} is not a 40-hex git oid", 2)
    abbrev = build_abbrev(build)
    if abbrev and not oid.startswith(abbrev):
        die(f"lastdb oid {oid} does not match build {build} (build names {abbrev})", 2)


def lastdb_oid_from_manifest(bin_path: Path, manifest: Path | None = None) -> str:
    candidates = [manifest] if manifest else [bin_path.parent / "manifest.json", bin_path.parent.parent / "manifest.json"]
    for candidate in candidates:
        if candidate.is_file():
            try:
                data = json.loads(candidate.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            oid = str(data.get("source_git_oid") or "")
            if oid:
                return oid
    return ""


def artifact_channel_oid(artifact_root: Path, artifact_app: str | None, channel: str) -> str:
    if not artifact_app:
        return ""
    path = artifact_root / "channels" / artifact_app / f"{channel}.json"
    if not path.is_file():
        return ""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return ""
    return str(data.get("source_oid") or "")


def main_oid(url: str) -> str:
    """`refs/heads/main` of `url` (the app's gate of record), or ""."""
    proc = run(["git", "ls-remote", url, "refs/heads/main"], timeout=60)
    if proc.returncode != 0:
        return ""
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == "refs/heads/main":
            return parts[0]
    return ""


GH_CI_WINDOW = 20


def gh_bin() -> str:
    return os.environ.get("LAST_STACK_GH_BIN", "gh")


def gh_json(path: str, jq: str) -> object:
    """`gh api <path> --jq <jq>` parsed as JSON, or None on any failure."""
    proc = subprocess.run([gh_bin(), "api", path, "--jq", jq], capture_output=True, text=True,
                          timeout=60, check=False)
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout or "null")
    except json.JSONDecodeError:
        return None


def repo_slug(url: str) -> str:
    """`https://github.com/EdgeVector/brain.git` -> `EdgeVector/brain`; "" otherwise."""
    prefix = "https://github.com/"
    if not url.startswith(prefix):
        return ""
    slug = url[len(prefix):]
    return slug[:-4] if slug.endswith(".git") else slug


def github_ci_head(cfg: dict) -> tuple[str, str]:
    """(sha, why) of the newest green, published `main` commit; ("", why) when none.

    See the module docstring, `--sha-source github-ci`."""
    slug = repo_slug(str(cfg.get("github") or ""))
    if not slug:
        return "", "no github repo"
    needs_artifact = bool(cfg.get("artifact_app"))
    commits = gh_json(f"repos/{slug}/commits?sha=main&per_page={GH_CI_WINDOW}", "[.[].sha]")
    if not isinstance(commits, list) or not commits:
        return "", f"could not list main commits of {slug}"
    for sha in commits[:GH_CI_WINDOW]:
        runs = gh_json(f"repos/{slug}/commits/{sha}/check-runs?per_page=100",
                       '[.check_runs[] | select(.name == "ci-required" or (.name | endswith("/ ci-required"))) | .conclusion]')
        if not isinstance(runs, list) or "success" not in runs:
            continue
        if needs_artifact:
            arts = gh_json(f"repos/{slug}/actions/artifacts?name=ht-artifact-{sha}&per_page=10",
                           "[.artifacts[] | select(.expired == false)] | length")
            if not isinstance(arts, int) or arts < 1:
                continue
        return str(sha), "ok"
    need = "a green ci-required and an ht-artifact" if needs_artifact else "a green ci-required"
    return "", f"none of the last {GH_CI_WINDOW} main commits of {slug} has {need}"


def source_candidates(app: str, cfg: dict, venue: str) -> list[tuple[str, str]]:
    """Ordered (url, venue) sources to try for one app. See the module docstring."""
    github = str(cfg.get("github") or "")
    forge = str(cfg.get("forge") or "")
    if venue == "github":
        if not github:
            die(f"--source-venue github: app {app!r} has no `github` field", 2)
        return [(github, "github")]
    if venue == "forge":
        return [(forge, "forge")] if forge else []
    out: list[tuple[str, str]] = []
    if github:
        out.append((github, "github"))
    if forge:
        out.append((forge, "forge"))
    return out


def commit_reachable(probe_root: Path, url: str, sha: str) -> bool:
    """True when `url` serves `sha`: a depth-1 fetch into a throwaway bare repo.

    Never the version cache: it keeps commits from every source it ever read,
    so a commit found there says nothing about THIS source. Measured
    2026-09-28: situations' artifact head 38b0b7f6d689 was in the cache (read
    from Forgejo) but not on GitHub, whose history for situations starts at a
    squashed era-3 seed commit."""
    probe_root.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="probe.", dir=str(probe_root)) as tmp:
        if run(["git", "init", "--quiet", "--bare", tmp], timeout=30).returncode != 0:
            return False
        fetch = run(["git", "-C", tmp, "fetch", "--quiet", "--depth", "1", url, sha], timeout=180)
        return fetch.returncode == 0


def app_version_at(cache_root: Path, app: str, url: str, sha: str) -> str:
    """package.json version at `sha`, through a bounded per-app bare cache."""
    cache = cache_root / f"{app}.git"
    if not cache.is_dir():
        cache.parent.mkdir(parents=True, exist_ok=True)
        init = run(["git", "init", "--quiet", "--bare", str(cache)], timeout=30)
        if init.returncode != 0:
            return "0.0.0"
    show = run(["git", "-C", str(cache), "show", f"{sha}:package.json"], timeout=30)
    if show.returncode != 0:
        fetch = run(["git", "-C", str(cache), "fetch", "--quiet", "--depth", "1", url, sha], timeout=180)
        if fetch.returncode != 0:
            return "0.0.0"
        show = run(["git", "-C", str(cache), "show", f"{sha}:package.json"], timeout=30)
        if show.returncode != 0:
            return "0.0.0"
    try:
        version = str(json.loads(show.stdout).get("version") or "").strip()
    except json.JSONDecodeError:
        return "0.0.0"
    return version or "0.0.0"


def parse_pins(values: list[str]) -> dict[str, str]:
    pins: dict[str, str] = {}
    for value in values:
        if "=" not in value:
            die(f"--pin takes <app>=<sha>, got {value!r}", 2)
        app, sha = value.split("=", 1)
        pins[app.strip()] = sha.strip()
    return pins


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="last-stack-canary-candidate-set",
        description="Write the nightly candidate set: one LastDB build plus one commit per app.",
    )
    parser.add_argument("--lastdbd", type=Path, default=None, help="the candidate lastdbd binary (canary-builds/<oid>/lastdbd)")
    parser.add_argument("--lastdb-build", default="",
                        help="the build string, in place of --lastdbd, for a host with no lastdbd (the cheap "
                        "heads check on an ubuntu runner). The set records an empty lastdb.bin.")
    parser.add_argument("--apps-config", type=Path, default=DEFAULT_APPS_CONFIG)
    parser.add_argument("--only", action="append", default=[], help="limit to these app ids (repeatable)")
    parser.add_argument("--pin", action="append", default=[], help="<app>=<sha> override (repeatable)")
    parser.add_argument("--artifact-root", type=Path, default=Path(os.environ.get("HOST_TRACK_ARTIFACT_ROOT", DEFAULT_ARTIFACT_ROOT)))
    parser.add_argument("--artifact-channel", default="stable", help="artifact CAS channel that names each app's released head")
    parser.add_argument(
        "--source-venue",
        choices=("auto", "github", "forge"),
        default=os.environ.get("LAST_STACK_CANDIDATE_SOURCE_VENUE", "auto"),
        help="where each app's source is read: auto (github when the app has one, then "
        "forge), github, or forge (the frozen copy)",
    )
    parser.add_argument("--lastdb-oid", default="",
                        help="full 40-hex source oid of the lastdb build (a built binary: the fold "
                        "commit that was checked out). Checked against the build string.")
    parser.add_argument("--lastdb-manifest", type=Path, default=None,
                        help="release manifest.json whose source_git_oid names the build "
                        "(a release tarball; default: manifest.json next to the binary)")
    parser.add_argument("--sha-source", choices=("auto", "github-ci"), default="auto",
                        help="auto: artifact channel, then main. github-ci: newest main commit with a "
                        "green ci-required and (for an app with an artifact) an ht-artifact-<sha>")
    parser.add_argument("--cache-root", type=Path, default=DEFAULT_CACHE_ROOT)
    parser.add_argument("--no-version-lookup", action="store_true", help="skip the package.json fetch; versions read 0.0.0")
    parser.add_argument("--no-source-probe", action="store_true",
                        help="do not fetch each pin from its source; take the first source as is")
    parser.add_argument("--out", type=Path, help="output file (default: <out-root>/<lastdb build>.json)")
    parser.add_argument("--out-root", type=Path, default=DEFAULT_OUT_ROOT)
    parser.add_argument("--json", action="store_true", help="print the set to stdout as well")
    args = parser.parse_args(argv)

    if bool(args.lastdbd) == bool(args.lastdb_build):
        die("give exactly one of --lastdbd and --lastdb-build", 2)
    if args.lastdbd and not args.lastdbd.is_file():
        die(f"lastdbd not found at {args.lastdbd}", 2)
    try:
        config = json.loads(args.apps_config.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"apps config {args.apps_config}: {exc}", 2)
    apps_cfg: dict = config.get("apps") or {}
    if not apps_cfg:
        die(f"apps config {args.apps_config} has no apps", 2)
    pins = parse_pins(args.pin)
    for pinned in pins:
        if pinned not in apps_cfg:
            die(f"--pin names unknown app {pinned!r}", 2)
    selected = [a for a in apps_cfg if not args.only or a in args.only]
    for wanted in args.only:
        if wanted not in apps_cfg:
            die(f"--only names unknown app {wanted!r}", 2)

    build = args.lastdb_build.strip() if args.lastdb_build else lastdbd_build(args.lastdbd)
    oid, oid_source = "", ""
    if args.lastdb_oid:
        oid, oid_source = args.lastdb_oid.strip().lower(), "flag"
    elif args.lastdbd:
        oid = lastdb_oid_from_manifest(args.lastdbd, args.lastdb_manifest)
        oid_source = "manifest" if oid else ""
    if oid:
        check_oid_matches_build(oid, build)
    apps_out: dict[str, dict] = {}
    missing: list[str] = []
    unreachable: list[str] = []
    for app in selected:
        cfg = apps_cfg[app]
        candidates = source_candidates(app, cfg, args.source_venue)
        if not candidates:
            missing.append(app)
            continue
        if app in pins:
            sha, sha_source = pins[app], "pin"
        elif args.sha_source == "github-ci":
            sha, why = github_ci_head(cfg)
            sha_source = "github-ci-main"
            if not sha:
                print(f"last-stack-canary-candidate-set: {app}: {why}", file=sys.stderr)
        else:
            sha = artifact_channel_oid(args.artifact_root, cfg.get("artifact_app"), args.artifact_channel)
            sha_source = f"artifact-channel:{args.artifact_channel}"
            if not sha:
                for url, venue in candidates:
                    sha = main_oid(url)
                    if sha:
                        sha_source = f"{venue}-main"
                        break
        if not sha:
            missing.append(app)
            continue
        # The first source that serves the commit wins. GitHub first: it is
        # the gate of record. The frozen Forgejo copy still serves every commit
        # made before a squash-seeded repo, which GitHub may not have.
        source, venue = candidates[0]
        reachable = True
        fallback_from = ""
        if not args.no_source_probe:
            reachable = False
            for url, v in candidates:
                if commit_reachable(args.cache_root / ".probe", url, sha):
                    source, venue, reachable = url, v, True
                    break
            if reachable and venue != candidates[0][1]:
                fallback_from = candidates[0][1]
                print(
                    f"last-stack-canary-candidate-set: NOTE {app} {sha[:12]} ({sha_source}) is not on "
                    f"{candidates[0][0]}; using {source}",
                    file=sys.stderr,
                )
        if not reachable:
            unreachable.append(app)
            print(
                f"last-stack-canary-candidate-set: WARNING {app} {sha[:12]} ({sha_source}) could not be "
                f"fetched from {', '.join(u for u, _ in candidates)}; the install smoke will fail this app",
                file=sys.stderr,
            )
        version = "0.0.0" if args.no_version_lookup else app_version_at(args.cache_root, app, source, sha)
        row = {
            "sha": sha,
            "sha_source": sha_source,
            "app_version": version,
            "source": source,
            "source_venue": venue,
            "source_reachable": reachable,
            "forge_source": str(cfg.get("forge") or ""),
            "public_source": str(cfg.get("public") or ""),
            "install_name": str(cfg.get("install_name") or app),
            "description": str(cfg.get("description") or ""),
        }
        if fallback_from:
            row["source_fallback_from"] = fallback_from
        apps_out[app] = row
    if missing:
        die(f"no commit could be resolved for: {', '.join(missing)}", 3)

    candidate_set = {
        "created_at": utc_now(),
        "lastdb": {"build": build, "oid": oid, "oid_source": oid_source, "bin": str(args.lastdbd or "")},
        "apps": apps_out,
    }
    out = args.out or (args.out_root / f"{build}.json")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(candidate_set, indent=2) + "\n", encoding="utf-8")
    if args.json:
        print(json.dumps(candidate_set, indent=2))
    else:
        print(f"candidate set: lastdb {build} + {len(apps_out)} apps -> {out}")
        for app, row in apps_out.items():
            print(f"  {app}\t{row['app_version']}\t{row['sha'][:12]}\t{row['sha_source']}\t{row['source']}")
        if unreachable:
            print(f"  unreachable on their source: {', '.join(unreachable)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
