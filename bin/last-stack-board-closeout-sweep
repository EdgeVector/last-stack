import json, os, re, subprocess, sys, time
from pathlib import Path

last_stack = Path(sys.argv[1])
board_cli = os.environ.get("BOARD_CLI", "kanban")
dry_run = os.environ.get("BOARD_CLOSEOUT_DRY_RUN") == "1"
grace_min = max(1, int(os.environ.get("BOARD_CLOSEOUT_GRACE_MIN") or "60"))
max_actions = max(1, int(os.environ.get("BOARD_CLOSEOUT_MAX_ACTIONS") or "50"))
max_park_hours = max(1, int(os.environ.get("BOARD_CLOSEOUT_MAX_PARK_HOURS") or "24"))
skip_zombie = os.environ.get("BOARD_CLOSEOUT_SKIP_ZOMBIE") == "1"
json_out = os.environ.get("BOARD_CLOSEOUT_JSON") == "1"
now = time.time()
iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now))
home = Path.home()
worktree_roots = [home / ".kanban" / "worktrees", home / ".fkanban" / "worktrees"]
forge_api = last_stack / "bin" / "last-stack-forge-api"
closeout_bin = last_stack / "bin" / "last-stack-card-closeout"

res = {"status": "ok", "closed": [], "rolled_back": [], "demoted": [], "skipped": [], "flagged": []}

def run(cmd, timeout=60):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, p.stdout or "", p.stderr or ""
    except Exception as e:
        return False, "", str(e)

def transient_board_failure(text):
    return bool(re.search(
        r"service_timeout|node did not respond|too many concurrent reads|uds_connection_limit|lastdb-sync-outbox-full|max_outbox_entries|folddb\.sock|socket hang up|ECONNRESET|ETIMEDOUT",
        str(text or ""),
        re.I,
    ))

# Slugs whose closeout failed on a transient board/service condition this pass.
# The board itself was unreachable — that is not evidence the CARD is stuck, so
# park expiry must not reclaim them (the reclaim would use the same sick CLI).
closeout_deferred = set()

def note_closeout_deferred(slug, out, err):
    if not transient_board_failure(f"{out or ''} {err or ''}"):
        return False
    closeout_deferred.add(slug)
    res["skipped"].append(f"{slug}:closeout-transient")
    res["flagged"].append(f"closeout-deferred:{slug}")
    if res["status"] == "ok":
        res["status"] = "noop"
    return True

# Consecutive non-transient closeout failures, per slug, across passes. See the
# node engine for the why: a closeout that can never succeed used to repeat in
# silence for 10h. Transient board failures never count.
fail_state_dir = Path(
    os.environ.get("BOARD_CLOSEOUT_STATE_DIR")
    or (home / ".local" / "state" / "last-stack" / "board-closeout")
)
fail_state_path = fail_state_dir / "close-failures.json"
escalate_after = max(1, int(os.environ.get("BOARD_CLOSEOUT_ESCALATE_AFTER") or "3"))

def read_fail_state():
    try:
        data = json.loads(fail_state_path.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}

fail_state = read_fail_state()
# Slugs seen in `doing` this pass — None until the board answered, so a busy
# node never prunes streaks it could not observe.
seen_doing_slugs = None

def write_fail_state():
    if dry_run:
        return
    try:
        fail_state_dir.mkdir(parents=True, exist_ok=True)
        fail_state_path.write_text(json.dumps(fail_state, indent=2) + "\n")
    except Exception:
        pass

def failure_detail(out, err):
    lines = [l.strip() for l in f"{err or ''}\n{out or ''}".split("\n") if l.strip()]
    return (lines[-1] if lines else "closeout failed")[:220]

def note_close_failure(slug, out, err):
    prev = fail_state.get(slug) or {}
    entry = {
        "count": int(prev.get("count") or 0) + 1,
        "first_at": prev.get("first_at") or iso,
        "last_at": iso,
        "last_reason": failure_detail(out, err),
        "escalated": bool(prev.get("escalated")),
    }
    fail_state[slug] = entry
    if entry["count"] < escalate_after or entry["escalated"]:
        return
    entry["escalated"] = True
    res["flagged"].append(f"close-failed-escalated:{slug}")
    if dry_run:
        return
    run(
        [
            board_cli,
            "mark",
            slug,
            f"CLOSE-FAILED-REPEATED {iso} — last-stack-board-closeout-sweep could not close this card on {entry['count']} consecutive passes (since {entry['first_at']}). Last failure: {entry['last_reason']}. The closeout is refusing for the same reason every time; this needs a human or a fix to the gate, not more passes.",
        ],
        timeout=60,
    )

def clear_close_failure(slug):
    fail_state.pop(slug, None)

def strip(s):
    return re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", " ", s or "")

def list_doing():
    ok, out, err = run(
        [board_cli, "list", "--column", "doing", "--json", "--all", "--full-body"],
        timeout=180,
    )
    if not ok:
        ok, out, err = run([board_cli, "list", "--column", "doing", "--json", "--all"], timeout=120)
    if not ok:
        ok, out, err = run([board_cli, "list", "--column", "doing", "--json"], timeout=120)
    if not ok:
        if re.search(r"service_timeout|node did not respond|too many concurrent reads|folddb\.sock", err + out, re.I):
            res["status"] = "noop"
            res["flagged"].append("busy-node")
            return None
        res["status"] = "error"
        res["flagged"].append("board-list-failed")
        return None
    try:
        data = json.loads(strip(out))
    except Exception:
        res["status"] = "error"
        res["flagged"].append("board-json-parse-failed")
        return None
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for k in ("cards", "items"):
            if isinstance(data.get(k), list):
                return data[k]
    return []

def age_s(card):
    try:
        pos = float(card.get("position") or 0)
        if pos > 1e12:
            return now - pos / 1000.0
        if pos > 1e9:
            return now - pos
    except Exception:
        pass
    for key in ("updated_at", "created_at"):
        raw = card.get(key) or ""
        if not raw:
            continue
        try:
            # fromisoformat handles Z with replace
            from datetime import datetime
            dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
            return now - dt.timestamp()
        except Exception:
            continue
    return 0

def body_of(card):
    return str(card.get("body") or card.get("Body") or "")

def parse_body_header(body, name):
    re_h = re.compile(rf"^[ \t]*{re.escape(name)}:[ \t]*(.*)$", re.I)
    in_fence = False
    for line in str(body or "").splitlines():
        if re.match(r"^[ \t]*```", line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re_h.match(line)
        if m:
            raw = m.group(1).split("#", 1)[0].strip().split()
            return raw[0] if raw else ""
    return ""

def extract_pr_url_from_body(body, repo=""):
    for name in ("PR", "CR"):
        raw = parse_body_header(body, name)
        if not raw:
            continue
        normalized = normalize_pr_url(raw)
        if re.match(r"^(https?://|lastgit://)", normalized, re.I):
            return normalized
        cr = re.search(r"\b(cr-[A-Za-z0-9_-]+)\b", raw)
        if cr:
            r = (repo or "").strip()
            slug = r.split("/")[-1] if r else ""
            if slug:
                return f"lastgit://{slug}/cr/{cr.group(1)}"
            return cr.group(1)
        if re.search(r"pulls?/\d+", raw, re.I) or re.search(r"/pull/\d+", raw, re.I):
            return raw
    in_fence = False
    for line in str(body or "").splitlines():
        if re.match(r"^[ \t]*```", line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.search(r"\blastgit://[^\s)>\]]+", line, re.I)
        if m:
            return normalize_pr_url(m.group(0))
    return ""

def normalize_pr_url(raw):
    url = str(raw or "").strip()
    if not url:
        return ""
    url = re.sub(r"^[`<]+", "", url)
    while re.search(r"[`)\]}>.,;]+$", url):
        url = re.sub(r"[`)\]}>.,;]+$", "", url)
    return url.strip()

def pr_url(card):
    field = normalize_pr_url(card.get("pr_url") or card.get("prUrl") or card.get("pr") or "")
    if field:
        return field
    return extract_pr_url_from_body(body_of(card), card.get("repo") or card.get("Repo") or "")

def heal_pr_url(slug, url):
    if dry_run or not url:
        return
    run([board_cli, "add", slug, "--pr-url", url], timeout=45)

def tag_list(card):
    t = card.get("tags") or card.get("Tags") or []
    if isinstance(t, list):
        return [str(x).lower() for x in t]
    return [x.strip().lower() for x in str(t).split() if x.strip()]

def is_deploy_parked(card):
    tags = tag_list(card)
    if any(
        t in (
            "awaiting-deploy",
            "live-proof",
            "deploy-gate",
            "needs-safe-upgrade",
            "awaiting-validation",
        )
        for t in tags
    ):
        return True
    body = body_of(card)
    if parse_body_header(body, "Requires-Deploy"):
        return True
    if re.search(r"^Requires-Deploy:", body, re.I | re.M):
        return True
    if re.search(r"\b(LIVE PROOF|deploy-pipeline proof|awaiting deploy)\b", body, re.I) and re.search(
        r"\b(pending|do not mark done|returning the card|leave(?:ing)? this card)\b", body, re.I
    ):
        return True
    return False

def ensure_awaiting_deploy_tag(slug, card):
    if dry_run:
        return
    if "awaiting-deploy" in tag_list(card):
        return
    run([board_cli, "tag", "add", slug, "awaiting-deploy"], timeout=30)

def worktree(slug):
    for root in worktree_roots:
        p = root / slug
        if p.is_dir():
            return p
    return None

def live_worker(wt):
    if not wt:
        return False
    ok, out, _ = run(["ps", "-ax", "-o", "command="], timeout=15)
    if not ok:
        return False
    s = str(wt)
    return any(s in line and "rg " not in line and "grep" not in line for line in out.splitlines())

def has_commits(wt):
    if not wt:
        return False
    ok, out, _ = run(["git", "-C", str(wt), "rev-list", "--count", "origin/main..HEAD"], timeout=30)
    if ok:
        try:
            return int(out.strip() or "0") > 0
        except Exception:
            pass
    return False

def is_merged(url):
    """Return (merged, closed, detail). closed = terminal closed without merge."""
    url = normalize_pr_url(url)
    if not url:
        return False, False, "no-pr"
    m = re.match(r"lastgit://([^/]+)/cr/([^/\s?#]+)", url)
    if m:
        repo, cid = m.group(1), m.group(2)
        ok, out, _ = run(["lastgit", "cr", "view", repo, cid, "--json"], timeout=45)
        if not ok:
            res["flagged"].append(f"lastgit-fetch-failed:{repo}/{cid}")
            return False, False, "lastgit-fetch-failed"
        try:
            d = json.loads(strip(out))
        except Exception:
            return False, False, "lastgit-parse-failed"
        cr = d.get("cr") or d.get("change_request") or d
        state = str(cr.get("state") or cr.get("status") or d.get("state") or "").lower()
        merge_oid = cr.get("merge_oid") or cr.get("mergeOid") or d.get("merge_oid") or ""
        merged = state == "merged" or bool(merge_oid)
        closed = (not merged) and state in ("closed", "abandoned", "rejected")
        detail = f"lastgit:{cid}" if merged else f"lastgit:{cid}:{state or 'open'}"
        return merged, closed, detail
    m = re.search(r"/([^/]+)/([^/]+)/pulls?/(\d+)", url)
    if m and "github.com" not in url:
        owner, repo, num = m.group(1), m.group(2), m.group(3)
        if not forge_api.exists():
            res["flagged"].append("forge-api-missing")
            return False, False, "forge-api-missing"
        ok, out, _ = run([str(forge_api), f"repos/{owner}/{repo}/pulls/{num}"], timeout=45)
        if not ok:
            res["flagged"].append(f"forge-fetch-failed:{owner}/{repo}#{num}")
            return False, False, "forge-fetch-failed"
        try:
            d = json.loads(strip(out))
        except Exception:
            return False, False, "forge-parse-failed"
        state = str(d.get("state") or "").lower()
        merged = d.get("merged") is True or state == "merged"
        closed = (not merged) and state in ("closed", "rejected")
        detail = f"forge#{num}" if merged else f"forge#{num}:{state or 'open'}"
        return merged, closed, detail
    m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
    if m:
        owner, repo, num = m.group(1), m.group(2), m.group(3)
        ok, out, _ = run(["gh", "pr", "view", num, "-R", f"{owner}/{repo}", "--json", "state,mergedAt"], timeout=45)
        if not ok:
            res["flagged"].append(f"gh-fetch-failed:{owner}/{repo}#{num}")
            return False, False, "gh-fetch-failed"
        try:
            d = json.loads(strip(out))
        except Exception:
            return False, False, "gh-parse-failed"
        state = str(d.get("state") or "").upper()
        merged = bool(d.get("mergedAt")) or state == "MERGED"
        closed = (not merged) and state == "CLOSED"
        detail = f"gh#{num}" if merged else f"gh#{num}:{state or 'OPEN'}"
        return merged, closed, detail
    res["flagged"].append("pr-url-unparsed")
    return False, False, "unparsed"

def body_signals_closed_pr(card):
    body = body_of(card)
    if re.search(r"\bSTALE-PR\s*REAP\b", body, re.I):
        return True
    if re.search(r"\bSTALE_PR_REAP\b", body, re.I):
        return True
    if re.search(r"\breaper:\s*closed\b", body, re.I):
        return True
    if re.search(r"\bPR\s+(?:was\s+)?(?:closed|reaped)\b", body, re.I):
        return True
    return False

def repo_dirs_for(card, wt):
    dirs = []
    if wt and Path(wt).is_dir():
        dirs.append(Path(wt))
    repo = str(card.get("repo") or card.get("Repo") or "").strip()
    name = repo.split("/")[-1] if "/" in repo else repo
    if name:
        # Portal repos keep no checkout; their bare mirror still has both refs.
        dirs.append(home / ".cache" / "edgevector-git" / f"{name}.git")
        dirs.append(home / "code" / "edgevector" / name)
    return [d for d in dirs if d.exists()]

def resolve_ref(d, candidates):
    for ref in candidates:
        if not ref:
            continue
        ok, out, _ = run(
            ["git", "-C", str(d), "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
            timeout=15,
        )
        if ok and out.strip():
            return out.strip()
    return ""

def branch_merged_into_base(card, wt):
    """Is the card branch head already an ancestor of its base ref?

    A closed-not-merged review artifact is NOT proof the work is unshipped:
    `lastgit cr close` can race the auto-merger and rewrite a merged CR to
    state=closed with an empty merge_oid, and that corrupt record is durable.
    The git ref outranks the record when the two disagree.

    Returns True (proven ancestor), False (proven NOT an ancestor), or None
    when no checkout or no ref resolves. Never guess True — an unknown must
    keep the historical rollback behaviour.
    """
    branch = str(card.get("branch") or "").strip() or parse_body_header(body_of(card), "Branch")
    if not branch:
        return None
    base = (
        str(card.get("base") or card.get("Base") or "").strip()
        or parse_body_header(body_of(card), "Base")
        or "main"
    )
    for d in repo_dirs_for(card, wt):
        head = resolve_ref(d, [branch, f"origin/{branch}", f"refs/heads/{branch}"])
        if not head:
            continue
        base_oid = resolve_ref(d, [f"origin/{base}", base, f"refs/heads/{base}"])
        if not base_oid:
            continue
        try:
            pr = subprocess.run(
                ["git", "-C", str(d), "merge-base", "--is-ancestor", head, base_oid],
                capture_output=True,
                text=True,
                timeout=20,
            )
        except Exception:
            continue
        if pr.returncode == 0:
            return True
        if pr.returncode == 1:
            return False
        # Any other status is a git error, not an answer.
    return None

def is_closed_not_merged(merged, closed, detail, card):
    if merged:
        return False
    if closed:
        return True
    if re.search(r":(closed|abandoned|rejected)\b", str(detail or ""), re.I):
        return True
    if body_signals_closed_pr(card):
        return True
    return False

def clear_pr_url(slug):
    if dry_run:
        return
    run([board_cli, "add", slug, "--pr-url", ""], timeout=30)

def close_card(slug, url, branch):
    if dry_run:
        res["closed"].append(slug)
        return True
    reclaim_bin = last_stack / "bin" / "last-stack-worktree-reclaim"
    if closeout_bin.exists():
        args = [str(closeout_bin), slug, "--board-cli", board_cli]
        if url:
            args += ["--pr-url", url]
        if branch:
            args += ["--branch", branch]
        ok, out, err = run(args, timeout=90)
        if not ok:
            if note_closeout_deferred(slug, out, err):
                return False
            res["flagged"].append(f"close-failed:{slug}")
            note_close_failure(slug, out, err)
            return False
        res["closed"].append(slug)
        clear_close_failure(slug)
        # Idempotent: reclaim again if closeout is an older binary without it
        if reclaim_bin.exists():
            run([str(reclaim_bin), "--slug", slug], timeout=120)
        return True
    ok, out, err = run([board_cli, "move", slug, "done", "--force"], timeout=60)
    if not ok:
        if note_closeout_deferred(slug, out, err):
            return False
        res["flagged"].append(f"close-failed:{slug}")
        note_close_failure(slug, out, err)
        return False
    res["closed"].append(slug)
    clear_close_failure(slug)
    if reclaim_bin.exists():
        run([str(reclaim_bin), "--slug", slug], timeout=120)
    return True

def rollback(slug):
    if dry_run:
        res["rolled_back"].append(slug)
        return True
    ok, _, _ = run([board_cli, "move", slug, "todo", "--force"], timeout=60)
    if not ok:
        ok, _, _ = run([board_cli, "move", slug, "todo"], timeout=60)
        if not ok:
            res["flagged"].append(f"rollback-failed:{slug}")
            return False
    run([board_cli, "add", slug, "--assignee", ""], timeout=30)
    res["rolled_back"].append(slug)
    return True

def demote_deploy_parked(slug, card):
    """Deploy/live-proof waits are a human/validate gate, not factory WIP."""
    ensure_awaiting_deploy_tag(slug, card)
    if dry_run:
        res["demoted"].append(slug)
        res["flagged"].append(f"deploy-parked:{slug}")
        res["flagged"].append(f"deploy-parked-demoted:{slug}")
        return True
    reason = "deploy-parked: awaiting deploy/safe-upgrade/live-proof; not factory WIP"
    run(
        [board_cli, "set", slug, "--block-status", "deferred", "--block-reason", reason],
        timeout=45,
    )
    run(
        [
            board_cli,
            "mark",
            slug,
            f"PARKED: {iso} — closeout demoted deploy/live-proof wait from doing to backlog (WIP accounting). Deploy/safe-upgrade remains a human gate.",
        ],
        timeout=45,
    )
    ok, _, _ = run([board_cli, "move", slug, "backlog", "--force"], timeout=60)
    if not ok:
        ok, _, _ = run([board_cli, "move", slug, "backlog"], timeout=60)
        if not ok:
            res["flagged"].append(f"demote-failed:{slug}")
            return False
    run([board_cli, "add", slug, "--assignee", ""], timeout=30)
    clear_close_failure(slug)
    res["demoted"].append(slug)
    res["flagged"].append(f"deploy-parked:{slug}")
    res["flagged"].append(f"deploy-parked-demoted:{slug}")
    return True

cards = list_doing()
if cards is None:
    # Board unreadable: emit and leave every streak untouched.
    write_fail_state()
    st = res["status"]
    flags = ",".join(res["flagged"]) if res["flagged"] else "none"
    print(f"board-closeout {iso} {st} closed=0 rolled_back=0 skipped=0 flagged={flags}")
    sys.exit(0)
seen_doing_slugs = {str(c.get("slug") or "") for c in cards}

actions = 0
grace_s = grace_min * 60
max_park_s = max_park_hours * 3600

def park_expired(age, wt):
    """A park delays reclaim; it must not become a permanent exemption."""
    if age < max_park_s:
        return False
    return not live_worker(wt)

for card in cards:
    if actions >= max_actions:
        res["flagged"].append(f"action-capped:{len(cards) - actions}")
        break
    slug = str(card.get("slug") or "")
    if not slug:
        continue
    field_pr = (card.get("pr_url") or card.get("prUrl") or card.get("pr") or "").strip()
    url = pr_url(card)
    branch = str(card.get("branch") or "").strip() or parse_body_header(body_of(card), "Branch")
    age = age_s(card)
    wt = worktree(slug)
    deploy_parked = is_deploy_parked(card)
    if url and field_pr != url:
        heal_pr_url(slug, url)
        res["flagged"].append(f"pr-url-healed:{slug}")
    if url:
        merged, closed, detail = is_merged(url)
        if merged:
            if close_card(slug, url, branch):
                actions += 1
            else:
                parked_close = deploy_parked or bool(
                    re.search(r"deploy", str(detail or ""), re.I)
                )
                if slug not in closeout_deferred and parked_close:
                    if demote_deploy_parked(slug, card):
                        actions += 1
                        continue
                res["skipped"].append(f"{slug}:close-failed")
                if parked_close:
                    ensure_awaiting_deploy_tag(slug, card)
                    res["flagged"].append(f"deploy-parked:{slug}")
                if (
                    slug not in closeout_deferred
                    and not parked_close
                    and park_expired(age, wt)
                ):
                    res["flagged"].append(f"park-expired:{slug}")
                    if rollback(slug):
                        actions += 1
            continue
        # Closed/reaped (not merged) → todo so pickup can reopen (keep worktree).
        if is_closed_not_merged(merged, closed, detail, card):
            # The record says closed; the git ref decides. A branch already
            # merged into base is shipped work — closing it here stops pickup
            # from re-manufacturing it as ready work on the next fire.
            proof = branch_merged_into_base(card, wt)
            if proof is True:
                res["flagged"].append(f"merge-proof-close:{slug}")
                # Keep the structured pr_url empty: the stored CR record is
                # corrupt, so restamping it would re-arm this same loop.
                clear_pr_url(slug)
                if close_card(slug, "", branch):
                    actions += 1
                else:
                    res["skipped"].append(f"{slug}:merge-proof-close-failed")
                continue
            res["flagged"].append(f"closed-pr:{slug}:{detail or 'body-reap'}")
            if proof is None:
                res["flagged"].append(f"merge-proof-unknown:{slug}")
            clear_pr_url(slug)
            if rollback(slug):
                actions += 1
            else:
                res["skipped"].append(f"{slug}:closed-pr-rollback-failed")
            continue
        res["skipped"].append(f"{slug}:pr-open-or-unknown")
        continue
    if deploy_parked:
        if demote_deploy_parked(slug, card):
            actions += 1
            continue
        ensure_awaiting_deploy_tag(slug, card)
        res["skipped"].append(f"{slug}:deploy-parked")
        res["flagged"].append(f"deploy-parked:{slug}")
        continue
    if skip_zombie:
        res["skipped"].append(f"{slug}:no-pr-zombie-skipped")
        continue
    if age < grace_s:
        res["skipped"].append(f"{slug}:young")
        continue
    if live_worker(wt):
        res["skipped"].append(f"{slug}:live-worker")
        continue
    # STALE-PR REAP body annotation with no parseable URL is the same class:
    # the reaped record must not outrank a branch that already reached base.
    if body_signals_closed_pr(card):
        reap_proof = branch_merged_into_base(card, wt)
        if reap_proof is True:
            res["flagged"].append(f"merge-proof-close:{slug}")
            if close_card(slug, "", branch):
                actions += 1
                continue
            res["skipped"].append(f"{slug}:merge-proof-close-failed")
            continue
        if reap_proof is None:
            res["flagged"].append(f"merge-proof-unknown:{slug}")

    if has_commits(wt):
        # Pickup contract: no PR after grace → todo (worktree kept).
        res["flagged"].append(f"wip-no-pr:{slug}")
        if rollback(slug):
            actions += 1
            continue
        res["skipped"].append(f"{slug}:wip-no-pr-rollback-failed")
        continue
    if rollback(slug):
        actions += 1

closed = len(res["closed"])
rolled = len(res["rolled_back"])
demoted = len(res["demoted"])
# A card that left `doing` is no longer failing to close — drop its streak.
if seen_doing_slugs is not None:
    for slug in list(fail_state.keys()):
        if slug not in seen_doing_slugs:
            fail_state.pop(slug, None)
write_fail_state()

skipped = len(res["skipped"])
flags = ",".join(res["flagged"]) if res["flagged"] else "none"
st = res["status"]
if st == "noop" and (closed > 0 or rolled > 0 or demoted > 0):
    st = "ok"
elif st == "ok" and closed == 0 and rolled == 0 and demoted == 0:
    st = "noop"
line = f"board-closeout {iso} {st} closed={closed}"
if closed:
    line += f" closed_slugs={','.join(res['closed'])}"
line += f" rolled_back={rolled}"
if rolled:
    line += f" rolled_slugs={','.join(res['rolled_back'])}"
line += f" demoted={demoted}"
if demoted:
    line += f" demoted_slugs={','.join(res['demoted'])}"
line += f" skipped={skipped} flagged={flags}"
payload = {
    "kind": "board-closeout",
    "status": st,
    "iso": iso,
    "closed": closed,
    "rolled_back": rolled,
    "demoted": demoted,
    "skipped": skipped,
    "flagged": res["flagged"],
}
print(json.dumps(payload, separators=(",", ":")), flush=True)
print(line, flush=True)
if json_out:
    print(json.dumps({**res, "status": st, "iso": iso}, indent=2), flush=True)
hb = last_stack / "bin" / "last-stack-brain-append-heartbeat"
if not dry_run and hb.exists():
    run([str(hb), "--line", line], timeout=30)
sys.exit(0)
