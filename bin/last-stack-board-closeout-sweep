#!/usr/bin/env bash
# Deterministic board closeout — no LLM.
#
# Closes the gap where pickup hands off in-flight PRs into `doing`, then
# kanban-watch / card-reaper are paused (e.g. low-credit) and merged work
# sits for hours.
#
# Actions (CHEAP, uncapped within --max-actions):
#   1. doing + pr_url (field or body PR:/CR:/lastgit://) whose PR/CR is MERGED
#      → last-stack-card-closeout (done; honors Requires-Deploy)
#   2. doing + pr_url whose PR/CR is CLOSED (not merged), or body has a
#      STALE-PR REAP / reaper closed annotation → todo (flag closed-pr;
#      clear structured pr_url; keep worktree/branch so pickup can reopen).
#      FIRST the git ref decides: `lastgit cr close` can race the auto-merger
#      and rewrite a merged CR to state=closed with an empty merge_oid, and
#      that corrupt record is durable. When the card branch head is already an
#      ancestor of its base ref, the card closes to `done` instead
#      (flag merge-proof-close) and the corrupt pr_url stays cleared. An
#      unresolvable branch or base ref is `unknown`, keeps the rollback, and
#      flags merge-proof-unknown so an operator can see why.
#   3. empty/no-PR doing, age ≥ grace, no live worker, no branch commits → todo
#   4. WIP commits + no PR after grace → todo (flag wip-no-pr; worktree kept)
#   5. deploy-parked doing cards (Requires-Deploy:, tags awaiting-deploy /
#      live-proof / deploy-gate / needs-safe-upgrade / awaiting-validation, or
#      live-proof wait notes) → backlog + block_status=deferred (flag
#      deploy-parked-demoted). They must not inflate factory doing_stuck_hard.
#      Open in-flight PR/CR cards are NOT demoted.
#   6. park expiry: a NON-deploy close-failed park older than
#      --max-park-hours with no live worker → todo (flag park-expired), so a
#      parked card can never sit in `doing` forever with nobody driving it.
#   7. repeated-failure escalation: a slug whose closeout fails for a
#      NON-transient reason on --escalate-after consecutive passes (default 3)
#      is stamped once on the board (CLOSE-FAILED-REPEATED, with the last
#      failure text) and flagged close-failed-escalated:<slug>. A closeout that
#      can never succeed otherwise repeats in silence — on 2026-08-08 one did,
#      every few minutes for 10h, on a card that was already merged AND
#      deployed. Streak state:
#      ~/.local/state/last-stack/board-closeout/close-failures.json
#      (BOARD_CLOSEOUT_STATE_DIR overrides). Leaving `doing` clears the streak;
#      a transient board failure never counts toward it.
#
# Protections (do NOT reclaim to todo):
#   - open / unknown PR on structured pr_url or body header
#     (closed-not-merged is NOT protected — see action 2)
#   - live agent process in the card worktree
#   - younger than --grace-min (default 60)
# Deploy-gated parks are demoted to backlog (action 5), not left in doing.
#
# On heal: empty pr_url + body PR/CR → best-effort
#   `<board> add <slug> --pr-url <url>` so later soft reclaim skips the card.
#
# Usage:
#   last-stack-board-closeout-sweep [--dry-run] [--grace-min 60] [--max-actions 50]
#                                   [--board-cli kanban|fkanban] [--skip-zombie]
#                                   [--max-park-hours 24] [--escalate-after 3]
#
# Env:
#   BOARD_CLOSEOUT_ENGINE=node|python3|auto  pin one engine (default auto:
#     node when present, else python3). An unknown value exits 2 rather than
#     silently picking one. Tests use it to prove both engines agree.
#   BOARD_CLOSEOUT_STATE_DIR                 override the streak state dir.
#
# Exit 0 always after a completed pass (including noop). Exit 2 on usage error.
# Prints one compact JSON object, then a heartbeat line (heartbeat is last):
#   {"kind":"board-closeout","status":"noop",...}
#   board-closeout <ISO> ok|noop closed=<n> rolled_back=<n> demoted=<n> skipped=<n> flagged=...
# Never exec the engine: a chained/sourced caller must survive this helper.
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
last_stack="$(cd "$self_dir/.." && pwd -P)"
if [ -f "$last_stack/bin/last-stack-shell-prelude" ]; then
  # shellcheck disable=SC1091
  . "$last_stack/bin/last-stack-shell-prelude"
fi

dry_run=0
grace_min=60
max_actions=50
max_park_hours=24
escalate_after=3
board_cli=""
skip_zombie=0
json_out=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    --grace-min) grace_min="${2:-}"; shift 2 ;;
    --grace-min=*) grace_min="${1#*=}"; shift ;;
    --max-actions) max_actions="${2:-}"; shift 2 ;;
    --max-actions=*) max_actions="${1#*=}"; shift ;;
    --max-park-hours) max_park_hours="${2:-}"; shift 2 ;;
    --max-park-hours=*) max_park_hours="${1#*=}"; shift ;;
    --escalate-after) escalate_after="${2:-}"; shift 2 ;;
    --escalate-after=*) escalate_after="${1#*=}"; shift ;;
    --board-cli) board_cli="${2:-}"; shift 2 ;;
    --board-cli=*) board_cli="${1#*=}"; shift ;;
    --skip-zombie) skip_zombie=1; shift ;;
    --json) json_out=1; shift ;;
    -h|--help)
      # Print the leading comment block; no brittle line-number range.
      awk 'NR==1 {next} /^#/ {print; next} {exit}' "$0"
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [ -z "$board_cli" ]; then
  if command -v kanban >/dev/null 2>&1; then board_cli=kanban
  else
    echo "board-closeout: need kanban on PATH" >&2
    exit 2
  fi
fi

export BOARD_CLI="$board_cli"
export LAST_STACK_ROOT="$last_stack"
export BOARD_CLOSEOUT_DRY_RUN="$dry_run"
export BOARD_CLOSEOUT_GRACE_MIN="$grace_min"
export BOARD_CLOSEOUT_MAX_ACTIONS="$max_actions"
export BOARD_CLOSEOUT_MAX_PARK_HOURS="$max_park_hours"
export BOARD_CLOSEOUT_ESCALATE_AFTER="$escalate_after"
export BOARD_CLOSEOUT_SKIP_ZOMBIE="$skip_zombie"
export BOARD_CLOSEOUT_JSON="$json_out"
export PATH="$last_stack/bin:${PATH:-}"

# Prefer node (matches card-reaper); fall back to python3.
# Do NOT exec: merge-babysit / card-reaper chain this helper then keep running.
_engine_out="$(mktemp "${TMPDIR:-/tmp}/board-closeout.out.XXXXXX")"
_engine_err="$(mktemp "${TMPDIR:-/tmp}/board-closeout.err.XXXXXX")"
_emit_closeout_result() {
  if grep -q '^board-closeout ' "$_engine_out" 2>/dev/null; then
    cat "$_engine_out"
    cat "$_engine_err" >&2 || true
  else
    cat "$_engine_out"
    cat "$_engine_err" >&2 || true
    _iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '%s\n' "{\"kind\":\"board-closeout\",\"status\":\"error\",\"iso\":\"$_iso\",\"closed\":0,\"rolled_back\":0,\"demoted\":0,\"skipped\":0,\"flagged\":[\"engine-silent\"]}"
    printf 'board-closeout %s error closed=0 rolled_back=0 demoted=0 skipped=0 flagged=engine-silent\n' "$_iso"
  fi
  rm -f "$_engine_out" "$_engine_err"
}

# BOARD_CLOSEOUT_ENGINE pins one engine so a test can prove both behave the
# same. Unset/auto keeps the historical preference (node, then python3).
_engine_pref="${BOARD_CLOSEOUT_ENGINE:-auto}"
case "$_engine_pref" in
  node|python3|python|auto) : ;;
  *)
    echo "board-closeout: BOARD_CLOSEOUT_ENGINE must be node|python3|auto (got '$_engine_pref')" >&2
    exit 2
    ;;
esac
if [ "$_engine_pref" = "node" ] && ! command -v node >/dev/null 2>&1; then
  echo "board-closeout: BOARD_CLOSEOUT_ENGINE=node but node is not on PATH" >&2
  exit 2
fi

if [ "$_engine_pref" != "python3" ] && [ "$_engine_pref" != "python" ] && command -v node >/dev/null 2>&1; then
  node - "$last_stack" >"$_engine_out" 2>"$_engine_err" <<'NODE' || true
const fs = require("fs");
const path = require("path");
const cp = require("child_process");
const os = require("os");

const lastStack = process.argv[2];
const boardCli = process.env.BOARD_CLI || "kanban";
const dryRun = process.env.BOARD_CLOSEOUT_DRY_RUN === "1";
const graceMin = Math.max(1, parseInt(process.env.BOARD_CLOSEOUT_GRACE_MIN || "60", 10) || 60);
const maxActions = Math.max(1, parseInt(process.env.BOARD_CLOSEOUT_MAX_ACTIONS || "50", 10) || 50);
const maxParkHours = Math.max(1, parseInt(process.env.BOARD_CLOSEOUT_MAX_PARK_HOURS || "24", 10) || 24);
const skipZombie = process.env.BOARD_CLOSEOUT_SKIP_ZOMBIE === "1";
const jsonOut = process.env.BOARD_CLOSEOUT_JSON === "1";
const nowMs = Date.now();
const iso = new Date(nowMs).toISOString().replace(/\.\d{3}Z$/, "Z");
const home = process.env.HOME || os.homedir();
const worktreeRoots = [
  path.join(home, ".kanban", "worktrees"),
  path.join(home, ".fkanban", "worktrees"),
];
const forgeApi = path.join(lastStack, "bin", "last-stack-forge-api");
const closeoutBin = path.join(lastStack, "bin", "last-stack-card-closeout");
const forgeJsonJq = path.join(lastStack, "bin", "last-stack-forge-json-jq");

const res = {
  status: "ok",
  closed: [],
  rolled_back: [],
  demoted: [],
  skipped: [],
  flagged: [],
};

function run(cmd, args, opts = {}) {
  const out = cp.spawnSync(cmd, args, {
    encoding: "utf8",
    timeout: opts.timeout || 60000,
    env: process.env,
    maxBuffer: 20 * 1024 * 1024,
  });
  return {
    ok: out.status === 0,
    status: out.status,
    stdout: out.stdout || "",
    stderr: out.stderr || "",
    error: out.error ? String(out.error.message || out.error) : "",
  };
}

function isTransientBoardFailure(text) {
  return /service_timeout|node did not respond|too many concurrent reads|uds_connection_limit|lastdb-sync-outbox-full|max_outbox_entries|folddb\.sock|socket hang up|ECONNRESET|ETIMEDOUT/i
    .test(String(text || ""));
}

// Slugs whose closeout failed on a transient board/service condition this pass.
// The board itself was unreachable — that is not evidence the CARD is stuck, so
// park expiry must not reclaim them (the reclaim would use the same sick CLI).
const closeoutDeferred = new Set();

function noteCloseoutDeferred(slug, out) {
  const detail = `${out?.stderr || ""} ${out?.error || ""} ${out?.stdout || ""}`;
  if (!isTransientBoardFailure(detail)) return false;
  closeoutDeferred.add(slug);
  res.skipped.push(`${slug}:closeout-transient`);
  res.flagged.push(`closeout-deferred:${slug}`);
  if (res.status === "ok") res.status = "noop";
  return true;
}

// Consecutive non-transient closeout failures, per slug, across passes.
//
// A closeout that can never succeed used to repeat forever in silence: on
// 2026-08-08 a merged+deployed fold card was flagged close-failed on EVERY pass
// for 10h (an unsatisfiable Requires-Deploy gate) and nothing said so anywhere
// a human looks. Repetition is the signal — after --escalate-after passes the
// slug is stamped on the board once and flagged distinctly in the heartbeat.
// Transient board failures never count; the board being sick is not evidence
// that the CARD is stuck.
const failStateDir =
  process.env.BOARD_CLOSEOUT_STATE_DIR ||
  path.join(home, ".local", "state", "last-stack", "board-closeout");
const failStatePath = path.join(failStateDir, "close-failures.json");
const escalateAfter = Math.max(
  1,
  parseInt(process.env.BOARD_CLOSEOUT_ESCALATE_AFTER || "3", 10) || 3,
);

function readFailState() {
  try {
    const raw = JSON.parse(fs.readFileSync(failStatePath, "utf8"));
    return raw && typeof raw === "object" ? raw : {};
  } catch {
    return {};
  }
}

function writeFailState(state) {
  if (dryRun) return;
  try {
    fs.mkdirSync(failStateDir, { recursive: true });
    fs.writeFileSync(failStatePath, `${JSON.stringify(state, null, 2)}\n`);
  } catch {
    /* best-effort: never fail a sweep on its own bookkeeping */
  }
}

const failState = readFailState();

function failureDetail(out) {
  const text = `${out?.stderr || ""} ${out?.stdout || ""} ${out?.error || ""}`;
  const lines = text
    .split("\n")
    .map((l) => l.trim())
    .filter(Boolean);
  return (lines[lines.length - 1] || "closeout failed").slice(0, 220);
}

function noteCloseFailure(slug, out) {
  const prev = failState[slug] || { count: 0, first_at: iso, escalated: false };
  const entry = {
    count: (prev.count || 0) + 1,
    first_at: prev.first_at || iso,
    last_at: iso,
    last_reason: failureDetail(out),
    escalated: Boolean(prev.escalated),
  };
  failState[slug] = entry;
  if (entry.count < escalateAfter || entry.escalated) return;
  entry.escalated = true;
  res.flagged.push(`close-failed-escalated:${slug}`);
  if (dryRun) return;
  // Stamp the board so the jam is visible where the work lives, not only in a
  // heartbeat line nobody reads. Best-effort — never fail the sweep on it.
  run(
    boardCli,
    [
      "mark",
      slug,
      `CLOSE-FAILED-REPEATED ${iso} — last-stack-board-closeout-sweep could not close this card on ${entry.count} consecutive passes (since ${entry.first_at}). Last failure: ${entry.last_reason}. The closeout is refusing for the same reason every time; this needs a human or a fix to the gate, not more passes.`,
    ],
    { timeout: 60000 },
  );
}

function clearCloseFailure(slug) {
  if (failState[slug]) delete failState[slug];
}

// Slugs seen in `doing` this pass — null until the board actually answered, so
// a busy node never prunes the streaks it could not observe.
let seenDoingSlugs = null;

function stripControls(s) {
  return String(s || "").replace(/[\x00-\x08\x0b\x0c\x0e-\x1f]/g, " ");
}

function parseJsonLoose(raw) {
  try {
    return JSON.parse(stripControls(raw));
  } catch {
    return null;
  }
}

function listDoing() {
  // Prefer --all --full-body: bare list returns empty body previews, which
  // hides PR: / Requires-Deploy: headers needed for heal + deploy-park.
  let out = run(
    boardCli,
    ["list", "--column", "doing", "--json", "--all", "--full-body"],
    { timeout: 180000 },
  );
  if (!out.ok) {
    out = run(boardCli, ["list", "--column", "doing", "--json", "--all"], { timeout: 120000 });
  }
  if (!out.ok) {
    out = run(boardCli, ["list", "--column", "doing", "--json"], { timeout: 120000 });
  }
  if (!out.ok) {
    const err = `${out.stderr} ${out.error}`;
    if (/service_timeout|node did not respond|too many concurrent reads|folddb\.sock/i.test(err)) {
      res.status = "noop";
      res.flagged.push("busy-node");
      return null;
    }
    res.status = "error";
    res.flagged.push("board-list-failed");
    return null;
  }
  const data = parseJsonLoose(out.stdout);
  if (!data) {
    res.status = "error";
    res.flagged.push("board-json-parse-failed");
    return null;
  }
  if (Array.isArray(data)) return data;
  if (Array.isArray(data.cards)) return data.cards;
  if (Array.isArray(data.items)) return data.items;
  return [];
}

function ageMs(card) {
  // Prefer position as doing-since epoch-ms (fkanban sets on column enter).
  const pos = Number(card.position);
  if (Number.isFinite(pos) && pos > 1e12) return nowMs - pos;
  if (Number.isFinite(pos) && pos > 1e9) return nowMs - pos * 1000;
  const updated = Date.parse(card.updated_at || card.updatedAt || "");
  if (Number.isFinite(updated)) return nowMs - updated;
  const created = Date.parse(card.created_at || card.createdAt || "");
  if (Number.isFinite(created)) return nowMs - created;
  return 0;
}

function bodyOf(card) {
  return String(card.body || card.Body || "");
}

function parseBodyHeader(body, name) {
  const re = new RegExp(`^[ \\t]*${name}:[ \\t]*(.*)$`, "i");
  let inFence = false;
  for (const line of String(body || "").split("\n")) {
    if (/^[ \t]*```/.test(line)) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    const m = line.match(re);
    if (m) {
      const raw = String(m[1] || "")
        .split("#")[0]
        .trim()
        .split(/\s+/)[0];
      return raw || "";
    }
  }
  return "";
}

function extractPrUrlFromBody(body, repo) {
  for (const name of ["PR", "CR"]) {
    const raw = parseBodyHeader(body, name);
    if (!raw) continue;
    const normalized = normalizePrUrl(raw);
    if (/^(https?:\/\/|lastgit:\/\/)/i.test(normalized)) return normalized;
    const cr = raw.match(/\b(cr-[A-Za-z0-9_-]+)\b/);
    if (cr) {
      const r = String(repo || "").trim();
      const slug = r.includes("/") ? r.split("/").pop() : r;
      if (slug) return `lastgit://${slug}/cr/${cr[1]}`;
      return cr[1];
    }
    if (/pulls?\/\d+/i.test(raw) || /\/pull\/\d+/i.test(raw)) return raw;
  }
  let inFence = false;
  for (const line of String(body || "").split("\n")) {
    if (/^[ \t]*```/.test(line)) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    const m = line.match(/\blastgit:\/\/[^\s)>\]]+/i);
    if (m) return normalizePrUrl(m[0]);
  }
  return "";
}

function normalizePrUrl(raw) {
  let url = String(raw || "").trim();
  if (!url) return "";
  url = url.replace(/^[`<]+/, "");
  while (/[`)\]}>.,;]+$/.test(url)) {
    url = url.replace(/[`)\]}>.,;]+$/, "");
  }
  return url.trim();
}

function prUrlOf(card) {
  const field = normalizePrUrl(card.pr_url || card.prUrl || card.pr || "");
  if (field) return field;
  return extractPrUrlFromBody(bodyOf(card), card.repo || card.Repo || "");
}

function healPrUrl(slug, url) {
  if (!url || dryRun) return;
  // Best-effort structured stamp so soft reclaim + watch skip this card later.
  run(boardCli, ["add", slug, "--pr-url", url], { timeout: 45000 });
}

function tagList(card) {
  const t = card.tags || card.Tags || [];
  if (Array.isArray(t)) return t.map((x) => String(x).toLowerCase());
  return String(t)
    .split(/[,\s]+/)
    .map((x) => x.trim().toLowerCase())
    .filter(Boolean);
}

/** Deploy-gated / live-proof / safe-upgrade park: demote out of doing. */
function isDeployParked(card) {
  const tags = tagList(card);
  if (
    tags.some((t) =>
      [
        "awaiting-deploy",
        "live-proof",
        "deploy-gate",
        "needs-safe-upgrade",
        "awaiting-validation",
      ].includes(t),
    )
  ) {
    return true;
  }
  const body = bodyOf(card);
  if (parseBodyHeader(body, "Requires-Deploy")) return true;
  if (/^Requires-Deploy:/im.test(body)) return true;
  // Live-proof wait notes written by pickup without the structured header.
  if (/\b(LIVE PROOF|deploy-pipeline proof|awaiting deploy)\b/i.test(body) &&
      /\b(pending|do not mark done|returning the card|leave(?:ing)? this card)\b/i.test(body)) {
    return true;
  }
  return false;
}

function ensureAwaitingDeployTag(slug, card) {
  if (dryRun) return;
  const tags = tagList(card);
  if (tags.includes("awaiting-deploy")) return;
  run(boardCli, ["tag", "add", slug, "awaiting-deploy"], { timeout: 30000 });
}

function worktreeFor(slug) {
  for (const root of worktreeRoots) {
    const p = path.join(root, slug);
    if (fs.existsSync(p)) return p;
  }
  return "";
}

function hasLiveWorker(wt) {
  if (!wt || !fs.existsSync(wt)) return false;
  // Prefer pgrep on path; lsof +D is slow and noisy.
  const out = run("ps", ["-ax", "-o", "command="], { timeout: 15000 });
  if (!out.ok) return false;
  const needle = wt;
  return out.stdout.split("\n").some((line) => line.includes(needle) && !/\b(rg|grep)\b/.test(line));
}

function branchHasCommits(card, wt) {
  const branch = String(card.branch || "").trim();
  const cwd = wt && fs.existsSync(wt) ? wt : "";
  if (!cwd) return Boolean(branch); // unknown: treat as possible WIP if branch named
  const out = run("git", ["-C", cwd, "rev-list", "--count", "HEAD", "--not", "origin/main", "main", "origin/master", "master"], { timeout: 30000 });
  // Fallback: commits not on remote tracking if that failed
  if (!out.ok) {
    const o2 = run("git", ["-C", cwd, "log", "--oneline", "-1"], { timeout: 15000 });
    return o2.ok && o2.stdout.trim().length > 0 && Boolean(branch);
  }
  // rev-list with multiple --not bases may error; try simpler
  const simple = run("git", ["-C", cwd, "rev-list", "--count", "origin/main..HEAD"], { timeout: 30000 });
  if (simple.ok) {
    const n = parseInt(simple.stdout.trim(), 10);
    return Number.isFinite(n) && n > 0;
  }
  const simple2 = run("git", ["-C", cwd, "rev-list", "--count", "main..HEAD"], { timeout: 30000 });
  if (simple2.ok) {
    const n = parseInt(simple2.stdout.trim(), 10);
    return Number.isFinite(n) && n > 0;
  }
  return Boolean(branch);
}

function classifyPr(url) {
  url = normalizePrUrl(url);
  if (!url) return { kind: "none" };
  // lastgit://repo/cr/cr-id or lastgit://repo/cr/cr-id
  let m = url.match(/^lastgit:\/\/([^/]+)\/cr\/([^/\s?#]+)/i);
  if (m) return { kind: "lastgit", repo: m[1], id: m[2] };
  // Forgejo / Gitea: .../Owner/Repo/pulls/N
  m = url.match(/\/([^/]+)\/([^/]+)\/pulls?\/(\d+)/i);
  if (m) {
    // If host looks like github.com, use gh path
    if (/github\.com/i.test(url)) {
      return { kind: "github", owner: m[1], repo: m[2], number: m[3] };
    }
    return { kind: "forge", owner: m[1], repo: m[2], number: m[3] };
  }
  // github.com/owner/repo/pull/N
  m = url.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/i);
  if (m) return { kind: "github", owner: m[1], repo: m[2], number: m[3] };
  return { kind: "unknown", url };
}

function isMerged(pr) {
  // Returns { merged, closed, detail }. closed = terminal closed/abandoned
  // without merge (Forgejo/GitHub closed, LastGit closed/abandoned/rejected).
  if (pr.kind === "none") return { merged: false, closed: false, detail: "no-pr" };
  if (pr.kind === "forge") {
    if (!fs.existsSync(forgeApi)) {
      res.flagged.push("forge-api-missing");
      return { merged: false, closed: false, detail: "forge-api-missing" };
    }
    const apiPath = `repos/${pr.owner}/${pr.repo}/pulls/${pr.number}`;
    const out = run(forgeApi, [apiPath], { timeout: 45000 });
    if (!out.ok) {
      res.flagged.push(`forge-fetch-failed:${pr.owner}/${pr.repo}#${pr.number}`);
      return { merged: false, closed: false, detail: "forge-fetch-failed" };
    }
    const d = parseJsonLoose(out.stdout);
    if (!d) return { merged: false, closed: false, detail: "forge-parse-failed" };
    const state = String(d.state || "").toLowerCase();
    const merged = d.merged === true || state === "merged";
    // closed without merged = not our done path — reclaim to todo (reaper path)
    const closed = !merged && (state === "closed" || state === "rejected");
    return {
      merged,
      closed,
      detail: merged ? `forge#${pr.number}` : `forge#${pr.number}:${state || "open"}`,
    };
  }
  if (pr.kind === "lastgit") {
    const out = run("lastgit", ["cr", "view", pr.repo, pr.id, "--json"], { timeout: 45000 });
    if (!out.ok) {
      res.flagged.push(`lastgit-fetch-failed:${pr.repo}/${pr.id}`);
      return { merged: false, closed: false, detail: "lastgit-fetch-failed" };
    }
    const d = parseJsonLoose(out.stdout);
    if (!d) return { merged: false, closed: false, detail: "lastgit-parse-failed" };
    const cr = d.cr || d.change_request || d;
    const state = String(cr.state || cr.status || d.state || "").toLowerCase();
    const mergeOid = cr.merge_oid || cr.mergeOid || d.merge_oid || "";
    const merged = state === "merged" || Boolean(mergeOid);
    const closed =
      !merged && (state === "closed" || state === "abandoned" || state === "rejected");
    return {
      merged,
      closed,
      detail: merged ? `lastgit:${pr.id}` : `lastgit:${pr.id}:${state || "open"}`,
    };
  }
  if (pr.kind === "github") {
    const out = run("gh", ["pr", "view", pr.number, "-R", `${pr.owner}/${pr.repo}`, "--json", "state,mergedAt"], { timeout: 45000 });
    if (!out.ok) {
      res.flagged.push(`gh-fetch-failed:${pr.owner}/${pr.repo}#${pr.number}`);
      return { merged: false, closed: false, detail: "gh-fetch-failed" };
    }
    const d = parseJsonLoose(out.stdout);
    if (!d) return { merged: false, closed: false, detail: "gh-parse-failed" };
    const state = String(d.state || "").toUpperCase();
    const merged = Boolean(d.mergedAt) || state === "MERGED";
    const closed = !merged && state === "CLOSED";
    return {
      merged,
      closed,
      detail: merged ? `gh#${pr.number}` : `gh#${pr.number}:${state || "OPEN"}`,
    };
  }
  res.flagged.push("pr-url-unparsed");
  return { merged: false, closed: false, detail: "unparsed" };
}

/** Body annotations left by card-reaper / STALE-PR REAP when forge closed a PR. */
function bodySignalsClosedPr(card) {
  const body = bodyOf(card);
  if (/\bSTALE-PR\s*REAP\b/i.test(body)) return true;
  if (/\bSTALE_PR_REAP\b/i.test(body)) return true;
  if (/\breaper:\s*closed\b/i.test(body)) return true;
  if (/\bPR\s+(?:was\s+)?(?:closed|reaped)\b/i.test(body)) return true;
  return false;
}

/**
 * Is the card branch head already an ancestor of its base ref?
 *
 * A closed-not-merged review artifact is NOT proof the work is unshipped:
 * `lastgit cr close` can race the auto-merger and rewrite a merged CR to
 * state=closed with an empty merge_oid, and that corrupt record is durable.
 * The git ref outranks the record when the two disagree.
 *
 * Returns true (proven ancestor), false (proven NOT an ancestor), or
 * "unknown" when no checkout or no ref resolves. Never guess true — an
 * unknown must keep the historical rollback behaviour.
 */
function repoDirsFor(card, wt) {
  const dirs = [];
  if (wt && fs.existsSync(wt)) dirs.push(wt);
  const repo = String(card.repo || card.Repo || "").trim();
  const name = repo.includes("/") ? repo.split("/").pop() : repo;
  if (name) {
    // Portal repos keep no checkout; their bare mirror still has both refs.
    dirs.push(path.join(os.homedir(), ".cache", "edgevector-git", `${name}.git`));
    dirs.push(path.join(os.homedir(), "code", "edgevector", name));
  }
  return dirs.filter((d) => d && fs.existsSync(d));
}

function resolveRef(dir, candidates) {
  for (const ref of candidates) {
    if (!ref) continue;
    const out = run("git", ["-C", dir, "rev-parse", "--verify", "--quiet", `${ref}^{commit}`], { timeout: 15000 });
    if (out.ok && out.stdout.trim()) return out.stdout.trim();
  }
  return "";
}

function branchMergedIntoBase(card, wt) {
  const branch =
    String(card.branch || "").trim() || parseBodyHeader(bodyOf(card), "Branch");
  if (!branch) return "unknown";
  const base =
    String(card.base || card.Base || "").trim() ||
    parseBodyHeader(bodyOf(card), "Base") ||
    "main";
  for (const dir of repoDirsFor(card, wt)) {
    const head = resolveRef(dir, [branch, `origin/${branch}`, `refs/heads/${branch}`]);
    if (!head) continue;
    const baseOid = resolveRef(dir, [`origin/${base}`, base, `refs/heads/${base}`]);
    if (!baseOid) continue;
    const anc = run("git", ["-C", dir, "merge-base", "--is-ancestor", head, baseOid], { timeout: 20000 });
    if (anc.status === 0) return true;
    if (anc.status === 1) return false;
    // Any other status is a git error, not an answer.
  }
  return "unknown";
}

function isClosedNotMerged(m, card) {
  if (!m || m.merged) return false;
  if (m.closed) return true;
  if (/:(closed|abandoned|rejected)\b/i.test(String(m.detail || ""))) return true;
  if (bodySignalsClosedPr(card)) return true;
  return false;
}

function clearPrUrl(slug) {
  if (dryRun) return;
  run(boardCli, ["add", slug, "--pr-url", ""], { timeout: 30000 });
}

function closeCard(slug, prUrl, branch) {
  if (dryRun) {
    res.closed.push(slug);
    return true;
  }
  if (!fs.existsSync(closeoutBin)) {
    // Fallback: direct move
    const args = ["move", slug, "done", "--force"];
    const out = run(boardCli, args, { timeout: 60000 });
    if (!out.ok) {
      if (noteCloseoutDeferred(slug, out)) return false;
      res.flagged.push(`close-failed:${slug}`);
      noteCloseFailure(slug, out);
      return false;
    }
    res.closed.push(slug);
    clearCloseFailure(slug);
    return true;
  }
  const args = [slug, "--board-cli", boardCli];
  if (prUrl) args.push("--pr-url", prUrl);
  if (branch) args.push("--branch", branch);
  const out = run(closeoutBin, args, { timeout: 90000 });
  if (!out.ok) {
    if (noteCloseoutDeferred(slug, out)) return false;
    res.flagged.push(`close-failed:${slug}`);
    noteCloseFailure(slug, out);
    return false;
  }
  res.closed.push(slug);
  clearCloseFailure(slug);
  // last-stack-card-closeout reclaims the worktree after column=done.
  // Fallback if an older closeout binary is still installed without reclaim:
  const reclaimBin = path.join(lastStack, "bin", "last-stack-worktree-reclaim");
  if (fs.existsSync(reclaimBin)) {
    run(reclaimBin, ["--slug", slug], { timeout: 120000 });
  }
  return true;
}

function rollbackTodo(slug) {
  if (dryRun) {
    res.rolled_back.push(slug);
    return true;
  }
  const out = run(boardCli, ["move", slug, "todo", "--force"], { timeout: 60000 });
  if (!out.ok) {
    // try without force
    const out2 = run(boardCli, ["move", slug, "todo"], { timeout: 60000 });
    if (!out2.ok) {
      res.flagged.push(`rollback-failed:${slug}`);
      return false;
    }
  }
  // clear assignee best-effort so pickup can re-claim
  run(boardCli, ["add", slug, "--assignee", ""], { timeout: 30000 });
  res.rolled_back.push(slug);
  return true;
}

/**
 * Deploy/live-proof waits are a human/validate gate, not factory WIP.
 * Demote them to backlog with deferred so doing_stuck_hard stays honest.
 * Do not send them to todo — that is the pickup thrash path.
 */
function demoteDeployParked(slug, card) {
  ensureAwaitingDeployTag(slug, card);
  if (dryRun) {
    res.demoted.push(slug);
    res.flagged.push(`deploy-parked:${slug}`);
    res.flagged.push(`deploy-parked-demoted:${slug}`);
    return true;
  }
  const reason =
    "deploy-parked: awaiting deploy/safe-upgrade/live-proof; not factory WIP";
  run(
    boardCli,
    ["set", slug, "--block-status", "deferred", "--block-reason", reason],
    { timeout: 45000 },
  );
  run(
    boardCli,
    [
      "mark",
      slug,
      `PARKED: ${iso} — closeout demoted deploy/live-proof wait from doing to backlog (WIP accounting). Deploy/safe-upgrade remains a human gate.`,
    ],
    { timeout: 45000 },
  );
  let out = run(boardCli, ["move", slug, "backlog", "--force"], { timeout: 60000 });
  if (!out.ok) {
    out = run(boardCli, ["move", slug, "backlog"], { timeout: 60000 });
    if (!out.ok) {
      res.flagged.push(`demote-failed:${slug}`);
      return false;
    }
  }
  run(boardCli, ["add", slug, "--assignee", ""], { timeout: 30000 });
  clearCloseFailure(slug);
  res.demoted.push(slug);
  res.flagged.push(`deploy-parked:${slug}`);
  res.flagged.push(`deploy-parked-demoted:${slug}`);
  return true;
}

const cards = listDoing();
if (cards === null) {
  finish();
  process.exit(0);
}
seenDoingSlugs = new Set(cards.map((c) => String(c.slug || "")));

let actions = 0;
const graceMs = graceMin * 60 * 1000;
const maxParkMs = maxParkHours * 60 * 60 * 1000;

/**
 * A park (deploy gate, live-proof wait, refused closeout) delays reclaim — it
 * must not become a permanent exemption. Past --max-park-hours with no live
 * worker, hand the card back to todo so pickup re-claims and drives it.
 */
function parkExpired(age, wt) {
  if (age < maxParkMs) return false;
  return !hasLiveWorker(wt);
}

for (const card of cards) {
  if (actions >= maxActions) {
    res.flagged.push(`action-capped:${cards.length - actions}`);
    break;
  }
  const slug = String(card.slug || "");
  if (!slug) continue;
  const fieldPr = String(card.pr_url || card.prUrl || card.pr || "").trim();
  const url = prUrlOf(card);
  const branch =
    String(card.branch || "").trim() || parseBodyHeader(bodyOf(card), "Branch");
  const age = ageMs(card);
  const wt = worktreeFor(slug);
  const deployParked = isDeployParked(card);

  // Heal empty OR dirty-nonempty structured pr_url (trailing markdown
  // punctuation). Lookup already uses normalizePrUrl; the stored field must
  // match or restamp/pipeline keep treating a merged CR as missing-ci.
  if (url && fieldPr !== url) {
    healPrUrl(slug, url);
    res.flagged.push(`pr-url-healed:${slug}`);
  }

  if (url) {
    const pr = classifyPr(url);
    const m = isMerged(pr);
    if (m.merged) {
      if (closeCard(slug, url, branch)) actions++;
      else {
        // Deploy-parked merged cards are a human/validate gate, not WIP.
        // Demote to backlog instead of leaving them to inflate doing_stuck_hard.
        const parkedClose =
          deployParked || /deploy/i.test(String(m.detail || ""));
        if (!closeoutDeferred.has(slug) && parkedClose) {
          if (demoteDeployParked(slug, card)) {
            actions++;
            continue;
          }
        }
        res.skipped.push(`${slug}:close-failed`);
        if (parkedClose) {
          ensureAwaitingDeployTag(slug, card);
          res.flagged.push(`deploy-parked:${slug}`);
        }
        // Non-deploy close-failed parks still expire back to todo.
        if (!closeoutDeferred.has(slug) && !parkedClose && parkExpired(age, wt)) {
          res.flagged.push(`park-expired:${slug}`);
          if (rollbackTodo(slug)) actions++;
        }
      }
      continue;
    }
    // Closed/reaped (not merged): roll back to todo so pickup can reopen work.
    // Detect via forge/LastGit/gh state, or STALE-PR REAP body annotation when
    // the remote lookup flakes. Keep worktree/branch; clear structured pr_url.
    if (isClosedNotMerged(m, card)) {
      // The record says closed; the git ref decides. A branch already merged
      // into base is shipped work — closing it here stops pickup from
      // re-manufacturing it as ready work on the next fire.
      const proof = branchMergedIntoBase(card, wt);
      if (proof === true) {
        res.flagged.push(`merge-proof-close:${slug}`);
        // Keep the structured pr_url empty: the stored CR record is corrupt,
        // so restamping it would re-arm this same loop.
        clearPrUrl(slug);
        if (closeCard(slug, "", branch)) actions++;
        else res.skipped.push(`${slug}:merge-proof-close-failed`);
        continue;
      }
      res.flagged.push(`closed-pr:${slug}:${m.detail || "body-reap"}`);
      if (proof === "unknown") res.flagged.push(`merge-proof-unknown:${slug}`);
      clearPrUrl(slug);
      if (rollbackTodo(slug)) actions++;
      else res.skipped.push(`${slug}:closed-pr-rollback-failed`);
      continue;
    }
    // Open / unknown PR: leave for watch/merge-babysit. Soft 1h does not reclaim these.
    res.skipped.push(`${slug}:pr-open-or-unknown`);
    continue;
  }

  // Deploy-gated / live-proof wait without a parseable PR: demote out of WIP.
  // Do not roll to todo (pickup thrash) and do not leave in doing.
  if (deployParked) {
    if (demoteDeployParked(slug, card)) {
      actions++;
      continue;
    }
    ensureAwaitingDeployTag(slug, card);
    res.skipped.push(`${slug}:deploy-parked`);
    res.flagged.push(`deploy-parked:${slug}`);
    continue;
  }

  // No PR — soft zombie reclaim only after grace, never kill live workers / WIP commits.
  if (skipZombie) {
    res.skipped.push(`${slug}:no-pr-zombie-skipped`);
    continue;
  }
  if (age < graceMs) {
    res.skipped.push(`${slug}:young`);
    continue;
  }
  if (hasLiveWorker(wt)) {
    res.skipped.push(`${slug}:live-worker`);
    continue;
  }
  // STALE-PR REAP body annotation with no parseable URL is the same class:
  // the reaped record must not outrank a branch that already reached base.
  if (bodySignalsClosedPr(card)) {
    const reapProof = branchMergedIntoBase(card, wt);
    if (reapProof === true) {
      res.flagged.push(`merge-proof-close:${slug}`);
      if (closeCard(slug, "", branch)) {
        actions++;
        continue;
      }
      res.skipped.push(`${slug}:merge-proof-close-failed`);
      continue;
    }
    if (reapProof === "unknown") res.flagged.push(`merge-proof-unknown:${slug}`);
  }

  if (branchHasCommits(card, wt)) {
    // Pickup contract: never leave doing without a PR/CR after budget.
    // Roll back to todo so the next fire can reopen/finish the PR; keep worktree.
    res.flagged.push(`wip-no-pr:${slug}`);
    if (rollbackTodo(slug)) {
      actions++;
      continue;
    }
    res.skipped.push(`${slug}:wip-no-pr-rollback-failed`);
    continue;
  }
  if (rollbackTodo(slug)) actions++;
}

function finish() {
  // A card that left `doing` is no longer failing to close — drop its streak so
  // a later, unrelated failure starts from zero.
  if (seenDoingSlugs) {
    for (const slug of Object.keys(failState)) {
      if (!seenDoingSlugs.has(slug)) delete failState[slug];
    }
  }
  writeFailState(failState);
  const closed = res.closed.length;
  const rolled = res.rolled_back.length;
  const demoted = res.demoted.length;
  const skipped = res.skipped.length;
  const flags = res.flagged.length ? res.flagged.join(",") : "none";
  let st = res.status;
  if (st === "noop" && (closed > 0 || rolled > 0 || demoted > 0)) st = "ok";
  else if (st === "ok" && closed === 0 && rolled === 0 && demoted === 0) st = "noop";
  const line =
    `board-closeout ${iso} ${st} closed=${closed}` +
    (closed ? ` closed_slugs=${res.closed.join(",")}` : "") +
    ` rolled_back=${rolled}` +
    (rolled ? ` rolled_slugs=${res.rolled_back.join(",")}` : "") +
    ` demoted=${demoted}` +
    (demoted ? ` demoted_slugs=${res.demoted.join(",")}` : "") +
    ` skipped=${skipped} flagged=${flags}`;
  const payload = {
    kind: "board-closeout",
    status: st,
    iso,
    closed,
    rolled_back: rolled,
    demoted,
    skipped,
    flagged: res.flagged,
  };
  // Unbuffered: a timeout/kill used to drop fully-buffered console.log.
  fs.writeSync(1, JSON.stringify(payload) + "\n");
  fs.writeSync(1, line + "\n");
  if (jsonOut) {
    fs.writeSync(1, JSON.stringify({ ...res, status: st, iso }, null, 2) + "\n");
  }
  // Heartbeat best-effort
  const hb = path.join(lastStack, "bin", "last-stack-brain-append-heartbeat");
  if (!dryRun && fs.existsSync(hb)) {
    run(hb, ["--line", line], { timeout: 30000 });
  }
}

finish();
process.exit(0);
NODE
  _emit_closeout_result
  exit 0
fi

# Python fallback
