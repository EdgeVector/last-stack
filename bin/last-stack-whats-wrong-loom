#!/usr/bin/env bash
# last-stack-whats-wrong-loom — hourly EV OPS "What's wrong" healer via loom.
#
# Reads http://127.0.0.1:7733/api/snapshot coverage.exceptions and fans one
# loom child execution per row. Same-hour --key resumes the existing exec.
#
#   last-stack-whats-wrong-loom [--json] [--quiet] [--dry-run] [--no-heal] [--status]
#   last-stack-whats-wrong-loom --key whats-wrong-YYYYmmddTHH
#
# loom run is wall-clock bounded (default 780s, LAST_STACK_WHATS_WRONG_LOOM_TIMEOUT_SEC).
# A stuck child is SIGTERM'd (then SIGKILL) so it cannot eat routines'
# GATE_TIMEOUT_CAP_MS (15m) with empty logs. The wrapper still emits
# ROUTINE_RESULT with exceptions/healed counts.
#
# On that bound the wrapper MEASURES what the run healed; it does not assume
# zero. The CLOSEOUT node is what writes context.detail/context.healed, and it
# only runs at the end of the graph, so a bounded run has no detail line — but
# context.heal_results is appended per heal agent as it finishes, and that is
# the ground truth. Reporting a hardcoded healed=0 made a working healer look
# broken for six days (papercut-whats-wrong-loom-780s-healed-zero-20260820)
# and hid the heals that did land. When the readback itself is unavailable the
# count is `unknown`, never `0`: an unmeasured value must not be printed as a
# measured one.
#
# Exit:
#   0  ran (including exceptions=0 noop), bounded run with heals, or
#      --status/--dry-run printed
#   2  usage
#   3  loom / snapshot / definitions unavailable / loom-timeout with no heals
set -euo pipefail

JSON=0
QUIET=0
STATUS=0
DRY=0
HEAL=1
KEY=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --status) STATUS=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --no-heal) HEAL=0; shift ;;
    --heal) HEAL=1; shift ;;
    --key) KEY="${2:-}"; shift 2 ;;
    --key=*) KEY="${1#*=}"; shift ;;
    -h|--help)
      echo "last-stack-whats-wrong-loom [--json] [--quiet] [--dry-run] [--no-heal] [--status] [--key KEY]"
      exit 0
      ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"
STAMP="${LAST_STACK_WHATS_WRONG_STAMP:-$HOME/.last-stack/state/whats-wrong-loom.json}"

log() { [ "$QUIET" -eq 1 ] || printf 'whats-wrong-loom: %s\n' "$*" >&2; }

write_stamp() {
  mkdir -p "$(dirname "$STAMP")"
  ST="$1" EX="${2:-}" DT="${3:-}" KY="${4:-}" OC="${5:-}" LAST_STACK_WHATS_WRONG_STAMP="$STAMP" python3 -c '
import json, os, datetime
p = os.environ["LAST_STACK_WHATS_WRONG_STAMP"]
doc = {
  "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "status": os.environ.get("ST", ""),
  "exec_id": os.environ.get("EX", ""),
  "detail": os.environ.get("DT", ""),
  "key": os.environ.get("KY", ""),
  "outcome": os.environ.get("OC", ""),
  "engine": "loom",
}
open(p, "w").write(json.dumps(doc) + "\n")
'
}

print_status() {
  LAST_STACK_WHATS_WRONG_STAMP="$STAMP" python3 -c '
import json, os, sys, datetime
p = os.environ["LAST_STACK_WHATS_WRONG_STAMP"]
if not os.path.isfile(p):
    print(json.dumps({"ok": False, "missing": True, "status": "", "ageH": 99.0}))
    sys.exit(0)
try:
    d = json.load(open(p))
except Exception:
    print(json.dumps({"ok": False, "missing": True, "status": "parse", "ageH": 99.0}))
    sys.exit(0)
ts = d.get("ts") or ""
try:
    t = datetime.datetime.strptime(ts.replace("Z",""), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    age_h = (datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() / 3600.0
except Exception:
    age_h = 99.0
status = str(d.get("status") or "")
print(json.dumps({
    "ok": status == "succeeded",
    "missing": False,
    "status": status,
    "ageH": round(age_h, 4),
    "exec_id": d.get("exec_id") or "",
    "detail": d.get("detail") or "",
    "key": d.get("key") or "",
    "outcome": d.get("outcome") or "",
}))
'
}

if [ "$STATUS" -eq 1 ]; then
  print_status
  exit 0
fi

list_exceptions() {
  WHATS_WRONG_DASHBOARD="${WHATS_WRONG_DASHBOARD:-http://127.0.0.1:7733}" \
  python3 -c '
import json, os, sys, urllib.request
snap_file = os.environ.get("WHATS_WRONG_SNAPSHOT_FILE") or ""
dash = (os.environ.get("WHATS_WRONG_DASHBOARD") or "http://127.0.0.1:7733").rstrip("/")
url = os.environ.get("WHATS_WRONG_SNAPSHOT_URL") or (dash + "/api/snapshot")
try:
    if snap_file:
        snap = json.load(open(snap_file))
    else:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=45) as resp:
            snap = json.loads(resp.read().decode("utf-8"))
except Exception as e:
    print(json.dumps({"ok": False, "error": str(e)}))
    sys.exit(3)
exc = (snap.get("coverage") or {}).get("exceptions") or []
if not isinstance(exc, list):
    exc = []
rows = [r for r in exc if isinstance(r, dict) and r.get("id")]
print(json.dumps({"ok": True, "count": len(rows), "exceptions": rows, "dashboard": dash}))
'
}

if [ "$DRY" -eq 1 ]; then
  listed="$(list_exceptions)" || {
    log "snapshot failed"
    write_stamp unavailable "" "snapshot-failed" "${KEY:-}" "error"
    exit 3
  }
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$listed"
  else
    printf '%s\n' "$listed" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print("whats-wrong dry-run count=%s" % d.get("count"))
for r in d.get("exceptions") or []:
    print("  %s  L=%s F=%s T=%s  %s" % (r.get("id"), r.get("L"), r.get("F"), r.get("T"), r.get("why") or r.get("detail") or ""))
'
  fi
  n="$(printf '%s\n' "$listed" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("count",0))')"
  oc="noop"
  [ "${n:-0}" = "0" ] || oc="ok"
  write_stamp dry-run "" "exceptions=${n}" "${KEY:-}" "$oc"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=exceptions=${n}"
  exit 0
fi

if ! command -v loom >/dev/null 2>&1; then
  log "loom not on PATH"
  write_stamp unavailable "" "loom-missing" "${KEY:-}" "error"
  exit 3
fi
if ! loom ping >/dev/null 2>&1; then
  log "loom ping failed"
  write_stamp unavailable "" "loom-ping-failed" "${KEY:-}" "error"
  exit 3
fi

exe="$(command -v loom)"
real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$exe")"
install_root="$(dirname "$(dirname "$real")")"

defs=""
scripts=""
for cand in \
  "${LOOM_DEFS:-}" \
  "$ROOT/lib/whats-wrong" \
  "$install_root/definitions" \
  "${HOME}/.loom/definitions"; do
  if [ -n "$cand" ] && [ -f "$cand/whats-wrong.json" ] && [ -f "$cand/whats-wrong-item.json" ]; then
    defs="$cand"
    break
  fi
done
for cand in \
  "${LOOM_SCRIPTS:-}" \
  "$ROOT/lib/whats-wrong" \
  "$install_root/scripts" \
  "${HOME}/.loom/scripts"; do
  if [ -n "$cand" ] && [ -f "$cand/loom-whats-wrong-list.sh" ] && [ -f "$cand/loom-whats-wrong-heal.sh" ]; then
    scripts="$cand"
    break
  fi
done
if [ -z "$defs" ] || [ -z "$scripts" ]; then
  log "whats-wrong definitions/scripts not found"
  write_stamp unavailable "" "defs-missing" "${KEY:-}" "error"
  exit 3
fi
export LOOM_SCRIPTS="$scripts"

if ! loom publish "$defs/whats-wrong.json" >/dev/null 2>&1; then
  log "loom publish whats-wrong failed"
  write_stamp unavailable "" "publish-failed" "${KEY:-}" "error"
  exit 3
fi
if ! loom publish "$defs/whats-wrong-item.json" >/dev/null 2>&1; then
  log "loom publish whats-wrong-item failed"
  write_stamp unavailable "" "publish-failed" "${KEY:-}" "error"
  exit 3
fi

if [ "$HEAL" -eq 1 ]; then
  export LOOM_WHATS_WRONG_LIVE=1
  export LOOM_LIVE=1
else
  unset LOOM_WHATS_WRONG_LIVE || true
fi

if [ -z "$KEY" ]; then
  KEY="${LOOM_WHATS_WRONG_KEY:-whats-wrong-$(date -u +%Y%m%dT%H)}"
fi
listed_input="$(list_exceptions)" || {
  log "snapshot failed"
  write_stamp unavailable "" "snapshot-failed" "$KEY" "error"
  exit 3
}
input="$(printf '%s\n' "$listed_input" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(json.dumps({
    "dashboard": d.get("dashboard") or "http://127.0.0.1:7733",
    "items": d.get("exceptions") or [],
    "count": int(d.get("count") or 0),
}, separators=(",", ":")))
')"

# Under routines GATE_TIMEOUT_CAP_MS (15m). Leave headroom for snapshot + trailer.
TIMEOUT_SEC="${LAST_STACK_WHATS_WRONG_LOOM_TIMEOUT_SEC:-780}"
case "$TIMEOUT_SEC" in
  ''|*[!0-9]*) TIMEOUT_SEC=780 ;;
esac
[ "$TIMEOUT_SEC" -ge 1 ] || TIMEOUT_SEC=780

# Budget for the post-timeout readback. Small and separate from TIMEOUT_SEC:
# it runs *after* the main bound has already fired, so it eats the headroom
# left under routines' GATE_TIMEOUT_CAP_MS (15m), not the heal budget.
READBACK_SEC="${LAST_STACK_WHATS_WRONG_LOOM_READBACK_SEC:-45}"
case "$READBACK_SEC" in
  ''|*[!0-9]*) READBACK_SEC=45 ;;
esac
[ "$READBACK_SEC" -ge 1 ] || READBACK_SEC=45

# Retry budget for a `loom run` that fails FAST on a retryable LastDB answer.
#
# persist_queue_full is the case this exists for: the node returns 503 with
# `"retryable":true` and `retry after drain`, loom exits 1 in a few seconds,
# and the hour's heal pass used to end there — 5.5 s of a 780 s budget, twice
# in a row on 2026-08-27
# (papercut-whats-wrong-loom-no-retry-on-retryable-lastdb-503).
#
# Retrying is safe because `loom run --key` is idempotent by contract: the same
# key re-attaches to the existing execution instead of starting a second one.
# The retries share the ONE wall-clock deadline below, so this cannot push the
# gate past routines' GATE_TIMEOUT_CAP_MS.
RETRY_ATTEMPTS="${LAST_STACK_WHATS_WRONG_LOOM_RETRY_ATTEMPTS:-3}"
case "$RETRY_ATTEMPTS" in
  ''|*[!0-9]*) RETRY_ATTEMPTS=3 ;;
esac
[ "$RETRY_ATTEMPTS" -ge 1 ] || RETRY_ATTEMPTS=3

RETRY_SLEEP_SEC="${LAST_STACK_WHATS_WRONG_LOOM_RETRY_SLEEP_SEC:-10}"
case "$RETRY_SLEEP_SEC" in
  ''|*[!0-9]*) RETRY_SLEEP_SEC=10 ;;
esac
[ "$RETRY_SLEEP_SEC" -ge 1 ] || RETRY_SLEEP_SEC=10

# Same transient set as last-stack-lastdb-retry. Structural rejects
# (max_outbox_entries) and agent rate limits are NOT retried.
is_transient_lastdb_flap() {
  printf '%s' "${1:-}" | grep -Eiq \
    'persist_queue_full|persist queue full|retry after drain|"retryable":[[:space:]]*true|service_timeout|node did not respond|too many concurrent reads|uds_connection_limit|connection refused|ECONNRESET|temporarily at capacity' \
    || return 1
  if printf '%s' "${1:-}" | grep -Eiq 'max_outbox_entries|outbox.?full'; then
    return 1
  fi
  if printf '%s' "${1:-}" | grep -Eiq 'rate.?limit|429|limit reached'; then
    return 1
  fi
  return 0
}

# Parse a `loom run` / `loom show` view on stdin into one JSON line.
# Shared by the success path and the timeout readback so the two cannot drift
# in what they consider a heal.
parse_loom_view() {
  python3 -c '
import json, sys
text = sys.stdin.read()
status = ""
state = ""
ctx = {}
exec_id = ""
for i, line in enumerate(text.splitlines()):
    if i == 0 and line.strip() and not line.startswith("status:") and not line.startswith("context."):
        exec_id = line.strip()
    if line.startswith("status:"):
        status = line.split(":", 1)[1].strip()
    elif line.startswith("state:"):
        state = line.split(":", 1)[1].strip()
    elif line.startswith("context."):
        key, _, rest = line.partition(":")
        key = key[len("context."):]
        rest = rest.strip()
        try:
            ctx[key] = json.loads(rest)
        except Exception:
            ctx[key] = rest.strip("\"")


def as_dict(v):
    if isinstance(v, dict):
        return v
    if isinstance(v, str):
        try:
            parsed = json.loads(v)
            return parsed if isinstance(parsed, dict) else {}
        except Exception:
            return {}
    return {}


# `healed` is what CLOSEOUT writes, and CLOSEOUT only runs at the end of the
# graph. `heal_results` is appended per agent, so it is the only count a
# bounded run can report. Prefer the finished list, fall back to the live one.
healed = ctx.get("healed")
if isinstance(healed, list):
    healed_n = len(healed)
else:
    results = ctx.get("heal_results")
    if isinstance(results, list):
        healed_n = 0
        for row in results:
            row = as_dict(row)
            if "heal_status" not in row:
                for key in ("result", "output", "context", "stdout"):
                    inner = as_dict(row.get(key))
                    if inner.get("heal_status") or inner.get("id"):
                        row = inner
                        break
            if str(row.get("heal_status") or "") == "healed":
                healed_n += 1
    else:
        healed_n = None

print(json.dumps({
    "status": status,
    "state": state,
    "exec_id": exec_id,
    "outcome": str(ctx.get("outcome") or ""),
    "detail": str(ctx.get("detail") or ""),
    "count": ctx.get("count"),
    "healed_n": healed_n,
}))
'
}

json_field() {
  # $1 = field name; JSON on stdin. Empty string when absent/null.
  JSON_FIELD_NAME="$1" python3 -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
v = d.get(os.environ["JSON_FIELD_NAME"])
print("" if v is None else v)
'
}

# Read back the bounded execution to find out what it actually healed.
#
# `loom show <ID>` is the direct read, but the exec id only reaches us if loom
# printed it before the kill. `loom run --key` is idempotent by contract — a
# repeated key returns the EXISTING execution rather than starting a second one
# — so it is the fallback read, not a second run. Both are bounded: this runs
# after the main budget is already spent.
readback_view() {
  rb_exec_id="$1"
  if [ -n "$rb_exec_id" ]; then
    RB_ID="$rb_exec_id" RB_SEC="$READBACK_SEC" python3 -c '
import os, subprocess, sys
try:
    p = subprocess.run(["loom", "show", os.environ["RB_ID"]],
                       capture_output=True, text=True,
                       timeout=int(os.environ["RB_SEC"]))
except Exception:
    raise SystemExit(1)
if p.returncode != 0 or not p.stdout.strip():
    raise SystemExit(1)
sys.stdout.write(p.stdout)
' 2>/dev/null && return 0
  fi
  RB_SEC="$READBACK_SEC" python3 -c '
import os, signal, subprocess, sys
argv = [
    "loom", "run", "whats-wrong",
    "--key", os.environ["LOOM_WHATS_WRONG_RUN_KEY"],
    "--input", os.environ["LOOM_WHATS_WRONG_RUN_INPUT"],
]
p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                     text=True, start_new_session=True)
try:
    out, _ = p.communicate(timeout=int(os.environ["RB_SEC"]))
except subprocess.TimeoutExpired:
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    raise SystemExit(1)
if p.returncode != 0 or not out.strip():
    raise SystemExit(1)
sys.stdout.write(out)
' 2>/dev/null
}

count_exceptions() {
  listed="$(list_exceptions 2>/dev/null)" || listed=""
  printf '%s\n' "$listed" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    print(int(d.get("count") or 0))
except Exception:
    print(0)
' 2>/dev/null || echo 0
}

emit_result() {
  local oc="$1"
  local det="$2"
  if [ "$JSON" -eq 1 ]; then
    printf '{"outcome":"%s","detail":"%s","engine":"loom","key":"%s"}\n' \
      "$oc" "$(printf '%s' "$det" | tr '"' "'")" "$KEY"
  else
    printf 'WHATS_WRONG outcome=%s engine=loom\n' "$oc"
    printf 'detail: %s\n' "$det"
  fi
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=${oc} detail=${det}"
}

log "loom run whats-wrong --key $KEY timeout=${TIMEOUT_SEC}s attempts=${RETRY_ATTEMPTS}"
export LOOM_WHATS_WRONG_RUN_KEY="$KEY"
export LOOM_WHATS_WRONG_RUN_INPUT="$input"

loom_err_file="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack-whats-wrong.XXXXXX")"
trap 'rm -f "$loom_err_file"' EXIT

# ONE deadline for the whole attempt sequence. Each attempt is handed only the
# time still left, so N retries cost the same wall clock as no retries.
loom_deadline=$(( $(date -u +%s) + TIMEOUT_SEC ))
attempt=1
view=""
lrc=0

while :; do
  remaining=$(( loom_deadline - $(date -u +%s) ))
  [ "$remaining" -ge 1 ] || remaining=1
  export LAST_STACK_WHATS_WRONG_LOOM_TIMEOUT_SEC="$remaining"

  : >"$loom_err_file"
  set +e
  view="$(python3 -c '
import os, signal, subprocess, sys, time
sec = int(os.environ["LAST_STACK_WHATS_WRONG_LOOM_TIMEOUT_SEC"])
argv = [
    "loom", "run", "whats-wrong",
    "--key", os.environ["LOOM_WHATS_WRONG_RUN_KEY"],
    "--input", os.environ["LOOM_WHATS_WRONG_RUN_INPUT"],
]
p = subprocess.Popen(argv, start_new_session=True)
try:
    rc = p.wait(timeout=sec)
    if rc is None:
        raise SystemExit(1)
    raise SystemExit(rc if rc >= 0 else 124)
except subprocess.TimeoutExpired:
    try:
        os.killpg(p.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    t0 = time.time()
    while time.time() - t0 < 5:
        if p.poll() is not None:
            break
        time.sleep(0.05)
    if p.poll() is None:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass
    raise SystemExit(124)
' 2>"$loom_err_file")"
  lrc=$?
  set -e
  # Keep the operator-visible stream identical to the pre-retry wrapper.
  cat "$loom_err_file" >&2 || true
  loom_err="$(cat "$loom_err_file" 2>/dev/null || true)"

  # Success, or the wall-clock bound fired (that has its own reporting path).
  if { [ "$lrc" -eq 0 ] && [ -n "$view" ]; } || [ "$lrc" -eq 124 ]; then
    break
  fi

  if [ "$attempt" -lt "$RETRY_ATTEMPTS" ] \
     && is_transient_lastdb_flap "$loom_err" \
     && [ "$(( loom_deadline - $(date -u +%s) ))" -gt "$(( RETRY_SLEEP_SEC + 5 ))" ]; then
    log "loom run rc=${lrc} is a retryable LastDB answer; attempt $((attempt + 1))/${RETRY_ATTEMPTS} in ${RETRY_SLEEP_SEC}s"
    sleep "$RETRY_SLEEP_SEC"
    attempt=$((attempt + 1))
    continue
  fi
  break
done

if [ "$lrc" -ne 0 ] || [ -z "$view" ]; then
  n="$(count_exceptions)"
  if [ "$lrc" -eq 124 ]; then
    log "loom run timed out after ${TIMEOUT_SEC}s"
    # loom may have printed the exec id before the kill; that makes the
    # readback a direct `loom show` instead of a re-attach.
    partial_id="$(printf '%s\n' "$view" | parse_loom_view | json_field exec_id)"
    rb="$(readback_view "$partial_id" 2>/dev/null || true)"
    healed_n=""
    rb_exec=""
    rb_status=""
    rb_state=""
    if [ -n "$rb" ]; then
      rb_parsed="$(printf '%s\n' "$rb" | parse_loom_view)"
      healed_n="$(printf '%s\n' "$rb_parsed" | json_field healed_n)"
      rb_exec="$(printf '%s\n' "$rb_parsed" | json_field exec_id)"
      rb_status="$(printf '%s\n' "$rb_parsed" | json_field status)"
      rb_state="$(printf '%s\n' "$rb_parsed" | json_field state)"
    fi
    [ -n "$rb_exec" ] || rb_exec="$partial_id"

    if [ -z "$healed_n" ] && [ -n "$rb" ]; then
      # The readback WORKED. A graph that has not reached its first heal yet
      # carries neither `healed` nor `heal_results`, so healed_n is absent —
      # that is a fact about the EXECUTION, not about the read. Reporting
      # `readback=unavailable` here sent operators to look for a broken loom
      # when `loom show` answers in ~30 ms and names where the graph is
      # parked. Say what was read.
      det="exceptions=${n} healed=unknown loom-timeout=${TIMEOUT_SEC}s readback=live exec-status=${rb_status:-unknown} exec-state=${rb_state:-unknown}"
      log "loom readback live: exec ${rb_exec} status=${rb_status:-unknown} state=${rb_state:-unknown}; no heal count written yet"
      write_stamp timed-out "$rb_exec" "$det" "$KEY" "error"
      emit_result error "$det"
      exit 3
    fi

    if [ -z "$healed_n" ]; then
      # Unmeasured. Say so — printing 0 here is what made a working healer
      # look broken for six days.
      det="exceptions=${n} healed=unknown loom-timeout=${TIMEOUT_SEC}s readback=unavailable"
      log "loom readback unavailable; healed count unknown"
      write_stamp timed-out "$rb_exec" "$det" "$KEY" "error"
      emit_result error "$det"
      exit 3
    fi
    if [ "$healed_n" -ge 1 ]; then
      # The bound outran the graph, not the healer. Heals landed, so this hour
      # did its job; reporting error here is what buried the signal.
      det="exceptions=${n} healed=${healed_n} loom-timeout=${TIMEOUT_SEC}s partial=1"
      log "loom bound fired after ${healed_n} heal(s); reporting ok"
      write_stamp timed-out-partial "$rb_exec" "$det" "$KEY" "ok"
      if [ -x "$ROOT/bin/last-stack-brain-append-heartbeat" ]; then
        ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        "$ROOT/bin/last-stack-brain-append-heartbeat" --line \
          "whats-wrong $ts ok $det engine=loom" >/dev/null 2>&1 || true
      fi
      emit_result ok "$det"
      exit 0
    fi
    # Measured zero: the bound fired and nothing healed. Still red — the card
    # is explicit that a genuinely stuck loom run must not be masked.
    det="exceptions=${n} healed=0 loom-timeout=${TIMEOUT_SEC}s measured=1"
    write_stamp timed-out "$rb_exec" "$det" "$KEY" "error"
    emit_result error "$det"
    exit 3
  fi
  det="exceptions=${n} healed=0 loom-run-failed rc=${lrc} attempts=${attempt}"
  log "loom run failed rc=$lrc after ${attempt} attempt(s)"
  write_stamp failed "" "$det" "$KEY" "error"
  emit_result error "$det"
  exit 3
fi

parsed="$(printf '%s\n' "$view" | parse_loom_view)"

run_status="$(printf '%s\n' "$parsed" | json_field status)"
exec_id="$(printf '%s\n' "$parsed" | json_field exec_id)"
det_str="$(printf '%s\n' "$parsed" | json_field detail)"
oc_str="$(printf '%s\n' "$parsed" | json_field outcome)"
if [ "$run_status" != "succeeded" ]; then
  n="$(count_exceptions)"
  [ -n "$det_str" ] || det_str="exceptions=${n} healed=0 status=${run_status:-failed}"
  log "loom exec status=$run_status"
  write_stamp "${run_status:-failed}" "$exec_id" "$det_str" "$KEY" "error"
  emit_result error "$det_str"
  exit 3
fi

if [ -z "$oc_str" ]; then
  oc_str="ok"
fi
if [ -z "$det_str" ]; then
  det_str="ran"
fi
write_stamp succeeded "$exec_id" "$det_str" "$KEY" "$oc_str"

if [ -x "$ROOT/bin/last-stack-brain-append-heartbeat" ]; then
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "$ROOT/bin/last-stack-brain-append-heartbeat" --line \
    "whats-wrong $ts $oc_str $det_str engine=loom" >/dev/null 2>&1 || true
fi

emit_result "$oc_str" "$det_str"
exit 0
