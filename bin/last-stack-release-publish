#!/usr/bin/env python3
"""The one human command that publishes a proved LastDB candidate.

    last-stack-release-publish --lastdb-version 0.23.3-2117-gffb8eb6c4 [--dry-run]

Two things move together, so the public shelf never names an app row that was
not proved with the node brew ships:

  1. node  → brew stable: LastDB's forge-promote-homebrew-stable.sh publishes
     the staged canary package under the next stable tag and opens the
     formula PR on the GitHub tap.
  2. rows  → registry stable: the `next` rows proved with this build are
     copied to registry/stable.json with each app's PUBLIC source, every
     commit is checked to be fetchable from that public source (mirror lag
     fails closed), the index is re-signed, and a second auto-merging PR
     lands on the tap.

`--dry-run` resolves the tag, stages nothing public, promotes into a scratch
copy, and prints what the two PRs would carry.

Since 2026-09-21 (decision-2026-09-21-stable-publish-is-automatic-on-green,
Tom) the hourly reconciler runs this with `--if-needed` when a candidate's
quiet window (1 h since 2026-09-24) is green: a build whose rows are already on `stable`
publishes nothing, a build with no `next` rows (nothing proved) is refused,
and each half (brew, registry) is skipped when it is already done. A human
can still run it by hand; the flags are the same.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
TAP_REPO = os.environ.get("LAST_STACK_REGISTRY_TAP_REPO", "EdgeVector/homebrew-lastdb")
# Gate of record for the tap is GitHub since 2026-09-30
# (decision-2026-09-29-retire-lastgit-all-repos-to-github). PRs + auto-merge.
TAP_URL = os.environ.get("LAST_STACK_REGISTRY_TAP_URL", f"https://github.com/{TAP_REPO}.git")
CANARY_BUILDS = Path(os.environ.get("LAST_STACK_CANARY_BUILDS_DIR", HOME / ".local/state/last-stack/canary-builds"))
PROMOTE_ROOT = Path(os.environ.get("LAST_STACK_CANARY_PROMOTE_ROOT", HOME / ".local/state/last-stack/canary-promote"))
SEMVER_TAG = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def die(message: str, code: int = 1) -> None:
    print(f"last-stack-release-publish: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    kw.setdefault("text", True)
    kw.setdefault("capture_output", True)
    kw.setdefault("check", False)
    return subprocess.run(cmd, **kw)


def find_staged_build(build: str) -> tuple[Path, str]:
    """canary-builds/<oid>/ whose manifest names this build string."""
    if not CANARY_BUILDS.is_dir():
        die(f"no canary-builds directory at {CANARY_BUILDS}")
    for child in sorted(CANARY_BUILDS.iterdir(), reverse=True):
        if not child.is_dir():
            continue
        for name in ("manifest.json", "lastdb-aarch64-apple-darwin.manifest.json"):
            man = child / name
            if not man.is_file():
                continue
            try:
                data = json.loads(man.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if str(data.get("lastdb_version") or data.get("lastdbd_version") or "") == build:
                oid = str(data.get("source_git_oid") or child.name)
                return child, oid
    die(f"no staged canary package names lastdb {build} under {CANARY_BUILDS}")
    return Path(), ""


def find_promote_script(explicit: str | None) -> tuple[Path, str]:
    """LastDB's promote script from accepted GitHub main (lib/fold_promote_script.py).

    Never ~/.lastgit/mirrors/fold: frozen at fold 06965ddf, it cloned
    lastdb:///homebrew-lastdb and exited 128
    (papercut-release-publish-uses-stale-lastgit-fold-mirror-20260923)."""
    sys.path.insert(0, str(ROOT / "lib"))
    import fold_promote_script  # noqa: E402  (lib/ is not a package)

    try:
        script, source = fold_promote_script.resolve(explicit, auth_header=None)
    except fold_promote_script.PromoteScriptError:
        die("accepted LastDB promotion helper could not be resolved")
    print(f"promote script: {script} ({source})")
    return script, source


# Stable tags live on the public GitHub tap (the bottle CDN), not on the
# Forge copy, so the next tag is read from there. Anonymous read.
PUBLIC_TAP_URL = os.environ.get("LAST_STACK_PUBLIC_TAP_URL", "https://github.com/EdgeVector/homebrew-lastdb.git")


def latest_stable_tag() -> str | None:
    best: tuple[int, int, int] | None = None
    seen_any = False
    for url in (PUBLIC_TAP_URL, TAP_URL):
        cmd = ["git", "ls-remote", "--tags", "--refs", url, "v*"]
        proc = run(cmd, timeout=60, env=None)
        if proc.returncode != 0:
            continue
        seen_any = True
        best = _max_semver_tag(proc.stdout, best)
    if not seen_any:
        die("could not read stable tags from the GitHub tap; pass --version-tag")
    return f"v{best[0]}.{best[1]}.{best[2]}" if best else None


def _max_semver_tag(listing: str, best: tuple[int, int, int] | None) -> tuple[int, int, int] | None:
    for line in listing.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        m = SEMVER_TAG.match(parts[1].rsplit("/", 1)[-1])
        if not m:
            continue
        tup = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
        if best is None or tup > best:
            best = tup
    return best


def next_stable_tag(build: str, explicit: str | None) -> str:
    if explicit:
        if not SEMVER_TAG.match(explicit):
            die(f"--version-tag must look like vX.Y.Z, got {explicit!r}", 2)
        return explicit
    base = build.split("-", 1)[0]
    try:
        a, b, c = (int(x) for x in base.split("."))
    except ValueError:
        die(f"cannot read a semver base from build {build!r}; pass --version-tag")
    latest = latest_stable_tag()
    candidate = (a, b, c)
    if latest:
        m = SEMVER_TAG.match(latest)
        assert m
        lt = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
        if candidate <= lt:
            candidate = (lt[0], lt[1], lt[2] + 1)
    return f"v{candidate[0]}.{candidate[1]}.{candidate[2]}"


def stage_assets(build_dir: Path, dest: Path) -> None:
    dest.mkdir(parents=True, exist_ok=True)
    for item in build_dir.iterdir():
        if item.is_file() and (item.name.endswith(".tar.gz") or item.name.endswith(".manifest.json") or item.name == "manifest.json"):
            shutil.copy2(item, dest / item.name)
    std = dest / "lastdb-aarch64-apple-darwin.manifest.json"
    if not std.is_file() and (dest / "manifest.json").is_file():
        shutil.copy2(dest / "manifest.json", std)
    if not any(p.name.endswith(".tar.gz") for p in dest.iterdir()):
        die(f"staged build {build_dir} has no .tar.gz package; the canary build did not package")


def tap_state_for_build(build: str, oid: str) -> dict:
    """Read the tap's main once: next/stable rows for this build, and whether the
    formula's current release was built from this source OID."""
    tap_dir = Path(tempfile.mkdtemp(prefix="release-publish-state."))
    clone = run(["git", "clone", "--quiet", "--depth", "1", TAP_URL, str(tap_dir)],
                timeout=120)
    if clone.returncode != 0:
        die("the GitHub tap read failed")
    state = {"next_rows": 0, "stable_rows": 0, "stable_complete": False, "brew_tag": "", "brew_release_oid": ""}
    indexes = {}
    for channel in ("next", "stable"):
        path = tap_dir / "registry" / f"{channel}.json"
        if path.is_file():
            try:
                index = json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            indexes[channel] = index
            state[f"{channel}_rows"] = sum(
                1 for app in index.get("apps", []) for row in app.get("compat", []) if row.get("lastdb_version") == build
            )
    if state["next_rows"] and state["stable_rows"]:
        sys.path.insert(0, str(ROOT / "lib"))
        import release_proofs
        desired = release_proofs.selected_rows(indexes["next"], build)
        held = release_proofs.selected_rows(indexes["stable"], build)
        state["stable_complete"] = set(desired).issubset(held)
    formula = tap_dir / "Formula" / "lastdb.rb"
    if formula.is_file():
        m = re.search(r'version\s+"([^"]+)"', formula.read_text(encoding="utf-8"))
        if m:
            state["brew_tag"] = f"v{m.group(1)}"
            manifest_url = (f"https://github.com/EdgeVector/homebrew-lastdb/releases/download/"
                            f"{state['brew_tag']}/lastdb-aarch64-apple-darwin.manifest.json")
            curl = run(["curl", "-fsSL", "--max-time", "30", manifest_url], timeout=60)
            if curl.returncode == 0:
                try:
                    state["brew_release_oid"] = str(json.loads(curl.stdout).get("source_git_oid") or "")
                except json.JSONDecodeError:
                    pass
    shutil.rmtree(tap_dir, ignore_errors=True)
    return state


def main(argv: list[str]) -> int:
    sys.path.insert(0, str(ROOT / "lib"))
    import release_registry as registry
    import release_state

    parser = argparse.ArgumentParser(prog="last-stack-release-publish", description=__doc__.split("\n\n")[0])
    parser.add_argument("--lastdb-version", help="the proved node build string")
    parser.add_argument("--version-tag", help="stable tag; default next patch after the latest tap tag")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--skip-brew", action="store_true", help="registry only; node already on brew")
    parser.add_argument("--skip-registry", action="store_true", help="brew only; registry already promoted")
    parser.add_argument("--fold-promote-script", help="accepted LastDB promotion helper")
    parser.add_argument("--lastdb-bin", help="LastDB signer with the existing release trust key")
    parser.add_argument("--signing-key-lastsecrets", default=os.environ.get("LASTDB_REGISTRY_SIGNING_KEY_LASTSECRETS", ""))
    parser.add_argument("--registry-tap-dir", default=os.environ.get("LAST_STACK_REGISTRY_TAP_DIR", ""),
                        help="dedicated clean registry DEV worktree at current accepted main")
    parser.add_argument("--formula-tap-dir", default=os.environ.get("LAST_STACK_FORMULA_TAP_DIR", ""),
                        help="independent clean formula DEV worktree at current accepted main")
    parser.add_argument("--no-verify-reachable", action="store_true", help="retired; real releases always verify source reachability")
    parser.add_argument("--if-needed", action="store_true", help="skip halves already published; no next rows means no publication")
    parser.add_argument("--resolve-promote-script", action="store_true", help="resolve accepted LastDB helper and exit")
    args = parser.parse_args(argv)
    if args.resolve_promote_script:
        find_promote_script(args.fold_promote_script)
        return 0
    if not args.lastdb_version:
        parser.error("--lastdb-version is required")
    if not args.dry_run and (args.fold_promote_script or os.environ.get("LAST_STACK_CANARY_FORGE_PROMOTE")):
        parser.error("real publication resolves the promotion helper from accepted LastDB main")
    if args.no_verify_reachable:
        parser.error("source reachability is required for stable publication")
    if TAP_REPO != registry.TAP_REPO or TAP_URL != registry.TAP_URL or PUBLIC_TAP_URL != registry.TAP_URL:
        parser.error("stable publication uses the exact GitHub homebrew-lastdb tap")
    build = args.lastdb_version.strip()
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+[A-Za-z0-9.-]{0,100}", build):
        parser.error("the selected build string is invalid")
    build_dir, oid = find_staged_build(build)
    if not re.fullmatch(r"[0-9a-f]{40}", oid):
        parser.error("the staged Mini source must be a full accepted OID")
    if args.if_needed:
        published = tap_state_for_build(build, oid)
        if not published["next_rows"]:
            print(f"RELEASE_PUBLISH build={build} skipped=no_next_rows")
            return 0
        args.skip_registry |= published["stable_complete"]
        args.skip_brew |= published["brew_release_oid"] == oid
        if args.skip_brew and args.skip_registry:
            print(f"RELEASE_PUBLISH build={build} tag={published['brew_tag']} brew=already registry=already")
            return 0
        if args.skip_brew and not args.version_tag:
            args.version_tag = published["brew_tag"]
    try:
        previous = None if args.dry_run else release_state.prior(PROMOTE_ROOT, build, oid)
    except release_state.ReceiptRefused:
        die("the prior exact release receipt is invalid; publication stays held")
    if previous:
        tag = previous.get("stable_tag", "")
        if not SEMVER_TAG.fullmatch(tag) or (args.version_tag and args.version_tag != tag):
            die("the prior exact release tag differs; publication stays held")
    else:
        tag = next_stable_tag(build, args.version_tag)
    out_dir = PROMOTE_ROOT / dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d")
    out_dir.mkdir(parents=True, exist_ok=True)
    summary = {"at": utc_now(), "lastdb_version": build, "source_git_oid": oid,
               "stable_tag": tag, "brew": "skipped", "registry": "skipped", "dry_run": args.dry_run}
    state = None
    try:
        if previous:
            state = release_state.ReleaseState(PROMOTE_ROOT, summary)
        binary = registry.binary_and_trust(args.lastdb_bin)
        if not args.skip_registry:
            registry.signing_source(args.signing_key_lastsecrets)
        with tempfile.TemporaryDirectory(prefix="release-stable-prepare.") as scratch_dir:
            scratch = Path(scratch_dir)
            if args.dry_run:
                tap = registry.scratch_tap(scratch / "tap")
                base = ""
                formula = tap
            else:
                tap, base = registry.clean_dev(args.registry_tap_dir)
                formula = None
                if not args.skip_brew:
                    formula, _ = registry.clean_dev(args.formula_tap_dir)
                    if formula == tap:
                        raise registry.Refused("formula and registry need independent DEV worktrees")
            prepared = registry.prepare(ROOT, tap, build, oid, binary, args.signing_key_lastsecrets,
                                        scratch, skip_registry=args.skip_registry)
            summary["registry"] = "verified-existing" if prepared is None else "prepared"
            if not args.dry_run:
                state = release_state.ReleaseState(PROMOTE_ROOT, summary)
            if state:
                summary["registry_base"] = base
                summary["registry_dev"] = str(tap)
                state.save()
            if not args.skip_brew:
                helper, helper_source = find_promote_script(args.fold_promote_script)
                summary["promotion_helper_source"] = helper_source
                artifacts = out_dir / f"artifacts-{tag}"
                stage_assets(build_dir, artifacts)
                cmd = ["bash", str(helper), "--version-tag", tag, "--artifact-dir", str(artifacts),
                       "--source-git-oid", oid, "--proof-report", str(out_dir / f"proof-{tag}.json"),
                       "--formula-venue", "github", "--tap-dir", str(formula), "--require-dev-worktree",
                       "--dry-run" if args.dry_run else "--publish"]
                summary["brew"] = "requested"
                proof_path = out_dir / f"proof-{tag}.json"
                summary["formula_proof_receipt"] = str(proof_path)
                if state:
                    state.stage("brew", "helper_requested", formula_dev=str(formula), helper_source=helper_source)
                try:
                    registry.command(cmd, timeout=600)
                finally:
                    if state and proof_path.is_file():
                        state.formula_proof(proof_path)
                proof = release_state.read(proof_path)
                summary["brew"] = "dry-run" if args.dry_run else proof["live_outputs"]["tap_pr_url"]
            if prepared is not None:
                summary["registry"] = "dry-run" if args.dry_run else registry.publish(tap, base, prepared, build, tag, out_dir, state)
    except (registry.Refused, release_state.ReceiptRefused, OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
        summary["status"] = "refused"
        summary["reason"] = str(exc) if isinstance(exc, (registry.Refused, release_state.ReceiptRefused)) else "release preparation or receipt refused"
        print(f"last-stack-release-publish: {summary['reason']}", file=sys.stderr)
        return 1
    finally:
        receipt = out_dir / f"release-publish-{tag}.json"
        try:
            if state:
                state.save()
            release_state.write(receipt, summary)
        except (OSError, ValueError, release_state.ReceiptRefused):
            print("last-stack-release-publish: durable release receipt refused; publication stays held", file=sys.stderr)
            return 1
    print(f"RELEASE_PUBLISH build={build} tag={tag} brew={summary['brew']} registry={summary['registry']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
