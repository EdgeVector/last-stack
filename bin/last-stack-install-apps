#!/usr/bin/env bash
# Install the usable LastDB app stack from public repos.
set -euo pipefail

TARGET_DIR="${LASTDB_APPS_DIR:-$HOME/lastdb-apps}"
INSTALL_LASTDB=1
LINK_CLIS=1
# Install by proof (registry index) unless a candidate set pins every commit.
PINS_FILE="${LASTDB_APPS_PINS:-}"
CHANNEL="${LASTDB_APPS_CHANNEL:-stable}"
PROOF_MODE="${LASTDB_APPS_PROOF:-auto}"   # auto | require | off
ALLOW_UNPROVED=0
RECEIPTS_DIR=""
SOURCE_ONLY=0

usage() {
  cat <<'USAGE'
last-stack-install-apps [options]

Downloads the stable LastDB app stack from public GitHub:
  LastDB daemon, loom and lastseek (Homebrew binaries), brain, kanban (fkanban), situations, routines,
  dogfood-graph, org, lastsecrets, search, LastDB Browser, and the optional
  Kanban Factory theater UI.

  org + lastsecrets are required for invite/join ("join my org") onboarding.
  search owns the local semantic MiniLM plane brain/kanban prefer for ask/search.
  lastdb-browser provides a read-only local UI for schemas, keys, records, and
  atoms through the machine's own LastDB unix socket.
  kanban-factory is an optional local animated board UI (Node; no npm install).

Options:
  --dir <path>      clone/update app repos under this directory
                   (default: ~/lastdb-apps or $LASTDB_APPS_DIR)
  --no-brew         skip the Homebrew formulas (LastDB daemon, loom, lastseek)
  --no-link         skip linking CLI commands onto PATH
  --pins <file>     candidate set (last-stack-canary-candidate-set): install
                   each app at exactly the pinned commit from its pinned source
  --channel <c>     registry index channel for install-by-proof (default:
                   stable, or $LASTDB_APPS_CHANNEL)
  --no-proof        do not consult the registry index; clone main (legacy)
  --allow-unproved  when the index has no row proved with this node, fall back
                   to main with a warning instead of failing
  --source-only     check out sources only; skip dependency installs and links
  -h, --help        show this help

Install by proof: when the installed `lastdb` knows `app resolve`, each app
is checked out at the newest commit the signed registry index proves with the
running LastDB build (`lastdb app resolve <app> --channel <c>`). An older
`lastdb` without that verb falls back to cloning main and says so.

LastGit is intentionally not installed by this bundle yet (review venue for
EdgeVector contributors). Public app source is GitHub so a cold first install
needs no running LastDB node and no LastGit remote helper.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir)
      TARGET_DIR="$2"
      shift 2
      ;;
    --dir=*)
      TARGET_DIR="${1#*=}"
      shift
      ;;
    --no-brew)
      INSTALL_LASTDB=0
      shift
      ;;
    --no-link)
      LINK_CLIS=0
      shift
      ;;
    --pins)
      PINS_FILE="$2"
      shift 2
      ;;
    --pins=*)
      PINS_FILE="${1#*=}"
      shift
      ;;
    --channel)
      CHANNEL="$2"
      shift 2
      ;;
    --channel=*)
      CHANNEL="${1#*=}"
      shift
      ;;
    --no-proof)
      PROOF_MODE=off
      shift
      ;;
    --allow-unproved)
      ALLOW_UNPROVED=1
      shift
      ;;
    --source-only)
      SOURCE_ONLY=1
      LINK_CLIS=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

clone_or_update() {
  local name="$1"
  local url="$2"
  local dest="$TARGET_DIR/$name"
  local optional="${3:-}"

  if [ -d "$dest/.git" ]; then
    echo "==> updating $name"
    if ! git -C "$dest" pull --ff-only; then
      if [ "$optional" = "optional" ]; then
        echo "    warning: could not update optional app $name — skipping" >&2
        return 1
      fi
      return 1
    fi
    return 0
  elif [ -e "$dest" ]; then
    echo "refusing to overwrite non-git path: $dest" >&2
    return 1
  else
    echo "==> cloning $name"
    if ! git clone "$url" "$dest"; then
      if [ "$optional" = "optional" ]; then
        echo "    warning: could not clone optional app $name from $url — skipping" >&2
        echo "    (if the repo is private, authenticate to GitHub or install it later)" >&2
        return 1
      fi
      echo "failed to clone $name from $url" >&2
      return 1
    fi
    return 0
  fi
}

# A candidate set can name a LastGit source (lastdb:///<repo>): since LastGit
# era 3 (2026-09-26/27) that is every app's gate of record, and the Forgejo
# copy is frozen. Only the internal proving path (Tom's machine) writes such a
# set; a public install resolves GitHub sources and never reaches this.
#
# git reaches lastdb:// through the `git-remote-lastdb` helper, which finds
# the node socket and its schema map under $HOME. The install smoke runs under
# a throwaway HOME, so point the helper at the login user's node unless the
# caller already chose one. The helper only reads refs and packs here.
LASTGIT_TRANSPORT_READY=""
prepare_lastgit_transport() {
  local name="$1" login sock map
  [ -z "$LASTGIT_TRANSPORT_READY" ] || return 0
  if ! command -v git-remote-lastdb >/dev/null 2>&1; then
    echo "$name: the pinned source is a lastdb:// LastGit remote, and git-remote-lastdb is not on PATH" >&2
    return 1
  fi
  login="$(login_home)"
  if [ -n "$login" ] && [ "${HOME:-}" != "$login" ]; then
    sock="$login/.lastdb/data/folddb.sock"
    map="$login/.lastgit/schema-map.json"
    if [ -z "${LASTGIT_SOCKET:-}" ] && [ -S "$sock" ]; then
      export LASTGIT_SOCKET="$sock"
    fi
    if [ -z "${LASTGIT_SCHEMA_MAP:-}" ] && [ -f "$map" ]; then
      export LASTGIT_SCHEMA_MAP="$map"
    fi
  fi
  LASTGIT_TRANSPORT_READY=1
  return 0
}

# Check out `sha` from `url` at $TARGET_DIR/$name. An existing clone is
# fetched and moved; a fresh directory is cloned. HEAD is verified.
install_pinned() {
  local name="$1" url="$2" sha="$3" why="$4"
  local dest="$TARGET_DIR/$name" head origin
  case "$url" in
    lastdb://*) prepare_lastgit_transport "$name" || return 1 ;;
  esac
  if [ -d "$dest/.git" ]; then
    echo "==> pinning $name to ${sha:0:12} ($why)"
    # The pinned source wins over whatever an earlier run cloned from. Since
    # LastGit era 3 an app's gate of record moved from Forgejo to LastGit, so
    # a clone made from the frozen Forgejo copy never sees a newer commit.
    origin="$(git -C "$dest" remote get-url origin 2>/dev/null || true)"
    if [ -n "$url" ] && [ "$origin" != "$url" ]; then
      git -C "$dest" remote set-url origin "$url" 2>/dev/null \
        || git -C "$dest" remote add origin "$url" || return 1
    fi
    if ! git -C "$dest" cat-file -e "${sha}^{commit}" 2>/dev/null; then
      git -C "$dest" fetch --quiet origin || git -C "$dest" fetch --quiet origin "$sha" || {
        echo "failed to fetch $name from $(git -C "$dest" remote get-url origin 2>/dev/null || echo origin)" >&2
        return 1
      }
      if ! git -C "$dest" cat-file -e "${sha}^{commit}" 2>/dev/null; then
        git -C "$dest" fetch --quiet origin "$sha" 2>/dev/null || true
      fi
    fi
    git -C "$dest" checkout --quiet --detach "$sha" || {
      echo "proved commit ${sha:0:12} for $name is not in its source $(git -C "$dest" remote get-url origin 2>/dev/null || echo origin)" >&2
      return 1
    }
  elif [ -e "$dest" ]; then
    echo "refusing to overwrite non-git path: $dest" >&2
    return 1
  else
    echo "==> cloning $name at ${sha:0:12} ($why)"
    git clone --quiet --no-checkout "$url" "$dest" || {
      echo "failed to clone $name from $url" >&2
      return 1
    }
    git -C "$dest" checkout --quiet --detach "$sha" || {
      echo "proved commit ${sha:0:12} for $name is not in $url" >&2
      return 1
    }
  fi
  head="$(git -C "$dest" rev-parse HEAD)"
  case "$head" in
    "$sha"*|*"$sha") ;;
    *)
      echo "$name checkout HEAD $head is not the proved commit $sha" >&2
      return 1
      ;;
  esac
  return 0
}

write_receipt() {
  local name="$1" json="$2"
  [ -n "$RECEIPTS_DIR" ] || RECEIPTS_DIR="$TARGET_DIR/.lastdb-app-receipts"
  mkdir -p "$RECEIPTS_DIR"
  printf '%s\n' "$json" >"$RECEIPTS_DIR/$name.json"
}

# Does the installed `lastdb` know `app resolve`? Cached after the first call.
LASTDB_RESOLVE_AVAILABLE=""
lastdb_can_resolve() {
  if [ -z "$LASTDB_RESOLVE_AVAILABLE" ]; then
    if command -v lastdb >/dev/null 2>&1 && lastdb app resolve --help >/dev/null 2>&1; then
      LASTDB_RESOLVE_AVAILABLE=1
    else
      LASTDB_RESOLVE_AVAILABLE=0
    fi
  fi
  [ "$LASTDB_RESOLVE_AVAILABLE" = 1 ]
}

# Install `name` (registry app id == install name for this bundle) from the
# candidate set, else by proof, else the legacy main clone.
#   returns 0 installed, 1 hard failure
#   APP_ATTEMPT_SHA / APP_ATTEMPT_SOURCE name what it tried, for the receipt
#   of a failed app.
APP_ATTEMPT_SHA=""
APP_ATTEMPT_SOURCE=""
install_app_source() {
  local name="$1" url="$2" optional="${3:-}"
  local pin_json sha psrc resolved err
  APP_ATTEMPT_SHA=""
  APP_ATTEMPT_SOURCE="$url"
  if [ -n "$PINS_FILE" ]; then
    pin_json="$(jq -c --arg n "$name" '.apps | to_entries[] | select(.value.install_name == $n or .key == $n) | .value' "$PINS_FILE" 2>/dev/null | head -n1 || true)"
    if [ -n "$pin_json" ]; then
      sha="$(printf '%s' "$pin_json" | jq -r '.sha')"
      psrc="$(printf '%s' "$pin_json" | jq -r '.source // empty')"
      [ -n "$psrc" ] || psrc="$url"
      APP_ATTEMPT_SHA="$sha"
      APP_ATTEMPT_SOURCE="$psrc"
      install_pinned "$name" "$psrc" "$sha" "candidate set" || return 1
      write_receipt "$name" "$(jq -cn --arg n "$name" --arg sha "$sha" --arg src "$psrc" --arg mode pinned --arg pins "$PINS_FILE" \
        '{app_id:$n, sha:$sha, source:$src, mode:$mode, pins:$pins}')"
      return 0
    fi
  fi
  if [ "$PROOF_MODE" != off ] && lastdb_can_resolve; then
    set +e
    resolved="$(lastdb app resolve "$name" --channel "$CHANNEL" --json 2>"$TARGET_DIR/.resolve.err")"
    err=$?
    set -e
    if [ "$err" -eq 0 ]; then
      sha="$(printf '%s' "$resolved" | jq -r '.sha')"
      psrc="$(printf '%s' "$resolved" | jq -r '.source')"
      APP_ATTEMPT_SHA="$sha"
      APP_ATTEMPT_SOURCE="$psrc"
      install_pinned "$name" "$psrc" "$sha" "proved with lastdb $(printf '%s' "$resolved" | jq -r '.lastdb_version') by $(printf '%s' "$resolved" | jq -r '.proof_run')" || return 1
      write_receipt "$name" "$(printf '%s' "$resolved" | jq -c '. + {mode:"proved"}')"
      rm -f "$TARGET_DIR/.resolve.err"
      return 0
    fi
    echo "    registry: $(tr '\n' ' ' <"$TARGET_DIR/.resolve.err")" >&2
    rm -f "$TARGET_DIR/.resolve.err"
    if [ "$ALLOW_UNPROVED" -ne 1 ]; then
      echo "no $CHANNEL row for $name is proved with this LastDB build; pass --allow-unproved to clone main anyway" >&2
      return 1
    fi
    echo "    warning: installing $name from main WITHOUT a proved row (--allow-unproved)" >&2
  elif [ "$PROOF_MODE" != off ]; then
    echo "    note: this lastdb has no \`app resolve\`; installing $name from main (unproved). \`brew upgrade lastdb\` enables install-by-proof." >&2
  fi
  clone_or_update "$name" "$url" "$optional" || return 1
  write_receipt "$name" "$(jq -cn --arg n "$name" --arg src "$url" --arg sha "$(git -C "$TARGET_DIR/$name" rev-parse HEAD 2>/dev/null || echo unknown)" \
    '{app_id:$n, sha:$sha, source:$src, mode:"unproved-main"}')"
  return 0
}

run_bun_install() {
  local name="$1"
  local dest="$TARGET_DIR/$name"
  [ -f "$dest/package.json" ] || return 0
  echo "==> installing dependencies for $name"
  local cache_dir="${BUN_INSTALL_CACHE_DIR:-${HOME:-/tmp}/.cache/bun}"
  mkdir -p "$cache_dir"
  # One dependency download must not fail a release proof. This step runs inside
  # the llms-txt install smoke, whose GREEN verdict is what writes the app
  # registry `next` rows, so a single transient fetch error costs the whole
  # fleet a delivery cycle. Measured 2026-09-26T11:0xZ: an apps-only canary pass
  # went RED on `error: Fail extracting tarball for "protobufjs"` while
  # installing `search`, with all nine pinned checkouts OK -- and the identical
  # pinned sha installed clean in 3.81s on a retry outside the sandbox. The
  # smoke uses a throwaway HOME, so its bun cache is always cold and every
  # package is a fresh download.
  #
  # The same class cost a registry row two days earlier through npm: see
  # install_lastdb_browser below, whose comment records the 2026-09-24 canary
  # smoke RED. That one was deterministic and needed a real fix; this one is a
  # fetch, and a fetch gets retried.
  local attempts="${LAST_STACK_BUN_INSTALL_ATTEMPTS:-3}" attempt=1 backoff
  while :; do
    if bun install --cwd "$dest" --cache-dir "$cache_dir"; then
      return 0
    fi
    if [ "$attempt" -ge "$attempts" ]; then
      echo "    bun install for $name failed $attempt time(s); giving up" >&2
      return 1
    fi
    # LAST_STACK_BUN_INSTALL_SLEEP exists so the guard test can exercise the
    # retry without burning the real backoff; a fixture that waits 15 real
    # seconds is a fixture nobody runs.
    backoff="${LAST_STACK_BUN_INSTALL_SLEEP:-$(( attempt * 5 ))}"
    echo "    bun install for $name failed (attempt $attempt/$attempts); retrying in ${backoff}s" >&2
    [ "$backoff" -le 0 ] || sleep "$backoff"
    attempt=$(( attempt + 1 ))
  done
}

install_lastdb_browser() {
  local dest="$TARGET_DIR/lastdb-browser"
  echo "==> building lastdb-browser"
  # Run npm inside the package, not with --prefix. With npm 11.19.1,
  # `npm --prefix <dir> ci` fails on this lockfile from any working
  # directory ("Missing: <dir-name>@0.1.0 from lock file"), while a plain
  # `npm ci` in <dir> passes. It turned the 2026-09-24 canary smoke RED, so
  # no registry row was proved for LastDB 2321 and kanban could not install.
  # Explicit `|| return 1`: the caller checks the result, so set -e is off here.
  (cd "$dest" && npm ci --no-audit --no-fund && npm run build) || return 1
  test -f "$dest/dist/index.html" || {
    echo "lastdb-browser build did not produce dist/index.html" >&2
    return 1
  }
}

ensure_user_bin() {
  mkdir -p "$HOME/.local/bin"
  export PATH="$HOME/.local/bin:${PATH:-}"
}

link_existing_cli() {
  local src="$1"
  local command_name="$2"
  [ -x "$src" ] || {
    echo "missing executable for $command_name: $src" >&2
    return 1
  }
  ensure_user_bin
  ln -snf "$src" "$HOME/.local/bin/$command_name"
}

write_bun_cli_shim() {
  local entrypoint="$1"
  local command_name="$2"
  [ -f "$entrypoint" ] || {
    echo "missing Bun CLI entrypoint for $command_name: $entrypoint" >&2
    return 1
  }
  ensure_user_bin
  cat >"$HOME/.local/bin/$command_name" <<EOF
#!/usr/bin/env bash
set -euo pipefail
exec bun "$entrypoint" "\$@"
EOF
  chmod +x "$HOME/.local/bin/$command_name"
}

# Login-user home (not process $HOME). Homebrew evaluates Dir.home into the
# formula service plist at install/reinstall time; running `brew install` under
# an ephemeral/sandbox HOME freezes that path into the machine-wide service.
login_home() {
  local real_home=""
  real_home="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
  if [ -z "$real_home" ]; then
    real_home="$(eval echo "~$(id -un)" 2>/dev/null || true)"
  fi
  if [ -z "$real_home" ]; then
    real_home="${HOME:-}"
  fi
  printf '%s\n' "$real_home"
}

# Apps that ship as public Homebrew binaries from the same tap (Tom
# 2026-09-23: loom and lastseek; the source stays private). A formula that is
# not published yet, or a failed install, warns and continues: the rest of the
# bundle still works, and report_unmet_requires names what is missing.
BREW_APPS="loom lastseek"
BREW_APPS_INSTALLED=""
install_brew_apps() {
  local tap="edgevector/lastdb" app brew_home
  brew_home="$(login_home)"
  for app in $BREW_APPS; do
    echo "==> installing $app (Homebrew binary)"
    if [ -n "$brew_home" ] && [ "${HOME:-}" != "$brew_home" ]; then
      HOME="$brew_home" brew install "$tap/$app" && BREW_APPS_INSTALLED="$BREW_APPS_INSTALLED $app" && continue
    else
      brew install "$tap/$app" && BREW_APPS_INSTALLED="$BREW_APPS_INSTALLED $app" && continue
    fi
    echo "    warning: could not install $tap/$app; the rest of the bundle continues" >&2
  done
}

install_lastdb_formula() {
  local tap="edgevector/lastdb"
  local formula="$tap/lastdb"
  local trust_formula="$tap/folddb"
  local brew_home=""

  need brew
  echo "==> installing LastDB daemon"
  if ! brew tap | grep -Fxq "$tap"; then
    brew tap "$tap"
  fi

  if brew trust --help 2>/dev/null | grep -q -- '--tap'; then
    brew trust --tap "$tap"
  else
    brew trust --formula "$trust_formula"
  fi

  brew_home="$(login_home)"
  if [ -n "$brew_home" ] && [ "${HOME:-}" != "$brew_home" ]; then
    echo "    note: running brew under login HOME=$brew_home (process HOME=${HOME:-} is not the login home)"
    # Prevent brew reinstall/service rewrite from baking a sandbox HOME into the
    # machine-wide launchd plist used by `brew services start lastdb`.
    HOME="$brew_home" brew install "$formula"
  else
    brew install "$formula"
  fi
}

link_cli() {
  local name="$1"
  local dest="$TARGET_DIR/$name"
  [ "$LINK_CLIS" -eq 1 ] || return 0
  [ -d "$dest" ] || return 0

  case "$name" in
    kanban)
      echo "==> linking kanban CLI"
      # Ensure a user bin dir exists for first-run machines (install-cli creates
      # ~/.local/bin when needed, but put it on PATH for this process too).
      ensure_user_bin
      (cd "$dest" && bun run install-cli "$HOME/.local/bin")
      ;;
    situations)
      if [ -x "$dest/bin/situations" ]; then
        echo "==> linking situations CLI"
        ensure_user_bin
        ln -snf "$dest/bin/situations" "$HOME/.local/bin/situations"
      fi
      ;;
    routines)
      echo "==> linking routines CLI"
      link_existing_cli "$dest/bin/routines" routines
      ;;
    brain)
      echo "==> linking brain CLI"
      # Chained: link_cli runs inside a failure check, where set -e is off.
      link_existing_cli "$dest/bin/brain" brain &&
        link_existing_cli "$dest/bin/brain-mcp" brain-mcp
      ;;
    lastsecrets)
      echo "==> linking lastsecrets CLI"
      write_bun_cli_shim "$dest/src/cli.ts" lastsecrets
      ;;
    org)
      echo "==> linking org CLI"
      write_bun_cli_shim "$dest/src/cli.ts" org
      ;;
    search)
      echo "==> linking search CLI"
      # Prefer committed bin/search (bun entry) when present.
      if [ -x "$dest/bin/search" ]; then
        link_existing_cli "$dest/bin/search" search
      else
        write_bun_cli_shim "$dest/src/cli.ts" search
      fi
      ;;
    lastdb-browser)
      echo "==> linking lastdb-browser launcher"
      link_existing_cli "$dest/bin/lastdb-browser" lastdb-browser
      ;;
  esac
}

need git
need jq
if [ "$SOURCE_ONLY" -ne 1 ]; then
  need bun
  need npm
fi

if [ "$INSTALL_LASTDB" -eq 1 ]; then
  install_lastdb_formula
  install_brew_apps
  if [ -x "$(dirname "$0")/last-stack-lastdb-current" ]; then
    echo "==> linking LastDB daemon through ~/.lastdb/current"
    brew_prefix="$(brew --prefix edgevector/lastdb/lastdb 2>/dev/null || brew --prefix lastdb 2>/dev/null || true)"
    if [ -n "$brew_prefix" ] && [ -x "$brew_prefix/bin/lastdbd" ]; then
      "$(dirname "$0")/last-stack-lastdb-current" set --bin-dir "$brew_prefix/bin"
    elif command -v lastdbd >/dev/null 2>&1; then
      "$(dirname "$0")/last-stack-lastdb-current" set
    fi
  fi
fi

mkdir -p "$TARGET_DIR"

# All required apps are public on GitHub so invitees can cold-install without
# LastGit, without a running node, and without GitHub org membership.
# A failed app still fails the install (invite/join needs org + lastsecrets
# linked), but only after every other app has had its own attempt.
#
# Why per-app (2026-09-28): this loop used to `exit 1` on the first failure.
# `routines` is 4th; when its pinned commit was not on its source, the 5 apps
# after it were never tried, got no receipt, and the canary smoke reported all
# 6 as `missing`. That hid which app was broken and kept every registry `next`
# row unwritten for days.
# papercut-canary-primary-rows-smoke-red-0-23-3-2375-ga7bac36f1
if [ -n "$PINS_FILE" ]; then
  [ -f "$PINS_FILE" ] || { echo "--pins file not found: $PINS_FILE" >&2; exit 2; }
  echo "==> candidate set: $PINS_FILE (lastdb $(jq -r '.lastdb.build // "?"' "$PINS_FILE"))"
fi

BUNDLE_APPS="brain kanban situations routines dogfood-graph org lastsecrets search lastdb-browser"
FAILED_APPS=""      # "<app>:<stage>" words, in install order
app_failed() {
  case " $FAILED_APPS " in
    *" $1:"*) return 0 ;;
  esac
  return 1
}
record_failure() {
  # record_failure <app> <stage>: remember it and overwrite the receipt, so a
  # receipt from an earlier good run never claims this run installed the app.
  local name="$1" stage="$2" sha="$APP_ATTEMPT_SHA" src="$APP_ATTEMPT_SOURCE" prior
  FAILED_APPS="${FAILED_APPS:+$FAILED_APPS }$name:$stage"
  if [ "$stage" != source ]; then
    # The source step passed and wrote a receipt; keep the commit it names.
    prior="${RECEIPTS_DIR:-$TARGET_DIR/.lastdb-app-receipts}/$name.json"
    sha="$(jq -r '.sha // ""' "$prior" 2>/dev/null || true)"
    src="$(jq -r '.source // ""' "$prior" 2>/dev/null || true)"
  fi
  write_receipt "$name" "$(jq -cn --arg n "$name" --arg stage "$stage" \
    --arg sha "$sha" --arg src "$src" \
    '{app_id:$n, mode:"failed", stage:$stage, sha:$sha, source:$src}')"
  echo "    FAILED $name ($stage); continuing with the other apps" >&2
}
public_source_for() {
  case "$1" in
    kanban) printf '%s\n' "https://github.com/EdgeVector/fkanban.git" ;;
    *) printf 'https://github.com/EdgeVector/%s.git\n' "$1" ;;
  esac
}

for app in $BUNDLE_APPS; do
  if ! install_app_source "$app" "$(public_source_for "$app")"; then
    record_failure "$app" source
  fi
done
# Optional UI: animated live theater for the board (Node; no package install).
# Soft-fail so a private/unreachable mirror never blocks the core stack. It is
# not part of the proved set, so it always tracks main.
clone_or_update kanban-factory "https://github.com/EdgeVector/kanban-factory.git" optional || true

for app in $BUNDLE_APPS; do
  if [ "$SOURCE_ONLY" -eq 1 ]; then
    continue
  fi
  # No dependencies and no links for an app whose source did not install:
  # its directory is absent or holds an older checkout.
  app_failed "$app" && continue
  if [ "$app" = "lastdb-browser" ]; then
    if ! install_lastdb_browser; then
      record_failure "$app" dependencies
      continue
    fi
  elif ! run_bun_install "$app"; then
    record_failure "$app" dependencies
    continue
  fi
  if ! link_cli "$app"; then
    record_failure "$app" link
  fi
done

# Report every declared `requires` edge that this bundle leaves unmet: the app
# is installed, the app it needs is neither in the bundle nor on PATH. The
# registry ships with last-stack; a bare copy of this script skips the report.
report_unmet_requires() {
  local registry="$1" installed="$2" gaps
  [ -f "$registry" ] || return 0
  gaps="$(jq -r --argjson installed "$installed" '
    ((.apps // {}) + (.brew_apps // {})) | to_entries[]
    | select(.key as $k | $installed | index($k))
    | .key as $app
    | (.value.requires // [])[]
    | select(. as $d | $installed | index($d) | not)
    | [$app, .] | @tsv' "$registry")" || return 0
  [ -n "$gaps" ] || return 0
  while IFS=$'\t' read -r app dep; do
    if command -v "$dep" >/dev/null 2>&1; then
      continue
    fi
    printf 'WARNING: %s requires %s, and this bundle does not install %s yet.\n' "$app" "$dep" "$dep" >&2
    printf '         %s may fail until %s is on PATH.\n' "$app" "$dep" >&2
  done <<<"$gaps"
}
# Resolve $0 first: behind a ~/.local/bin symlink dirname "$0"/.. is ~/.local.
INSTALL_APPS_ROOT="$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd -P)"
INSTALLED_APPS=""
for app in $BUNDLE_APPS; do
  app_failed "$app" || INSTALLED_APPS="$INSTALLED_APPS $app"
done
report_unmet_requires "$INSTALL_APPS_ROOT/config/registry/apps.json" \
  "$(printf '%s\n' $INSTALLED_APPS $BREW_APPS_INSTALLED | jq -R . | jq -sc 'map(select(length > 0))')"

if [ -n "$FAILED_APPS" ]; then
  n_failed=0
  for f in $FAILED_APPS; do n_failed=$((n_failed + 1)); done
  printf '\n' >&2
  printf 'install-apps: %s of %s apps FAILED; every other app was attempted.\n' \
    "$n_failed" "$(printf '%s\n' $BUNDLE_APPS | wc -l | tr -d ' ')" >&2
  for f in $FAILED_APPS; do
    printf '  FAILED %s (stage: %s)\n' "${f%%:*}" "${f#*:}" >&2
  done
  printf 'Receipts: %s\n' "${RECEIPTS_DIR:-$TARGET_DIR/.lastdb-app-receipts}" >&2
  exit 1
fi

printf '\n'
printf 'Installed LastDB apps under:\n'
printf '  %s\n\n' "$TARGET_DIR"
printf 'Next steps:\n'
printf '  brew services start lastdb\n'
printf '  brain init --grant-consent\n'
printf '  kanban init\n'
printf '  situations init\n'
printf '  lastsecrets init\n'
printf '  org init\n'
printf '  search init   # online semantic index bootstrap (daemon may stay up)\n'
printf '  lastdb-browser   # opens the read-only local data browser\n'
printf '\n'
printf 'Dogfood Graph is a local app:\n'
printf '  cd "%s/dogfood-graph" && npm run dev\n\n' "$TARGET_DIR"
if [ -d "$TARGET_DIR/kanban-factory" ]; then
  printf 'Kanban Factory (optional animated board theater, Node 18+):\n'
  printf '  cd "%s/kanban-factory" && node server.mjs\n' "$TARGET_DIR"
  printf '  # → http://127.0.0.1:4177\n'
  printf '  # macOS auto-start: ./scripts/install-launchd.sh install\n\n'
else
  printf 'Kanban Factory was not installed (optional). Manual:\n'
  printf '  git clone https://github.com/EdgeVector/kanban-factory.git\n'
  printf '  cd kanban-factory && node server.mjs\n\n'
fi
printf 'Make sure ~/.local/bin and ~/.bun/bin are on PATH if linked commands are not found.\n'
