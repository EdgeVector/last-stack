#!/usr/bin/env python3
"""Capture a fresh driver snapshot and fence each supported board mutation.

The run ledger survives recapture. A reserved slot remains consumed after an
uncertain command result; a retry needs a new run and fresh point reads.
"""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid


class Refusal(Exception):
    def __init__(self, reason, code=1):
        self.reason, self.code = reason, code


def refuse(reason, code=1):
    raise Refusal(reason, code)


def load(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        refuse(f"invalid-json path={path}")


def save(path, value):
    temporary = path.with_name(path.name + '.' + uuid.uuid4().hex)
    with temporary.open('w') as stream:
        stream.write(json.dumps(value, indent=2) + '\n')
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


def point_read(board, argv):
    try:
        result = subprocess.run([board, *argv, '--json'], capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        refuse(f"point-read-timeout command={' '.join(argv)} seconds=30")
    if result.returncode:
        refuse(f"point-read-failed command={' '.join(argv)} rc={result.returncode}")
    try:
        value = json.loads(result.stdout)
        if not isinstance(value, dict):
            refuse(f"point-read-invalid command={' '.join(argv)}")
        return value
    except ValueError:
        refuse(f"point-read-invalid command={' '.join(argv)}")


def detail(board, slug):
    if not isinstance(slug, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', slug):
        refuse('invalid-milestone-slug')
    value = point_read(board, ['milestone', 'detail', slug])
    milestone = value.get('milestone', {})
    if (not isinstance(milestone, dict) or milestone.get('slug') != slug
        or not isinstance(milestone.get('deps'), list)
        or not all(isinstance(dep, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', dep) for dep in milestone['deps'])):
        refuse(f"milestone-evidence-invalid slug={slug}")
    return value


def prerequisites(board, root):
    visiting, checked = set(), set()
    cache = {root['milestone']['slug']: root}

    def check(value):
        slug = value['milestone']['slug']
        if slug in visiting:
            refuse(f"dependency-cycle slug={slug}")
        if slug in checked:
            return
        if len(checked) + len(visiting) >= 128:
            refuse('dependency-bound-exceeded')
        visiting.add(slug)
        for dependency in value['milestone']['deps']:
            if dependency not in cache:
                if len(cache) >= 128:
                    refuse('dependency-bound-exceeded')
                cache[dependency] = detail(board, dependency)
            dep = cache[dependency]
            ms = dep['milestone']
            if ms.get('state') != 'complete' or dep.get('proof_verdict') not in ('passing', 'not_required'):
                refuse(f"dependency-unsatisfied slug={dependency}")
            if dep.get('proof_verdict') != ms.get('proof_status'):
                refuse(f"dependency-proof-disagrees slug={dependency}")
            check(dep)
        visiting.remove(slug)
        checked.add(slug)
    check(root)


def _list_cards(path):
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError):
        return []
    cards = value.get('cards') if isinstance(value, dict) else None
    return cards if isinstance(cards, list) else []


def _milestone_north_star(board, slug, cache):
    """Best-effort North Star lookup for a milestone slug. Empty on any doubt."""
    if not isinstance(slug, str) or not slug:
        return ''
    if slug in cache:
        return cache[slug]
    north_star = ''
    try:
        result = subprocess.run([board, 'milestone', 'show', slug, '--json'],
                                 capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            value = json.loads(result.stdout)
            if isinstance(value, dict) and value.get('slug') == slug:
                candidate = value.get('north_star')
                if isinstance(candidate, str):
                    north_star = candidate
    except (subprocess.TimeoutExpired, OSError, ValueError):
        north_star = ''
    cache[slug] = north_star
    return north_star


def _milestone_detail_best_effort(board, slug, cache):
    """Best-effort `milestone detail` read. None on any doubt -- never fatal."""
    if not isinstance(slug, str) or not slug:
        return None
    if slug in cache:
        return cache[slug]
    value = None
    try:
        result = subprocess.run([board, 'milestone', 'detail', slug, '--json'],
                                 capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            parsed = json.loads(result.stdout)
            if (isinstance(parsed, dict) and isinstance(parsed.get('milestone'), dict)
                    and parsed['milestone'].get('slug') == slug):
                value = parsed
    except (subprocess.TimeoutExpired, OSError, ValueError):
        value = None
    cache[slug] = value
    return value


def _card_best_effort(board, slug, cache):
    """Best-effort `show` read for a card slug (e.g. a proof card). None on doubt."""
    if not isinstance(slug, str) or not slug:
        return None
    if slug in cache:
        return cache[slug]
    value = None
    try:
        result = subprocess.run([board, 'show', slug, '--json'],
                                 capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            parsed = json.loads(result.stdout)
            if isinstance(parsed, dict) and parsed.get('slug') == slug:
                value = parsed
    except (subprocess.TimeoutExpired, OSError, ValueError):
        value = None
    cache[slug] = value
    return value


def _parse_timestamp(value):
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def _cadence_seconds():
    # The routine's declared cadence (routines/milestone-driver.md: hourly).
    # One stale-run grace period before we call a FAIL proof report stale.
    raw = os.environ.get('MILESTONE_DRIVER_CADENCE_SECONDS', '3600')
    try:
        value = int(raw)
    except ValueError:
        return 3600
    return value if value > 0 else 3600


_FAIL_EVIDENCE_RE = re.compile(r'^[ \t]*(?:PROOF|RESULT):[ \t]*FAIL[ \t]*$', re.M | re.I)
_SPEC_SECTION_RE = re.compile(r'^##\s*(outcome|acceptance|goal|end state)', re.M | re.I)
_BARE_SLUG_LINE_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]*$')


def _is_bare_slug_list_body(body):
    """True when a milestone body is only a newline list of sibling slugs --
    no Outcome/Acceptance/Goal/End-State spec for decompose to work from
    (papercut-milestone-driver-rollup-body-milestones-block-decompose-20260926)."""
    if not isinstance(body, str):
        return False
    lines = [line.strip() for line in body.splitlines() if line.strip()]
    if not lines:
        return False
    if _SPEC_SECTION_RE.search(body):
        return False
    return all(_BARE_SLUG_LINE_RE.fullmatch(line) for line in lines)


def _annotate_stuck_states(board, report, detail_cache, card_cache):
    """Annotate (never rename) three more dead-end states so the driver can
    act on them instead of re-reporting the same stuck count every pass.
    `action` stays exactly what the classifier emitted -- `authorize()`
    matches a guarded command back to its queue entry by that exact string,
    so renaming it here would make a legitimate later guard call (e.g.
    `milestone state <slug> complete` after a proof card gets attached)
    refuse with `action-not-in-current-queue` even though the live
    prerequisite/proof checks would otherwise allow it.

    - decompose (idle_empty) whose terminal proof report is an old FAIL:
      flag `stale_fail_proof` + `proof_card` so the driver re-runs the proof
      or files the repair card the FAIL points at, instead of treating it as
      fresh idle_empty forever.
      (papercut-milestone-driver-never-reruns-stale-fail-proof-20260926)
    - complete_proof with implementation done and no proof card at all:
      flag `missing_proof_card` so the driver files the missing proof card
      instead of leaving it uncounted every pass.
      (papercut-milestones-with-done-work-and-no-proof-card-have-no-exit-20260926)
    - decompose whose milestone body is a bare slug list (no Outcome/
      Acceptance spec): flag `needs_spec` + `sibling_milestones` so the
      driver treats it as needing a spec instead of silently skipping it.
      (papercut-milestone-driver-rollup-body-milestones-block-decompose-20260926)
    """
    work_queue = report.get('work_queue')
    if not isinstance(work_queue, list) or not work_queue:
        return report
    cadence = _cadence_seconds()
    now = datetime.now(timezone.utc)
    counts = report.get('counts')
    if not isinstance(counts, dict):
        counts = None

    def bump(name):
        if counts is not None:
            current = counts.get(name, 0)
            if not isinstance(current, (int, float)) or isinstance(current, bool):
                current = 0
            counts[name] = current + 1

    annotated = []
    for entry in work_queue:
        if not isinstance(entry, dict):
            annotated.append(entry)
            continue
        action = entry.get('action')
        slug = entry.get('slug')
        if action == 'decompose':
            detail = _milestone_detail_best_effort(board, slug, detail_cache)
            milestone = detail.get('milestone', {}) if detail else {}
            proof_card_slug = milestone.get('proof_card') if detail else None
            flagged = False
            if isinstance(proof_card_slug, str) and proof_card_slug:
                proof_card = _card_best_effort(board, proof_card_slug, card_cache)
                body = proof_card.get('body', '') if proof_card else ''
                is_terminal = bool(proof_card) and proof_card.get('column') == 'done'
                is_fail = bool(_FAIL_EVIDENCE_RE.search(body)) if isinstance(body, str) else False
                updated_at = _parse_timestamp(proof_card.get('updated_at')) if proof_card else None
                is_stale = bool(updated_at) and (now - updated_at).total_seconds() > cadence
                if is_terminal and is_fail and is_stale:
                    annotated.append({**entry, 'stale_fail_proof': True, 'proof_card': proof_card_slug})
                    bump('stale_fail_proof')
                    flagged = True
            if not flagged:
                body = milestone.get('body', '') if detail else ''
                if detail and _is_bare_slug_list_body(body):
                    siblings = [line.strip() for line in body.splitlines() if line.strip()]
                    annotated.append({**entry, 'needs_spec': True, 'sibling_milestones': siblings})
                    bump('needs_spec')
                    flagged = True
            if not flagged:
                annotated.append(entry)
        elif action == 'complete_proof':
            detail = _milestone_detail_best_effort(board, slug, detail_cache)
            milestone = detail.get('milestone', {}) if detail else {}
            proof_card_slug = milestone.get('proof_card') if detail else None
            proof_status = milestone.get('proof_status') if detail else None
            proof_verdict = detail.get('proof_verdict') if detail else None
            missing_card = detail is not None and not proof_card_slug
            already_not_required = proof_status == 'not_required' and proof_verdict == 'not_required'
            if missing_card and not already_not_required:
                annotated.append({**entry, 'missing_proof_card': True})
                bump('missing_proof_card')
            else:
                annotated.append(entry)
        else:
            annotated.append(entry)
    report['work_queue'] = annotated
    return report


def _admitted_north_stars(admission_bin):
    if not admission_bin or not Path(admission_bin).exists():
        return set()
    try:
        result = subprocess.run([admission_bin, '--work-class', 'feature', '--json'],
                                 capture_output=True, text=True, timeout=180)
        value = json.loads(result.stdout)
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return set()
    outcomes = value.get('admitted_outcomes') if isinstance(value, dict) else None
    if not isinstance(outcomes, list):
        return set()
    return {outcome for outcome in outcomes if isinstance(outcome, str) and outcome}


def reconcile_gap_report(board, snapshot_dir, report, admission_bin):
    """Correct two gap-report drift classes before this run trusts the queue.

    idle_empty staleness: a milestone with no children linked directly to it
    can still have real in-flight Kind:pr children recorded only against its
    North Star (child filed with --north-star but no --milestone). Drop that
    decompose entry -- real work already covers the gap -- and move the
    milestone from idle_empty to in_flight in counts.

    Safety-cap starvation: keep every other entry at its original position,
    and only reorder the decompose entries among themselves so ones under an
    admitted North Star (decision-2026-08-31-two-admitted-feature-outcomes)
    run first. A fixed low SAFETY_CAP can otherwise spend its whole budget on
    unadmitted entries that always sort earlier and never reach admitted work.

    Every entry this cannot classify, and every non-decompose entry, passes
    through unchanged at its original position. Never rebuild the array from
    a fixed action allowlist -- that silently drops entries carrying an
    action this code does not enumerate.
    """
    work_queue = report.get('work_queue')
    if not isinstance(work_queue, list) or not work_queue:
        return report

    ns_children = {}
    unattached_cards = [card for card in
                         _list_cards(snapshot_dir / 'todo.json') + _list_cards(snapshot_dir / 'doing.json')
                         if isinstance(card, dict) and card.get('kind') == 'pr' and not card.get('milestone')]
    for card in unattached_cards:
        north_star = card.get('north_star')
        if isinstance(north_star, str) and north_star:
            ns_children[north_star] = ns_children.get(north_star, 0) + 1

    ns_cache = {}

    def entry_north_star(entry):
        return _milestone_north_star(board, entry.get('slug') if isinstance(entry, dict) else None, ns_cache)

    kept = []
    stale = 0
    for entry in work_queue:
        if not isinstance(entry, dict) or entry.get('action') != 'decompose':
            kept.append(entry)
            continue
        north_star = entry_north_star(entry)
        if north_star and ns_children.get(north_star, 0) > 0:
            stale += 1
            continue
        kept.append(entry)

    if stale:
        counts = report.get('counts')
        if isinstance(counts, dict):
            idle_empty = counts.get('idle_empty')
            if isinstance(idle_empty, (int, float)) and not isinstance(idle_empty, bool):
                counts['idle_empty'] = max(0, idle_empty - stale)
            in_flight = counts.get('in_flight')
            if isinstance(in_flight, (int, float)) and not isinstance(in_flight, bool):
                counts['in_flight'] = in_flight + stale

    decompose_indices = [i for i, entry in enumerate(kept)
                          if isinstance(entry, dict) and entry.get('action') == 'decompose']
    if len(decompose_indices) > 1:
        admitted = _admitted_north_stars(admission_bin)
        if admitted:
            reordered = sorted((kept[i] for i in decompose_indices),
                                key=lambda entry: 0 if entry_north_star(entry) in admitted else 1)
            for index, entry in zip(decompose_indices, reordered):
                kept[index] = entry

    report['work_queue'] = kept
    report = _annotate_stuck_states(board, report, {}, {})
    return report


def flags(args, allowed):
    values = {}
    index = 0
    while index < len(args):
        key = args[index]
        if key not in allowed or key in values:
            refuse(f"unsupported-or-duplicate-option option={key}")
        if key == '--json':
            values[key] = True
            index += 1
        else:
            if index + 1 >= len(args) or args[index + 1].startswith('--'):
                refuse(f"missing-option-value option={key}")
            values[key] = args[index + 1]
            index += 2
    return values


def has_section(body, title):
    section = re.search(r'^##[ \t]+' + re.escape(title) + r'[ \t]*\r?\n(.*?)(?=^##[ \t]|\Z)', body, re.M | re.S)
    return bool(section and section.group(1).strip())


def authorize(command, board, control, report):
    """Known command shapes only. No shell wrapper or raw PR add escape."""
    program, args = Path(command[0]).name, command[1:]
    owner, cost, action = None, 0, None
    proof_status, proof_card = None, None
    if program == 'last-stack-kanban-file-pr':
        if not args:
            refuse('missing-card-slug')
        options = flags(args[1:], {'--title', '--repo', '--north-star', '--milestone',
            '--column', '--deps', '--surfaces', '--base', '--tags', '--priority',
            '--kind', '--work-class'})
        owner = options.get('--milestone')
        kind = options.get('--kind', 'pr')
        if kind not in ('pr', 'validation'):
            refuse(f"unsupported-card-kind kind={kind}")
        if options.get('--column', 'todo') not in ('todo', 'backlog'):
            refuse('invalid-new-card-column')
        if kind == 'validation':
            # file_proof_card: the proof card for a complete_proof queue entry
            # that has no proof card yet. A validation card has no source
            # surfaces; the checks below hold it to exactly that gap
            # (papercut-milestone-driver-guard-hardcodes-decompose-action-for-file-pr-20260926).
            # A proof card costs nothing against SAFETY_CAP: the routine
            # contract processes every complete_proof entry, and the cap
            # budgets PR supply. The one-proof-card-per-milestone-per-run
            # check below bounds it instead
            # (papercut-milestone-driver-guard-caps-complete-proof-contradicts-doc-20260926).
            cost, action = 0, 'file_proof'
        else:
            if not options.get('--surfaces', '').strip() or not any(s.strip() for s in options['--surfaces'].split(',')):
                refuse('missing-source-surfaces')
            cost, action = 1, 'decompose'
    elif program in ('kanban', 'fkanban', Path(board).name):
        if len(args) >= 3 and args[0] == 'move' and args[2] == 'todo':
            flags(args[3:], {'--json'})
            card = point_read(board, ['show', args[1]])
            if card.get('slug') != args[1] or card.get('column') != 'backlog':
                refuse('promotion-card-not-backlog')
            if not card.get('surfaces') or card.get('block_status') not in ('', 'none'):
                refuse('promotion-held-or-missing-surfaces')
            owner, cost, action = card.get('milestone'), 1, 'promote'
        elif len(args) >= 3 and args[0] == 'milestone' and args[1] == 'add':
            owner = args[2]
            options = flags(args[3:], {'--proof-card', '--proof-status', '--json'})
            proof_status = options.get('--proof-status')
            proof_card = options.get('--proof-card')
            if not proof_status and not options.get('--proof-card'):
                refuse('empty-proof-update')
        elif len(args) >= 4 and args[:2] == ['milestone', 'state'] and args[3] == 'complete':
            owner = args[2]
            options = flags(args[4:], {'--proof-status', '--json'})
            proof_status = options.get('--proof-status')
            action = 'complete_proof'
        else:
            refuse('unsupported-guard-command')
    else:
        refuse('unsupported-guard-program')
    if not owner:
        refuse('missing-owner-milestone')
    if control['target'] and owner != control['target']:
        refuse(f"target-mismatch expected={control['target']} actual={owner}")
    current = detail(board, owner)
    milestone = current['milestone']
    if milestone.get('state') not in ('planned', 'active', 'proving'):
        refuse(f"milestone-not-live slug={owner}")
    if proof_status == 'not_required' and milestone.get('proof_status') != 'not_required':
        refuse(f"proof-waiver-refused slug={owner}")
    if proof_status is not None and proof_status not in ('pending', 'passing', 'not_required'):
        refuse('unsupported-proof-status')
    passing_current = current.get('proof_verdict') == 'passing' and milestone.get('proof_status') == 'passing'
    if proof_status == 'passing' and not passing_current:
        # A pending operator status deliberately has a pending live verdict.
        # Bootstrap only from a current, terminal validation card with exact
        # PASS evidence; the underlying state command repeats its proof gate.
        linked = milestone.get('proof_card')
        if not linked or milestone.get('proof_status') != 'pending':
            refuse(f"passing-proof-not-current slug={owner}")
        proof = point_read(board, ['show', linked, '--canonical'])
        if (proof.get('slug') != linked or proof.get('milestone') != owner
            or not milestone.get('board') or proof.get('board') != milestone['board']
            or proof.get('kind') != 'validation' or proof.get('column') != 'done'
            or not re.search(r'^[ \t]*(?:PROOF|RESULT):[ \t]*PASS[ \t]*$', proof.get('body', ''), re.M | re.I)):
            refuse(f"passing-proof-not-current slug={owner}")
        passing_current = True
    if proof_card:
        card = point_read(board, ['show', proof_card, '--canonical'])
        body = card.get('body', '')
        if (card.get('slug') != proof_card or card.get('milestone') != owner
            or card.get('kind') != 'validation'
            or not milestone.get('board') or card.get('board') != milestone['board']
            or not has_section(body, 'GOAL') or not has_section(body, 'END STATE')
            or not re.search(r'^DONE-WHEN:\s*\S', body, re.M)):
            refuse('existing-proof-card-invalid')
        if proof_status != 'pending':
            refuse('proof-attachment-must-remain-pending')
    if action == 'file_proof':
        if milestone.get('proof_card'):
            refuse(f"proof-card-already-linked slug={owner}")
        if any(entry.get('action') == 'file_proof' and entry.get('milestone') == owner
               for entry in control['actions']):
            refuse(f"proof-card-already-filed-this-run slug={owner}")
        if 'not_required' in (milestone.get('proof_status'), current.get('proof_verdict')):
            refuse(f"proof-not-required slug={owner}")
    if action == 'complete_proof':
        if not (proof_status == 'passing' and passing_current or proof_status == 'not_required' and current.get('proof_verdict') == milestone.get('proof_status') == 'not_required'):
            refuse(f"completion-proof-not-current slug={owner}")
    prerequisites(board, current)
    if action:
        # A proof card closes the gap a complete_proof entry names.
        queue_action = 'complete_proof' if action == 'file_proof' else action
        entries = [entry for entry in report.get('work_queue', [])
                   if entry.get('slug') == owner and entry.get('action') == queue_action]
        if not entries:
            refuse(f"action-not-in-current-queue slug={owner} action={action}")
        if action == 'promote' and not any(args[1] in entry.get('promoteable', []) for entry in entries):
            refuse('promotion-not-in-current-queue')
    if cost and control['reserved_actions'] >= control['safety_cap']:
        refuse(f"safety-cap-exhausted cap={control['safety_cap']}")
    return cost, owner, action


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['capture', 'verify', 'consume', 'guard'])
    parser.add_argument('--run-dir', default=os.environ.get('ROUTINES_RUN_DIR', ''))
    parser.add_argument('--run-id', default=os.environ.get('ROUTINES_RUN_ID', ''))
    parser.add_argument('--artifact', default='')
    parser.add_argument('--preflight-bin')
    parser.add_argument('--kanban-bin', default=os.environ.get('KANBAN_BIN', 'kanban'))
    parser.add_argument('--admission-bin', default=os.environ.get(
        'MILESTONE_DRIVER_ADMISSION_BIN',
        str(Path(__file__).resolve().with_name('last-stack-feature-portfolio-admission'))))
    argv = sys.argv[1:]
    boundary = argv.index('--') if '--' in argv else len(argv)
    command = argv[boundary + 1:]
    args = parser.parse_args(argv[:boundary])
    run = Path(args.run_dir)
    if not run.is_absolute() or str(run) == '/':
        refuse('run-dir-must-be-absolute', 2)
    if not args.run_id:
        refuse('missing-run-id', 2)
    snapshot = run / 'milestone-driver'
    snapshot.mkdir(parents=True, exist_ok=True)
    expected = snapshot / 'gap-report.json'
    stamp = snapshot / 'preflight.json'
    ledger = snapshot / 'action-ledger.json'
    # A kernel lock has no stale-owner cleanup path and cannot reset the budget.
    with (snapshot / 'action.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            refuse('run-action-in-progress', 75)
        control = load(ledger) if ledger.exists() else None
        if control:
            if control.get('run_id') != args.run_id:
                refuse('run-ledger-id-mismatch')
            for key, env in [('target', 'MILESTONE_DRIVER_TARGET'), ('safety_cap', 'MILESTONE_DRIVER_SAFETY_CAP')]:
                if env in os.environ and str(control[key]) != os.environ[env]:
                    refuse(f"run-scope-changed field={key}")
        if args.mode == 'capture':
            for name in ['gap-report.json', 'preflight.json', 'backlog.json', 'todo.json', 'doing.json', 'portfolio.json']:
                (snapshot / name).unlink(missing_ok=True)
            preflight = args.preflight_bin or str(Path(__file__).resolve().with_name('last-stack-generator-preflight'))
            outcome = subprocess.run([preflight, 'milestone-driver'], stdout=sys.stderr)
            if outcome.returncode:
                print(f'MILESTONE_DRIVER_PREFLIGHT stopped rc={outcome.returncode} run_id={args.run_id} no_board_commands=1', file=sys.stderr)
                return outcome.returncode
            if control is None:
                cap = os.environ.get('MILESTONE_DRIVER_SAFETY_CAP', '8')
                if cap not in tuple(str(n) for n in range(1, 9)):
                    refuse('invalid-safety-cap', 2)
                control = {'run_id': args.run_id, 'target': os.environ.get('MILESTONE_DRIVER_TARGET', ''),
                           'safety_cap': int(cap), 'reserved_actions': 0, 'actions': []}
                save(ledger, control)
            now = int(time.time())
            preflight_at = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
            token = uuid.uuid4().hex
            evidence = {'run_id': args.run_id, 'preflight_token': token,
                        'preflight_succeeded': True, 'preflight_succeeded_epoch': now, 'preflight_succeeded_at': preflight_at}
            save(stamp, evidence)
            for step, argv in [('backlog', ['list', '--column', 'backlog']),
                               ('todo', ['list', '--column', 'todo']), ('doing', ['list', '--column', 'doing']),
                               ('portfolio', ['milestone', 'portfolio']), ('gap-report', ['milestone', 'gap-report'])]:
                for attempt in range(1, 4):
                    result = subprocess.run([args.kanban_bin, *argv, '--json'], capture_output=True, text=True)
                    (snapshot / (step + '.json')).write_text(result.stdout)
                    if result.returncode == 0 and result.stdout.strip():
                        break
                    if attempt < 3 and re.search(r'partition read failed|service_timeout|did not respond|too many concurrent|busy', result.stderr, re.I):
                        time.sleep(attempt * 10)
                        continue
                    refuse(f"board-read-failed step={step} rc={result.returncode} attempts={attempt} run_id={args.run_id} stderr={result.stderr[:300].replace(chr(10), ' ')}")
                value = load(snapshot / (step + '.json'))
            if not isinstance(value.get('counts'), dict) or not isinstance(value.get('work_queue'), list):
                refuse('invalid-gap-report')
            value = reconcile_gap_report(args.kanban_bin, snapshot, value, args.admission_bin)
            value['_milestone_driver_run'] = {**evidence, 'created_epoch': int(time.time()),
                'artifact': str(expected), 'target': control['target'], 'safety_cap': control['safety_cap'],
                'created_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}
            save(expected, value)
            print(json.dumps({'artifact': str(expected), 'run_id': args.run_id,
                'target': control['target'], 'safety_cap': control['safety_cap'], 'reserved_actions': control['reserved_actions'],
                'preflight_succeeded_at': preflight_at, 'created_at': value['_milestone_driver_run']['created_at']}))
            return 0
        if args.artifact != str(expected):
            refuse('artifact-outside-current-run')
        if not control or not stamp.exists() or not expected.exists():
            refuse('current-run-artifact-missing')
        report, preflight = load(expected), load(stamp)
        metadata = report.get('_milestone_driver_run', {})
        if not (metadata.get('run_id') == preflight.get('run_id') == args.run_id
            and metadata.get('preflight_token') == preflight.get('preflight_token')
            and metadata.get('preflight_succeeded') is True and preflight.get('preflight_succeeded') is True
            and isinstance(metadata.get('created_epoch'), int)
            and metadata.get('preflight_succeeded_epoch') == preflight.get('preflight_succeeded_epoch')
            and metadata.get('created_epoch', -1) >= preflight.get('preflight_succeeded_epoch', 0) >= 0
            and metadata.get('artifact') == str(expected)
            and metadata.get('target') == control['target'] and metadata.get('safety_cap') == control['safety_cap']):
            refuse('stale-or-invalid-artifact')
        if args.mode == 'verify':
            print(f'MILESTONE_DRIVER_SNAPSHOT valid run_id={args.run_id} artifact={expected}')
        elif args.mode == 'consume':
            print(json.dumps(report))
        else:
            if not command:
                refuse('missing-guard-command', 2)
            cost, owner, action = authorize(command, args.kanban_bin, control, report)
            control['reserved_actions'] += cost
            control['actions'].append({'command': command, 'milestone': owner, 'action': action,
                                       'cost': cost, 'state': 'reserved'})
            save(ledger, control)
            try:
                result = subprocess.run(command)
            except OSError as error:
                control['actions'][-1].update(state='launch_failed', error=str(error))
                save(ledger, control)
                refuse(f"command-launch-failed error={error}")
            control['actions'][-1].update(state='returned', exit_code=result.returncode)
            save(ledger, control)
            return result.returncode
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Refusal as error:
        print(f'MILESTONE_DRIVER_SNAPSHOT error={error.reason}', file=sys.stderr)
        sys.exit(error.code)
