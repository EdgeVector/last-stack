#!/usr/bin/env python3
"""Snapshot and verify the deterministic Brain papercut work queue."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


EXPECTED_METHOD = "status-keyed papercut index"

# Exit codes. 1 means the queue itself is wrong and a human must look; 3 means
# the queue could not be read at all because a dependency is degraded. The
# reconciler must not report a routine error for 3 -- nothing was mutated and
# nothing about the routine is broken. Keeping them apart is what stops an
# unreadable queue from looking like a defect, without ever letting an invalid
# queue look green.
EXIT_QUEUE_INVALID = 1
EXIT_QUEUE_UNAVAILABLE = 3

# Substrings that identify a degraded-dependency read rather than a bad queue.
# Matched case-insensitively against the brain error text.
UNAVAILABLE_SIGNATURES = (
    "not marked complete",
    "index is registered but not",
    "service_timeout",
    "node did not respond",
    "too many concurrent reads",
    "uds_connection_limit",
    # A query the node rejects at the grammar is a read that never happened,
    # not a queue that read as invalid (papercut-brain-papercut-list-http-400-grammar).
    "http 400",
    "outside its grammar",
)


def brain_failure_text(proc: subprocess.CompletedProcess[str]) -> tuple[str, str]:
    """Return (detail, hint) for a failed brain call.

    brain reports the machine-readable form on stdout as {"error", "hint"} and
    the human form on stderr. Prefer the structured one; fall back to whichever
    stream has text.
    """
    stdout = (proc.stdout or "").strip()
    stderr = (proc.stderr or "").strip()
    try:
        payload = json.loads(stdout)
    except (json.JSONDecodeError, TypeError):
        payload = None
    if isinstance(payload, dict) and isinstance(payload.get("error"), str):
        hint = payload.get("hint")
        return payload["error"].strip(), hint.strip() if isinstance(hint, str) else ""
    return (stderr or stdout), ""


def unavailable_reason(detail: str) -> str | None:
    """Name the degraded-dependency condition in `detail`, or None."""
    lowered = detail.lower()
    if "not marked complete" in lowered or "index is registered but not" in lowered:
        return "status-index-incomplete"
    for signature in UNAVAILABLE_SIGNATURES:
        if signature in lowered:
            return "brain-unavailable"
    return None


def parse_json_stream(raw: str) -> dict[str, Any]:
    decoder = json.JSONDecoder()
    index = 0
    values: list[Any] = []
    while index < len(raw):
        while index < len(raw) and raw[index].isspace():
            index += 1
        if index >= len(raw):
            break
        try:
            value, end = decoder.raw_decode(raw, index)
        except json.JSONDecodeError:
            index += 1
            continue
        values.append(value)
        index = end
    for value in values:
        if isinstance(value, dict) and isinstance(value.get("rows"), list):
            return value
    raise ValueError("brain did not return a papercut-list JSON object")


def is_safe_papercut_slug(slug: object) -> bool:
    return isinstance(slug, str) and slug.startswith("papercut-") and slug != "papercut-"


def validate_queue(payload: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    method = payload.get("method")
    rows = payload.get("rows")
    total = payload.get("total")
    if not isinstance(method, str) or EXPECTED_METHOD not in method:
        raise ValueError("reader is not the status-keyed papercut index")
    if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
        raise ValueError("rows is not an object array")
    if not isinstance(total, int) or total != len(rows):
        raise ValueError(f"total/rows mismatch: total={total!r} rows={len(rows)}")
    slugs: set[str] = set()
    accepted: list[dict[str, Any]] = []
    quarantined: list[dict[str, Any]] = []
    for row in rows:
        slug = row.get("slug")
        if not is_safe_papercut_slug(slug):
            quarantined.append({
                "slug": slug if isinstance(slug, str) else None,
                "reason": "missing-papercut-prefix",
            })
            continue
        if row.get("status") != "open":
            raise ValueError(f"non-open row in open queue: {slug} status={row.get('status')!r}")
        if slug in slugs:
            raise ValueError(f"duplicate papercut queue membership: {slug}")
        slugs.add(str(slug))
        accepted.append(row)
    return accepted, quarantined


def write_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


# Index-only first: one keyed partition read, no per-row hydrate. The hydrated
# open ledger measured 214s wall / 2191 node requests on the primary
# (2026-09-03, 2171 rows) and timed out every reconciler pass for 8 days
# (papercut-lastdb-reconciler-policies-query-slow). This helper only needs the
# slug column; the reconciler point-gets what it acts on.
OPEN_LIST_INDEX_ONLY = ["papercut", "list", "--status", "open", "--index-only", "--json"]
OPEN_LIST_HYDRATED = ["papercut", "list", "--status", "open", "--json"]


def rejects_index_only(proc: subprocess.CompletedProcess[str]) -> bool:
    """True when the installed brain predates `--index-only` and refused the flag."""
    text = f"{proc.stdout or ''}\n{proc.stderr or ''}".lower()
    if "index-only" not in text:
        return False
    return any(word in text for word in ("unknown", "unexpected", "unrecognized", "invalid option"))


def run_open_list(brain_bin: str, *, timeout: int) -> subprocess.CompletedProcess[str]:
    """Read the open queue; fall back to the hydrated list only on an old brain."""
    proc = subprocess.run(
        [brain_bin, *OPEN_LIST_INDEX_ONLY],
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
    )
    if proc.returncode != 0 and rejects_index_only(proc):
        proc = subprocess.run(
            [brain_bin, *OPEN_LIST_HYDRATED],
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    return proc


def snapshot(args: argparse.Namespace) -> int:
    try:
        proc = run_open_list(args.brain_bin, timeout=args.timeout)
    except subprocess.TimeoutExpired as error:
        # The queue was never read. An uncaught traceback here ended the pass
        # with rc=1 and no snapshot (2026-09-02T14:45Z); report it like every
        # other unavailable read so the caller can retry or hold.
        detail = f"{' '.join(str(part) for part in error.cmd)} timed out after {args.timeout}s"
        result = {
            "ok": False,
            "phase": "snapshot",
            "reason": "brain-unavailable",
            "retryable": True,
            "detail": detail,
        }
        if args.json:
            print(json.dumps(result, sort_keys=True))
        else:
            print(f"papercut-queue unavailable reason=brain-unavailable detail={detail}")
        print(f"papercut queue unavailable (brain-unavailable): {detail}", file=sys.stderr)
        return EXIT_QUEUE_UNAVAILABLE
    if proc.returncode != 0:
        detail, hint = brain_failure_text(proc)
        reason = unavailable_reason(detail)
        if reason is not None:
            # The queue was never read, so there is nothing to be false-green
            # about. Report it as its own terminal condition and let the caller
            # decide; do NOT write a snapshot file.
            result = {
                "ok": False,
                "phase": "snapshot",
                "reason": reason,
                "retryable": True,
                "detail": detail,
            }
            if hint:
                result["hint"] = hint
            if args.json:
                print(json.dumps(result, sort_keys=True))
            else:
                print(f"papercut-queue unavailable reason={reason} detail={detail}")
            print(
                f"papercut queue unavailable ({reason}): {detail}",
                file=sys.stderr,
            )
            return EXIT_QUEUE_UNAVAILABLE
        print(
            f"papercut queue read failed ({proc.returncode}): {proc.stderr.strip() or proc.stdout.strip()}",
            file=sys.stderr,
        )
        return EXIT_QUEUE_INVALID
    try:
        source = parse_json_stream(proc.stdout)
        rows, quarantined = validate_queue(source)
    except ValueError as error:
        print(f"papercut queue invalid: {error}", file=sys.stderr)
        return EXIT_QUEUE_INVALID
    fetched_at = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    receipt = {
        "version": 1,
        "ok": True,
        "fetched_at": fetched_at,
        "method": source["method"],
        "discovered": len(rows),
        "quarantined": quarantined,
        "rows": rows,
    }
    write_atomic(Path(args.output), receipt)
    result = {
        "ok": True,
        "phase": "snapshot",
        "snapshot": str(Path(args.output).resolve()),
        "discovered": len(rows),
        "quarantined": len(quarantined),
        "method": source["method"],
    }
    if quarantined:
        print(
            f"papercut queue quarantined {len(quarantined)} slug(s) missing papercut- prefix",
            file=sys.stderr,
        )
    print(json.dumps(result, sort_keys=True) if args.json else (
        f"papercut-queue snapshot={result['snapshot']} discovered={len(rows)} "
        f"quarantined={len(quarantined)} method=status-keyed"
    ))
    return 0


def read_slug_file(path: str) -> list[str]:
    values: list[str] = []
    for raw in Path(path).read_text(encoding="utf-8").splitlines():
        slug = raw.strip()
        if not slug or slug.startswith("#"):
            continue
        if not slug.startswith("papercut-"):
            raise ValueError(f"invalid classified slug in {path}: {slug!r}")
        values.append(slug)
    if len(values) != len(set(values)):
        raise ValueError(f"duplicate slug inside classification file: {path}")
    return values


def verify(args: argparse.Namespace) -> int:
    try:
        receipt = json.loads(Path(args.snapshot).read_text(encoding="utf-8"))
        rows, _quarantined = validate_queue({
            "method": receipt.get("method"),
            "rows": receipt.get("rows"),
            "total": receipt.get("discovered"),
        })
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(f"papercut queue receipt invalid: {error}", file=sys.stderr)
        return 1
    try:
        classified = {
            "reconciled": read_slug_file(args.reconciled_file),
            "deferred": read_slug_file(args.deferred_file),
            "already_handled": read_slug_file(args.already_handled_file),
            "failed": read_slug_file(args.failed_file),
        }
    except (OSError, ValueError) as error:
        print(f"papercut queue classification invalid: {error}", file=sys.stderr)
        return 1
    owners: dict[str, str] = {}
    overlap: list[str] = []
    for bucket, slugs in classified.items():
        for slug in slugs:
            if slug in owners:
                overlap.append(slug)
            else:
                owners[slug] = bucket
    expected = {str(row["slug"]) for row in rows}
    actual = set(owners)
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    counts = {bucket: len(slugs) for bucket, slugs in classified.items()}
    accounted = len(actual)
    discovered = len(expected)
    conserved = not missing and not extra and not overlap
    result = {
        "ok": conserved and counts["failed"] == 0,
        "phase": "verify",
        "snapshot": str(Path(args.snapshot).resolve()),
        "discovered": discovered,
        **counts,
        "accounted": accounted,
        "conserved": conserved,
        "missing": missing,
        "extra": extra,
        "overlap": sorted(set(overlap)),
    }
    print(json.dumps(result, sort_keys=True) if args.json else " ".join(
        ["papercut-queue"] + [f"{key}={value}" for key, value in result.items() if key != "phase"]
    ))
    return 0 if result["ok"] else 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    snapshot_parser = sub.add_parser("snapshot")
    snapshot_parser.add_argument("--output", required=True)
    snapshot_parser.add_argument("--brain-bin", default="brain")
    snapshot_parser.add_argument("--timeout", type=int, default=60)
    snapshot_parser.add_argument("--json", action="store_true")
    snapshot_parser.set_defaults(func=snapshot)
    verify_parser = sub.add_parser("verify")
    verify_parser.add_argument("--snapshot", required=True)
    verify_parser.add_argument("--reconciled-file", required=True)
    verify_parser.add_argument("--deferred-file", required=True)
    verify_parser.add_argument("--already-handled-file", required=True)
    verify_parser.add_argument("--failed-file", required=True)
    verify_parser.add_argument("--json", action="store_true")
    verify_parser.set_defaults(func=verify)
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
