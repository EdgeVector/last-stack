#!/usr/bin/env bash
set -euo pipefail

# Resolve this script through symlinks so `lib/` is found in the artifact tree
# and in a checkout alike (same convention as bin/last-stack-factory-health-install).
self="${BASH_SOURCE[0]}"
while [ -h "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
self_root="$(cd -P "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/forge-token.sh
. "$self_root/lib/forge-token.sh"

usage() {
  cat <<'EOF'
Usage:
  last-stack-forge-git [-C <repo>] <git-args...>

Runs git with the local Forgejo token injected as an HTTP extraHeader, avoiding
hand-built auth headers for http://localhost:3300 remotes. The token travels in
GIT_CONFIG_* environment entries, never on the command line: `ps aux` is world
readable on this host, and passing the header as a `git -c` word put the secret
there (papercut-forge-git-extraheader-token-visible-in-ps-20260923).

Example:
  last-stack-forge-git -C /path/to/fold ls-remote --heads origin main
EOF
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

repo_dir="$PWD"
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  if [[ "${args[$i]}" == "-C" && $((i + 1)) -lt ${#args[@]} ]]; then
    repo_dir="${args[$((i + 1))]}"
    break
  fi
done

if ! git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "not a git repository: $repo_dir" >&2
  exit 2
fi

origin_url="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
if [[ "$origin_url" != http://localhost:3300/* && "$origin_url" != http://127.0.0.1:3300/* ]]; then
  exec git "${args[@]}"
fi

# The token goes into the environment, not into argv. `ps aux` lists argv to every
# local account; `ps -E`/`ps eww` print no environment at all on this host, even
# for the caller's own child. Measured 2026-09-25.
# papercut-forge-git-extraheader-token-visible-in-ps-20260923
if ! last_stack_forge_export_git_config; then
  last_stack_forge_token_missing_msg
  exit 1
fi

exec git "${args[@]}"
