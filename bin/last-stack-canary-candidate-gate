#!/usr/bin/env bash
# The nightly LastDB candidate-set action, zero-agent. One routine does what
# build-main and dogfood did, plus the two steps the release loop needed:
#
#   1. build   — GitHub fold main → canary-builds/<oid>/ (idempotent)
#   2. resolve — the candidate build and the cutover-hold policy
#   3. set     — fix one commit per app: the candidate set
#   4. smoke   — the isolated llms-txt install smoke on exactly that set,
#                booting the candidate lastdbd (never the primary)
#   5. cutover — safe-upgrade probe + primary cutover (existing action)
#   6. rows    — write the proved pairs to registry `next` (GitHub PR on the tap repo)
#
# When step 2 finds no build to cut over to (the primary already runs the
# candidate) or the cutover is held, the gate does NOT stop: it runs the
# apps-only pass, which proves the app commits against the build the primary
# already runs and publishes those rows. App merges are hourly and node builds
# are nightly, so stopping here is what left three apps 5 to 9 commits behind
# their registry pin on 2026-09-26.
#
# A RED smoke stops before the cutover: the primary keeps its build and the
# ledger gets a build-subject line event. Candidate rows are written only after a
# GREEN smoke AND a successful cutover, so `next` never names a pair the primary
# did not accept.
#
# When the cutover FAILS, the gate stays `outcome=error` and still runs the
# apps-only pass, pinned to the build the primary actually runs after the
# failure. The candidate's GREEN set names a build this host did not take; the
# apps-only set names one it does.
#
# Step 0, primary-rows, runs BEFORE the expensive build: when registry `next`
# has no row proved with the build the primary runs RIGHT NOW, prove the app
# set against that build (set + isolated smoke on the primary's own lastdbd +
# publish-next) and never cut over. Any path can move the primary --
# lastdb-safe-upgrade, post-merge-safe-upgrade, a hand rollback -- and only this
# gate wrote rows, so a primary moved outside it froze every host-track refresh
# until the next nightly pass (2026-09-26: 2375 went live at 12:53Z with no
# rows, and kanban, routines, brain and situations all held).
# papercut-host-track-refresh-held-hours-after-lastdb-cutover-no-registry-proof-trigger-20260926
#
# Step 0 also proves rows when the build did NOT move but an app did. Rows pin
# exact app commits, so an app fix merged while the LastDB build stays the same
# (fkanban PR 45 on 2026-09-26, against a 2375 row that pinned kanban b654aecf)
# got no row until the daily pass, and that pass noops when fold main equals the
# primary build. After the rows-present probe, step 0 asks the candidate-set
# tool for each app's head (the same pick: artifact channel, else GitHub main)
# and compares it with the pin `next` holds for the primary build. A head that
# moved runs the same set + smoke + publish-next, at most one smoke an hour, and
# a RED set is not smoked again until a head moves.
#
# `--primary-rows-only` runs step 0 alone. It costs one identity read, one
# channel read per app and one `lastdb app resolve` per app when nothing moved. `--detach` adds: when rows are
# missing, start the worker in its own session and return at once. The
# hourly reconcile gate calls it that way.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

build_main="${LAST_STACK_CANARY_V2_BUILD_MAIN:-${ROOT}/bin/last-stack-canary-build-main}"
dogfood="${LAST_STACK_CANARY_V2_DOGFOOD:-${ROOT}/bin/last-stack-lastdb-canary-dogfood}"
pipeline="${LAST_STACK_CANARY_V2_PIPELINE:-${ROOT}/bin/last-stack-canary-pipeline}"
candidate_set_bin="${LAST_STACK_CANARY_CANDIDATE_SET_BIN:-${ROOT}/bin/last-stack-canary-candidate-set}"
smoke_run="${LAST_STACK_CANARY_SMOKE_RUN:-${ROOT}/skills/llms-txt-install-smoke/run.sh}"
publish_next="${LAST_STACK_CANARY_PUBLISH_NEXT_BIN:-${ROOT}/bin/last-stack-registry-publish-next}"
hold_hours="${LAST_STACK_CANARY_V2_CUTOVER_HOLD_HOURS:-4}"
run_dir="${ROUTINES_RUN_DIR:-${TMPDIR:-/tmp}}"
skip_build="${LAST_STACK_CANARY_SKIP_BUILD:-0}"
skip_smoke="${LAST_STACK_CANARY_SKIP_SMOKE:-0}"
skip_rows="${LAST_STACK_CANARY_SKIP_ROWS:-0}"
primary_lastdbd="${LAST_STACK_CANARY_PRIMARY_LASTDBD:-$HOME/.lastdb/current/lastdbd}"
resolve_bin="${LAST_STACK_CANARY_APP_RESOLVE_BIN:-lastdb}"
apps_only_stamp_dir="${LAST_STACK_CANARY_APPS_ONLY_STAMP_DIR:-$HOME/.local/state/last-stack/canary-apps-only}"
apps_only_cooldown="${LAST_STACK_CANARY_APPS_ONLY_COOLDOWN_SECS:-3600}"
primary_rows_enabled="${LAST_STACK_CANARY_PRIMARY_ROWS:-1}"
primary_rows_probe_app="${LAST_STACK_CANARY_PRIMARY_ROWS_PROBE_APP:-}"
primary_rows_lock="${LAST_STACK_CANARY_PRIMARY_ROWS_LOCK:-$HOME/.local/state/last-stack/canary-primary-rows.lock}"
primary_rows_log_dir="${LAST_STACK_CANARY_PRIMARY_ROWS_LOG_DIR:-$HOME/.local/state/last-stack/canary-primary-rows}"
apps_config="${LAST_STACK_CANARY_APPS_CONFIG:-${ROOT}/config/registry/apps.json}"
heads_enabled="${LAST_STACK_CANARY_PRIMARY_ROWS_HEADS:-1}"
heads_interval="${LAST_STACK_CANARY_HEADS_SMOKE_INTERVAL_SECS:-3600}"
heads_green_recheck="${LAST_STACK_CANARY_HEADS_GREEN_RECHECK_SECS:-86400}"
last_smoke_stamp="${LAST_STACK_CANARY_LAST_SMOKE_STAMP:-$apps_only_stamp_dir/last-smoke.json}"
red_papercut_enabled="${LAST_STACK_CANARY_RED_PAPERCUT:-1}"
brain_bin="${LAST_STACK_CANARY_BRAIN_BIN:-brain}"
self_path="$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")"

usage() {
  printf '%s\n' 'last-stack-canary-candidate-gate'
  printf '%s\n' 'Build → candidate set → isolated smoke → primary cutover → registry next rows.'
  printf '%s\n' 'Env for tests: LAST_STACK_CANARY_V2_BUILD_MAIN, LAST_STACK_CANARY_V2_DOGFOOD,'
  printf '%s\n' '  LAST_STACK_CANARY_V2_PIPELINE, LAST_STACK_CANARY_CANDIDATE_SET_BIN,'
  printf '%s\n' '  LAST_STACK_CANARY_SMOKE_RUN, LAST_STACK_CANARY_PUBLISH_NEXT_BIN,'
  printf '%s\n' '  LAST_STACK_CANARY_SKIP_BUILD=1, LAST_STACK_CANARY_SKIP_SMOKE=1, LAST_STACK_CANARY_SKIP_ROWS=1'
  printf '%s\n' '  LAST_STACK_CANARY_PRIMARY_LASTDBD, LAST_STACK_CANARY_APP_RESOLVE_BIN'
  printf '%s\n' '  LAST_STACK_CANARY_APPS_ONLY_STAMP_DIR, LAST_STACK_CANARY_APPS_ONLY_COOLDOWN_SECS'
  printf '%s\n' '  LAST_STACK_CANARY_PRIMARY_ROWS=0 (skip step 0), LAST_STACK_CANARY_PRIMARY_ROWS_PROBE_APP,'
  printf '%s\n' '  LAST_STACK_CANARY_PRIMARY_ROWS_LOCK, LAST_STACK_CANARY_PRIMARY_ROWS_LOG_DIR,'
  printf '%s\n' '  LAST_STACK_CANARY_APPS_CONFIG, LAST_STACK_CANARY_V2_PRIMARY_IDENTITY_CMD'
  printf '%s\n' '  LAST_STACK_CANARY_PRIMARY_ROWS_HEADS=0 (skip the app-head check),'
  printf '%s\n' '  LAST_STACK_CANARY_HEADS_SMOKE_INTERVAL_SECS, LAST_STACK_CANARY_HEADS_GREEN_RECHECK_SECS,'
  printf '%s\n' '  LAST_STACK_CANARY_LAST_SMOKE_STAMP, LAST_STACK_CANARY_RED_PAPERCUT=0, LAST_STACK_CANARY_BRAIN_BIN'
  printf '%s\n' ''
  printf '%s\n' '  --primary-rows-only   run step 0 alone: prove rows for the build the primary'
  printf '%s\n' '                        runs when next has none, or when an app head moved past'
  printf '%s\n' '                        its pin; never builds, never cuts over'
  printf '%s\n' '  --detach              with --primary-rows-only: start the worker in its own'
  printf '%s\n' '                        session when rows are missing and return at once'
}

mode=full
detach=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --primary-rows-only) mode=primary-rows ;;
    --detach) detach=1 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done
if [ "$detach" = 1 ] && [ "$mode" != primary-rows ]; then
  usage >&2
  exit 2
fi

# Set before any step can name them in a detail line (set -u).
incoming=-
primary=-
primary_rows_status=""
heads_moved=""

result() {
  # result <outcome> <detail-kv...>: the two contract lines, then exit 0.
  local outcome="$1" detail
  shift
  detail="$*"
  [ -z "$primary_rows_status" ] || detail="$detail primary_rows=$primary_rows_status"
  printf 'CANARY_CANDIDATE result=%s %s\n' "$outcome" "$detail"
  printf 'ROUTINE_RESULT outcome=%s detail=%s\n' "$outcome" "$(printf '%s' "$detail" | tr ' ' ',')"
  exit 0
}

# ── the apps-only pass ───────────────────────────────────────────────────
# App commits merge several times an hour. A LastDB candidate appears at most
# once a night, and its rows reach the registry only after a successful primary
# cutover. So every `resolve` noop below used to publish nothing, and an
# app-only merge waited for the NODE to move: measured 2026-09-26 as 5 to 9
# commits and 31 to 50 hours of lag on brain, kanban and routines at once, with
# all three reading `freshness=fresh`.
# papercut-app-only-merge-waits-for-lastdb-candidate-set-registry-pin-20260926
#
# A registry row is a proved PAIR, not a minimum version
# (decision-2026-09-19-app-registry-is-the-release-unit), and the pair the host
# needs is <app sha, the build the primary ALREADY runs>. That pair needs no new
# build and no cutover, so the apps-only pass pins the set to the primary's own
# lastdbd, proves it with the same isolated smoke, and publishes the same rows.
# It never cuts the primary over: there is nothing to cut over to.

apps_moved_past_registry() {
  # Print a comma list of app ids whose set pin differs from the row `next`
  # already proves for the build the primary runs. A resolve that cannot answer
  # counts as MOVED: proving is the safe direction, and a silent skip is how
  # this lag stayed invisible for two days.
  local set_file="$1" app set_sha proved moved=""
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    set_sha="$(jq -r --arg a "$app" '.apps[$a].sha // empty' "$set_file" 2>/dev/null || true)"
    [ -n "$set_sha" ] || continue
    proved="$("$resolve_bin" app resolve "$app" --channel next --lastdb-version "$primary" --json 2>/dev/null \
      | jq -r '.sha // empty' 2>/dev/null || true)"
    [ "$proved" = "$set_sha" ] || moved="${moved:+$moved,}$app"
  done < <(jq -r '.apps | keys[]' "$set_file" 2>/dev/null || true)
  printf '%s' "$moved"
}

write_apps_only_stamp() {
  # Best effort: a stamp that cannot be written must not fail a GREEN pass, it
  # only costs the next run a repeat.
  local stamp="$1" fp="$2" verdict="$3" dir
  [ -n "$stamp" ] && [ -n "$fp" ] || return 0
  dir="$(dirname "$stamp")"
  mkdir -p "$dir" 2>/dev/null || return 0
  jq -n --arg fp "$fp" --arg r "$verdict" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson e "$(date +%s)" '{fingerprint: $fp, result: $r, at: $at, at_epoch: $e}' \
    >"$stamp.tmp" 2>/dev/null && mv -f "$stamp.tmp" "$stamp" 2>/dev/null || true
  return 0
}

apps_only_fingerprint() {
  # A stable id for "this set of app pins against this primary build".
  local set_file="$1"
  jq -r '.apps | to_entries | sort_by(.key) | map(.key + "=" + (.value.sha // "")) | join(",")' \
    "$set_file" 2>/dev/null | shasum -a 256 | awk '{print $1}'
}

apps_only_run() {
  # apps_only_run <why>: the WORKER. It returns a status instead of calling
  # `result`, so a caller that must keep its own outcome can still publish the
  # rows. That is the whole reason for the split: a failed primary cutover has
  # to stay `outcome=error` or routinesd's error escalation stops firing on it,
  # and it used to `result error` two steps above the rows —
  # papercut-canary-gate-discards-a-green-app-set-when-the-primary-cutover-fails-20260926
  #
  #    0  a GREEN proof, rows published (or skipped by a test flag)
  #   10  nothing to prove: no primary binary, every app already proved, cooldown
  #   20  red: a tool is missing, the set failed, the smoke was RED, rows failed
  #
  # <why> names the outcome that sent us here, so the detail still says why the
  # full pass did not run. Sets apps_only_status / apps_only_evidence /
  # apps_only_rows for a caller that reports one short field, and
  # apps_only_detail for the thin wrapper that reports it verbatim.
  local why="$1"
  apps_only_status=noop
  apps_only_evidence=unset
  apps_only_rows=-
  apps_only_moved=-
  apps_only_detail=""
  if [ -z "$primary_lastdbd" ] || [ ! -x "$primary_lastdbd" ]; then
    apps_only_evidence=primary_lastdbd_absent
    apps_only_detail="stage=apps-only candidate=$incoming primary=$primary evidence=${why}_primary_lastdbd_absent bin=${primary_lastdbd:-unset}"
    return 10
  fi
  if [ ! -x "$candidate_set_bin" ]; then
    apps_only_status=red
    apps_only_evidence=tool_missing
    apps_only_detail="evidence=tool_missing tool=$candidate_set_bin"
    return 20
  fi
  mkdir -p "$run_dir"
  local set_file="$run_dir/apps-only-set.json" rc=0 count moved
  set +e
  "$candidate_set_bin" --lastdbd "$primary_lastdbd" --out "$set_file" >"$run_dir/apps-only-set.out" 2>&1
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    "$pipeline" record-line-event --check candidate_set --subject observer --result fail --detail "exit=$rc" >/dev/null || true
    apps_only_status=red
    apps_only_evidence=candidate_set_failed
    apps_only_detail="stage=apps-only primary=$primary evidence=candidate_set_failed rc=$rc after=$why"
    return 20
  fi
  count="$(jq -r '.apps | length' "$set_file")"
  moved="$(apps_moved_past_registry "$set_file")"
  if [ -z "$moved" ]; then
    apps_only_evidence=apps_already_proved
    apps_only_detail="stage=apps-only candidate=$incoming primary=$primary apps=$count evidence=${why}_apps_already_proved"
    return 10
  fi

  # The smoke costs ~18 minutes of the primary host. This routine does NOT fire
  # once a day: it fired 7 times on 2026-09-24, four of them inside 22 minutes,
  # every one of them a `resolve` noop that cost seconds. Those are exactly the
  # runs the apps-only pass now picks up, so without a cooldown one busy evening
  # buys four consecutive real smokes for the same app pins -- and the natural
  # gate does not close in time, because a published row only becomes visible to
  # `lastdb app resolve` after the tap PR merges and the mirror syncs.
  #
  # So: one apps-only smoke per <primary build, app-pin fingerprint> per
  # cooldown, recorded whatever the verdict. A RED set must not be re-smoked
  # every ten minutes either. The cutover-failure caller shares this stamp on
  # purpose: a primary that fails its cutover fails it again next run, and that
  # must not buy a second ~18-minute smoke for pins already proved.
  local fp fp_short stamp stamp_fp stamp_at stamp_age stamp_result
  fp="$(apps_only_fingerprint "$set_file")"
  fp_short="${fp:0:12}"
  stamp="$apps_only_stamp_dir/$primary.json"
  if [ -n "$fp" ] && [ -f "$stamp" ]; then
    stamp_fp="$(jq -r '.fingerprint // ""' "$stamp" 2>/dev/null || true)"
    stamp_at="$(jq -r '.at_epoch // 0' "$stamp" 2>/dev/null || true)"
    [[ "$stamp_at" =~ ^[0-9]+$ ]] || stamp_at=0
    stamp_result="$(jq -r '.result // "unknown"' "$stamp" 2>/dev/null || true)"
    stamp_age=$(( $(date +%s) - stamp_at ))
    if [ "$stamp_fp" = "$fp" ] && [ "$stamp_age" -lt "$apps_only_cooldown" ]; then
      apps_only_evidence=apps_only_cooldown
      apps_only_detail="stage=apps-only primary=$primary apps=$count moved=$moved fingerprint=$fp_short evidence=${why}_apps_only_cooldown last=${stamp_result} age=${stamp_age}s cooldown=${apps_only_cooldown}s"
      return 10
    fi
  fi

  local smoke_status=skipped proof_file="$run_dir/apps-only-proof.json" src=0 steps
  if [ "$skip_smoke" != 1 ]; then
    if [ ! -f "$smoke_run" ]; then
      apps_only_status=red
      apps_only_evidence=tool_missing
      apps_only_detail="evidence=tool_missing tool=$smoke_run"
      return 20
    fi
    # The app-head check in step 0 allows one smoke an hour on this host, so
    # every apps-only smoke, from any caller, counts against it.
    write_apps_only_stamp "$last_smoke_stamp" "$fp" started
    set +e
    SMOKE_LASTDBD_BIN="$primary_lastdbd" SMOKE_CANDIDATE_SET="$set_file" \
      bash "$smoke_run" --json >"$proof_file" 2>"$run_dir/apps-only-smoke.err"
    src=$?
    set -e
    smoke_status="$(jq -r '.verdict // empty' "$proof_file" 2>/dev/null || true)"
    # The real smoke (skills/llms-txt-install-smoke/run.sh) exits 1 on EVERY
    # RED verdict by design, so a nonzero $src alone does not mean "crashed" --
    # it is the normal shape of a RED. What DOES mean "nothing to attribute"
    # is an empty/unparsed verdict: no proof JSON at all, or a shape jq could
    # not read (a genuine crash, a timeout, a truncated log).
    if [ -z "$smoke_status" ]; then
      steps="$(jq -r '.steps // "no-verdict"' "$proof_file" 2>/dev/null || echo no-verdict)"
      write_apps_only_stamp "$stamp" "$fp" red
      apps_only_status=red
      apps_only_evidence=smoke_red
      apps_only_detail="stage=apps-only primary=$primary apps=$count moved=$moved evidence=smoke_red rc=$src steps=$steps log=$run_dir/apps-only-smoke.err after=$why"
      return 20
    fi
    if [ "$smoke_status" != GREEN ]; then
      # A RED verdict from a smoke that ran to completion is a verdict about
      # the app set, not about the primary, which is untouched here. It used
      # to stop the whole pass -- one app's own check failing zeroed out
      # every app in the set, including ones with nothing wrong (2026-09-28:
      # one missing ~/Library/LaunchAgents dir broke install-apps for 6 of 9
      # apps and zeroed rows for brain/kanban/situations too, which had no
      # fail of their own). publish_next below now decides, from the proof's
      # fails[] via last-stack-registry-red-attribution: it writes rows only
      # for the apps with zero fails of their own, and it still dies (rc!=0)
      # on a shared/cross-cutting fail -- the isolated node itself never came
      # up, so the proof is worthless for every app, same as before.
      steps="$(jq -r '.steps // "no-verdict"' "$proof_file" 2>/dev/null || echo no-verdict)"
    fi
  fi

  # The stamp records the smoke's own verdict (green/red), not the row
  # outcome, so a moved-head recheck is not fooled by a partial-rows success
  # into skipping a genuinely still-broken app. Same lowercase contract as
  # before per-app attribution existed (tests/last-stack-canary-candidate-gate.sh).
  if [ "${smoke_status:-GREEN}" = GREEN ]; then
    write_apps_only_stamp "$stamp" "$fp" green
  else
    write_apps_only_stamp "$stamp" "$fp" red
  fi

  local rows_status=skipped rows_out rows_pr rrc=0
  if [ "$skip_rows" != 1 ] && [ "$skip_smoke" != 1 ]; then
    if [ ! -x "$publish_next" ]; then
      apps_only_status=red
      apps_only_evidence=tool_missing
      apps_only_detail="evidence=tool_missing tool=$publish_next"
      return 20
    fi
    set +e
    rows_out="$("$publish_next" --candidate-set "$set_file" --proof "$proof_file" 2>"$run_dir/apps-only-rows.err")"
    rrc=$?
    set -e
    if [ "$rrc" -ne 0 ]; then
      apps_only_status=red
      # smoke_red when publish_next refused a RED proof (shared/cross-cutting
      # fail, or every known app failed its own check); rows_failed for any
      # other tool failure (a GREEN proof that still could not write/push).
      if [ "$smoke_status" != GREEN ]; then
        apps_only_evidence=smoke_red
      else
        apps_only_evidence=rows_failed
      fi
      apps_only_detail="stage=apps-only primary=$primary apps=$count moved=$moved evidence=$apps_only_evidence rc=$rrc smoke=${smoke_status:-skipped} steps=${steps:-} log=$run_dir/apps-only-rows.err after=$why"
      return 20
    fi
    rows_status="$(printf '%s\n' "$rows_out" | sed -n 's/^REGISTRY_NEXT status=\([^ ]*\).*/\1/p' | tail -n1)"
    rows_pr="$(printf '%s\n' "$rows_out" | sed -n 's/.* pr=\([^ ]*\).*/\1/p' | tail -n1)"
    [ -z "$rows_pr" ] || rows_status="$rows_status:$rows_pr"
  fi

  apps_only_status=ok
  apps_only_evidence=rows_published
  [ "${smoke_status:-GREEN}" = GREEN ] || apps_only_evidence=rows_published_partial
  [ "$rows_status" != skipped ] || apps_only_evidence=rows_skipped
  apps_only_rows="$rows_status"
  apps_only_moved="$moved"
  apps_only_detail="stage=apps-only primary=$primary apps=$count moved=$moved smoke=$smoke_status cutover=skipped rows=$rows_status evidence=$apps_only_evidence after=$why"
  return 0
}

apps_only_pass() {
  # The thin wrapper for the two `resolve` exits: the apps-only pass IS the
  # outcome there, so the worker's status becomes the result line verbatim.
  local why="$1" rc=0
  apps_only_run "$why" || rc=$?
  case "$rc" in
    0)  result ok "$apps_only_detail" ;;
    10) result noop "$apps_only_detail" ;;
    *)  result error "$apps_only_detail" ;;
  esac
}

identity_command="${LAST_STACK_CANARY_V2_PRIMARY_IDENTITY_CMD:-last-stack-lastdb-memory-guard --identity}"

read_primary_build() {
  # Print the build the primary runs right now, or nothing. Read twice: once at
  # step 2, and again after a failed cutover, because a row is a proved PAIR and
  # the second half of the pair is whatever the primary runs AT THAT MOMENT.
  local out rc=0 token
  set +e
  out="$(eval "$identity_command" 2>/dev/null)"
  rc=$?
  set -e
  [ "$rc" -eq 0 ] || return 0
  for token in $out; do
    case "$token" in build=*) printf '%s' "${token#build=}" ;; esac
  done
  return 0
}

# ── 0. primary-rows ──────────────────────────────────────────────────────
# A row is a proved pair <app sha, lastdb build>, and host-track installs only a
# pair whose build is the one the primary runs. So the moment the primary runs a
# build with no `next` row, every app install freezes. Step 0 closes that gap
# for whatever path moved the primary. It never builds and never cuts over.
#
# Cheap when rows exist: one identity read, one `lastdb --version`, one
# `lastdb app resolve`. publish-next writes a row for every app in one PR, so
# one app's row stands for the build's whole set; a new app with no row is the
# apps-only pass's job (it compares every app's pin).
#
# One lock covers step 0 and the full gate. The full gate cuts the
# primary over at step 5 and publishes its own rows at step 6. The hourly
# reconcile gate uses step 0 when another path moved the primary.

lock_owned=0
lock_holder=-

primary_rows_lock_live_holder() {
  # Print the pid of a LIVE holder, or nothing. An empty pid file is a holder
  # between mkdir and the pid write, unless the lock dir is older than 10 min.
  local pid
  [ -d "$primary_rows_lock" ] || return 0
  pid="$(sed -n '1p' "$primary_rows_lock/pid" 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    if kill -0 "$pid" 2>/dev/null; then printf '%s' "$pid"; fi
    return 0
  fi
  if [ -z "$(find "$primary_rows_lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    printf '%s' starting
  fi
  return 0
}

primary_rows_lock_acquire() {
  local holder
  mkdir -p "$(dirname "$primary_rows_lock")" 2>/dev/null || true
  if ! mkdir "$primary_rows_lock" 2>/dev/null; then
    holder="$(primary_rows_lock_live_holder)"
    if [ -n "$holder" ]; then
      lock_holder="$holder"
      return 1
    fi
    # The owner is gone. Take the lock over.
    rm -f "$primary_rows_lock/pid"
    rmdir "$primary_rows_lock" 2>/dev/null || true
    if ! mkdir "$primary_rows_lock" 2>/dev/null; then
      lock_holder=race
      return 1
    fi
  fi
  printf '%s\n' "$$" >"$primary_rows_lock/pid"
  lock_owned=1
  return 0
}

primary_rows_lock_release() {
  [ "$lock_owned" = 1 ] || return 0
  rm -f "$primary_rows_lock/pid"
  rmdir "$primary_rows_lock" 2>/dev/null || true
  lock_owned=0
}
trap primary_rows_lock_release EXIT

primary_rows_probe() {
  # primary_rows_probe <app>: print present | missing | unknown for the row
  # `next` holds for <app> proved with the build the primary runs.
  local app="$1" out rc=0 err_file sha
  err_file="$(mktemp "${TMPDIR:-/tmp}/primary-rows-probe.XXXXXX")"
  set +e
  out="$("$resolve_bin" app resolve "$app" --channel next --lastdb-version "$primary" --json 2>"$err_file")"
  rc=$?
  set -e
  sha="$(printf '%s' "$out" | jq -r '.sha // empty' 2>/dev/null || true)"
  if [ "$rc" -eq 0 ] && [ -n "$sha" ]; then
    printf '%s' present
  elif grep -q 'no next row' "$err_file" 2>/dev/null \
    || { [ "$rc" -eq 0 ] && printf '%s' "$out" | jq -e 'has("sha")' >/dev/null 2>&1; }; then
    printf '%s' missing
  else
    printf '%s' unknown
  fi
  rm -f "$err_file"
}

heads_check() {
  # heads_check <probe_app>: the rows for the primary build exist. Did an app
  # head move past the pin those rows hold? Sets heads_moved, heads_fp and
  # primary_rows_evidence / primary_rows_detail. Returns
  #    0  a head moved and nothing holds it back: prove the set now
  #   10  nothing to do (current, rate limited, RED unchanged, GREEN pending)
  #   20  the heads could not be read (reported, never smoked on)
  #
  # The head pick is the candidate-set tool's own (artifact channel head, else
  # GitHub main), run with --no-version-lookup: no package.json fetch, no smoke.
  local app="$1" heads_dir heads_file rc=0 stamp stamp_fp stamp_result stamp_at age last_at last_age
  heads_moved=""
  heads_fp=""
  if [ ! -x "$candidate_set_bin" ]; then
    primary_rows_evidence=tool_missing
    primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=tool_missing tool=$candidate_set_bin"
    return 20
  fi
  heads_dir="$(mktemp -d "${TMPDIR:-/tmp}/primary-rows-heads.XXXXXX")"
  heads_file="$heads_dir/heads.json"
  set +e
  "$candidate_set_bin" --lastdbd "$primary_lastdbd" --no-version-lookup --out "$heads_file" >"$heads_dir/heads.out" 2>&1
  rc=$?
  set -e
  if [ "$rc" -ne 0 ] || [ ! -s "$heads_file" ]; then
    primary_rows_evidence=heads_unreadable
    primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=heads_unreadable rc=$rc log=$heads_dir/heads.out"
    return 20
  fi
  heads_moved="$(apps_moved_past_registry "$heads_file")"
  heads_fp="$(apps_only_fingerprint "$heads_file")"
  rm -rf "$heads_dir"
  if [ -z "$heads_moved" ]; then
    primary_rows_evidence=rows_present
    primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=rows_present heads=current"
    return 10
  fi

  # The same pins were already proved for this build. A RED waits for a head to
  # move: a persistent RED must not buy an ~18-minute smoke every hour. A GREEN
  # waits for its tap PR to merge and the mirror to serve the row; after a day
  # with the row still absent, the PR is presumed lost and the set is proved again.
  stamp="$apps_only_stamp_dir/$primary.json"
  if [ -n "$heads_fp" ] && [ -f "$stamp" ]; then
    stamp_fp="$(jq -r '.fingerprint // ""' "$stamp" 2>/dev/null || true)"
    stamp_result="$(jq -r '.result // ""' "$stamp" 2>/dev/null || true)"
    stamp_at="$(jq -r '.at_epoch // 0' "$stamp" 2>/dev/null || true)"
    [[ "$stamp_at" =~ ^[0-9]+$ ]] || stamp_at=0
    age=$(( $(date +%s) - stamp_at ))
    if [ "$stamp_fp" = "$heads_fp" ] && [ "$stamp_result" = red ]; then
      primary_rows_evidence=heads_red_unchanged
      primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app moved=$heads_moved evidence=heads_red_unchanged age=${age}s"
      return 10
    fi
    if [ "$stamp_fp" = "$heads_fp" ] && [ "$stamp_result" = green ] && [ "$age" -lt "$heads_green_recheck" ]; then
      primary_rows_evidence=heads_rows_pending
      primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app moved=$heads_moved evidence=heads_rows_pending age=${age}s"
      return 10
    fi
  fi
  # At most one apps-only smoke an hour on this host, whatever started it.
  if [ -f "$last_smoke_stamp" ]; then
    last_at="$(jq -r '.at_epoch // 0' "$last_smoke_stamp" 2>/dev/null || true)"
    [[ "$last_at" =~ ^[0-9]+$ ]] || last_at=0
    last_age=$(( $(date +%s) - last_at ))
    if [ "$last_age" -lt "$heads_interval" ]; then
      primary_rows_evidence=heads_rate_limited
      primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app moved=$heads_moved evidence=heads_rate_limited last_smoke_age=${last_age}s interval=${heads_interval}s"
      return 10
    fi
  fi
  return 0
}

red_papercut() {
  # red_papercut <moved>: a RED primary-rows smoke is an app set that does not
  # install against the build the primary runs. File it once per build and
  # append each later RED, so the smoke output reaches the backlog. Best effort:
  # prints one short status for the detail line and never fails the step.
  local moved="$1" slug body rc=0 status existing
  [ "$red_papercut_enabled" = 1 ] || { printf '%s' disabled; return 0; }
  command -v "$brain_bin" >/dev/null 2>&1 || { printf '%s' brain_absent; return 0; }
  slug="papercut-canary-primary-rows-smoke-red-$(printf '%s' "$primary" | tr 'A-Z.' 'a-z-' | tr -cd 'a-z0-9-')"
  body="$(mktemp "${TMPDIR:-/tmp}/primary-rows-red.XXXXXX")"
  {
    printf '%s\n' "## RED $(date -u +%Y-%m-%dT%H:%M:%SZ)" ''
    printf '%s\n' "The primary-rows step of last-stack-canary-candidate-gate proved the app set" \
      "against the LastDB build the primary runs ($primary), and the isolated" \
      "llms-txt smoke was RED. No registry next rows were written. The step does" \
      "not smoke this set again until an app head moves." ''
    printf '%s\n' "- primary build: $primary" "- moved apps: ${moved:-none}" \
      "- run dir: $run_dir" "- smoke stderr: $run_dir/apps-only-smoke.err" ''
    printf '%s\n' '### Candidate set pins' '```'
    jq -r '.apps | to_entries[] | "\(.key) \(.value.sha) \(.value.sha_source // "-")"' "$run_dir/apps-only-set.json" 2>/dev/null || true
    printf '%s\n' '```' '' '### Smoke verdict' '```'
    head -c 4000 "$run_dir/apps-only-proof.json" 2>/dev/null || true
    printf '\n%s\n' '```' '' '### Smoke stderr (last 60 lines)' '```'
    tail -n 60 "$run_dir/apps-only-smoke.err" 2>/dev/null || true
    printf '%s\n' '```'
  } >"$body"
  existing="$("$brain_bin" get "$slug" --type papercut 2>/dev/null || true)"
  status="$(printf '%s\n' "$existing" | sed -n 's/^status:[[:space:]]*//p' | head -n1)"
  if [ -n "$existing" ] && { [ "$status" = open ] || [ "$status" = partial ]; }; then
    "$brain_bin" append "$slug" --type papercut <"$body" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] && printf '%s' "appended:$slug" || printf '%s' "append_failed:$slug"
  else
    # A closed record for this build means the defect came back: a new row.
    [ -z "$existing" ] || slug="$slug-$(date -u +%Y%m%dt%H%M%Sz)"
    "$brain_bin" papercut file "$slug" --component canary-candidate-gate \
      --symptom "primary-rows smoke RED for the app set on lastdb $primary (moved: ${moved:-none})" \
      --title "Canary primary-rows smoke RED on lastdb $primary; no next rows for moved app heads" \
      --severity p2 --repo EdgeVector/last-stack --body-file "$body" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 0 ] && printf '%s' "filed:$slug" || printf '%s' "file_rc$rc:$slug"
  fi
  rm -f "$body"
  return 0
}

primary_rows_step() {
  # Sets primary_rows_status (ok | noop | spawned | red | unknown | skipped),
  # primary_rows_evidence and primary_rows_detail. Returns 0 on ok/spawned,
  # 10 on noop/skipped, 20 on red/unknown. Never exits the gate.
  local app probe bin_build rc=0 ts log child_dir child why=primary_rows_missing spawn_evidence=rows_missing hrc=0 paper
  primary_rows_status=noop
  primary_rows_evidence=unset
  primary_rows_detail=""
  if [ "$primary_rows_enabled" != 1 ]; then
    primary_rows_status=skipped
    primary_rows_evidence=disabled
    primary_rows_detail="stage=primary-rows evidence=disabled"
    return 10
  fi
  primary="$(read_primary_build)"
  if [ -z "$primary" ] || [ "$primary" = unknown ]; then
    primary=-
    primary_rows_status=unknown
    primary_rows_evidence=primary_identity_absent
    primary_rows_detail="stage=primary-rows evidence=primary_identity_absent"
    return 20
  fi
  if [ -z "$primary_lastdbd" ] || [ ! -x "$primary_lastdbd" ]; then
    primary_rows_evidence=primary_lastdbd_absent
    primary_rows_detail="stage=primary-rows primary=$primary evidence=primary_lastdbd_absent bin=${primary_lastdbd:-unset}"
    return 10
  fi
  # The smoke boots the binary; the row names the running build. They must be
  # the same build, or the row would name a pair nothing proved (a binary
  # swapped on disk before the daemon restarts, for example).
  bin_build="$("$primary_lastdbd" --version 2>/dev/null | awk 'NF {v=$NF} END {print v}' || true)"
  if [ "$bin_build" != "$primary" ]; then
    primary_rows_evidence=primary_binary_mismatch
    primary_rows_detail="stage=primary-rows primary=$primary evidence=primary_binary_mismatch binary=${bin_build:-unreadable}"
    return 10
  fi
  app="$primary_rows_probe_app"
  if [ -z "$app" ]; then
    app="$(jq -r '.apps | keys[0] // empty' "$apps_config" 2>/dev/null || true)"
  fi
  [ -n "$app" ] || app=kanban
  probe="$(primary_rows_probe "$app")"
  case "$probe" in
    present)
      if [ "$heads_enabled" != 1 ]; then
        primary_rows_evidence=rows_present
        primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=rows_present heads=skipped"
        return 10
      fi
      heads_check "$app" || hrc=$?
      case "$hrc" in
        0)  why=primary_rows_heads_moved; spawn_evidence=heads_moved ;;
        10) return 10 ;;
        *)  primary_rows_status=unknown; return 20 ;;
      esac
      ;;
    missing) ;;
    *)
      # Do not smoke on a probe that could not answer: a broken resolve must
      # not buy an ~18-minute smoke every hour. Report it; it is visible.
      primary_rows_status=unknown
      primary_rows_evidence=probe_failed
      primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=probe_failed"
      return 20
      ;;
  esac

  if [ "$mode" = primary-rows ] && [ "$detach" = 1 ]; then
    lock_holder="$(primary_rows_lock_live_holder)"
    if [ -n "$lock_holder" ]; then
      primary_rows_evidence=locked
      primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=locked holder=$lock_holder"
      return 10
    fi
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    child_dir="$primary_rows_log_dir/$ts-$primary"
    log="$child_dir.log"
    mkdir -p "$child_dir"
    # Its own session: the hourly caller returns now. Its process-group
    # teardown must not take the worker with it.
    ROUTINES_RUN_DIR="$child_dir" nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!\n"' \
      "$self_path" --primary-rows-only </dev/null >"$log" 2>&1 &
    child=$!
    primary_rows_status=spawned
    primary_rows_evidence="$spawn_evidence"
    primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=$spawn_evidence${heads_moved:+ moved=$heads_moved} pid=$child log=$log"
    return 0
  fi

  if [ "$lock_owned" != 1 ] && ! primary_rows_lock_acquire; then
    primary_rows_evidence=locked
    primary_rows_detail="stage=primary-rows primary=$primary probe_app=$app evidence=locked holder=$lock_holder"
    return 10
  fi
  apps_only_run "$why" || rc=$?
  primary_rows_detail="$(printf '%s' "$apps_only_detail" | sed 's/stage=apps-only/stage=primary-rows/') probe_app=$app"
  primary_rows_evidence="$apps_only_evidence"
  if [ "$rc" -eq 20 ] && [ "$apps_only_evidence" = smoke_red ]; then
    paper="$(red_papercut "$(printf '%s' "$apps_only_detail" | sed -n 's/.* moved=\([^ ]*\).*/\1/p')")"
    primary_rows_detail="$primary_rows_detail papercut=$paper"
  fi
  case "$rc" in
    0)  primary_rows_status=ok; return 0 ;;
    10) primary_rows_status=noop; return 10 ;;
    *)  primary_rows_status=red; return 20 ;;
  esac
}

if [ "$mode" = primary-rows ]; then
  step0_rc=0
  primary_rows_step || step0_rc=$?
  printf 'PRIMARY_ROWS result=%s %s\n' "$primary_rows_status" "$primary_rows_detail"
  [ "$step0_rc" -ne 20 ] || exit 1
  exit 0
fi

# The full gate holds the lock for its whole run (see above). A live holder is
# a primary-rows worker in flight: step 0 is its job, so skip it here.
if primary_rows_lock_acquire; then
  primary_rows_step || true
else
  primary_rows_status=skipped
  primary_rows_evidence=locked
fi
# A GREEN or RED step 0 wrote the apps-only cooldown stamp for <primary build,
# app pins>. The apps-only exits below read the same stamp, so they do not
# smoke the same pins a second time in this run.

for tool in "$dogfood" "$pipeline"; do
  [ -x "$tool" ] || result error "evidence=tool_missing tool=$tool"
done

# ── 1. build ─────────────────────────────────────────────────────────────
build_status=skipped
if [ "$skip_build" != 1 ]; then
  [ -x "$build_main" ] || result error "evidence=tool_missing tool=$build_main"
  set +e
  build_json="$(LAST_STACK_CANARY_FETCH_MAIN=1 "$build_main" --json)"
  build_rc=$?
  set -e
  if [ "$build_rc" -ne 0 ]; then
    # No ledger line event here: `record-line-event` knows the subjects
    # observer and host, and a failed build is neither (an observer failure
    # would read as line-stopped in the hourly verdict). The result line and
    # ROUTINE_RESULT are the evidence; the primary stays where it is.
    result error "stage=build evidence=build_failed rc=$build_rc"
  fi
  build_status="$(printf '%s\n' "$build_json" | jq -r '.status // "unknown"' 2>/dev/null || echo unknown)"
fi

# ── 2. resolve the candidate and the hold policy ─────────────────────────
primary="$(read_primary_build)"
if [ -z "$primary" ] || [ "$primary" = unknown ]; then
  "$pipeline" record-line-event --check primary_identity --subject observer --result fail --detail absent >/dev/null || true
  result error "stage=resolve subject=observer evidence=primary_identity_absent"
fi
"$pipeline" record-line-event --check primary_identity --subject observer --result pass >/dev/null || true

set +e
preview="$("$dogfood" --dry-run --json)"
preview_rc=$?
set -e
[ "$preview_rc" -eq 0 ] || result error "stage=resolve evidence=candidate_absent"
incoming="$(printf '%s\n' "$preview" | jq -r '.version // empty' 2>/dev/null || true)"
candidate_bin="$(printf '%s\n' "$preview" | jq -r '.safe_upgrade_args[1] // empty' 2>/dev/null || true)"
[ -n "$incoming" ] && [ "$incoming" != unknown ] || result error "stage=resolve evidence=candidate_identity_absent"
[ -n "$candidate_bin" ] && [ -f "$candidate_bin" ] || result error "stage=resolve evidence=candidate_binary_absent candidate=$incoming"

if [ "$incoming" = "$primary" ]; then
  # No new build to cut over to. The apps may still have moved.
  apps_only_pass primary_already_on_candidate
fi

channel_args=(--json channels --main-build "$primary" --incoming-build "$incoming" --cutover-hold-hours "$hold_hours")
[ "${LAST_STACK_CANARY_V2_INCOMING_FIXES_RED:-0}" != 1 ] || channel_args+=(--incoming-fixes-red)
[ -z "${LAST_STACK_CANARY_V2_AT:-}" ] || channel_args+=(--at "$LAST_STACK_CANARY_V2_AT")
channel_json="$("$pipeline" "${channel_args[@]}")"
if [ "$(printf '%s\n' "$channel_json" | jq -r '.cutover.hold // false')" = true ]; then
  # The cutover is held, so the primary keeps its build. Prove the apps against
  # the build it actually runs rather than waiting for the window.
  apps_only_pass quiet_window_near_complete
fi

# ── 3. candidate set ─────────────────────────────────────────────────────
[ -x "$candidate_set_bin" ] || result error "evidence=tool_missing tool=$candidate_set_bin"
mkdir -p "$run_dir"
set_file="$run_dir/candidate-set.json"
set +e
"$candidate_set_bin" --lastdbd "$candidate_bin" --out "$set_file" >"$run_dir/candidate-set.out" 2>&1
set_rc=$?
set -e
if [ "$set_rc" -ne 0 ]; then
  "$pipeline" record-line-event --check candidate_set --subject observer --result fail --detail "exit=$set_rc" >/dev/null || true
  result error "stage=set candidate=$incoming evidence=candidate_set_failed rc=$set_rc"
fi
app_count="$(jq -r '.apps | length' "$set_file")"

# ── 4. isolated smoke on the set, booting the candidate lastdbd ──────────
smoke_status=skipped
proof_file="$run_dir/smoke-proof.json"
if [ "$skip_smoke" != 1 ]; then
  [ -f "$smoke_run" ] || result error "evidence=tool_missing tool=$smoke_run"
  set +e
  SMOKE_LASTDBD_BIN="$candidate_bin" SMOKE_CANDIDATE_SET="$set_file" \
    bash "$smoke_run" --json >"$proof_file" 2>"$run_dir/smoke.err"
  smoke_rc=$?
  set -e
  smoke_status="$(jq -r '.verdict // empty' "$proof_file" 2>/dev/null || true)"
  if [ "$smoke_rc" -ne 0 ] || [ "$smoke_status" != GREEN ]; then
    steps="$(jq -r '.steps // "no-verdict"' "$proof_file" 2>/dev/null || echo no-verdict)"
    # A RED smoke is a verdict about the candidate set, not about the observer
    # or the host, and the ledger's line events know only those two subjects.
    # The candidate never boots on the primary, so there is nothing for the
    # hourly reconciler to grade; this result line is the record.
    result error "stage=smoke candidate=$incoming apps=$app_count evidence=smoke_red steps=$steps log=$run_dir/smoke.err"
  fi
fi

# ── 5. cutover (the existing bounded safe-upgrade action) ────────────────
set +e
cutover="$("$dogfood" --cutover --json)"
cutover_rc=$?
set -e
if [ "$cutover_rc" -ne 0 ]; then
  # The GREEN set above proved the app commits against the CANDIDATE build, and
  # the primary did not take that build -- so those rows are useless to this
  # host and step 6 below is never reached. That discarded a GREEN app set on 3
  # of the 13 runs before 2026-09-26, including the 09:47Z one that left brain
  # 5 commits behind its pin:
  # papercut-canary-gate-discards-a-green-app-set-when-the-primary-cutover-fails-20260926
  #
  # So publish the rows the host CAN use, from the third call site of the
  # apps-only worker, pinned to the build the primary actually runs. The cutover
  # failure stays outcome=error -- routinesd escalates on that and must keep
  # doing so -- and the rows are reported in the detail.
  #
  # Re-read the identity first. A cutover that reports failure may still have
  # moved (or be moving) the primary, and a row proved against a build the host
  # does not run is exactly the wrong thing this record warns about. No identity,
  # no rows.
  apps_only_status=skipped
  apps_only_evidence=not_attempted
  apps_only_rows=-
  apps_only_moved=-
  primary_now="$(read_primary_build)"
  if [ -z "$primary_now" ] || [ "$primary_now" = unknown ]; then
    apps_only_status=unknown
    apps_only_evidence=primary_identity_absent_after_cutover
  else
    primary="$primary_now"
    apps_only_rc=0
    apps_only_run cutover_failed || apps_only_rc=$?
  fi
  result error "stage=cutover candidate=$incoming smoke=$smoke_status evidence=cutover_failed primary_now=${primary_now:-unknown} apps_only=$apps_only_status apps_only_evidence=$apps_only_evidence apps_only_moved=$apps_only_moved rows=$apps_only_rows"
fi
cutover_result="$(printf '%s\n' "$cutover" | jq -r '.safe_upgrade // "unknown"' 2>/dev/null || true)"

# ── 6. proved rows → registry next ───────────────────────────────────────
rows_status=skipped
if [ "$skip_rows" != 1 ] && [ "$skip_smoke" != 1 ]; then
  [ -x "$publish_next" ] || result error "evidence=tool_missing tool=$publish_next"
  set +e
  rows_out="$("$publish_next" --candidate-set "$set_file" --proof "$proof_file" 2>"$run_dir/rows.err")"
  rows_rc=$?
  set -e
  if [ "$rows_rc" -ne 0 ]; then
    # The primary is already on the candidate; a rows failure is a lane fault,
    # not a build verdict. Say so and leave the evidence where the next run finds it.
    result error "stage=rows candidate=$incoming cutover=$cutover_result evidence=rows_failed rc=$rows_rc log=$run_dir/rows.err"
  fi
  rows_status="$(printf '%s\n' "$rows_out" | sed -n 's/^REGISTRY_NEXT status=\([^ ]*\).*/\1/p' | tail -n1)"
  rows_pr="$(printf '%s\n' "$rows_out" | sed -n 's/.* pr=\([^ ]*\).*/\1/p' | tail -n1)"
  [ -z "$rows_pr" ] || rows_status="$rows_status:$rows_pr"
fi

result ok "candidate=$incoming primary_was=$primary build=$build_status apps=$app_count smoke=$smoke_status cutover=$cutover_result rows=$rows_status"
