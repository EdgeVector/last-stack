#!/usr/bin/env python3
"""Prove the five permanent feature-delivery fixes against installed products.

PASS is terminal. PENDING means that an artifact or the 24-hour LastDB soak is
not ready. FAIL means that an installed fix failed its product probe.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any


SLUG = "north-star-feature-delivery-effective-flow"
MILESTONE = "feature-delivery-effective-flow-v1"
BOARD_MILESTONE_MISMATCH = "does not match milestone"
SOAK_SECONDS = 24 * 60 * 60
WARM_CACHE_LIMIT_BYTES = 4294967296

FIXES: dict[str, list[dict[str, str]]] = {
    "fkanban": [
        {
            "name": "durable milestone on add",
            "source_commit": "ec51f37a1502fd8cf0ad21e10b293ffca0ae9a7d",
        },
        {
            "name": "immediate claim and show coherence",
            "source_commit": "b3868f5c0bdb7a14d41a391432ac51fbc3a75528",
        },
        {
            "name": "bounded board move write",
            "source_commit": "e59594d546b2cc0193b6ed7196c41b5fa6aaf128",
        },
        {
            "name": "keyed feature flow ledger",
            "source_commit": "64096f71d15cc2745bd0ee13989efd4264d04bc0",
        },
    ],
    "last-stack": [
        {
            "name": "two-outcome feature admission",
            "source_commit": "ce7566abb3302c63da61aa26ee6dada8d5762f0d",
        },
        {
            "name": "current-main slice satisfaction",
            "source_commit": "7bb8dd280574a382f141e8c2ec3fc02581a132db",
        },
        {
            "name": "monotonic card closeout",
            "source_commit": "a312542dfc1b58932563d17d29b2bda9baeb47cf",
        },
    ],
    "fold": [
        {
            "name": "full-heap warm-cache accounting",
            "source_commit": "28e77f30e774f6ac16c50a214cdb280d12025e6d",
        }
    ],
    "routines": [
        {
            "name": "all-route provider fallback",
            "source_commit": "fd3a50c6d0366672312b414e5ff24690b4c0c174",
        }
    ],
}


class ProofError(Exception):
    """A product probe cannot produce valid evidence."""


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def after(hours: int) -> str:
    return (
        (dt.datetime.now(dt.timezone.utc) + dt.timedelta(hours=hours))
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def board_milestone_mismatch_line(text: str) -> str | None:
    for line in text.splitlines():
        if BOARD_MILESTONE_MISMATCH in line:
            return line.strip()
    return None


def raise_if_board_milestone_mismatch(text: str, label: str) -> None:
    line = board_milestone_mismatch_line(text)
    if line:
        raise ProofError(f"{label} returned board/milestone mismatch: {line}")


def run(
    argv: list[str],
    *,
    env: dict[str, str] | None = None,
    timeout: int = 90,
    allowed: tuple[int, ...] = (0,),
) -> subprocess.CompletedProcess[str]:
    try:
        cp = subprocess.run(
            argv,
            text=True,
            capture_output=True,
            env=env,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise ProofError(f"{' '.join(argv)} failed: {exc}") from exc
    combined = f"{cp.stderr or ''}\n{cp.stdout or ''}"
    raise_if_board_milestone_mismatch(combined, " ".join(argv[:6]))
    if cp.returncode not in allowed:
        detail = combined.strip().splitlines()
        raise ProofError(
            f"{' '.join(argv)} returned {cp.returncode}: "
            f"{detail[0] if detail else 'no output'}"
        )
    return cp


def parse_json(text: str, label: str) -> dict[str, Any]:
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        raise ProofError(f"{label} returned invalid JSON: {exc}") from exc
    if not isinstance(value, dict):
        raise ProofError(f"{label} did not return a JSON object")
    return value


def timed_probe(name: str, callback: Any) -> dict[str, Any]:
    started = now()
    try:
        detail = callback()
        status = "pass"
        if not isinstance(detail, dict):
            detail = {"detail": str(detail)}
    except ProofError as exc:
        detail = {"reason": str(exc)}
        status = "fail"
    return {
        "name": name,
        "status": status,
        "started_at": started,
        "finished_at": now(),
        **detail,
    }


def workspace() -> Path:
    return Path(os.environ.get("EDGEVECTOR_WORKSPACE", str(Path.home() / "code/edgevector")))


def cache_path(repo: str) -> Path:
    marker = workspace() / repo / ".portal/cache"
    if not marker.is_file():
        raise ProofError(f"missing portal cache marker: {marker}")
    value = marker.read_text().strip()
    if not value:
        raise ProofError(f"empty portal cache marker: {marker}")
    path = Path(value)
    if not path.is_dir():
        raise ProofError(f"portal cache does not exist: {path}")
    return path


def git(repo: str, *args: str) -> str:
    cp = run(["git", f"--git-dir={cache_path(repo)}", *args], timeout=60)
    return cp.stdout.strip()


def source_contains(repo: str, required: str, installed: str) -> bool:
    if not required or not installed:
        return False
    cp = run(
        ["git", f"--git-dir={cache_path(repo)}", "merge-base", "--is-ancestor", required, installed],
        timeout=60,
        allowed=(0, 1),
    )
    return cp.returncode == 0


def read_stamp(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise ProofError(f"missing install stamp: {path}")
    return parse_json(path.read_text(), str(path))


def installed_heads() -> tuple[dict[str, str], dict[str, Any]]:
    home = Path.home()
    stamps = home / ".host-track/stamps"
    heads = {
        "fkanban": str(read_stamp(stamps / "kanban.json").get("source_oid", "")),
        "last-stack": str(read_stamp(stamps / "last-stack.json").get("source_oid", "")),
        "routines": str(read_stamp(stamps / "routines.json").get("source_oid", "")),
    }
    status = parse_json(run(["lastdb", "status", "--json"], timeout=60).stdout, "lastdb status")
    build = str(status.get("daemon_build", ""))
    match = re.search(r"g([0-9a-f]{7,40})$", build)
    fold_head = ""
    if match:
        cp = run(
            ["git", f"--git-dir={cache_path('fold')}", "rev-parse", f"{match.group(1)}^{{commit}}"],
            timeout=60,
            allowed=(0, 128),
        )
        if cp.returncode == 0:
            fold_head = cp.stdout.strip()
    heads["fold"] = fold_head
    return heads, {"build": build, "status": status}


def component_evidence(heads: dict[str, str]) -> dict[str, Any]:
    evidence: dict[str, Any] = {}
    for repo, fixes in FIXES.items():
        installed = heads.get(repo, "")
        checks = []
        for fix in fixes:
            checks.append(
                {
                    **fix,
                    "installed_head": installed,
                    "present": source_contains(repo, fix["source_commit"], installed),
                }
            )
        evidence[repo] = {"installed_head": installed, "fixes": checks}
    return evidence


def all_present(components: dict[str, Any], repo: str, names: tuple[str, ...]) -> bool:
    checks = components.get(repo, {}).get("fixes", [])
    by_name = {str(check.get("name")): bool(check.get("present")) for check in checks}
    return all(by_name.get(name, False) for name in names)


def installed_root(app: str) -> Path:
    if app == "last-stack":
        return Path.home() / ".local/state/last-stack/artifacts/current"
    if app == "routines":
        return Path.home() / ".host-track/apps/routines/current"
    raise ProofError(f"unknown installed app: {app}")


def proof_command(root: Path, name: str) -> Path:
    path = root / "bin" / name
    if not path.is_file():
        raise ProofError(f"installed command is missing: {path}")
    return path


def probe_admission() -> dict[str, Any]:
    # Read the actual policy. Do not create synthetic cases or write test cards.
    command = proof_command(installed_root("last-stack"), "last-stack-feature-portfolio-admission")
    policy = parse_json(
        run([str(command), "--json"], timeout=90).stdout,
        "admission policy",
    )
    if policy.get("verdict") != "report":
        raise ProofError(f"admission policy returned {policy.get('verdict')!r}, not 'report'")
    admitted = policy.get("admitted_outcomes")
    if not isinstance(admitted, list) or not 1 <= len(admitted) <= 3:
        raise ProofError(f"admission policy returned invalid outcomes: {admitted!r}")
    if not all(isinstance(slug, str) and slug for slug in admitted):
        raise ProofError(f"admission policy returned invalid outcome slugs: {admitted!r}")
    if len(set(admitted)) != len(admitted):
        raise ProofError(f"admission policy returned duplicate outcomes: {admitted!r}")
    paused_list = policy.get("paused_outcomes")
    if not isinstance(paused_list, list) or not all(
        isinstance(slug, str) and slug for slug in paused_list
    ):
        raise ProofError(f"admission policy returned invalid paused_outcomes: {paused_list!r}")

    return {
        "policy_version": policy.get("policy_version"),
        "admitted_outcomes": admitted,
        "paused_outcomes": paused_list,
    }


def read_self_metric_samples(process_start: int) -> list[dict[str, Any]]:
    path = Path(
        os.environ.get(
            "LASTDB_SELF_METRICS_FILE",
            str(Path.home() / ".lastdb/logs/self-metrics.jsonl"),
        )
    )
    if not path.is_file():
        raise ProofError(f"LastDB self-metric file is missing: {path}")
    samples: list[dict[str, Any]] = []
    with path.open() as stream:
        for line in stream:
            if not line.strip():
                continue
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(value, dict) and value.get("process_start_ts") == process_start:
                samples.append(value)
    return samples


def collect_lastdb_soak(lastdb_meta: dict[str, Any], fixed_build: bool) -> dict[str, Any]:
    result: dict[str, Any] = {
        "build": lastdb_meta.get("build", ""),
        "fixed_build": fixed_build,
        "required_seconds": SOAK_SECONDS,
        "samples": [],
    }
    if not fixed_build:
        result["status"] = "pending"
        result["reason"] = "the active LastDB build does not contain the full-heap cache fix"
        return result
    metrics_path = Path(
        os.environ.get(
            "LASTDB_SELF_METRICS_FILE",
            str(Path.home() / ".lastdb/logs/self-metrics.jsonl"),
        )
    )
    if not metrics_path.is_file():
        result["status"] = "fail"
        result["reason"] = f"missing LastDB self metrics: {metrics_path}"
        return result
    latest: dict[str, Any] | None = None
    with metrics_path.open() as stream:
        for line in stream:
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(value, dict) and isinstance(value.get("process_start_ts"), int):
                latest = value
    if latest is None:
        result["status"] = "fail"
        result["reason"] = "LastDB self metrics contain no process sample"
        return result
    process_start = int(latest["process_start_ts"])
    samples = read_self_metric_samples(process_start)
    result["process_start_ts"] = process_start
    result["samples"] = samples
    return result


def sample_number(sample: dict[str, Any], field: str) -> int | None:
    value = sample.get(field)
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def evaluate_soak(soak: dict[str, Any]) -> dict[str, Any]:
    started = now()
    if not soak.get("fixed_build"):
        return {
            "name": "LastDB 24-hour full-heap soak",
            "status": "pending",
            "started_at": started,
            "finished_at": now(),
            "reason": str(soak.get("reason", "the fixed build is not active")),
            "build": soak.get("build", ""),
        }
    samples = soak.get("samples")
    if not isinstance(samples, list) or not samples:
        return {
            "name": "LastDB 24-hour full-heap soak",
            "status": "fail",
            "started_at": started,
            "finished_at": now(),
            "reason": "the fixed process has no self-metric samples",
            "build": soak.get("build", ""),
        }
    valid = [sample for sample in samples if isinstance(sample, dict)]
    process_starts = {sample_number(sample, "process_start_ts") for sample in valid}
    if None in process_starts or len(process_starts) != 1:
        return {
            "name": "LastDB 24-hour full-heap soak",
            "status": "pending",
            "started_at": started,
            "finished_at": now(),
            "reason": "the sample window crosses a LastDB restart; the soak resets",
            "build": soak.get("build", ""),
        }
    epochs = [sample_number(sample, "sampled_at") for sample in valid]
    if any(value is None for value in epochs):
        return {
            "name": "LastDB 24-hour full-heap soak",
            "status": "fail",
            "started_at": started,
            "finished_at": now(),
            "reason": "a LastDB sample has no sampled_at value",
            "build": soak.get("build", ""),
        }
    first = min(int(value) for value in epochs if value is not None)
    last = max(int(value) for value in epochs if value is not None)
    span = last - first
    violations: list[str] = []
    for sample in valid:
        resident = sample_number(sample, "warm_resident_bytes")
        budget = sample_number(sample, "warm_budget_bytes")
        rss = sample_number(sample, "rss_bytes")
        limit = sample_number(sample, "memory_limit_bytes")
        at = sample.get("sampled_at", "unknown")
        if resident is None or budget is None or budget <= 0:
            violations.append(f"sample {at} lacks the warm-cache byte contract")
        else:
            if budget > WARM_CACHE_LIMIT_BYTES:
                violations.append(
                    f"sample {at} warm budget {budget} exceeds hard limit {WARM_CACHE_LIMIT_BYTES}"
                )
            if resident > WARM_CACHE_LIMIT_BYTES:
                violations.append(
                    f"sample {at} warm bytes {resident} exceed hard limit {WARM_CACHE_LIMIT_BYTES}"
                )
            elif resident > budget:
                violations.append(f"sample {at} warm bytes {resident} exceed {budget}")
        if rss is not None and limit is not None and limit > 0 and rss > limit:
            violations.append(f"sample {at} RSS {rss} exceeds guard limit {limit}")
        if sample.get("runtime_degraded") is True:
            violations.append(f"sample {at} reports runtime_degraded=true")
    if violations:
        return {
            "name": "LastDB 24-hour full-heap soak",
            "status": "fail",
            "started_at": started,
            "finished_at": now(),
            "reason": violations[0],
            "violation_count": len(violations),
            "sample_count": len(valid),
            "span_seconds": span,
            "build": soak.get("build", ""),
        }
    required = int(soak.get("required_seconds", SOAK_SECONDS))
    if span < required:
        return {
            "name": "LastDB 24-hour full-heap soak",
            "status": "pending",
            "started_at": started,
            "finished_at": now(),
            "reason": (
                f"the fixed process has {span}s of the required {required}s sample window; "
                f"it needs {required - span}s more"
            ),
            "sample_count": len(valid),
            "span_seconds": span,
            "remaining_seconds": required - span,
            "process_start_ts": next(iter(process_starts)),
            "build": soak.get("build", ""),
        }
    return {
        "name": "LastDB 24-hour full-heap soak",
        "status": "pass",
        "started_at": started,
        "finished_at": now(),
        "sample_count": len(valid),
        "span_seconds": span,
        "process_start_ts": next(iter(process_starts)),
        "max_warm_resident_bytes": max(int(sample["warm_resident_bytes"]) for sample in valid),
        "max_warm_budget_bytes": max(int(sample["warm_budget_bytes"]) for sample in valid),
        "warm_budget_bytes": min(int(sample["warm_budget_bytes"]) for sample in valid),
        "warm_limit_bytes": WARM_CACHE_LIMIT_BYTES,
        "build": soak.get("build", ""),
    }


def skipped_probe(name: str, reason: str) -> dict[str, Any]:
    stamp = now()
    return {
        "name": name,
        "status": "pending",
        "started_at": stamp,
        "finished_at": stamp,
        "reason": reason,
    }


def collect_live() -> dict[str, Any]:
    collected_at = now()
    heads, lastdb_meta = installed_heads()
    components = component_evidence(heads)
    last_stack_ready = all_present(
        components, "last-stack", ("two-outcome feature admission",)
    )
    fold_ready = all_present(components, "fold", ("full-heap warm-cache accounting",))
    reason = (
        "No operational evidence is supplied for this clause. "
        "Synthetic fixtures and test suites are retired by no-tests-all-repos-20261009."
    )
    probes = {
        name: skipped_probe(name.replace("_", " "), reason)
        for name in ("card_truth", "board_write", "flow_ledger", "satisfaction", "closeout", "provider_fallback")
    }
    if last_stack_ready:
        probes["admission"] = timed_probe("installed admission policy", probe_admission)
    else:
        probes["admission"] = skipped_probe(
            "installed admission policy", "the active artifact lacks the required source commit"
        )
    soak = collect_lastdb_soak(lastdb_meta, fold_ready)
    return {
        "captured_at": collected_at,
        "components": components,
        "probes": probes,
        "lastdb": soak,
    }


def fix_status(components: dict[str, Any], repo: str, name: str) -> str:
    for fix in components.get(repo, {}).get("fixes", []):
        if fix.get("name") == name:
            return "pass" if fix.get("present") else "pending"
    return "pending"


def combine_status(statuses: list[str]) -> str:
    if "fail" in statuses:
        return "fail"
    if any(status != "pass" for status in statuses):
        return "pending"
    return "pass"


def evaluate(snapshot: dict[str, Any]) -> dict[str, Any]:
    components = snapshot.get("components", {})
    probes = snapshot.get("probes", {})
    soak_probe = evaluate_soak(snapshot.get("lastdb", {}))
    probes = {**probes, "lastdb_soak": soak_probe}
    clauses = [
        {
            "number": 1,
            "title": "Durable card truth",
            "sources": [
                ("fkanban", "durable milestone on add"),
                ("fkanban", "immediate claim and show coherence"),
            ],
            "probes": ["card_truth"],
        },
        {
            "number": 2,
            "title": "Portfolio admission and current-main duplicate prevention",
            "sources": [
                ("last-stack", "two-outcome feature admission"),
                ("last-stack", "current-main slice satisfaction"),
            ],
            "probes": ["admission", "satisfaction"],
        },
        {
            "number": 3,
            "title": "Monotonic closeout",
            "sources": [("last-stack", "monotonic card closeout")],
            "probes": ["closeout"],
        },
        {
            "number": 4,
            "title": "Bounded board and LastDB memory",
            "sources": [
                ("fkanban", "bounded board move write"),
                ("fold", "full-heap warm-cache accounting"),
            ],
            "probes": ["board_write", "lastdb_soak"],
        },
        {
            "number": 5,
            "title": "Provider fallback and keyed flow ledger",
            "sources": [
                ("routines", "all-route provider fallback"),
                ("fkanban", "keyed feature flow ledger"),
            ],
            "probes": ["provider_fallback", "flow_ledger"],
        },
    ]
    results = []
    for clause in clauses:
        statuses = [fix_status(components, repo, name) for repo, name in clause["sources"]]
        statuses.extend(str(probes.get(name, {}).get("status", "pending")) for name in clause["probes"])
        results.append({**clause, "status": combine_status(statuses)})
    overall = combine_status([clause["status"] for clause in results])
    return {
        "verdict": overall.upper(),
        "captured_at": snapshot.get("captured_at", now()),
        "finished_at": now(),
        "components": components,
        "probes": probes,
        "clauses": results,
    }


def render(report: dict[str, Any], offline: bool = False) -> str:
    verdict = str(report["verdict"])
    first_line = "PENDING-OFFLINE" if offline else verdict
    lines = [
        first_line,
        "",
        f"# North Star proof — {SLUG}",
        "",
        f"Start: {report.get('captured_at', '')}",
        f"Finish: {report.get('finished_at', '')}",
        f"Verdict: {first_line}",
        "",
    ]
    if not offline and verdict == "PASS":
        lines[2:2] = ["PROOF: PASS", ""]
    components = report.get("components", {})
    probes = report.get("probes", {})
    for clause in report.get("clauses", []):
        lines.extend(
            [
                f"## {clause['number']}. {clause['title']}",
                "",
                f"Verdict: {str(clause['status']).upper()}",
                "",
                "Sources:",
                "",
            ]
        )
        for repo, name in clause["sources"]:
            matched = next(
                (
                    fix
                    for fix in components.get(repo, {}).get("fixes", [])
                    if fix.get("name") == name
                ),
                {},
            )
            lines.append(
                f"- {name}: source `{matched.get('source_commit', 'unknown')}`; "
                f"installed `{matched.get('installed_head', 'unknown') or 'unknown'}`; "
                f"verdict `{'PASS' if matched.get('present') else 'PENDING'}`."
            )
        lines.extend(["", "Live probes:", ""])
        for key in clause["probes"]:
            probe = probes.get(key, {})
            detail = probe.get("reason")
            if not detail:
                compact = {
                    k: v
                    for k, v in probe.items()
                    if k not in {"name", "status", "started_at", "finished_at", "samples"}
                }
                detail = json.dumps(compact, sort_keys=True, separators=(",", ":"))
            lines.append(
                f"- {probe.get('name', key)}: start `{probe.get('started_at', '')}`; "
                f"finish `{probe.get('finished_at', '')}`; "
                f"verdict `{str(probe.get('status', 'pending')).upper()}`; {detail}"
            )
        lines.append("")
    lines.extend(
        [
            "## Terminal rule",
            "",
            "Only PASS on the first line satisfies the North Star. PENDING and FAIL remain open.",
            "",
        ]
    )
    return "\n".join(lines)


def offline_snapshot(root: Path) -> dict[str, Any]:
    required = [
        root / "bin/last-stack-feature-delivery-effective-flow-proof",
        root / "bin/last-stack-feature-portfolio-admission",
        root / "bin/last-stack-milestone-slice-satisfaction",
        root / "bin/last-stack-card-closeout",
        root / "harness/north-star/feature-delivery-effective-flow/run.sh",
    ]
    missing = [str(path) for path in required if not path.is_file()]
    stamp = now()
    status = "pass" if not missing else "fail"
    reason = "repository structure is complete" if not missing else f"missing paths: {', '.join(missing)}"
    components = {
        repo: {
            "installed_head": "offline-source-tree",
            "fixes": [
                {**fix, "installed_head": "offline-source-tree", "present": not missing}
                for fix in fixes
            ],
        }
        for repo, fixes in FIXES.items()
    }
    probes = {
        key: {
            "name": f"offline structure: {key}",
            "status": status,
            "started_at": stamp,
            "finished_at": stamp,
            "reason": reason,
        }
        for key in (
            "card_truth",
            "board_write",
            "flow_ledger",
            "admission",
            "satisfaction",
            "closeout",
            "provider_fallback",
        )
    }
    return {
        "captured_at": stamp,
        "components": components,
        "probes": probes,
        "lastdb": {
            "build": "offline",
            "fixed_build": False,
            "reason": "offline mode cannot prove the 24-hour live process",
            "samples": [],
        },
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--live", action="store_true")
    mode.add_argument("--offline", action="store_true")
    parser.add_argument("--evidence", type=Path, help="evaluate a captured operational snapshot")
    parser.add_argument("--report", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    self_path = Path(__file__).resolve()
    root = self_path.parent.parent
    default_mode = os.environ.get("NORTH_STAR_PROOF_MODE", "live")
    offline = args.offline or (not args.live and default_mode == "offline")
    report_path = args.report or Path(
        os.environ.get(
            "NORTH_STAR_PROOF_DIR",
            str(Path.home() / ".last-stack/north-star-proofs"),
        )
    ) / f"{SLUG}.md"

    try:
        if args.evidence:
            snapshot = parse_json(args.evidence.read_text(), str(args.evidence))
        elif offline:
            snapshot = offline_snapshot(root)
        else:
            snapshot = collect_live()
        report = evaluate(snapshot)
    except (OSError, ProofError, subprocess.SubprocessError) as exc:
        stamp = now()
        report = {
            "verdict": "FAIL",
            "captured_at": stamp,
            "finished_at": now(),
            "components": {},
            "probes": {},
            "clauses": [],
            "reason": str(exc),
        }

    text = render(report, offline=offline)
    if report.get("reason"):
        text += f"\n## Fatal error\n\n{report['reason']}\n"
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(text)
    if args.json:
        print(json.dumps({**report, "report": str(report_path)}, indent=2, sort_keys=True))
    else:
        print(f"PROOF_REPORT={report_path}")
        print(f"PROOF_VERDICT={'PENDING-OFFLINE' if offline else report['verdict']}")
    if offline:
        return 0 if report["verdict"] != "FAIL" else 1
    return 0 if report["verdict"] == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
