#!/usr/bin/env bash
# last-stack-fold-ci-health — zero-LLM Forge CI capacity check (Class C).
#
# The name is historical. Fold and every other repo moved to GitHub, `lastgit`
# last (2026-10-08). The local Forgejo merge-gate runner is checked only while
# the lane policy still needs it: config/forge-runner-lanes.json
# merge_gate.retired=true means no repo is gated on Forgejo, so there is no runner
# to check and the answer is `ok` (detail=forge-retired). Before that flag the
# check reported level=down and hinted "reload the launchd agent" as soon as the
# runner was stopped. The repo-scoped host runners (fold, exemem-infra) and the
# gaming PC runner are retired and not checked.
#
# Usage:
#   last-stack-fold-ci-health [--json] [--page]
#
# Exit: 0 ok, 1 degraded/down, 2 usage
set -euo pipefail

JSON=0
PAGE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --page) PAGE=1; shift ;;
    -h|--help) echo "last-stack-fold-ci-health [--json] [--page]"; exit 0 ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
  esac
done

# Resolve the symlink chain first: a PATH link points into the install tree.
_self_src="$0"
while [ -L "$_self_src" ]; do
  _self_link="$(readlink "$_self_src")"
  case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
done
ROOT="$(CDPATH='' cd -- "$(dirname -- "$_self_src")/.." && pwd -P)"
lanes_cfg="${LAST_STACK_FORGE_LANES_CONFIG:-$ROOT/config/forge-runner-lanes.json}"

forge_gate_retired() {
  command -v jq >/dev/null 2>&1 && [ -f "$lanes_cfg" ] \
    && jq -e '.merge_gate.retired == true' "$lanes_cfg" >/dev/null 2>&1
}

uid="$(id -u)"
agents=(
  com.edgevector.forgejo-runner
)
# No Forgejo repo, no runner to watch.
if forge_gate_retired; then
  agents=()
fi

ok=0
bad=0
rows=()

for agent in ${agents[@]+"${agents[@]}"}; do
  if launchctl print "gui/$uid/$agent" >/dev/null 2>&1; then
    state="$(launchctl print "gui/$uid/$agent" 2>/dev/null | sed -n 's/^[[:space:]]*state = //p' | head -1)"
    state="${state:-unknown}"
    if [ "$state" = "running" ]; then
      ok=$((ok + 1))
      rows+=("$agent=running")
    else
      bad=$((bad + 1))
      rows+=("$agent=$state")
    fi
  else
    bad=$((bad + 1))
    rows+=("$agent=missing")
  fi
done

# the merge-gate runner is the only lane checked
level="ok"
merge_state="missing"
for r in ${rows[@]+"${rows[@]}"}; do
  case "$r" in
    com.edgevector.forgejo-runner=running) merge_state="running" ;;
    com.edgevector.forgejo-runner=*) merge_state="${r#com.edgevector.forgejo-runner=}" ;;
  esac
done
if forge_gate_retired; then
  :  # the lane policy retired the merge gate: nothing to be down
elif [ "$merge_state" != "running" ]; then
  level="down"
elif [ "$bad" -gt 0 ]; then
  level="degraded"
fi

if forge_gate_retired; then
  detail="forge-retired"
else
  detail="$(IFS=,; echo "${rows[*]}")"
fi

if [ "$JSON" -eq 1 ]; then
  printf '{"level":"%s","ok":%s,"bad":%s,"detail":"%s"}\n' "$level" "$ok" "$bad" "$detail"
else
  printf 'FOLD_CI_HEALTH level=%s ok=%s bad=%s detail=%s\n' "$level" "$ok" "$bad" "$detail"
  if [ "$level" != "ok" ]; then
    printf 'hint: docs/forge-runner-lanes.md — reload the com.edgevector.forgejo-runner launchd agent\n'
  fi
fi

if [ "$PAGE" -eq 1 ] && [ "$level" != "ok" ] && command -v ra >/dev/null 2>&1; then
  ra notify "Fold CI health $level: $detail" --priority high >/dev/null 2>&1 || true
fi

# Heartbeat
if [ -x "$(dirname "$0")/last-stack-brain-append-heartbeat" ]; then
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "$(dirname "$0")/last-stack-brain-append-heartbeat" --line \
    "fold-ci-health $ts $level $detail" 2>/dev/null || true
fi

[ "$level" = "ok" ] && exit 0
exit 1
