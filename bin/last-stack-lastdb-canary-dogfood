#!/usr/bin/env python3
"""Resolve a LastDB canary and dogfood it on the primary (probe and/or live cutover).

Canonical candidate source (Tom 2026-08-05, local-canonical + forge SoT):

  1. Explicit --candidate / --version (operator override)
  2. **Forge fold `main` tip** — local binary built from that OID
  3. Optional GitHub prerelease ONLY when LAST_STACK_CANARY_ALLOW_GITHUB=1
     AND the release manifest's source_git_oid matches fold main tip

GitHub is never the default dogfood path. The 2026-08-05 Aug-1 rollback happened
because dogfood took the newest GH prerelease by name (semver 0.23.3-canary >
0.23.2 describe) without checking git ancestry against main.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.request
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()

def _resolve_ledger() -> Path:
    env = os.environ.get("LAST_STACK_CANARY_PIPELINE")
    if env:
        return Path(env)
    for c in (
        Path(__file__).resolve().parent / "last-stack-canary-pipeline",
        HOME / ".local/bin/last-stack-canary-pipeline",
        HOME / ".last-stack/bin/last-stack-canary-pipeline",
        ROOT / "bin" / "last-stack-canary-pipeline",
    ):
        if c.is_file() and os.access(c, os.X_OK):
            return c
    return ROOT / "bin" / "last-stack-canary-pipeline"

def _resolve_safe_upgrade() -> Path:
    env = os.environ.get("LAST_STACK_CANARY_SAFE_UPGRADE")
    if env:
        return Path(env)
    for c in (
        HOME / ".claude/skills/lastdb-safe-upgrade/scripts/safe-upgrade-lastdb.sh",
        HOME / ".last-stack/skills/lastdb-safe-upgrade/scripts/safe-upgrade-lastdb.sh",
        ROOT / "skills" / "lastdb-safe-upgrade" / "scripts" / "safe-upgrade-lastdb.sh",
    ):
        if c.is_file():
            return c
    return ROOT / "skills" / "lastdb-safe-upgrade" / "scripts" / "safe-upgrade-lastdb.sh"

LEDGER = _resolve_ledger()
SAFE_UPGRADE = _resolve_safe_upgrade()

ALLOWED = {
    "candidate_found": {"dogfood_started"},
    "dogfood_started": {"dogfood_green", "dogfood_red"},
    "dogfood_green": {"soak_started"},
    "dogfood_red": set(),
    "soak_started": {"soak_green", "soak_red"},
    "soak_green": {"promote_prepare", "promoted"},
    "soak_red": set(),
    "promote_prepare": {"promoted"},
    "promoted": set(),
}

# git-describe shortsha is typically 7–12 hex digits after -g
_DESCRIBE_GSHA = re.compile(r"-g([0-9a-f]{7,40})\b", re.I)


@dataclass(frozen=True)
class Candidate:
    candidate: str
    version: str
    source: str
    note: str
    safe_upgrade_args: tuple[str, ...]
    source_git_oid: str = ""


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="last-stack-lastdb-canary-dogfood",
        description=(
            "Resolve a LastDB canary from local Forge fold main (default) and dogfood it "
            "(dry-run / probe-only / live cutover). GitHub prereleases are opt-in only."
        ),
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="ledger only; do not run safe-upgrade")
    mode.add_argument(
        "--live",
        action="store_true",
        help="run safe-upgrade --probe-only only (no primary cutover)",
    )
    mode.add_argument(
        "--cutover",
        action="store_true",
        help="probe-only then live safe-upgrade --yes on GREEN (mutates primary sidebin)",
    )
    parser.add_argument("--candidate", help="explicit lastdbd candidate binary")
    parser.add_argument("--version", help="explicit LastDB release version/tag (escape hatch)")
    parser.add_argument("--state-dir", type=Path, default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--skip-situation-preflight",
        action="store_true",
        help="skip situations preflight (tests only)",
    )
    return parser.parse_args(argv)


def sanitize(value: str) -> str:
    value = value.strip().lstrip("v") or "unknown"
    value = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("-._")
    return value or "unknown"


def run(cmd: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)


def binary_version(path: str) -> str:
    try:
        out = run([path, "--version"], check=False).stdout.strip()
    except OSError:
        return "unknown"
    return out.split()[-1] if out else "unknown"


def live_version() -> str:
    cmd = os.environ.get("LAST_STACK_CANARY_LIVE_VERSION_CMD", "lastdbd --version")
    if cmd in ("", "pass", "skip"):
        return ""
    proc = run(["bash", "-lc", cmd], check=False)
    line = (proc.stdout or "").strip().splitlines()
    if not line:
        return ""
    return line[-1].split()[-1]


def situations_clear() -> bool:
    cmd = os.environ.get(
        "LAST_STACK_CANARY_SITUATION_CHECK_CMD",
        'situations list --json | jq -e "length == 0"',
    )
    if cmd in ("", "pass", "true", "ok"):
        return True
    if cmd in ("fail", "false", "red"):
        return False
    return run(["bash", "-lc", cmd], check=False).returncode == 0


def github_prerelease_allowed() -> bool:
    """GitHub prereleases are opt-in. RELEASES_JSON in tests implies allow."""
    if os.environ.get("LAST_STACK_CANARY_RELEASES_JSON"):
        return True
    return os.environ.get("LAST_STACK_CANARY_ALLOW_GITHUB", "0") == "1"


def fold_mirror() -> Path | None:
    override = os.environ.get("LAST_STACK_CANARY_FOLD_MIRROR")
    candidates = [Path(override)] if override else []
    candidates.append(HOME / ".cache/edgevector-git/fold.git")
    for candidate in candidates:
        if candidate is not None and candidate.is_dir():
            return candidate
    return None


def maybe_fetch_fold_main(mirror: Path) -> None:
    """Best-effort refresh of fold main from local Forgejo (origin). Never fatal."""
    if os.environ.get("LAST_STACK_CANARY_FETCH_MAIN", "1") != "1":
        return
    forge_git = os.environ.get("LAST_STACK_FORGE_GIT", "last-stack-forge-git")
    # Prefer forge-git so localhost:3300 auth works unattended.
    cmd = [forge_git, "-C", str(mirror), "fetch", "origin", "refs/heads/main:refs/heads/main"]
    proc = run(cmd, check=False)
    if proc.returncode == 0:
        return
    # Plain git fallback (mirror may already be up to date / have creds).
    run(["git", "-C", str(mirror), "fetch", "origin", "refs/heads/main:refs/heads/main"], check=False)


def fold_main_oid() -> str:
    """Full OID of fold main tip from the local Forge mirror (or override)."""
    override = os.environ.get("LAST_STACK_CANARY_MAIN_OID", "").strip()
    if override:
        return override
    mirror = fold_mirror()
    if mirror is None:
        return ""
    maybe_fetch_fold_main(mirror)
    for ref in ("refs/heads/main", "refs/remotes/origin/main"):
        proc = run(["git", "-C", str(mirror), "rev-parse", ref], check=False)
        if proc.returncode == 0:
            oid = (proc.stdout or "").strip()
            if re.fullmatch(r"[0-9a-f]{40}", oid):
                return oid
    return ""


def oid_matches_version(main_oid: str, version: str) -> bool:
    """True when a git-describe version embeds a shortsha of main_oid."""
    if not main_oid or not version:
        return False
    m = _DESCRIBE_GSHA.search(version)
    if not m:
        return False
    gsha = m.group(1).lower()
    main = main_oid.lower()
    return main.startswith(gsha) or gsha.startswith(main[: len(gsha)])


def read_manifest_oid(path: Path) -> str:
    if not path.is_file():
        return ""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return ""
    return str(data.get("source_git_oid") or data.get("git_oid") or "").strip()


def candidate_from_local_bin(
    path: str,
    *,
    main_oid: str,
    trusted: bool,
    source: str = "forge-main",
) -> Candidate | None:
    if not path or not os.access(path, os.X_OK):
        return None
    version = sanitize(binary_version(path))
    manifest_oid = ""
    # Sibling or parent-dir manifests from package-lastdb-bundle.sh
    for rel in (
        Path(path).parent / "lastdb-aarch64-apple-darwin.manifest.json",
        Path(path).parent / "manifest.json",
        Path(path).parent.parent / "lastdb-aarch64-apple-darwin.manifest.json",
    ):
        manifest_oid = read_manifest_oid(rel)
        if manifest_oid:
            break

    if trusted:
        oid = manifest_oid or main_oid
        note = f"path={path} trusted=1 main={main_oid[:12] if main_oid else 'unknown'}"
    else:
        if main_oid and manifest_oid and not (
            main_oid.startswith(manifest_oid) or manifest_oid.startswith(main_oid[:12])
        ):
            return None
        if main_oid and not manifest_oid and not oid_matches_version(main_oid, version):
            return None
        if not main_oid and not manifest_oid and not oid_matches_version("", version):
            # No main tip and no describe sha — refuse auto-discovered binaries.
            return None
        oid = manifest_oid or main_oid
        note = f"path={path} main={main_oid[:12] if main_oid else 'unknown'} oid={oid[:12] if oid else 'unknown'}"

    short = (oid or version)[:12] if oid else version
    return Candidate(
        candidate=f"lastdb-forge-main-{sanitize(short)}",
        version=version,
        source=source,
        note=note,
        safe_upgrade_args=("--candidate", path),
        source_git_oid=oid,
    )


def canary_builds_root() -> Path:
    env = os.environ.get("LAST_STACK_CANARY_BUILDS_DIR")
    if env:
        return Path(env)
    return HOME / ".local" / "state" / "last-stack" / "canary-builds"


def resolve_forge_main_candidate() -> Candidate | None:
    """Local binary built from fold main tip (Forge SoT). Prefer staged canary-builds."""
    main_oid = fold_main_oid()
    trusted_bin = os.environ.get("LAST_STACK_CANARY_LOCAL_FALLBACK_BIN", "").strip()
    if trusted_bin:
        cand = candidate_from_local_bin(trusted_bin, main_oid=main_oid, trusted=True)
        if cand:
            return cand

    paths: list[str] = []
    builds = canary_builds_root()
    if main_oid and builds.is_dir():
        # Prefer exact main tip directory, then any subdir with matching manifest.
        tip_dir = builds / main_oid
        for name in ("lastdbd", "bin/lastdbd"):
            paths.append(str(tip_dir / name))
        for child in sorted(builds.iterdir(), reverse=True):
            if not child.is_dir():
                continue
            man = read_manifest_oid(child / "manifest.json") or read_manifest_oid(
                child / "lastdb-aarch64-apple-darwin.manifest.json"
            )
            if man and main_oid and (main_oid.startswith(man) or man.startswith(main_oid[:12])):
                paths.append(str(child / "lastdbd"))
                paths.append(str(child / "bin" / "lastdbd"))

    # Worktrees / checkouts (never the empty portal). Prefer fkanban worktrees.
    home = HOME
    paths.extend(
        [
            str(home / "code/edgevector/fold/target/release/lastdbd"),
            str(home / "code/edgevector/fold/lastdb_node/target/release/lastdbd"),
            str(home / "code/edgevector/fold/fold_db/target/release/lastdbd"),
        ]
    )
    wt_root = home / ".fkanban" / "worktrees"
    if wt_root.is_dir():
        for p in sorted(wt_root.glob("fold-*/target/release/lastdbd"), reverse=True)[:20]:
            paths.append(str(p))

    seen: set[str] = set()
    for path in paths:
        if path in seen:
            continue
        seen.add(path)
        cand = candidate_from_local_bin(path, main_oid=main_oid, trusted=False)
        if cand:
            return cand
    return None


def load_releases() -> list[dict]:
    raw = os.environ.get("LAST_STACK_CANARY_RELEASES_JSON")
    if raw:
        data = json.loads(raw)
    else:
        url = os.environ.get(
            "LAST_STACK_CANARY_RELEASES_URL",
            "https://api.github.com/repos/EdgeVector/homebrew-lastdb/releases?per_page=20",
        )
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except Exception:
            data = []
    if isinstance(data, dict):
        data = data.get("releases") or data.get("items") or [data]
    return [item for item in data if isinstance(item, dict)]


def release_source_oid(release: dict) -> str:
    """source_git_oid from a release dict (tests may inject it) or remote manifest."""
    direct = str(release.get("source_git_oid") or "").strip()
    if direct:
        return direct
    for asset in release.get("assets") or []:
        if not isinstance(asset, dict):
            continue
        name = str(asset.get("name") or "")
        if not name.endswith("manifest.json"):
            continue
        # Inline body for hermetic tests
        if asset.get("manifest"):
            try:
                body = asset["manifest"]
                if isinstance(body, str):
                    body = json.loads(body)
                return str(body.get("source_git_oid") or "").strip()
            except Exception:
                return ""
        url = str(asset.get("browser_download_url") or "")
        if not url:
            continue
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/octet-stream"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                manifest = json.loads(resp.read().decode("utf-8"))
            return str(manifest.get("source_git_oid") or "").strip()
        except Exception:
            continue
    return ""


def candidate_from_release(release: dict, *, main_oid: str) -> Candidate | None:
    tag = str(release.get("tag_name") or release.get("name") or "").strip()
    version = sanitize(tag)
    source_oid = release_source_oid(release)
    # Require main-tip match when we know main. Refuse unknown-oid GH canaries.
    if main_oid:
        if not source_oid:
            return None
        if not (main_oid.startswith(source_oid) or source_oid.startswith(main_oid[:12])):
            return None
    elif not source_oid:
        # No main tip and no oid — refuse (this is how Aug-1 snuck in).
        return None

    asset_names = []
    for asset in release.get("assets") or []:
        if isinstance(asset, dict):
            asset_names.append(str(asset.get("name") or asset.get("browser_download_url") or ""))
    note = "tag={tag} assets={assets} source_git_oid={oid} main={main}".format(
        tag=tag or "unknown",
        assets=",".join(asset_names) or "none",
        oid=source_oid[:12] if source_oid else "unknown",
        main=main_oid[:12] if main_oid else "unknown",
    )
    return Candidate(
        candidate=f"lastdb-{version}",
        version=version,
        source="github-prerelease-canary",
        note=note,
        safe_upgrade_args=("--version", version),
        source_git_oid=source_oid,
    )


def resolve_github_canary_for_main() -> Candidate | None:
    """Opt-in only. Prefer a prerelease whose source_git_oid is fold main tip."""
    if not github_prerelease_allowed():
        return None
    main_oid = fold_main_oid()
    releases = [r for r in load_releases() if bool(r.get("prerelease")) and not bool(r.get("draft"))]
    if not releases:
        return None
    marked = [
        r
        for r in releases
        if re.search(r"(canary|nightly|pre|rc)", f"{r.get('tag_name','')} {r.get('name','')}", re.I)
    ]
    for release in marked or releases:
        cand = candidate_from_release(release, main_oid=main_oid)
        if cand:
            return cand
    return None


def missing_forge_main_candidate() -> Candidate:
    main_oid = fold_main_oid()
    version = sanitize(os.environ.get("LAST_STACK_CANARY_LOCAL_FALLBACK_VERSION", "forge-main-unbuilt"))
    note = (
        "no local lastdbd built from fold main tip; "
        f"main={main_oid[:12] if main_oid else 'unavailable'}; "
        "build from Forgejo fold main (package-lastdb-bundle / cargo --release) "
        "and set LAST_STACK_CANARY_LOCAL_FALLBACK_BIN or stage under "
        f"{canary_builds_root()}/<oid>/lastdbd. "
        "GitHub prereleases are not used unless LAST_STACK_CANARY_ALLOW_GITHUB=1 "
        "and the release source_git_oid matches main tip."
    )
    return Candidate(
        candidate=f"lastdb-forge-main-{version}",
        version=version,
        source="forge-main-missing",
        note=note,
        safe_upgrade_args=(),
        source_git_oid=main_oid,
    )


def resolve_candidate(args: argparse.Namespace) -> Candidate:
    if args.candidate:
        version = sanitize(binary_version(args.candidate))
        return Candidate(
            candidate=f"lastdb-explicit-{version}",
            version=version,
            source="explicit-candidate",
            note=f"path={args.candidate}",
            safe_upgrade_args=("--candidate", args.candidate),
        )
    if args.version:
        version = sanitize(args.version)
        return Candidate(
            candidate=f"lastdb-{version}",
            version=version,
            source="explicit-version",
            note=f"version={args.version}",
            safe_upgrade_args=("--version", version),
        )

    # 1) Local Forge fold main tip (canonical)
    local = resolve_forge_main_candidate()
    if local:
        return local

    # 2) Optional GH prerelease that is *exactly* main tip (CDN package of same SHA)
    gh = resolve_github_canary_for_main()
    if gh:
        return gh

    # 3) Fail closed — never pick a stale GH canary by name alone
    return missing_forge_main_candidate()



def ledger_base(args: argparse.Namespace) -> list[str]:
    cmd = [str(_resolve_ledger())]
    if args.state_dir is not None:
        cmd.extend(["--state-dir", str(args.state_dir)])
    return cmd


def read_state(args: argparse.Namespace, candidate: str) -> str | None:
    proc = run(ledger_base(args) + ["--json", "read", candidate], check=False)
    if proc.returncode != 0:
        return None
    return str(json.loads(proc.stdout).get("state") or "")


def create_if_missing(args: argparse.Namespace, candidate: Candidate) -> str:
    state = read_state(args, candidate.candidate)
    if state:
        return state
    cmd = ledger_base(args) + [
        "create",
        candidate.candidate,
        "--version",
        candidate.version,
        "--source",
        candidate.source,
        "--note",
        candidate.note,
    ]
    if candidate.source_git_oid:
        cmd.extend(["--source-git-oid", candidate.source_git_oid])
    run(cmd)
    return "candidate_found"


def advance_if_allowed(args: argparse.Namespace, candidate: Candidate, desired: str, note: str) -> str:
    state = read_state(args, candidate.candidate) or create_if_missing(args, candidate)
    if state == desired:
        return state
    if desired not in ALLOWED.get(state, set()):
        return state
    run(ledger_base(args) + ["advance", candidate.candidate, desired, "--note", note])
    return desired


def safe_upgrade_bin() -> str:
    return str(_resolve_safe_upgrade())


def run_safe_upgrade(args_list: list[str]) -> tuple[bool, str, int]:
    cmd = [safe_upgrade_bin(), *args_list]
    proc = run(cmd, check=False)
    combined = (proc.stdout or "") + (proc.stderr or "")
    green = proc.returncode == 0 and (
        "VERDICT: GREEN" in combined
        or "VERDICT: GREEN_PROBE_ONLY" in combined
        or "VERDICT: ALREADY_CURRENT" in combined
    )
    return green, combined, proc.returncode


def mode_name(args: argparse.Namespace) -> str:
    if args.cutover:
        return "cutover"
    if args.live:
        return "live"
    return "dry-run"


def dogfood(args: argparse.Namespace) -> dict:
    candidate = resolve_candidate(args)
    create_if_missing(args, candidate)
    advance_if_allowed(args, candidate, "dogfood_started", f"{mode_name(args)} source={candidate.source}")

    def base_result(**extra) -> dict:
        out = {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "source_git_oid": candidate.source_git_oid or None,
            "note": candidate.note,
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
        }
        out.update(extra)
        return out

    if args.dry_run:
        # Missing candidate is red even in dry-run so scheduled noops are loud.
        if not candidate.safe_upgrade_args:
            final = advance_if_allowed(
                args,
                candidate,
                "dogfood_red",
                f"dry-run: no candidate — {candidate.note}",
            )
            return base_result(
                mode="dry-run",
                state=final,
                safe_upgrade="not-run-no-candidate",
                primary_mutation=False,
            )
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_green",
            "dry-run: would probe then cutover " + " ".join(candidate.safe_upgrade_args or ["?"]),
        )
        return base_result(
            mode="dry-run",
            state=final,
            safe_upgrade="not-run",
            live_version=live_version() or None,
            primary_mutation=False,
        )

    if not candidate.safe_upgrade_args:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_red",
            f"{mode_name(args)}: no candidate args — {candidate.note}",
        )
        return base_result(
            mode=mode_name(args),
            state=final,
            safe_upgrade="not-run-no-candidate",
            primary_mutation=False,
        )

    if not args.skip_situation_preflight and not situations_clear():
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_red",
            f"{mode_name(args)}: situation fence blocked",
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": mode_name(args),
            "state": final,
            "safe_upgrade": "blocked-situation",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "primary_mutation": False,
        }

    # Always probe first for live and cutover.
    probe_args = ["--probe-only", *candidate.safe_upgrade_args]
    probe_green, _probe_out, probe_rc = run_safe_upgrade(probe_args)
    if not probe_green:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_red",
            f"{mode_name(args)}: probe-only red rc={probe_rc}",
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": mode_name(args),
            "state": final,
            "safe_upgrade": "probe-red",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "safe_upgrade_rc": probe_rc,
            "primary_mutation": False,
        }

    if args.live and not args.cutover:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_green",
            f"live: probe-only green rc={probe_rc}",
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "live",
            "state": final,
            "safe_upgrade": "green",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "safe_upgrade_rc": probe_rc,
            "primary_mutation": False,
            "live_version": live_version() or None,
        }

    # cutover: probe green → live --yes
    cut_args = ["--yes", *candidate.safe_upgrade_args]
    cut_green, _cut_out, cut_rc = run_safe_upgrade(cut_args)
    observed = live_version()
    if cut_green:
        note = f"cutover: live safe-upgrade green rc={cut_rc} live={observed or 'unknown'}"
        final = advance_if_allowed(args, candidate, "dogfood_green", note)
        # Stamp observed version for soak matching via advance note + dogfood command on pipeline
        if observed:
            dog_cmd = ledger_base(args) + [
                "dogfood",
                "--sha",
                candidate.candidate,
                "--observed-sha",
                observed,
                "--version",
                candidate.version,
                "--source",
                candidate.source,
            ]
            if candidate.source_git_oid:
                dog_cmd.extend(["--source-git-oid", candidate.source_git_oid])
            run(dog_cmd, check=False)
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "cutover",
            "state": final,
            "safe_upgrade": "cutover-green",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "safe_upgrade_rc": cut_rc,
            "primary_mutation": True,
            "live_version": observed or None,
        }

    final = advance_if_allowed(
        args,
        candidate,
        "dogfood_red",
        f"cutover: live safe-upgrade red rc={cut_rc} (probe was green)",
    )
    return {
        "candidate": candidate.candidate,
        "version": candidate.version,
        "source": candidate.source,
        "mode": "cutover",
        "state": final,
        "safe_upgrade": "cutover-red",
        "safe_upgrade_args": list(candidate.safe_upgrade_args),
        "safe_upgrade_rc": cut_rc,
        "primary_mutation": True,
        "live_version": observed or None,
    }


def emit(result: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
        return
    print(
        "lastdb-canary-dogfood candidate={candidate} state={state} mode={mode} "
        "source={source} safe_upgrade={safe_upgrade} primary_mutation={pm}".format(
            candidate=result.get("candidate"),
            state=result.get("state"),
            mode=result.get("mode"),
            source=result.get("source"),
            safe_upgrade=result.get("safe_upgrade"),
            pm=result.get("primary_mutation"),
        )
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if not args.dry_run and not args.live and not args.cutover:
        # Scheduled auto path defaults to cutover when CANARY_AUTO_CUTOVER=1
        if os.environ.get("LAST_STACK_CANARY_AUTO_CUTOVER", "1") == "1":
            args.cutover = True
        else:
            args.dry_run = True
    result = dogfood(args)
    emit(result, args.json)
    return 0 if result.get("state") == "dogfood_green" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
