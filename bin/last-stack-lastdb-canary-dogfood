#!/usr/bin/env python3
"""Resolve a LastDB canary and dogfood it on the primary (probe and/or live cutover)."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.request
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()

def _resolve_ledger() -> Path:
    env = os.environ.get("LAST_STACK_CANARY_PIPELINE")
    if env:
        return Path(env)
    for c in (
        Path(__file__).resolve().parent / "last-stack-canary-pipeline",
        HOME / ".local/bin/last-stack-canary-pipeline",
        HOME / ".last-stack/bin/last-stack-canary-pipeline",
        ROOT / "bin" / "last-stack-canary-pipeline",
    ):
        if c.is_file() and os.access(c, os.X_OK):
            return c
    return ROOT / "bin" / "last-stack-canary-pipeline"

def _resolve_safe_upgrade() -> Path:
    env = os.environ.get("LAST_STACK_CANARY_SAFE_UPGRADE")
    if env:
        return Path(env)
    for c in (
        HOME / ".claude/skills/lastdb-safe-upgrade/scripts/safe-upgrade-lastdb.sh",
        HOME / ".last-stack/skills/lastdb-safe-upgrade/scripts/safe-upgrade-lastdb.sh",
        ROOT / "skills" / "lastdb-safe-upgrade" / "scripts" / "safe-upgrade-lastdb.sh",
    ):
        if c.is_file():
            return c
    return ROOT / "skills" / "lastdb-safe-upgrade" / "scripts" / "safe-upgrade-lastdb.sh"

LEDGER = _resolve_ledger()
SAFE_UPGRADE = _resolve_safe_upgrade()

ALLOWED = {
    "candidate_found": {"dogfood_started"},
    "dogfood_started": {"dogfood_green", "dogfood_red"},
    "dogfood_green": {"soak_started"},
    "dogfood_red": set(),
    "soak_started": {"soak_green", "soak_red"},
    "soak_green": {"promote_prepare", "promoted"},
    "soak_red": set(),
    "promote_prepare": {"promoted"},
    "promoted": set(),
}


@dataclass(frozen=True)
class Candidate:
    candidate: str
    version: str
    source: str
    note: str
    safe_upgrade_args: tuple[str, ...]


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="last-stack-lastdb-canary-dogfood",
        description="Resolve a LastDB canary and dogfood it (dry-run / probe-only / live cutover).",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="ledger only; do not run safe-upgrade")
    mode.add_argument(
        "--live",
        action="store_true",
        help="run safe-upgrade --probe-only only (no primary cutover)",
    )
    mode.add_argument(
        "--cutover",
        action="store_true",
        help="probe-only then live safe-upgrade --yes on GREEN (mutates primary sidebin)",
    )
    parser.add_argument("--candidate", help="explicit lastdbd candidate binary")
    parser.add_argument("--version", help="explicit LastDB release version/tag")
    parser.add_argument("--state-dir", type=Path, default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--skip-situation-preflight",
        action="store_true",
        help="skip situations preflight (tests only)",
    )
    return parser.parse_args(argv)


def sanitize(value: str) -> str:
    value = value.strip().lstrip("v") or "unknown"
    value = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("-._")
    return value or "unknown"


def run(cmd: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)


def binary_version(path: str) -> str:
    try:
        out = run([path, "--version"], check=False).stdout.strip()
    except OSError:
        return "unknown"
    return out.split()[-1] if out else "unknown"


def live_version() -> str:
    cmd = os.environ.get("LAST_STACK_CANARY_LIVE_VERSION_CMD", "lastdbd --version")
    if cmd in ("", "pass", "skip"):
        return ""
    proc = run(["bash", "-lc", cmd], check=False)
    line = (proc.stdout or "").strip().splitlines()
    if not line:
        return ""
    return line[-1].split()[-1]


def situations_clear() -> bool:
    cmd = os.environ.get(
        "LAST_STACK_CANARY_SITUATION_CHECK_CMD",
        'situations list --json | jq -e "length == 0"',
    )
    if cmd in ("", "pass", "true", "ok"):
        return True
    if cmd in ("fail", "false", "red"):
        return False
    return run(["bash", "-lc", cmd], check=False).returncode == 0


def load_releases() -> list[dict]:
    raw = os.environ.get("LAST_STACK_CANARY_RELEASES_JSON")
    if raw:
        data = json.loads(raw)
    else:
        url = os.environ.get(
            "LAST_STACK_CANARY_RELEASES_URL",
            "https://api.github.com/repos/EdgeVector/homebrew-lastdb/releases?per_page=20",
        )
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except Exception:
            data = []
    if isinstance(data, dict):
        data = data.get("releases") or data.get("items") or [data]
    return [item for item in data if isinstance(item, dict)]


def candidate_from_release(release: dict) -> Candidate:
    tag = str(release.get("tag_name") or release.get("name") or "").strip()
    version = sanitize(tag)
    asset_names = []
    for asset in release.get("assets") or []:
        if isinstance(asset, dict):
            asset_names.append(str(asset.get("name") or asset.get("browser_download_url") or ""))
    note = "tag={tag} assets={assets}".format(tag=tag or "unknown", assets=",".join(asset_names) or "none")
    return Candidate(
        candidate=f"lastdb-{version}",
        version=version,
        source="github-prerelease-canary",
        note=note,
        safe_upgrade_args=("--version", version),
    )


def resolve_release_candidate() -> Candidate | None:
    releases = [r for r in load_releases() if bool(r.get("prerelease")) and not bool(r.get("draft"))]
    if not releases:
        return None
    marked = [
        r
        for r in releases
        if re.search(r"(canary|nightly|pre|rc)", f"{r.get('tag_name','')} {r.get('name','')}", re.I)
    ]
    return candidate_from_release((marked or releases)[0])


def resolve_local_candidate() -> Candidate:
    explicit = os.environ.get("LAST_STACK_CANARY_LOCAL_FALLBACK_BIN", "")
    paths = [explicit] if explicit else []
    home = Path.home()
    paths.extend(
        [
            str(home / "code/edgevector/fold/target/release/lastdbd"),
            str(home / "code/edgevector/fold/lastdb_node/target/release/lastdbd"),
            str(home / "code/edgevector/fold/fold_db/target/release/lastdbd"),
        ]
    )
    for path in paths:
        if path and os.access(path, os.X_OK):
            version = sanitize(binary_version(path))
            return Candidate(
                candidate=f"lastdb-local-main-{version}",
                version=version,
                source="local-main",
                note=f"path={path}",
                safe_upgrade_args=("--candidate", path),
            )
    version = sanitize(os.environ.get("LAST_STACK_CANARY_LOCAL_FALLBACK_VERSION", "local-main-unbuilt"))
    return Candidate(
        candidate=f"lastdb-local-main-{version}",
        version=version,
        source="local-main",
        note="no executable local release candidate found",
        safe_upgrade_args=(),
    )


def resolve_candidate(args: argparse.Namespace) -> Candidate:
    if args.candidate:
        version = sanitize(binary_version(args.candidate))
        return Candidate(
            candidate=f"lastdb-explicit-{version}",
            version=version,
            source="explicit-candidate",
            note=f"path={args.candidate}",
            safe_upgrade_args=("--candidate", args.candidate),
        )
    if args.version:
        version = sanitize(args.version)
        return Candidate(
            candidate=f"lastdb-{version}",
            version=version,
            source="explicit-version",
            note=f"version={args.version}",
            safe_upgrade_args=("--version", version),
        )
    return resolve_release_candidate() or resolve_local_candidate()


def ledger_base(args: argparse.Namespace) -> list[str]:
    cmd = [str(_resolve_ledger())]
    if args.state_dir is not None:
        cmd.extend(["--state-dir", str(args.state_dir)])
    return cmd


def read_state(args: argparse.Namespace, candidate: str) -> str | None:
    proc = run(ledger_base(args) + ["--json", "read", candidate], check=False)
    if proc.returncode != 0:
        return None
    return str(json.loads(proc.stdout).get("state") or "")


def create_if_missing(args: argparse.Namespace, candidate: Candidate) -> str:
    state = read_state(args, candidate.candidate)
    if state:
        return state
    run(
        ledger_base(args)
        + [
            "create",
            candidate.candidate,
            "--version",
            candidate.version,
            "--source",
            candidate.source,
            "--note",
            candidate.note,
        ]
    )
    return "candidate_found"


def advance_if_allowed(args: argparse.Namespace, candidate: Candidate, desired: str, note: str) -> str:
    state = read_state(args, candidate.candidate) or create_if_missing(args, candidate)
    if state == desired:
        return state
    if desired not in ALLOWED.get(state, set()):
        return state
    run(ledger_base(args) + ["advance", candidate.candidate, desired, "--note", note])
    return desired


def safe_upgrade_bin() -> str:
    return str(_resolve_safe_upgrade())


def run_safe_upgrade(args_list: list[str]) -> tuple[bool, str, int]:
    cmd = [safe_upgrade_bin(), *args_list]
    proc = run(cmd, check=False)
    combined = (proc.stdout or "") + (proc.stderr or "")
    green = proc.returncode == 0 and (
        "VERDICT: GREEN" in combined
        or "VERDICT: GREEN_PROBE_ONLY" in combined
        or "VERDICT: ALREADY_CURRENT" in combined
    )
    return green, combined, proc.returncode


def mode_name(args: argparse.Namespace) -> str:
    if args.cutover:
        return "cutover"
    if args.live:
        return "live"
    return "dry-run"


def dogfood(args: argparse.Namespace) -> dict:
    candidate = resolve_candidate(args)
    create_if_missing(args, candidate)
    advance_if_allowed(args, candidate, "dogfood_started", f"{mode_name(args)} source={candidate.source}")

    if args.dry_run:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_green",
            "dry-run: would probe then cutover " + " ".join(candidate.safe_upgrade_args or ["?"]),
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "dry-run",
            "state": final,
            "safe_upgrade": "not-run",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "live_version": live_version() or None,
            "primary_mutation": False,
        }

    if not candidate.safe_upgrade_args:
        final = advance_if_allowed(args, candidate, "dogfood_red", f"{mode_name(args)}: no candidate args")
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": mode_name(args),
            "state": final,
            "safe_upgrade": "not-run-no-candidate",
            "safe_upgrade_args": [],
            "primary_mutation": False,
        }

    if not args.skip_situation_preflight and not situations_clear():
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_red",
            f"{mode_name(args)}: situation fence blocked",
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": mode_name(args),
            "state": final,
            "safe_upgrade": "blocked-situation",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "primary_mutation": False,
        }

    # Always probe first for live and cutover.
    probe_args = ["--probe-only", *candidate.safe_upgrade_args]
    probe_green, _probe_out, probe_rc = run_safe_upgrade(probe_args)
    if not probe_green:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_red",
            f"{mode_name(args)}: probe-only red rc={probe_rc}",
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": mode_name(args),
            "state": final,
            "safe_upgrade": "probe-red",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "safe_upgrade_rc": probe_rc,
            "primary_mutation": False,
        }

    if args.live and not args.cutover:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_green",
            f"live: probe-only green rc={probe_rc}",
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "live",
            "state": final,
            "safe_upgrade": "green",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "safe_upgrade_rc": probe_rc,
            "primary_mutation": False,
            "live_version": live_version() or None,
        }

    # cutover: probe green → live --yes
    cut_args = ["--yes", *candidate.safe_upgrade_args]
    cut_green, _cut_out, cut_rc = run_safe_upgrade(cut_args)
    observed = live_version()
    if cut_green:
        note = f"cutover: live safe-upgrade green rc={cut_rc} live={observed or 'unknown'}"
        final = advance_if_allowed(args, candidate, "dogfood_green", note)
        # Stamp observed version for soak matching via advance note + dogfood command on pipeline
        if observed:
            run(
                ledger_base(args)
                + [
                    "dogfood",
                    "--sha",
                    candidate.candidate,
                    "--observed-sha",
                    observed,
                    "--version",
                    candidate.version,
                    "--source",
                    candidate.source,
                ],
                check=False,
            )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "cutover",
            "state": final,
            "safe_upgrade": "cutover-green",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
            "safe_upgrade_rc": cut_rc,
            "primary_mutation": True,
            "live_version": observed or None,
        }

    final = advance_if_allowed(
        args,
        candidate,
        "dogfood_red",
        f"cutover: live safe-upgrade red rc={cut_rc} (probe was green)",
    )
    return {
        "candidate": candidate.candidate,
        "version": candidate.version,
        "source": candidate.source,
        "mode": "cutover",
        "state": final,
        "safe_upgrade": "cutover-red",
        "safe_upgrade_args": list(candidate.safe_upgrade_args),
        "safe_upgrade_rc": cut_rc,
        "primary_mutation": True,
        "live_version": observed or None,
    }


def emit(result: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
        return
    print(
        "lastdb-canary-dogfood candidate={candidate} state={state} mode={mode} "
        "source={source} safe_upgrade={safe_upgrade} primary_mutation={pm}".format(
            candidate=result.get("candidate"),
            state=result.get("state"),
            mode=result.get("mode"),
            source=result.get("source"),
            safe_upgrade=result.get("safe_upgrade"),
            pm=result.get("primary_mutation"),
        )
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if not args.dry_run and not args.live and not args.cutover:
        # Scheduled auto path defaults to cutover when CANARY_AUTO_CUTOVER=1
        if os.environ.get("LAST_STACK_CANARY_AUTO_CUTOVER", "1") == "1":
            args.cutover = True
        else:
            args.dry_run = True
    result = dogfood(args)
    emit(result, args.json)
    return 0 if result.get("state") == "dogfood_green" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
