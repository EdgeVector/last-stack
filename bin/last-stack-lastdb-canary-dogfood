#!/usr/bin/env python3
"""Resolve and dogfood a LastDB canary candidate without mutating the primary."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.request
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
LEDGER = ROOT / "bin" / "last-stack-canary-pipeline"
SAFE_UPGRADE = ROOT / "skills" / "lastdb-safe-upgrade" / "scripts" / "safe-upgrade-lastdb.sh"

ALLOWED = {
    "candidate_found": {"dogfood_started"},
    "dogfood_started": {"dogfood_green", "dogfood_red"},
    "dogfood_green": {"soak_started"},
    "dogfood_red": set(),
    "soak_started": {"soak_green", "soak_red"},
    "soak_green": {"promote_prepare"},
    "soak_red": set(),
    "promote_prepare": set(),
}


@dataclass(frozen=True)
class Candidate:
    candidate: str
    version: str
    source: str
    note: str
    safe_upgrade_args: tuple[str, ...]


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="last-stack-lastdb-canary-dogfood",
        description="Resolve a LastDB canary candidate and record dogfood preflight state.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="record intended probe-only dogfood; do not run safe-upgrade")
    mode.add_argument("--live", action="store_true", help="run safe-upgrade --probe-only, never live cutover")
    parser.add_argument("--candidate", help="explicit lastdbd candidate binary")
    parser.add_argument("--version", help="explicit LastDB release version/tag")
    parser.add_argument("--state-dir", type=Path, default=None)
    parser.add_argument("--json", action="store_true")
    return parser.parse_args(argv)


def sanitize(value: str) -> str:
    value = value.strip().lstrip("v") or "unknown"
    value = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("-._")
    return value or "unknown"


def run(cmd: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)


def binary_version(path: str) -> str:
    try:
        out = run([path, "--version"], check=False).stdout.strip()
    except OSError:
        return "unknown"
    return out.split()[-1] if out else "unknown"


def load_releases() -> list[dict]:
    raw = os.environ.get("LAST_STACK_CANARY_RELEASES_JSON")
    if raw:
        data = json.loads(raw)
    else:
        url = os.environ.get(
            "LAST_STACK_CANARY_RELEASES_URL",
            "https://api.github.com/repos/EdgeVector/homebrew-lastdb/releases?per_page=20",
        )
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json"})
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except Exception:
            data = []
    if isinstance(data, dict):
        data = data.get("releases") or data.get("items") or [data]
    return [item for item in data if isinstance(item, dict)]


def candidate_from_release(release: dict) -> Candidate:
    tag = str(release.get("tag_name") or release.get("name") or "").strip()
    version = sanitize(tag)
    asset_names = []
    for asset in release.get("assets") or []:
        if isinstance(asset, dict):
            asset_names.append(str(asset.get("name") or asset.get("browser_download_url") or ""))
    note = "tag={tag} assets={assets}".format(tag=tag or "unknown", assets=",".join(asset_names) or "none")
    return Candidate(
        candidate=f"lastdb-{version}",
        version=version,
        source="github-prerelease-canary",
        note=note,
        safe_upgrade_args=("--version", version),
    )


def resolve_release_candidate() -> Candidate | None:
    releases = [
        r
        for r in load_releases()
        if bool(r.get("prerelease")) and not bool(r.get("draft"))
    ]
    if not releases:
        return None
    marked = [
        r
        for r in releases
        if re.search(r"(canary|nightly|pre|rc)", f"{r.get('tag_name','')} {r.get('name','')}", re.I)
    ]
    return candidate_from_release((marked or releases)[0])


def resolve_local_candidate() -> Candidate:
    explicit = os.environ.get("LAST_STACK_CANARY_LOCAL_FALLBACK_BIN", "")
    paths = [explicit] if explicit else []
    home = Path.home()
    paths.extend(
        [
            str(home / "code/edgevector/fold/target/release/lastdbd"),
            str(home / "code/edgevector/fold/lastdb_node/target/release/lastdbd"),
            str(home / "code/edgevector/fold/fold_db/target/release/lastdbd"),
        ]
    )
    for path in paths:
        if path and os.access(path, os.X_OK):
            version = sanitize(binary_version(path))
            return Candidate(
                candidate=f"lastdb-local-main-{version}",
                version=version,
                source="local-main",
                note=f"path={path}",
                safe_upgrade_args=("--candidate", path),
            )
    version = sanitize(os.environ.get("LAST_STACK_CANARY_LOCAL_FALLBACK_VERSION", "local-main-unbuilt"))
    return Candidate(
        candidate=f"lastdb-local-main-{version}",
        version=version,
        source="local-main",
        note="no executable local release candidate found",
        safe_upgrade_args=(),
    )


def resolve_candidate(args: argparse.Namespace) -> Candidate:
    if args.candidate:
        version = sanitize(binary_version(args.candidate))
        return Candidate(
            candidate=f"lastdb-explicit-{version}",
            version=version,
            source="explicit-candidate",
            note=f"path={args.candidate}",
            safe_upgrade_args=("--candidate", args.candidate),
        )
    if args.version:
        version = sanitize(args.version)
        return Candidate(
            candidate=f"lastdb-{version}",
            version=version,
            source="explicit-version",
            note=f"version={args.version}",
            safe_upgrade_args=("--version", version),
        )
    return resolve_release_candidate() or resolve_local_candidate()


def ledger_base(args: argparse.Namespace) -> list[str]:
    cmd = [str(LEDGER)]
    if args.state_dir is not None:
        cmd.extend(["--state-dir", str(args.state_dir)])
    return cmd


def read_state(args: argparse.Namespace, candidate: str) -> str | None:
    proc = run(ledger_base(args) + ["--json", "read", candidate], check=False)
    if proc.returncode != 0:
        return None
    return str(json.loads(proc.stdout).get("state") or "")


def create_if_missing(args: argparse.Namespace, candidate: Candidate) -> str:
    state = read_state(args, candidate.candidate)
    if state:
        return state
    run(
        ledger_base(args)
        + [
            "create",
            candidate.candidate,
            "--version",
            candidate.version,
            "--source",
            candidate.source,
            "--note",
            candidate.note,
        ]
    )
    return "candidate_found"


def advance_if_allowed(args: argparse.Namespace, candidate: Candidate, desired: str, note: str) -> str:
    state = read_state(args, candidate.candidate) or create_if_missing(args, candidate)
    if state == desired:
        return state
    if desired not in ALLOWED.get(state, set()):
        return state
    run(ledger_base(args) + ["advance", candidate.candidate, desired, "--note", note])
    return desired


def safe_upgrade_cmd(candidate: Candidate) -> list[str]:
    safe_upgrade = os.environ.get("LAST_STACK_CANARY_SAFE_UPGRADE", str(SAFE_UPGRADE))
    return [safe_upgrade, "--probe-only", *candidate.safe_upgrade_args]


def dogfood(args: argparse.Namespace) -> dict:
    candidate = resolve_candidate(args)
    create_if_missing(args, candidate)
    started = advance_if_allowed(args, candidate, "dogfood_started", f"{args_mode(args)} source={candidate.source}")

    if not args.live:
        final = advance_if_allowed(
            args,
            candidate,
            "dogfood_green",
            "dry-run: would run " + " ".join(safe_upgrade_cmd(candidate) or ["safe-upgrade-probe"]),
        )
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "dry-run",
            "state": final,
            "safe_upgrade": "not-run",
            "safe_upgrade_args": list(candidate.safe_upgrade_args),
        }

    if not candidate.safe_upgrade_args:
        final = advance_if_allowed(args, candidate, "dogfood_red", "live: no executable local-main candidate")
        return {
            "candidate": candidate.candidate,
            "version": candidate.version,
            "source": candidate.source,
            "mode": "live",
            "state": final,
            "safe_upgrade": "not-run-no-candidate",
            "safe_upgrade_args": [],
        }

    cmd = safe_upgrade_cmd(candidate)
    proc = run(cmd, check=False)
    combined = proc.stdout + proc.stderr
    green = proc.returncode == 0 and (
        "VERDICT: GREEN" in combined or "VERDICT: GREEN_PROBE_ONLY" in combined or "VERDICT: ALREADY_CURRENT" in combined
    )
    desired = "dogfood_green" if green else "dogfood_red"
    final = advance_if_allowed(args, candidate, desired, f"live: safe-upgrade-probe rc={proc.returncode}")
    return {
        "candidate": candidate.candidate,
        "version": candidate.version,
        "source": candidate.source,
        "mode": "live",
        "state": final,
        "safe_upgrade": "green" if green else "red",
        "safe_upgrade_args": list(candidate.safe_upgrade_args),
        "safe_upgrade_rc": proc.returncode,
    }


def args_mode(args: argparse.Namespace) -> str:
    return "live" if args.live else "dry-run"


def emit(result: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
        return
    print(
        "lastdb-canary-dogfood candidate={candidate} state={state} mode={mode} source={source} safe_upgrade={safe_upgrade}".format(
            **result
        )
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if not args.dry_run and not args.live:
        args.dry_run = True
    result = dogfood(args)
    emit(result, args.json)
    return 0 if result.get("state") == "dogfood_green" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
