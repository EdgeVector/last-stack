#!/usr/bin/env python3
"""Milestone factory dashboard — North Star → Milestone → cards by column.

Read-only against fkanban + brain. Writes HTML (and optional JSON) grouping
live factory work under first-class milestones. Complements
`last-stack-north-star-dashboard` (NS-only rollup).

Opens with a one-screen progress band: every North Star as a single bar row,
sorted most-active first. Each row links into its (collapsed) detail section.

Default HTML: ~/code/edgevector/milestone-factory-dashboard.html
Links docs/ev-house.css (edgevector.org workstation house style).
"""

from __future__ import annotations

import argparse
import html
import json
import os
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Optional

COLUMNS = ("backlog", "todo", "doing", "done")
LIVE = ("backlog", "todo", "doing")
DEFAULT_HTML = Path.home() / "code" / "edgevector" / "milestone-factory-dashboard.html"
HOUSE_CSS = "docs/ev-house.css"
CMD_TIMEOUT = 45.0


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run_json(argv: list[str]) -> Any:
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            check=False,
            timeout=CMD_TIMEOUT,
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"timeout running {' '.join(argv)}") from exc
    if proc.returncode != 0:
        raise RuntimeError(
            f"{' '.join(argv)} failed ({proc.returncode}): "
            f"{(proc.stderr or proc.stdout or '').strip()}"
        )
    out = (proc.stdout or "").strip()
    if not out:
        return []
    return json.loads(out)


def fetch_live(board: str) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    cards_raw = run_json(["fkanban", "list", "--board", board, "--json", "--all"])
    if isinstance(cards_raw, dict):
        cards = cards_raw.get("cards") or cards_raw.get("items") or []
    else:
        cards = cards_raw if isinstance(cards_raw, list) else []
    ms_raw = run_json(["fkanban", "milestone", "list", "--board", board, "--json"])
    if isinstance(ms_raw, dict):
        milestones = ms_raw.get("milestones") or ms_raw.get("items") or []
    else:
        milestones = ms_raw if isinstance(ms_raw, list) else []
    projects = run_json(["brain", "list", "--type", "project", "--json", "--limit", "200"])
    if not isinstance(projects, list):
        projects = []
    return cards, milestones, projects


DEAD_MS = ("abandoned",)
ACTIVE_MS = ("active", "proving")


def ns_progress(ms_list: list[dict[str, Any]]) -> dict[str, Any]:
    """Roll a North Star's milestones into one glanceable progress figure.

    The milestone is the unit of progress, so every non-abandoned milestone
    carries equal weight. A complete milestone scores 1.0; an incomplete one
    scores its own done-card ratio (0.0 when it has no cards yet). Cards
    therefore give partial credit *within* a milestone but can never drag a
    fully-complete North Star back down — a stray backlog card under an
    otherwise-finished set is not "0% done".

    Abandoned milestones never count against a North Star; a North Star whose
    milestones are *all* abandoned is reported as closed, not as 0%.
    """
    counts = {c: 0 for c in COLUMNS}
    live_ms = [m for m in ms_list if str(m.get("state") or "") not in DEAD_MS]
    score = 0.0
    for m in live_ms:
        for col in COLUMNS:
            counts[col] += len(m["cards"].get(col) or [])
        m_cards = m["cards"]
        m_total = sum(len(m_cards.get(col) or []) for col in COLUMNS)
        if str(m.get("state") or "") == "complete":
            score += 1.0
        elif m_total:
            score += len(m_cards.get("done") or []) / m_total

    total_cards = sum(counts.values())
    live_cards = sum(counts[c] for c in LIVE)
    ms_total = len(live_ms)
    ms_done = sum(1 for m in live_ms if str(m.get("state") or "") == "complete")
    ms_active = sum(1 for m in live_ms if str(m.get("state") or "") in ACTIVE_MS)

    if not ms_total:
        status, pct = "closed", 0
    else:
        pct = round(100 * score / ms_total)
        if ms_done == ms_total:
            status = "done"
        elif ms_active or live_cards:
            status = "active"
        else:
            status = "idle"

    return {
        "pct": pct,
        "status": status,
        "cards": counts,
        "cards_total": total_cards,
        "cards_live": live_cards,
        "ms_total": ms_total,
        "ms_done": ms_done,
        "ms_active": ms_active,
        "ms_abandoned": len(ms_list) - ms_total,
    }


def build_model(
    cards: list[dict[str, Any]],
    milestones: list[dict[str, Any]],
    projects: list[dict[str, Any]],
) -> dict[str, Any]:
    ns_titles = {
        str(p.get("slug")): str(p.get("title") or p.get("slug"))
        for p in projects
        if p.get("slug") and ("north-star" in str(p.get("slug")) or "north-star" in str(p.get("tags") or []).lower())
    }
    # Also accept any project title for known north_star fields
    for p in projects:
        slug = str(p.get("slug") or "")
        if slug:
            ns_titles.setdefault(slug, str(p.get("title") or slug))

    by_ms: dict[str, dict[str, Any]] = {}
    for m in milestones:
        slug = str(m.get("slug") or "")
        if not slug:
            continue
        by_ms[slug] = {
            "slug": slug,
            "title": m.get("title") or slug,
            "state": m.get("state") or "",
            "north_star": m.get("north_star") or "",
            "proof_status": m.get("proof_status") or "",
            "proof_card": m.get("proof_card") or "",
            "driver": m.get("driver") or "",
            "cards": {c: [] for c in COLUMNS},
        }

    unassigned: list[dict[str, Any]] = []
    for card in cards:
        ms = str(card.get("milestone") or "").strip()
        col = str(card.get("column") or "?")
        if not ms or ms not in by_ms:
            unassigned.append(card)
            continue
        bucket = by_ms[ms]["cards"]
        if col not in bucket:
            bucket[col] = []
        bucket[col].append(card)

    # Group milestones under North Stars
    ns_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)
    orphan_ms: list[dict[str, Any]] = []
    for m in by_ms.values():
        ns = str(m.get("north_star") or "").strip()
        if not ns:
            orphan_ms.append(m)
        else:
            ns_groups[ns].append(m)

    def ms_sort(m: dict[str, Any]) -> tuple[int, str]:
        order = {"active": 0, "proving": 1, "blocked": 2, "planned": 3, "complete": 8, "abandoned": 9}
        return (order.get(str(m.get("state")), 5), str(m.get("slug")))

    for ns in ns_groups:
        ns_groups[ns].sort(key=ms_sort)

    live_unassigned_pr = [
        c
        for c in unassigned
        if str(c.get("column") or "") in LIVE
        and str(c.get("kind") or "pr") == "pr"
    ]

    groups = [
        {
            "slug": ns,
            "title": ns_titles.get(ns, ns),
            "milestones": ns_groups[ns],
            "progress": ns_progress(ns_groups[ns]),
        }
        for ns in sorted(ns_groups.keys())
    ]

    # Band order: what still needs attention first, closest-to-shipping on top.
    status_rank = {"active": 0, "idle": 1, "done": 2, "closed": 3}
    groups.sort(
        key=lambda g: (
            status_rank.get(g["progress"]["status"], 4),
            -g["progress"]["pct"],
            g["slug"],
        )
    )

    return {
        "generated_at": now_iso(),
        "board_total": len(cards),
        "milestone_count": len(by_ms),
        "north_star_groups": groups,
        "orphan_milestones": sorted(orphan_ms, key=ms_sort),
        "unassigned": {
            "total": len(unassigned),
            "live_pr": live_unassigned_pr,
            "live": [c for c in unassigned if str(c.get("column") or "") in LIVE],
        },
    }


def band_label(title: str, slug: str) -> str:
    """Strip decorative North Star prefixes so band rows stay scannable."""
    label = str(title or slug)
    for prefix in ("🌟 North Star — ", "🌟 North Star - ", "North Star — ", "North Star - "):
        if label.startswith(prefix):
            label = label[len(prefix):]
            break
    return label.strip() or slug


def render_html(model: dict[str, Any], css_href: str = HOUSE_CSS) -> str:
    esc = html.escape

    def card_li(c: dict[str, Any]) -> str:
        slug = esc(str(c.get("slug") or ""))
        title = esc(str(c.get("title") or ""))
        kind = esc(str(c.get("kind") or "pr"))
        pri = esc(str(c.get("priority") or c.get("pri") or "—"))
        return f'<li class="card"><code>{slug}</code> <span class="kind">{kind}</span> <span class="pri">{pri}</span> — {title}</li>'

    sections = []
    band_rows = []
    for ns in model["north_star_groups"]:
        anchor = "ns-" + str(ns["slug"])
        pr = ns["progress"]
        c = pr["cards"]
        tip = (
            f"{ns['slug']} · {pr['status']} · {pr['pct']}% · "
            f"milestones {pr['ms_done']}/{pr['ms_total']} complete"
            + (f" (+{pr['ms_abandoned']} abandoned)" if pr["ms_abandoned"] else "")
            + f" · cards backlog {c['backlog']} / todo {c['todo']} / doing {c['doing']} / done {c['done']}"
        )
        if pr["status"] == "closed":
            # every milestone abandoned — no progress to claim, so don't show 100%
            sub, pct_label, fill = "closed", "—", 0
        else:
            fill = max(0, min(100, pr["pct"]))
            pct_label = f"{pr['pct']}%"
            sub = f"{pr['ms_done']}/{pr['ms_total']} ms"
        band_rows.append(
            f'<a class="nsrow" href="#{esc(anchor)}" data-status="{esc(pr["status"])}" '
            f'title="{esc(tip)}">'
            f'<span class="nsname">{esc(band_label(ns["title"], ns["slug"]))}</span>'
            f'<span class="bar"><i style="width:{fill}%"></i></span>'
            f'<span class="pct">{esc(pct_label)}</span>'
            f'<span class="sub">{esc(sub)}</span>'
            f"</a>"
        )

        ms_blocks = []
        for m in ns["milestones"]:
            cols_html = []
            for col in COLUMNS:
                cards = m["cards"].get(col) or []
                if not cards and col == "done":
                    # keep done collapsed if empty
                    cols_html.append(
                        f'<div class="col"><h4>{col} (0)</h4><p class="muted">—</p></div>'
                    )
                    continue
                if cards:
                    body = f"<ul>{''.join(card_li(c) for c in cards)}</ul>"
                else:
                    body = '<p class="muted">—</p>'
                cols_html.append(
                    f'<div class="col"><h4>{col} ({len(cards)})</h4>{body}</div>'
                )
            proof = esc(str(m.get("proof_status") or "—"))
            state = esc(str(m.get("state") or ""))
            ms_blocks.append(
                f"""
<section class="milestone" data-state="{state}">
  <header>
    <h3>{esc(str(m.get("title")))}</h3>
    <div class="meta"><code>{esc(str(m.get("slug")))}</code>
      <span class="pill">{state}</span>
      <span class="pill">proof:{proof}</span>
    </div>
  </header>
  <div class="cols">{''.join(cols_html)}</div>
</section>"""
            )
        sections.append(
            f"""
<details class="ns" id="{esc(anchor)}" data-ns="{esc(ns['slug'])}" data-status="{esc(pr['status'])}">
  <summary>
    <span class="sum-title">{esc(ns['title'])}</span>
    <span class="sum-bar"><i style="width:{fill}%"></i></span>
    <span class="sum-pct">{esc(pct_label)}</span>
  </summary>
  <p class="slug"><code>{esc(ns['slug'])}</code> · {len(ns['milestones'])} milestone(s)
    · {pr['ms_done']}/{pr['ms_total']} complete · {pr['cards_live']} live card(s)
    · {pr['cards']['done']}/{pr['cards_total']} cards done</p>
  {''.join(ms_blocks) if ms_blocks else '<p class="muted">No milestones.</p>'}
</details>"""
        )

    orphan_html = ""
    if model["orphan_milestones"]:
        items = "".join(
            f"<li><code>{esc(m['slug'])}</code> — {esc(str(m.get('title')))} "
            f"<span class='pill'>{esc(str(m.get('state')))}</span></li>"
            for m in model["orphan_milestones"]
        )
        orphan_html = f"<section class='orphan'><h2>Milestones without North Star</h2><ul>{items}</ul></section>"

    ua = model["unassigned"]
    ua_rows = "".join(
        f"<tr><td><code>{esc(str(c.get('slug')))}</code></td>"
        f"<td>{esc(str(c.get('column')))}</td>"
        f"<td>{esc(str(c.get('kind') or 'pr'))}</td>"
        f"<td>{esc(str(c.get('title') or ''))}</td></tr>"
        for c in ua["live"]
    )

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Milestone factory dashboard</title>
<link rel="stylesheet" href="{esc(css_href)}" />
<style>
/* local layout extensions on house system */
body {{ margin: 0; font: 14px/1.45 system-ui, sans-serif; background: var(--bg, #f4f1ea); color: var(--ink, #1c1917); }}
header.top {{ background: #1c1917; color: #fafaf9; padding: 24px 28px; }}
header.top h1 {{ margin: 0 0 6px; font-size: 26px; }}
header.top p {{ margin: 0; color: #a8a29e; max-width: 900px; }}
main {{ padding: 20px 28px 48px; max-width: 1400px; margin: 0 auto; }}
.topline {{ display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }}
.stat {{ background: #fffdf8; border: 1px solid #d6d3d1; border-radius: 10px; padding: 10px 12px; min-width: 100px; }}
.stat b {{ display: block; font-size: 22px; }}
.stat span {{ color: #78716c; font-size: 12px; }}
.notice {{ border-left: 4px solid #b45309; background: #fffbeb; padding: 10px 12px; border-radius: 8px; margin: 12px 0; color: #78350f; }}

/* ── progress band: every North Star, one screen, click through to detail ── */
.band {{ background: #fffdf8; border: 1px solid #d6d3d1; border-radius: 12px; padding: 12px 14px; margin: 0 0 16px; }}
.band-head {{ display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }}
.band-head h2 {{ margin: 0; font-size: 15px; letter-spacing: .02em; text-transform: uppercase; color: #44403c; }}
.band-head .legend {{ font-size: 11px; color: #78716c; }}
.band-head .legend b {{ font-weight: 600; color: #57534e; }}
.band-head .acts {{ margin-left: auto; display: flex; gap: 6px; }}
.band-head button {{ font: inherit; font-size: 11px; padding: 2px 9px; border-radius: 999px;
  border: 1px solid #d6d3d1; background: #fafaf9; color: #57534e; cursor: pointer; }}
.band-head button:hover {{ background: #ebe7df; }}
.band-grid {{ display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 2px 20px; }}
.nsrow {{ display: grid; grid-template-columns: minmax(0, 1fr) 76px 32px 56px; align-items: center;
  gap: 8px; padding: 3px 6px; border-radius: 6px; text-decoration: none; color: inherit; }}
.nsrow:hover {{ background: #f0ece3; }}
.nsrow .nsname {{ font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }}
.nsrow .pct {{ font-size: 11px; text-align: right; font-variant-numeric: tabular-nums; color: #44403c; }}
.nsrow .sub {{ font-size: 10px; color: #a8a29e; white-space: nowrap; }}
.bar {{ height: 7px; border-radius: 999px; background: #e7e5e4; overflow: hidden; }}
.bar i {{ display: block; height: 100%; background: #0f766e; border-radius: 999px; }}
.nsrow[data-status="idle"] .bar i {{ background: #a8a29e; }}
.nsrow[data-status="done"] .bar i {{ background: #4d7c0f; }}
.nsrow[data-status="closed"] {{ opacity: .5; }}
.nsrow[data-status="closed"] .bar i {{ background: #d6d3d1; }}
.nsrow:target, .nsrow.hit {{ background: #fef3c7; }}

.ns {{ position: relative; background: #fffdf8; border: 1px solid #d6d3d1; border-radius: 12px; padding: 4px 16px; margin: 10px 0; }}
.ns[open] {{ padding-bottom: 14px; }}
.ns > summary {{ display: grid; grid-template-columns: minmax(0, 1fr) 120px 44px; align-items: center;
  gap: 12px; cursor: pointer; padding: 10px 0; list-style: none; }}
.ns > summary::-webkit-details-marker {{ display: none; }}
.ns > summary::before {{ content: "▸"; position: absolute; margin-left: -14px; color: #a8a29e; font-size: 11px; }}
.ns[open] > summary::before {{ content: "▾"; }}
.ns > summary:hover {{ color: #0f766e; }}
.sum-title {{ font-size: 16px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }}
.sum-bar {{ height: 7px; border-radius: 999px; background: #e7e5e4; overflow: hidden; }}
.sum-bar i {{ display: block; height: 100%; background: #0f766e; border-radius: 999px; }}
.ns[data-status="idle"] .sum-bar i {{ background: #a8a29e; }}
.ns[data-status="done"] .sum-bar i {{ background: #4d7c0f; }}
.ns[data-status="closed"] .sum-bar i {{ background: #d6d3d1; }}
.sum-pct {{ font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; color: #57534e; }}
.ns:target {{ border-color: #0f766e; box-shadow: 0 0 0 3px rgba(15, 118, 110, .14); }}
.ns .slug {{ color: #78716c; margin: 0 0 12px; font-size: 12px; }}
.milestone {{ border: 1px solid #e7e5e4; border-radius: 10px; padding: 10px 12px; margin: 10px 0; background: #fff; }}
.milestone h3 {{ margin: 0 0 4px; font-size: 15px; }}
.meta {{ display: flex; gap: 8px; flex-wrap: wrap; align-items: center; font-size: 12px; color: #57534e; }}
.pill {{ border: 1px solid #d6d3d1; border-radius: 999px; padding: 1px 8px; background: #fafaf9; }}
.cols {{ display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }}
.col h4 {{ margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #57534e; }}
.col ul {{ list-style: none; margin: 0; padding: 0; }}
.card {{ border: 1px solid #e7e5e4; border-radius: 8px; padding: 6px 8px; margin: 4px 0; font-size: 12px; }}
.card .kind, .card .pri {{ color: #78716c; }}
.muted {{ color: #78716c; }}
table {{ width: 100%; border-collapse: collapse; background: #fffdf8; border: 1px solid #d6d3d1; border-radius: 12px; overflow: hidden; }}
th, td {{ padding: 8px 10px; border-bottom: 1px solid #e7e5e4; text-align: left; vertical-align: top; }}
th {{ background: #ebe7df; font-size: 11px; text-transform: uppercase; color: #57534e; }}
.orphan {{ margin-top: 24px; }}
@media (max-width: 1000px) {{ .cols {{ grid-template-columns: 1fr 1fr; }} }}
@media (max-width: 640px) {{ .cols {{ grid-template-columns: 1fr; }} main {{ padding: 12px; }} }}
</style>
</head>
<body>
<header class="top">
  <h1>Milestone factory dashboard</h1>
  <p>Generated <code>{esc(model['generated_at'])}</code>. Hierarchy: North Star → Milestone → cards by column.
  Live Unassigned Kind:pr cards must be backfilled. CLI twin: <code>kanban list --group-by-milestone</code>.</p>
</header>
<main>
  <div class="topline">
    <div class="stat"><b>{model['board_total']}</b><span>board cards</span></div>
    <div class="stat"><b>{model['milestone_count']}</b><span>milestones</span></div>
    <div class="stat"><b>{len(model['north_star_groups'])}</b><span>NS with milestones</span></div>
    <div class="stat"><b>{len(ua['live_pr'])}</b><span>live Kind:pr unassigned</span></div>
  </div>
  <section class="band">
    <div class="band-head">
      <h2>North Star progress</h2>
      <span class="legend">% = milestones complete, each unfinished one credited its done-card share
        · <b>teal</b> active · <b>grey</b> idle · <b>green</b> done · faded closed
        · click a row for detail</span>
      <span class="acts">
        <button type="button" data-all="1">Expand all</button>
        <button type="button" data-all="0">Collapse all</button>
      </span>
    </div>
    <div class="band-grid">{''.join(band_rows) if band_rows else '<p class="muted">No North Stars with milestones.</p>'}</div>
  </section>
  <div class="notice">Unassigned / Operational live Kind:pr count: <b>{len(ua['live_pr'])}</b>
  (todo/doing should be zero once enforce + backfill land). House CSS: <code>{esc(css_href)}</code>.</div>
  {''.join(sections)}
  {orphan_html}
  <h2>Live unassigned cards</h2>
  <table>
    <thead><tr><th>slug</th><th>column</th><th>kind</th><th>title</th></tr></thead>
    <tbody>{ua_rows if ua_rows else '<tr><td colspan="4" class="muted">None</td></tr>'}</tbody>
  </table>
</main>
<script>
(function () {{
  function byHash() {{
    var id = (location.hash || '').slice(1);
    return id ? document.getElementById(id) : null;
  }}
  function openTarget() {{
    var el = byHash();
    if (el && el.tagName === 'DETAILS') {{ el.open = true; }}
  }}
  document.addEventListener('click', function (e) {{
    if (!e.target || !e.target.closest) {{ return; }}
    var row = e.target.closest('a.nsrow');
    if (row) {{
      var d = document.getElementById(row.getAttribute('href').slice(1));
      if (d) {{ d.open = true; }}
      return;
    }}
    var btn = e.target.closest('.band-head button');
    if (btn) {{
      var on = btn.getAttribute('data-all') === '1';
      var all = document.querySelectorAll('details.ns');
      for (var i = 0; i < all.length; i++) {{ all[i].open = on; }}
    }}
  }});
  window.addEventListener('hashchange', openTarget);
  openTarget();
}})();
</script>
</body>
</html>
"""


def main(argv: Optional[list[str]] = None) -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--board", default="default")
    p.add_argument("--html", type=Path, nargs="?", const=DEFAULT_HTML, default=None)
    p.add_argument("--json-out", type=Path)
    p.add_argument("--css", default=HOUSE_CSS, help="stylesheet href for house style")
    p.add_argument(
        "--cards-json",
        type=Path,
        help="fixture cards JSON (with --milestones-json)",
    )
    p.add_argument("--milestones-json", type=Path)
    p.add_argument("--projects-json", type=Path)
    args = p.parse_args(argv)

    try:
        if args.cards_json and args.milestones_json:
            cards = json.loads(args.cards_json.read_text(encoding="utf-8"))
            milestones = json.loads(args.milestones_json.read_text(encoding="utf-8"))
            projects = (
                json.loads(args.projects_json.read_text(encoding="utf-8"))
                if args.projects_json
                else []
            )
            if isinstance(milestones, dict):
                milestones = milestones.get("milestones") or []
        else:
            cards, milestones, projects = fetch_live(args.board)
        model = build_model(cards, milestones, projects)
    except Exception as exc:  # noqa: BLE001 — CLI surface
        print(f"error: {exc}", file=sys.stderr)
        return 1

    if args.json_out:
        args.json_out.write_text(json.dumps(model, indent=2) + "\n", encoding="utf-8")
        print(f"JSON={args.json_out}", file=sys.stderr)

    html_path = args.html if args.html is not None else DEFAULT_HTML
    html_path.parent.mkdir(parents=True, exist_ok=True)
    html_path.write_text(render_html(model, css_href=args.css), encoding="utf-8")
    print(f"HTML={html_path}", file=sys.stderr)

    print(
        f"milestones={model['milestone_count']} ns_groups={len(model['north_star_groups'])} "
        f"live_unassigned_pr={len(model['unassigned']['live_pr'])}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
