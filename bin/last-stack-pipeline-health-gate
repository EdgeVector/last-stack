#!/usr/bin/env bash
# Zero-agent pre-dispatch gate for pipeline-health.
#
# Delegates to last-stack-merge-demand-gate. Quiet inventories skip. There is
# no hourly deep-pulse proceed. LastGit-disabled tool failures are quiet.
# Aged Forge PRs and blocked deploys still proceed.
set -euo pipefail

self_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
if [ -n "${LAST_STACK_ROOT:-}" ] && [ -d "${LAST_STACK_ROOT}/bin" ]; then
  last_stack="$LAST_STACK_ROOT"
elif [ -d "${HOME}/.last-stack/bin" ]; then
  last_stack="${HOME}/.last-stack"
else
  last_stack="$(CDPATH='' cd -- "$self_dir/.." && pwd -P)"
fi

usage() {
  cat <<'USAGE'
last-stack-pipeline-health-gate

Exit 0 prints a noop result and skips the full agent.
Exit 10 asks routinesd to start the full pipeline-health agent.

Does not force a deep pass on a timer. LastGit ghosts and LastGit-disabled
tool failures are quiet. Forge aged-open PRs and blocked deploys proceed.

Environment:
  LAST_STACK_PIPELINE_GATE_MIN_AGE_MIN       stuck merge age (default 10)
  LAST_STACK_PIPELINE_GATE_TIMEOUT_SEC       per-read cap (default 20)
  LAST_STACK_PIPELINE_GATE_DEPLOY_TAIL_BYTES deploy log tail (default 16777216)
  LAST_STACK_PIPELINE_GATE_FORGE_REPOS       comma list (default seven-repo file)
  LAST_STACK_LASTGIT_NATIVE_REPOS            opt-in LastGit venues; empty = disabled
  LAST_STACK_MERGE_DEMAND_FORGE_REPOS        overrides the Forge list
USAGE
}

case "${1:-}" in
  "") ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

merge_demand=""
for cand in \
  "${LAST_STACK_MERGE_DEMAND_BIN:-}" \
  "$self_dir/last-stack-merge-demand-gate" \
  "${last_stack}/bin/last-stack-merge-demand-gate"; do
  if [ -n "$cand" ] && [ -x "$cand" ]; then
    merge_demand="$cand"
    break
  fi
done
if [ -z "$merge_demand" ]; then
  echo "last-stack-pipeline-health-gate: missing last-stack-merge-demand-gate" >&2
  exit 2
fi

export LAST_STACK_MERGE_DEMAND_PROCEED_PREFIX="${LAST_STACK_MERGE_DEMAND_PROCEED_PREFIX:-PIPELINE_HEALTH_GATE_PROCEED}"
export LAST_STACK_MERGE_DEMAND_HEARTBEAT_ID="${LAST_STACK_MERGE_DEMAND_HEARTBEAT_ID:-pipeline-health}"
exec "$merge_demand"
