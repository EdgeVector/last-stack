#!/usr/bin/env bash
# Scan LastGit post-merge deploy-pipeline logs under ~/.lastgit/deploy-*/deploy.log
# and report repos whose latest terminal state is failure, or pending too long.
#
# Usage:
#   last-stack-pipeline-deploy-scan [--json] [--root <dir>] [--pending-max-s <n>] [--tail-bytes <n>]
#                                   [--repo <name>]
#
# Exit codes:
#   0  scanned OK (even if some pipelines are blocked — check .blocked)
#   2  usage / bad args
#
# A pipeline is blocked when:
#   - the latest success|failure line is `failure`, OR
#   - the latest line is `pending` older than --pending-max-s (default 4h)
#   AND there is no later success.
#
# --repo <name> narrows the report to one repo and ALWAYS emits a row for it,
# so a caller gating on it can tell these three states apart:
#   - a producer exists       -> success|failure|pending, as scanned
#   - no producer for <name>, but other repos DO have one under <root>
#                             -> status=not-applicable, blocked=false.
#      That repo does not deploy through the LastGit deploy-pipeline at all
#      (e.g. fold deploys via lastdb-safe-upgrade, last-stack via host-track),
#      so a gate waiting on it can never be satisfied and must not block.
#   - no producers under <root> whatsoever
#                             -> status=unconfigured, blocked=true.
#      Ambiguous — likely a wrong --root / LASTGIT_DEPLOY_ROOT — so fail closed.
#   - a producer exists but its launchd watcher job
#     (com.edgevector.lastgit-deploy-<repo>, underscores as dashes) is not
#     loaded -> status=retired, blocked=false.
#      The repo moved its deploy to GitHub Actions (sop-migrate-repo-to-github)
#      and the LastGit watcher was deliberately booted out; its deploy.log
#      stopped updating and freezes on whatever line it last wrote — which can
#      be `failure` purely because that is what the watcher happened to be
#      mid-write when it was stopped, not a live production signal
#      (papercut-pipeline-deploy-schema-infra, 2026-10-01: a disabled plist
#      from 2026-09-30 froze schema-infra's log on a stale `failure` line for
#      a day while the repo's real deploy, now on GitHub Actions, was green).
set -eu

# The COMPLETE status vocabulary this scanner can emit, declared in one place so
# a consumer that gates on status has something to be checked against. Every
# literal `pipe_status="…"` assignment and every synthesized `--repo` row below
# must appear here, and a consumer must have an explicit verdict for each one.
# Both directions are asserted by
# tests/last-stack-card-closeout-deploy-gate-vocabulary.sh, so adding a status
# without classifying it in bin/last-stack-card-closeout breaks CI instead of
# jamming a merged card in `doing`
# (papercut-card-closeout-deploy-gate-refuses-the-retired-status-the-scanner-now-emits-20261001:
# `retired` was added by PR #172 and silently took the refusal arm, which made
# the gate unsatisfiable for all four repos it covers).
DEPLOY_SCAN_STATUSES="success failure pending unknown retired not-applicable unconfigured missing"

json=0
root="${LASTGIT_DEPLOY_ROOT:-$HOME/.lastgit}"
pending_max_s=14400
tail_bytes="${LAST_STACK_DEPLOY_SCAN_TAIL_BYTES:-1048576}"
repo_filter=""

usage() {
  cat >&2 <<'EOF'
usage: last-stack-pipeline-deploy-scan [--json] [--root <dir>] [--pending-max-s <seconds>] [--tail-bytes <bytes>] [--repo <name>]
       last-stack-pipeline-deploy-scan --statuses

Scans <root>/deploy-*/deploy.log for LastGit deploy-pipeline health.
Prints human lines by default, or a JSON array with --json.
With --repo <name>, reports only that repo and always emits exactly one row —
synthesizing status=not-applicable (no producer for it, others configured) or
status=unconfigured (no producers at all) when it has no deploy log.

--statuses prints the complete status vocabulary this scanner can emit, one per
line. A caller that gates on status must have an explicit verdict for each.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) json=1; shift ;;
    # Print the declared status vocabulary, one per line, and exit. This is the
    # contract a gating consumer is checked against; it reads this instead of
    # grepping the source.
    --statuses)
      printf '%s\n' $DEPLOY_SCAN_STATUSES
      exit 0
      ;;
    --root)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      root="$2"
      shift 2
      ;;
    --pending-max-s)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      pending_max_s="$2"
      shift 2
      ;;
    --tail-bytes)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      tail_bytes="$2"
      shift 2
      ;;
    --repo)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      repo_filter="$2"
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

now="$(date -u +%s)"

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | tr '\n' ' '
}

log_mtime() {
  local f="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import os,sys; print(int(os.path.getmtime(sys.argv[1])))' "$f" 2>/dev/null && return 0
  fi
  # GNU stat
  if stat -c %Y "$f" >/dev/null 2>&1; then
    stat -c %Y "$f"
    return 0
  fi
  # BSD stat
  if stat -f %m "$f" >/dev/null 2>&1; then
    stat -f %m "$f"
    return 0
  fi
  echo 0
}

last_matching_line() {
  local log="$1"
  local pattern="$2"
  # Production deploy logs can be tens of MB. Keep the shell bounded by reading
  # only the recent tail and using grep's C implementation for matching.
  tail -c "$tail_bytes" "$log" 2>/dev/null | grep -aE "$pattern" | tail -n 1 || true
}

# The LastGit deploy watcher for <repo> is the launchd job
# com.edgevector.lastgit-deploy-<repo>, underscores folded to dashes (matches
# the plist filenames under ~/Library/LaunchAgents). Override the lookup
# binary in tests with LAST_STACK_DEPLOY_SCAN_LAUNCHCTL_BIN.
watcher_label() {
  local repo="$1"
  printf 'com.edgevector.lastgit-deploy-%s' "${repo//_/-}"
}

watcher_loaded() {
  local label="$1"
  local lc="${LAST_STACK_DEPLOY_SCAN_LAUNCHCTL_BIN:-launchctl}"
  "$lc" list "$label" >/dev/null 2>&1
}

# Collect results as lines: repo|pipe_status|sha|blocked|reason|log|mtime
results=()
shopt -s nullglob
for dir in "$root"/deploy-*/; do
  [ -d "$dir" ] || continue
  base="$(basename "${dir%/}")"
  case "$base" in
    # deploy-run's working-copy root (<root>/deploy-checkouts/<repo>/), not a
    # producer. It never has a deploy.log, and reading it as repo=checkouts
    # reported a permanent false `missing` block
    # (papercut-pipeline-deploy-checkouts, 2026-09-21).
    deploy-checkouts) continue ;;
    deploy-*) repo="${base#deploy-}" ;;
    *) continue ;;
  esac
  log="${dir}deploy.log"
  if [ ! -f "$log" ]; then
    results+=("$repo|missing||1|deploy.log missing|$log|0")
    continue
  fi

  # Latest deploy event from a bounded tail window (ignore skip / JSON telemetry).
  # Two producer shapes emit a terminal line:
  #   line-anchored:      "success <sha> deploy-pipeline ..."       (deploy-prod.sh's own log line)
  #   timestamp-prefixed: "<ts>Z deploy success oid=<sha> rc=<n>"   (deploy-run.sh's log(), the
  #                        common case: every deploy-run.sh copy logs its own outcome this way)
  last_term="$(last_matching_line "$log" '^(success|failure) |deploy (success|failure)([[:space:]]|$)')"
  last_any="$(last_matching_line "$log" '^(success|failure|pending) ')"

  mtime="$(log_mtime "$log")"
  pipe_status="unknown"
  sha=""
  blocked=0
  reason="no success/failure/pending lines"

  if [ -n "$last_term" ]; then
    if [[ "$last_term" =~ ^(success|failure)[[:space:]] ]]; then
      # e.g. "failure abcdef deploy-pipeline"
      pipe_status="${last_term%% *}"
      rest="${last_term#* }"
      sha="${rest%% *}"
    else
      # e.g. "2026-09-23T08:14:00Z deploy success oid=8697e686 rc=0"
      case "$last_term" in
        *"deploy failure"*) pipe_status="failure" ;;
        *"deploy success"*) pipe_status="success" ;;
      esac
      sha="$(printf '%s' "$last_term" | sed -n 's/.*oid=\([^[:space:]]*\).*/\1/p')"
    fi
    if [ "$pipe_status" = "failure" ]; then
      blocked=1
      reason="latest terminal status is failure for $sha"
    else
      reason="latest terminal status is success for $sha"
    fi
  fi

  # If the newest event overall is pending, apply grace on log mtime
  case "$last_any" in
    pending\ *)
      rest="${last_any#* }"
      pend_sha="${rest%% *}"
      pipe_status="pending"
      sha="$pend_sha"
      age=$((now - mtime))
      if [ "$age" -gt "$pending_max_s" ]; then
        blocked=1
        reason="pending ${age}s (max ${pending_max_s}s) for $sha"
      else
        blocked=0
        reason="pending ${age}s (within grace) for $sha"
      fi
      ;;
  esac

  # A frozen log is not a live signal. If the launchd watcher that writes
  # this log is not loaded, the repo's deploy moved off the LastGit
  # deploy-pipeline (sop-migrate-repo-to-github) and the last line — success,
  # failure, or pending — is just whatever it happened to be mid-write when
  # the job was booted out. Report it as retired, not blocked.
  if ! watcher_loaded "$(watcher_label "$repo")"; then
    reason="LastGit deploy watcher $(watcher_label "$repo") not loaded; log frozen since mtime=$mtime on last status=$pipe_status sha=${sha:-none} — repo likely moved to GitHub Actions deploy"
    pipe_status="retired"
    blocked=0
  fi

  results+=("$repo|$pipe_status|$sha|$blocked|$reason|$log|$mtime")
done
shopt -u nullglob

# --repo: always emit exactly one row for the requested repo, synthesizing the
# absent-producer states so a gating caller can never sit forever on a row that
# will never appear. See the header comment for why not-applicable is unblocked
# while unconfigured is not.
if [ -n "$repo_filter" ]; then
  filtered=()
  configured=()
  for row in "${results[@]+"${results[@]}"}"; do
    row_repo="${row%%|*}"
    configured+=("$row_repo")
    if [ "$row_repo" = "$repo_filter" ]; then
      filtered+=("$row")
    fi
  done
  if [ "${#filtered[@]}" -eq 0 ]; then
    if [ "${#configured[@]}" -gt 0 ]; then
      others="$(printf '%s,' "${configured[@]}")"
      others="${others%,}"
      filtered=("$repo_filter|not-applicable||0|no deploy-pipeline producer for $repo_filter under $root (configured: $others)||0")
    else
      filtered=("$repo_filter|unconfigured||1|no deploy-* producers under $root|$root|0")
    fi
  fi
  results=("${filtered[@]}")
fi

if [ "$json" -eq 1 ]; then
  printf '['
  first=1
  for row in "${results[@]+"${results[@]}"}"; do
    IFS='|' read -r repo pipe_status sha blocked reason log mtime <<<"$row"
    [ "$first" -eq 1 ] || printf ','
    first=0
    if [ "$blocked" = "1" ]; then bj=true; else bj=false; fi
    printf '{"repo":"%s","status":"%s","sha":"%s","blocked":%s,"reason":"%s","log":"%s","log_mtime":%s}' \
      "$(json_escape "$repo")" \
      "$(json_escape "$pipe_status")" \
      "$(json_escape "$sha")" \
      "$bj" \
      "$(json_escape "$reason")" \
      "$(json_escape "$log")" \
      "${mtime:-0}"
  done
  printf ']\n'
else
  if [ "${#results[@]}" -eq 0 ]; then
    echo "no deploy logs under $root/deploy-*"
  fi
  blocked_n=0
  for row in "${results[@]+"${results[@]}"}"; do
    IFS='|' read -r repo pipe_status sha blocked reason log mtime <<<"$row"
    mark="ok"
    if [ "$blocked" = "1" ]; then
      mark="BLOCKED"
      blocked_n=$((blocked_n + 1))
    fi
    printf '%s  %-20s  status=%-8s  sha=%s  %s\n' "$mark" "$repo" "$pipe_status" "${sha:--}" "$reason"
  done
  echo "summary blocked=$blocked_n total=${#results[@]}"
fi
