#!/usr/bin/env bash
# The `promote-eligible` short action of the hourly canary v2 reconciler.
#
# Called once per green verdict token with LAST_STACK_CANARY_CANDIDATE set to
# the primary's build string. Writes PROMOTE.md — the node build and the
# `next` rows proved with it — then PUBLISHES: since 2026-09-21
# (decision-2026-09-21-stable-publish-is-automatic-on-green, Tom) a green
# quiet window (1 h since 2026-09-24; 24 h before) is the stable decision. `last-stack-release-publish
# --if-needed` refuses a build with no proved `next` rows, skips halves that
# are already public, and moves brew stable and the registry `stable` rows
# together. LAST_STACK_RELEASE_AUTO_PUBLISH=0 turns this back into
# material-only (the pre-09-21 behaviour). Then it notifies with the result.
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")/.." && pwd -P)"
export PATH="${HOME}/.local/bin:${ROOT}/bin:${PATH:-/usr/bin:/bin}"

candidate="${LAST_STACK_CANARY_CANDIDATE:-}"
promote_root="${LAST_STACK_CANARY_PROMOTE_ROOT:-$HOME/.local/state/last-stack/canary-promote}"
tap_url="${LAST_STACK_REGISTRY_TAP_URL:-${FORGE_ROOT_URL:-http://localhost:3300}/EdgeVector/homebrew-lastdb.git}"
next_index="${LAST_STACK_REGISTRY_NEXT_INDEX:-}"   # tests: a local next.json
notify="${LAST_STACK_CANARY_NOTIFY_CMD:-ra notify}"
no_notify=0
auto_publish="${LAST_STACK_RELEASE_AUTO_PUBLISH:-1}"
publish_bin="${LAST_STACK_RELEASE_PUBLISH_BIN:-$ROOT/bin/last-stack-release-publish}"

usage() {
  printf '%s\n' 'last-stack-canary-promote-material [--candidate BUILD] [--no-notify] [--no-publish]'
  printf '%s\n' 'Green candidate: write PROMOTE.md, then publish brew stable + registry stable rows (release-publish --if-needed).'
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --candidate) candidate="$2"; shift 2 ;;
    --no-notify) no_notify=1; shift ;;
    --no-publish) auto_publish=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[ -n "$candidate" ] || { echo "last-stack-canary-promote-material: no candidate (LAST_STACK_CANARY_CANDIDATE)" >&2; exit 2; }

# Read the `next` rows for this build from the tap's main (or a local file).
work="$(mktemp -d "${TMPDIR:-/tmp}/promote-material.XXXXXX")"
trap 'rm -rf "$work"' EXIT
if [ -z "$next_index" ]; then
  case "$tap_url" in
    http://localhost:3300/*|http://127.0.0.1:3300/*)
      if [ -r "$ROOT/lib/forge-token.sh" ]; then
        # shellcheck source=../lib/forge-token.sh
        . "$ROOT/lib/forge-token.sh"
        last_stack_forge_export_git_config 2>/dev/null || true
      fi ;;
  esac
  if git clone --quiet --depth 1 "$tap_url" "$work/tap" 2>/dev/null && [ -f "$work/tap/registry/next.json" ]; then
    next_index="$work/tap/registry/next.json"
  fi
fi
rows_block="(the tap could not be read; run \`last-stack-registry-index show --index <tap>/registry/next.json --lastdb-version $candidate\`)"
row_count=0
if [ -n "$next_index" ] && [ -f "$next_index" ]; then
  rows_block="$(jq -r --arg b "$candidate" '.apps[] | . as $a | .compat[] | select(.lastdb_version == $b) | "- `\($a.app_id)` \(.app_version) @ `\(.sha[0:12])` — proved \(.proved_at) by `\(.proof_run)`"' "$next_index")"
  row_count="$(jq -r --arg b "$candidate" '[.apps[].compat[] | select(.lastdb_version == $b)] | length' "$next_index")"
  [ -n "$rows_block" ] || rows_block="(no next rows name lastdb $candidate — the nightly candidate gate did not write them; the publish command will refuse)"
fi

day="$(date -u +%Y-%m-%d)"
out_dir="$promote_root/$day"
mkdir -p "$out_dir"
out="$out_dir/PROMOTE.md"
cat >"$out" <<EOF
# LastDB release candidate — ready to publish

- Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)
- Node build: \`$candidate\` (the primary held the quiet window; verdict green)
- Registry \`next\` rows proved with this build: $row_count

## Proved app rows (\`next\`)

$rows_block

## Publish

\`\`\`bash
last-stack-release-publish --lastdb-version $candidate --if-needed
\`\`\`

Since 2026-09-21 the reconciler runs this itself when the quiet window is
green (decision-2026-09-21-stable-publish-is-automatic-on-green). It moves
the node to the Homebrew stable formula and these rows to the registry
\`stable\` channel with public sources, together. A build with no proved
rows is refused; halves already public are skipped. The result is appended
below.
EOF

publish_status=material-only
if [ "$auto_publish" != 0 ]; then
  if [ "$row_count" -eq 0 ]; then
    publish_status=skipped:no_next_rows
  elif [ -x "$publish_bin" ]; then
    set +e
    publish_out="$("$publish_bin" --lastdb-version "$candidate" --if-needed 2>"$out_dir/publish.err")"
    publish_rc=$?
    set -e
    publish_line="$(printf '%s\n' "$publish_out" | grep '^RELEASE_PUBLISH' | tail -n1 || true)"
    if [ "$publish_rc" -eq 0 ]; then
      publish_status="${publish_line#RELEASE_PUBLISH }"
    else
      publish_status="failed:rc=$publish_rc"
    fi
    {
      printf '\n## Result (%s)\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '%s\n' "${publish_line:-no RELEASE_PUBLISH line}"
      if [ "$publish_rc" -ne 0 ]; then
        printf '\nrc=%s\n\n' "$publish_rc"
        tail -n 20 "$out_dir/publish.err"
      fi
    } >>"$out"
  else
    publish_status=failed:publisher_missing
  fi
fi

if [ "$no_notify" -ne 1 ]; then
  # shellcheck disable=SC2086
  $notify "LastDB candidate $candidate green ($row_count proved app rows): publish $publish_status ($out)" --priority high >/dev/null 2>&1 || true
fi
printf 'PROMOTE_MATERIAL candidate=%s rows=%s publish=%s output=%s\n' "$candidate" "$row_count" "$publish_status" "$out"
case "$publish_status" in
  failed:*) exit 1 ;;
esac
