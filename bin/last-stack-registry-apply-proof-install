#!/usr/bin/env bash
# Install / uninstall / status / proof / run-once the LaunchAgent that runs
# `last-stack-registry-apply-proof --latest` on a schedule.
#
# Without this agent, the Mac-side signing half of the registry-proof
# pipeline (decision-2026-09-30-registry-proof-ci-sign-on-mac-gh-pat-build-in-last-stack)
# only runs when a human or an agent happens to invoke it by hand. That gap
# is the confirmed root cause of host-track's registry pin lagging behind a
# green, published main tip for brain, lastsecrets, routines, and situations
# (papercut-host-track-registry-pin-lags-behind-published-artifact-20260927,
# 5+ occurrences). The command itself already refuses unsafely (serial
# open-PR check, run verification, stale/backwards-pin check); this agent
# only has to call it regularly.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -h "$self" ]; do
  self_dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
self_root="$(cd -P "$(dirname "$self")/.." && pwd)"
# shellcheck source=../lib/last-stack-launchd-agent.sh
. "$self_root/lib/last-stack-launchd-agent.sh"

program="last-stack-registry-apply-proof"
label="com.edgevector.last-stack-registry-apply-proof"
last_stack="$(last_stack_agent_stable_root "$self" "$program")"
plist_src="$self_root/launchd/${label}.plist"
if [ ! -f "$plist_src" ]; then
  plist_src="$last_stack/launchd/${label}.plist"
fi
plist_dst="${LAST_STACK_REGISTRY_APPLY_PROOF_PLIST:-$HOME/Library/LaunchAgents/${label}.plist}"
cmd="${1:-status}"

install_agent() {
  chmod +x "$last_stack/bin/$program" 2>/dev/null || true
  [ -e "$last_stack/bin/$program" ] || [ -x "$self_root/bin/$program" ] || {
    echo "missing $last_stack/bin/$program" >&2
    exit 1
  }
  [ -f "$plist_src" ] || {
    echo "missing $plist_src" >&2
    exit 1
  }
  mkdir -p "$(dirname "$plist_dst")"
  mkdir -p "$HOME/Library/Logs"
  rendered="$(mktemp "${TMPDIR:-/tmp}/last-stack-registry-apply-proof.plist.XXXXXX")"
  last_stack_agent_render_plist "$plist_src" "$rendered" "$last_stack"
  last_stack_agent_commit_plist \
    "$label" "$plist_dst" "$rendered" "last-stack-registry-apply-proof"
}

uninstall_agent() {
  last_stack_agent_uninstall "$label" "$plist_dst" "last-stack-registry-apply-proof"
}

status_agent() {
  echo "bin: $last_stack/bin/$program"
  echo "plist: $plist_dst"
  if [ -f "$plist_dst" ]; then
    echo "plist: present"
    plist_program="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$plist_dst" 2>/dev/null || true)"
    echo "program: ${plist_program:-unknown}"
    case "$plist_program" in
      */artifacts/versions/*) echo "program: VERSION-PINNED (will re-toast on refresh)" ;;
    esac
  else
    echo "plist: missing"
  fi
  if last_stack_agent_should_touch_launchd "$plist_dst" && command -v launchctl >/dev/null 2>&1; then
    uid="$(id -u)"
    launchctl print "gui/${uid}/${label}" 2>/dev/null | head -25 || echo "launchctl: not loaded"
  else
    echo "launchctl: skipped"
  fi
  if [ -f "$HOME/Library/Logs/last-stack-registry-apply-proof.out.log" ]; then
    echo "--- last log ---"
    tail -8 "$HOME/Library/Logs/last-stack-registry-apply-proof.out.log" || true
  fi
}

proof_agent() {
  if [ ! -f "$plist_dst" ]; then
    echo "proof: missing plist $plist_dst" >&2
    return 1
  fi
  plist_program="$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$plist_dst" 2>/dev/null || true)"
  if [ "$plist_program" != "$last_stack/bin/$program" ]; then
    echo "proof: unexpected program=${plist_program:-missing} expected=$last_stack/bin/$program" >&2
    return 1
  fi
  if last_stack_agent_should_touch_launchd "$plist_dst"; then
    if ! command -v launchctl >/dev/null 2>&1; then
      echo "proof: launchctl unavailable" >&2
      return 1
    fi
    uid="$(id -u)"
    if ! launchctl print "gui/${uid}/${label}" >/dev/null 2>&1; then
      echo "proof: service not loaded label=$label" >&2
      return 1
    fi
  fi
  echo "proof: ok label=$label program=$plist_program"
}

case "$cmd" in
  install) install_agent ;;
  uninstall) uninstall_agent ;;
  status) status_agent ;;
  proof) proof_agent ;;
  run-once)
    if [ -x "$last_stack/bin/$program" ]; then
      exec "$last_stack/bin/$program" --latest "${@:2}"
    fi
    exec "$self_root/bin/$program" --latest "${@:2}"
    ;;
  -h|--help) awk 'NR == 1 { next } /^#/ { print; next } { exit }' "$0" ;;
  *) echo "usage: $0 install|uninstall|status|proof|run-once" >&2; exit 2 ;;
esac
