#!/usr/bin/env python3
"""Read collected Card keys with the public authenticated raw23 batch CLI.

Legacy stdout is a complete stored-field array. Envelope mode keeps exact
snapshot bytes and explicit missing items. No derived fields or fallback.
"""
import argparse
import json
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'lib'))
from factory_repair import Refusal, public_card_batch, validate_snapshot, MAX_KEYS, read_bytes, set_deadline

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('slug', nargs='*'); parser.add_argument('--slugs')
    parser.add_argument('--slugs-file', type=Path)
    parser.add_argument('--board-cli', default=str(Path.home() / '.local/bin/kanban'))
    parser.add_argument('--chunk', type=int, default=256)
    parser.add_argument('--snapshot-envelope', action='store_true')
    parser.add_argument('--socket', help=argparse.SUPPRESS)
    args = parser.parse_args(); set_deadline(120)
    try:
        if args.socket:
            raise Refusal('socket override is unsupported; use public CLI config')
        keys = list(args.slug)
        if args.slugs:
            keys += args.slugs.split(',')
        if args.slugs_file:
            keys += read_bytes(args.slugs_file, 1024 * 1024).decode('utf-8').splitlines()
        keys = list(dict.fromkeys(k.strip() for k in keys if k.strip()))
        if len(keys) > MAX_KEYS:
            raise Refusal('collected Card key limit')
        reply = public_card_batch(args.board_cli, keys, args.chunk)
        if args.snapshot_envelope:
            result = reply
        else:
            if any(item.get('missing') is True for item in reply['items']):
                raise Refusal('canonical Card missing; no partial record array')
            result = [validate_snapshot(item, item['slug'])['fields'] for item in reply['items']]
    except (Refusal, OSError, ValueError, KeyError, TypeError) as error:
        print('kanban-show-batch: ' + str(error), file=sys.stderr); return 1
    print(json.dumps(result, ensure_ascii=False))
    print(f'kanban-show-batch n={len(keys)} via=public-guarded-snapshot chunks={(len(keys) + args.chunk - 1) // args.chunk}', file=sys.stderr)
    return 0

if __name__ == '__main__':
    sys.exit(main())
