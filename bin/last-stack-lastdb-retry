#!/usr/bin/env bash
# Retry a LastDB-backed CLI a few times on transient socket/busy flaps.
#
# Usage:
#   last-stack-lastdb-retry [--attempts N] [--sleep-ms MS] -- <command> [args...]
#
# Retries ONLY transient LastDB backpressure / socket blips. Does NOT retry:
#   - max_outbox_entries (structural; needs outbox drain, not thrash)
#   - rate-limit / 429 (agent must stop)
#   - claim_conflict / successful non-zero business outcomes
#
# persist_queue_full IS transient. The node answers it with
# `"retryable":true` and `retry after drain`, and the queue drains on its own.
# The bounded post-ack capture queue is the same backpressure typed differently:
# `HTTP 400 Invalid data: ... mutation capture queue remained full for 100ms;
# retry before local commit`. No 503 and no `"retryable": true`, so it must be
# matched on its own text or it reads as a structural reject.
# It was missing from the matcher until 2026-08-27, so a caller that asked for
# 30 attempts got exactly one
# (papercut-last-stack-lastdb-retry-does-not-match-persist-queue-full).
#
# Default wait is the shared drain-aware schedule in lib/lastdb-retry-schedule.sh
# (15s, 45s, 90s, 120s; 5 attempts). --sleep-ms keeps a fixed millisecond sleep
# for callers that already pass it (pickup claim uses --attempts 3 --sleep-ms 750).
#
# Exit: propagates the last command exit code. On final failure after retries
# still returns that exit code (caller decides noop vs error).

set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
# shellcheck source=lib/lastdb-retry-schedule.sh
. "$ROOT/lib/lastdb-retry-schedule.sh"

attempts="$(last_stack_lastdb_retry_default_attempts)"
sleep_ms=""

usage() {
  cat <<'EOF'
Usage: last-stack-lastdb-retry [--attempts N] [--sleep-ms MS] -- <command> [args...]

Run <command> with up to N attempts (default 5) when stderr/stdout match
transient LastDB flap signals. Default sleep is the drain-aware schedule
15s,45s,90s,120s (LAST_STACK_LASTDB_RETRY_SCHEDULE_SEC). --sleep-ms sets a
fixed millisecond sleep instead. Never restarts lastdbd. Never retries
max_outbox_entries.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --attempts)
      attempts="${2:?}"
      shift 2
      ;;
    --sleep-ms)
      sleep_ms="${2:?}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      # allow bare command without --
      break
      ;;
  esac
done

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

# Patterns that mean "try again shortly" (node busy / socket blip / brief UDS pressure).
is_transient_flap() {
  local text="$1"
  printf '%s' "$text" | grep -Eiq \
    'service_timeout|node did not respond|too many concurrent reads|uds_connection_limit|connection refused|Was there a typo in the url or port|ECONNRESET|EPIPE|[Bb]roken pipe|os error 32|socket.*(gone|unavailable|unreachable)|temporarily at capacity|resource has been exhausted|persist_queue_full|persist queue full|retry after drain|capture queue remained full|retry before local commit|"retryable":[[:space:]]*true' \
    || return 1
  # Structural write reject — do not thrash
  if printf '%s' "$text" | grep -Eiq 'max_outbox_entries|lastdb-sync-outbox-full|outbox.?full'; then
    return 1
  fi
  # Agent rate limit — do not thrash
  if printf '%s' "$text" | grep -Eiq 'rate.?limit|429|limit reached'; then
    return 1
  fi
  return 0
}

attempt=1
last_rc=1
combined=""
cumulative_wait=0
ended_reason=""

while [ "$attempt" -le "$attempts" ]; do
  tmp_out="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  tmp_err="$(mktemp "${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/last-stack.XXXXXX")"
  set +e
  "$@" >"$tmp_out" 2>"$tmp_err"
  last_rc=$?
  set -e
  out="$(cat "$tmp_out")"
  err="$(cat "$tmp_err")"
  rm -f "$tmp_out" "$tmp_err"
  combined="${out}${err}"

  if [ "$last_rc" -eq 0 ]; then
    if [ "$attempt" -gt 1 ]; then
      printf 'last-stack-lastdb-retry: succeeded after %s drain wait(s) cumulative=%ss answer=ok\n' \
        "$((attempt - 1))" "$cumulative_wait" >&2
    fi
    printf '%s' "$out"
    [ -n "$err" ] && printf '%s' "$err" >&2
    exit 0
  fi

  if [ "$attempt" -lt "$attempts" ] && is_transient_flap "$combined"; then
    ended_reason="$(last_stack_lastdb_retry_reason "$combined")"
    if [ -n "$sleep_ms" ]; then
      printf 'last-stack-lastdb-retry: drain wait attempt=%s/%s sleep=%sms reason=%s\n' \
        "$((attempt + 1))" "$attempts" "$sleep_ms" "$ended_reason" >&2
      if command -v python3 >/dev/null 2>&1; then
        python3 -c "import time; time.sleep(max(0, int('${sleep_ms}'))/1000.0)"
      else
        sleep 1
      fi
      case "$sleep_ms" in
        ''|*[!0-9]*) ;;
        *) cumulative_wait=$((cumulative_wait + (sleep_ms / 1000))) ;;
      esac
      attempt=$((attempt + 1))
      continue
    fi
    sleep_sec="$(last_stack_lastdb_retry_sleep_sec "$attempt")"
    capped="$(last_stack_lastdb_retry_capped_sleep_sec "$sleep_sec")"
    if [ "$capped" -lt 1 ] && [ "$sleep_sec" -gt 0 ]; then
      printf 'last-stack-lastdb-retry: deadline won remaining wait=%ss answer=%s cumulative=%ss\n' \
        "$sleep_sec" "$ended_reason" "$cumulative_wait" >&2
      printf '%s' "$out"
      [ -n "$err" ] && printf '%s' "$err" >&2
      exit "$last_rc"
    fi
    cumulative_wait=$((cumulative_wait + capped))
    printf 'last-stack-lastdb-retry: drain wait attempt=%s/%s sleep=%ss cumulative=%ss reason=%s\n' \
      "$((attempt + 1))" "$attempts" "$capped" "$cumulative_wait" "$ended_reason" >&2
    last_stack_lastdb_retry_wait "$capped"
    attempt=$((attempt + 1))
    continue
  fi

  if [ -n "$combined" ]; then
    ended_reason="$(last_stack_lastdb_retry_reason "$combined")"
  fi
  if [ "$attempt" -gt 1 ]; then
    printf 'last-stack-lastdb-retry: ended rc=%s after %s attempt(s) cumulative=%ss answer=%s\n' \
      "$last_rc" "$attempt" "$cumulative_wait" "${ended_reason:-unknown}" >&2
  fi
  printf '%s' "$out"
  [ -n "$err" ] && printf '%s' "$err" >&2
  exit "$last_rc"
done

exit "$last_rc"
