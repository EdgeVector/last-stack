#!/usr/bin/env python3
"""Forgejo open-PR inventory and the ONE per-PR papercut ledger for pipeline-health.

Why this exists (2026-09-22 papercut burn-down): the pipeline-health routine
hand-wrote a shell loop every wake to read Forgejo PR state, and filed a new
papercut per observed STATE. One PR produced up to five open p0 rows
(`...-pr-2147`, `-pending`, `-failure`, `-required-checks`, ...), none of which
closed when the PR merged. The loops themselves broke on zsh word splitting
and malformed API paths about once a run. Of 82 open pipeline rows, ~55 were
per-PR state records like these.

This helper replaces both:

  scan   Read-only. One JSON document: every open PR on the merge-demand repo
         list, with its required-check verdict (read from branch protection),
         mergeability, age, and whether the BASE branch tip is itself red on
         the same required contexts.

  sync   scan, then reconcile the ledger (dry run unless --apply):
         - a stuck PR is keyed by repo + PR number:
             papercut-pipeline-forge-<repo>-pr-<n>
           one slug per PR, never per state. An open record gets ONE appended
           evidence line when the head or the verdict changes; otherwise it is
           left alone.
         - a PR that is red only on contexts that are ALSO red on the base tip
           is not a PR defect. It is attributed to the per-repo root-cause row
             papercut-pipeline-forge-<repo>-main-red
           and no per-PR row is written.
         - a required context the forge CANCELLED is shape `cancelled`, never
           `red`. It is still stuck (the merge is blocked and nothing re-runs
           the run on its own), but it is NOT a product failure: no test
           failed, so it is never attributed to a red main and its row names a
           re-run as the remedy. See CANCELLED.
         - a green, mergeable PR that nobody armed for auto-merge is not a PR
           defect either: nobody asked for the merge. It is RECORDED in the
           heartbeat as `green_unarmed=` and in the actions as
           `action=green-unarmed`, and no row is written. Its owner is the
           card's `needs_human` decision, not this ledger. See merge_intent().
           This only applies when the repo is not policy-held: an unarmed
           green PR on a repo a Situation blocks for merge-pr is
           `policy-blocked` instead, same as an armed one, so `policy_hold`
           is visible without a second preflight call
           (papercut-pipeline-ledger-p0-for-situation-held-pr-20260925).
         - the SEVERITY of a filed row comes from its shape, not from a
           constant: `p0` only for a conflict or a red main, which cannot
           resolve unless somebody acts; `p1` for a red, cancelled, pending or
           armed-green row, which often clears on its own. Severity cannot be
           amended after a filing, so the evidence line carries `passes=<n>`,
           the number of consecutive passes that fingerprint has survived. See
           row_severity().
         - every row this helper tracks is closed `verified` with a live point
           read once its PR is merged or closed, or (main-red rows) once the
           base tip is green on every required context.

  merge-green  One PR. Bounded "merge when green" fallback: Forgejo 15.0.3
         never fires an auto-merge armed after the required check went green.
         Merges an ARMED green PR directly after --grace-sec (dry run unless
         --apply; --arm also merges an unarmed green PR).
         Refuses before any read or write when
         `situations preflight --action merge-pr --repo <repo>` does not answer
         OK: verdict `situations-blocked` (an active Situation forbids it) or
         `situations-unreadable` (policy unreadable, so it fails closed), exit 3
         for both, with the blocking slug rendered in JSON and text.

LastGit is not read. It is disabled for every EdgeVector repo
(decision-2026-09-06-all-repos-venue-forgejo-no-lastgit-default).
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import concurrent.futures
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

HERE = Path(__file__).resolve().parent
DEFAULT_REPOS_FILE = HERE.parent / "config" / "merge-demand-forge-repos"
FALLBACK_REPOS = [
    "EdgeVector/fold",
    "EdgeVector/lastgit",
    "EdgeVector/exemem-infra",
    "EdgeVector/last-stack",
    "EdgeVector/fkanban",
    "EdgeVector/routines",
    "EdgeVector/loom",
]
DEFAULT_REQUIRED = ["Forge CI / ci-required"]
RED = {"failure", "error"}
EVENT_SUFFIX = re.compile(r"\s+\((pull_request|push|pull_request_target)\)$")

# A run the forge CANCELLED is stored on the commit as a plain `failure` whose
# description reads "Has been cancelled". The status VALUE is identical to a
# real red, so before 2026-09-26 every consumer of this helper read a red the
# commit never earned: on 2026-09-25, 7 of the latest 40 first-parent commits on
# EdgeVector/fold main were red on `Forge CI / ci-required` with no failing
# test, because ci.yml shares one concurrency group across the whole ref and a
# later merge cancels the earlier commit's run
# (papercut-fold-ci-required-cancelled-run-stored-as-a-required-red-20260925).
#
# A cancellation is NOT green — branch protection still blocks the merge — so it
# cannot be folded into success. It is a THIRD state, because its remedy is a
# different action: re-run the run. A product red means read the logs and change
# code. `context_states` maps it to CANCELLED so the distinction reaches every
# caller instead of being thrown away at the first read.
CANCELLED = "cancelled"
CANCELLED_DESC = re.compile(r"cancel", re.I)

# Severity is chosen once, at file time: `brain papercut` has no verb that amends
# a header column afterwards, and re-filing the same slug is refused by the
# dedupe gate as an exact self-duplicate
# (papercut-brain-papercut-has-no-verb-to-amend-a-header-column-after-filing-20260926).
# So the value has to be right on the FIRST pass, and the split that survives
# that constraint is by SHAPE: does this row name something that cannot resolve
# unless somebody acts on it?
#
# STRUCTURAL — does not self-heal, and its blast radius is not one PR:
#   conflict   the head needs a rebase; no re-run and no wait clears it.
#   base-red   the base tip is red, so every open PR in the repo inherits it.
# TRANSIENT — everything else a pass can call stuck: a red that may be a flake on
# a loaded host, a cancelled run whose remedy is a re-run, a context still queued
# behind a congested lane, a green PR waiting on the completer.
#
# Filing every per-PR row at p0 made `papercut-p0-active` — the fleet's only
# drop-everything signal — continuously true for states no agent could act on:
# six distinct p0 rows inside 40 minutes on EdgeVector/last-stack on 2026-09-26,
# none naming a durable defect, and the band a triaging agent ranks on never held
# the same contents twice
# (papercut-pipeline-ledger-p0-per-stuck-pr-floods-the-priority-band-20260926).
STRUCTURAL_SHAPES = {"conflict"}
SEVERITY_STRUCTURAL = "p0"
SEVERITY_TRANSIENT = "p1"


def row_severity(pr: dict[str, Any]) -> str:
    """p0 for a row that cannot resolve without action, p1 for a transient state.

    NOT escalated later. A transient red that persists is still p1, because the
    severity column is immutable after the filing; what the pass records instead
    is `passes=<n>` on the evidence line, so a reader can tell a flake from a
    wedged lane. When an amend verb exists, escalation keys on that counter.
    """
    if pr.get("root_cause") == "base-red":
        return SEVERITY_STRUCTURAL
    if pr.get("shape") in STRUCTURAL_SHAPES:
        return SEVERITY_STRUCTURAL
    return SEVERITY_TRANSIENT


def now_utc() -> dt.datetime:
    fixed = os.environ.get("LAST_STACK_PR_LEDGER_NOW")
    if fixed:
        return parse_ts(fixed) or dt.datetime.now(dt.timezone.utc)
    return dt.datetime.now(dt.timezone.utc)


def iso(ts: dt.datetime) -> str:
    return ts.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(raw: Any) -> dt.datetime | None:
    if not raw or not isinstance(raw, str):
        return None
    try:
        return dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError:
        return None


def run(argv: list[str], *, stdin: str | None = None, timeout: int = 60) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(argv, input=stdin, text=True, capture_output=True, check=False, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"timeout after {timeout}s")
    except FileNotFoundError as exc:
        return subprocess.CompletedProcess(argv, 127, "", str(exc))


def forge_api_bin() -> str:
    env = os.environ.get("LAST_STACK_FORGE_API")
    if env:
        return env
    sibling = HERE / "last-stack-forge-api"
    return str(sibling) if sibling.exists() else "last-stack-forge-api"


def situations_bin() -> str:
    env = os.environ.get("LAST_STACK_SITUATIONS_BIN")
    if env:
        return env
    if shutil.which("situations"):
        return "situations"
    # A sandboxed agent shell can lose ~/.local/bin from PATH; that is not a host
    # without a policy store.
    local = Path(os.path.expanduser("~/.local/bin/situations"))
    return str(local) if local.exists() else ""


def merge_policy(repo: str) -> tuple[str, str]:
    """Is a merge to `repo` allowed right now? ("ok"|"blocked"|"unreadable", detail).

    `bin/last-stack-forge-api` refuses the merge POST itself since last-stack#203,
    so this is not the only gate and it is not a duplicate of it either. Without
    it, merge_green_once on a blocked repo runs this sequence:

        DELETE .../merge     cancels the owner's armed schedule  (NOT guarded,
                             on purpose: a cancel must stay possible under a hold)
        POST   .../merge     REFUSED by the wrapper -> verdict `merge-failed`
        POST   .../merge     the recovery re-arm, ALSO refused by the wrapper

    which cancels the schedule, does not merge, and then cannot put the schedule
    back. It leaves the PR in a worse state than it found it and reports an
    opaque `merge-failed` while doing so. Asking first turns all three writes
    into one read and one honest verdict.

    History: on 2026-09-25 three EdgeVector/loom PRs merged under an active p0
    hold that named merge-pr in `blocked_actions` and EdgeVector/loom in
    `scope_repos`; host-track then advanced 10 commits and re-absorbed the schema
    regression the hold existed to keep out
    (papercut-incident-pipeline-health-loom-pr60-merge-violates-active-hold-20260925).

    "unreadable" is not "ok" here. The wrapper fails open on a preflight that
    cannot run, so that a broken install cannot stop every merge on the forge;
    this caller is a scheduled repair verb with no operator watching, its writes
    are exactly the ones a hold exists to stop, and the workspace rule for a
    shared-system mutation with no readable preflight is to stay read-only. A
    host with no `situations` binary at all has no policy store to consult and
    reads "ok" with a detail that says so.
    """
    sit = situations_bin()
    if not sit:
        return "ok", "no situations binary on this host; merge-pr policy unchecked"
    proc = run([sit, "preflight", "--action", "merge-pr", "--repo", repo, "--field", "slug,reason"], timeout=60)
    if proc.returncode == 0:
        return "ok", ""
    detail = ((proc.stdout or "") + (proc.stderr or "")).strip()[:300]
    if proc.returncode == 3:
        return "blocked", detail or "preflight exited 3 with no rows"
    return "unreadable", f"preflight exited {proc.returncode}: {detail}"


def policy_slug(detail: str) -> str:
    """The Situation slug out of a `merge_policy` "blocked" detail, or "".

    `situations preflight --field slug,reason` prints one TSV row per blocking
    Situation. A refusal has to name what refused it — `policy-blocked` alone
    sends the reader back to preflight to find out which hold applies, and the
    slug is the one thing they need in order to cite it or clear it.
    """
    first = (detail or "").strip().splitlines()[0] if (detail or "").strip() else ""
    token = first.split("\t")[0].strip() if first else ""
    return token if re.fullmatch(r"[a-z0-9][a-z0-9-]*", token or "") else ""


class ForgeError(RuntimeError):
    pass


def forge_get(path: str) -> Any:
    proc = run([forge_api_bin(), path], timeout=45)
    if proc.returncode != 0:
        raise ForgeError(f"{path}: rc={proc.returncode} {(proc.stderr or proc.stdout).strip()[:300]}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise ForgeError(f"{path}: invalid json ({exc})") from exc


def load_repos(args: argparse.Namespace) -> list[str]:
    if args.repo:
        return [r if "/" in r else f"EdgeVector/{r}" for r in args.repo]
    env = os.environ.get("LAST_STACK_MERGE_DEMAND_FORGE_REPOS", "").split()
    if env:
        return [r if "/" in r else f"EdgeVector/{r}" for r in env]
    path = Path(args.repos_file)
    if path.is_file():
        repos = [ln.strip() for ln in path.read_text().splitlines() if ln.strip() and not ln.lstrip().startswith("#")]
        if repos:
            return repos
    return list(FALLBACK_REPOS)


def stem(context: str) -> str:
    return EVENT_SUFFIX.sub("", context or "").strip()


def required_contexts(repo: str, branch: str) -> list[str]:
    try:
        rules = forge_get(f"repos/{repo}/branch_protections")
    except ForgeError:
        return list(DEFAULT_REQUIRED)
    if isinstance(rules, list):
        for rule in rules:
            if not isinstance(rule, dict):
                continue
            name = rule.get("rule_name") or rule.get("branch_name") or ""
            if name == branch and rule.get("enable_status_check", True):
                ctxs = sorted({stem(c) for c in (rule.get("status_check_contexts") or []) if c})
                if ctxs:
                    return ctxs
    return list(DEFAULT_REQUIRED)


def context_states(status_doc: Any) -> dict[str, str]:
    """Latest state per context stem from a combined-status document.

    A red whose DESCRIPTION says the run was cancelled is reported as
    CANCELLED, not as its raw `failure`. The forge stores both with the same
    status value and only the description tells them apart, so this is the one
    place that can make the distinction — see CANCELLED above.
    """
    out: dict[str, tuple[str, str]] = {}
    statuses = status_doc.get("statuses") if isinstance(status_doc, dict) else None
    for row in statuses or []:
        if not isinstance(row, dict):
            continue
        key = stem(row.get("context") or "")
        state = str(row.get("status") or row.get("state") or "").lower()
        when = str(row.get("updated_at") or row.get("created_at") or "")
        if state in RED and CANCELLED_DESC.search(str(row.get("description") or "")):
            state = CANCELLED
        if key and (key not in out or when >= out[key][1]):
            out[key] = (state, when)
    return {k: v[0] for k, v in out.items()}


def required_verdict(states: dict[str, str], required: list[str]) -> tuple[str, list[str], list[str]]:
    """(verdict, product-red contexts, cancelled contexts).

    A product red outranks a cancellation: a commit that has both earned the
    red, and the cancellation is not what a reader needs to act on. A commit
    whose ONLY reds are cancellations gets the verdict `cancelled` and an EMPTY
    red list, which is what keeps it out of every "main is red" attribution
    downstream. It is still not green, so nothing treats it as mergeable.
    """
    red = [c for c in required if states.get(c) in RED]
    cancelled = [c for c in required if states.get(c) == CANCELLED]
    if red:
        return "red", red, cancelled
    if cancelled:
        return CANCELLED, [], cancelled
    if any(c not in states for c in required):
        return "absent", [], []
    if all(states.get(c) == "success" for c in required):
        return "green", [], []
    return "pending", [], []


def repo_token(repo: str) -> str:
    return re.sub(r"[^a-z0-9-]+", "-", repo.rsplit("/", 1)[-1].lower()).strip("-")


def merge_intent(repo: str, number: int) -> str:
    """Does anybody want this green PR merged? "armed" | "unarmed" | "unknown".

    A green, mergeable, UNARMED PR is not a pipeline defect: nobody asked for
    the merge. The state is produced on purpose — a loom land-card execution
    that parked because its review escalated at cap, a proof still in flight, a
    PR held for a human decision — and the board carries it as the owning card's
    `needs_human` block reason. Filing a p0 pipeline row for it puts a
    deliberate park at the top of the factory's priority queue, and the row can
    never close, because nothing will merge the PR. `merge-green` already makes
    exactly this judgment for the same PR (verdict `green-not-armed`, "Nobody
    asked for a merge"); before 2026-09-25 the stuck classifier did not, so the
    two halves of this helper disagreed about one PR.

    "armed" is the real defect: Forgejo 15.0.3 never fires a schedule armed
    after the last required status went green
    (papercut-forgejo-auto-merge-armed-after-green-never-fires-20260923), and
    `merge-green --apply` is its repair.

    Who owns an unarmed green PR instead of this ledger: `pr-reaper`, whose
    1-hour open-PR SLA (Tom directive 2026-07-19) drives ANY PR open past 60
    minutes to a terminal state — merged when it is green and mergeable, closed
    otherwise, with no class exempt by age. That is why `may_merge` in the reap
    plan is deliberately NOT gated on this value: the reaper's job does not
    change. Only the papercut ledger's does. The board carries the same PR a
    second time, as the owning card's `needs_human` block reason when a loom
    execution parked it.

    A timeline read that fails answers "unknown", which stays stuck: an
    unreadable probe must not silence a row.
    """
    try:
        armed, _ = schedule_state(repo, number)
    except ForgeError:
        return "unknown"
    return "armed" if armed else "unarmed"


def pr_slug(repo: str, number: int) -> str:
    return f"papercut-pipeline-forge-{repo_token(repo)}-pr-{number}"


DEFAULT_ROOT_CAUSES_FILE = HERE.parent / "config" / "pipeline-known-root-causes.tsv"


def load_known_root_causes(path: str) -> list[tuple[str, str, str]]:
    """(repo, required-context stem, papercut slug) rows; '#' comments allowed."""
    rows: list[tuple[str, str, str]] = []
    try:
        text = Path(path).read_text()
    except OSError:
        return rows
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = [x.strip() for x in line.split("\t")]
        if len(parts) >= 3 and all(parts[:3]):
            rows.append((parts[0], stem(parts[1]), parts[2]))
    return rows


def main_red_slug(repo: str) -> str:
    return f"papercut-pipeline-forge-{repo_token(repo)}-main-red"


def read_base(repo: str, base_ref: str) -> dict[str, Any]:
    required = required_contexts(repo, base_ref)
    base_sha, base_states = "", {}
    try:
        branch = forge_get(f"repos/{repo}/branches/{base_ref}")
        base_sha = ((branch or {}).get("commit") or {}).get("id") or ""
        if base_sha:
            base_states = context_states(forge_get(f"repos/{repo}/commits/{base_sha}/status"))
    except ForgeError:
        pass
    verdict, red, cancelled = (
        required_verdict(base_states, required) if base_sha else ("unreadable", [], [])
    )
    return {"ref": base_ref, "sha": base_sha, "required": required, "verdict": verdict,
            "red_contexts": red, "cancelled_contexts": cancelled}


def heartbeat_fields(report: dict[str, Any]) -> str:
    """One ready-made heartbeat fragment, so the routine never composes jq
    string interpolation (it failed four times on 2026-09-23 under the
    harness's zsh -lc quoting: papercut-pipeline-health-jq-stuck-summary-filter)."""
    stuck = [f"{p['repo'].rsplit('/', 1)[-1]}#{p['number']}" for p in report.get("prs", []) if p.get("stuck")]
    fields = [
        f"open_forge={len(report.get('prs', []))}",
        f"stuck={len(stuck)}",
        f"stuck_prs={','.join(stuck) or '-'}",
        f"unreadable={','.join(u['repo'].rsplit('/', 1)[-1] for u in report.get('unreadable', [])) or '-'}",
    ]
    # Recorded, not filed: a green PR nobody armed is the owning card's
    # needs_human decision, so the heartbeat names it and no p0 row is written.
    unarmed = [f"{p['repo'].rsplit('/', 1)[-1]}#{p['number']}" for p in report.get("prs", []) if p.get("stuck_excluded") == "green-unarmed"]
    if unarmed:
        fields.append(f"green_unarmed={','.join(unarmed)}")
    # Recorded, not filed: the repo is under a Situation that blocks merge-pr,
    # so "merge it" is not an action any agent may take. Name the PRs and the
    # holds, so the pass is auditable without a per-PR p0 row.
    held = [f"{p['repo'].rsplit('/', 1)[-1]}#{p['number']}" for p in report.get("prs", []) if p.get("stuck_excluded") == "policy-blocked"]
    if held:
        holds = sorted({p.get("policy_hold") or "-" for p in report.get("prs", []) if p.get("stuck_excluded") == "policy-blocked"})
        fields.append(f"policy_blocked={','.join(held)}")
        fields.append(f"policy_holds={','.join(holds)}")
    ledger = report.get("ledger")
    if ledger:
        counts: dict[str, int] = {}
        for a in ledger.get("actions", []):
            counts[a["action"]] = counts.get(a["action"], 0) + 1
        filed = [a["slug"] for a in ledger.get("actions", []) if a["action"] == "file" and a.get("ok")]
        updated = [a["slug"] for a in ledger.get("actions", []) if a["action"] == "append" and a.get("ok")]
        closed = [a["slug"] for a in ledger.get("actions", []) if a["action"] == "close" and a.get("ok")]
        fields += [
            f"filed_papercut={','.join(filed) or '-'}",
            f"updated_papercut={','.join(updated) or '-'}",
            f"closed_papercut={','.join(closed) or '-'}",
        ]
        if counts.get("skip-busy"):
            fields.append(f"brain_busy={counts['skip-busy']}")
    return " ".join(fields)


def scan_repo(repo: str, args: argparse.Namespace, now: dt.datetime) -> tuple[dict[str, Any] | None, list[dict[str, Any]], list[dict[str, Any]]]:
    """One repo's open PRs and base verdicts. Pure reads; safe to run in parallel."""
    prs: list[dict[str, Any]] = []
    try:
        pulls = forge_get(f"repos/{repo}/pulls?state=open&limit=50")
    except ForgeError as exc:
        return None, [], [{"repo": repo, "error": str(exc)}]
    if not isinstance(pulls, list):
        return None, [], [{"repo": repo, "error": "pulls response is not a list"}]
    base_cache: dict[str, dict[str, Any]] = {}
    repo_row = {"repo": repo, "open": 0, "base": {}}
    # Prefetch every open head's combined status in parallel (one forge-api
    # spawn each); the loop below then reads from this map.
    heads = sorted({(pr.get("head") or {}).get("sha") or "" for pr in pulls
                    if isinstance(pr, dict) and pr.get("state") == "open"} - {""})

    def fetch_status(sha: str) -> tuple[str, Any, str]:
        try:
            return sha, forge_get(f"repos/{repo}/commits/{sha}/status"), ""
        except ForgeError as exc:
            return sha, None, str(exc)

    status_by_head: dict[str, tuple[Any, str]] = {}
    if heads:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(6, len(heads))) as pool:
            for sha, doc, err in pool.map(fetch_status, heads):
                status_by_head[sha] = (doc, err)

    policy_cache: list[tuple[str, str]] = []

    def repo_merge_policy() -> tuple[str, str]:
        """`merge_policy(repo)`, once per repo per pass, lazily.

        Lazy because most repos have no green unmerged PR on any given pass and
        the call spawns `situations`; cached because `scan_repo` may see several
        green PRs in one repo and the answer is a property of the repo.
        """
        if not policy_cache:
            policy_cache.append(merge_policy(repo))
        return policy_cache[0]

    for pr in pulls:
        if not isinstance(pr, dict) or pr.get("state") != "open":
            continue
        repo_row["open"] += 1
        number = int(pr.get("number") or 0)
        head = (pr.get("head") or {}).get("sha") or ""
        base_ref = (pr.get("base") or {}).get("ref") or "main"
        if base_ref not in base_cache:
            base_cache[base_ref] = read_base(repo, base_ref)
            repo_row["base"][base_ref] = base_cache[base_ref]
        base = base_cache[base_ref]
        states: dict[str, str] = {}
        status_error = ""
        if head:
            doc, err = status_by_head.get(head, (None, "status not fetched"))
            if err:
                status_error = err
            else:
                states = context_states(doc)
        verdict, red, cancelled = required_verdict(states, base["required"])
        if status_error:
            verdict = "unreadable"
        mergeable = pr.get("mergeable")
        updated = parse_ts(pr.get("updated_at"))
        created = parse_ts(pr.get("created_at"))
        age_min = int((now - created).total_seconds() // 60) if created else None
        idle_min = int((now - updated).total_seconds() // 60) if updated else None
        if pr.get("draft"):
            shape = "draft"
        elif mergeable is False:
            shape = "conflict"
        elif verdict == "red":
            shape = "red"
        elif verdict == CANCELLED:
            # Not `red`: no product failure to read logs for, and no main-red
            # attribution below, because base["verdict"] is `cancelled` too when
            # the base tip's only reds are cancellations. Still stuck — the
            # merge is blocked and nothing re-runs the run on its own.
            shape = CANCELLED
        elif verdict == "green":
            shape = "green-unmerged"
        else:
            shape = verdict  # pending | absent | unreadable
        stuck = False
        over_age = age_min is not None and age_min >= args.min_age_min
        # "" — the field does not apply (this PR is not green).
        # "not-read" — green but under --min-age-min, so the answer cannot
        #              change any verdict this pass and the read is skipped.
        intent = "" if shape != "green-unmerged" else ("not-read" if not over_age else merge_intent(repo, number))
        # A held repo does not make a broken CI lane less broken, so `red`,
        # `conflict` and `pending` are classified without asking about policy.
        # Their implied remedy — read the logs, draft a fix, open a PR — is
        # inside the loom hold's own `allowed_actions`. Only `green-unmerged`
        # implies the one remedy a merge-pr block forbids.
        policy, policy_detail, policy_hold = "", "", ""
        if over_age and shape in {"conflict", "red", CANCELLED}:
            stuck = True
        if over_age and shape == "green-unmerged":
            # Read the policy regardless of arm state: an unarmed PR under a
            # held repo still needs `policy_hold` set, or the row reads as an
            # ordinary re-arm candidate to an agent that trusts `shape` alone
            # (papercut-pipeline-ledger-p0-for-situation-held-pr-20260925,
            # confirmed 6x on 2026-09-26 before this fix).
            policy, policy_detail = repo_merge_policy()
            policy_hold = policy_slug(policy_detail) if policy == "blocked" else ""
            if intent != "unarmed":
                # Fail OPEN, the opposite of `merge_green_once`. A filing writes
                # nothing to the forge, so suppressing a genuine stuck-PR signal
                # because the policy store was busy loses information for no gain;
                # a merge under an unreadable hold is the loss that matters. The
                # asymmetry is deliberate. Unarmed PRs never file (see
                # `stuck_excluded` below), so `stuck` stays untouched for them.
                stuck = policy != "blocked"
        if idle_min is not None and idle_min >= args.pending_stale_min and shape in {"pending", "absent"}:
            stuck = True
        root_cause = ""
        if shape == "red" and red and base["verdict"] == "red" and set(red) <= set(base["red_contexts"]):
            root_cause = "base-red"
        prs.append(
            {
                "repo": repo,
                "number": number,
                "title": pr.get("title") or "",
                "head_sha": head,
                "head_ref": (pr.get("head") or {}).get("ref") or "",
                "base_ref": base_ref,
                "mergeable": mergeable,
                "age_min": age_min,
                "idle_min": idle_min,
                "required": {c: states.get(c, "absent") for c in base["required"]},
                "red_contexts": red,
                "cancelled_contexts": cancelled,
                "shape": shape,
                "merge_intent": intent,
                "merge_policy": policy,
                "policy_hold": policy_hold,
                "stuck_excluded": (
                    "policy-blocked" if policy == "blocked"
                    else "green-unarmed" if (over_age and shape == "green-unmerged" and intent == "unarmed")
                    else ""
                ),
                "stuck": stuck,
                "root_cause": root_cause,
                "ledger_slug": main_red_slug(repo) if root_cause else pr_slug(repo, number),
                "status_error": status_error,
            }
        )
    if "main" not in base_cache:
        # main-red rows close on a green main even when no PR is open.
        repo_row["base"]["main"] = read_base(repo, "main")
    return repo_row, prs, []


def scan(args: argparse.Namespace) -> dict[str, Any]:
    now = now_utc()
    report: dict[str, Any] = {"checked_at": iso(now), "repos": [], "prs": [], "unreadable": []}
    # Repos are independent, and each Forge read spawns last-stack-forge-api.
    # Sequentially the scan took ~33s on 2026-09-23 (20 open PRs); a Codex
    # routine shell yields long before that, and pipeline-health read the
    # still-empty output file as a "silent timeout"
    # (papercut-pipeline-health-forge-ledger-silent-timeout). Read repos in
    # parallel; the report keeps the repo-list order.
    repos = load_repos(args)
    workers = max(1, min(len(repos), int(os.environ.get("LAST_STACK_FORGE_LEDGER_WORKERS", "8"))))
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        results = list(pool.map(lambda r: scan_repo(r, args, now), repos))
    for repo_row, prs, unreadable in results:
        report["unreadable"].extend(unreadable)
        report["prs"].extend(prs)
        if repo_row is not None:
            report["repos"].append(repo_row)
    report["stuck"] = sum(1 for p in report["prs"] if p["stuck"])
    report["open"] = len(report["prs"])
    report["heartbeat_fields"] = heartbeat_fields(report)
    return report


# ── ledger ──────────────────────────────────────────────────────────────────

def state_path(args: argparse.Namespace) -> Path:
    if args.state_file:
        return Path(args.state_file)
    root = os.environ.get("LAST_STACK_STATE_DIR") or str(Path.home() / ".local/state/last-stack")
    return Path(root) / "pipeline-health" / "forge-pr-ledger.json"


def load_state(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


class BrainBusy(RuntimeError):
    pass


def brain_status(brain: str, slug: str) -> str | None:
    """Typed status of a papercut, None when the slug does not exist."""
    proc = run([brain, "get", slug, "--type", "papercut", "--json"], timeout=60)
    text = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode != 0:
        if "No papercut" in text or "not found" in text.lower():
            return None
        raise BrainBusy(text.strip()[:300])
    try:
        doc = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise BrainBusy(f"brain get {slug}: invalid json") from exc
    return str(doc.get("status") or "open")


LIVE = {"open", "partial", "fixed"}
ATTRIBUTED = {"duplicate", "wontfix"}


def live_card_owner(args: argparse.Namespace, pr: dict[str, Any], now: dt.datetime) -> str:
    """Card slug when the PR's kanban/<slug> card is in doing, assigned, and fresh."""
    ref = pr.get("head_ref") or ""
    if not ref.startswith("kanban/"):
        return ""
    card_slug = ref[len("kanban/"):]
    proc = run([args.kanban_bin, "show", card_slug, "--json"], timeout=45)
    if proc.returncode != 0:
        return ""
    try:
        card = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return ""
    if not isinstance(card, dict) or card.get("column") != "doing" or not card.get("assignee"):
        return ""
    updated = parse_ts(card.get("updated_at"))
    if not updated or (now - updated).total_seconds() > args.owner_fresh_min * 60:
        return ""
    return card_slug


def evidence_line(pr: dict[str, Any], checked_at: str, passes: int = 0) -> str:
    req = ", ".join(f"{c}={s}" for c, s in pr["required"].items())
    intent = f" intent={pr['merge_intent']}" if pr.get("merge_intent") else ""
    # `cancelled=` is what tells the next reader the red is infra, not product.
    # Without it the evidence line is the same text for both, which is the
    # defect this whole classification exists to stop.
    cancelled = pr.get("cancelled_contexts") or []
    cancel = f" cancelled={', '.join(cancelled)}" if cancelled else ""
    # How many consecutive passes this row has been observed with the same
    # fingerprint. A transient row is filed p1 and never escalated (row_severity),
    # so this counter is the only thing that separates a flake from a lane that
    # has been wedged for an hour.
    seen = f" passes={passes}" if passes else ""
    return (
        f"- {checked_at}: {pr['repo']}#{pr['number']} shape={pr['shape']}{intent} head={pr['head_sha'][:12]} "
        f"mergeable={pr['mergeable']} age_min={pr['age_min']}{cancel}{seen} required: {req}\n"
    )


def sync(args: argparse.Namespace) -> dict[str, Any]:
    report = scan(args)
    checked_at = report["checked_at"]
    path = state_path(args)
    state = load_state(path)
    tracked: dict[str, Any] = state.setdefault("tracked", {})
    actions: list[dict[str, Any]] = []
    brain = args.brain_bin
    open_prs = {(p["repo"], p["number"]): p for p in report["prs"]}
    unreadable = {u["repo"] for u in report["unreadable"]}

    def act(kind: str, slug: str, **extra: Any) -> dict[str, Any]:
        row = {"action": kind, "slug": slug, **extra}
        actions.append(row)
        return row

    # 0. a PR red ONLY on a context that a live, named root-cause papercut
    #    already owns (config/pipeline-known-root-causes.tsv, e.g. fold's flaky
    #    required Mini lane) is evidence for that papercut, not a new row. Once
    #    that papercut is closed, the mapping stops applying and a red PR gets
    #    its own row again.
    known = load_known_root_causes(args.root_causes_file)
    known_status: dict[str, str | None] = {}
    for pr in report["prs"]:
        if not (pr["stuck"] and pr["shape"] == "red" and pr["red_contexts"] and not pr["root_cause"]):
            continue
        for repo_k, ctx, rc_slug in known:
            if repo_k != pr["repo"]:
                continue
            mapped = {c for r, c, sl in known if r == pr["repo"] and sl == rc_slug}
            if not set(pr["red_contexts"]) <= mapped:
                continue
            if rc_slug not in known_status:
                try:
                    known_status[rc_slug] = brain_status(brain, rc_slug)
                except BrainBusy:
                    known_status[rc_slug] = None
            if known_status[rc_slug] in LIVE:
                pr["root_cause"] = "known"
                pr["ledger_slug"] = rc_slug
                break

    # 0b. a green PR nobody armed is recorded, never filed (see merge_intent).
    for pr in report["prs"]:
        if pr.get("stuck_excluded") == "green-unarmed":
            act("green-unarmed", pr_slug(pr["repo"], pr["number"]), age_min=pr["age_min"])

    # 0c. a green PR whose repo is under a Situation that blocks merge-pr is
    #     recorded, never filed. A p0 row for it puts a deliberate hold at the
    #     top of the factory queue and its only implied remedy is the action the
    #     hold forbids: on 2026-09-25 three EdgeVector/loom PRs merged under
    #     such a hold and host-track re-absorbed the schema regression the hold
    #     existed to keep out. The row also cannot close, because nothing may
    #     merge the PR. See merge_policy() for the classification, which is
    #     scoped to this shape only.
    for pr in report["prs"]:
        if pr.get("stuck_excluded") == "policy-blocked":
            act("policy-blocked", pr_slug(pr["repo"], pr["number"]),
                policy=pr.get("policy_hold") or "", age_min=pr["age_min"])

    # 1. stuck PRs → file or append (one row per PR, or one per repo when main is red)
    grouped: dict[str, list[dict[str, Any]]] = {}
    for pr in report["prs"]:
        if pr["stuck"]:
            grouped.setdefault(pr["ledger_slug"], []).append(pr)
    for slug, prs in grouped.items():
        pr = prs[0]
        fingerprint = ";".join(sorted(f"{p['number']}:{p['head_sha']}:{p['shape']}" for p in prs))
        prior = tracked.get(slug) or {}
        # Consecutive passes this exact fingerprint has been seen. Resets when the
        # head or the shape changes, because that is a different observation.
        passes = int(prior.get("passes") or 0) + 1 if prior.get("fingerprint") == fingerprint else 1
        severity = row_severity(pr)
        if not pr["root_cause"] and args.owner_fresh_min > 0:
            owner = live_card_owner(args, pr, now_utc())
            if owner:
                # A red PR whose card is in doing with a worker that touched it
                # recently is that worker's job, not pipeline friction. The
                # pr-reaper's one-hour SLA still applies to it.
                act("owned", slug, card=owner)
                continue
        try:
            status = known_status[slug] if pr["root_cause"] == "known" else brain_status(brain, slug)
        except BrainBusy as exc:
            act("skip-busy", slug, error=str(exc))
            continue
        if status in LIVE:
            if prior.get("fingerprint") == fingerprint:
                # Still no write to the record — the append only happens on a
                # change — but the counter has to advance, or every pass reads
                # `passes=1` and a wedged lane is indistinguishable from a flake.
                act("unchanged", slug, passes=passes)
                if args.apply:
                    tracked[slug] = {**prior, "passes": passes, "last_seen_at": checked_at}
                continue
            chunk = "".join(evidence_line(p, checked_at, passes) for p in prs)
            row = act("append", slug, prs=[p["number"] for p in prs])
            if args.apply:
                proc = run([brain, "append", slug, "--type", "papercut"], stdin=chunk)
                row["ok"] = proc.returncode == 0
                if proc.returncode != 0:
                    row["error"] = (proc.stderr or proc.stdout).strip()[:300]
                    continue
        elif status in ATTRIBUTED:
            # A human or agent closed this PR's row as a duplicate of a named
            # root cause (for example a flaky required lane on main), or as
            # wontfix. Respect that attribution: re-filing it each wake is the
            # churn this helper exists to stop. It re-opens only as a new PR.
            act("attributed", slug, status=status)
            continue
        else:
            file_slug = slug
            if status is not None:
                # terminal (verified/wontfix/duplicate): a recurrence gets its own
                # stable occurrence slug keyed by the head; never reopen.
                file_slug = f"{slug}-{pr['head_sha'][:8]}" if not pr["root_cause"] else f"{slug}-{checked_at[:10].replace('-', '')}"
                try:
                    if brain_status(brain, file_slug) in LIVE:
                        act("unchanged", file_slug)
                        continue
                except BrainBusy as exc:
                    act("skip-busy", file_slug, error=str(exc))
                    continue
            if pr["root_cause"]:
                title = f"Pipeline: {pr['repo']} main is red on required checks; open PRs inherit it"
                symptom = f"{pr['repo']} base tip is red on {', '.join(pr['red_contexts'])}, so every open PR is red"
            elif pr["shape"] == CANCELLED:
                # Name the remedy in the row itself. A reader who sees only
                # "stuck (red)" routes to the heavy arm — enter the worktree,
                # read logs, change code — and spends a build attempt on code
                # that was never broken. The run was cancelled; re-run it.
                ctxs = ", ".join(pr["cancelled_contexts"])
                title = f"Pipeline: {pr['repo']} PR {pr['number']} is stuck on a CANCELLED required run (re-run it)"
                symptom = (
                    f"{pr['repo']} PR {pr['number']} is stuck: required context {ctxs} was cancelled, "
                    f"not failed - no test failed; the remedy is a re-run, not a code change"
                )
            else:
                title = f"Pipeline: {pr['repo']} PR {pr['number']} is stuck ({pr['shape']})"
                symptom = f"{pr['repo']} PR {pr['number']} is stuck: {pr['shape']}"
            body = (
                f"Source: last-stack-pipeline-forge-pr-ledger (one row per PR; closes itself when the PR merges or closes)\n"
                f"Repo: {pr['repo']}\nPR: {', '.join(str(p['number']) for p in prs)}\nChecked-at: {checked_at}\n\n"
                f"## Evidence\n" + "".join(evidence_line(p, checked_at, passes) for p in prs)
            )
            row = act("file", file_slug, prs=[p["number"] for p in prs], severity=severity)
            if args.apply:
                argv = [
                    brain, "papercut", "file", file_slug,
                    "--component", "pipeline", "--severity", severity, "--kind", "specified-fix",
                    "--symptom", symptom, "--title", title, "--repo", pr["repo"],
                    "--tag", "papercut", "--tag", "pipeline", "--tag", severity, "--body", body,
                ]
                proc = run(argv)
                refusal = (proc.stdout or "") + (proc.stderr or "")
                if proc.returncode != 0:
                    # The dedupe gate matches sibling per-PR rows (same shape,
                    # different PR). Those are not duplicates: clear exactly them.
                    siblings = sorted(set(re.findall(r"papercut-pipeline-forge-[a-z0-9-]+-pr-\d+(?:-[0-9a-f]{8})?", refusal)) - {file_slug})
                    others = sorted(set(re.findall(r"papercut-[a-z0-9-]+", refusal)) - set(siblings) - {file_slug})
                    if siblings and not others:
                        for sib in siblings:
                            argv += ["--not-duplicate-of", sib]
                        proc = run(argv)
                        refusal = (proc.stdout or "") + (proc.stderr or "")
                row["ok"] = proc.returncode == 0
                if proc.returncode != 0:
                    row["error"] = refusal.strip()[:600]
                    continue
            slug = file_slug
        if args.apply:
            tracked[slug] = {
                "repo": pr["repo"],
                "prs": [p["number"] for p in prs],
                "kind": {"base-red": "main-red", "known": "known"}.get(pr["root_cause"], "pr"),
                "fingerprint": fingerprint,
                "last_evidence_at": checked_at,
                # The severity the row was FILED at. It cannot be amended later,
                # so this is what the record actually carries, not a wish.
                "severity": severity,
                "passes": passes,
                "last_seen_at": checked_at,
            }

    # 2. tracked rows whose PR left the open set (or whose main went green) → close verified
    for slug, meta in sorted(tracked.items()):
        repo = meta.get("repo") or ""
        if repo in unreadable:
            continue
        if meta.get("kind") == "known":
            # Not ours to close: the owner of the root cause closes it. Stop
            # tracking once none of its PRs is stuck on it any more.
            if not any(p["ledger_slug"] == slug and p["stuck"] for p in report["prs"]):
                tracked.pop(slug, None)
            continue
        if meta.get("kind") == "main-red":
            still = [p for p in report["prs"] if p["ledger_slug"] == slug and p["stuck"]]
            base = next((r["base"] for r in report["repos"] if r["repo"] == repo), {})
            main = (base or {}).get("main") or {}
            if still or main.get("verdict") != "green":
                continue
            evidence = f"{repo} main tip {main.get('sha', '')[:12]} is green on every required context: {', '.join(main.get('required', []))}"
            verified_by = f"forge point read GET repos/{repo}/commits/{main.get('sha', '')}/status at {checked_at}: required contexts success"
        else:
            numbers = meta.get("prs") or []
            if any((repo, n) in open_prs for n in numbers):
                continue
            facts = []
            try:
                for n in numbers:
                    doc = forge_get(f"repos/{repo}/pulls/{n}")
                    facts.append(f"#{n} state={doc.get('state')} merged={doc.get('merged')} merged_at={doc.get('merged_at') or '-'}")
                    if doc.get("state") == "open":
                        raise ForgeError("list/point disagreement: still open")
            except ForgeError as exc:
                act("close-deferred", slug, error=str(exc))
                continue
            evidence = f"{repo} PR left the open set: {'; '.join(facts)}"
            verified_by = f"forge point read GET repos/{repo}/pulls/<n> at {checked_at}: {'; '.join(facts)}"
        row = act("close", slug, evidence=evidence)
        if args.apply:
            try:
                status = brain_status(brain, slug)
            except BrainBusy as exc:
                row["ok"] = False
                row["error"] = str(exc)
                continue
            if status is None or status not in LIVE:
                tracked.pop(slug, None)
                row["ok"] = True
                row["note"] = f"already {status or 'absent'}"
                continue
            proc = run([
                brain, "papercut", "close", slug, "--status", "verified",
                "--evidence", evidence, "--verified-by", verified_by,
            ])
            row["ok"] = proc.returncode == 0
            if proc.returncode == 0:
                tracked.pop(slug, None)
            else:
                row["error"] = (proc.stderr or proc.stdout).strip()[:300]

    if args.apply:
        state["updated_at"] = checked_at
        save_state(path, state)
    report["ledger"] = {"apply": bool(args.apply), "state_file": str(path), "actions": actions, "tracked": sorted(tracked)}
    report["heartbeat_fields"] = heartbeat_fields(report)
    return report


def guard_bin() -> str:
    env = os.environ.get("LAST_STACK_CLOSE_GUARD")
    if env:
        return env
    sibling = HERE / "last-stack-pr-reaper-close-guard"
    return str(sibling) if sibling.exists() else "last-stack-pr-reaper-close-guard"


def reap_plan(args: argparse.Namespace) -> dict[str, Any]:
    """pr-reaper's inventory: every open PR older than --reap-age-min, with the
    close-guard verdict and a fresh point read, so the routine writes no loop.

    pr-reaper hand-wrote `set -- $spec` loops under zsh to run the guard per PR;
    zsh does not word-split, the PR argument came out empty, and the guard
    exited 2 on most passes of 2026-09-22 (papercut-pr-reaper-zsh-positional-split-20260922).
    """
    report = scan(args)
    plan = []
    for pr in report["prs"]:
        if pr["age_min"] is None or pr["age_min"] <= args.reap_age_min:
            continue
        name = pr["repo"].rsplit("/", 1)[-1]
        proc = run([guard_bin(), "--venue", "forgejo", "--repo", name, "--pr", str(pr["number"]), "--json"], timeout=120)
        try:
            guard = json.loads(proc.stdout)
        except json.JSONDecodeError:
            guard = {"verdict": "guard-error", "reason": (proc.stderr or proc.stdout).strip()[:200]}
        guard["exit"] = proc.returncode
        try:
            point = forge_get(f"repos/{pr['repo']}/pulls/{pr['number']}")
            fresh = {
                "state": point.get("state"),
                "merged": point.get("merged"),
                "head_sha": (point.get("head") or {}).get("sha") or "",
            }
        except ForgeError as exc:
            fresh = {"state": "unreadable", "merged": None, "head_sha": "", "error": str(exc)[:200]}
        still_open = fresh["state"] == "open" and not fresh["merged"]
        owned_by = live_card_owner(args, pr, now_utc()) if hasattr(args, "kanban_bin") else ""
        plan.append(
            {
                "repo": pr["repo"],
                "number": pr["number"],
                "age_min": pr["age_min"],
                "shape": pr["shape"],
                "head_ref": pr["head_ref"],
                "head_sha": pr["head_sha"],
                "guard_verdict": guard.get("verdict"),
                "guard_reason": guard.get("reason"),
                "guard_exit": guard.get("exit"),
                "point": fresh,
                "head_unchanged": fresh["head_sha"] == pr["head_sha"],
                "owned_by": owned_by,
                # The only rows the reaper may terminalize this pass.
                "may_close": still_open and fresh["head_sha"] == pr["head_sha"] and guard.get("verdict") == "close-ok" and not owned_by,
                # Informational. may_merge is NOT gated on it: the reaper's
                # 1-hour SLA terminalizes an unarmed green PR by merging it, and
                # that directive is unchanged by this field.
                "merge_intent": pr.get("merge_intent", ""),
                "may_merge": still_open and fresh["head_sha"] == pr["head_sha"] and pr["shape"] == "green-unmerged",
            }
        )
    report["reap_plan"] = plan
    report["plan_valid"] = not bool(report["unreadable"])
    return report


def forge_write(method: str, path: str, data: str | None = None) -> subprocess.CompletedProcess[str]:
    argv = [forge_api_bin(), "--method", method]
    if data is not None:
        argv += ["--data", data]
    return run(argv + [path], timeout=60)


def schedule_state(repo: str, number: int) -> tuple[bool, dt.datetime | None]:
    """(armed, armed_at) from the PR timeline.

    A Forgejo PR read has no auto-merge field (.auto_merge is always null), and
    the only other probe, re-POSTing merge_when_checks_succeed, ARMS the PR as a
    side effect. The timeline records pull_scheduled_merge and
    pull_cancel_scheduled_merge events; the later one wins.
    """
    armed, armed_at = False, None
    for page in range(1, 11):  # bounded: 10 pages x 50 events
        events = forge_get(f"repos/{repo}/issues/{number}/timeline?limit=50&page={page}")
        if page == 1 and not isinstance(events, list):
            # A timeline that does not read as a list of events is UNREADABLE.
            # Answering "not armed" here would let a broken read look like
            # "nobody asked for the merge", which is the one thing every caller
            # of this function decides on.
            raise ForgeError(f"repos/{repo}/issues/{number}/timeline: response is not a list")
        if not isinstance(events, list) or not events:
            break
        for ev in events:
            kind = (ev or {}).get("type") if isinstance(ev, dict) else None
            if kind == "pull_scheduled_merge":
                armed, armed_at = True, parse_ts(ev.get("created_at"))
            elif kind == "pull_cancel_scheduled_merge":
                armed, armed_at = False, None
        if len(events) < 50:
            break
    return armed, armed_at


def green_since(status_doc: Any, required: list[str]) -> dt.datetime | None:
    """When the last required context turned success (latest per context)."""
    latest: dict[str, tuple[str, str]] = {}
    rows = status_doc.get("statuses") if isinstance(status_doc, dict) else None
    for row in rows or []:
        if not isinstance(row, dict):
            continue
        key = stem(row.get("context") or "")
        when = str(row.get("updated_at") or row.get("created_at") or "")
        if key and (key not in latest or when >= latest[key][1]):
            latest[key] = (str(row.get("status") or row.get("state") or "").lower(), when)
    stamps = [parse_ts(latest[c][1]) for c in required if c in latest and latest[c][0] == "success"]
    stamps = [s for s in stamps if s]
    return max(stamps) if len(stamps) == len(required) and stamps else None


def merge_green_once(args: argparse.Namespace) -> dict[str, Any]:
    repo = args.repo[0] if "/" in args.repo[0] else f"EdgeVector/{args.repo[0]}"
    number = args.pr
    out: dict[str, Any] = {"repo": repo, "number": number, "applied": bool(args.apply)}
    # Policy before evidence. The answer does not depend on the PR, it is the
    # same with or without --apply, and asking first is what keeps the
    # cancel/merge/re-arm sequence from starting at all. See merge_policy().
    policy, policy_detail = merge_policy(repo)
    out["policy"] = policy
    if policy_detail:
        out["policy_detail"] = policy_detail
    if policy != "ok":
        return {**out, "verdict": f"situations-{policy}"}
    point = forge_get(f"repos/{repo}/pulls/{number}")
    if point.get("merged"):
        return {**out, "verdict": "merged", "merge_commit_sha": point.get("merge_commit_sha") or ""}
    if point.get("state") != "open":
        return {**out, "verdict": "closed"}
    if point.get("draft"):
        return {**out, "verdict": "draft"}
    if point.get("mergeable") is False:
        return {**out, "verdict": "conflict"}
    head = (point.get("head") or {}).get("sha") or ""
    base_ref = (point.get("base") or {}).get("ref") or "main"
    required = required_contexts(repo, base_ref)
    doc = forge_get(f"repos/{repo}/commits/{head}/status")
    verdict, red, cancelled = required_verdict(context_states(doc), required)
    out.update({"head_sha": head, "required": required, "checks": verdict,
                "red_contexts": red, "cancelled_contexts": cancelled})
    if verdict != "green":
        return {**out, "verdict": verdict}
    armed, armed_at = schedule_state(repo, number)
    green_at = green_since(doc, required)
    out.update({"armed": armed, "armed_at": iso(armed_at) if armed_at else "",
                "green_at": iso(green_at) if green_at else ""})
    if not armed and not args.arm:
        # Nobody asked for a merge (e.g. "proof in flight - do not arm").
        return {**out, "verdict": "green-not-armed"}
    if armed:
        stamps = [t for t in (armed_at, green_at) if t]
        since = max(stamps) if stamps else None
        idle = int((now_utc() - since).total_seconds()) if since else None
        out["armed_green_idle_sec"] = idle
        if idle is not None and idle < args.grace_sec:
            return {**out, "verdict": "armed-green-wait"}
    if not args.apply:
        return {**out, "verdict": "would-merge"}
    # Forgejo 15.0.3 only evaluates a scheduled auto-merge on a NEW commit-status
    # event. A schedule armed after the last required status went green never
    # fires (papercut-forgejo-auto-merge-armed-after-green-never-fires-20260923;
    # schema-infra PR 7 and 8 on 2026-09-23). Cancel the schedule and merge
    # directly: branch protection still enforces the required checks on the
    # merge call, so this cannot bypass the gate.
    cancelled = False
    if armed:
        cancelled = forge_write("DELETE", f"repos/{repo}/pulls/{number}/merge").returncode == 0
    body = json.dumps({"Do": args.style, "delete_branch_after_merge": True})
    proc = forge_write("POST", f"repos/{repo}/pulls/{number}/merge", body)
    out["merge_rc"] = proc.returncode
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout).strip()[:300]
        if cancelled:
            # Keep the owner's intent: re-arm what we cancelled.
            forge_write("POST", f"repos/{repo}/pulls/{number}/merge",
                        json.dumps({"Do": args.style, "merge_when_checks_succeed": True,
                                    "delete_branch_after_merge": True}))
        # 405 with green checks is the stuck status-check task
        # (papercut-forge-merge-405-stuck-status-check): heal with an empty commit.
        return {**out, "verdict": "merge-405" if "405" in err else "merge-failed", "error": err}
    after = forge_get(f"repos/{repo}/pulls/{number}")
    if after.get("merged"):
        return {**out, "verdict": "merged-now", "merge_commit_sha": after.get("merge_commit_sha") or ""}
    return {**out, "verdict": "merge-unconfirmed"}


def merge_green(args: argparse.Namespace) -> dict[str, Any]:
    """Bounded "merge when green" fallback for Forgejo native auto-merge.

    Polls (with sleep) up to --wait-sec while the required checks are pending
    or an armed green PR is inside --grace-sec, then merges an ARMED green PR
    directly. It never merges a PR that nobody armed unless --arm is passed.
    """
    deadline = time.monotonic() + max(0, args.wait_sec)
    report: dict[str, Any] = {"checked_at": iso(now_utc()), "prs": [], "unreadable": []}
    while True:
        try:
            result = merge_green_once(args)
        except ForgeError as exc:
            result = {"repo": args.repo[0], "number": args.pr, "verdict": "unreadable", "error": str(exc)[:300]}
        if result["verdict"] not in {"pending", "absent", "armed-green-wait"} or time.monotonic() >= deadline:
            break
        time.sleep(max(1, min(args.poll_sec, int(deadline - time.monotonic()) or 1)))
    report["merge_green"] = result
    return report


def print_text(report: dict[str, Any]) -> None:
    mg = report.get("merge_green")
    if mg:
        print("\t".join(str(x) for x in (
            "merge-green", mg.get("repo"), mg.get("number"), mg.get("verdict"),
            f"checks={mg.get('checks', '-')}", f"armed={mg.get('armed', '-')}",
            f"merge={mg.get('merge_commit_sha') or '-'}",
            # A refusal must name what it refused ON. `situations-blocked` alone
            # sends the reader back to preflight to find out which Situation did
            # it; the slug is the one thing they need in order to cite it.
            f"policy={mg.get('policy_detail')}" if mg.get("policy_detail") else "",
            mg.get("error", "") or "",
        )).rstrip("\t"))
        return
    print(f"checked_at={report['checked_at']} stuck={report['stuck']} unreadable={len(report['unreadable'])}")
    for pr in report["prs"]:
        req = ",".join(f"{c.split(' / ')[-1]}={s}" for c, s in pr["required"].items())
        print(
            "\t".join(
                str(x)
                for x in (
                    pr["repo"], pr["number"], pr["shape"], "stuck" if pr["stuck"] else "-",
                    pr["root_cause"] or "-", pr["age_min"], pr["head_sha"][:10], req,
                )
            )
        )
    for u in report["unreadable"]:
        print(f"unreadable\t{u['repo']}\t{u['error']}")
    for r in report.get("reap_plan", []):
        print(
            f"reap\t{r['repo']}\t{r['number']}\t{r['guard_verdict']}\t{r['guard_reason']}\t"
            f"close={r['may_close']}\tmerge={r['may_merge']}"
        )
    for a in (report.get("ledger") or {}).get("actions", []):
        # A suppression has to name what suppressed it: `policy-blocked` alone
        # sends the reader back to preflight for the hold's slug.
        policy = f"policy={a['policy']}" if a.get("policy") else ""
        print(f"ledger\t{a['action']}\t{a['slug']}\t{a.get('ok', '')}\t{policy}\t{a.get('error', '')}".rstrip("\t"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    for name in ("scan", "sync", "reap-plan"):
        sp = sub.add_parser(name)
        sp.add_argument("--repo", action="append", help="owner/name (repeatable); default: merge-demand repo list")
        sp.add_argument("--repos-file", default=str(DEFAULT_REPOS_FILE))
        sp.add_argument("--min-age-min", type=int, default=10, help="red/conflict/green-unmerged older than this is stuck")
        sp.add_argument("--pending-stale-min", type=int, default=120, help="pending/absent with no PR update for this long is stuck")
        sp.add_argument("--root-causes-file", default=os.environ.get("LAST_STACK_PIPELINE_ROOT_CAUSES", str(DEFAULT_ROOT_CAUSES_FILE)),
                        help="TSV: repo, required context, root-cause papercut slug")
        sp.add_argument("--json", action="store_true", dest="json_out")
        if name == "reap-plan":
            sp.add_argument("--reap-age-min", type=int, default=60, help="only PRs open longer than this (the one-hour SLA)")
            sp.add_argument("--kanban-bin", default=os.environ.get("KANBAN_BIN", "kanban"),
                            help="kanban CLI for checking card ownership")
            sp.add_argument("--owner-fresh-min", type=int, default=120,
                            help="skip a PR whose kanban/<slug> card is in doing, assigned, and updated this recently")
        if name == "sync":
            sp.add_argument("--apply", action="store_true", help="write the ledger (default: dry run)")
            sp.add_argument("--brain-bin", default=os.environ.get("BRAIN_BIN", "brain"))
            sp.add_argument("--state-file", default="")
            sp.add_argument("--kanban-bin", default=os.environ.get("KANBAN_BIN", "kanban"))
            sp.add_argument(
                "--owner-fresh-min", type=int, default=120,
                help="skip a PR whose kanban/<slug> card is in doing, assigned, and updated this recently (0 = never skip)",
            )
    mg = sub.add_parser(
        "merge-green",
        help="bounded merge-when-green fallback for one Forgejo PR (native auto-merge armed after green never fires)",
    )
    mg.add_argument("--repo", action="append", required=True, help="owner/name")
    mg.add_argument("--pr", type=int, required=True)
    mg.add_argument("--apply", action="store_true", help="merge (default: report would-merge)")
    mg.add_argument("--arm", action="store_true", help="also merge a green PR that has no auto-merge schedule")
    mg.add_argument("--grace-sec", type=int, default=90,
                    help="give native auto-merge this long after arm/green before merging directly")
    mg.add_argument("--wait-sec", type=int, default=0, help="poll up to this long while pending (bounded)")
    mg.add_argument("--poll-sec", type=int, default=30)
    mg.add_argument("--style", default="merge", choices=["merge", "rebase", "rebase-merge", "squash"])
    mg.add_argument("--json", action="store_true", dest="json_out")
    args = parser.parse_args()
    report = {"scan": scan, "sync": sync, "reap-plan": reap_plan, "merge-green": merge_green}[args.cmd](args)
    if args.json_out:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text(report)
    if args.cmd == "merge-green":
        verdict = report["merge_green"]["verdict"]
        if verdict in {"merged", "merged-now", "would-merge", "green-not-armed", "armed-green-wait", "pending", "absent", "draft"}:
            return 0
        # 3 is "stop and cite the reason", the same code `situations preflight`
        # and last-stack-forge-api's merge guard use for a refusal.
        if verdict in {"unreadable", "situations-blocked", "situations-unreadable"}:
            return 3
        return 1
    if report["unreadable"] and not report["prs"]:
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
