#!/usr/bin/env bash
# Zero-LLM pre-dispatch gate for kanban-pickup workers.
#
# Problem: routinesd always boots the harness (codex high-effort). The old
# empty-todo gate lived *inside* the agent prompt, so a non-empty todo full of
# unclaimable cards (ready=0: unattached-outcome, human-gated, …) still burned
# ~5 minutes of high-effort Codex per worker per fire.
#
# This script is the cheap outer gate:
#   - exit 0  → skip harness (noop). Heartbeat + ROUTINE_RESULT already printed.
#   - exit 10 → proceed to harness (ready work exists).
#   - exit 2  → usage / hard config error.
#
# Invoked by routinesd `gate_command` when present, and also as the first step
# of the pickup bootstrap prompt (defense in depth on older routinesd).
#
# Won't-undo (2026-08-15): NEVER run unbounded board-closeout-sweep here.
# Closeout has its own 15m LaunchAgent. A hung closeout under LastDB load
# exceeded routinesd's ~120s gate_command timeout, so ready>0 never reached a
# harness (factory outage: pickup-gate-timeout). Ready reads are hard-capped.
set -euo pipefail

# Resolve the file symlink chain before dirname: the PATH link
# ~/.local/bin/<name> points into the artifact tree, and siblings live there.
_self_src="$0"
while [ -L "$_self_src" ]; do
  _self_link="$(readlink "$_self_src")"
  case "$_self_link" in /*) _self_src="$_self_link" ;; *) _self_src="$(dirname "$_self_src")/$_self_link" ;; esac
done
self_dir="$(cd "$(dirname "$_self_src")" && pwd -P)"
# Prefer a logical install root. `pwd -P` follows ~/.last-stack/bin into the
# immutable host-track artifacts/versions/* tree. Heartbeat then tries to
# mkdir version/logs, gets EPERM in a Codex sandbox, and older gates mixed
# that write error into a board-read skip.
if [ -n "${LAST_STACK_ROOT:-}" ] && [ -d "${LAST_STACK_ROOT}/bin" ]; then
  last_stack="${LAST_STACK_ROOT}"
elif [ -x "${HOME}/.last-stack/bin/last-stack-kanban-pickup-gate" ]; then
  last_stack="${HOME}/.last-stack"
else
  last_stack="$(cd "$self_dir/.." && pwd -P)"
fi
if [ -f "$last_stack/bin/last-stack-shell-prelude" ]; then
  # shellcheck disable=SC1091
  . "$last_stack/bin/last-stack-shell-prelude"
fi

usage() {
  cat <<'USAGE'
last-stack-kanban-pickup-gate [--json-out PATH]

Zero-LLM credit gate for kanban-pickup. Exit 0 = skip agent; 10 = proceed.

Does not run board-closeout-sweep (LaunchAgent owns closeout). Caps ready and
todo board reads so the gate always finishes under routinesd's gate_command
timeout (~120s). Todo list is diagnostic only. Ready unavailable always skips.
Never proceed from todo count. Proceed prints PICKUP_GATE_PROCEED, not
ROUTINE_RESULT outcome=ok.

The proceed/skip read is `kanban pickup ready --json` (todo-partition ready
count). Do not call the full-board BoardCards audit CLI here.

Options:
  --json-out PATH   write the pickup ready JSON (or todo list) to PATH
  -h, --help        show this help

Env (optional, for tests):
  LAST_STACK_PICKUP_GATE_READY_TIMEOUT_SEC   cap for `pickup ready` (default 45)
  LAST_STACK_PICKUP_GATE_STATUS_TIMEOUT_SEC  alias for READY timeout (legacy)
  LAST_STACK_PICKUP_GATE_TODO_TIMEOUT_SEC    cap for todo list fallback (default 30)
USAGE
}

json_out=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json-out)
      json_out="${2:-}"
      shift 2
      ;;
    --json-out=*)
      json_out="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

hb() {
  local line="$1"
  if [ -x "$last_stack/bin/last-stack-brain-append-heartbeat" ]; then
    "$last_stack/bin/last-stack-brain-append-heartbeat" --line "$line" || true
  fi
  printf '%s\n' "$line"
}

trailer_noop() {
  local detail="$1"
  printf '%s %s\n' 'ROUTINE_RESULT' "outcome=noop detail=${detail}"
}

# Prefer gtimeout (coreutils on macOS) then timeout; empty means no wrapper.
# Probe exec: Homebrew gtimeout often sits outside the Codex workspace-write
# allow list. `command -v` succeeds, then the wrapper exits 126, both board
# reads "fail" in <1s, and the inner gate skip-exits a run the outer gate
# already allowed. Only keep a timeout binary that can actually run `true`.
timeout_bin=""
if command -v gtimeout >/dev/null 2>&1; then
  timeout_bin="gtimeout"
elif command -v timeout >/dev/null 2>&1; then
  timeout_bin="timeout"
fi
if [ -n "$timeout_bin" ]; then
  if ! "$timeout_bin" 1s true >/dev/null 2>&1 && ! "$timeout_bin" 1 true >/dev/null 2>&1; then
    timeout_bin=""
  fi
fi

status_timeout_sec="${LAST_STACK_PICKUP_GATE_READY_TIMEOUT_SEC:-${LAST_STACK_PICKUP_GATE_STATUS_TIMEOUT_SEC:-45}}"
todo_timeout_sec="${LAST_STACK_PICKUP_GATE_TODO_TIMEOUT_SEC:-30}"

# Closeout is intentionally NOT run here. LaunchAgent
# com.edgevector.board-closeout owns the 15m zero-LLM sweep. Pickup harness
# prompts may still call closeout after the ready gate has already decided.

board_cli="kanban"
if ! command -v kanban >/dev/null 2>&1; then
  hb "kanban-pickup $(iso_now) noop missing-board-cli no_card_claimed"
  trailer_noop "missing-board-cli no_card_claimed"
  exit 0
fi

retry_bin=""
if [ -x "$last_stack/bin/last-stack-lastdb-retry" ]; then
  retry_bin="$last_stack/bin/last-stack-lastdb-retry"
elif command -v last-stack-lastdb-retry >/dev/null 2>&1; then
  retry_bin="last-stack-lastdb-retry"
fi

# Board read with wall-clock cap. Must invoke real executables only (timeout
# cannot run bash functions). Exit 124/137 = timed out. Exit 126/127 = the
# timeout wrapper itself could not exec — fall back to unwrapped kanban so a
# sandbox that blocks Homebrew gtimeout does not look like a dead board.
#
# Won't-undo (2026-09-04): the retry wrapper's own backoff schedule (15s,
# 45s, ...) does not know about this function's outer `timeout` deadline
# unless told. Export LAST_STACK_LASTDB_RETRY_DEADLINE_EPOCH so
# last_stack_lastdb_retry_capped_sleep_sec caps each sleep to what is left of
# `secs`, and exits with the real rc/stderr ("deadline won") instead of
# sleeping past the outer kill and having SIGKILL erase the buffered error
# (papercut-pickup-gate-45s-cap-cannot-hold-the-retry-schedule-it-asks-for-20260904).
run_board_capped() {
  local secs="$1"
  shift
  local rc=0
  set +e
  if [ -n "$timeout_bin" ] && [ -n "$secs" ] && [ "$secs" -gt 0 ] 2>/dev/null; then
    if [ -n "$retry_bin" ]; then
      LAST_STACK_LASTDB_RETRY_DEADLINE_EPOCH="$(( $(date -u +%s) + secs ))" \
        "$timeout_bin" -k 3s "${secs}s" "$retry_bin" --attempts 3 -- "$@"
    else
      "$timeout_bin" -k 3s "${secs}s" "$@"
    fi
    rc=$?
    # 126/127 = wrapper cannot exec. rc=1 with a live kanban is often the
    # same sandbox (Homebrew gtimeout denied, or timeout spawn of retry).
    # Do not treat those as a dead board: run kanban without the wrapper.
    # Keep 124/137 as real wall-clock timeouts (fail closed).
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ] && [ "$rc" -ne 137 ]; then
      if [ -n "$retry_bin" ]; then
        LAST_STACK_LASTDB_RETRY_DEADLINE_EPOCH="$(( $(date -u +%s) + secs ))" \
          "$retry_bin" --attempts 3 -- "$@"
      else
        "$@"
      fi
      rc=$?
    fi
  else
    if [ -n "$retry_bin" ]; then
      "$retry_bin" --attempts 3 -- "$@"
    else
      "$@"
    fi
    rc=$?
  fi
  set -e
  return "$rc"
}

tmp_status="$(mktemp "${TMPDIR:-/tmp}/pickup-gate-status.XXXXXX")"
tmp_todo="$(mktemp "${TMPDIR:-/tmp}/pickup-gate-todo.XXXXXX")"
tmp_status_err="$(mktemp "${TMPDIR:-/tmp}/pickup-gate-status-err.XXXXXX")"
tmp_todo_err="$(mktemp "${TMPDIR:-/tmp}/pickup-gate-todo-err.XXXXXX")"
cleanup() { rm -f "$tmp_status" "$tmp_todo" "$tmp_status_err" "$tmp_todo_err"; }
trap cleanup EXIT

# Prefer pickup ready (todo-partition ready count). A failed or timed-out
# ready read always skips. The todo list is diagnostic only — never a
# proceed signal. CLI `pickup status` stays the full-board audit; this gate
# must not call it.
classify_err_class() {
  local status_rc="$1"
  local err="$2"
  local err_class="board-read-failed"
  case "$err" in
    *service_timeout*|*did\ not\ respond*|*too\ many\ concurrent*)
      err_class="busy-node"
      ;;
    *folddb.sock*|*socket*gone*|*socket*unavailable*|*socket*unreachable*)
      err_class="absent-sock"
      ;;
    *Permission\ denied*|*Operation\ not\ permitted*|*cannot\ execute*)
      err_class="sandbox-exec"
      ;;
    *No\ such\ file*)
      err_class="absent-sock"
      ;;
  esac
  if [ "$status_rc" -eq 124 ] || [ "$status_rc" -eq 137 ]; then
    if [ "$err_class" = "board-read-failed" ]; then
      err_class="status-timeout"
    fi
  fi
  printf '%s\n' "$err_class"
}

skip_status_unavailable() {
  local status_rc="$1"
  local todo_rc="$2"
  local err="$3"
  local err_class
  err_class="$(classify_err_class "$status_rc" "$err")"
  local detail="${err_class} no_card_claimed err_class=${err_class} status_rc=${status_rc} todo_rc=${todo_rc}"
  if [ "$err_class" = "status-timeout" ]; then
    detail="busy-node status-timeout no_card_claimed err_class=${err_class} status_rc=${status_rc} todo_rc=${todo_rc}"
  elif [ "$err_class" = "busy-node" ]; then
    detail="busy-node no_card_claimed err_class=${err_class} status_rc=${status_rc} todo_rc=${todo_rc}"
  fi
  hb "kanban-pickup $(iso_now) noop ${detail}"
  trailer_noop "$detail"
  exit 0
}

status_ok=0
status_rc=0
todo_rc=0
if run_board_capped "$status_timeout_sec" \
  "$board_cli" pickup ready --json >"$tmp_status" 2>"$tmp_status_err"; then
  status_ok=1
else
  status_rc=$?
  if run_board_capped "$todo_timeout_sec" \
    "$board_cli" list --column todo --json >"$tmp_todo" 2>"$tmp_todo_err"; then
    todo_rc=0
  else
    todo_rc=$?
  fi
fi

if [ -n "$json_out" ]; then
  if [ "$status_ok" -eq 1 ]; then
    cp "$tmp_status" "$json_out" || true
  elif [ -s "$tmp_todo" ]; then
    cp "$tmp_todo" "$json_out" || true
  fi
fi

if [ "$status_ok" -ne 1 ]; then
  err="$(cat "$tmp_status_err" "$tmp_todo_err" 2>/dev/null | tr '\n' ' ' | head -c 200)"
  skip_status_unavailable "$status_rc" "$todo_rc" "$err"
fi

# ready is top-level; counts.pickup-ready is the same signal
ready="$(jq -r '(.ready // .counts["pickup-ready"] // 0) | tonumber' "$tmp_status" 2>/dev/null || echo 0)"
scanned="$(jq -r '(.scanned // 0) | tonumber' "$tmp_status" 2>/dev/null || echo 0)"
# summarize non-ready categories for the heartbeat (compact)
blockers="$(jq -r '
  (.counts // {})
  | to_entries
  | map(select(.key != "pickup-ready" and (.value | tonumber) > 0))
  | map("\(.key):\(.value)")
  | join(",")
' "$tmp_status" 2>/dev/null || echo "")"
todo_count="$(jq -r '
  [.cards[]? | select((.column // "") == "todo")] | length
' "$tmp_status" 2>/dev/null || echo "?")"
printf 'PICKUP_GATE ready=%s scanned=%s todo_approx=%s blockers=%s\n' \
  "$ready" "$scanned" "$todo_count" "${blockers:-none}"

# integer compare
ready_i=0
case "$ready" in
  ''|*[!0-9]*) ready_i=0 ;;
  *) ready_i="$ready" ;;
esac

if [ "$ready_i" -eq 0 ]; then
  detail="no-eligible ready=0"
  if [ -n "$blockers" ]; then
    detail="${detail} blockers=${blockers}"
  fi
  detail="${detail} no_card_claimed"
  hb "kanban-pickup $(iso_now) noop ${detail}"
  trailer_noop "$detail"
  exit 0
fi

# `claimable` (kanban >= the release that added it) is ready MINUS the cards a
# live doing peer fences through surface overlap. ready=4 with every card
# fenced used to wake an LLM worker that claimed nothing and logged the same
# `noop no-eligible` token an empty queue writes
# (papercut-kanban-pickup-gate-ready-overstates-eligible-20260922,
# papercut-pickup-surface-overlap-fence-has-no-age-bound-or-alarm). A fenced
# queue now skips with its own `fenced` detail token, naming the peers.
claimable="$(jq -r 'if has("claimable") then (.claimable | tostring) else "" end' "$tmp_status" 2>/dev/null || echo "")"
if [ "$claimable" = "0" ]; then
  fenced="$(jq -r '[.fenced[]? | "\(.slug)<-\(.peers | join("+"))"] | join(",")' "$tmp_status" 2>/dev/null || echo "")"
  detail="fenced ready=${ready_i} claimable=0 fenced=${fenced:-unknown} no_card_claimed"
  hb "kanban-pickup $(iso_now) noop ${detail}"
  trailer_noop "$detail"
  exit 0
fi

# Situation claim-card fence. On 2026-09-26 a pickup claimed a fold card 5 min
# after Situation pc-gaming-pause-fold-work-until-20260926t0900z blocked
# `claim-card` for EdgeVector/fold: nothing on the pickup path ran
# `situations preflight`. Preflight each distinct repo of the claimable ready
# cards once. Only exit 3 (BLOCKED / human clearance) fences a repo; any other
# failure of the situations CLI leaves the repo open, the same as before this
# check. When every claimable card's repo is fenced, skip with its own token.
situations_bin="${LAST_STACK_SITUATIONS_BIN:-}"
if [ -z "$situations_bin" ]; then
  situations_bin="$(command -v situations 2>/dev/null || true)"
fi
if [ -z "$situations_bin" ] && [ -x "$HOME/.local/bin/situations" ]; then
  situations_bin="$HOME/.local/bin/situations"
fi
candidate_repos="$(jq -r '
  ([.fenced[]?.slug] ) as $f
  | [.cards[]? | select(.ready == true and ((.slug // "") as $s | ($f | index($s)) == null)) | (.repo // "")]
  | unique | .[]
' "$tmp_status" 2>/dev/null || true)"
if [ -n "$situations_bin" ] && [ -n "$candidate_repos" ]; then
  open_repos=0
  blocked_repos=""
  blocked_by=""
  repo_checks=0
  while IFS= read -r repo; do
    if [ -z "$repo" ]; then
      # A card with no Repo: header cannot be fenced by repo scope.
      open_repos=$((open_repos + 1))
      continue
    fi
    repo_checks=$((repo_checks + 1))
    if [ "$repo_checks" -gt 8 ]; then
      open_repos=$((open_repos + 1))
      continue
    fi
    set +e
    # Not run_board_capped: it re-runs any non-zero exit, and exit 3 is the
    # answer here, not a flap.
    if [ -n "$timeout_bin" ]; then
      pf_out="$("$timeout_bin" -k 3s 15s "$situations_bin" preflight --action claim-card --repo "$repo" 2>&1)"
    else
      pf_out="$("$situations_bin" preflight --action claim-card --repo "$repo" 2>&1)"
    fi
    pf_rc=$?
    set -e
    if [ "$pf_rc" -eq 3 ]; then
      blocked_repos="${blocked_repos:+$blocked_repos,}${repo}"
      sit="$(printf '%s\n' "$pf_out" | sed -n 's/^BLOCKED: claim-card by \([^ ]*\).*/\1/p' | head -1)"
      blocked_by="${blocked_by:+$blocked_by,}${sit:-unknown}"
    else
      open_repos=$((open_repos + 1))
    fi
  done <<EOF_REPOS
$candidate_repos
EOF_REPOS
  if [ -n "$blocked_repos" ]; then
    printf 'PICKUP_GATE situation_blocked repos=%s situations=%s\n' "$blocked_repos" "$blocked_by"
  fi
  if [ -n "$blocked_repos" ] && [ "$open_repos" -eq 0 ]; then
    detail="situation-blocked ready=${ready_i} repos=${blocked_repos} situations=${blocked_by} no_card_claimed"
    hb "kanban-pickup $(iso_now) noop ${detail}"
    trailer_noop "$detail"
    exit 0
  fi
fi

printf 'PICKUP_GATE proceed ready=%s claimable=%s\n' "$ready_i" "${claimable:-unknown}"
printf 'PICKUP_GATE_PROCEED ready=%s\n' "$ready_i"
exit 10
