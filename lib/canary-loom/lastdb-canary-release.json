{
  "name": "lastdb-canary-release",
  "version": "5",
  "start_at": "DECIDE_ENTRY",
  "max_depth": 2,
  "node_budget": 80,
  "input_schema": {
    "type": "object",
    "properties": {
      "main_oid": { "type": "string" },
      "max_attempts": { "type": "integer" },
      "recovery_mode": { "type": "string" },
      "recovery_child_execution": { "type": "string" },
      "recovery_candidate": { "type": "string" },
      "recovery_source_git_oid": { "type": "string" },
      "recovery_version": { "type": "string" }
    }
  },
  "states": {
    "DECIDE_ENTRY": {
      "type": "choice",
      "path": "recovery_mode",
      "map": {
        "verified-live": "RECOVER_LIVE"
      },
      "default": "BUILD_START"
    },
    "RECOVER_LIVE": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" RECOVER_LIVE"],
      "effects": "none",
      "timeout_sec": 120,
      "next": "LEDGER",
      "on_error": "FAILED"
    },
    "BUILD_START": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" BUILD_START"],
      "effects": "none",
      "timeout_sec": 120,
      "next": "BUILD_POLL",
      "on_error": "FAILED"
    },
    "BUILD_POLL": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" BUILD_POLL"],
      "effects": "none",
      "timeout_sec": 120,
      "next": "DECIDE_BUILD",
      "on_error": "FAILED"
    },
    "DECIDE_BUILD": {
      "type": "choice",
      "path": "build_next",
      "map": {
        "BUILD_WAIT": "BUILD_WAIT",
        "BUILD_COLLECT": "BUILD_COLLECT",
        "FAILED": "FAILED"
      },
      "default": "BUILD_WAIT"
    },
    "BUILD_WAIT": {
      "type": "wait",
      "until": "duration:2m",
      "next": "BUILD_POLL"
    },
    "BUILD_COLLECT": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" BUILD_COLLECT"],
      "effects": "none",
      "timeout_sec": 300,
      "next": "CALL_A",
      "on_error": "FAILED"
    },
    "CALL_A": {
      "type": "map",
      "over": "upgrade_jobs",
      "definition": "lastdb-safe-upgrade",
      "fanout": "upgrade",
      "max_parallel": 1,
      "input_from_context": ["candidate", "version", "source_git_oid"],
      "next": "JOIN_A"
    },
    "JOIN_A": {
      "type": "join",
      "fanout": "upgrade",
      "policy": "all",
      "result_key": "upgrade_results",
      "next": "READ_A",
      "on_error": "HEAL"
    },
    "READ_A": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" READ_A"],
      "effects": "none",
      "timeout_sec": 60,
      "next": "DECIDE_A",
      "on_error": "HEAL"
    },
    "DECIDE_A": {
      "type": "choice",
      "path": "child_status",
      "map": {
        "green": "LEDGER",
        "red": "HEAL",
        "exhausted": "REPORT"
      },
      "default": "HEAL"
    },
    "LEDGER": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" LEDGER"],
      "effects": "idempotent",
      "timeout_sec": 120,
      "next": "SOAK",
      "on_error": "HEAL"
    },
    "SOAK": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" SOAK"],
      "effects": "idempotent",
      "timeout_sec": 900,
      "next": "DECIDE_SOAK",
      "on_error": "HEAL"
    },
    "DECIDE_SOAK": {
      "type": "choice",
      "path": "soak_status",
      "map": {
        "green": "PROMOTE",
        "red": "HEAL",
        "pending": "SOAK_WAIT",
        "exhausted": "REPORT"
      },
      "default": "SOAK_WAIT"
    },
    "SOAK_WAIT": {
      "type": "wait",
      "until": "duration:1h",
      "next": "SOAK"
    },
    "HEAL": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-heal.sh\""],
      "effects": "checked",
      "check": [
        "/bin/bash",
        "-c",
        "exec \"$LOOM_SCRIPTS/loom-canary-check-fix.sh\""
      ],
      "timeout_sec": 3600,
      "next": "RETRY_PREP",
      "on_error": "RETRY_PREP"
    },
    "RETRY_PREP": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" RETRY_PREP"],
      "effects": "none",
      "timeout_sec": 60,
      "next": "DECIDE_RETRY",
      "on_error": "REPORT"
    },
    "DECIDE_RETRY": {
      "type": "choice",
      "path": "verdict",
      "map": {
        "exhausted": "REPORT",
        "blocked": "REPORT"
      },
      "default": "DECIDE_RETRY_ROUTE"
    },
    "DECIDE_RETRY_ROUTE": {
      "type": "choice",
      "path": "recovery_mode",
      "map": {
        "verified-live": "REPORT"
      },
      "default": "BUILD_START"
    },
    "PROMOTE": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-step.sh\" PROMOTE"],
      "effects": "checked",
      "check": [
        "/bin/bash",
        "-c",
        "exec \"$LOOM_SCRIPTS/loom-canary-check-cutover.sh\""
      ],
      "timeout_sec": 3600,
      "next": "DONE",
      "on_error": "FAILED"
    },
    "REPORT": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"$LOOM_SCRIPTS/loom-canary-report.sh\""],
      "effects": "idempotent",
      "timeout_sec": 120,
      "next": "FAILED",
      "on_error": "FAILED"
    },
    "DONE": { "type": "succeed" },
    "FAILED": { "type": "fail" }
  }
}
