{
  "name": "lastdb-safe-upgrade",
  "version": "10",
  "start_at": "PROBE",
  "max_depth": 1,
  "node_budget": 20,
  "input_schema": {
    "type": "object",
    "properties": {
      "candidate": { "type": "string" },
      "candidate_cli": { "type": "string" },
      "version": { "type": "string" },
      "lastdbd_version": { "type": "string" },
      "lastdb_version": { "type": "string" },
      "lastdbd_sha256": { "type": "string" },
      "lastdb_sha256": { "type": "string" },
      "source_git_oid": { "type": "string" },
      "candidate_artifact_digest": { "type": "string" },
      "safe_upgrade_protocol_version": { "type": "string" },
      "upgrade_mode": { "type": "string", "enum": ["legacy-cloud", "native-inplace-cloud-off", "native-logical-migration-cloud-off", "native-v2-ci", "native-run-v2-ci-cloud-off"] },
      "native_approval": { "type": "string" },
      "native_approval_sha256": { "type": "string" },
      "native_reopen": { "type": "boolean" },
      "native_probe_only": { "type": "boolean" },
      "zero_live_soak": { "type": "boolean" },
      "accept_stale_recovery_point": { "type": "string" },
      "attempt": { "type": "integer", "minimum": 1 },
      "item": {}
    },
    "required": [
      "candidate",
      "candidate_cli",
      "version",
      "lastdbd_version",
      "lastdb_version",
      "lastdbd_sha256",
      "lastdb_sha256",
      "source_git_oid",
      "candidate_artifact_digest",
      "safe_upgrade_protocol_version"
    ]
  },
  "states": {
    "PROBE": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"${LOOM_SCRIPTS:-$HOME/.last-stack/lib/canary-loom}/loom-safe-upgrade-step.sh\" PROBE"],
      "effects": "none",
      "timeout_sec": 7200,
      "next": "DECIDE",
      "on_error": "FAILED"
    },
    "DECIDE": {
      "type": "choice",
      "path": "verdict",
      "map": {
        "green": "CUTOVER",
        "probed": "DONE",
        "current": "DONE",
        "red": "FAILED",
        "blocked": "FAILED"
      },
      "default": "FAILED"
    },
    "CUTOVER": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"${LOOM_SCRIPTS:-$HOME/.last-stack/lib/canary-loom}/loom-safe-upgrade-step.sh\" CUTOVER"],
      "effects": "checked",
      "check": [
        "/bin/bash",
        "-c",
        "exec \"${LOOM_SCRIPTS:-$HOME/.last-stack/lib/canary-loom}/loom-canary-check-cutover.sh\""
      ],
      "timeout_sec": 10800,
      "next": "VERIFY",
      "on_error": "RECOVERY_ROUTE"
    },
    "VERIFY": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"${LOOM_SCRIPTS:-$HOME/.last-stack/lib/canary-loom}/loom-safe-upgrade-step.sh\" VERIFY"],
      "effects": "none",
      "timeout_sec": 180,
      "next": "DONE",
      "on_error": "RECOVERY_ROUTE"
    },
    "RECOVERY_ROUTE": {
      "type": "choice",
      "path": "upgrade_mode",
      "map": { "native-inplace-cloud-off": "RECOVER", "native-logical-migration-cloud-off": "RECOVER", "native-v2-ci": "RECOVER", "native-run-v2-ci-cloud-off": "RECOVER" },
      "default": "FAILED"
    },
    "RECOVER": {
      "type": "agent",
      "command": ["/bin/bash", "-c", "exec \"${LOOM_SCRIPTS:-$HOME/.last-stack/lib/canary-loom}/loom-safe-upgrade-step.sh\" RECOVER"],
      "effects": "checked",
      "check": ["/bin/bash", "-c", "exec \"${LOOM_SCRIPTS:-$HOME/.last-stack/lib/canary-loom}/loom-safe-upgrade-step.sh\" RECOVERY_CHECK"],
      "timeout_sec": 1200,
      "next": "FAILED",
      "on_error": "FAILED"
    },
    "DONE": { "type": "succeed" },
    "FAILED": { "type": "fail" }
  }
}
