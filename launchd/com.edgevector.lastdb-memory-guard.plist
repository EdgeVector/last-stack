<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgevector.lastdb-memory-guard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-launchd-loop</string>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-lastdb-memory-guard</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/REPLACE</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>LASTDB_HOME</key>
    <string>/Users/REPLACE/.lastdb</string>
    <key>LASTDBD_PRIMARY_HOME</key>
    <string>/Users/REPLACE/.lastdb</string>

    <!-- Tom chose phys_footprint with a 16 GiB limit on 2026-08-08.
         Keep this metric and limit together. The script logs both gauges. -->
    <key>LASTDBD_GUARD_METRIC</key>
    <string>footprint</string>

    <key>LASTDBD_RSS_LIMIT_MB</key>
    <string>16384</string>
    <!-- launchd-loop: see bin/last-stack-launchd-loop -->
    <key>LAUNCHD_LOOP_LABEL</key>
    <string>com.edgevector.lastdb-memory-guard</string>
    <key>LAUNCHD_LOOP_INTERVAL_SEC</key>
    <string>60</string>
  </dict>

  <!-- KeepAlive loop, not StartInterval (2026-09-23): a locked GUI session puts
       gui/<uid> in on-demand mode, and launchd then spawns no interval job and
       respawns no exited job. A loop that never exits keeps running.
       Staleness: every loop pages when a peer heartbeat under
       ~/.lastdb/monitoring/launchd-loop is older than max(300s, 2*interval+60s). -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Standard</string>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/lastdbd-memory-guard.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/lastdbd-memory-guard.launchd.log</string>
</dict>
</plist>
