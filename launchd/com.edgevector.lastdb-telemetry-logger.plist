<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgevector.lastdb-telemetry-logger</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-launchd-loop</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-lastdb-telemetry-logger</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/REPLACE</string>
    <key>PATH</key>
    <string>/Users/REPLACE/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>

    <!-- Tom asked for this on 2026-09-25: lastdb ops should always run, not be
         a command someone has to remember to run by hand. This polls
         `lastdb status` + `lastdb ops --json` on the same interval as the
         memory guard and keeps a rotating trend log (see the script header for
         the fields and the retention/size-cap knobs). -->
    <key>LAUNCHD_LOOP_LABEL</key>
    <string>com.edgevector.lastdb-telemetry-logger</string>
    <key>LAUNCHD_LOOP_INTERVAL_SEC</key>
    <string>60</string>
  </dict>

  <!-- Same reasoning as lastdb-memory-guard (2026-09-23): a locked GUI session
       puts launchd in on-demand mode, where it neither fires StartInterval
       jobs nor respawns a KeepAlive job that exited. A loop that never exits
       keeps running regardless. -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/lastdb-telemetry-logger.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/lastdb-telemetry-logger.launchd.log</string>
</dict>
</plist>
