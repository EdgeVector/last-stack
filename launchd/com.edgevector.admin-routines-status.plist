<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgevector.admin-routines-status</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE/.local/share/edgevector/admin-routines-status/run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/REPLACE</string>
    <key>USER</key><string>REPLACE</string>
    <key>PATH</key><string>/Users/REPLACE/.local/bin:/Users/REPLACE/.last-stack/bin:/Users/REPLACE/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LAST_STACK_ROOT</key><string>/Users/REPLACE/.last-stack</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/REPLACE/.local/share/edgevector/admin-routines-status/deliver.log</string>
  <key>StandardErrorPath</key><string>/Users/REPLACE/.local/share/edgevector/admin-routines-status/deliver.err.log</string>
</dict>
</plist>
