<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgevector.host-memory-sentinel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-host-memory-sentinel</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/REPLACE</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>SENTINEL_SWAP_ALERT_MB</key>
    <string>20480</string>
    <key>SENTINEL_FREE_PCT_ALERT</key>
    <string>8</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/host-memory-sentinel.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/host-memory-sentinel.launchd.log</string>
</dict>
</plist>
