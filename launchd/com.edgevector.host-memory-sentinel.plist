<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edgevector.host-memory-sentinel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-launchd-loop</string>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/.last-stack/bin/last-stack-host-memory-sentinel</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/REPLACE</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>SENTINEL_SWAP_ALERT_MB</key>
    <string>20480</string>
    <key>SENTINEL_FREE_PCT_ALERT</key>
    <string>8</string>
    <!-- launchd-loop: see bin/last-stack-launchd-loop -->
    <key>LAUNCHD_LOOP_LABEL</key>
    <string>com.edgevector.host-memory-sentinel</string>
    <key>LAUNCHD_LOOP_INTERVAL_SEC</key>
    <string>300</string>
  </dict>

  <!-- KeepAlive loop, not StartInterval (2026-09-23): a locked GUI session puts
       gui/<uid> in on-demand mode, and launchd then spawns no interval job and
       respawns no exited job. A loop that never exits keeps running.
       Staleness: every loop pages when a peer heartbeat under
       ~/.lastdb/monitoring/launchd-loop is older than max(300s, 2*interval+60s). -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Standard</string>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/host-memory-sentinel.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/.lastdb/monitoring/host-memory-sentinel.launchd.log</string>
</dict>
</plist>
