{
  "defaults": {
    "install_mode": "artifact",
    "artifact_channel": "stable",
    "artifact_root": "$HOME/.lastgit/artifacts"
  },
  "apps": [
    {
      "app": "lastgit",
      "install_mode": "checkout",
      "kind": "checkout-shim",
      "command": "lastgit",
      "gate": "forgejo",
      "gate_main": "http://localhost:3300/EdgeVector/lastgit.git#main",
      "host_track": "$HOME/.lastgit/host-checkout/lastgit",
      "refresh": "$HOME/.lastgit/host-checkout/lastgit/.lastgit/refresh-host.sh",
      "artifact_app": "lastgit",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/lastgit",
      "links": [
        {
          "source": "dist/lastgit",
          "target": "$HOME/.local/bin/lastgit"
        },
        {
          "source": "dist/git-remote-lastdb",
          "target": "$HOME/.local/bin/git-remote-lastdb"
        }
      ],
      "artifact_exemption": {
        "kind": "bootstrap-recovery",
        "owner": "platform",
        "rationale": "LastGit remains checkout-backed so LastGit fixes can still be built when the artifact/CR substrate itself is unhealthy."
      },
      "notes": "LastGit is the bootstrap forge and stays checkout-backed until its artifact producer is independent of LastGit itself."
    },
    {
      "app": "last-stack",
      "install_mode": "artifact",
      "kind": "artifact skill-pack",
      "command": "host-track",
      "gate": "lastgit",
      "gate_main": "lastdb:///last-stack#main",
      "track_gate_main": true,
      "artifact_app": "last-stack",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.local/state/last-stack/artifacts",
      "post_install": "$HOME/.local/state/last-stack/artifacts/current/setup",
      "links": [
        {
          "source": "bin/host-track",
          "target": "$HOME/.local/bin/host-track"
        },
        {
          "source": "bin/last-stack-class-a-heal",
          "target": "$HOME/.local/bin/last-stack-class-a-heal"
        },
        {
          "source": "bin/last-stack-papercut-lifecycle-close",
          "target": "$HOME/.local/bin/last-stack-papercut-lifecycle-close"
        },
        {
          "source": "bin/last-stack-routine-read",
          "target": "$HOME/.local/bin/last-stack-routine-read"
        },
        {
          "source": "bin/last-stack-update-check",
          "target": "$HOME/.local/bin/last-stack-update-check"
        },
        {
          "source": "bin/last-stack-self-upgrade",
          "target": "$HOME/.local/bin/last-stack-self-upgrade"
        },
        {
          "source": "bin/last-stack-shell-prelude",
          "target": "$HOME/.local/bin/last-stack-shell-prelude"
        },
        {
          "source": "bin/last-stack-cli-preflight",
          "target": "$HOME/.local/bin/last-stack-cli-preflight"
        },
        {
          "source": "bin/last-stack-board-closeout-sweep",
          "target": "$HOME/.local/bin/last-stack-board-closeout-sweep"
        },
        {
          "source": "bin/last-stack-card-closeout",
          "target": "$HOME/.local/bin/last-stack-card-closeout"
        },
        {
          "source": "bin/last-stack-forge-api",
          "target": "$HOME/.local/bin/last-stack-forge-api"
        },
        {
          "source": "bin/last-stack-forge-git",
          "target": "$HOME/.local/bin/last-stack-forge-git"
        },
        {
          "source": "bin/last-stack-forge-ci-log",
          "target": "$HOME/.local/bin/last-stack-forge-ci-log"
        },
        {
          "source": "bin/last-stack-forge-json-jq",
          "target": "$HOME/.local/bin/last-stack-forge-json-jq"
        },
        {
          "source": "bin/last-stack-unattached-outcome-heal",
          "target": "$HOME/.local/bin/last-stack-unattached-outcome-heal"
        },
        {
          "source": "bin/last-stack-why-stopped",
          "target": "$HOME/.local/bin/last-stack-why-stopped"
        },
        {
          "source": "bin/last-stack-factory-health",
          "target": "$HOME/.local/bin/last-stack-factory-health"
        },
        {
          "source": "bin/last-stack-ship-pipeline-gap-snapshot",
          "target": "$HOME/.local/bin/last-stack-ship-pipeline-gap-snapshot"
        },
        {
          "source": "bin/last-stack-pr-venue",
          "target": "$HOME/.local/bin/last-stack-pr-venue"
        },
        {
          "source": "bin/last-stack-lastseek-host-track-post-install",
          "target": "$HOME/.local/bin/last-stack-lastseek-host-track-post-install"
        }
      ],
      "notes": "Runtime is an immutable CI artifact that tracks gate_main (green+published main). host-track refresh promotes stable to that tip then installs. ~/.last-stack/{bin,skills,...} \u2192 artifacts/current. PATH links Class A + pickup bootstrap + Forge closeout tools (forge-api and friends) so routinesd (~/.local/bin first) never hits GC'd version pins and board-closeout can resolve Forge PRs. Never develop in the install; use a worktree. Also PATH-link last-stack-papercut-lifecycle-close so papercut-reconciler scheduled shells (routinesd PATH often ~/.local/bin-first without sourcing shell-prelude) resolve the lifecycle closer instead of lifecycle_helper_missing."
    },
    {
      "app": "brain",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "brain",
      "gate": "lastgit",
      "gate_main": "lastdb:///brain#main",
      "artifact_app": "brain",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/brain",
      "links": [
        {
          "source": "bin/brain",
          "target": "$HOME/.local/bin/brain"
        },
        {
          "source": "bin/brain-mcp",
          "target": "$HOME/.local/bin/brain-mcp"
        }
      ],
      "notes": "Brain LastGit artifact install; track_gate_main promotes stable to green+published main. post_install runs bun install --frozen-lockfile --production. PATH links brain + brain-mcp.",
      "track_gate_main": true,
      "post_install": "$HOME/.host-track/apps/brain/current/bin/brain-host-track-post-install"
    },
    {
      "app": "situations",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "situations",
      "gate": "lastgit",
      "gate_main": "lastdb:///situations#main",
      "artifact_app": "situations",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/situations",
      "links": [
        {
          "source": "dist/situations",
          "target": "$HOME/.local/bin/situations"
        },
        {
          "source": "dist/fsituations",
          "target": "$HOME/.local/bin/fsituations"
        }
      ],
      "notes": "Situations LastGit artifact install from CI-published dist/* binaries; track_gate_main promotes stable to green+published main.",
      "track_gate_main": true
    },
    {
      "app": "kanban",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "kanban",
      "gate": "lastgit",
      "gate_main": "lastdb:///fkanban#main",
      "artifact_app": "fkanban",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/fkanban",
      "links": [
        {
          "source": "dist/kanban",
          "target": "$HOME/.local/bin/kanban"
        },
        {
          "source": "dist/fkanban",
          "target": "$HOME/.local/bin/fkanban"
        }
      ],
      "notes": "One registration for the whole fkanban artifact bundle: links BOTH public CLI names (kanban and fkanban) off a single install_root and a single stamp. There used to be a second app entry named `fkanban` pointing at the same install_root; two entries meant two stamps for one bundle, they drifted, and host-track reported the identical binary as fresh under one name and stale under the other. track_gate_main follows fkanban green+published main.",
      "track_gate_main": true
    },
    {
      "app": "routines",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "routines",
      "gate": "lastgit",
      "gate_main": "lastdb:///routines#main",
      "artifact_app": "routines",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/routines",
      "links": [
        {
          "source": "dist/routines",
          "target": "$HOME/.local/bin/routines"
        }
      ],
      "notes": "Routines LastGit artifact install from CI-published dist/routines; track_gate_main promotes stable to green+published main.",
      "track_gate_main": true
    },
    {
      "app": "lastsecrets",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "lastsecrets",
      "gate": "lastgit",
      "gate_main": "lastdb:///lastsecrets#main",
      "artifact_app": "lastsecrets",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/lastsecrets",
      "links": [
        {
          "source": "dist/lastsecrets",
          "target": "$HOME/.local/bin/lastsecrets"
        }
      ],
      "notes": "LastSecrets LastGit artifact install from CI-published dist/lastsecrets; track_gate_main promotes stable to green+published main.",
      "track_gate_main": true
    },
    {
      "app": "configurations",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "configurations",
      "gate": "lastgit",
      "gate_main": "lastdb:///configurations#main",
      "artifact_app": "configurations",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/configurations",
      "links": [
        {
          "source": "dist/configurations",
          "target": "$HOME/.local/bin/configurations"
        }
      ],
      "notes": "Configurations LastGit artifact install from CI-published dist/configurations; track_gate_main promotes stable to green+published main.",
      "track_gate_main": true
    },
    {
      "app": "lastseek",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "lastseek",
      "gate": "lastgit",
      "gate_main": "lastdb:///lastseek#main",
      "artifact_app": "lastseek",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/lastseek",
      "links": [
        {
          "source": "dist/lastseek",
          "target": "$HOME/.local/bin/lastseek"
        }
      ],
      "notes": "LastSeek LastGit neural artifact install from CI-published dist/lastseek; track_gate_main promotes stable to green+published main. Model weights remain host state and post_install verifies the five documented bge-small-en-v1.5 files without downloading them.",
      "track_gate_main": true,
      "post_install": "$HOME/.local/bin/last-stack-lastseek-host-track-post-install"
    },
    {
      "app": "search",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "search",
      "gate": "lastgit",
      "gate_main": "lastdb:///search#main",
      "artifact_app": "search",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/search",
      "links": [
        {
          "source": "bin/search",
          "target": "$HOME/.local/bin/search"
        }
      ],
      "notes": "Search LastGit artifact install (source pack + post_install npm/bun deps + neural smoke); track_gate_main promotes stable to green+published main.",
      "track_gate_main": true,
      "post_install": "$HOME/.host-track/apps/search/current/bin/search-host-track-post-install"
    },
    {
      "app": "remote",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "ra",
      "gate": "lastgit",
      "gate_main": "lastdb:///remote#main",
      "artifact_app": "remote",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/remote",
      "links": [
        {
          "source": "bin/ra",
          "target": "$HOME/.local/bin/ra"
        },
        {
          "source": "bin/rad",
          "target": "$HOME/.local/bin/rad"
        },
        {
          "source": "bin/rad-telegram",
          "target": "$HOME/.local/bin/rad-telegram"
        }
      ],
      "notes": "Remote Agent artifact install; refresh links ra/rad/rad-telegram from the promoted LastGit artifact. track_gate_main promotes stable to green+published main — without it the channel sat on a hand-promoted pointer for 8 days and shipped a known-broken ra shim, silently killing every ra notify page.",
      "track_gate_main": true
    },
    {
      "app": "state-machine",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "sm",
      "aliases": [
        "state-machine"
      ],
      "gate": "lastgit",
      "gate_main": "lastdb:///state-machine-app#main",
      "artifact_app": "state-machine",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/state-machine",
      "links": [
        {
          "source": "dist/sm",
          "target": "$HOME/.local/bin/sm"
        },
        {
          "source": "dist/state-machine",
          "target": "$HOME/.local/bin/state-machine"
        }
      ],
      "notes": "State Machine LastGit artifact install from CI-published dist/* binaries; track_gate_main promotes stable to green+published main. sm is the runner for lastdb-canary-release and lastdb-safe-upgrade, so it upgrades the primary and publishes to public brew \u2014 before this entry ~/.local/bin/sm symlinked into the workspace DEV checkout and had no freshness gate at all.",
      "track_gate_main": true
    },
    {
      "app": "lastdb-browser",
      "install_mode": "artifact",
      "kind": "artifact cli",
      "command": "lastdb-browser",
      "gate": "lastgit",
      "gate_main": "lastdb:///lastdb-browser#main",
      "artifact_app": "lastdb-browser",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/lastdb-browser",
      "links": [
        {
          "source": "bin/lastdb-browser",
          "target": "$HOME/.local/bin/lastdb-browser"
        }
      ],
      "notes": "LastDB Browser LastGit artifact install (source pack + post_install npm build, same shape as search); track_gate_main promotes stable to green+published main. Interactive schemas -> keys -> record -> atom browser for a local node, served by a zero-dependency Node bridge because a browser cannot open a unix socket. Read-only: every bridge route is a GET or the read-only POST /api/query. post_install builds the UI then deletes node_modules -- nothing is needed at runtime.",
      "track_gate_main": true,
      "post_install": "$HOME/.host-track/apps/lastdb-browser/current/bin/lastdb-browser-host-track-post-install"
    },
    {
      "app": "lastdb",
      "install_mode": "checkout",
      "kind": "safe-upgrade-managed binary",
      "command": "lastdb",
      "gate": "forgejo",
      "gate_main": "http://localhost:3300/EdgeVector/fold.git#main",
      "artifact_app": "lastdb-bundle",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/lastdb-bundle",
      "links": [
        {
          "source": "bin/lastdb",
          "target": "$HOME/.local/bin/lastdb"
        }
      ],
      "artifact_exemption": {
        "kind": "deployment-only",
        "owner": "platform",
        "rationale": "Live primary Mini activation is managed by lastdb-safe-upgrade and ~/.lastdb/current, not generic host-track artifact refresh."
      },
      "notes": "LastDB Mini is deployment-managed; live primary upgrades still require lastdb-safe-upgrade and must not be performed by Host Track refresh."
    },
    {
      "app": "lastdbd",
      "install_mode": "checkout",
      "kind": "safe-upgrade-managed binary",
      "command": "lastdbd",
      "gate": "forgejo",
      "gate_main": "http://localhost:3300/EdgeVector/fold.git#main",
      "artifact_app": "lastdb-bundle",
      "artifact_channel": "stable",
      "artifact_root": "$HOME/.lastgit/artifacts",
      "install_root": "$HOME/.host-track/apps/lastdb-bundle",
      "links": [
        {
          "source": "bin/lastdbd",
          "target": "$HOME/.local/bin/lastdbd"
        }
      ],
      "artifact_exemption": {
        "kind": "deployment-only",
        "owner": "platform",
        "rationale": "Live primary Mini daemon activation is managed by lastdb-safe-upgrade and ~/.lastdb/current, not generic host-track artifact refresh."
      },
      "notes": "LastDB Mini daemon is deployment-managed; activation of Tom's primary node remains lastdb-safe-upgrade only."
    }
  ]
}
