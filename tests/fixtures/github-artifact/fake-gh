#!/usr/bin/env python3
"""Fixture `gh`: serves `gh api <path> [--jq .a.b]` from $FAKE_GH_ROUTES (JSON).

routes.json maps an exact API path (query included) to {"json": ...} or
{"file": "<path>"} (raw bytes). Every call is appended to $FAKE_GH_LOG.
An unknown path exits 1 with an HTTP 404 line, like the real tool.
"""
import json
import os
import sys

args = sys.argv[1:]
log = os.environ.get("FAKE_GH_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(" ".join(args) + "\n")
if len(args) < 2 or args[0] != "api":
    sys.stderr.write("fake-gh: only `api` is supported\n")
    sys.exit(2)
path = args[1]
jq = args[args.index("--jq") + 1] if "--jq" in args else None
with open(os.environ["FAKE_GH_ROUTES"]) as fh:
    routes = json.load(fh)
route = routes.get(path)
if route is None:
    sys.stderr.write("gh: Not Found (HTTP 404)\n")
    sys.exit(1)
if "file" in route:
    with open(route["file"], "rb") as fh:
        sys.stdout.buffer.write(fh.read())
    sys.exit(0)
val = route["json"]
if jq:
    for part in [p for p in jq.split(".") if p]:
        val = val[part]
    print(val if isinstance(val, str) else json.dumps(val))
else:
    print(json.dumps(val))
